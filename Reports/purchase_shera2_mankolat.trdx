<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource1" Width="20cm" Name="شراء منقولات" Zoom="0.6666667" xmlns="http://schemas.telerik.com/reporting/2023/1.0">
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="azxsandoaa" SelectCommand="SELECT &#xD;&#xA;    azaccmf.acc_no,&#xD;&#xA;    azaccmf.acc_nm_ar,&#xD;&#xA;    azaccmf.Phone,&#xD;&#xA;    azaccmf.TaxReg_No,&#xD;&#xA;    azaccmf.TaxFil_No ,        &#xD;&#xA;    azaccmf.TAX_CARD,&#xD;&#xA;    azaccmf.TaxOfc,     &#xD;&#xA;    azaccmf.Strt,&#xD;&#xA;    azaccmf.Fax,&#xD;&#xA;    azaccmf.Email,&#xD;&#xA;&#xD;&#xA;    aztrh.FNCL_TR_NO,&#xD;&#xA;    aztrh.TR_DT,&#xD;&#xA;    aztrh.PURCHAS_NO,&#xD;&#xA;    aztrh.Vst_No,&#xD;&#xA;    aztrh.VAC_DAYS,&#xD;&#xA;    aztrh.DLVR_LOC,&#xD;&#xA;    DLVRLOC.DSCR_AR AS 'مكان التسليم',&#xD;&#xA;&#xD;&#xA;    -- السنة المالية&#xD;&#xA;    CASE&#xD;&#xA;        WHEN MONTH(aztrh.TR_DT) &gt;= 7&#xD;&#xA;        THEN CAST(YEAR(aztrh.TR_DT)+1 AS VARCHAR) + '/' + CAST(YEAR(aztrh.TR_DT) AS VARCHAR)&#xD;&#xA;        ELSE CAST(YEAR(aztrh.TR_DT) AS VARCHAR) + '/' + CAST(YEAR(aztrh.TR_DT)-1 AS VARCHAR)&#xD;&#xA;    END AS Fiscal_Year,&#xD;&#xA;&#xD;&#xA;    PAYTYPE.DSCR_AR AS 'نوع الدفع',&#xD;&#xA;    AZTRTY.DSCR_AR AS 'نوع العملية',&#xD;&#xA;&#xD;&#xA;    aztrh.Ltot AS TOTAL_Ltot,&#xD;&#xA;&#xD;&#xA;    'فقط ' + dbo.Num_To_Str(aztrh.Ltot) + ' لا غير' AS tfqet,&#xD;&#xA;&#xD;&#xA;    SUM(aztrd.qty) AS TOTAL_QTY,&#xD;&#xA;    AVG(aztrd.PKPRC) AS AVG_PRICE,&#xD;&#xA;    SUM(aztrd.qty * aztrd.PKPRC) AS TOTAL_VALUE,&#xD;&#xA;&#xD;&#xA;    STRING_AGG(CAST(aztrd.ITM_CD AS NVARCHAR(50)), N' - ') AS ITEMS_CODES,&#xD;&#xA;    STRING_AGG(azitms.ITM_NM_AR, N' - ') AS ITEMS_NAMES,&#xD;&#xA;    STRING_AGG(AZPKGDEF.pk_nm_ar, N' - ') AS PK_NAMES&#xD;&#xA;&#xD;&#xA;FROM aztrd&#xD;&#xA;&#xD;&#xA;INNER JOIN aztrh &#xD;&#xA;    ON aztrh.tr_no = aztrd.tr_no &#xD;&#xA;    AND aztrh.tr_ty = aztrd.tr_ty &#xD;&#xA;    AND aztrh.loc = aztrd.loc&#xD;&#xA;&#xD;&#xA;LEFT JOIN APPCODES PAYTYPE&#xD;&#xA;    ON PAYTYPE.SEQ = AZTRH.PYMNT_MTHD&#xD;&#xA;    AND PAYTYPE.ID = 11031    &#xD;&#xA;&#xD;&#xA;LEFT JOIN APPCODES DLVRLOC&#xD;&#xA;    ON DLVRLOC.SEQ = AZTRH.DLVR_LOC&#xD;&#xA;    AND DLVRLOC.ID = 11032&#xD;&#xA;&#xD;&#xA;LEFT JOIN azitms &#xD;&#xA;    ON azitms.itm_cd = aztrd.ITM_CD&#xD;&#xA;&#xD;&#xA;LEFT JOIN AZTRTY&#xD;&#xA;    ON AZTRTY.TR_TY = AZTRH.Prchs_Oprtn_Typ&#xD;&#xA;&#xD;&#xA;LEFT JOIN AZPKGDEF&#xD;&#xA;    ON AZPKGDEF.pkid = AZTRd.pkid&#xD;&#xA;&#xD;&#xA;INNER JOIN azaccmf &#xD;&#xA;    ON (&#xD;&#xA;        (',' + ISNULL(aztrh.acc_no2, '') + ',' &#xD;&#xA;         LIKE '%,''' + azaccmf.acc_no + ''',%')&#xD;&#xA;        OR (&#xD;&#xA;            ISNULL(aztrh.acc_no2, '') = ''&#xD;&#xA;            AND dbo.StringIntersect(AZTRH.RMRK_EXTRA, AZACCMF.Acc_Actv, ',') = 1&#xD;&#xA;        )&#xD;&#xA;    )&#xD;&#xA;&#xD;&#xA;WHERE &#xD;&#xA;    aztrd.loc = '50' &#xD;&#xA;    AND aztrd.tr_ty = '120'  &#xD;&#xA;    AND azaccmf.stpd = '1'&#xD;&#xA;&#xD;&#xA;GROUP BY&#xD;&#xA;    azaccmf.acc_no,&#xD;&#xA;    azaccmf.acc_nm_ar,&#xD;&#xA;    azaccmf.Phone,&#xD;&#xA;    azaccmf.TaxReg_No,&#xD;&#xA;    azaccmf.TaxFil_No,&#xD;&#xA;    azaccmf.Fax,&#xD;&#xA;    azaccmf.TAX_CARD,&#xD;&#xA;    azaccmf.TaxOfc,&#xD;&#xA;    azaccmf.Strt,&#xD;&#xA;    azaccmf.Email,&#xD;&#xA;    aztrh.FNCL_TR_NO,&#xD;&#xA;    aztrh.TR_DT,&#xD;&#xA;    aztrh.PURCHAS_NO,&#xD;&#xA;    aztrh.Vst_No,&#xD;&#xA;    aztrh.VAC_DAYS,&#xD;&#xA;    aztrh.DLVR_LOC,&#xD;&#xA;    DLVRLOC.DSCR_AR,&#xD;&#xA;    aztrh.Ltot,&#xD;&#xA;    PAYTYPE.DSCR_AR,&#xD;&#xA;    AZTRTY.DSCR_AR,&#xD;&#xA;&#xD;&#xA;    CASE&#xD;&#xA;        WHEN MONTH(aztrh.TR_DT) &gt;= 7&#xD;&#xA;        THEN CAST(YEAR(aztrh.TR_DT)+1 AS VARCHAR) + '/' + CAST(YEAR(aztrh.TR_DT) AS VARCHAR)&#xD;&#xA;        ELSE CAST(YEAR(aztrh.TR_DT) AS VARCHAR) + '/' + CAST(YEAR(aztrh.TR_DT)-1 AS VARCHAR)&#xD;&#xA;    END&#xD;&#xA;&#xD;&#xA;ORDER BY azaccmf.acc_no;" Name="sqlDataSource1" />
  </DataSources>
