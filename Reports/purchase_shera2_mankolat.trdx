            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="9.7cm" Height="0.4cm" Left="9.368cm" Top="7.189cm" Value="17 -  يجب أن تكون كافة الملاحق وفقاً لما تضمنته كراسة الشروط والمواصفات." Name="textBox117">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.024cm" Height="0.332cm" Left="3.002cm" Top="6.089cm" Value="ـــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــ" Name="textBox119">
