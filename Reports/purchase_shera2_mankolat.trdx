            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="5.196cm" Height="0.4cm" Left="6.453cm" Top="18.389cm" Value="تبدأ من ( اليوم التالي لإخطاره بأمر التوريد / " Name="textBox146">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="9.704cm" Height="0.4cm" Left="9.368cm" Top="19.889cm" Value="الفواتير مستندات تثبت قيمة مصروفات النق الإضافية التي تجملها فعلياً لردها إليه ." Name="textBox147">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="2.75cm" Height="0.4cm" Left="16.326cm" Top="25.089cm" Value="حدد الطرف الأول يوم" Name="textBox150">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.5cm" Height="0.4cm" Left="2.576cm" Top="26.589cm" Value="ويلتزم الطرف الثاني بسحب الأصناف المرفوضة وتوريد بدل منها خلال مدة لا تجاوز سبعة أيام من تاريخ اليوم التالي لإخطاره , فإذا تأخر في" Name="textBox149">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="0.3cm" Height="0.4cm" Left="2.626cm" Top="18.389cm" Value=")" Name="textBox151">
