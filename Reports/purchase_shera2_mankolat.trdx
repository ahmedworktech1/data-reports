            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="11.55cm" Height="0.5cm" Left="7.599cm" Top="20.389cm" Value="(إذا كان التوريد دفعات , يكون البتد علي النحو التالي وتستكمل البيانات المطلوبة فيه )" Name="textBox152">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="11pt" Bold="True" Underline="False" />
