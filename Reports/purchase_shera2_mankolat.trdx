        <TextBox Width="5.724cm" Height="0.4cm" Left="13.352cm" Top="31.289cm" Value="لمكتب شكاوي التعاقدات العمومية وذلك للمتابعة . " Name="textBox174">
          <Style TextAlign="Left" VerticalAlign="Middle">
