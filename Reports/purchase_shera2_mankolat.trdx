        <TextBox Width="9.823cm" Height="0.4cm" Left="9.253cm" Top="26.089cm" Value="العينات المعتمدة وجب علي الطرف الأول إخطار الطرف الثاني بأسباب الرقض كتابة . " Name="textBox164">
