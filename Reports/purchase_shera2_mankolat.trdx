        <TextBox Width="8.473cm" Height="0.4cm" Left="10.602cm" Top="7.689cm" Value="18 - أدهل بيان موجز عن الصنف طبقاً لكراسة الشروط والمواصفات ." Name="textBox121">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
