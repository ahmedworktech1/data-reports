        <TextBox Width="2cm" Height="0.4cm" Left="9.416cm" Top="46.268cm" Value="البند الأول" Name="textBox371">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Size="12pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.2cm" Height="0.4cm" Left="2.066cm" Top="46.879cm" Value="يعتبر التمهيد السابق وكراسة الشروط والمواصفات و( العطاء /  العرض) المقدم من الطرف الثاني، وكافة المكاتبات والمستندات المتبادلة بين " Name="textBox370">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="2.7cm" Height="0.4cm" Left="15.566cm" Top="47.444cm" Value="بين الطرفين ومحاضر " Name="textBox369">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="0.7cm" Height="0.4cm" Left="8.466cm" Top="47.441cm" Value="لسنة " Name="textBox368">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="1.181cm" Height="0.5cm" Left="4.285cm" Top="47.444cm" Value=") , وأمر" Name="textBox367">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="2cm" Height="0.4cm" Left="16.266cm" Top="47.944cm" Value="الاسناد المؤرخ " Name="textBox366">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="6.214cm" Height="0.4cm" Left="7.452cm" Top="47.944cm" Value="جزءا لا بتجزأ من هذا العقد ومتمما ومكملا لأحكامه ." Name="textBox365">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="2cm" Height="0.4cm" Left="9.366cm" Top="48.779cm" Value="البند الثاني" Name="textBox364">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Size="12pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="7.1cm" Height="0.4cm" Left="11.166cm" Top="49.279cm" Value="تعتبر الملاحق التالية والمرفقة بهذا العقد جزءاً لا يتجزأ منه: " Name="textBox363">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="4.2cm" Height="0.4cm" Left="14.066cm" Top="49.779cm" Value="ملحق (1): وصف موضوع العقد." Name="textBox362">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="4cm" Height="0.4cm" Left="14.266cm" Top="50.279cm" Value="ملحق (2): الاشتراطات الخاصة." Name="textBox361">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="4.2cm" Height="0.4cm" Left="14.066cm" Top="50.779cm" Value="ملحق (3): التزامات طرفي التعاقد." Name="textBox360">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="2cm" Height="0.4cm" Left="9.366cm" Top="51.679cm" Value="البند الثالث" Name="textBox359">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Size="12pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="15.05cm" Height="0.4cm" Left="3.266cm" Top="52.279cm" Value="يلتزم الطرف الثاني بتنفيذ محل هذا العقد وفقاًً للممارسات الجيدة وأفضل المعايير المتعارف عليها وطبقاً للمواصفات الفنية والكميات " Name="textBox358">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="5.642cm" Height="0.4cm" Left="12.674cm" Top="52.779cm" Value="والأسعار الموضحة بعد وبقيمة إجمالية قدرها (" Name="textBox357">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="1.692cm" Height="0.4cm" Left="9.574cm" Top="52.779cm" Value=") (فقط وقدره " Name="textBox356">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="3.831cm" Height="0.4cm" Left="2.177cm" Top="52.779cm" Value=") شاملة كافة الضرائب والرسوم " Name="textBox355">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="6.573cm" Height="0.4cm" Left="11.743cm" Top="53.279cm" Value="والتكاليف والنفقات ذات الصلة وذلك علي النحو التالي : " Name="textBox354">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
