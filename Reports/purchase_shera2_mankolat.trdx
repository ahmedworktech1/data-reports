        <TextBox Width="1.205cm" Height="0.4cm" Left="18.005cm" Top="88.562cm" Value="التحكيم ." Name="textBox165">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.5cm" Height="0.4cm" Left="2.576cm" Top="27.089cm" Value="سحبها فيحق للطرف الأول تحصيل مصروفات تخزين منه بواقع (5%) من قيمة الأصناف المرصوفة عن كل أسبوع تأخير أو جزء منه وبحد" Name="textBox167">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="15.832cm" Height="0.4cm" Left="3.244cm" Top="30.289cm" Value="يلتزم الطرف الأول باستلام الأصناف محل هذا العقد فى المواعيد المجددة , وذلك حال مطابقتها للمواصفات والشروط المتفق عليها , ويحق" Name="textBox168">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="15.832cm" Height="0.4cm" Left="3.244cm" Top="30.789cm" Value="للطرف الثاني حال تقاعس الطرف الأول عن الاستلام بطلب للسلطة المختصة لتشكيل لحنة محايدة لدراسة أسباب التقاعس , وصورة منه " Name="textBox169">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.5cm" Height="0.4cm" Left="2.626cm" Top="27.589cm" Value="أقصي أربعة أسابيع وبعد انتهاء تلك المدة يحق للطرف الأول اتخاذ إجراءات بيعها لحساب الطرف الثاني , ويخصم من الثمن ما يكون مستحقاً" Name="textBox170">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="15.558cm" Height="0.4cm" Left="3.568cm" Top="28.089cm" Value="للطرف الأول ؤيكون البيع وفقاً لأحكام قانون تنظيم التعاقدات التي تبرمها الجهات العامة الصادر رقم 182 لسنة 2018 ولائحته التنفيذية " Name="textBox171">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="6.166cm" Height="0.4cm" Left="12.96cm" Top="28.589cm" Value="الصادره بقرار وزير المالية رقم 692 لسنة 2019 . " Name="textBox172">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="2cm" Height="0.5cm" Left="10.026cm" Top="29.589cm" Value="البند السابع" Name="textBox173">
          <Style TextAlign="Center" VerticalAlign="Middle">
