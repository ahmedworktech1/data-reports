            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="9.223cm" Height="0.4cm" Left="9.926cm" Top="9.689cm" Value="22- أدخل القيمة الإجمالية ( الكيمة * سعر الوحدة ) وطبقا لنتيجة الترسية . " Name="textBox124">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.623cm" Height="0.4cm" Left="2.526cm" Top="10.189cm" Value="23- لا يحصل تأمين نهائي من الطرف الثاني إ1ا ورد جميع الأصناف اتي رسا عليه توريدها وقبلها الطرف الأول بصفة نهائية خلال المدة المحددة" Name="textBox125">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.573cm" Height="0.4cm" Left="2.576cm" Top="10.689cm" Value="لأداء التأمين ما لم يكن لهذه الأصناف مدة ضمان وفقاُ لحكم المادة (40) من قانون تنظيم التعاقدات التي تبرمها الجهات العامة الصادر بالقانون" Name="textBox126">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="3.104cm" Height="0.4cm" Left="16.045cm" Top="11.189cm" Value=" رقم 182 لسنة 2018 . " Name="textBox127">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="6.904cm" Height="0.4cm" Left="12.245cm" Top="11.689cm" Value="24- أدخل اسم الجهة الإدارية أو الجهات الإدارية الأخري . " Name="textBox128">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="6.189cm" Height="0.4cm" Left="12.96cm" Top="12.189cm" Value="25- مدة الضمان بحسب طبيعة الصنف محل التعاقد . " Name="textBox129">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.589cm" Height="0.5cm" Left="2.526cm" Top="13.289cm" Value="(إذا كان الطرف الأول قد قام بسداج دفقة مقدمة , يكون البند علي النحو التالي و تستكمل البيانات المطلوبة فيه )" Name="textBox130">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="11pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="5.762cm" Height="0.4cm" Left="13.353cm" Top="13.889cm" Value="قام الطرف الأول بسداد دفعة مقدمة بمبلغ إجمالي " Name="textBox131">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="1.023cm" Height="0.4cm" Left="17.944cm" Top="14.489cm" Value="مقداره (" Name="textBox132">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="1.897cm" Height="0.4cm" Left="12.676cm" Top="14.489cm" Value=")( فقط وقدره " Name="textBox133">
