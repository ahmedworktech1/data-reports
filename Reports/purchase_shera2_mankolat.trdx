            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="1.439cm" Height="0.4cm" Left="4.026cm" Top="14.489cm" Value=") بما يعادل " Name="textBox134">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="0.923cm" Height="0.4cm" Left="18.226cm" Top="15.089cm" Value="نسبة (" Name="textBox135">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="7.526cm" Height="0.4cm" Left="7.926cm" Top="15.089cm" Value=") من قيمة التعاقد مقابل خطاب ضمنان بنكي معتمد صادر من بنك  " Name="textBox136">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="8.546cm" Height="0.4cm" Left="10.602cm" Top="15.789cm" Value="بأي قيد او شرط بالقيمة والعملة ذاتهما قدمه الطرف الثاني للطرف الأول ." Name="textBox137">
          <Style TextAlign="Left" VerticalAlign="Middle">
