          </Style>
        </TextBox>
        <TextBox Width="11.55cm" Height="0.5cm" Left="7.526cm" Top="17.289cm" Value="(إذا كان التوريد مرة واحدة , يكون البند علي النحو التالي وتستكمل البيانات المطلوبة فيه )" Name="textBox140">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="11pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="7.494cm" Height="0.4cm" Left="11.574cm" Top="17.889cm" Value="يلتزم الطرف الثاني بتوريد الكميات والأصناف محل العقد مخازن " Name="textBox141">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="5.996cm" Height="0.4cm" Left="13.076cm" Top="18.389cm" Value="وعلي نفقته الخاصة علي أن يتم التوريد خلال مدة" Name="textBox142">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.496cm" Height="0.4cm" Left="2.576cm" Top="18.889cm" Value=" كما يلتزم بأن يقدم فاتورة الأصناف الموردة من أصل وصورتين , وفي حالة اخطاره بتسليم الأصناف بتسليم الأصناف في غير هذا العنوان " Name="textBox143">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.496cm" Height="0.4cm" Left="2.576cm" Top="19.389cm" Value="يلتزم بأن بقدم فاتورة الأصناف الموردة من أصل وصوروتين , وفي خالة اخطاره بتسليم الأصناف في غير هذا العنوان يلتزم بأن يرفق مع" Name="textBox144">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="1.262cm" Height="0.4cm" Left="7.226cm" Top="17.889cm" Value="وعنوانها" Name="textBox145">
