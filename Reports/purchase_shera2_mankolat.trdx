          </Style>
        </TextBox>
        <TextBox Width="0.931cm" Height="0.4cm" Left="11.626cm" Top="40.489cm" Value="بالبنك" Name="textBox189">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.508cm" Height="0.4cm" Left="2.526cm" Top="40.989cm" Value="وفي حالة عدم وفاء الطرف الأول بالمبال المستحقة فى المواعيد المحددة يلتزم بأن يؤدي للطرف الثاني ما يعادل تكلفة التمويل لقيمة المطالبة عن" Name="textBox190">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.708cm" Height="0.4cm" Left="2.326cm" Top="41.489cm" Value="فترة التأخير وفقاً لسعر الائتمان والخصم المعلن من البنك المركزي وقت المحاسبة شريطة تقديم الطرف الثاني مستندات رسمية بالمبلغ المطالب به. " Name="textBox191">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.508cm" Height="0.4cm" Left="2.526cm" Top="43.289cm" Value="للطرف الأول زيادة أو نفص الكميات المتعاقد عليها بما لا يجاوز (15%) من كمية كل بند بذات الشروط والمواصفات والأسعار . " Name="textBox192">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="2cm" Height="0.5cm" Left="10.026cm" Top="42.689cm" Value="البند العاشر" Name="textBox193">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Size="12pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.508cm" Height="0.4cm" Left="2.526cm" Top="45.189cm" Value="لا يجوز للطرف الثاني أثناء تنفيذ هذا العقد أن يقوم بتغيير من عهد إليهم ووافق عليهم الطرف الأول بتنفيذ بعض بنوده من الباطن دون موافقة " Name="textBox194">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="3.573cm" Height="0.5cm" Left="9.145cm" Top="44.589cm" Value="البند الحادي عشر" Name="textBox195">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Size="12pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="1.881cm" Height="0.4cm" Left="17.153cm" Top="45.689cm" Value="الطرف الأول . " Name="textBox196">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.508cm" Height="0.4cm" Left="2.526cm" Top="46.189cm" Value="ويظل الطرف الثاني وحدة مسئولاً عن أية أفعال أو اعمال أو أخطاء في تنفيذ العقد , كما يلتزم باطلاع من عهد إليهم بتنفيذ بعض بنود العملية من " Name="textBox197">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="4.889cm" Height="0.4cm" Left="14.145cm" Top="46.689cm" Value="الباطن علي ما يخصهم من شروط العقد . " Name="textBox198">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="4.402cm" Height="0.4cm" Left="11.574cm" Top="48.289cm" Value="كلف الطرف الاول (السيد / السيدة )" Name="textBox199">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="3.573cm" Height="0.5cm" Left="9.226cm" Top="47.689cm" Value="البند الثاني عشر" Name="textBox200">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Size="12pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="3.102cm" Height="0.4cm" Left="5.426cm" Top="48.289cm" Value="بصفته / بصفتها الوظيفية" Name="textBox201">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="2.3cm" Height="0.4cm" Left="16.726cm" Top="48.789cm" Value="بموجب القرار رقم " Name="textBox202">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="1.35cm" Height="0.4cm" Left="13.876cm" Top="48.789cm" Value="الصادر في" Name="textBox203">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="4.402cm" Height="0.4cm" Left="7.726cm" Top="48.789cm" Value="مسئولا / مسئولة عن إدارة هذا العقد." Name="textBox204">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="3.573cm" Height="0.5cm" Left="9.226cm" Top="49.889cm" Value="البند الثالث عشر" Name="textBox205">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Size="12pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.508cm" Height="0.4cm" Left="2.526cm" Top="50.489cm" Value="أقر الطرف الثاني بحق الطرف الأول في أن يقوم بنفسه أو بواسطة أي شخص أو حهة يحددهاه الطرف الأول وبحسب طبيعة العملية المرور أو" Name="textBox206">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="11.108cm" Height="0.4cm" Left="7.926cm" Top="50.989cm" Value="التفتيش أو مراقبة التنفيذ علي محل هذا العقد وفي أي وقت دون حاجة الي إخطار أو أذن مسبق ." Name="textBox207">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="15.926cm" Height="0.4cm" Left="3.108cm" Top="51.489cm" Value="وفي حالة اكتشاف الطرف الثاني لأي التزام يحق للطرف الأول توقيع أي من الإجراءين المنصوص عليهما في البند العشرون من هذا العقد . " Name="textBox209">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="15.008cm" Height="0.4cm" Left="4.026cm" Top="53.289cm" Value="إذا تأخر الطرف اثاني في تنفيذ هذا العقد عن الميعاد المحدد به لأسباب خارجة عن ارادته يجوز للطرف الأول اعطائة مهلة لا يجاوز " Name="textBox208">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="3.573cm" Height="0.5cm" Left="9.226cm" Top="52.689cm" Value="البند الرابع عشر" Name="textBox210">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Size="12pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.508cm" Height="0.4cm" Left="2.526cm" Top="53.789cm" Value="من المدة الأصلية للتنفيذ دون توقيع مقابل تأخير , وفي حالة تأخره لأسباب راجعه إلية فيوقع عليه مقابل تأخير يحسب من بداية المهلة وفقاً للآتي :" Name="textBox211">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.408cm" Height="0.4cm" Left="2.626cm" Top="56.089cm" Value="ولا يخل توقيع مقابل التأخير بحق الطرف الأول في الرجوع علي الطرف الثاني بكامل التعويض المستحق عما أصابه من أضرار بسبب التأخير ." Name="textBox212">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="7.408cm" Height="0.4cm" Left="11.626cm" Top="57.789cm" Value="يحظر علي الطرف الثاني التنازل للغير عن العقد كلياً او جزئياً ." Name="textBox213">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="3.573cm" Height="0.5cm" Left="9.226cm" Top="57.189cm" Value="البند الخامس عشر" Name="textBox214">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Size="12pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="8.908cm" Height="0.4cm" Left="10.126cm" Top="58.289cm" Value="32- يستخدم هذا البند في حالة إذا ما كانت الأصناف الموردة لها مدة ضمان ." Name="textBox215">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="7.008cm" Height="0.4cm" Left="12.026cm" Top="58.789cm" Value="33- أدخل مدة الضمان طبقاً لكراسة الشروط والمواصفات . " Name="textBox216">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="11.708cm" Height="0.4cm" Left="7.326cm" Top="59.289cm" Value="34- أدخل العيوب الأخري التي تظهر خلال مدة الضمان وبما يتماشي مع طبيعة الصنف محل التعاقد ." Name="textBox217">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.508cm" Height="0.4cm" Left="2.526cm" Top="59.789cm" Value="35- يسنخدم هذا البند في حالة ما إذا كامن كراسة الشروط والمواصفات قد أجازت للمتعاقد أن يعهد ببعض بتود العقد لغيره من الباطن " Name="textBox218">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="3.358cm" Height="0.4cm" Left="15.676cm" Top="60.889cm" Value="37- أدخل المهلة المناسبة ." Name="textBox219">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.508cm" Height="0.4cm" Left="2.526cm" Top="60.389cm" Value="36- إعمالاً لحكم المادة (87) من اللائحة التنفيذية لقانون تنظيم التعاقدات التي تبرمها الجهات العامة الصادر بالقانون رقم  182 لسنة 2018 ." Name="textBox220">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.508cm" Height="0.4cm" Left="2.526cm" Top="61.389cm" Value="38- ادخل مقابل التإخير في تنفيذ العقد وفقاً للحدود المنصوص عليها بالمادة (98) من اللائحة التنفيذية لقانون تنظيم التعاقدات التي تبرمها" Name="textBox221">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="5.192cm" Height="0.4cm" Left="13.876cm" Top="62.389cm" Value="29- الالتزام بحكم المادة (92) من القانون ." Name="textBox222">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="2cm" Height="0.4cm" Left="17.026cm" Top="61.889cm" Value="الجهات العامة ." Name="textBox223">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="3.573cm" Height="0.5cm" Left="9.272cm" Top="63.689cm" Value="البند السادس عشر" Name="textBox224">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Size="12pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.592cm" Height="0.4cm" Left="2.526cm" Top="64.289cm" Value="أقر الطرف الثاني عند توقيعه علي هذا العقد بعدم صدور أحكام نهائية ضده في إحدي الجرائم عليها في الباب الرابع من الكتاب الثاني من قانون" Name="textBox225">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="6.615cm" Height="0.4cm" Left="12.503cm" Top="64.789cm" Value="العقوبات , أو في جرائم التهرب الضريبي , أو الجمركي . " Name="textBox226">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.592cm" Height="0.4cm" Left="2.526cm" Top="66.489cm" Value="يلتزكم الطرف الثاني والعاملين لديه بالمحافظه علي سرية وخصوصية ما يحصلون عليه من بيانات أو مستنندات أياً كانت طبيعتها تكون متعلقه" Name="textBox227">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="3.573cm" Height="0.5cm" Left="9.326cm" Top="65.889cm" Value="البند السابع عشر" Name="textBox228">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Size="12pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.592cm" Height="0.4cm" Left="2.526cm" Top="66.989cm" Value="بالعقد ويتعهد بعدم إفشائها للغير وذلك طوال مدة سريان العقد أو بعد انتهاؤه أو انهاؤه أو فسخه , ويعد الأخلال بمبدأ السرية والخصوصية بمثابة " Name="textBox229">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="8.792cm" Height="0.4cm" Left="10.326cm" Top="67.589cm" Value="إخلالاً جسيما بشروط العقد ودون الإخلال بأية عقوبة مقررة في هذ الشأن ." Name="textBox230">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="11.592cm" Height="0.4cm" Left="7.526cm" Top="75.089cm" Value="على السلطة المختصة للموافقة عليها بعد تقديم كافة المستندات والبيانات والمبررات لتسوية الخلاف." Name="textBox231">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="3.573cm" Height="0.5cm" Left="9.326cm" Top="68.889cm" Value="البند الثامن عشر" Name="textBox232">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Size="12pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.592cm" Height="0.4cm" Left="2.526cm" Top="69.489cm" Value="يلتزكم الطرف الثاني بتحمل كافة الضرائب والرسوم وغيرها التي تستحق علي هذا العقد من تاريخ توقيعه وسدادها في مواعيدها المحددة قانوناً." Name="textBox233">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.592cm" Height="0.4cm" Left="2.526cm" Top="71.589cm" Value="أتفق الطرفان على بذل أقصى جهد للالتزام ببنود التعاقد طوال مدة تنفيذه طبقاً لما اشتمل عليه وبطريقة تتفق مع ما يوجبه حسن النية، وفى حالة" Name="textBox234">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="3.573cm" Height="0.5cm" Left="9.326cm" Top="70.989cm" Value="البند التاسع عشر" Name="textBox235">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Size="12pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.592cm" Height="0.4cm" Left="2.526cm" Top="72.089cm" Value="حدوث خلاف بينهما أثناء التنفيذ يتم عقد اجتماع مع مسئول إدارة العقد أو ممثل الجهة الإدارية حسب الأحوال خلال مدة خمسة عشر يوماً من " Name="textBox236">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="7.492cm" Height="0.4cm" Left="11.626cm" Top="72.589cm" Value="تاريخ ظهور الخلاف وذلك لمناقشته، واتخاذ الإجراءات الآتية:" Name="textBox237">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="7.492cm" Height="0.4cm" Left="11.626cm" Top="73.089cm" Value="1- فحص شروط التعاقد بكل دقة واتخاذ الحل المناسب للمشكلة." Name="textBox238">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.592cm" Height="0.4cm" Left="2.526cm" Top="73.589cm" Value="2- قيام إدارة التعاقدات بإعداد تصور عن موضوع الخلاف وتقديم رأى فنى ومالى وقانونى للسلطة المختصة، ويجوز لها الاستعانة باستشارى متخصص" Name="textBox239">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="4.973cm" Height="0.4cm" Left="14.145cm" Top="74.089cm" Value="للمساعدة فى دراسة الخلاف وتقديم الرأى." Name="textBox240">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.592cm" Height="0.4cm" Left="2.538cm" Top="74.589cm" Value="3- تسوية الخلاف الذى نشأ بالطرق الودية بما لا يخل بحقوق والتزامات طرفى العقد، وإذا ترتب على التسوية الودية أى أعباء مالية فيتم عرضها" Name="textBox241">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="10.566cm" Height="0.4cm" Left="8.552cm" Top="75.589cm" Value="وفى جميع الحالات يلتزم طرفى التعاقد بالاستمرار فى تنفيذ التزاماتها الناشئة عن هذا العقد." Name="textBox242">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="3.573cm" Height="0.5cm" Left="9.326cm" Top="76.789cm" Value="البند العشرون" Name="textBox243">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Size="12pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.592cm" Height="0.4cm" Left="2.526cm" Top="77.389cm" Value="فى حالة إخلال الطرف الثانى بأى شرط جوهرى من شروط التعاقد، يحق للطرف الأول فسخ العقد أو تنفيذه على حساب الطرف الثانى وفى الحالتين" Name="textBox244">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.592cm" Height="0.4cm" Left="2.526cm" Top="77.889cm" Value="كون التأمين النهائى من حق الطرف الأول كما يكون له أن يخصم ما يستحقه وقيمة كل خسارة تلحق به من أى مبالغ مستحقة أو تستحق للطرف" Name="textBox245">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.374cm" Height="0.4cm" Left="2.744cm" Top="78.389cm" Value="الثانى لديه، وفى حالة عدم كفايتها يحق للطرف الأول خصمها من مستحقاته لدى أى جهة إدارية أخرى أياً كان سبب الاستحقاق، دون حاجة إلى" Name="textBox246">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.01cm" Height="0.4cm" Left="3.108cm" Top="78.889cm" Value="اتخاذ أى إجراءات قضائية، وذلك كله مع عدم الإخلال بحق الطرف الأول فى الرجوع على الطرف الثانى قضائياً بما لم يتمكن من استيفائه من" Name="textBox247">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="10.992cm" Height="0.4cm" Left="8.126cm" Top="79.389cm" Value="حقوق بالطريق الإدارى، ولا يحق للطرف الثانى المطالبة باسترداد ما سبق سداده للطرف الأول." Name="textBox248">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="3.573cm" Height="0.5cm" Left="9.326cm" Top="81.189cm" Value="البند الحادي العشرون " Name="textBox249">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Size="12pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="4.873cm" Height="0.4cm" Left="14.145cm" Top="81.789cm" Value="يفسخ هذا العقد تلقائياً فى الحالات الآتية:" Name="textBox250">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="15.192cm" Height="0.4cm" Left="3.826cm" Top="82.289cm" Value="1- إذا تبين أن الطرف الثانى استعمل بنفسه أو بواسطة غيره الغش أو التلاعب فى تعامله مع الطرف الاول أو فى حصوله على العقد." Name="textBox251">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="9.874cm" Height="0.4cm" Left="9.144cm" Top="82.789cm" Value="2- إذا تبين وجود تواطؤ أو ممارسات احتيال أو فساد أو احتكار من قبل الطرف الثانى." Name="textBox252">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="4.392cm" Height="0.4cm" Left="14.626cm" Top="83.289cm" Value="3- إذا أفلس الطرف الثانى أو أعسر." Name="textBox253">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="3.573cm" Height="0.5cm" Left="9.326cm" Top="84.389cm" Value="البند الثاني و العشرون " Name="textBox254">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Size="12pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="3.573cm" Height="0.5cm" Left="9.387cm" Top="86.962cm" Value="البند الثالث و العشرون " Name="textBox256">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Size="12pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.356cm" Height="0.4cm" Left="2.805cm" Top="85.162cm" Value="يسرى على هذا العقد أحكام قانون تنظيم التعاقدات التى تبرمها الجهات العامة الصادر بالقانون رقم 182 لسنة 2018 ولائحته التنفيذية الصادرة" Name="textBox258">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="10.974cm" Height="0.4cm" Left="8.187cm" Top="85.662cm" Value="بقرار وزير المالية رقم 692 لسنة 2019، وذلك فيما لم يرد بشأنه نص خاص فى هذا العقد." Name="textBox257">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.673cm" Height="0.4cm" Left="2.537cm" Top="87.562cm" Value="يتم تسوية المنازعات والخلافات التى تنشأ أثناء التنفيذ وفقاً للطرق والشروط والأحكام المنصوص عليها فى المادة (91) من قانون تنظيم التعاقدات" Name="textBox260">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.673cm" Height="0.4cm" Left="2.537cm" Top="88.062cm" Value="التى تبرمها الجهات العامة الصادر بالقانون رقم 182 لسنة 2018، مع مراعاة ضرورة الحصول على موافقة الوزير المختص فى حالة اللجوء إلى التحكيم." Name="textBox259">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="12.905cm" Height="0.4cm" Left="6.387cm" Top="89.062cm" Value="(فى حالة اللجوء إلى تسوية النزاع قضائياً وكان المتعاقد معه شخصاً اعتبارياً خاصاً يكون البند على النحو التالى)" Name="textBox262">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="9.927cm" Height="0.4cm" Left="9.333cm" Top="89.662cm" Value="تختص محاكم مجلس الدولة دون غيرها بالفصل فى أى نزاع ينشأ عن تنفيذ هذا العقد." Name="textBox263">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="12.885cm" Height="0.4cm" Left="6.375cm" Top="90.162cm" Value="(فى حالة اللجوء إلى تسوية النزاع قضائياً وكان المتعاقد معه شخصاً اعتبارياً عاماً يكون البند على النحو التالى)" Name="textBox264">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="15.173cm" Height="0.4cm" Left="4.087cm" Top="90.662cm" Value="تختص الجمعية العمومية لقسمى الفتوى والتشريع بمجلس الدولة بالفصل فى كافة المنازعات التى تنشأ عن تنفيذ أو تفسير هذا العقد." Name="textBox265">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.673cm" Height="0.4cm" Left="2.587cm" Top="96.062cm" Value="تحرر هذا العقد من أصل وأربعة نسخ، سلمت إحداها إلى الطرف الثانى، واحتفظ الطرف الأول بالأصل والنسخ الأخرى، للعمل بمقتضاها عند اللزوم." Name="textBox266">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="3.573cm" Height="0.5cm" Left="9.387cm" Top="92.162cm" Value="البند الرابع و العشرون " Name="textBox268">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Size="12pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.573cm" Height="0.4cm" Left="2.687cm" Top="92.762cm" Value="أقر الطرفان بأن العنوان المبين قرين كل منهما بصدر هذا العقد هو المحل المختار لهما، وأن جميع المكاتبات والمراسلات والإعلانات والإخطارات" Name="textBox269">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="15.631cm" Height="0.4cm" Left="3.629cm" Top="93.262cm" Value="التى توجه أو ترسل أو تعلن أو تخطر عليه تكون صحيحة ومنتجة لكافة آثارها القانونية، وفى حالة تغيير أحد الطرفين عنوانه يتعين عليه" Name="textBox270">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="14.931cm" Height="0.4cm" Left="4.287cm" Top="93.762cm" Value="إخطار الطرف الآخر بهذا العنوان الجديد خلال خمسة عشر يوماً بخطاب مسجل بعلم الوصول، وإلا اعتبرت كافة مراسلاته وإعلاناته وإخطاراته" Name="textBox271">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="6.654cm" Height="0.4cm" Left="12.564cm" Top="94.262cm" Value="على هذا العنوان صحيحة ومنتجة لكافة آثارها القانونية ." Name="textBox272">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="3.573cm" Height="0.5cm" Left="9.387cm" Top="95.462cm" Value="البند الخامس و العشرون " Name="textBox273">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Size="12pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="1.3cm" Height="0.4cm" Left="13.876cm" Top="0.789cm" Value="= Fields.TOTAL_Ltot" Name="textBox80">
          <Style VerticalAlign="Middle" />
        </TextBox>
        <TextBox Width="3.897cm" Height="0.4cm" Left="8.729cm" Top="0.789cm" Value="= Fields.tfqet" Name="textBox81">
          <Style TextAlign="Right" VerticalAlign="Middle" />
        </TextBox>
        <TextBox Width="1.774cm" Height="0.5cm" Left="8.804cm" Top="22.589cm" Value="= Fields.DLVR_LOC" Name="textBox83">
          <Style VerticalAlign="Middle" />
        </TextBox>
        <TextBox Width="1.66cm" Height="0.5cm" Left="13.184cm" Top="22.589cm" Value="= Fields.TOTAL_QTY" Name="textBox84">
          <Style VerticalAlign="Middle" />
        </TextBox>
        <TextBox Width="0.804cm" Height="0.5cm" Left="12.378cm" Top="22.589cm" Value="= Fields.TR_DT" Format="{0:dd}" Culture="en" Name="textBox87">
          <Style TextAlign="Right" VerticalAlign="Middle">
            <Font Bold="True" />
          </Style>
        </TextBox>
        <TextBox Width="0.804cm" Height="0.5cm" Left="11.574cm" Top="22.589cm" Value="= Fields.TR_DT" Format="{0:/MM/}" Culture="en" Name="textBox86">
          <Style TextAlign="Right" VerticalAlign="Middle">
            <Font Bold="True" />
          </Style>
        </TextBox>
        <TextBox Width="0.996cm" Height="0.5cm" Left="10.578cm" Top="22.589cm" Value="= Fields.TR_DT" Format="{0:yyyy}" Culture="en" Name="textBox85">
          <Style TextAlign="Right" VerticalAlign="Middle">
            <Font Bold="True" />
          </Style>
        </TextBox>
        <TextBox Width="1.386cm" Height="0.4cm" Left="11.69cm" Top="18.389cm" Value="= Fields.VAC_DAYS" Name="textBox88">
          <Style TextAlign="Center" VerticalAlign="Middle" />
        </TextBox>
      </Items>
    </ReportFooterSection>
  </Items>
