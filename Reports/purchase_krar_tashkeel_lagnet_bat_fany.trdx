              </Style>
            </TextBox>
            <TextBox Width="1.188in" Height="0.2in" Left="1.683in" Top="0.3in" Value="= Fields.Fncl_Dcsn_Dt" Format="{0:dd/MM/yyyy} " Name="textBox18">
              <Style TextAlign="Justify" VerticalAlign="Middle">
                <Font Bold="True" />
              </Style>
            </TextBox>
            <TextBox Width="1.188in" Height="0.2in" Left="1.683in" Top="0.094in" Value="= Fields.Tchncl_Dcsn_Dt" Format="{0:dd/MM/yyyy} " Name="textBox23">
              <Style TextAlign="Justify">
                <Font Bold="True" />
              </Style>
            </TextBox>
            <TextBox Width="1.494cm" Height="0.492cm" Left="8.412cm" Top="0.254cm" Value="= Format(&quot;{0:dddd}&quot;, CDate(Fields.Tchncl_Dcsn_Dt ))&#xD;&#xA;" Format="{0:yyyy/MM/dd}" Culture="ar-EG" Name="textBox31">
              <Style TextAlign="Right" VerticalAlign="Middle">
                <Font Bold="True" />
              </Style>
            </TextBox>
            <TextBox Width="1.342cm" Height="0.492cm" Left="8.412cm" Top="0.762cm" Value="= Format(&quot;{0:dddd}&quot;, CDate(Fields.Fncl_Dcsn_Dt  ))&#xD;&#xA;" Format="{0:yyyy/MM/dd}" Culture="ar-EG" Name="textBox27">
              <Style TextAlign="Right" VerticalAlign="Middle">
                <Font Bold="True" />
              </Style>
            </TextBox>
            <TextBox Width="5.04in" Height="0.7in" Left="0.4in" Top="0.634in" Value="= Fields.CMMTTE_RMRK_DCSN" Name="textBox28">
              <Style TextAlign="Right">
                <Font Bold="True" />
              </Style>
            </TextBox>
            <TextBox Width="3.806cm" Height="0.496cm" Left="0.922cm" Top="3.703cm" Value=" (                              ) " Name="textBox72">
