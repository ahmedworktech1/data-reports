<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource1" Width="19.517cm" Name="Report1" xmlns="http://schemas.telerik.com/reporting/2023/1.0">
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="glxsandoaaAhmedHasan" SelectCommand="WITH &#xD;&#xA;&#xD;&#xA;-- الفترة&#xD;&#xA;ReportPeriod AS (&#xD;&#xA;    SELECT &#xD;&#xA;        MAX(CAST(G.fPRD_No AS VARCHAR(20))) AS fprd_no,&#xD;&#xA;        MAX(CAST(G.tPRD_NO AS VARCHAR(20))) AS tPRD_NO&#xD;&#xA;    FROM GLBDG G&#xD;&#xA;    WHERE G.CHKTOT = '0'&#xD;&#xA;),&#xD;&#xA;&#xD;&#xA;-- 2. تفاصيل الإيرادات (ديناميكي من appcodes)&#xD;&#xA;RevenueDetails AS (&#xD;&#xA;    SELECT &#xD;&#xA;        A.SEQ AS Seq,&#xD;&#xA;        A.DSCR_AR AS Text,&#xD;&#xA;        CAST(ISNULL(SUM(G.BDG), 0) AS DECIMAL(18,2)) AS Amount,&#xD;&#xA;        10 + A.SEQ AS SortOrder&#xD;&#xA;    FROM GLMF M&#xD;&#xA;    INNER JOIN appcodes A &#xD;&#xA;        ON A.SEQ = M.BDG_CTG &#xD;&#xA;       AND A.ID = 63&#xD;&#xA;    LEFT JOIN GLBDG G &#xD;&#xA;        ON G.ACC_NO = M.ACC_NO &#xD;&#xA;       AND G.CHKTOT = '0'&#xD;&#xA;    WHERE M.ACC_NO LIKE '40%'&#xD;&#xA;      AND M.BDG_CTG IS NOT NULL&#xD;&#xA;    GROUP BY A.SEQ, A.DSCR_AR&#xD;&#xA;),&#xD;&#xA;&#xD;&#xA;-- 3. تفاصيل المصروفات (ديناميكي من appcodes)&#xD;&#xA;ExpenseDetails AS (&#xD;&#xA;    SELECT &#xD;&#xA;        A.SEQ AS Seq,&#xD;&#xA;        A.DSCR_AR AS Text,&#xD;&#xA;        CAST(ISNULL(SUM(G.BDG), 0) AS DECIMAL(18,2)) AS Amount,&#xD;&#xA;        110 + A.SEQ AS SortOrder&#xD;&#xA;    FROM GLMF M&#xD;&#xA;    INNER JOIN appcodes A &#xD;&#xA;        ON A.SEQ = M.BDG_CTG &#xD;&#xA;       AND A.ID = 63&#xD;&#xA;    LEFT JOIN GLBDG G &#xD;&#xA;        ON G.ACC_NO = M.ACC_NO &#xD;&#xA;       AND G.CHKTOT = '0'&#xD;&#xA;    WHERE M.ACC_NO LIKE '30%'&#xD;&#xA;      AND M.BDG_CTG IS NOT NULL&#xD;&#xA;    GROUP BY A.SEQ, A.DSCR_AR&#xD;&#xA;),&#xD;&#xA;&#xD;&#xA;-- 4. التجميع النهائي&#xD;&#xA;CombinedReport AS (&#xD;&#xA;    -- القسم 1: إجماليات الموازنة (إيرادات / مصروفات) + الفائض&#xD;&#xA;    SELECT NULL AS SerialNo, 'إجمالي الإيرادات (موازنة)' AS StatementText, (SELECT SUM(Amount) FROM RevenueDetails) AS Amount, 1 AS SortOrder, 'BudgetTotal' AS SectionType&#xD;&#xA;    UNION ALL&#xD;&#xA;    SELECT NULL, 'إجمالي المصروفات (موازنة)', (SELECT SUM(Amount) FROM ExpenseDetails), 2, 'BudgetTotal'&#xD;&#xA;    UNION ALL&#xD;&#xA;    SELECT NULL, 'الفائض / (العجز)', (SELECT SUM(Amount) FROM RevenueDetails) - (SELECT SUM(Amount) FROM ExpenseDetails), 3, 'Balance'&#xD;&#xA;    &#xD;&#xA;    -- القسم 2: تفاصيل الإيرادات (بدون الفعلي)&#xD;&#xA;    UNION ALL&#xD;&#xA;    SELECT NULL, 'أولاً: الإيرادات', NULL, 100, 'SectionTitle'&#xD;&#xA;    UNION ALL&#xD;&#xA;    SELECT Seq, Text, Amount, 100 + Seq, 'Detail' FROM RevenueDetails&#xD;&#xA;    UNION ALL&#xD;&#xA;    SELECT NULL, 'إجمالي الإيرادات (موازنة)', SUM(Amount), 150, 'BudgetTotal' FROM RevenueDetails&#xD;&#xA;    &#xD;&#xA;    -- تكرار إجماليات الموازنة في بداية صفحة المصروفات&#xD;&#xA;    UNION ALL&#xD;&#xA;    SELECT NULL, 'إجمالي الإيرادات (موازنة)', (SELECT SUM(Amount) FROM RevenueDetails), 190, 'BudgetTotal'&#xD;&#xA;    UNION ALL&#xD;&#xA;    SELECT NULL, 'إجمالي المصروفات (موازنة)', (SELECT SUM(Amount) FROM ExpenseDetails), 191, 'BudgetTotal'&#xD;&#xA;    UNION ALL&#xD;&#xA;    SELECT NULL, 'الفائض / (العجز)', (SELECT SUM(Amount) FROM RevenueDetails) - (SELECT SUM(Amount) FROM ExpenseDetails), 192, 'Balance'&#xD;&#xA;    &#xD;&#xA;    -- فاصل فارغ بين جدول الإجماليات وجدول المصروفات&#xD;&#xA;    UNION ALL&#xD;&#xA;    SELECT NULL, NULL, NULL, 195, 'Spacer'&#xD;&#xA;    &#xD;&#xA;    -- القسم 3: تفاصيل المصروفات (بدون الفعلي)&#xD;&#xA;    UNION ALL&#xD;&#xA;    SELECT NULL, 'ثانياً: المصروفات', NULL, 200, 'SectionTitle'&#xD;&#xA;    UNION ALL&#xD;&#xA;    SELECT Seq, Text, Amount, 200 + Seq, 'Detail' FROM ExpenseDetails&#xD;&#xA;    UNION ALL&#xD;&#xA;    SELECT NULL, 'إجمالي المصروفات (موازنة)', SUM(Amount), 250, 'BudgetTotal' FROM ExpenseDetails&#xD;&#xA;)&#xD;&#xA;&#xD;&#xA;-- النهائي&#xD;&#xA;SELECT &#xD;&#xA;    CR.SerialNo, &#xD;&#xA;    CR.StatementText, &#xD;&#xA;    CR.Amount,&#xD;&#xA;    CR.SectionType,&#xD;&#xA;    RP.fprd_no,&#xD;&#xA;    RP.tPRD_NO,&#xD;&#xA;    CR.SortOrder,&#xD;&#xA;    CASE &#xD;&#xA;        WHEN CR.SortOrder BETWEEN 1 AND 3 THEN 1&#xD;&#xA;        WHEN CR.SortOrder BETWEEN 100 AND 150 THEN 2&#xD;&#xA;        WHEN CR.SortOrder BETWEEN 190 AND 250 THEN 3&#xD;&#xA;        ELSE 0 &#xD;&#xA;    END AS ReportSection&#xD;&#xA;FROM CombinedReport CR&#xD;&#xA;CROSS JOIN ReportPeriod RP&#xD;&#xA;    WHERE 1=1 &#xD;&#xA;&#xD;&#xA;ORDER BY CR.SortOrder;" Name="sqlDataSource1" />
  </DataSources>
