  <Groups>
    <Group Name="groupReportSection">
      <GroupHeader>
        <GroupHeaderSection Height="0cm" Name="groupHeaderSectionRS">
          <Bindings>
            <Binding Path="PageBreak" Expression="= IIf(Fields.ReportSection = 3, &quot;Before&quot;, &quot;None&quot;)" />
