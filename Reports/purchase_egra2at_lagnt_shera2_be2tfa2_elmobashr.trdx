<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource1" Width="17cm" Name="اجرءات لجنة شراء بالاتفاق المباشر" xmlns="http://schemas.telerik.com/reporting/2023/1.0">
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="azxsandoaa" SelectCommand=";WITH ALLMEMBERS AS (&#xD;&#xA;  -- 🧩 الأعضاء الداخليين&#xD;&#xA;  SELECT &#xD;&#xA;    A.TR_NO,&#xD;&#xA;&#x9;A.FNCL_TR_NO,&#xD;&#xA;    A.PURCHAS_NO,&#xD;&#xA;    BOSS.EMP_NAME AS BOSS,&#xD;&#xA;    BOSS.JOB_CD AS BOSS_DSC,&#xD;&#xA;    L.DSCR_AR AS MEMPER_DWLA,&#xD;&#xA;    E.EMP_NAME AS MEMBERNAME,&#xD;&#xA;    E.JOB_CD&#xD;&#xA;  FROM AZTRH A&#xD;&#xA;  LEFT JOIN PYEMPMF_H AS BOSS ON BOSS.EMP_NO = A.CMMTTE_CHRMN_DCSN&#xD;&#xA;  LEFT JOIN AZLISTS AS L ON TRY_CAST(REPLACE(REPLACE(COALESCE(A.CMMTTE_EXTRNL_MMBRS_DCSN, ''), '''', ''), '&quot;', '') AS INT) = L.CODE &#xD;&#xA;    AND L.REC_TYPE = 61&#xD;&#xA;  OUTER APPLY (&#xD;&#xA;    SELECT VALUE&#xD;&#xA;    FROM STRING_SPLIT(REPLACE(REPLACE(COALESCE(A.CMMTTE_INTRNL_MMBRS_DCSN, ''), '''', ''), '&quot;', ''), ',')&#xD;&#xA;    WHERE VALUE &lt;&gt; '' AND ISNUMERIC(VALUE) = 1&#xD;&#xA;  ) AS S&#xD;&#xA;  LEFT JOIN PYEMPMF_H AS E ON TRY_CAST(S.VALUE AS INT) = E.EMP_NO&#xD;&#xA;  WHERE A.TR_TY = '119' AND E.EMP_NAME IS NOT NULL&#xD;&#xA;&#xD;&#xA;  UNION ALL&#xD;&#xA;&#xD;&#xA;  -- 🧩 الأعضاء الخارجيين&#xD;&#xA;  SELECT &#xD;&#xA;    A.TR_NO,&#xD;&#xA;&#x9;A.FNCL_TR_NO, &#xD;&#xA;&#x9;A.PURCHAS_NO,&#xD;&#xA;    BOSS.EMP_NAME AS BOSS,&#xD;&#xA;    BOSS.JOB_CD AS BOSS_DSC,&#xD;&#xA;    L.DSCR_AR AS MEMPER_DWLA,&#xD;&#xA;    EL.DSCR_AR AS MEMBERNAME,&#xD;&#xA;    NULL AS JOB_CD&#xD;&#xA;  FROM AZTRH A&#xD;&#xA;  LEFT JOIN PYEMPMF_H AS BOSS ON BOSS.EMP_NO = A.CMMTTE_CHRMN_OPN&#xD;&#xA;  LEFT JOIN AZLISTS AS L ON TRY_CAST(REPLACE(REPLACE(COALESCE(A.CMMTTE_EXTRNL_MMBRS_DCSN, ''), '''', ''), '&quot;', '') AS INT) = L.CODE &#xD;&#xA;    AND L.REC_TYPE = 61&#xD;&#xA;  OUTER APPLY (&#xD;&#xA;    SELECT VALUE&#xD;&#xA;    FROM STRING_SPLIT(REPLACE(REPLACE(COALESCE(A.CMMTTE_EXTRNL_MMBRS_DCSN, ''), '''', ''), '&quot;', ''), ',')&#xD;&#xA;    WHERE VALUE &lt;&gt; '' AND ISNUMERIC(VALUE) = 1&#xD;&#xA;  ) AS S&#xD;&#xA;  LEFT JOIN AZLISTS AS EL ON TRY_CAST(S.VALUE AS INT) = EL.CODE AND EL.REC_TYPE = 61&#xD;&#xA;  WHERE A.TR_TY = '119' AND EL.DSCR_AR IS NOT NULL&#xD;&#xA;),&#xD;&#xA;&#xD;&#xA;-- 🔹 جلب اسم الوظيفة لكل عضو&#xD;&#xA;WITHJOBNAME AS (&#xD;&#xA;  SELECT &#xD;&#xA;    A.TR_NO,&#xD;&#xA;&#x9;A.FNCL_TR_NO, &#xD;&#xA;&#x9;A.PURCHAS_NO,&#xD;&#xA;    A.BOSS,&#xD;&#xA;    A.BOSS_DSC,&#xD;&#xA;    A.MEMPER_DWLA,&#xD;&#xA;    A.MEMBERNAME,&#xD;&#xA;    A.JOB_CD,&#xD;&#xA;    J.DSCR_AR AS JOBNAME&#xD;&#xA;  FROM ALLMEMBERS A&#xD;&#xA;  LEFT JOIN PYX_SANDOAA..APPCODES J ON J.ID = 12 AND J.SEQ = A.JOB_CD&#xD;&#xA;),&#xD;&#xA;&#xD;&#xA;-- 🧮 ترتيب الأعضاء&#xD;&#xA;NUMBERED AS (&#xD;&#xA;  SELECT &#xD;&#xA;    TR_NO,&#xD;&#xA;&#x9;FNCL_TR_NO,&#xD;&#xA;    PURCHAS_NO,&#xD;&#xA;    BOSS,&#xD;&#xA;    BOSS_DSC,&#xD;&#xA;    MEMPER_DWLA,&#xD;&#xA;    MEMBERNAME,&#xD;&#xA;    JOBNAME,&#xD;&#xA;    ROW_NUMBER() OVER (PARTITION BY TR_NO ORDER BY MEMBERNAME) AS RN&#xD;&#xA;  FROM WITHJOBNAME&#xD;&#xA;),&#xD;&#xA;&#xD;&#xA;-- 🧾 تلخيص الأعضاء حسب كل معاملة&#xD;&#xA;COMMITTEEDATA AS (&#xD;&#xA;  SELECT &#xD;&#xA;    TR_NO,&#xD;&#xA;&#x9;FNCL_TR_NO,&#xD;&#xA;    PURCHAS_NO,&#xD;&#xA;    MAX(BOSS) AS BOSS,&#xD;&#xA;    MAX(BOSS_DSC) AS BOSS_DSC,&#xD;&#xA;    MAX(MEMPER_DWLA) AS MEMPER_DWLA,&#xD;&#xA;    MAX(CASE WHEN RN = 1 THEN MEMBERNAME END) AS MEMBER1,&#xD;&#xA;    MAX(CASE WHEN RN = 1 THEN JOBNAME END) AS MEMBER1JOB,&#xD;&#xA;    MAX(CASE WHEN RN = 2 THEN MEMBERNAME END) AS MEMBER2,&#xD;&#xA;    MAX(CASE WHEN RN = 2 THEN JOBNAME END) AS MEMBER2JOB,&#xD;&#xA;    MAX(CASE WHEN RN = 3 THEN MEMBERNAME END) AS MEMBER3,&#xD;&#xA;    MAX(CASE WHEN RN = 3 THEN JOBNAME END) AS MEMBER3JOB,&#xD;&#xA;    MAX(CASE WHEN RN = 4 THEN MEMBERNAME END) AS MEMBER4,&#xD;&#xA;    MAX(CASE WHEN RN = 4 THEN JOBNAME END) AS MEMBER4JOB&#xD;&#xA;  FROM NUMBERED&#xD;&#xA;  GROUP BY TR_NO , FNCL_TR_NO, PURCHAS_NO&#xD;&#xA;),&#xD;&#xA;&#xD;&#xA;-- 💰 بيانات الرأس&#xD;&#xA;HEADERDATA AS (&#xD;&#xA;  SELECT &#xD;&#xA;    TR_NO,&#xD;&#xA;    PURCHAS_NO,&#xD;&#xA;    TCHNCL_DCSN_DT,&#xD;&#xA;    ACC_NM&#xD;&#xA;  FROM AZTRH&#xD;&#xA;  WHERE TR_TY = '119'&#xD;&#xA;)&#xD;&#xA;&#xD;&#xA;-- 🔹 الاستعلام النهائي - عرض كل الأصناف مع ضمان عدم التكرار&#xD;&#xA;SELECT DISTINCT&#xD;&#xA;  D.TR_NO,&#xD;&#xA;  D.PURCHAS_NO,&#xD;&#xA;  D.LN_NO,&#xD;&#xA;  D.TR_DT,&#xD;&#xA;  D.ITM_CD,&#xD;&#xA;  ITM.ITM_NM_AR AS ITEM_NAME,&#xD;&#xA;  ITM.ITM_CLS1 AS ITEM_SPECS,&#xD;&#xA;  D.QTY,&#xD;&#xA;  PK.PK_NM_AR AS UNIT_NAME,&#xD;&#xA;  D.PKPRC AS ESTIMATED_PRICE,&#xD;&#xA;  CAST(D.PKPRC AS INT) AS PKPRC_GNEH,&#xD;&#xA;  CAST(ROUND((D.PKPRC - FLOOR(D.PKPRC)) * 100, 0) AS INT) AS PKPRC_QERSH,&#xD;&#xA;  (D.QTY * D.PKPRC) AS LINE_TOTAL,&#xD;&#xA;  D.SAL_DISC_PRCNT AS DISCOUNT_PERCENT,&#xD;&#xA;  D.RMRK AS NOTES,&#xD;&#xA;  D.RMRK1,&#xD;&#xA;  D.ENTEREDBY,&#xD;&#xA;  LST.DSCR_AR AS REQUESTING_DEPT,&#xD;&#xA;  D.LOC,&#xD;&#xA;  D.TR_TY,&#xD;&#xA;  H.FNCL_TR_NO,&#xD;&#xA;  -- بيانات اللجنة&#xD;&#xA;  CD.BOSS AS BOSS_NAME,&#xD;&#xA;  CD.BOSS_DSC AS BOSS_JOB,&#xD;&#xA;  CD.MEMPER_DWLA AS STATE_MEMBER,&#xD;&#xA;  CD.MEMBER1,&#xD;&#xA;  CD.MEMBER1JOB,&#xD;&#xA;  CD.MEMBER2,&#xD;&#xA;  CD.MEMBER2JOB,&#xD;&#xA;  CD.MEMBER3,&#xD;&#xA;  CD.MEMBER3JOB,&#xD;&#xA;  CD.MEMBER4,&#xD;&#xA;  CD.MEMBER4JOB,&#xD;&#xA;  -- بيانات الرأس&#xD;&#xA;  HD.TCHNCL_DCSN_DT AS TECHNICAL_DATE,&#xD;&#xA;  HD.ACC_NM AS SUPPLIER_NAME,&#xD;&#xA;  -- الإجمالي الكلي للمعاملة&#xD;&#xA;  (SELECT SUM(QTY * PKPRC) FROM AZTRD WHERE TR_NO = D.TR_NO AND TR_TY = '119') AS TOTAL_VALUE,&#xD;&#xA;  CAST((SELECT SUM(QTY * PKPRC) FROM AZTRD WHERE TR_NO = D.TR_NO AND TR_TY = '119') AS INT) AS EL_GNEH,&#xD;&#xA;  CAST(ROUND(((SELECT SUM(QTY * PKPRC) FROM AZTRD WHERE TR_NO = D.TR_NO AND TR_TY = '119') - &#xD;&#xA;    FLOOR((SELECT SUM(QTY * PKPRC) FROM AZTRD WHERE TR_NO = D.TR_NO AND TR_TY = '119'))) * 100, 0) AS INT) AS EL_QERSH&#xD;&#xA;FROM AZTRD D&#xD;&#xA;LEFT JOIN AZITMS ITM ON ITM.ITM_CD = D.ITM_CD&#xD;&#xA;LEFT JOIN AZPKGDEF PK ON PK.PKID = D.PKID&#xD;&#xA;LEFT JOIN AZLISTS LST ON LST.CODE = D.CAROWNER AND LST.REC_TYPE = '2'&#xD;&#xA;LEFT JOIN AZTRH H ON H.LOC = D.LOC AND H.TR_TY = D.TR_TY AND H.TR_NO = D.TR_NO&#xD;&#xA;LEFT JOIN COMMITTEEDATA CD ON CD.TR_NO = D.TR_NO&#xD;&#xA;LEFT JOIN HEADERDATA HD ON HD.TR_NO = D.TR_NO&#xD;&#xA;WHERE D.TR_TY = '119'&#xD;&#xA;ORDER BY D.TR_NO, D.LN_NO;" Name="sqlDataSource1" />
  </DataSources>
