        <TextBox Width="3.057cm" Height="0.852cm" Left="0.18mm" Top="0mm" Value="= IsNull( sum(Fields.AFaVl),0) - (IsNull( sum(Fields.BgDPrc),0)+IsNull( sum(Fields.CaddAcc),0)-sum(IsNull( Fields.DSP_DPREXP,0))+IsNull( sum(Fields.CdspAcc),0)+IsNull( sum(Fields.Dprexp1),0)+IsNull( sum(Fields.QPYrdPrc),0))" Format="{0:N2}" Multiline="False" Name="textBox35">
