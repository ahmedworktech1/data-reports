<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource1" Width="17cm" Name="AztrhRequestInstanceLogs" xmlns="http://schemas.telerik.com/reporting/2023/1.0">
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="azxsandoaa" SelectCommand="SELECT t.Id, t.TransitionDate, t.Reason, t1.NameArabic AS TriggerName, s.NameArabic AS FromStateName,&#xD;&#xA;       s0.NameArabic AS ToStateName, t2.FullName AS ExecuterName&#xD;&#xA;FROM dbo.AZTRH&#xD;&#xA;    INNER JOIN erpx_sandoaa3_br.Workflow.RequestInstanceLogs t&#xD;&#xA;        ON AZTRH.RequestId     = t.RequestInstanceId&#xD;&#xA;    LEFT JOIN erpx_sandoaa3_br.Workflow.Transitions t0&#xD;&#xA;        ON t.TransitionId   = t0.Id&#xD;&#xA;    LEFT JOIN erpx_sandoaa3_br.Workflow.States s&#xD;&#xA;        ON t0.FromStateId   = s.Id&#xD;&#xA;    LEFT JOIN erpx_sandoaa3_br.Workflow.States s0&#xD;&#xA;        ON t0.ToStateId     = s0.Id&#xD;&#xA;    LEFT JOIN erpx_sandoaa3_br.Workflow.Triggers t1&#xD;&#xA;        ON t0.TriggerId     = t1.Id&#xD;&#xA;    LEFT JOIN erpx_sandoaa3_br.Brca.BrcaUsers t2&#xD;&#xA;        ON t.ExecuterUserId = t2.Id&#xD;&#xA;where 1=1" Name="sqlDataSource1" />
  </DataSources>
  <Items>
    <PageHeaderSection Height="0.8cm" Name="pageHeaderSection1">
      <Items>
        <TextBox Width="2.8cm" Height="0.8cm" Left="0cm" Top="0cm" Value="السبب" Name="headerReason">
          <Style BackgroundColor="84, 110, 179" Color="White" TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" />
          </Style>
        </TextBox>
        <TextBox Width="2.8cm" Height="0.8cm" Left="2.8cm" Top="0cm" Value="تاريخ الإنتقال" Name="headerDate">
          <Style BackgroundColor="84, 110, 179" Color="White" TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" />
          </Style>
        </TextBox>
        <TextBox Width="3cm" Height="0.8cm" Left="5.6cm" Top="0cm" Value="المنفذ" Name="headerExecuter">
          <Style BackgroundColor="84, 110, 179" Color="White" TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" />
          </Style>
        </TextBox>
        <TextBox Width="2.8cm" Height="0.8cm" Left="8.6cm" Top="0cm" Value="إلى حالة" Name="headerToState">
          <Style BackgroundColor="84, 110, 179" Color="White" TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" />
          </Style>
        </TextBox>
        <TextBox Width="2.8cm" Height="0.8cm" Left="11.4cm" Top="0cm" Value="من حالة" Name="headerFromState">
          <Style BackgroundColor="84, 110, 179" Color="White" TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" />
          </Style>
        </TextBox>
        <TextBox Width="2.8cm" Height="0.8cm" Left="14.2cm" Top="0cm" Value="الإجراء" Name="headerTrigger">
          <Style BackgroundColor="84, 110, 179" Color="White" TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" />
          </Style>
        </TextBox>
      </Items>
    </PageHeaderSection>
    <DetailSection Height="0.8cm" Name="detailSection1">
      <Items>
        <TextBox Width="2.8cm" Height="0.6cm" Left="0cm" Top="0.1cm" Value="= Fields.Reason" Name="txtReason">
          <Style TextAlign="Center" VerticalAlign="Middle" />
        </TextBox>
        <TextBox Width="2.8cm" Height="0.6cm" Left="2.8cm" Top="0.1cm" Value="= Fields.TransitionDate.ToString('yyyy/MM/dd')" Name="txtDate">
          <Style TextAlign="Center" VerticalAlign="Middle" />
        </TextBox>
        <TextBox Width="3cm" Height="0.6cm" Left="5.6cm" Top="0.1cm" Value="= Fields.ExecuterName" Name="txtExecuter">
          <Style TextAlign="Center" VerticalAlign="Middle" />
        </TextBox>
        <TextBox Width="2.8cm" Height="0.6cm" Left="8.6cm" Top="0.1cm" Value="= Fields.ToStateName" Name="txtToState">
          <Style TextAlign="Center" VerticalAlign="Middle" />
        </TextBox>
        <TextBox Width="2.8cm" Height="0.6cm" Left="11.4cm" Top="0.1cm" Value="= Fields.FromStateName" Name="txtFromState">
          <Style TextAlign="Center" VerticalAlign="Middle" />
        </TextBox>
        <TextBox Width="2.8cm" Height="0.6cm" Left="14.2cm" Top="0.1cm" Value="= Fields.TriggerName" Name="txtTrigger">
          <Style TextAlign="Center" VerticalAlign="Middle" />
        </TextBox>
      </Items>
    </DetailSection>
    <PageFooterSection Height="0.132cm" Name="pageFooterSection1" />
  </Items>
  <PageSettings PaperKind="A4" Landscape="False">
    <Margins>
      <MarginsU Left="2cm" Right="2cm" Top="2cm" Bottom="2cm" />
    </Margins>
  </PageSettings>
  <StyleSheet>
    <StyleRule>
      <Style>
        <Padding Left="2pt" Right="2pt" />
      </Style>
      <Selectors>
        <TypeSelector Type="TextItemBase" />
        <TypeSelector Type="HtmlTextBox" />
      </Selectors>
    </StyleRule>
  </StyleSheet>
</Report>