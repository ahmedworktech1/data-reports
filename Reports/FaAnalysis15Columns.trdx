            <TextBox Width="0.708in" Height="0.483in" Left="0.799in" Top="0in" Value="= IsNull( sum(Fields.VAL15_1),0)" Format="{0:##.000;(##.000);}" CanGrow="False" Multiline="True" TextWrap="True" Name="textBox81">
              <Style BackgroundColor="255, 215, 255" TextAlign="Center" VerticalAlign="Middle">
