<Report DataSourceName="sqlDataSource1" Width="29.7cm" Name="QueryGlJrnl1" xmlns="http://schemas.telerik.com/reporting/2021/1.0">
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="STARData" SelectCommand=" SELECT GLJRNLD.TR_NO,GLJRNLD.TR_DT,DB_VL,CR_VL,CUR_VL,GLJRNLD.JRN_CD,CASE WHEN LN_TY &gt;0 THEN CUR_VL ELSE 0 END AS DB_CUR, RATE,GLJRNLH.TR_DT,&#xD;&#xA;CASE WHEN LN_TY &lt;0 THEN CUR_VL ELSE 0 END AS CR_CUR, ACC_NO,(SELECT ACC_NM_AR FROM GLMF WHERE GLMF.ACC_NO = GLJRNLD.ACC_NO) AS ACC_NM,&#xD;&#xA;TRY_CONVERT(DATETIME, '01/01/1901', 102)  AS FROM_date, &#xD;&#xA;TRY_CONVERT(DATETIME, '01/01/1902', 102) AS TO_date&#xD;&#xA; from gljrnld&#xD;&#xA; INNER JOIN gljrnlh&#xD;&#xA;ON  gljrnld.jrn_cd = gljrnlh.jrn_cd and gljrnld.tr_no = gljrnlh.tr_no&#xD;&#xA; WHERE (1=1)&#xD;&#xA; ORDER BY GLJRNLD.TR_NO&#xD;&#xA;" Name="sqlDataSource1" />
  </DataSources>
