            </TextBox>
            <TextBox Width="6cm" Height="0.5cm" Left="10.248cm" Top="2.299cm" Value="إنعقدت اللجنة فى المكان والزمان المحددان بعاليه" Name="textBox31">
              <Style TextAlign="Right" VerticalAlign="Middle">
                <Font Bold="True" Underline="False" />
              </Style>
            </TextBox>
            <TextBox Width="13cm" Height="0.5cm" Left="3.248cm" Top="2.799cm" Value="تأكدت اللجنة من أن الإدارة العامة للتعاقدات والمشتريات قامت بتسليم جميع العطاءات التي وردت إليها ووضعها" Name="textBox32">
              <Style TextAlign="Right" VerticalAlign="Middle">
                <Font Bold="True" Underline="False" />
              </Style>
            </TextBox>
            <TextBox Width="6.45cm" Height="0.5cm" Left="9.798cm" Top="3.3cm" Value="داخل صندوق العطاءات فى اليوم المحدد لفتح المظاريف" Name="textBox33">
              <Style TextAlign="Right" VerticalAlign="Middle">
                <Font Bold="True" Underline="False" />
              </Style>
            </TextBox>
            <TextBox Width="9.699cm" Height="0.5cm" Left="6.548cm" Top="3.8cm" Value=" قامت اللجنة بفتح صندوق العطاءات وتم حصر العطاءات المقدمه وكانت جملتها عدد" Name="textBox35">
              <Style TextAlign="Right" VerticalAlign="Middle">
                <Font Bold="True" Underline="False" />
              </Style>
            </TextBox>
            <TextBox Width="1.943cm" Height="0.5cm" Left="2.16cm" Top="3.8cm" Value="عطاء و تأكددت" Name="textBox36">
              <Style TextAlign="Left" VerticalAlign="Middle">
                <Font Bold="True" Underline="False" />
              </Style>
            </TextBox>
            <TextBox Width="7.85cm" Height="0.5cm" Left="8.348cm" Top="4.3cm" Value=" أن لكل عطاء مظروفين أحدهما للعرض الفنى والآخر للعرض المالي" Name="textBox37">
              <Style TextAlign="Right" VerticalAlign="Middle">
                <Font Bold="True" Underline="False" />
              </Style>
            </TextBox>
            <TextBox Width="12.15cm" Height="0.5cm" Left="4.048cm" Top="4.8cm" Value="قامت اللجنة بفض العطاءات الفنية بالتتابع وإعطائها رقم مسلسل وترقيم الأوراق المكون منها ، وتم تدوين" Name="textBox38">
              <Style TextAlign="Right" VerticalAlign="Middle">
                <Font Bold="True" Underline="False" />
              </Style>
            </TextBox>
            <TextBox Width="11.25cm" Height="0.5cm" Left="4.948cm" Top="5.3cm" Value="نفس الرقم على المظروف المالي دون فتحه وإعادته إلى الصندوق بعد التوقيــــــــــع عاليــــــــــه" Name="textBox39">
              <Style TextAlign="Right" VerticalAlign="Middle">
                <Font Bold="True" Underline="False" />
              </Style>
            </TextBox>
            <TextBox Width="11.75cm" Height="0.5cm" Left="4.448cm" Top="5.801cm" Value="قامت اللجنة بقراءة إسم صاحب العطاء وقيمة التأمين المؤقت ونوعه وغيرها من محتويات المظروف" Name="textBox40">
              <Style TextAlign="Right" VerticalAlign="Middle">
                <Font Bold="True" Underline="False" />
              </Style>
            </TextBox>
            <TextBox Width="11.45cm" Height="0.5cm" Left="4.748cm" Top="6.301cm" Value=" الفنى على الحاضرين من مقدمي العطاءات أو مندوبيهم وتم التأشير عليه من أعضاء ورئيس اللجنة" Name="textBox41">
              <Style TextAlign="Right" VerticalAlign="Middle">
                <Font Bold="True" Underline="False" />
              </Style>
            </TextBox>
            <TextBox Width="2.992cm" Height="0.499cm" Left="12.156cm" Top="6.801cm" Value=" و على كل ورقة بداخله " Name="textBox42">
              <Style TextAlign="Left" VerticalAlign="Middle">
                <Font Bold="True" Underline="False" />
              </Style>
            </TextBox>
            <TextBox Width="9.65cm" Height="0.5cm" Left="6.548cm" Top="7.3cm" Value=":  تم تسليم التأمينات المؤقته لمندوب الحسابات بعد توقيعه بالإستلام وبيانها كالآتي " Name="textBox43">
              <Style TextAlign="Right" VerticalAlign="Middle">
                <Font Bold="True" Underline="False" />
              </Style>
            </TextBox>
