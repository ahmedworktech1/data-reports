            </TextBox>
            <TextBox Width="10.954cm" Height="0.5cm" Left="4.948cm" Top="11.9cm" Value="قامت اللجنـــة بمراجعــة العينـــات المقدمــــه مـــن العطــــاءات علـــى الكشــف التـي وردت بــه" Name="textBox64">
              <Style TextAlign="Left" VerticalAlign="Middle">
                <Font Bold="True" Underline="False" />
              </Style>
            </TextBox>
            <TextBox Width="4.654cm" Height="0.5cm" Left="10.198cm" Top="12.4cm" Value=" وتأكدت من سلامة اختامها وعلاماتها " Name="textBox65">
              <Style TextAlign="Left" VerticalAlign="Middle">
                <Font Bold="True" Underline="False" />
              </Style>
