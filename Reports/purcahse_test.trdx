                <Font Bold="True" Underline="False" />
              </Style>
            </TextBox>
            <TextBox Width="12.55cm" Height="0.5cm" Left="3.352cm" Top="12.901cm" Value="تم إرفاق العطــــــاءات الـــــواردة و جميــــع الأوراق الخاصــــة بهـــــــأ و المظـــاريف التــــى وردت فيهــــا" Name="textBox67">
              <Style TextAlign="Right" VerticalAlign="Middle">
                <Font Bold="True" Underline="False" />
              </Style>
            </TextBox>
            <TextBox Width="3.404cm" Height="0.5cm" Left="11.448cm" Top="13.507cm" Value=" و مراجعتـــــها طبقا للقانون " Name="textBox68">
