    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="glx20231" SelectCommand="Select 'رصيد بدايه الفتره' as acc_nm,&#xD;&#xA;sum(case when  prd like '%00' and acc_no like '21%' then (CR_VL - DB_VL) else 0 end) as s1,&#xD;&#xA;sum(case when  prd like '%00' and acc_no like '231%' then (CR_VL - DB_VL) else 0 end) as s2,&#xD;&#xA;sum(case when  prd like '%00' and acc_no like '232%' then (CR_VL - DB_VL) else 0 end) as s3,&#xD;&#xA;sum(case when  prd like '%00' and acc_no like '233%' then (CR_VL - DB_VL) else 0 end) as s4,&#xD;&#xA;sum(case when  prd like '%00' and (acc_no like '231%' or acc_no like '232%' or acc_no like '233%') &#xD;&#xA;then (CR_VL - DB_VL) else 0 end) as sm1,&#xD;&#xA;0 as s5,&#xD;&#xA;sum(case when  prd like '%00' and acc_no like '241%' then (CR_VL - DB_VL) else 0 end) as s6,&#xD;&#xA;0 as s7,&#xD;&#xA;0 as s8,&#xD;&#xA;sum(case when  prd like '%00' and (acc_no like '21%' or acc_no like '231%' or acc_no like '232%' &#xD;&#xA;or acc_no like '233%' or acc_no like '241%') then (CR_VL - DB_VL) else 0 end) as sm2&#xD;&#xA;from gljrnld where 1=1&#xD;&#xA;&#xD;&#xA;union all&#xD;&#xA;&#xD;&#xA;Select 'التغير في السياسات المحاسبيه والاخطاء الجوهريه' as acc_nm,&#xD;&#xA;0 as s1,&#xD;&#xA;0 as s2,&#xD;&#xA;0 as s3,&#xD;&#xA;0 as s4,&#xD;&#xA;0 as sm1,&#xD;&#xA;0 as s5,&#xD;&#xA;sum(case when  prd not like '%00' and (acc_no like '2422%' or acc_no like '2421%') then (CR_VL - DB_VL) else 0 end) as s6,&#xD;&#xA;0 as s7,&#xD;&#xA;0 as s8,&#xD;&#xA;sum(case when  prd not like '%00' and (acc_no like '2422%' or acc_no like '2421%') then (CR_VL - DB_VL) else 0 end) as sm2&#xD;&#xA;from gljrnld where 1=1&#xD;&#xA;&#xD;&#xA;union all&#xD;&#xA;&#xD;&#xA;Select 'تسويات تمت خلال الفتره' as acc_nm,&#xD;&#xA;0 as s1,&#xD;&#xA;0 as s2,&#xD;&#xA;0 as s3,&#xD;&#xA;0 as s4,&#xD;&#xA;0 as sm1,&#xD;&#xA;0 as s5,&#xD;&#xA;sum(case when  prd not like '%00' and (acc_no like '2423%') then (CR_VL - DB_VL) else 0 end) as s6,&#xD;&#xA;0 as s7,&#xD;&#xA;0 as s8,&#xD;&#xA;sum(case when  prd not like '%00' and (acc_no like '2423%' ) then (CR_VL - DB_VL) else 0 end) as sm2&#xD;&#xA;from gljrnld where 1=1&#xD;&#xA;&#xD;&#xA;union all&#xD;&#xA;&#xD;&#xA;Select 'صافي ربح الفتره' as acc_nm,&#xD;&#xA;0 as s1,&#xD;&#xA;0 as s2,&#xD;&#xA;0 as s3,&#xD;&#xA;0 as s4,&#xD;&#xA;0 as sm1,&#xD;&#xA;0 as s5,&#xD;&#xA;0 as s6,&#xD;&#xA;sum(case when  prd not like '%00' and (acc_no like '25%' ) then (CR_VL - DB_VL) else 0 end) as s7,&#xD;&#xA;0 as s8,&#xD;&#xA;sum(case when  prd not like '%00' and (acc_no like '25%') then (CR_VL - DB_VL) else 0 end) as sm2&#xD;&#xA;from gljrnld where 1=1&#xD;&#xA;&#xD;&#xA;union all&#xD;&#xA;&#xD;&#xA;Select 'الزياده في رأس المال من دائني التوزيعات' as acc_nm,&#xD;&#xA;sum(case when  prd not like '%00' and acc_no like '3244%' then (DB_VL - CR_VL) else 0 end) as s1,&#xD;&#xA;0 s2,&#xD;&#xA;0 as s3,&#xD;&#xA;0 as s4,&#xD;&#xA;0 as sm1,&#xD;&#xA;0 as s5,&#xD;&#xA;0 as s6,&#xD;&#xA;0 as s7,&#xD;&#xA;0 as s8,&#xD;&#xA;sum(case when  prd not like '%00' and (acc_no like '3244') then (DB_VL - CR_VL) else 0 end) as sm2&#xD;&#xA;from gljrnld where 1=1&#xD;&#xA;&#xD;&#xA;union all&#xD;&#xA;&#xD;&#xA;Select 'الزياده في رأس المال من الاحتياطيات' as acc_nm,&#xD;&#xA;sum(case when  prd not like '%00' and acc_no like '21%' then (CR_VL - DB_VL) else 0 end) as s1,&#xD;&#xA;sum(case when  prd not like '%00' and acc_no like '231%' then (CR_VL - DB_VL) else 0 end) as s2,&#xD;&#xA;sum(case when  prd not like '%00' and acc_no like '232%' then (CR_VL - DB_VL) else 0 end) as s3,&#xD;&#xA;sum(case when  prd not like '%00' and acc_no like '233%' then (CR_VL - DB_VL) else 0 end) as s4,&#xD;&#xA;sum(case when  prd not like '%00' and (acc_no like '231%' or acc_no like '232%' or acc_no like '233%') &#xD;&#xA;then (CR_VL - DB_VL) else 0 end) as sm1,&#xD;&#xA;0 as s5,&#xD;&#xA;0 s6,&#xD;&#xA;0 as s7,&#xD;&#xA;0 as s8,&#xD;&#xA;sum(case when  prd not like '%00' and (acc_no like '21%' or acc_no like '231%' or acc_no like '232%' &#xD;&#xA;or acc_no like '233%') then (CR_VL - DB_VL) else 0 end) as sm2&#xD;&#xA;from gljrnld where 1=1&#xD;&#xA;&#xD;&#xA;union all&#xD;&#xA;&#xD;&#xA;Select 'توزيعات الارباح' as acc_nm,&#xD;&#xA;0 as s1,&#xD;&#xA;sum(case when  prd not like '%00' and acc_no like '231%' then (CR_VL - DB_VL) else 0 end) as s2,&#xD;&#xA;sum(case when  prd not like '%00' and acc_no like '232%' then (CR_VL - DB_VL) else 0 end) as s3,&#xD;&#xA;sum(case when  prd not like '%00' and acc_no like '233%' then (CR_VL - DB_VL) else 0 end) as s4,&#xD;&#xA;sum(case when  prd not like '%00' and (acc_no like '231%' or acc_no like '232%' or acc_no like '233%') &#xD;&#xA;then (CR_VL - DB_VL) else 0 end) as sm1,&#xD;&#xA;0 as s5,&#xD;&#xA;sum(case when  prd not like '%00' and acc_no like '241%' then (CR_VL - DB_VL) else 0 end) as s6,&#xD;&#xA;0 as s7,&#xD;&#xA;0 as s8,&#xD;&#xA;sum(case when  prd not like '%00' and (acc_no like '231%' or acc_no like '232%' &#xD;&#xA;or acc_no like '233%' or acc_no like '241%') then (CR_VL - DB_VL) else 0 end) as sm2&#xD;&#xA;from gljrnld where 1=1&#xD;&#xA;" Name="sqlDataSource1" />
