            </TextBox>
            <TextBox Width="3.018cm" Height="0.721cm" Left="11.481cm" Top="0cm" Value="=Sum (Fields.CR_CUR)" Format="{0:N3}" Culture="en" Name="textBox19">
              <Style Color="192, 0, 0" TextAlign="Justify" VerticalAlign="Middle">
                <Font Bold="True" />
                <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
                <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
                <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
              </Style>
            </TextBox>
            <TextBox Width="2.143cm" Height="0.721cm" Left="23.556cm" Top="0cm" Value="الإجمالي" Name="textBox17">
              <Style TextAlign="Center" VerticalAlign="Middle">
                <Font Size="16pt" Bold="True" />
                <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
                <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
                <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
              </Style>
            </TextBox>
            <TextBox Width="2.6cm" Height="0.7cm" Left="22.554cm" Top="0.921cm" Value="= IIf((Sum(Fields.DB_CUR) - Sum(Fields.CR_CUR)) &lt; 0,' رصيد دائن','رصيد مدين ')" Culture="en" Name="textBox31">
              <Style TextAlign="Center" VerticalAlign="Middle">
                <Font Size="14pt" Bold="True" />
                <BorderStyle Top="None" Bottom="None" Left="None" Right="None" />
                <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
                <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
              </Style>
            </TextBox>
            <TextBox Width="1.85in" Height="0.276in" Left="6.811in" Top="0.363in" Value="=Sum(Fields.DB_CUR) - Sum(Fields.CR_CUR)" Format="{0:N3}" Culture="en" Name="textBox38">
              <Style Color="192, 0, 0" TextAlign="Center" VerticalAlign="Middle">
                <Font Size="16pt" Bold="True" />
                <BorderStyle Top="None" Bottom="None" Left="None" Right="None" />
                <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
                <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
              </Style>
            </TextBox>
            <TextBox Width="11.481cm" Height="0.721cm" Left="0cm" Top="0cm" Value="" Format="{0:N3}" Name="textBox40">
              <Style Color="Red" TextAlign="Center" VerticalAlign="Middle">
                <Font Size="14pt" Bold="True" />
                <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
                <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
                <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
              </Style>
            </TextBox>
            <TextBox Width="2.8cm" Height="0.6cm" Left="1.1cm" Top="1.359cm" Value="= &quot; صفحة &quot; + CStr(PageNumber) + &quot; من &quot;  + CStr(PageCount)" Name="textBox20">
              <Style VerticalAlign="Middle">
                <Font Size="8pt" />
              </Style>
            </TextBox>
            <TextBox Width="1.8cm" Height="0.6cm" Left="3.9cm" Top="1.359cm" Value="= &quot;بواسطة :&quot;+Cstr(UserIdentity.Name)" Name="textBox23">
              <Style TextAlign="Left" VerticalAlign="Middle">
                <Font Size="8pt" />
              </Style>
            </TextBox>
            <TextBox Width="3cm" Height="0.721cm" Left="20.499cm" Top="0cm" Value="=iif(Sum(Fields.DB_CUR) - Sum(Fields.CR_CUR) &gt; 0 ,Sum(Fields.DB_CUR) - Sum(Fields.CR_CUR),'')" Format="{0:N3}" Culture="en" Name="textBox16">
              <Style Color="Blue" TextAlign="Justify" VerticalAlign="Middle">
                <Font Bold="True" />
                <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
                <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
                <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
              </Style>
            </TextBox>
            <TextBox Width="3cm" Height="0.721cm" Left="17.499cm" Top="0cm" Value="=iif(Sum(Fields.DB_CUR) - Sum(Fields.CR_CUR) &gt; 0 ,'',Sum(Fields.DB_CUR) - Sum(Fields.CR_CUR))" Format="{0:N3}" Culture="en" Name="textBox22">
              <Style Color="192, 0, 0" TextAlign="Justify" VerticalAlign="Middle">
                <Font Bold="True" />
                <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
                <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
                <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
              </Style>
            </TextBox>
            <TextBox Width="18.2cm" Height="0.798cm" Left="6.954cm" Top="1.971cm" Value="= brca.Core.Services.ReportStaticService.TafqeetCur(Sum(Fields.DB_CUR) - Sum(Fields.CR_CUR),Parameters.CurCd.Value)&#xD;&#xA;&#xD;&#xA;" Format="{0:N2}" Name="textBox28">
              <Style TextAlign="Center" VerticalAlign="Middle">
                <Font Size="12pt" Bold="True" />
              </Style>
            </TextBox>
          </Items>
        </GroupFooterSection>
      </GroupFooter>
      <Groupings>
        <Grouping Expression="= Fields.AccNo" />
      </Groupings>
    </Group>
