D;&#xA; as tot5&#xD;&#xA;&#xD;&#xA;from gljrnld  WHERE (( acc_no like '4[7]1%' or  acc_no like '4[7]2%') )  and (1=1)&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;union all&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;select  'إجمالي الأعباء الإدارية والتمويلية' as s,&#xD;&#xA;(CAST(ROUND(sum( case when ( acc_no like '4[6-8]1122%'  )&#xD;&#xA; and (substring(cst_Cd,3,2)  in ('01','20','21','22','23','24','25','26') and cst_cd not like '01%') and jrn_Cd not like '017%'  then db_vl-cr_vl else 0 end ), 0) AS BIGINT)&#xD;&#xA; +&#xD;&#xA;CAST(ROUND(sum( case when ( acc_no like '4[6-8]1122%'  )&#xD;&#xA;and cst_Cd like '01%' and jrn_Cd not like '017%'  then db_vl-cr_vl else 0 end ), 0) AS BIGINT))&#xD;&#xA; &#xD;&#xA;&#xD;&#xA; as s1,&#xD;&#xA;(CAST(ROUND(sum( case when (( acc_no like '4[6-8]1121%' or  acc_no like '4[6-8]1123%')) &#xD;&#xA;and (substring(cst_Cd,3,2)  in ('01','20','21','22','23','24','25','26') and cst_cd not like '01%') and jrn_Cd not like '017%'&#xD;&#xA; then db_vl-cr_vl else 0 end ), 0) AS BIGINT)&#xD;&#xA; +&#xD;&#xA; CAST(ROUND(sum( case when (( acc_no like '4[6-8]1121%' or  acc_no like '4[6-8]1123%')) &#xD;&#xA;and cst_Cd like '01%' and jrn_Cd not like '017%'&#xD;&#xA; then db_vl-cr_vl else 0 end ), 0) AS BIGINT))&#xD;&#xA; &#xD;&#xA;  as s2,&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;(CAST(ROUND(sum( case when  (acc_no like '4[6-8]111%' or acc_no like '4[6-8]113%'  ) &#xD;&#xA;and (substring(cst_Cd,3,2)  in ('01','20','21','22','23','24','25','26') and cst_cd not like '01%') and jrn_Cd not like '017%' then db_vl-cr_vl else 0 end ), 0) AS BIGINT) &#xD;&#xA;+&#xD;&#xA;CAST(ROUND(sum( case when  (acc_no like '4[6-8]111%' or acc_no like '4[6-8]113%'  ) &#xD;&#xA;and cst_Cd like '01%' and jrn_Cd not like '017%' then db_vl-cr_vl else 0 end ), 0) AS BIGINT) &#xD;&#xA;)&#xD;&#xA;as s3,&#xD;&#xA;&#xD;&#xA;(CAST(ROUND(sum( case when (( acc_no like '4[6-8]114%' or  acc_no like '4[6-8]115%' or  acc_no like '4[6-8]116%') ) &#xD;&#xA;and (substring(cst_Cd,3,2)  in ('01','20','21','22','23','24',