c_no like '4[6-8]211%' ) &#xD;&#xA; and (substring(cst_Cd,3,2)  in ('01','20','21','22','23','24','25','26') and cst_cd not like '01%') and jrn_Cd not like '017%'&#xD;&#xA; then db_vl-cr_vl else 0 end ), 0) AS BIGINT)&#xD;&#xA;+&#xD;&#xA; CAST(ROUND(sum( case when ( acc_no like '4[6-8]211%' ) &#xD;&#xA; and cst_Cd like '01%' and jrn_Cd not like '017%'&#xD;&#xA; then db_vl-cr_vl else 0 end ), 0) AS BIGINT))&#xD;&#xA;as s6,&#xD;&#xA;&#xD;&#xA;(CAST(ROUND(sum( case when ( acc_no like '4[6-8]21%')&#xD;&#xA; and (substring(cst_Cd,3,2)  in ('01','20','21','22','23','24','25','26') and cst_cd not like '01%') and jrn_Cd not like '017%'&#xD;&#xA; then db_vl-cr_vl else 0 end ), 0) AS BIGINT)&#xD;&#xA;&#xD;&#xA;+&#xD;&#xA;CAST(ROUND(sum( case when ( acc_no like '4[6-8]21%')&#xD;&#xA;and cst_Cd like '01%' and jrn_Cd not like '017%'&#xD;&#xA;then db_vl-cr_vl else 0 end ), 0) AS BIGINT)&#xD;&#xA;)&#xD;&#xA;-&#xD;&#xA;(CAST(ROUND(sum( case when ( acc_no like '4[6-8]211%') &#xD;&#xA; and (substring(cst_Cd,3,2)  in ('01','20','21','22','23','24','25','26') and cst_cd not like '01%') and jrn_Cd not like '017%'&#xD;&#xA; then db_vl-cr_vl else 0 end ), 0) AS BIGINT)&#xD;&#xA; +&#xD;&#xA; CAST(ROUND(sum( case when ( acc_no like '4[6-8]211%') &#xD;&#xA;and cst_Cd like '01%' and jrn_Cd not like '017%'&#xD;&#xA; then db_vl-cr_vl else 0 end ), 0) AS BIGINT)&#xD;&#xA; )&#xD;&#xA; &#xD;&#xA;  as s7,&#xD;&#xA;&#xD;&#xA;(CAST(ROUND(sum( case when ( acc_no like '4[6-8]21%') &#xD;&#xA; and (substring(cst_Cd,3,2)  in ('01','20','21','22','23','24','25','26') and cst_cd not like '01%') and jrn_Cd not like '017%'&#xD;&#xA;then db_vl-cr_vl else 0 end ), 0) AS BIGINT)&#xD;&#xA;+&#xD;&#xA;CAST(ROUND(sum( case when ( acc_no like '4[6-8]21%') &#xD;&#xA;and cst_Cd like '01%' and jrn_Cd not like '017%' &#xD;&#xA;then db_vl-cr_vl else 0 end ), 0) AS BIGINT)&#xD;&#xA;) as tot2,&#xD;&#xA;&#xD;&#xA;(CAST(ROUND(sum( case when ( acc_no like '4[6-8]22%') &#xD;&#xA; and (substring(cst_Cd,3,2)  in ('01','20','21','22','23','24','25','26') and cst_cd not like '01%') and jrn_Cd = '0172' AND SUM_CD = '14'&#xD;&#xA;then db_vl-cr_vl else 0 end ), 0) AS BIGINT) *-1&#xD;&#xA;+&#xD;&#xA;CAST(ROUND(sum( case when ( acc_no like '4[6-8]22%') &#xD;&#xA;and cst_Cd like '01%' and   jrn_Cd = '0171' &#xD;&#xA;then db_vl-cr_vl else 0 end ), 0) AS BIGINT) *-1&#xD;&#xA;)&#xD;&#xA;as s8,&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;(CAST(ROUND(sum( case when ( acc_no like '4[6-8]23111%' ) &#xD;&#xA; and (substring(cst_Cd,3,2)  in ('01','20','21','22','23','24','25','26') and cst_cd not like '01%') and jrn_Cd not like '017%'&#xD;&#xA;then db_vl-cr_vl else 0 end ), 0) AS BIGINT) &#xD;&#xA;+&#xD;&#xA;CAST(ROUND(sum( case when ( acc_no like '4[6-8]23111%' ) &#xD;&#xA;and cst_Cd like '01%' and jrn_Cd not like '017%' &#xD;&#xA;then db_vl-cr_vl else 0 end ), 0) AS BIGINT) &#xD;&#xA;)&#xD;&#xA;as s9,&#xD;&#xA;&#xD;&#xA;(CAST(ROUND(sum( case when ( acc_no like '4[6-8]23112%')&#xD;&#xA; and (substring(cst_Cd,3,2)  in ('01','20','21','22','23','24','25','26') and cst_cd not like '01%') and jrn_Cd not like '017%'&#xD;&#xA; then db_vl-cr_vl else 0 end ), 0) AS BIGINT)&#xD;&#xA; +&#xD;&#xA; CAST(ROUND(sum( case when ( acc_no like '4[6-8]23112%')&#xD;&#xA;and cst_Cd like '01%' and jrn_Cd not like '017%' &#xD;&#xA; then db_vl-cr_vl else 0 end ), 0) AS BIGINT)&#xD;&#xA; ) as s10,&#xD;&#xA;&#xD;&#xA;(CAST(ROUND(sum( case when ( acc_no like '4[6-8]2311%') &#xD;&#xA; and (substring(cst_Cd,3,2)  in ('01','20','21','22','23','24','25','26') and cst_cd not like '01%') and jrn_Cd not like '017%'&#xD;&#xA; then db_vl-cr_vl else 0 end ), 0) AS BIGINT)&#xD;&#xA; +&#xD;&#xA; CAST(ROUND(sum( case when ( acc_no like '4[6-8]2311%') &#xD;&#xA;and cst_Cd like '01%' and jrn_Cd not like '017%' &#xD;&#xA; then db_vl-cr_vl else 0 end ), 0) AS BIGINT)&#xD;&#xA; ) as tot3,&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;(CAST(ROUND(sum( case when ( acc_no like '4[6-8]24%' ) &#xD;&#xA; and (substring(cst_Cd,3,2)  in ('01','20','21','22','23','24','25','26') and cst_cd not like '01%') and jrn_Cd not like '017%'&#xD;&#xA; then db_vl-cr_vl else 0 end ), 0) AS BIGINT) &#xD;&#xA; +&#xD;&#xA; CAST(ROUND(sum( case when ( acc_no like '4[6-8]24%' ) &#xD;&#xA;and cst_Cd like '01%' and jrn_Cd not like '017%' &#xD;&#xA; then db_vl-cr_vl else 0 end ), 0) AS BIGINT)&#xD;&#xA; )as s11,&#xD;&#xA;&#xD;&#xA;(CAST(ROUND(sum( case when (( acc_no like '4[6-8]25%' or  acc_no like '4[6-8]26%') ) &#xD;&#xA; and (substring(cst_Cd,3,2)  in ('01','20','21','22','23','24','25','26') and cst_cd not like '01%') and jrn_Cd not like '017%'&#xD;&#xA; then db_vl-cr_vl else 0 end ), 0) AS BIGINT) &#xD;&#xA; &#xD;&#xA; +&#xD;&#xA; CAST(ROUND(sum( case when (( acc_no like '4[6-8]25%' or  acc_no like '4[6-8]26%') ) &#xD;&#xA;and cst_Cd like '01%' and jrn_Cd not like '017%' &#xD;&#xA; then db_vl-cr_vl else 0 end ), 0) AS BIGINT)&#xD;&#xA; )as s12,&#xD;&#xA;&#xD;&#xA;(CAST(ROUND(sum( case when ((acc_no like '4[6-8]21%'  or acc_no like '4[6-8]2311%' or acc_no like '4[6-8]24%' or acc_no like '4[6-8]25%' or acc_no like '4[6-8]26%'))&#xD;&#xA; and (substring(cst_Cd,3,2)  in ('01','20','21','22','23','24','25','26') and cst_cd not like '01%') and jrn_Cd not like '017%'&#xD;&#xA; then db_vl-cr_vl else 0 end ), 0) AS BIGINT)&#xD;&#xA; +&#xD;&#xA; CAST(ROUND(sum( case when ((acc_no like '4[6-8]21%'  or acc_no like '4[6-8]2311%' or acc_no like '4[6-8]24%' or acc_no like '4[6-8]25%' or acc_no like '4[6-8]26%'))&#xD;&#xA;and cst_Cd like '01%' and jrn_Cd not like '017%' &#xD;&#xA; then db_vl-cr_vl else 0 end ), 0) AS BIGINT)&#xD;&#xA; )&#xD;&#xA; +&#xD;&#xA; (CAST(ROUND(sum( case when ( acc_no like '4[6-8]22%') &#xD;&#xA; and (substring(cst_Cd,3,2)  in ('01','20','21','22','23','24','25','26') and cst_cd not like '01%') and jrn_Cd = '0172' AND SUM_CD = '14'&#xD;&#xA;then db_vl-cr_vl else 0 end ), 0) AS BIGINT) *-1&#xD;&#xA;+&#xD;&#xA;CAST(ROUND(sum( case when ( acc_no like '4[6-8]22%') &#xD;&#xA;and cst_Cd like '01%' and   jrn_Cd = '0171' &#xD;&#xA;then db_vl-cr_vl else 0 end ), 0) AS BIGINT) *-1&#xD;&#xA;)&#xD;&#xA; as tot4,&#xD;&#xA;&#xD;&#xA;(CAST(ROUND(sum( case when ((acc_no like '4[6-8]21%'  or acc_no like '4[6-8]2311%' or acc_no like '4[6-8]24%' or acc_no like '4[6-8]25%' or acc_no like '4[6-8]26%'))&#xD;&#xA; and (substring(cst_Cd,3,2)  in ('01','20','21','22','23','24','25','26') and cst_cd not like '01%') and jrn_Cd not like '017%'&#xD;&#xA; then db_vl-cr_vl else 0 end ), 0) AS BIGINT)&#xD;&#xA; +&#xD;&#xA; CAST(ROUND(sum( case when ((acc_no like '4[6-8]21%'  or acc_no like '4[6-8]2311%' or acc_no like '4[6-8]24%' or acc_no like '4[6-8]25%' or acc_no like '4[6-8]26%'))&#xD;&#xA;and cst_Cd like '01%' and jrn_Cd not like '017%' &#xD;&#xA; then db_vl-cr_vl else 0 end ), 0) AS BIGINT)&#xD;&#xA; )&#xD;&#xA; +&#xD;&#xA; (CAST(ROUND(sum( case when ( acc_no like '4[6-8]22%') &#xD;&#xA; and (substring(cst_Cd,3,2)  in ('01','20','21','22','23','24','25','26') and cst_cd not like '01%') and jrn_Cd = '0172' AND SUM_CD = '14'&#xD;&#xA;then db_vl-cr_vl else 0 end ), 0) AS BIGINT) *-1&#xD;&#xA;+&#xD;&#xA;CAST(ROUND(sum( case when ( acc_no like '4[6-8]22%') &#xD;&#xA;and cst_Cd like '01%' and   jrn_Cd = '0171' &#xD;&#xA;then db_vl-cr_vl else 0 end ), 0) AS BIGINT) *-1&#xD;&#xA;&#xD;&#xA;)&#xD;&#xA;+&#xD;&#xA;(CAST(ROUND(sum( case when ((acc_no like '4[6-8]111%' or  acc_no like '4[6-8]1122%' &#xD;&#xA;or acc_no like '4[6-8]1121%' or  acc_no like '4[6-8]1123%' or acc_no like '4[6-8]113%' &#xD;&#xA; or acc_no like '4[6-8]114%' or  acc_no like '4[6-8]115%' or  acc_no like '4[6-8]116%' &#xD;&#xA; or  acc_no like '4[6-8]12%'))&#xD;&#xA; and (substring(cst_Cd,3,2)  in ('01','20','21','22','23','24','25','26') and cst_cd not like '01%') and jrn_Cd not like '017%'&#xD;&#xA;  then db_vl-cr_vl else 0 end ), 0) AS BIGINT) &#xD;&#xA; +&#xD;&#xA; CAST(ROUND(sum( case when ((acc_no like '4[6-8]111%' or  acc_no like '4[6-8]1122%' &#xD;&#xA;or acc_no like '4[6-8]1121%' or  acc_no like '4[6-8]1123%' or acc_no like '4[6-8]113%' &#xD;&#xA; or acc_no like '4[6-8]114%' or  acc_no like '4[6-8]115%' or  acc_no like '4[6-8]116%' &#xD;&#xA; or  acc_no like '4[6-8]12%'))&#xD;&#xA; and cst_Cd like '01%' and jrn_Cd not like '017%'&#xD;&#xA;  then db_vl-cr_vl else 0 end ), 0) AS BIGINT))&#xD;&#xA;  &#xD;&#xA;   as tot5&#xD;&#xA;from gljrnld  WHERE (( acc_no like '4[6-8]1%' or  acc_no like '4[6-8]2%') ) and (1=1)&#xD;&#xA;" Name="sqlDataSource1" />
