 acc_no like '4[6-8]114%' or  acc_no like '4[6-8]115%'  or  acc_no like '4[6-8]116%')) &#xD;&#xA;and cst_Cd like '01%' and jrn_Cd not like '017%'&#xD;&#xA; then db_vl-cr_vl else 0 end ), 0) AS BIGINT))&#xD;&#xA; -&#xD;&#xA; CAST(ROUND(sum( case when (( acc_no like '4[6-8]114%' or  acc_no like '4[6-8]115%' or  acc_no like '4[6-8]116%')) and cst_Cd like '11%'  and jrn_Cd like '017%'then db_vl-cr_vl else 0 end ), 0) AS BIGINT)&#xD;&#xA; -&#xD;&#xA;CAST(ROUND(sum( case when ((  acc_no like '4[6-8]114%' or  acc_no like '4[6-8]115%' or  acc_no like '4[6-8]116%'))    and sum_Cd in ('12','13')  and cst_cd not like '11%' and jrn_Cd like '017%'  then  db_vl-cr_vl else 0 end ), 0) AS BIGINT)&#xD;&#xA;-&#xD;&#xA;CAST(ROUND(sum( case when (( acc_no like '4[7]114%' or  acc_no like '4[7]115%' or  acc_no like '4[7]116%'))    and sum_Cd = '11'  and cst_cd not like '11%' and jrn_Cd  like '017%'  then  db_vl-cr_vl else 0 end ), 0) AS BIGINT)&#xD;&#xA;&#xD;&#xA;as s4,&#xD;&#xA;&#xD;&#xA;(CAST(ROUND(sum( case when (( acc_no like '4[6-8]12%')) &#xD;&#xA;and (substring(cst_Cd,3,2)  in ('01','20','21','22','23','24','25','26') and cst_cd not like '01%') and jrn_Cd not like '017%'&#xD;&#xA; then db_vl-cr_vl else 0 end ), 0) AS BIGINT)&#xD;&#xA; +&#xD;&#xA; CAST(ROUND(sum( case when (( acc_no like '4[6-8]12%')) &#xD;&#xA;and cst_Cd like '01%' and jrn_Cd not like '017%'&#xD;&#xA; then db_vl-cr_vl else 0 end ), 0) AS BIGINT))&#xD;&#xA; -&#xD;&#xA; CAST(ROUND(sum( case when (( acc_no like '4[6-8]12%' )) and cst_Cd like '11%'  and jrn_Cd like '017%'then db_vl-cr_vl else 0 end ), 0) AS BIGINT)&#xD;&#xA; -&#xD;&#xA;CAST(ROUND(sum( case when ((  acc_no like '4[6-8]12%'))    and sum_Cd in ('12','13')  and cst_cd not like '11%' and jrn_Cd like '017%'  then  db_vl-cr_vl else 0 end ), 0) AS BIGINT)&#xD;&#xA;-&#xD;&#xA;CAST(ROUND(sum( case when (( acc_no like '4[7]12%' ))    and sum_Cd = '11'  and cst_cd not like '11%' and jrn_Cd  like '017%'  then  db_vl-cr_vl else 0 end ), 0) AS BIGINT)&#xD;&#xA;&#xD;