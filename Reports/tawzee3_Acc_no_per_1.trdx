  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="glx2024" SelectCommand="&#xD;&#xA;select  '1- شبكات ' as s,&#xD;&#xA;CAST(ROUND(sum( case when ( acc_no like '0%' ) then db_vl-cr_vl else 0 end ), 0) AS BIGINT) as s1,&#xD;&#xA;CAST(ROUND(sum( case when ( acc_no like '0%' ) then db_vl-cr_vl else 0 end ), 0) AS BIGINT) as s2,&#xD;&#xA;CAST(ROUND(sum( case when ( acc_no like '0%' ) then db_vl-cr_vl else 0 end ), 0) AS BIGINT) as s3,&#xD;&#xA;CAST(ROUND(sum( case when ( acc_no like '0%' ) then db_vl-cr_vl else 0 end ), 0) AS BIGINT) as s4,&#xD;&#xA;CAST(ROUND(sum( case when ( acc_no like '0%' ) then db_vl-cr_vl else 0 end ), 0) AS BIGINT) as s5,&#xD;&#xA;CAST(ROUND(sum( case when ( acc_no like '0%' ) then db_vl-cr_vl else 0 end ), 0) AS BIGINT) as tot1,&#xD;&#xA;CAST(ROUND(sum( case when ( acc_no like '0%' ) then db_vl-cr_vl else 0 end ), 0) AS BIGINT) as s6,&#xD;&#xA;CAST(ROUND(sum( case when ( acc_no like '0%' ) then db_vl-cr_vl else 0 end ), 0) AS BIGINT) as s7,&#xD;&#xA;CAST(ROUND(sum( case when ( acc_no like '0%' ) then db_vl-cr_vl else 0 end ), 0) AS BIGINT) as tot2,&#xD;&#xA;CAST(ROUND(sum( case when ( acc_no like '0%' ) then db_vl-cr_vl else 0 end ), 0) AS BIGINT) as s8,&#xD;&#xA;CAST(ROUND(sum( case when ( acc_no like '0%' ) then db_vl-cr_vl else 0 end ), 0) AS BIGINT) as s9,&#xD;&#xA;CAST(ROUND(sum( case when ( acc_no like '0%' ) then db_vl-cr_vl else 0 end ), 0) AS BIGINT) as s10,&#xD;&#xA;CAST(ROUND(sum( case when ( acc_no like '0%' ) then db_vl-cr_vl else 0 end ), 0) AS BIGINT) as tot3,&#xD;&#xA;CAST(ROUND(sum( case when ( acc_no like '0%' ) then db_vl-cr_vl else 0 end ), 0) AS BIGINT) as s11,&#xD;&#xA;CAST(ROUND(sum( case when ( acc_no like '0%' ) then db_vl-cr_vl else 0 end ), 0) AS BIGINT) as s12,&#xD;&#xA;CAST(ROUND(sum( case when ( acc_no like '0%' ) then db_vl-cr_vl else 0 end ), 0) AS BIGINT)as tot4,&#xD;&#xA;CAST(ROUND(sum( case when ( acc_no like '0%' ) then db_vl-cr_vl else 0 end ), 0) AS BIGINT)as tot5&#xD;&#xA