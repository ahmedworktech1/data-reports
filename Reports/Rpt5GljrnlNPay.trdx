            </TextBox>
          </Items>
        </GroupFooterSection>
      </GroupFooter>
      <Groupings>
        <Grouping Expression="Fields.LnNo" />
      </Groupings>
    </Group>
  </Groups>
  <ReportParameters>
    <ReportParameter Name="login" AllowNull="True" />
    <ReportParameter Name="Url" AllowNull="True">
      <Value>
        <String>= ""</String>
      </Value>
    </ReportParameter>
    <ReportParameter Name="TrNo" AllowNull="True" />
    <ReportParameter Name="JrnCd" AllowNull="True" />
    <ReportParameter Name="CompanyAddress" />
    <ReportParameter Name="CompanyName" />
  </ReportParameters>
</Report>