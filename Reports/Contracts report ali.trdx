<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource1" Width="28.7cm" Name="ReportANWAR" Zoom="1.5" ShowSnapGrid="True" xmlns="http://schemas.telerik.com/reporting/2021/1.0">
  <Style>
    <Font Size="10pt" />
  </Style>
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="GLXMonth" SelectCommand="SELECT        TOP (100) PERCENT dbo.AQRENT_H.Folder_Id, T.Tr_NO, T.BLD_CD, T.TR_Dt, T.TENANT_Nm_AR, T.PAYED_AMT, T.Check_NO, T.REC_TYPE, T.bank_dec, T.NOTS, T.BLD_DSCR_AR, T.PAYED_TY, T.CONTRACT_NO, T.ty_des, &#xD;&#xA;                         T.csh, T.seq, T.kent, T.th, T.ad, T.sdsd, T.DSCR_AR, T.total, T.TENANT_NO, dbo.AQRENT_H.Unts_Dscrs, dbo.OwnerFolder.NM_AR, T.M_01, T.M_02, T.M_03, T.M_04, T.M_05, T.M_06, T.M_07, T.M_08, T.M_09, T.M_10, T.M_11, &#xD;&#xA;                         T.M_12, T.DUE_DT, T.YR, T.MNTH, T.DSCR_AR_PY, T.DSCR_EN_PY, T.DSCR_AR_KN, T.DSCR_EN_KN&#xD;&#xA;FROM            dbo.AQRENT_H INNER JOIN&#xD;&#xA;                         dbo.OwnerFolder ON dbo.AQRENT_H.Folder_Id = dbo.OwnerFolder.Folder_ID RIGHT OUTER JOIN&#xD;&#xA;                             (SELECT        TOP (100) PERCENT dbo.BLDMF.DPT_NO, dbo.AQCOLLECT_H.Tr_NO, dbo.AQCOLLECT_H.TR_Dt, dbo.tenantMF.TENANT_Nm_AR, dbo.AQCOLLECT_H.PAYED_AMT, dbo.AQCOLLECT_H.Check_NO, &#xD;&#xA;                                                         AQLISTS_1.REC_TYPE, AQLISTS_1.DSCR_AR AS bank_dec, dbo.AQCOLLECT_H.NOTS, dbo.BLDMF.BLD_DSCR_AR, dbo.AQCOLLECT_H.PAYED_TY, dbo.AQCOLLECT_H.CONTRACT_NO, &#xD;&#xA;                                                         CASE WHEN AQCOLLECT_H.PAYED_TY = 1 THEN 'نقدي' ELSE 'شيك' END AS ty_des, CASE WHEN (AQCOLLECT_H.PAYED_TY = 1) OR&#xD;&#xA;                                                         (AQCOLLECT_H.PAYED_TY = 7) OR&#xD;&#xA;                                                         (AQCOLLECT_H.PAYED_TY = 8) OR&#xD;&#xA;                                                         (AQCOLLECT_H.PAYED_TY = 9) OR&#xD;&#xA;                                                         (AQCOLLECT_H.PAYED_TY = 99) THEN AQCOLLECT_H.PAYED_AMT ELSE 0 END AS csh, CASE WHEN AQCOLLECT_H.PAYED_TY = 2 THEN AQCOLLECT_H.PAYED_AMT ELSE 0 END AS seq, &#xD;&#xA;                                                         CASE WHEN AQCOLLECT_H.PAYED_TY = 3 THEN AQCOLLECT_H.PAYED_AMT ELSE 0 END AS kent, CASE WHEN AQCOLLECT_H.PAYED_TY = 4 THEN AQCOLLECT_H.PAYED_AMT ELSE 0 END AS th, &#xD;&#xA;                                                         CASE WHEN AQCOLLECT_H.PAYED_TY = 5 THEN AQCOLLECT_H.PAYED_AMT ELSE 0 END AS ad, CASE WHEN AQCOLLECT_H.PAYED_TY = 6 THEN AQCOLLECT_H.PAYED_AMT ELSE 0 END AS sdsd, &#xD;&#xA;                                                         SUM(CASE WHEN dbo.AQCOLLECT_D.MNTH = 1 THEN MNTH_AMT ELSE 0 END) AS M_01, SUM(CASE WHEN dbo.AQCOLLECT_D.MNTH = 2 THEN MNTH_AMT ELSE 0 END) AS M_02, &#xD;&#xA;                                                         SUM(CASE WHEN dbo.AQCOLLECT_D.MNTH = 3 THEN MNTH_AMT ELSE 0 END) AS M_03, SUM(CASE WHEN dbo.AQCOLLECT_D.MNTH = 4 THEN MNTH_AMT ELSE 0 END) AS M_04, &#xD;&#xA;                                                         SUM(CASE WHEN dbo.AQCOLLECT_D.MNTH = 5 THEN MNTH_AMT ELSE 0 END) AS M_05, SUM(CASE WHEN dbo.AQCOLLECT_D.MNTH = 6 THEN MNTH_AMT ELSE 0 END) AS M_06, &#xD;&#xA;                                                         SUM(CASE WHEN dbo.AQCOLLECT_D.MNTH = 7 THEN MNTH_AMT ELSE 0 END) AS M_07, SUM(CASE WHEN dbo.AQCOLLECT_D.MNTH = 8 THEN MNTH_AMT ELSE 0 END) AS M_08, &#xD;&#xA;                                                         SUM(CASE WHEN dbo.AQCOLLECT_D.MNTH = 9 THEN MNTH_AMT ELSE 0 END) AS M_09, SUM(CASE WHEN dbo.AQCOLLECT_D.MNTH = 10 THEN MNTH_AMT ELSE 0 END) AS M_10, &#xD;&#xA;                                                         SUM(CASE WHEN dbo.AQCOLLECT_D.MNTH = 11 THEN MNTH_AMT ELSE 0 END) AS M_11, SUM(CASE WHEN dbo.AQCOLLECT_D.MNTH = 12 THEN MNTH_AMT ELSE 0 END) AS M_12, AQLISTS_2.DSCR_AR, &#xD;&#xA;                                                         SUM(CASE WHEN dbo.AQCOLLECT_D.MNTH = 1 THEN MNTH_AMT ELSE 0 END + CASE WHEN dbo.AQCOLLECT_D.MNTH = 2 THEN MNTH_AMT ELSE 0 END + CASE WHEN dbo.AQCOLLECT_D.MNTH = 3 THEN MNTH_AMT&#xD;&#xA;                                                          ELSE 0 END + CASE WHEN dbo.AQCOLLECT_D.MNTH = 4 THEN MNTH_AMT ELSE 0 END + CASE WHEN dbo.AQCOLLECT_D.MNTH = 5 THEN MNTH_AMT ELSE 0 END + CASE WHEN dbo.AQCOLLECT_D.MNTH = 6&#xD;&#xA;                                                          THEN MNTH_AMT ELSE 0 END + CASE WHEN dbo.AQCOLLECT_D.MNTH = 7 THEN MNTH_AMT ELSE 0 END + CASE WHEN dbo.AQCOLLECT_D.MNTH = 8 THEN MNTH_AMT ELSE 0 END + CASE WHEN dbo.AQCOLLECT_D.MNTH&#xD;&#xA;                                                          = 9 THEN MNTH_AMT ELSE 0 END + CASE WHEN dbo.AQCOLLECT_D.MNTH = 10 THEN MNTH_AMT ELSE 0 END + CASE WHEN dbo.AQCOLLECT_D.MNTH = 11 THEN MNTH_AMT ELSE 0 END + CASE WHEN dbo.AQCOLLECT_D.MNTH&#xD;&#xA;                                                          = 12 THEN MNTH_AMT ELSE 0 END) AS total, dbo.AQCOLLECT_H.TENANT_NO, dbo.BLDMF.BLD_CD, dbo.AQCOLLECT_D.DUE_DT, dbo.AQCOLLECT_D.YR, dbo.AQCOLLECT_D.MNTH, &#xD;&#xA;                                                         dbo.AQLISTS.DSCR_AR AS DSCR_AR_PY, dbo.AQLISTS.DSCR_EN AS DSCR_EN_PY, dbo.AQCOLLECT_D.BLD_KNET, AQLISTS_3.DSCR_AR AS DSCR_AR_KN, AQLISTS_3.DSCR_EN AS DSCR_EN_KN&#xD;&#xA;                               FROM            dbo.AQLISTS INNER JOIN&#xD;&#xA;                                                         dbo.AQCOLLECT_D ON dbo.AQLISTS.CODE = dbo.AQCOLLECT_D.PAYED_TY INNER JOIN&#xD;&#xA;                                                         dbo.AQLISTS AS AQLISTS_3 ON dbo.AQCOLLECT_D.BLD_KNET = AQLISTS_3.CODE RIGHT OUTER JOIN&#xD;&#xA;                                                         dbo.AQCOLLECT_H INNER JOIN&#xD;&#xA;                                                         dbo.BLDMF ON dbo.AQCOLLECT_H.BLD_CD = dbo.BLDMF.BLD_CD INNER JOIN&#xD;&#xA;                                                         dbo.tenantMF ON dbo.AQCOLLECT_H.TENANT_NO = dbo.tenantMF.TENANT_NO LEFT OUTER JOIN&#xD;&#xA;                                                         dbo.AQLISTS AS AQLISTS_2 ON dbo.BLDMF.DPT_NO = AQLISTS_2.CODE ON dbo.AQCOLLECT_D.TR_NO = dbo.AQCOLLECT_H.Tr_NO AND &#xD;&#xA;                                                         dbo.AQCOLLECT_D.CONTRACT_NO = dbo.AQCOLLECT_H.CONTRACT_NO LEFT OUTER JOIN&#xD;&#xA;                                                         dbo.AQLISTS AS AQLISTS_1 ON dbo.AQCOLLECT_H.BNK = AQLISTS_1.CODE&#xD;&#xA;                               GROUP BY dbo.AQCOLLECT_H.Tr_NO, dbo.AQCOLLECT_H.TR_Dt, dbo.tenantMF.TENANT_Nm_AR, dbo.AQCOLLECT_H.PAYED_AMT, dbo.AQCOLLECT_H.Check_NO, AQLISTS_1.REC_TYPE, AQLISTS_1.DSCR_AR, &#xD;&#xA;                                                         dbo.AQCOLLECT_H.NOTS, dbo.BLDMF.BLD_DSCR_AR, dbo.AQCOLLECT_H.PAYED_TY, dbo.AQCOLLECT_H.CONTRACT_NO, dbo.BLDMF.DPT_NO, AQLISTS_2.DSCR_AR, dbo.AQCOLLECT_H.TENANT_NO, &#xD;&#xA;                                                         dbo.BLDMF.BLD_CD, dbo.AQCOLLECT_D.DUE_DT, dbo.AQCOLLECT_D.YR, dbo.AQCOLLECT_D.MNTH, dbo.AQLISTS.DSCR_AR, dbo.AQLISTS.DSCR_EN, dbo.AQLISTS.REC_TYPE, dbo.AQCOLLECT_D.PAYED_TY, &#xD;&#xA;                                                         dbo.AQCOLLECT_D.BLD_KNET, AQLISTS_3.DSCR_AR, AQLISTS_3.DSCR_EN, AQLISTS_3.REC_TYPE&#xD;&#xA;                               HAVING         (AQLISTS_1.REC_TYPE = 17 OR&#xD;&#xA;                                                         AQLISTS_1.REC_TYPE IS NULL OR&#xD;&#xA;                                                         AQLISTS_1.REC_TYPE = ' ' OR&#xD;&#xA;                                                         AQLISTS_1.REC_TYPE = 25) AND &#xD;&#xA;                                                         (SUM(CASE WHEN dbo.AQCOLLECT_D.MNTH = 1 THEN MNTH_AMT ELSE 0 END + CASE WHEN dbo.AQCOLLECT_D.MNTH = 2 THEN MNTH_AMT ELSE 0 END + CASE WHEN dbo.AQCOLLECT_D.MNTH = 3 THEN MNTH_AMT&#xD;&#xA;                                                          ELSE 0 END + CASE WHEN dbo.AQCOLLECT_D.MNTH = 4 THEN MNTH_AMT ELSE 0 END + CASE WHEN dbo.AQCOLLECT_D.MNTH = 5 THEN MNTH_AMT ELSE 0 END + CASE WHEN dbo.AQCOLLECT_D.MNTH = 6&#xD;&#xA;                                                          THEN MNTH_AMT ELSE 0 END + CASE WHEN dbo.AQCOLLECT_D.MNTH = 7 THEN MNTH_AMT ELSE 0 END + CASE WHEN dbo.AQCOLLECT_D.MNTH = 8 THEN MNTH_AMT ELSE 0 END + CASE WHEN dbo.AQCOLLECT_D.MNTH&#xD;&#xA;                                                          = 9 THEN MNTH_AMT ELSE 0 END + CASE WHEN dbo.AQCOLLECT_D.MNTH = 10 THEN MNTH_AMT ELSE 0 END + CASE WHEN dbo.AQCOLLECT_D.MNTH = 11 THEN MNTH_AMT ELSE 0 END + CASE WHEN dbo.AQCOLLECT_D.MNTH&#xD;&#xA;                                                          = 12 THEN MNTH_AMT ELSE 0 END) &lt;&gt; 0) AND (dbo.AQCOLLECT_H.PAYED_AMT &gt; 0) AND (dbo.AQLISTS.REC_TYPE = 16) AND (AQLISTS_3.REC_TYPE = 60)&#xD;&#xA;                               ORDER BY dbo.BLDMF.DPT_NO, dbo.AQCOLLECT_H.Tr_NO, dbo.AQCOLLECT_H.TR_Dt) AS T ON dbo.AQRENT_H.BLD_CD = T.BLD_CD AND dbo.AQRENT_H.Tr_NO = T.CONTRACT_NO AND &#xD;&#xA;                         dbo.AQRENT_H.TENANT_NO = T.TENANT_NO&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; where 1=1&#xD;&#xA;ORDER BY dbo.AQRENT_H.Folder_Id, T.Tr_NO, T.BLD_CD" Name="sqlDataSource1" />
  </DataSources>
