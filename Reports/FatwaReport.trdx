<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource1" Width="6.5in" Name="FatwaReport" xmlns="http://schemas.telerik.com/reporting/2023/1.0">
  <DataSources>
    <SqlDataSource QueryDesignerState="" ParameterValues="null" ConnectionString="archx" SelectCommand="SELECT&#xD;&#xA;    [FATWAS].[FatwaID], &#xD;&#xA;    CASE [FATWAS].[FatwaType]&#xD;&#xA;        WHEN 1 THEN N'عامة'&#xD;&#xA;        WHEN 2 THEN N'مرتبطة بقانون'&#xD;&#xA;        WHEN 3 THEN N'لائحة'&#xD;&#xA;        WHEN 4 THEN N'تشريع'&#xD;&#xA;        ELSE N'غير معروف'&#xD;&#xA;    &#x9;END AS [FatwaTypeName],&#xD;&#xA;    &#x9;[FATWAS].[FatwaType], &#xD;&#xA;    CASE [FATWAS].[FatwaCategory]&#xD;&#xA;        WHEN 1 THEN N'قانون'&#xD;&#xA;        WHEN 2 THEN N'لائحة'&#xD;&#xA;        WHEN 3 THEN N'قرار إداري'&#xD;&#xA;        ELSE N'غير معروف'&#xD;&#xA;    END AS [FatwaCategoryName],&#xD;&#xA;    [FATWAS].[FatwaCategory], &#xD;&#xA;    [FATWAS].[FatwaNumber], &#xD;&#xA;    [FATWAS].[FatwaDate], &#xD;&#xA;    [FATWAS].[Content], &#xD;&#xA;    [FATWAS].[Result], &#xD;&#xA;    [FATWAS].[LegalManagerOpinion], &#xD;&#xA;    CASE [FATWAS].[FatwaStatus]&#xD;&#xA;        WHEN 1 THEN N'افتراضية'&#xD;&#xA;        WHEN 2 THEN N'تم الانتهاء'&#xD;&#xA;        ELSE N'غير معروف'&#xD;&#xA;    END AS [FatwaStatusName],&#xD;&#xA;    [FATWAS].[FatwaStatus], &#xD;&#xA;    [FATWAS].[EnteredBy], &#xD;&#xA;    [FATWAS].[UpdatedBy], &#xD;&#xA;    [FATWAS].[EntryDate], &#xD;&#xA;    [FATWAS].[UpdateDate]&#xD;&#xA;FROM [FATWAS]&#xD;&#xA;" Name="sqlDataSource1" />
  </DataSources>
  <Items>
    <PageHeaderSection Height="0.2in" Name="pageHeaderSection1">
      <Style>
        <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
        <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
        <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
      </Style>
      <Items>
        <TextBox Width="0.6in" Height="0.2in" Left="4.4in" Top="0in" Value="الرقم" Name="textBox1">
          <Style TextAlign="Right" VerticalAlign="Middle">
            <Font Bold="True" />
            <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
