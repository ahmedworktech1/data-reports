<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource2" Width="251.6mm" UnitOfMeasure="Mm" Name="ReportGlunbaljrn" xmlns="http://schemas.telerik.com/reporting/2021/1.0">
  <Style Visible="True" />
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="glx2023hassan" SelectCommand="SELECT &#xA;    main.scst_cd,&#xA;    main.COM_ID,&#xA;    main.s1,&#xA;    main.s2,&#xA;    main.s3,&#xA;    main.s4,&#xA;    main.s5,&#xA;    main.tot,&#xA;    glScst.Scst_nm_ar as Scst_nm,&#xA;    glScst.PLT_NO as pltno,&#xA;    glScst.MOT_NO as motor,&#xA;    glScst.CHS_NO as chsno,&#xA;    glLoc.unt_nm_ar as untnm&#xA;FROM (&#xA;    SELECT &#xA;        GLJRNLD.scst_cd,&#xA;        GLJRNLD.COM_ID,&#xA;        -- المصروف&#xA;        SUM(CASE &#xA;                WHEN (acc_no LIKE '4[6-8]112101%' OR acc_no LIKE '4[6-8]112102%' OR acc_no LIKE '4[6-8]112103%' OR acc_no LIKE '4[6-8]112104%' OR acc_no LIKE '4[6-8]112105%') &#xA;                THEN db_vl - cr_vl &#xA;                ELSE 0 &#xA;            END) AS s1,&#xA;        SUM(CASE &#xA;                WHEN (acc_no LIKE '4[6-8]11231%' OR acc_no LIKE '4[6-8]11233%') &#xA;                THEN db_vl - cr_vl &#xA;                ELSE 0 &#xA;            END) AS s2,&#xA;        SUM(CASE &#xA;                WHEN (acc_no LIKE '4[6-8]11104%') &#xA;                THEN db_vl - cr_vl &#xA;                ELSE 0 &#xA;            END) AS s3,&#xA;        SUM(CASE &#xA;                WHEN (acc_no LIKE '4[6-8]1132%') &#xA;                THEN db_vl - cr_vl &#xA;                ELSE 0 &#xA;            END) AS s4,&#xA;        SUM(CASE &#xA;                WHEN (acc_no LIKE '4[6-8]2182202%' OR acc_no LIKE '4[6-8]48302%') &#xA;                THEN db_vl - cr_vl &#xA;                ELSE 0 &#xA;            END) AS s5,&#xA;        -- الاجمالى&#xA;        SUM(&#xA;            CASE &#xA;                WHEN (acc_no LIKE '4[6-8]112101%' OR acc_no LIKE '4[6-8]112102%' OR acc_no LIKE '4[6-8]112103%' OR acc_no LIKE '4[6-8]112104%' OR acc_no LIKE '4[6-8]112105%') &#xA;                    THEN db_vl - cr_vl &#xA;                ELSE 0 &#xA;            END +&#xA;            CASE &#xA;                WHEN (acc_no LIKE '4[6-8]11231%' OR acc_no LIKE '4[6-8]11233%') &#xA;                    THEN db_vl - cr_vl &#xA;                ELSE 0 &#xA;            END +&#xA;            CASE &#xA;                WHEN (acc_no LIKE '4[6-8]11104%') &#xA;                    THEN db_vl - cr_vl &#xA;                ELSE 0 &#xA;            END +&#xA;            CASE &#xA;                WHEN (acc_no LIKE '4[6-8]1132%') &#xA;                    THEN db_vl - cr_vl &#xA;                ELSE 0 &#xA;            END +&#xA;            CASE &#xA;                WHEN (acc_no LIKE '4[6-8]2182202%' OR acc_no LIKE '4[6-8]48302%') &#xA;                    THEN db_vl - cr_vl &#xA;                ELSE 0 &#xA;            END&#xA;        ) AS tot&#xA;    FROM GLJRNLD &#xA;    WHERE &#xA;        (&#xA;            acc_no LIKE '4[6-8]112101%' OR &#xA;            acc_no LIKE '4[6-8]112102%' OR &#xA;            acc_no LIKE '4[6-8]112103%' OR &#xA;            acc_no LIKE '4[6-8]112104%' OR &#xA;            acc_no LIKE '4[6-8]112105%' OR &#xA;            acc_no LIKE '4[6-8]11231%' OR &#xA;            acc_no LIKE '4[6-8]11233%' OR &#xA;            acc_no LIKE '4[6-8]11104%' OR &#xA;            acc_no LIKE '4[6-8]1132%' OR &#xA;            acc_no LIKE '4[6-8]2182202%' OR &#xA;            acc_no LIKE '4[6-8]48302%'&#xA;        ) &#xA;        AND (GLJRNLD.scst_cd LIKE '113%' OR GLJRNLD.scst_cd LIKE '114%')&#xA;    GROUP BY &#xA;        GLJRNLD.scst_cd,&#xA;        GLJRNLD.COM_ID&#xA;) main&#xA;LEFT JOIN glScst ON main.scst_cd = glScst.Scst_cd&#xA;LEFT JOIN glLoc ON main.COM_ID = glLoc.UNT_CD&#xA;ORDER BY &#xA;    main.COM_ID,&#xA;    main.scst_cd&#xA;" Name="sqlDataSource2" />
  </DataSources>
