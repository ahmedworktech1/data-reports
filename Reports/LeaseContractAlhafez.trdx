        </TextBox>
        <TextBox Width="9.4cm" Height="1.198cm" Left="1.441cm" Top="9.165cm" Value="The 2nd party undertakes to adhere to the purpose for which the unit was leased &amp; is responsible for obtaining the necessary permits (if required), &amp; may not change this purpose without the prior owner consent." Culture="uk" Name="textBox89">
          <Style TextAlign="Justify" VerticalAlign="Top">
            <Font Name="Segoe UI" Size="8pt" Bold="False" />
