        <TextBox Width="2.397cm" Height="0.472cm" Left="17.141cm" Top="8.63cm" Value="الغرض من التأجير" Name="textBox44">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Name="Segoe UI" Size="8pt" Bold="True" Underline="False" />
            <BorderStyle Top="None" Bottom="None" Left="None" Right="None" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="8.497cm" Height="1.198cm" Left="11.041cm" Top="9.165cm" Value="يتعهد الطرف الثاني بالإلتزام بالغرض الذي تم التأجير لأجله ويكون وحدة المسئول عن إصدار التراخيص اللازمة ( إذا لزم الأمر ) ، ولا يحق له تغيير هذا النشاط إلا بموافقة الطرف الأول كتابيا ." Name="textBox45">
          <Style TextAlign="Justify" VerticalAlign="Top">
            <Font Name="Segoe UI" Size="8pt" Bold="False" />
            <BorderStyle Top="None" Bottom="None" Left="None" Right="None" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="8.484cm" Height="0.854cm" Left="11.067cm" Top="15.7cm" Value="أقر الطرف الثاني بأنه قد عاين الوحدة معاينة نافية للجهالة ووجدها بحالتها الراهنة صالحة للغرض الذي تم الإتفاق عليه ووافق عليها." Name="textBox48">
          <Style TextAlign="Justify" VerticalAlign="Top">
            <Font Name="Segoe UI" Size="8pt" Bold="False" />
            <BorderStyle Top="None" Bottom="None" Left="None" Right="None" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="1.312cm" Height="0.51cm" Left="14.683cm" Top="10.44cm" Value="تبدأ بتاريخ" Name="textBox50">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Name="Segoe UI" Size="8pt" Bold="False" />
            <BorderStyle Top="None" Bottom="None" Left="None" Right="None" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="1.847cm" Height="0.5cm" Left="17.704cm" Top="12.705cm" Value="الإيجار الشهري" Name="textBox55">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Name="Segoe UI" Size="8pt" Bold="True" />
          </Style>
        </TextBox>
        <TextBox Width="8.51cm" Height="0.477cm" Left="11.041cm" Top="13.338cm" Value="تسدد مقدما بداية كل شهر ميلادي في المكان الذي يحدده الطرف الاول." Name="textBox60">
          <Style TextAlign="Left" VerticalAlign="Top">
            <Font Name="Segoe UI" Size="8pt" Bold="False" />
          </Style>
        </TextBox>
        <TextBox Width="8.484cm" Height="0.794cm" Left="11.054cm" Top="11.865cm" Value="السنة الاولى من العقد إلزامية ، في حال رغب الطرف الثاني إنهاء العقد قبل إنقضائها يتوجب عليه سداد إيجار ثلاثة شهور مقدمة ." Name="textBox61">
          <Style TextAlign="Justify" VerticalAlign="Top">
            <Font Name="Segoe UI" Size="8pt" Bold="False" />
          </Style>
        </TextBox>
        <TextBox Width="3.755cm" Height="0.474cm" Left="15.796cm" Top="13.822cm" Value="يتحمل إستهلاك الكهرباء الطرف&#xD;&#xA;" Name="textBox62">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Name="Segoe UI" Size="8pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="8.497cm" Height="0.782cm" Left="11.054cm" Top="17.45cm" Value="الطرف الثاني مسؤول عن إصلاح الأضرار التي قد تحدث للوحدة خلال فترة التأجير ويتعهد بتسليمها عند نهاية العقد على الحالة التي إستلمها ." Name="textBox65">
          <Style TextAlign="Justify" VerticalAlign="Top">
            <Font Name="Segoe UI" Size="8pt" Bold="False" />
          </Style>
        </TextBox>
        <TextBox Width="8.497cm" Height="0.454cm" Left="11.054cm" Top="21.5cm" Value="لا يفسر النص الأجنبى بنود وأحكام العقد ولا يعتد به قانونياً." Name="textBox70">
          <Style TextAlign="Left" VerticalAlign="Top">
            <Font Name="Segoe UI" Size="8pt" Bold="False" />
            <BorderStyle Top="None" Bottom="None" Left="None" Right="None" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="8.497cm" Height="1.156cm" Left="11.054cm" Top="22.475cm" Value="كل ما لم يرد ذكره في هذا العقد أو ملحقاته يخضع لأحكام قانون الإيجارات والأعراف والتقاليد بدولة الكويت، والمحاكم المحلية هي المختصة في فض اى نراع قد ينشأ بين طرفي العقد." Name="textBox72">
          <Style TextAlign="Justify" VerticalAlign="Top">
            <Font Name="Segoe UI" Size="8pt" Bold="False" />
            <BorderStyle Top="None" Bottom="None" Left="None" Right="None" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="8.523cm" Height="0.444cm" Left="11.028cm" Top="23.649cm" Value="حرر هذا العقد من نسختين لكل طرف نسخة للعمل بمقتضاها." Name="textBox73">
          <Style TextAlign="Left" VerticalAlign="Top">
            <Font Name="Segoe UI" Size="8pt" Bold="False" />
            <BorderStyle Top="None" Bottom="None" Left="None" Right="None" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="3.198cm" Height="0.546cm" Left="16.913cm" Top="24.134cm" Value="الطرف الأول ( المؤجر )" Name="textBox74">
          <Style TextAlign="Right" VerticalAlign="Top">
            <Font Size="9pt" Bold="True" />
            <BorderStyle Top="None" Bottom="None" Left="None" Right="None" />
