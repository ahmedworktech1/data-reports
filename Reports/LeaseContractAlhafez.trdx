            <Font Name="Segoe UI" Size="8pt" Bold="False" />
          </Style>
        </TextBox>
        <TextBox Width="9.4cm" Height="0.789cm" Left="1.441cm" Top="18.289cm" Value="The 2nd party may not sublease or share the unit with a partner, Violating that right entails the 1st party’s right to terminate the cont.immediately." Culture="uk" Name="textBox2">
          <Style TextAlign="Justify" VerticalAlign="Top">
