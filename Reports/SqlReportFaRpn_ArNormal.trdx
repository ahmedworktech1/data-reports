  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="GLXAssets" SelectCommand="ALTER TABLE FADPRC_Q ALTER COLUMN TotDSPAcc DECIMAL(24,3)&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;SELECT FAMF.FA_CD as FaCd, PRD,FAMF.FA_NM_Ar AS FaNm ,FAMF.CHS_NO as ChsNo,FAMF.PLT_NO as PltNo,&#xD;&#xA;FAMF.MOT_NO as MotNo,FAMF.STRT_DT as StrtDt ,FAMF.vend ,FAMF.Resp,''  as cstcd,''  as CstName,'' as Mcstcd, &#xD;&#xA;FAMF.MFA_CD1 as MfaCd1,FAMF.MFA_CD2 as MfaCd2,FAMF.MFA_CD3 as MfaCd3,FAMF.MFA_CD4 as MfaCd4,FAMF.FAACC_NO as&#xD;&#xA;faccNo,FAMF.UNT_CD as untCd , &#xD;&#xA;Cast(ISNULL(FAMF.DPRC_VL,0) as decimal(18,4)) as DPrcVl , &#xD;&#xA;ISNULL(FADPRC_Q.FA_VL,0) as CFaVl ,&#xD;&#xA;Cast( ISNULL(FADPRC_Q.TOTADD,0)as decimal(18,4)) as Cadd  ,&#xD;&#xA;Cast(ISNULL(FADPRC_Q.TOTDSP,0)as decimal(18,4)) as Cdsp  ,&#xD;&#xA;(ISNULL(FADPRC_Q.FA_VL,0) + Round(Cast(( + ISNULL(FADPRC_Q.TOTADD,0) - ISNULL(FADPRC_Q.TOTDSP,0))as decimal(18,4)),2)) AS AFaVl  ,&#xD;&#xA;Cast(ISNULL(FAMF.DPRC,0)as decimal(18,4)) AS BgDPrc  ,&#xD;&#xA;Cast(ISNULL((select sum(FADPRC_Q.TOTADDACC)from FADPRC_Q  where FAMF.FA_CD= FADPRC_Q.FA_CD) ,0)as decimal(18,4)) as CaddAcc ,&#xD;&#xA;Round(Cast(ISNULL((select sum(FADPRC_Q.TOTDSPACC)from FADPRC_Q  where FAMF.FA_CD= FADPRC_Q.FA_CD) ,0)as decimal(18,4)),2) as CdspAcc , &#xD;&#xA;Round(Cast((ISNULL((select sum(FADPRC_Q.DPREXP)from FADPRC_Q  where FAMF.FA_CD= FADPRC_Q.FA_CD) ,0) )as decimal(18,4)),2) AS Dprexp1 ,&#xD;&#xA;Cast(ISNULL(FAMF.PYRDPRC,0)as decimal(18,4)) as QPYrdPrc , Round(Cast(ISNULL(FAMF.QTY,0)as decimal(18,4)) ,2)as BgQty ,&#xD;&#xA;Round(Cast(ISNULL(FADPRC_Q.FA_QTY,0)as decimal(18,4)) ,2)as FaQty  ,&#xD;&#xA;Cast((ISNULL(FADPRC_Q.ACCDPR,0) - (ISNULL(FAMF.DPRC,0) + ISNULL(FAMF.PYRDPRC,0) - ISNULL(FAMF.DDPRC,0)) + ISNULL(FADPRC_Q.TOTDSPACC,0) - ISNULL(FADPRC_Q.TOTADDACC,0))as decimal(18,4)) AS Dprexp&#xD;&#xA;, Round(Cast(ISNULL(FADPRC_Q.BKVAL,0)as decimal(18,4)),2) as QBkVal  , Round(Cast(ISNULL(FADPRC_Q.TOTADDQTY,0)as decimal(18,4)),2) as TotaddQty  ,&#xD;&#xA;Round(Cast(ISNULL(FADPRC_Q.TOTDSPQTY,0)as decimal(18,4)),2) as TotdspQty  , Round(Cast(ISNULL(FADPRC_Q.ACCDPR,0)as decimal(18,4)),2) as QAccDpr  ,&#xD;&#xA;Cast(ISNULL(FADPRC_Q.DPREXP,0) - ISNULL(FADPRC_Q.DSP_DPREXP,0)as decimal(18,4))  as BdDpreXp &#xD;&#xA;FROM (FAMF  LEFT JOIN FADPRC_Q ON FADPRC_Q.FA_CD=FAMF.FA_CD) LEFT JOIN  GLCST ON FAMF.CST_CD=GLCST.CST_CD &#xD;&#xA;WHERE (FAMF.FA_TY&lt;&gt;1) and  (FAMF.FA_TY&lt;&gt;5)" Name="sqlDataSource1" />
  </DataSources>
