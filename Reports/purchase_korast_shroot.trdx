<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource1" Width="20cm" Name="نموذج الشروط العامة" Zoom="2" xmlns="http://schemas.telerik.com/reporting/2023/1.0">
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="azxsandoaa" SelectCommand="&#xD;&#xA;SELECT &#xD;&#xA;&#xD;&#xA;    AZTRH.itms_incrs, &#xD;&#xA;&#x9;AZTRH.PRCHS_OPRTN_TYP,&#xD;&#xA;&#x9;(SELECT DSCR_AR FROM AZTRTY WHERE AZTRTY.TR_TY= AZTRH.PRCHS_OPRTN_TYP ) AS OPTRN_NM,&#xD;&#xA;&#xD;&#xA;    AZTRH.fnncl_auth,&#xD;&#xA;&#xD;&#xA;    AZTRH.Purchas_No,&#xD;&#xA;&#xD;&#xA;    AZTRH.lgl_grnds, &#xD;&#xA;&#xD;&#xA;    AZTRH.TR_NO,&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;    AZTRH.FNCL_TR_NO,&#xD;&#xA;&#xD;&#xA;    AZTRH.tr_dt,&#xD;&#xA;&#xD;&#xA;    AZTRD.ENTEREDBY,&#xD;&#xA;&#xD;&#xA;    (SELECT Emp_Name &#xD;&#xA;&#xD;&#xA;     FROM PYEMPMF_H &#xD;&#xA;&#xD;&#xA;     WHERE PYEMPMF_H.emp_no = AZTRd.ENTEREDBY) AS nm,&#xD;&#xA;&#xD;&#xA;    AZTRH.TCHNCL_OPN_DT, &#xD;&#xA;&#xD;&#xA;    AZTRH.VST_NO, &#xD;&#xA;&#xD;&#xA;    AZTRTY.OprTypeName,&#xD;&#xA;&#xD;&#xA;    STRING_AGG(CAST(AZTRD.PRCHS_DISC_PRCNT AS NVARCHAR(50)), N' - ') AS PRCHS_DISC_PRCNT,&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#x9;dbo.Num_To_Str(aztrh.VST_NO) AS tfqet&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;FROM AZTRH&#xD;&#xA;&#xD;&#xA;LEFT JOIN AZTRD &#xD;&#xA;&#xD;&#xA;    ON AZTRH.LOC = AZTRD.LOC &#xD;&#xA;&#xD;&#xA;    AND AZTRH.TR_TY = AZTRD.TR_TY &#xD;&#xA;&#xD;&#xA;    AND AZTRH.TR_NO = AZTRD.TR_NO&#xD;&#xA;&#xD;&#xA;LEFT JOIN (&#xD;&#xA;&#xD;&#xA;    SELECT &#xD;&#xA;&#xD;&#xA;        T.TR_TY,&#xD;&#xA;&#xD;&#xA;        T.DSCR_AR AS OprTypeName&#xD;&#xA;&#x9;&#x9;&#xD;&#xA;&#xD;&#xA;    FROM AZTRTY T&#xD;&#xA;&#xD;&#xA;    WHERE T.TR_TY IS NOT NULL&#xD;&#xA;&#xD;&#xA;) AZTRTY&#xD;&#xA;&#xD;&#xA;    ON AZTRH.TR_TY = AZTRTY.TR_TY&#xD;&#xA;&#xD;&#xA;WHERE (1=1)&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;GROUP BY &#xD;&#xA;&#xD;&#xA;    AZTRH.itms_incrs, &#xD;&#xA;&#xD;&#xA;    AZTRH.fnncl_auth, &#xD;&#xA;&#xD;&#xA;    AZTRH.lgl_grnds, &#xD;&#xA;&#xD;&#xA;    AZTRH.Purchas_No,&#xD;&#xA;&#xD;&#xA;    AZTRD.ENTEREDBY,&#xD;&#xA;&#xD;&#xA;    AZTRH.FNCL_TR_NO, &#xD;&#xA;&#xD;&#xA;    AZTRH.tr_dt, &#xD;&#xA;    &#xD;&#xA;    AZTRH.TR_NO,&#xD;&#xA;&#xD;&#xA;    AZTRH.TCHNCL_OPN_DT, &#xD;&#xA;&#xD;&#xA;    AZTRH.VST_NO,&#xD;&#xA;&#x9;AZTRH.PRCHS_OPRTN_TYP,&#xD;&#xA;&#xD;&#xA;    AZTRTY.OprTypeName;&#xD;&#xA;&#xD;&#xA;" Name="sqlDataSource1" />
  </DataSources>
