<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource1" Width="20cm" Name="نموذج الشروط العامة" Zoom="1.5" xmlns="http://schemas.telerik.com/reporting/2023/1.0">
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="LocalSqlServer" SelectCommand="&#xD;&#xA;SELECT b.*, c.ClauseLine&#xD;&#xA;FROM (&#xD;&#xA;SELECT&#xD;&#xA;    AZTRH.itms_incrs,&#xD;&#xA;    AZTRH.PRCHS_OPRTN_TYP,&#xD;&#xA;    (SELECT DSCR_AR FROM AZTRTY WHERE AZTRTY.TR_TY = AZTRH.PRCHS_OPRTN_TYP) AS OPTRN_NM,&#xD;&#xA;    AZTRH.fnncl_auth,&#xD;&#xA;    AZTRH.Purchas_No,&#xD;&#xA;    AZTRH.lgl_grnds,&#xD;&#xA;    AZTRH.TR_NO,&#xD;&#xA;    AZTRH.TR_TY,&#xD;&#xA;    AZTRH.FNCL_TR_NO,&#xD;&#xA;    AZTRH.tr_dt,&#xD;&#xA;    AZTRD.ENTEREDBY,&#xD;&#xA;    (SELECT Emp_Name FROM PYEMPMF_H WHERE PYEMPMF_H.emp_no = AZTRD.ENTEREDBY) AS nm,&#xD;&#xA;    AZTRH.TCHNCL_OPN_DT,&#xD;&#xA;    AZTRH.VST_NO,&#xD;&#xA;    AZTRTY.OprTypeName,&#xD;&#xA;    STRING_AGG(CAST(AZTRD.PRCHS_DISC_PRCNT AS NVARCHAR(50)), N' - ') AS PRCHS_DISC_PRCNT,&#xD;&#xA;    dbo.Num_To_Str(AZTRH.VST_NO) AS tfqet,&#xD;&#xA;    CASE&#xD;&#xA;        WHEN ISNULL((&#xD;&#xA;            SELECT TOP 1 JF.SHW522&#xD;&#xA;            FROM AZTRTY TY&#xD;&#xA;            INNER JOIN JrnlForms JF ON JF.FrmId = TY.frmid&#xD;&#xA;            WHERE TY.TR_TY = AZTRH.TR_TY&#xD;&#xA;        ), 0) = 1&#xD;&#xA;        AND MAX(CASE WHEN AZTRD.CHNG_OIL IS NOT NULL THEN 1 ELSE 0 END) = 1&#xD;&#xA;        THEN 1 ELSE 0&#xD;&#xA;    END AS ShowChngOil&#xD;&#xA;FROM AZTRH&#xD;&#xA;LEFT JOIN AZTRD&#xD;&#xA;    ON AZTRH.LOC = AZTRD.LOC&#xD;&#xA;    AND AZTRH.TR_TY = AZTRD.TR_TY&#xD;&#xA;    AND AZTRH.TR_NO = AZTRD.TR_NO&#xD;&#xA;LEFT JOIN (&#xD;&#xA;    SELECT T.TR_TY, T.DSCR_AR AS OprTypeName&#xD;&#xA;    FROM AZTRTY T&#xD;&#xA;    WHERE T.TR_TY IS NOT NULL&#xD;&#xA;) AZTRTY&#xD;&#xA;    ON AZTRH.TR_TY = AZTRTY.TR_TY&#xD;&#xA;WHERE (1=1)&#xD;&#xA;GROUP BY&#xD;&#xA;    AZTRH.itms_incrs,&#xD;&#xA;    AZTRH.fnncl_auth,&#xD;&#xA;    AZTRH.lgl_grnds,&#xD;&#xA;    AZTRH.Purchas_No,&#xD;&#xA;    AZTRD.ENTEREDBY,&#xD;&#xA;    AZTRH.FNCL_TR_NO,&#xD;&#xA;    AZTRH.tr_dt,&#xD;&#xA;    AZTRH.TR_NO,&#xD;&#xA;    AZTRH.TR_TY,&#xD;&#xA;    AZTRH.TCHNCL_OPN_DT,&#xD;&#xA;    AZTRH.VST_NO,&#xD;&#xA;    AZTRH.PRCHS_OPRTN_TYP,&#xD;&#xA;    AZTRTY.OprTypeName&#xD;&#xA;) b&#xD;&#xA;CROSS APPLY (&#xD;&#xA;    SELECT&#xD;&#xA;        CASE z.Rn&#xD;&#xA;            WHEN 1 THEN N'١'&#xD;&#xA;            WHEN 2 THEN N'٢'&#xD;&#xA;            WHEN 3 THEN N'٣'&#xD;&#xA;            WHEN 4 THEN N'٤'&#xD;&#xA;            WHEN 5 THEN N'٥'&#xD;&#xA;            WHEN 6 THEN N'٦'&#xD;&#xA;            WHEN 7 THEN N'٧'&#xD;&#xA;            WHEN 8 THEN N'٨'&#xD;&#xA;            WHEN 9 THEN N'٩'&#xD;&#xA;            WHEN 10 THEN N'١٠'&#xD;&#xA;            WHEN 11 THEN N'١١'&#xD;&#xA;            WHEN 12 THEN N'١٢'&#xD;&#xA;            WHEN 13 THEN N'١٣'&#xD;&#xA;            WHEN 14 THEN N'١٤'&#xD;&#xA;            WHEN 15 THEN N'١٥'&#xD;&#xA;            WHEN 16 THEN N'١٦'&#xD;&#xA;            WHEN 17 THEN N'١٧'&#xD;&#xA;            WHEN 18 THEN N'١٨'&#xD;&#xA;            WHEN 19 THEN N'١٩'&#xD;&#xA;            WHEN 20 THEN N'٢٠'&#xD;&#xA;            WHEN 21 THEN N'٢١'&#xD;&#xA;            WHEN 22 THEN N'٢٢'&#xD;&#xA;        END + N'- ' + z.Txt AS ClauseLine,&#xD;&#xA;        z.Rn&#xD;&#xA;    FROM (&#xD;&#xA;        SELECT&#xD;&#xA;            ROW_NUMBER() OVER (ORDER BY v.SortNo) AS Rn,&#xD;&#xA;            CASE v.SortNo&#xD;&#xA;                WHEN 1 THEN CONCAT(N'تقبل العطـــاءات بمقر / صندوق تكريم شهداء و ضحايا و مفقودي ومصابي العمليات الحربية و الإرهـابـية والأمـنية وأسـرهم بجهة القــاهـرة في مـوعد أقصـاه الســـاعة ١٢ ظهراً يوم ', ISNULL(FORMAT(b.TCHNCL_OPN_DT, 'dddd', 'ar-EG'), N''), N' الموافق ', NCHAR(8206)+REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(CASE WHEN b.TCHNCL_OPN_DT IS NULL THEN '' ELSE RIGHT('0000'+CAST(YEAR(b.TCHNCL_OPN_DT) AS varchar(4)),4)+'/'+RIGHT('00'+CAST(MONTH(b.TCHNCL_OPN_DT) AS varchar(2)),2)+'/'+RIGHT('00'+CAST(DAY(b.TCHNCL_OPN_DT) AS varchar(2)),2) END, '0', N'٠'), '1', N'١'), '2', N'٢'), '3', N'٣'), '4', N'٤'), '5', N'٥'), '6', N'٦'), '7', N'٧'), '8', N'٨'), '9', N'٩')+NCHAR(8206))&#xD;&#xA;                WHEN 2 THEN CONCAT(N'يرفق مع العطاء تأمين ابتدائي قدره (', REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(ISNULL(CONVERT(varchar(40), b.VST_NO), ''), '0', N'٠'), '1', N'١'), '2', N'٢'), '3', N'٣'), '4', N'٤'), '5', N'٥'), '6', N'٦'), '7', N'٧'), '8', N'٨'), '9', N'٩'), N' جنيه فقط ', ISNULL(b.tfqet, N''), N') يسدد نقدا بموجب إيصال أو بموجب خطاب ضمان بنكي غير مشروط أو بشيك مصرفي أو معتمد من البنك الصادر منه ولن يلتفت للعطاء الذي يرد بدون كامل التأمين الابتدائي')&#xD;&#xA;                WHEN 3 THEN N'تقدم العطاءات داخل مظاريف مغلقة (مظروف فني / مظروف مالي) باسم السيد مدير إدارة / العقود و المشتريات'&#xD;&#xA;                WHEN 4 THEN N'تقدم العينات للأصناف المطلوبة قبل ميعاد فتح المظاريف بأسبوع في حالة حاجة الأصناف إلى ذلك'&#xD;&#xA;                WHEN 5 THEN N'طريقة الدفع بشيك أو تحويل بنكي بعد الفحص والإستلام وتقديم الفواتير (أو تحدد بمعرفة الصندوق)'&#xD;&#xA;                WHEN 6 THEN N'على المورد اتباع كافة تعليمات الأمن التي يصدرها الصندوق في هذا الشأن'&#xD;&#xA;                WHEN 7 THEN N'التعاقد والتوريد طبقاً لأحكام القانون رقم ١٨٢ لسنة ٢٠١٨ ولائحته التنفيذية والقرارات والقوانين المعدلة أو المكملة له'&#xD;&#xA;                WHEN 8 THEN CONCAT(N'تحدد موعد فتح المظاريف الفنية الساعة ١٢ ظهراً يوم ', ISNULL(FORMAT(b.TCHNCL_OPN_DT, 'dddd', 'ar-EG'), N''), N' الموافق ', NCHAR(8206)+REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(CASE WHEN b.TCHNCL_OPN_DT IS NULL THEN '' ELSE RIGHT('0000'+CAST(YEAR(b.TCHNCL_OPN_DT) AS varchar(4)),4)+'/'+RIGHT('00'+CAST(MONTH(b.TCHNCL_OPN_DT) AS varchar(2)),2)+'/'+RIGHT('00'+CAST(DAY(b.TCHNCL_OPN_DT) AS varchar(2)),2) END, '0', N'٠'), '1', N'١'), '2', N'٢'), '3', N'٣'), '4', N'٤'), '5', N'٥'), '6', N'٦'), '7', N'٧'), '8', N'٨'), '9', N'٩')+NCHAR(8206))&#xD;&#xA;                WHEN 9 THEN N'لن يلتفت للعطاءات التي ترد بعد هذا الموعد'&#xD;&#xA;                WHEN 10 THEN N'الإرتباط بالأسعار الواردة بالعطاءات سارية لمدة ٣ شهور من تاريخ فتح المظاريف الفنية'&#xD;&#xA;                WHEN 11 THEN CONCAT(N'للصندوق الحق في تخفيض أو زيادة كميات بنسبة ٢٥% وبنفس الشروط والمواصفات والأسعار التي ',&#xD;&#xA;                    CASE WHEN ISNULL(NULLIF(b.PRCHS_OPRTN_TYP, 0), b.TR_TY) = 112 THEN N'ينتهي' ELSE N'تنتهي' END,&#xD;&#xA;                    N' إليها ',&#xD;&#xA;                    CASE&#xD;&#xA;                        WHEN ISNULL(NULLIF(b.PRCHS_OPRTN_TYP, 0), b.TR_TY) BETWEEN 102 AND 104 THEN N'المناقصة'&#xD;&#xA;                        WHEN ISNULL(NULLIF(b.PRCHS_OPRTN_TYP, 0), b.TR_TY) BETWEEN 105 AND 107 THEN N'الممارسة'&#xD;&#xA;                        WHEN ISNULL(NULLIF(b.PRCHS_OPRTN_TYP, 0), b.TR_TY) BETWEEN 108 AND 110 THEN N'المزايدة'&#xD;&#xA;                        WHEN ISNULL(NULLIF(b.PRCHS_OPRTN_TYP, 0), b.TR_TY) = 111 THEN N'السلفة المؤقتة'&#xD;&#xA;                        WHEN ISNULL(NULLIF(b.PRCHS_OPRTN_TYP, 0), b.TR_TY) = 112 THEN N'الأمر المباشر'&#xD;&#xA;                        ELSE N'المناقصة'&#xD;&#xA;                    END)&#xD;&#xA;                WHEN 12 THEN N'تقدم الكتالوجات والمواصفات الفنية للأصناف وقبل ميعاد فتح المظاريف الفنية'&#xD;&#xA;                WHEN 13 THEN N'التسليم بمخازن الصندوق (أو أي جهة يحددها الصندوق)'&#xD;&#xA;                WHEN 14 THEN N'يتم تحديد ماركة وجهة الصنع للأصناف كل صنف على حدة'&#xD;&#xA;                WHEN 15 THEN N'يتم التوريد للأصنـاف المطلوبة خالــصة مـن جميـع المصـاريف إلـى مخـازن الصنـدوق  (أو الجهة التي يحددها الصندوق)'&#xD;&#xA;                &#xD;&#xA;                WHEN 16 THEN CONCAT(N'العينات التي تقدم يجب أن ترفق بكل عينة بطاقة تثبت وتشمع بالشمع الأحمر ويحدد فيها اسم مقدم العطاء واسم الصنف ', REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(ISNULL(b.OPTRN_NM, N''), '0', N'٠'), '1', N'١'), '2', N'٢'), '3', N'٣'), '4', N'٤'), '5', N'٥'), '6', N'٦'), '7', N'٧'), '8', N'٨'), '9', N'٩'))&#xD;&#xA;                WHEN 17 THEN N'للصندوق الحق في استبعاد أي عطاء يتضمن اشتراط عدم التجزئة للكميات المتقدم بها'&#xD;&#xA;                WHEN 18 THEN N'لن يلتفت للعطــاءات التي تـتضمن اشتـراطات خاصة بالاستـيراد أو النـقد الأجنبي أو أي مساعدة في هذا القبيل بل يجب أن تورد الأصناف داخل مخازن الصندوق  ' + CHAR(13) + CHAR(10) + '  (أو الجهة التي يحددها الصندوق) على أساس العملة المصرية بدون أي قيود'&#xD;&#xA;                WHEN 19 THEN N'لا يلتزم الصندوق بالأخذ بأي تعديل على الشروط المدونة بأوراق العطاء وعلى مقدم العطاء إبداء ملاحظاته أو تعديلاته في خطاب منفصل يرفق بالعطاء'&#xD;&#xA;                WHEN 20 THEN N'للصندوق الحق في تحليل الأصناف التي يرى تحليلها في أي معامل معتمدة'&#xD;&#xA;                WHEN 21 THEN N' يشترط إظهار أسعار كل بنود الأصناف والخدمات المطلوبة منفصلة عن الضريبة على القيمة المضافة وتقدم الأسعار غير شاملة اي ضرائب او رسوم اخري'&#xD;&#xA;            END AS Txt&#xD;&#xA;        FROM (VALUES&#xD;&#xA;                (1, 0),&#xD;&#xA;                (2, 0),&#xD;&#xA;                (3, 0),&#xD;&#xA;                (4, 1),&#xD;&#xA;                (5, 0),&#xD;&#xA;                (6, 0),&#xD;&#xA;                (7, 0),&#xD;&#xA;                (8, 0),&#xD;&#xA;                (9, 0),&#xD;&#xA;                (10, 0),&#xD;&#xA;                (11, 0),&#xD;&#xA;                (12, 0),&#xD;&#xA;                (13, 0),&#xD;&#xA;                (14, 0),&#xD;&#xA;                (15, 0),&#xD;&#xA;                (16, 1),&#xD;&#xA;                (17, 0),&#xD;&#xA;                (18, 0),&#xD;&#xA;                (19, 0),&#xD;&#xA;                (20, 0),&#xD;&#xA;                (21, 0),&#xD;&#xA;                (22, 0)&#xD;&#xA;        ) v(SortNo, OilOnly)&#xD;&#xA;        WHERE v.OilOnly = 0 OR b.ShowChngOil = 1&#xD;&#xA;    ) z&#xD;&#xA;) c&#xD;&#xA;ORDER BY b.TR_NO, c.Rn" Name="sqlDataSource1" />
  </DataSources>
