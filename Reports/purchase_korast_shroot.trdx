        <TextBox Width="14mm" Height="6mm" Left="49.88mm" Top="9.92mm" Value="=Replace(Replace(Replace(Replace(Replace(Replace(Replace(Replace(Replace(Replace(CStr(PageCount), &quot;0&quot;, &quot;٠&quot;), &quot;1&quot;, &quot;١&quot;), &quot;2&quot;, &quot;٢&quot;), &quot;3&quot;, &quot;٣&quot;), &quot;4&quot;, &quot;٤&quot;), &quot;5&quot;, &quot;٥&quot;), &quot;6&quot;, &quot;٦&quot;), &quot;7&quot;, &quot;٧&quot;), &quot;8&quot;, &quot;٨&quot;), &quot;9&quot;, &quot;٩&quot;)" CanGrow="False" Culture="ar-EG" Name="textBox84">
