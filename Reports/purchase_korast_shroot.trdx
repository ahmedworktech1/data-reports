        <HtmlTextBox Width="19cm" Height="0.62cm" Left="0.45cm" Top="0cm" Value="=&quot;&lt;div style='width:100%;margin:0;padding:0 0 3px 0;direction:rtl;text-align:right;font-family:Arial;font-size:10pt;font-weight:bold;line-height:1.35;white-space:normal;'&gt;&quot; + Fields.ClauseLine + &quot;&lt;/div&gt;&quot;" CanGrow="True" CanShrink="False" Culture="ar-EG" Name="textBoxClause">
