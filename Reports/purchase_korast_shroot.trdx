        <TextBox Width="2.861in" Height="0.2in" Left="1.22in" Top="1.5in" Value="=Replace(Replace(Replace(Replace(Replace(Replace(Replace(Replace(Replace(Replace(IIf(Fields.PURCHAS_NO Is Null, &quot;&quot;, CStr(Fields.PURCHAS_NO)), &quot;0&quot;, &quot;٠&quot;), &quot;1&quot;, &quot;١&quot;), &quot;2&quot;, &quot;٢&quot;), &quot;3&quot;, &quot;٣&quot;), &quot;4&quot;, &quot;٤&quot;), &quot;5&quot;, &quot;٥&quot;), &quot;6&quot;, &quot;٦&quot;), &quot;7&quot;, &quot;٧&quot;), &quot;8&quot;, &quot;٨&quot;), &quot;9&quot;, &quot;٩&quot;)" Culture="ar-EG" Name="textBox110">
