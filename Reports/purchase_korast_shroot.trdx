          </Style>
        </TextBox>
        <TextBox Width="5.8cm" Height="0.5cm" Left="13.112cm" Top="8.097cm" Value="(أو الجهـــــة التــــــــــى يحددهــــــــــا الصندوق)" Name="textBox50">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="1.038cm" Height="0.5cm" Left="18.912cm" Top="8.594cm" Value="16 -" Name="textBox51">
          <Style TextAlign="Right" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="10.3cm" Height="0.5cm" Left="8.612cm" Top="8.597cm" Value="العينات التي تقدم يجب أن ترفق بكل عينه بطاقة تثبت وتشمع بالشمع الأحمر ويحدد فيها" Name="textBox52">
          <Style TextAlign="Right" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="3.663cm" Height="0.5cm" Left="15.249cm" Top="9.098cm" Value="إسم مقدم العطاء وإسم الصنف " Name="textBox53">
          <Style TextAlign="Right" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="1.038cm" Height="0.5cm" Left="18.912cm" Top="9.598cm" Value="17 -" Name="textBox54">
          <Style TextAlign="Right" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="9.9cm" Height="0.5cm" Left="9.012cm" Top="9.598cm" Value="للصندوق الحق فى إستبعاد أى عطاء يتضمن إشتراط عدم التجزئة للكميات المتقدم بها" Name="textBox55">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="1.038cm" Height="0.5cm" Left="18.912cm" Top="10.098cm" Value="18 -" Name="textBox56">
          <Style TextAlign="Right" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="10.7cm" Height="0.5cm" Left="8.212cm" Top="10.098cm" Value=" لن يلتفت للعطاءات التى تتضمن إشتراطات خاصة بالإستيراد أو النقد الأجبني أو أى مساعدة" Name="textBox57">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="7.3cm" Height="0.5cm" Left="11.612cm" Top="10.598cm" Value="في هذا القبيل بل يجب أن تورد الأصناف داخل مخازن الصندوق " Name="textBox59">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="5.012cm" Height="0.5cm" Left="13.9cm" Top="11.098cm" Value="على اساس العمله المصرية بدون أي قيود" Name="textBox58">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="0.85cm" Height="0.5cm" Left="19.1cm" Top="11.599cm" Value="19 -" Name="textBox60">
          <Style TextAlign="Right" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="12.3cm" Height="0.5cm" Left="6.8cm" Top="11.599cm" Value="لا يلتزم الصندوق بالأخذ بأي تعديل على الشروط المدونه بأوراق العطاء وعلى مقدم العطاء إبداء ملاحظاته " Name="textBox61">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="5.1cm" Height="0.495cm" Left="13.812cm" Top="12.104cm" Value="أو تعديلاته فى خطاب منفصل يرفق بالعطاء" Name="textBox62">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="1.038cm" Height="0.5cm" Left="18.912cm" Top="12.594cm" Value="20 -" Name="textBox63">
          <Style TextAlign="Right" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="8.6cm" Height="0.5cm" Left="10.312cm" Top="12.599cm" Value="للصندوق الحق فى تحليل الأصناف التى يرى تحليلها في أي معامل معتمدة" Name="textBox64">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="1.038cm" Height="0.5cm" Left="18.912cm" Top="13.094cm" Value="21 -" Name="textBox65">
          <Style TextAlign="Right" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="12.112cm" Height="0.5cm" Left="6.8cm" Top="13.099cm" Value="يشترط إظهار أسعار كل بند من بنود الاصناف والخدمات المطلوبه منفصله عن أسعار الضريبة على القيمة" Name="textBox66">
          <Style TextAlign="Right" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="10.3cm" Height="0.5cm" Left="8.612cm" Top="13.599cm" Value=" المضافة منفصله غير شامله الضريبه علي القيمه المضافه او اي ضرائب ورسوم اخري " Name="textBox67">
          <Style TextAlign="Right" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="1.038cm" Height="0.5cm" Left="18.912cm" Top="14.1cm" Value="22 -" Name="textBox68">
          <Style TextAlign="Right" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="12.712cm" Height="0.5cm" Left="6.2cm" Top="14.1cm" Value="جميع إجراءات التعاقد تتم طبقاً لأحكام القانون رقم 182 لسة 2018 بشأن تنظيم التعاقدات التي تبرمها الجهات " Name="textBox69">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="2.9cm" Height="0.5cm" Left="16.012cm" Top="14.6cm" Value="العامة ولائحته التنفيذيه" Name="textBox70">
