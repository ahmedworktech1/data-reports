  <PageSettings PaperKind="A4" Landscape="False" ContinuousPaper="False">
    <Margins>
      <MarginsU Left="0.5cm" Right="0.5cm" Top="0.5cm" Bottom="0.5cm" />
    </Margins>
  </PageSettings>
  <StyleSheet>
    <StyleRule>
      <Style>
        <Padding Left="2pt" Right="2pt" />
      </Style>
      <Selectors>
        <TypeSelector Type="TextItemBase" />
        <TypeSelector Type="HtmlTextBox" />
      </Selectors>
    </StyleRule>
  </StyleSheet>
  <Groups>
    <Group Name="group">
      <GroupHeader>
        <GroupHeaderSection Height="0.01cm" Name="groupHeaderSection">
          <Style Visible="False" />
        </GroupHeaderSection>
      </GroupHeader>
      <GroupFooter>
        <GroupFooterSection Height="1.698cm" Name="groupFooterSection">
          <Items>
            <TextBox Width="1.422cm" Height="0.55cm" Left="4.954cm" Top="0.048cm" Value="التوقيع" Name="textBoxSigLabel">
              <Style TextAlign="Left" VerticalAlign="Middle">
                <Font Size="11pt" Bold="True" />
              </Style>
            </TextBox>
            <TextBox Width="3.9cm" Height="0.55cm" Left="1.054cm" Top="0.048cm" Value="(                              )" Name="textBoxSigParen">
              <Style TextAlign="Right" VerticalAlign="Middle">
                <Font Size="11pt" Bold="True" />
              </Style>
            </TextBox>
            <TextBox Width="5.6cm" Height="0.55cm" Left="0.788cm" Top="0.598cm" Value="مدير عام الإدارة العامة" Name="textBoxSigTitle1">
              <Style TextAlign="Center" VerticalAlign="Middle">
                <Font Size="11pt" Bold="True" />
              </Style>
            </TextBox>
            <TextBox Width="5.6cm" Height="0.55cm" Left="0.788cm" Top="1.148cm" Value="للتعاقدات و المشتريات" Name="textBoxSigTitle2">
              <Style TextAlign="Center" VerticalAlign="Middle">
                <Font Size="11pt" Bold="True" />
              </Style>
            </TextBox>
          </Items>
        </GroupFooterSection>
      </GroupFooter>
      <Groupings>
        <Grouping Expression="= Fields.TR_NO" />
      </Groupings>
    </Group>
  </Groups>
</Report>