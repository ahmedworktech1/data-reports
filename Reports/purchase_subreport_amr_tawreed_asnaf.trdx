<?xml version="1.0" encoding="utf-8"?><Report Width="19.4cm" Name="purchase_subreport_amr_tawreed_asnaf" xmlns="http://schemas.telerik.com/reporting/2023/1.0"><DataSources><SqlDataSource ConnectionString="azxsandoaa" SelectCommand="-- أمر توريد / إسناد: the order's lines (unit price = final price of the financial decision, carried to the order),&#xA;-- product specifications from the supplier's financial opening (117)&#xA;SELECT&#xA;    dbo._GetArabicNumbers(CAST(d.LN_NO AS VARCHAR(10))) AS LnNo,&#xA;    dbo._GetArabicNumbers(LTRIM(RTRIM(i.ITM_NM_AR))) AS ItemName,&#xA;    LTRIM(RTRIM(p.PK_NM_AR)) AS UnitName,&#xA;    dbo._GetArabicNumbers(FORMAT(d.QTY, '#,##0.###')) AS QtyText,&#xA;    dbo._GetArabicNumbers(FORMAT(d.PKPRC, '#,##0.##')) AS PriceText,&#xA;    dbo._GetArabicNumbers(FORMAT(d.QTY * d.PKPRC, '#,##0.##')) AS TotalText,&#xA;    dbo._GetArabicNumbers(COALESCE(NULLIF(LTRIM(RTRIM(s.RMRK2)), ''), NULLIF(LTRIM(RTRIM(s.RMRK3)), ''), NULLIF(LTRIM(RTRIM(d.RMRK2)), ''), N'')) AS Specs&#xA;FROM AZTRD d&#xA;INNER JOIN AZTRH h ON h.LOC = d.LOC AND h.TR_TY = d.TR_TY AND h.TR_NO = d.TR_NO&#xA;LEFT JOIN AZITMS i ON i.ITM_CD = d.ITM_CD&#xA;LEFT JOIN AZPKGDEF p ON p.PKID = d.PKID&#xA;OUTER APPLY (&#xA;    SELECT TOP 1 f.RMRK2, f.RMRK3 FROM AZTRD f&#xA;    WHERE f.TR_TY = 117 AND f.PLOC2 = h.PLoc AND f.PTR_TY2 = h.PTR_TY AND f.PTR_NO2 = h.PTR_NO&#xA;      AND LTRIM(RTRIM(f.ACC_NO)) = LTRIM(RTRIM(h.Acc_No)) AND f.ITM_CD = d.ITM_CD&#xA;    ORDER BY f.TR_NO DESC&#xA;) s&#xA;WHERE d.LOC = @Loc AND d.TR_TY = @TrTy AND d.TR_NO = @TrNo&#xA;ORDER BY d.LN_NO" Name="dsLines"><Parameters><SqlDataSourceParameter DbType="String" Name="@Loc"><Value><String>= Parameters.Loc.Value</String></Value></SqlDataSourceParameter><SqlDataSourceParameter DbType="String" Name="@TrTy"><Value><String>= Parameters.TrTy.Value</String></Value></SqlDataSourceParameter><SqlDataSourceParameter DbType="String" Name="@TrNo"><Value><String>= Parameters.TrNo.Value</String></Value></SqlDataSourceParameter></Parameters></SqlDataSource></DataSources><Items><DetailSection Height="1.8cm" Name="detailSection1"><Items><Table DataSourceName="dsLines" Width="19.4cm" Height="1.8cm" Left="0cm" Top="0cm" ColumnHeadersPrintOnEveryPage="True" Name="tbl"><Body><Cells><TableCell RowIndex="0" ColumnIndex="0" RowSpan="1" ColumnSpan="1"><ReportItem><TextBox Width="4.2cm" Height="0.8cm" Left="0cm" Top="0cm" Value="= Fields.Specs" CanGrow="True" Name="tbl_c0"><Style TextAlign="Right" VerticalAlign="Middle"><Font Size="11pt" Bold="True" /><Padding Left="3pt" Right="3pt" /><BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" /><BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" /><BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" /></Style></TextBox></ReportItem></TableCell><TableCell RowIndex="0" ColumnIndex="1" RowSpan="1" ColumnSpan="1"><ReportItem><TextBox Width="2.6cm" Height="0.8cm" Left="0cm" Top="0cm" Value="= Fields.TotalText" CanGrow="True" Name="tbl_c1"><Style TextAlign="Center" VerticalAlign="Middle"><Font Size="11pt" Bold="True" /><Padding Left="3pt" Right="3pt" /><BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" /><BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" /><BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" /></Style></TextBox></ReportItem></TableCell><TableCell RowIndex="0" ColumnIndex="2" RowSpan="1" ColumnSpan="1"><ReportItem><TextBox Width="2.3cm" Height="0.8cm" Left="0cm" Top="0cm" Value="= Fields.PriceText" CanGrow="True" Name="tbl_c2"><Style TextAlign="Center" VerticalAlign="Middle"><Font Size="11pt" Bold="True" /><Padding Left="3pt" Right="3pt" /><BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" /><BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" /><BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" /></Style></TextBox></ReportItem></TableCell><TableCell RowIndex="0" ColumnIndex="3" RowSpan="1" ColumnSpan="1"><ReportItem><TextBox Width="1.7cm" Height="0.8cm" Left="0cm" Top="0cm" Value="= Fields.QtyText" CanGrow="True" Name="tbl_c3"><Style TextAlign="Center" VerticalAlign="Middle"><Font Size="11pt" Bold="True" /><Padding Left="3pt" Right="3pt" /><BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" /><BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" /><BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" /></Style></TextBox></ReportItem></TableCell><TableCell RowIndex="0" ColumnIndex="4" RowSpan="1" ColumnSpan="1"><ReportItem><TextBox Width="1.7cm" Height="0.8cm" Left="0cm" Top="0cm" Value="= Fields.UnitName" CanGrow="True" Name="tbl_c4"><Style TextAlign="Center" VerticalAlign="Middle"><Font Size="11pt" Bold="True" /><Padding Left="3pt" Right="3pt" /><BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" /><BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" /><BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" /></Style></TextBox></ReportItem></TableCell><TableCell RowIndex="0" ColumnIndex="5" RowSpan="1" ColumnSpan="1"><ReportItem><TextBox Width="6cm" Height="0.8cm" Left="0cm" Top="0cm" Value="= Fields.ItemName" CanGrow="True" Name="tbl_c5"><Style TextAlign="Right" VerticalAlign="Middle"><Font Size="11pt" Bold="True" /><Padding Left="3pt" Right="3pt" /><BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" /><BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" /><BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" /></Style></TextBox></ReportItem></TableCell><TableCell RowIndex="0" ColumnIndex="6" RowSpan="1" ColumnSpan="1"><ReportItem><TextBox Width="0.9cm" Height="0.8cm" Left="0cm" Top="0cm" Value="= Fields.LnNo" CanGrow="True" Name="tbl_c6"><Style TextAlign="Center" VerticalAlign="Middle"><Font Size="11pt" Bold="True" /><Padding Left="3pt" Right="3pt" /><BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" /><BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" /><BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" /></Style></TextBox></ReportItem></TableCell></Cells><Columns><Column Width="4.2cm" /><Column Width="2.6cm" /><Column Width="2.3cm" /><Column Width="1.7cm" /><Column Width="1.7cm" /><Column Width="6cm" /><Column Width="0.9cm" /></Columns><Rows><Row Height="0.8cm" /></Rows></Body><Corner /><RowGroups><TableGroup Name="tbl_detail"><Groupings><Grouping /></Groupings></TableGroup></RowGroups><ColumnGroups><TableGroup Name="tbl_g0"><ReportItem><TextBox Width="4.2cm" Height="1cm" Left="0cm" Top="0cm" Value="مواصفات المنتج" CanGrow="True" Name="tbl_h0"><Style TextAlign="Center" VerticalAlign="Middle" BackgroundColor="217, 217, 217"><Font Size="11pt" Bold="True" /><Padding Left="3pt" Right="3pt" /><BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" /><BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" /><BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" /></Style></TextBox></ReportItem></TableGroup><TableGroup Name="tbl_g1"><ReportItem><TextBox Width="2.6cm" Height="1cm" Left="0cm" Top="0cm" Value="الإجمالي&#xA;( جم )" CanGrow="True" Name="tbl_h1"><Style TextAlign="Center" VerticalAlign="Middle" BackgroundColor="217, 217, 217"><Font Size="11pt" Bold="True" /><Padding Left="3pt" Right="3pt" /><BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" /><BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" /><BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" /></Style></TextBox></ReportItem></TableGroup><TableGroup Name="tbl_g2"><ReportItem><TextBox Width="2.3cm" Height="1cm" Left="0cm" Top="0cm" Value="سعر الوحدة&#xA;( جم )" CanGrow="True" Name="tbl_h2"><Style TextAlign="Center" VerticalAlign="Middle" BackgroundColor="217, 217, 217"><Font Size="11pt" Bold="True" /><Padding Left="3pt" Right="3pt" /><BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" /><BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" /><BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" /></Style></TextBox></ReportItem></TableGroup><TableGroup Name="tbl_g3"><ReportItem><TextBox Width="1.7cm" Height="1cm" Left="0cm" Top="0cm" Value="الكمية" CanGrow="True" Name="tbl_h3"><Style TextAlign="Center" VerticalAlign="Middle" BackgroundColor="217, 217, 217"><Font Size="11pt" Bold="True" /><Padding Left="3pt" Right="3pt" /><BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" /><BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" /><BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" /></Style></TextBox></ReportItem></TableGroup><TableGroup Name="tbl_g4"><ReportItem><TextBox Width="1.7cm" Height="1cm" Left="0cm" Top="0cm" Value="الوحدة" CanGrow="True" Name="tbl_h4"><Style TextAlign="Center" VerticalAlign="Middle" BackgroundColor="217, 217, 217"><Font Size="11pt" Bold="True" /><Padding Left="3pt" Right="3pt" /><BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" /><BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" /><BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" /></Style></TextBox></ReportItem></TableGroup><TableGroup Name="tbl_g5"><ReportItem><TextBox Width="6cm" Height="1cm" Left="0cm" Top="0cm" Value="إسم الصنف" CanGrow="True" Name="tbl_h5"><Style TextAlign="Center" VerticalAlign="Middle" BackgroundColor="217, 217, 217"><Font Size="11pt" Bold="True" /><Padding Left="3pt" Right="3pt" /><BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" /><BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" /><BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" /></Style></TextBox></ReportItem></TableGroup><TableGroup Name="tbl_g6"><ReportItem><TextBox Width="0.9cm" Height="1cm" Left="0cm" Top="0cm" Value="م" CanGrow="True" Name="tbl_h6"><Style TextAlign="Center" VerticalAlign="Middle" BackgroundColor="217, 217, 217"><Font Size="11pt" Bold="True" /><Padding Left="3pt" Right="3pt" /><BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" /><BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" /><BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" /></Style></TextBox></ReportItem></TableGroup></ColumnGroups></Table></Items></DetailSection></Items><PageSettings PaperKind="A4" Landscape="False"><Margins><MarginsU Left="0cm" Right="0cm" Top="0cm" Bottom="0cm" /></Margins></PageSettings><ReportParameters><ReportParameter Name="Loc" AllowNull="True" /><ReportParameter Name="TrTy" AllowNull="True" /><ReportParameter Name="TrNo" AllowNull="True" /></ReportParameters></Report>