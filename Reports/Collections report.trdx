<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource1" Width="28.8cm" Name="Contracts report-39" Zoom="1.5" ShowSnapGrid="True" xmlns="http://schemas.telerik.com/reporting/2021/1.0">
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="AQALHAFEZ" SelectCommand="SELECT        TOP (100) PERCENT dbo.AQCOLLECT_H.Tr_NO, dbo.AQCOLLECT_H.CONTRACT_NO,&#xD;&#xA;                             (SELECT        BLD_DSCR_AR&#xD;&#xA;                                FROM            dbo.BLDMF&#xD;&#xA;                                WHERE        (BLD_CD = dbo.AQCOLLECT_H.BLD_CD)) AS BLD_DSCR_AR,&#xD;&#xA;                             (SELECT        TENANT_Nm_AR&#xD;&#xA;                                FROM            dbo.tenantMF&#xD;&#xA;                                WHERE        (TENANT_NO = dbo.AQCOLLECT_H.TENANT_NO)) AS TENANT_NM_AR, dbo.AQCOLLECT_H.YR, dbo.AQCOLLECT_H.Mnth, &#xD;&#xA;                         dbo.Earn_Records.AMT - dbo.Earn_Records.admin_Disc + ISNULL(dbo.Earn_Records.SRV_AMT, 0) AS NET, dbo.Earn_Records.pay_amt, dbo.Earn_Records.Rem, dbo.UNTMF.UNT_DSCR_AR, dbo.AQCOLLECT_H.PAYED_AMT, &#xD;&#xA;                         dbo.AQCOLLECT_D.DUE_DT, dbo.AQCOLLECT_H.TR_Dt, dbo.AQLIST60.DSCR_AR, CASE WHEN Collect_Stat = 1 THEN 'تأمينات' ELSE CASE WHEN Collect_Stat = 2 THEN 'خدمات' ELSE 'ايجار' END END AS TYP, &#xD;&#xA;                         CASE WHEN ISNULL(dbo.AQCOLLECT_H.DOC_TYP, 0) = 0 THEN ' سارى' ELSE ' ملغى ' END AS STAT&#xD;&#xA;FROM            dbo.AQCOLLECT_H INNER JOIN&#xD;&#xA;                         dbo.UNTMF ON dbo.AQCOLLECT_H.BLD_CD = dbo.UNTMF.BLD_CD AND dbo.AQCOLLECT_H.CONTRACT_NO = dbo.UNTMF.DOC_NO AND dbo.AQCOLLECT_H.TENANT_NO = dbo.UNTMF.TENANT_NO LEFT OUTER JOIN&#xD;&#xA;                         dbo.Earn_Records ON dbo.AQCOLLECT_H.CONTRACT_NO = dbo.Earn_Records.TR_NO AND dbo.AQCOLLECT_H.Mnth = dbo.Earn_Records.MNTH AND dbo.AQCOLLECT_H.YR = dbo.Earn_Records.YR LEFT OUTER JOIN&#xD;&#xA;                         dbo.AQCOLLECT_D ON dbo.AQCOLLECT_H.Tr_NO = dbo.AQCOLLECT_D.TR_NO AND dbo.AQCOLLECT_H.CONTRACT_NO = dbo.AQCOLLECT_D.CONTRACT_NO LEFT OUTER JOIN&#xD;&#xA;                         dbo.AQLIST60 ON dbo.AQCOLLECT_D.BLD_KNET = dbo.AQLIST60.CODE" Name="sqlDataSource1" />
  </DataSources>
