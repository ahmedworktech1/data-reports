  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="glx2023tarheel" SelectCommand="select fa_cd,fa_nm,&#xD;&#xA;(case when sum(AFaVl_MV)=0 then NULL else sum(AFaVl_MV) end) as AFaVl_MV&#xD;&#xA;from (&#xD;&#xA;SELECT &#xD;&#xA;substring(famf.FA_CD,1,3) as fa_cd,'أولا :- الأصول' as fa_nm&#xD;&#xA;,0 as AFaVl_MV&#xD;&#xA;FROM (FAMF  LEFT JOIN FADPRC ON FADPRC.FA_CD=FAMF.FA_CD) &#xD;&#xA;WHERE (FAMF.FA_TY&lt;&gt;1) and  (FAMF.FA_TY&lt;&gt;5) and (FAMF.FA_CD like '111%' )&#xD;&#xA;and FADPRC.PRD='-99991'&#xD;&#xA;) as t &#xD;&#xA;group by t.fa_cd,t.fa_nm&#xD;&#xA;------&#xD;&#xA;------&#xD;&#xA;union all&#xD;&#xA;select fa_cd,fa_nm,&#xD;&#xA;(case when sum(AFaVl_MV)=0 then NULL else sum(AFaVl_MV) end) as AFaVl_MV&#xD;&#xA;from (&#xD;&#xA;SELECT &#xD;&#xA;substring(famf.FA_CD,1,2) as fa_cd,'أصول الجهد المتوسط' as fa_nm&#xD;&#xA;,((ISNULL(FADPRC.FA_VL,0) + Round(Cast(( + ISNULL(FADPRC.TOTADD,0) - &#xD;&#xA;ISNULL(FADPRC.TOTDSP,0))as decimal(18,4)),2)) *2/3 ) as AFaVl_MV&#xD;&#xA;FROM (FAMF  LEFT JOIN FADPRC ON FADPRC.FA_CD=FAMF.FA_CD) &#xD;&#xA;WHERE (FAMF.FA_TY&lt;&gt;1) and  (FAMF.FA_TY&lt;&gt;5) and  (FAMF.FA_CD like '111%' or FAMF.FA_CD like '112%' or&#xD;&#xA;FAMF.FA_CD like '113%' or FAMF.FA_CD like '114%' or FAMF.FA_CD like '115%' or FAMF.FA_CD like '116%')&#xD;&#xA;and FADPRC.PRD='-99991'&#xD;&#xA;) as t &#xD;&#xA;group by t.fa_cd,t.fa_nm&#xD;&#xA;&#xD;&#xA;union all&#xD;&#xA;select fa_cd,fa_nm,&#xD;&#xA;(case when sum(AFaVl_MV)=0 then NULL else sum(AFaVl_MV) end) as AFaVl_MV&#xD;&#xA;from (&#xD;&#xA;SELECT &#xD;&#xA;substring(famf.FA_CD,1,2) as fa_cd,'يخصم منه مخصص الاهلاك' as fa_nm&#xD;&#xA;,((&#xD;&#xA;Cast(ISNULL(FAMF.DPRC,0)as decimal(18,4)) + &#xD;&#xA;Round(Cast((ISNULL((select sum(FADPRC.DPREXP)from FADPRC  &#xD;&#xA;where FAMF.FA_CD= FADPRC.FA_CD and FADPRC.PRD &lt;='-99991') ,0) )as decimal(18,4)),2) &#xD;&#xA;+ Cast(ISNULL(FAMF.PYRDPRC,0)as decimal(18,4))&#xD;&#xA;+ Cast(ISNULL((select sum(FADPRC.TOTADDACC)from FADPRC  &#xD;&#xA;where FAMF.FA_CD= FADPRC.FA_CD and FADPRC.PRD='-99991') ,0)as decimal(18,4))&#xD;&#xA;-&#xD;&#xA;Round(Cast(ISNULL((select sum(FADPRC.TOTDSPACC)from FADPRC  &#xD;&#xA;where FAMF.FA_CD= FADPRC.FA_CD and FADPRC.PRD='-99991') ,0)as decimal(18,4)),2)&#xD;&#xA;-Round(Cast((ISNULL((select sum(FADPRC.DSP_DPREXP)from FADPRC  &#xD;&#xA;where FAMF.FA_CD= FADPRC.FA_CD and FADPRC.PRD &lt;='-99991') ,0) )as decimal(18,4)),2)&#xD;&#xA;)*2/3) as AFaVl_MV&#xD;&#xA;FROM (FAMF  LEFT JOIN FADPRC ON FADPRC.FA_CD=FAMF.FA_CD) &#xD;&#xA;WHERE (FAMF.FA_TY&lt;&gt;1) and  (FAMF.FA_TY&lt;&gt;5) and  (FAMF.FA_CD like '111%' or FAMF.FA_CD like '112%' or&#xD;&#xA;FAMF.FA_CD like '113%' or FAMF.FA_CD like '114%' or FAMF.FA_CD like '115%' or FAMF.FA_CD like '116%')&#xD;&#xA;and FADPRC.PRD='-99991'&#xD;&#xA;) as t &#xD;&#xA;group by t.fa_cd,t.fa_nm&#xD;&#xA;&#xD;&#xA;union all&#xD;&#xA;select fa_cd,fa_nm,&#xD;&#xA;(case when sum(AFaVl_MV)=0 then NULL else sum(AFaVl_MV) end) as AFaVl_MV&#xD;&#xA;from (&#xD;&#xA;SELECT &#xD;&#xA;substring(famf.FA_CD,1,2) as fa_cd,'صافي الاصول الثابتة' as fa_nm,&#xD;&#xA;(((ISNULL(FADPRC.FA_VL,0) + Round(Cast(( + ISNULL(FADPRC.TOTADD,0) - &#xD;&#xA;ISNULL(FADPRC.TOTDSP,0))as decimal(18,4)),2)) *2/3 )&#xD;&#xA;-&#xD;&#xA;((&#xD;&#xA;Cast(ISNULL(FAMF.DPRC,0)as decimal(18,4)) + &#xD;&#xA;Round(Cast((ISNULL((select sum(FADPRC.DPREXP)from FADPRC  &#xD;&#xA;where FAMF.FA_CD= FADPRC.FA_CD and FADPRC.PRD &lt;='-99991') ,0) )as decimal(18,4)),2) &#xD;&#xA;+ Cast(ISNULL(FAMF.PYRDPRC,0)as decimal(18,4))&#xD;&#xA;+ Cast(ISNULL((select sum(FADPRC.TOTADDACC)from FADPRC  &#xD;&#xA;where FAMF.FA_CD= FADPRC.FA_CD and FADPRC.PRD='-99991') ,0)as decimal(18,4))&#xD;&#xA;-&#xD;&#xA;Round(Cast(ISNULL((select sum(FADPRC.TOTDSPACC)from FADPRC  &#xD;&#xA;where FAMF.FA_CD= FADPRC.FA_CD and FADPRC.PRD='-99991') ,0)as decimal(18,4)),2)&#xD;&#xA;-Round(Cast((ISNULL((select sum(FADPRC.DSP_DPREXP)from FADPRC  &#xD;&#xA;where FAMF.FA_CD= FADPRC.FA_CD and FADPRC.PRD &lt;='-99991') ,0) )as decimal(18,4)),2)&#xD;&#xA;)*2/3)) as AFaVl_MV&#xD;&#xA;FROM (FAMF  LEFT JOIN FADPRC ON FADPRC.FA_CD=FAMF.FA_CD) &#xD;&#xA;WHERE (FAMF.FA_TY&lt;&gt;1) and  (FAMF.FA_TY&lt;&gt;5) and  (FAMF.FA_CD like '111%' or FAMF.FA_CD like '112%' or&#xD;&#xA;FAMF.FA_CD like '113%' or FAMF.FA_CD like '114%' or FAMF.FA_CD like '115%' or FAMF.FA_CD like '116%')&#xD;&#xA;and FADPRC.PRD='-99991'&#xD;&#xA;) as t &#xD;&#xA;group by t.fa_cd,t.fa_nm&#xD;&#xA;&#xD;&#xA;union all&#xD;&#xA;select fa_cd,fa_nm,&#xD;&#xA;(case when sum(AFaVl_MV)=0 then NULL else sum(AFaVl_MV) end) as AFaVl_MV&#xD;&#xA;from (&#xD;&#xA;SELECT &#xD;&#xA;substring(famf.FA_CD,1,2) as fa_cd,'اصول الجهد المنخفض' as fa_nm&#xD;&#xA;,((ISNULL(FADPRC.FA_VL,0) + Round(Cast(( + ISNULL(FADPRC.TOTADD,0) - &#xD;&#xA;ISNULL(FADPRC.TOTDSP,0))as decimal(18,4)),2)) *1/3 ) as AFaVl_MV&#xD;&#xA;FROM (FAMF  LEFT JOIN FADPRC ON FADPRC.FA_CD=FAMF.FA_CD) &#xD;&#xA;WHERE (FAMF.FA_TY&lt;&gt;1) and  (FAMF.FA_TY&lt;&gt;5) and  (FAMF.FA_CD like '111%' or FAMF.FA_CD like '112%' or&#xD;&#xA;FAMF.FA_CD like '113%' or FAMF.FA_CD like '114%' or FAMF.FA_CD like '115%' or FAMF.FA_CD like '116%')&#xD;&#xA;and FADPRC.PRD='-99991'&#xD;&#xA;) as t &#xD;&#xA;group by t.fa_cd,t.fa_nm&#xD;&#xA;&#xD;&#xA;union all&#xD;&#xA;select fa_cd,fa_nm,&#xD;&#xA;(case when sum(AFaVl_MV)=0 then NULL else sum(AFaVl_MV) end) as AFaVl_MV&#xD;&#xA;from (&#xD;&#xA;SELECT &#xD;&#xA;substring(famf.FA_CD,1,2) as fa_cd,'يخصم منه مخصص الاهلاك' as fa_nm&#xD;&#xA;,(&#xD;&#xA;Cast(ISNULL(FAMF.DPRC,0)as decimal(18,4)) + &#xD;&#xA;Round(Cast((ISNULL((select sum(FADPRC.DPREXP)from FADPRC  &#xD;&#xA;where FAMF.FA_CD= FADPRC.FA_CD and FADPRC.PRD &lt;='-99991') ,0) )as decimal(18,4)),2) &#xD;&#xA;+ Cast(ISNULL(FAMF.PYRDPRC,0)as decimal(18,4))&#xD;&#xA;+ Cast(ISNULL((select sum(FADPRC.TOTADDACC)from FADPRC  &#xD;&#xA;where FAMF.FA_CD= FADPRC.FA_CD and FADPRC.PRD='-99991') ,0)as decimal(18,4))&#xD;&#xA;-&#xD;&#xA;Round(Cast(ISNULL((select sum(FADPRC.TOTDSPACC)from FADPRC  &#xD;&#xA;where FAMF.FA_CD= FADPRC.FA_CD and FADPRC.PRD='-99991') ,0)as decimal(18,4)),2)&#xD;&#xA;-Round(Cast((ISNULL((select sum(FADPRC.DSP_DPREXP)from FADPRC  &#xD;&#xA;where FAMF.FA_CD= FADPRC.FA_CD and FADPRC.PRD &lt;='-99991') ,0) )as decimal(18,4)),2)&#xD;&#xA;) as AFaVl_MV&#xD;&#xA;FROM (FAMF  LEFT JOIN FADPRC ON FADPRC.FA_CD=FAMF.FA_CD) &#xD;&#xA;WHERE (FAMF.FA_TY&lt;&gt;1) and  (FAMF.FA_TY&lt;&gt;5) and  (FAMF.FA_CD like '111%' or FAMF.FA_CD like '112%' or&#xD;&#xA;FAMF.FA_CD like '113%' or FAMF.FA_CD like '114%' or FAMF.FA_CD like '115%' or FAMF.FA_CD like '116%')&#xD;&#xA;and FADPRC.PRD='-99991'&#xD;&#xA;) as t &#xD;&#xA;group by t.fa_cd,t.fa_nm&#xD;&#xA;&#xD;&#xA;union all&#xD;&#xA;select fa_cd,fa_nm,&#xD;&#xA;(case when sum(AFaVl_MV)=0 then NULL else sum(AFaVl_MV) end) as AFaVl_MV&#xD;&#xA;from (&#xD;&#xA;SELECT &#xD;&#xA;substring(famf.FA_CD,1,2) as fa_cd,'صافي الاصول الثابتة' as fa_nm&#xD;&#xA;,((ISNULL(FADPRC.FA_VL,0) + Round(Cast(( + ISNULL(FADPRC.TOTADD,0) - &#xD;&#xA;ISNULL(FADPRC.TOTDSP,0))as decimal(18,4)),2))&#xD;&#xA;-(&#xD;&#xA;Cast(ISNULL(FAMF.DPRC,0)as decimal(18,4)) + &#xD;&#xA;Round(Cast((ISNULL((select sum(FADPRC.DPREXP)from FADPRC  &#xD;&#xA;where FAMF.FA_CD= FADPRC.FA_CD and FADPRC.PRD &lt;='-99991') ,0) )as decimal(18,4)),2) &#xD;&#xA;+ Cast(ISNULL(FAMF.PYRDPRC,0)as decimal(18,4))&#xD;&#xA;+ Cast(ISNULL((select sum(FADPRC.TOTADDACC)from FADPRC  &#xD;&#xA;where FAMF.FA_CD= FADPRC.FA_CD and FADPRC.PRD='-99991') ,0)as decimal(18,4))&#xD;&#xA;-&#xD;&#xA;Round(Cast(ISNULL((select sum(FADPRC.TOTDSPACC)from FADPRC  &#xD;&#xA;where FAMF.FA_CD= FADPRC.FA_CD and FADPRC.PRD='-99991') ,0)as decimal(18,4)),2)&#xD;&#xA;-Round(Cast((ISNULL((select sum(FADPRC.DSP_DPREXP)from FADPRC  &#xD;&#xA;where FAMF.FA_CD= FADPRC.FA_CD and FADPRC.PRD &lt;='-99991') ,0) )as decimal(18,4)),2)&#xD;&#xA;)) as AFaVl_MV&#xD;&#xA;FROM (FAMF  LEFT JOIN FADPRC ON FADPRC.FA_CD=FAMF.FA_CD) &#xD;&#xA;WHERE (FAMF.FA_TY&lt;&gt;1) and  (FAMF.FA_TY&lt;&gt;5) and  (FAMF.FA_CD like '111%' or FAMF.FA_CD like '112%' or&#xD;&#xA;FAMF.FA_CD like '113%' or FAMF.FA_CD like '114%' or FAMF.FA_CD like '115%' or FAMF.FA_CD like '116%')&#xD;&#xA;and FADPRC.PRD='-99991'&#xD;&#xA;) as t &#xD;&#xA;group by t.fa_cd,t.fa_nm&#xD;&#xA;" Name="sqlDataSource1" />
