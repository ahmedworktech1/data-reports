    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="glx2023hassan" SelectCommand="select  'مشتريات بغرض البيع' as s,&#xD;&#xA;sum( case when (acc_no like '4[6-8]3%' and substring(cst_Cd,6,7) in ('62','72','82') and gljrnld.cst_Cd like '02%') then db_vl-cr_vl else 0 end ) /1000 as s1, &#xD;&#xA;sum( case when (acc_no like '4[6-8]3%' and substring(cst_Cd,6,7) in ('62','72','82') and gljrnld.cst_Cd like '03%')   then db_vl-cr_vl else 0 end)/1000 as s2,&#xD;&#xA;sum( case when  (acc_no like '4[6-8]3%' and substring(cst_Cd,6,7) in ('62','72','82') and gljrnld.cst_Cd like '04%') then db_vl-cr_vl else 0 end)/1000 as s3,&#xD;&#xA;sum( case when (acc_no like '4[6-8]3%' and substring(cst_Cd,6,7) in ('62','72','82') and gljrnld.cst_Cd like '05%')  then db_vl-cr_vl else 0 end)/1000 as s4,&#xD;&#xA;sum( case when (acc_no like '4[6-8]3%' and substring(cst_Cd,6,7) in ('62','72','82') and gljrnld.cst_Cd like '07%')  then db_vl-cr_vl else 0 end)/1000 as s5,&#xD;&#xA;sum( case when (acc_no like '4[6-8]3%' and substring(cst_Cd,6,7) in ('62','72','82') and gljrnld.cst_Cd like '09%')  then db_vl-cr_vl else 0 end)/1000 as s6,&#xD;&#xA;sum( case when (acc_no like '4[6-8]3%' and substring(cst_Cd,6,7) in ('62','72','82') and gljrnld.cst_Cd like '06%')  then db_vl-cr_vl else 0 end)/1000 as s7,&#xD;&#xA;sum( case when  (acc_no like '4[6-8]3%' and substring(cst_Cd,6,7) in ('62','72','82') and gljrnld.cst_Cd like '[01-09]%')  then db_vl-cr_vl else 0 end)/1000 as tot&#xD;&#xA;&#xD;&#xA;from gljrnld  WHERE  (acc_no like '4[6-8]3%' and substring(cst_Cd,6,7) in ('62','72','82') and gljrnld.cst_Cd like '[01-09]%') &#xD;&#xA;and (1=1)&#xD;&#xA;&#xD;&#xA;union all&#xD;&#xA;select  'مواد وخامات ووقود' as s,&#xD;&#xA;sum( case when (acc_no like '4[6-8]11%' and substring(cst_Cd,6,7) in ('62','72','82') and gljrnld.cst_Cd like '02%') then db_vl-cr_vl else 0 end ) /1000 as s1, &#xD;&#xA;sum( case when (acc_no like '4[6-8]11%' and substring(cst_Cd,6,7) in ('62','72','82') a