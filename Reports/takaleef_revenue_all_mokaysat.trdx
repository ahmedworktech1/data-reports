('62','72','82') and gljrnld.cst_Cd like '[01-09]%')  then db_vl-cr_vl else 0 end)) *100 as tot&#xD;&#xA;&#xD;&#xA;from gljrnld  WHERE  ((acc_no like '4[6-8]11%' or acc_no like '4[6-8]12%' or acc_no like '4[6-8]2%' or acc_no like '4[6-8]3%' or acc_no like '5[6-8]11%' or acc_no like '5[6-8]12%' or acc_no like '5[6-8]121%' or acc_no like '5[6-8]122%') and substring(cst_Cd,6,7) in ('62','72','82') and gljrnld.cst_Cd like '[01-09]%') &#xD;&#xA;and (1=1)&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;" Name="sqlDataSource1" />
