<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource1" Width="27.200cm" Name="QueryAztrhOprtn" xmlns="http://schemas.telerik.com/reporting/2023/1.0">
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="azxsandoaa2" SelectCommand="SELECT aztrh.LOC, aztrh.TR_TY, aztrty.Dscr_AR, aztrh.TR_NO, aztrh.TR_DT, aztrh.TR_DS, aztrh.DUE_DT, aztrh.ACC_NO, aztrh.ACC_NM, aztrh.RMRK, aztrh.LTOT, aztrh.EnteredBy, aztrh.EntryDate FROM dbo.AZTRH aztrh LEFT JOIN dbo.AZTRTY aztrty ON aztrty.Tr_Ty = aztrh.TR_TY ORDER BY aztrh.TR_DT DESC, aztrh.TR_NO" Name="sqlDataSource1" />
  </DataSources>
  <Items>
    <PageHeaderSection Height="1.2cm" Name="pageHeaderSection1">
      <Items>
        <TextBox Width="27.200cm" Height="0.6cm" Left="0cm" Top="0cm" Value="استعلام عن العمليات" Name="titleTextBox">
          <Style TextAlign="Center"><Font Bold="True" Size="12pt" /></Style>
        </TextBox>
        <TextBox Width="1.5cm" Height="0.6cm" Left="0.000cm" Top="0.6cm" Value="الفرع" Name="hdr_LOC"><Style BackgroundColor="Silver" Color="Black" TextAlign="Center" VerticalAlign="Middle"><Font Bold="True" Size="8pt" /><BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" /><BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" /><BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" /></Style></TextBox><TextBox Width="1.2cm" Height="0.6cm" Left="1.500cm" Top="0.6cm" Value="الحركة" Name="hdr_TR_TY"><Style BackgroundColor="Silver" Color="Black" TextAlign="Center" VerticalAlign="Middle"><Font Bold="True" Size="8pt" /><BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" /><BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" /><BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" /></Style></TextBox><TextBox Width="3cm" Height="0.6cm" Left="2.700cm" Top="0.6cm" Value="وصف الحركة" Name="hdr_Dscr_AR"><Style BackgroundColor="Silver" Color="Black" TextAlign="Center" VerticalAlign="Middle"><Font Bold="True" Size="8pt" /><BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" /><BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" /><BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" /></Style></TextBox><TextBox Width="2cm" Height="0.6cm" Left="5.700cm" Top="0.6cm" Value="رقم الحركة" Name="hdr_TR_NO"><Style BackgroundColor="Silver" Color="Black" TextAlign="Center" VerticalAlign="Middle"><Font Bold="True" Size="8pt" /><BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" /><BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" /><BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" /></Style></TextBox><TextBox Width="2.5cm" Height="0.6cm" Left="7.700cm" Top="0.6cm" Value="التاريخ" Name="hdr_TR_DT"><Style BackgroundColor="Silver" Color="Black" TextAlign="Center" VerticalAlign="Middle"><Font Bold="True" Size="8pt" /><BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" /><BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" /><BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" /></Style></TextBox><TextBox Width="2.5cm" Height="0.6cm" Left="10.200cm" Top="0.6cm" Value="تاريخ التنفيذ" Name="hdr_DUE_DT"><Style BackgroundColor="Silver" Color="Black" TextAlign="Center" VerticalAlign="Middle"><Font Bold="True" Size="8pt" /><BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" /><BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" /><BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" /></Style></TextBox><TextBox Width="3cm" Height="0.6cm" Left="12.700cm" Top="0.6cm" Value="الحساب" Name="hdr_ACC_NO"><Style BackgroundColor="Silver" Color="Black" TextAlign="Center" VerticalAlign="Middle"><Font Bold="True" Size="8pt" /><BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" /><BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" /><BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" /></Style></TextBox><TextBox Width="2.5cm" Height="0.6cm" Left="15.700cm" Top="0.6cm" Value="القيمة" Name="hdr_LTOT"><Style BackgroundColor="Silver" Color="Black" TextAlign="Center" VerticalAlign="Middle"><Font Bold="True" Size="8pt" /><BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" /><BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" /><BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" /></Style></TextBox><TextBox Width="4cm" Height="0.6cm" Left="18.200cm" Top="0.6cm" Value="ملاحظات" Name="hdr_RMRK"><Style BackgroundColor="Silver" Color="Black" TextAlign="Center" VerticalAlign="Middle"><Font Bold="True" Size="8pt" /><BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" /><BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" /><BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" /></Style></TextBox><TextBox Width="2.5cm" Height="0.6cm" Left="22.200cm" Top="0.6cm" Value="أدخله" Name="hdr_EnteredBy"><Style BackgroundColor="Silver" Color="Black" TextAlign="Center" VerticalAlign="Middle"><Font Bold="True" Size="8pt" /><BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" /><BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" /><BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" /></Style></TextBox><TextBox Width="2.5cm" Height="0.6cm" Left="24.700cm" Top="0.6cm" Value="تاريخ الإدخال" Name="hdr_EntryDate"><Style BackgroundColor="Silver" Color="Black" TextAlign="Center" VerticalAlign="Middle"><Font Bold="True" Size="8pt" /><BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" /><BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" /><BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" /></Style></TextBox>
      </Items>
    </PageHeaderSection>
    <DetailSection Height="0.7cm" Name="detailSection1">
      <Items>
        <TextBox Width="1.5cm" Height="0.6cm" Left="0.000cm" Top="0.6cm" Value="=IIf(Fields.LOC Is Nothing, '-', Fields.LOC)" Name="det_LOC"><Style TextAlign="Center" VerticalAlign="Middle"><Font Size="8pt" /><BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" /><BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" /><BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" /></Style></TextBox><TextBox Width="1.2cm" Height="0.6cm" Left="1.500cm" Top="0.6cm" Value="=IIf(Fields.TR_TY Is Nothing, '-', Fields.TR_TY)" Name="det_TR_TY"><Style TextAlign="Center" VerticalAlign="Middle"><Font Size="8pt" /><BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" /><BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" /><BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" /></Style></TextBox><TextBox Width="3cm" Height="0.6cm" Left="2.700cm" Top="0.6cm" Value="=IIf(Fields.Dscr_AR Is Nothing, '-', Fields.Dscr_AR)" Name="det_Dscr_AR"><Style TextAlign="Center" VerticalAlign="Middle"><Font Size="8pt" /><BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" /><BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" /><BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" /></Style></TextBox><TextBox Width="2cm" Height="0.6cm" Left="5.700cm" Top="0.6cm" Value="=IIf(Fields.TR_NO Is Nothing, '-', Fields.TR_NO)" Name="det_TR_NO"><Style TextAlign="Center" VerticalAlign="Middle"><Font Size="8pt" /><BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" /><BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" /><BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" /></Style></TextBox><TextBox Width="2.5cm" Height="0.6cm" Left="7.700cm" Top="0.6cm" Value="=IIf(Fields.TR_DT Is Nothing, '-', Fields.TR_DT)" Name="det_TR_DT" Format="{0:dd/MM/yyyy}"><Style TextAlign="Center" VerticalAlign="Middle"><Font Size="8pt" /><BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" /><BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" /><BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" /></Style></TextBox><TextBox Width="2.5cm" Height="0.6cm" Left="10.200cm" Top="0.6cm" Value="=IIf(Fields.DUE_DT Is Nothing, '-', Fields.DUE_DT)" Name="det_DUE_DT" Format="{0:dd/MM/yyyy}"><Style TextAlign="Center" VerticalAlign="Middle"><Font Size="8pt" /><BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" /><BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" /><BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" /></Style></TextBox><TextBox Width="3cm" Height="0.6cm" Left="12.700cm" Top="0.6cm" Value="=IIf(Fields.ACC_NO Is Nothing, '-', Fields.ACC_NO)" Name="det_ACC_NO"><Style TextAlign="Center" VerticalAlign="Middle"><Font Size="8pt" /><BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" /><BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" /><BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" /></Style></TextBox><TextBox Width="2.5cm" Height="0.6cm" Left="15.700cm" Top="0.6cm" Value="=IIf(Fields.LTOT Is Nothing, '-', Fields.LTOT)" Name="det_LTOT" Format="{0:N2}"><Style TextAlign="Center" VerticalAlign="Middle"><Font Size="8pt" /><BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" /><BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" /><BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" /></Style></TextBox><TextBox Width="4cm" Height="0.6cm" Left="18.200cm" Top="0.6cm" Value="=IIf(Fields.RMRK Is Nothing, '-', Fields.RMRK)" Name="det_RMRK"><Style TextAlign="Center" VerticalAlign="Middle"><Font Size="8pt" /><BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" /><BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" /><BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" /></Style></TextBox><TextBox Width="2.5cm" Height="0.6cm" Left="22.200cm" Top="0.6cm" Value="=IIf(Fields.EnteredBy Is Nothing, '-', Fields.EnteredBy)" Name="det_EnteredBy"><Style TextAlign="Center" VerticalAlign="Middle"><Font Size="8pt" /><BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" /><BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" /><BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" /></Style></TextBox><TextBox Width="2.5cm" Height="0.6cm" Left="24.700cm" Top="0.6cm" Value="=IIf(Fields.EntryDate Is Nothing, '-', Fields.EntryDate)" Name="det_EntryDate" Format="{0:dd/MM/yyyy}"><Style TextAlign="Center" VerticalAlign="Middle"><Font Size="8pt" /><BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" /><BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" /><BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" /></Style></TextBox>
      </Items>
    </DetailSection>
  </Items>
