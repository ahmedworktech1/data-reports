UND(sum( case when ( acc_no like '4[6-8]211%') then db_vl-cr_vl else 0 end )/1000, 0) AS BIGINT)) as s7,&#xD;&#xA;&#xD;&#xA;CAST(ROUND(sum( case when ( acc_no like '4[6-8]21%') then db_vl-cr_vl else 0 end )/1000, 0) AS BIGINT) as tot2,&#xD;&#xA;CAST(ROUND(sum( case when ( acc_no like '4[6-8]22%') then db_vl-cr_vl else 0 end )/1000, 0) AS BIGINT) as s8,&#xD;&#xA;CAST(ROUND(sum( case when ( acc_no like '4[6-8]23111%' ) then db_vl-cr_vl else 0 end )/1000, 0) AS BIGINT) as s9,&#xD;&#xA;CAST(ROUND(sum( case when ( acc_no like '4[6-8]23112%') then db_vl-cr_vl else 0 end )/1000, 0) AS BIGINT) as s10,&#xD;&#xA;CAST(ROUND(sum( case when ( acc_no like '4[6-8]2311%') then db_vl-cr_vl else 0 end )/1000, 0) AS BIGINT) as tot3,&#xD;&#xA;CAST(ROUND(sum( case when ( acc_no like '4[6-8]24%' ) then db_vl-cr_vl else 0 end )/1000, 0) AS BIGINT) as s11,&#xD;&#xA;CAST(ROUND(sum( case when (( acc_no like '4[6-8]25%' or  acc_no like '4[6-8]26%') ) then db_vl-cr_vl else 0 end )/1000, 0) AS BIGINT) as s12,&#xD;&#xA;&#xD;&#xA;CAST(ROUND(sum( case when ((acc_no like '4[6-8]21%' or acc_no like '4[6-8]22%' or acc_no like '4[6-8]2311%' or acc_no like '4[6-8]24%' or acc_no like '4[6-8]25%' or acc_no like '4[6-8]26%')) then db_vl-cr_vl else 0 end )/1000, 0) AS BIGINT)as tot4,&#xD;&#xA;&#xD;&#xA;CAST(ROUND(sum( case when (( acc_no like '4[6-8]111%' or  acc_no like '4[6-8]1122%' &#xD;&#xA;or acc_no like '4[6-8]1121%' or  acc_no like '4[6-8]1123%' or acc_no like '4[6-8]113%' &#xD;&#xA; or acc_no like '4[6-8]114%' or  acc_no like '4[6-8]115%' or  acc_no like '4[6-8]116%' &#xD;&#xA; or  acc_no like '4[6-8]12%' or acc_no like '4[6-8]21%'or  acc_no like '4[6-8]22%' or  acc_no like '4[6-8]2311%' or acc_no like '4[6-8]24%'or&#xD;&#xA; acc_no like '4[6-8]25%' or acc_no like '4[6-8]26%'))&#xD;&#xA; then db_vl-cr_vl else 0 end )/1000, 0) AS BIGINT) as tot5,&#xD;&#xA; CAST(ROUND(sum( case when ( acc_no like '0%') then db_vl-cr_vl else 0 end )/1000, 0) AS BIGINT) as tot6,&#xD;&#xA;&#xD;&#xA;CAST(ROUND(sum( case when (( acc_no like '4[6-8]111%' or  acc_no like '4[6-8]1122%' &#xD;&#xA;or acc_no like '4[6-8]1121%' or  acc_no like '4[6-8]1123%' or acc_no like '4[6-8]113%' &#xD;&#xA; or acc_no like '4[6-8]114%' or  acc_no like '4[6-8]115%' or  acc_no like '4[6-8]116%' &#xD;&#xA; or  acc_no like '4[6-8]12%' or acc_no like '4[6-8]21%'or  acc_no like '4[6-8]22%' or  acc_no like '4[6-8]2311%' or acc_no like '4[6-8]24%'or&#xD;&#xA; acc_no like '4[6-8]25%' or acc_no like '4[6-8]26%'))&#xD;&#xA; then db_vl-cr_vl else 0 end )/1000, 0) AS BIGINT) as tot7&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;from gljrnld  WHERE (( acc_no like '4[6-8]1%' or  acc_no like '4[6-8]2%') ) and (1=1)&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;" Name="sqlDataSource1" />
