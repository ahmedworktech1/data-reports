<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource1" Width="28.7cm" Name="AztrhRequestInstanceLogs" xmlns="http://schemas.telerik.com/reporting/2023/1.0">
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="azxsandoaa" SelectCommand="SELECT t.Id, t.TransitionDate, t.Reason, t1.NameArabic AS TriggerName, s.NameArabic AS FromStateName,&#xD;&#xA;&#x9;   purchas_NO, FNCL_TR_NO,&#xD;&#xA;&#x9;   AZTRH.tr_ty AS TrTy,&#xD;&#xA;       s0.NameArabic AS ToStateName, t2.FullName AS ExecuterName,&#xD;&#xA;       (SELECT TOP 1 at2.dscr_ar FROM azx_sandoaa.dbo.AZTRH a2 LEFT JOIN azx_sandoaa.dbo.AZTRTY at2 ON at2.tr_ty = a2.tr_ty WHERE a2.FNCL_TR_NO = AZTRH.FNCL_TR_NO AND a2.loc = AZTRH.loc ORDER BY a2.tr_ty DESC) AS ProcessLastStageName,        (SELECT TOP 1 a3.tr_no FROM azx_sandoaa.dbo.AZTRH a3 WHERE a3.FNCL_TR_NO = AZTRH.FNCL_TR_NO AND a3.loc = AZTRH.loc ORDER BY a3.tr_ty DESC) AS ProcessLastStageNo&#xD;&#xA;FROM azx_sandoaa.dbo.AZTRH&#xD;&#xA;    LEFT JOIN erpx_sandoaa_br.Workflow.RequestInstanceLogs t&#xD;&#xA;        ON AZTRH.RequestId = t.RequestInstanceId&#xD;&#xA;    LEFT JOIN erpx_sandoaa_br.Workflow.Transitions t0&#xD;&#xA;        ON t.TransitionId = t0.Id&#xD;&#xA;    LEFT JOIN erpx_sandoaa_br.Workflow.States s&#xD;&#xA;        ON t0.FromStateId = s.Id&#xD;&#xA;    LEFT JOIN erpx_sandoaa_br.Workflow.States s0&#xD;&#xA;        ON t0.ToStateId = s0.Id&#xD;&#xA;    LEFT JOIN erpx_sandoaa_br.Workflow.Triggers t1&#xD;&#xA;        ON t0.TriggerId = t1.Id&#xD;&#xA;    LEFT JOIN erpx_sandoaa_br.Brca.BrcaUsers t2&#xD;&#xA;        ON t.ExecuterUserId = t2.Id&#xD;&#xA;    LEFT JOIN azx_sandoaa.dbo.AZTRTY at&#xD;&#xA;        ON at.tr_ty = AZTRH.tr_ty&#xD;&#xA;where 1=1&#xD;&#xA;&#xD;&#xA;" Name="sqlDataSource1" />
  </DataSources>
  <Items>
    <PageHeaderSection Height="0.132cm" Name="pageHeaderSection1" />
    <DetailSection Height="1.6cm" Name="detailSection1">
      <Items>
        <TextBox Width="4cm" Height="1.6cm" Left="0cm" Top="0cm" Value="= Fields.Reason" Name="txtReason">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="4.6cm" Height="1.6cm" Left="7.9cm" Top="0cm" Value="= Fields.ExecuterName" Name="txtExecuter">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="5.5cm" Height="1.6cm" Left="12.5cm" Top="0cm" Value="= Fields.ToStateName" Name="txtToState">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="5.4cm" Height="1.6cm" Left="18cm" Top="0cm" Value="= Fields.FromStateName" Name="txtFromState">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="5cm" Height="1.6cm" Left="23.4cm" Top="0cm" Value="= Fields.TriggerName" Name="txtTrigger">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="3.9cm" Height="1.6cm" Left="4cm" Top="0cm" Value="= Fields.TransitionDate.ToString('yyyy/MM/dd')" Format="{0:yyyy.mm.dd}" Name="txtDate">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
      </Items>
    </DetailSection>
    <PageFooterSection Height="0.132cm" Name="pageFooterSection1" />
    <ReportHeaderSection Height="5.582cm" Name="reportHeaderSection1">
      <Items>
        <TextBox Width="5cm" Height="1.768cm" Left="23.4cm" Top="3.804cm" Value="الإجراء" Name="headerTrigger">
          <Style BackgroundColor="84, 110, 179" Color="White" TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" />
            <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="5.4cm" Height="1.768cm" Left="18cm" Top="3.804cm" Value="من حالة" Name="headerFromState">
          <Style BackgroundColor="84, 110, 179" Color="White" TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" />
            <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="5.5cm" Height="1.768cm" Left="12.5cm" Top="3.804cm" Value="إلى حالة" Name="headerToState">
          <Style BackgroundColor="84, 110, 179" Color="White" TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" />
            <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="4.6cm" Height="1.768cm" Left="7.9cm" Top="3.804cm" Value="المنفذ" Name="headerExecuter">
          <Style BackgroundColor="84, 110, 179" Color="White" TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" />
            <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="3.9cm" Height="1.768cm" Left="4cm" Top="3.804cm" Value="تاريخ الإنتقال" Name="headerDate">
          <Style BackgroundColor="84, 110, 179" Color="White" TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" />
            <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="4cm" Height="1.768cm" Left="0cm" Top="3.804cm" Value="السبب" Name="headerReason">
          <Style BackgroundColor="84, 110, 179" Color="White" TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" />
            <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="4.1cm" Height="0.8cm" Left="12.5cm" Top="1.01cm" Value="بيان اجراءات العملية" Name="textBox7">
          <Style Color="Red" TextAlign="Center" VerticalAlign="Middle">
            <Font Size="14pt" Bold="True" Underline="True" />
          </Style>
        </TextBox>
        <TextBox Width="2.3cm" Height="0.8cm" Left="25.908cm" Top="2.21cm" Value="اسم العملية :" Name="textBox1">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Size="14pt" Bold="True" Underline="True" />
          </Style>
        </TextBox>
        <TextBox Width="2.4cm" Height="0.8cm" Left="25.808cm" Top="3.01cm" Value="رقم العملية :" Name="textBox2">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Size="14pt" Bold="True" Underline="True" />
          </Style>
        </TextBox>
        <TextBox Width="9.362cm" Height="0.6cm" Left="16.51cm" Top="2.31cm" Value="= Fields.purchas_NO" Name="textBox3">
          <Style TextAlign="Justify" VerticalAlign="Middle">
            <Font Size="12pt" Bold="True" />
          </Style>
        </TextBox>
        <TextBox Width="5.36cm" Height="0.6cm" Left="20.448cm" Top="3.11cm" Value="= Fields.FNCL_TR_NO" Name="textBox4">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Size="12pt" Bold="True" />
          </Style>
        </TextBox>
        <TextBox Width="8.636cm" Height="0.7cm" Left="0.878cm" Top="3.01cm" Value="=First(Fields.ProcessLastStageName)" Name="txtLastStage">
          <Style TextAlign="Justify" VerticalAlign="Middle">
            <Font Size="12pt" Bold="True" />
          </Style>
        </TextBox>
        <TextBox Width="2.986cm" Height="0.7cm" Left="9.514cm" Top="3.01cm" Value="اخر الاجراءات : " Name="textBox5">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Size="14pt" Bold="True" Underline="True" />
          </Style>
        </TextBox>
      </Items>
    </ReportHeaderSection>
  </Items>
  <PageSettings PaperKind="A4" Landscape="True" ContinuousPaper="False">
    <Margins>
      <MarginsU Left="0.5cm" Right="0.5cm" Top="0.5cm" Bottom="0.5cm" />
    </Margins>
  </PageSettings>
  <StyleSheet>
    <StyleRule>
      <Style>
        <Padding Left="2pt" Right="2pt" />
      </Style>
      <Selectors>
        <TypeSelector Type="TextItemBase" />
        <TypeSelector Type="HtmlTextBox" />
      </Selectors>
    </StyleRule>
  </StyleSheet>
</Report>