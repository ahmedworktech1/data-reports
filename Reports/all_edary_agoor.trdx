<Report DataSourceName="sqlDataSource1" Width="29.7cm" Name="QueryGlJrnl1" xmlns="http://schemas.telerik.com/reporting/2021/1.0">
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="glx2024" SelectCommand="SELECT 'تيار' AS s,&#xA;    CAST(ROUND(SUM(CASE &#xA;        WHEN acc_no LIKE '4[8]12%' &#xA;             AND SUBSTRING(cst_cd, 6, 7) = '81' &#xA;             AND cst_cd NOT LIKE '11%' &#xA;        THEN db_vl - cr_vl &#xA;        ELSE 0 END) / 1000.0, 0) AS BIGINT) AS tot,&#xA;    CAST(ROUND(SUM(CASE &#xA;        WHEN (acc_no LIKE '4[8]121%' OR acc_no LIKE '4[8]124%') &#xA;             AND SUBSTRING(cst_cd, 6, 7) = '81' &#xA;             AND cst_cd NOT LIKE '11%' &#xA;        THEN db_vl - cr_vl &#xA;        ELSE 0 END) / 1000.0, 0) AS BIGINT) AS s1,&#xA;    CAST(ROUND(SUM(CASE &#xA;        WHEN (acc_no LIKE '4[8]1221%' OR acc_no LIKE '4[8]125%') &#xA;             AND SUBSTRING(cst_cd, 6, 7) = '81' &#xA;             AND cst_cd NOT LIKE '11%' &#xA;        THEN db_vl - cr_vl &#xA;        ELSE 0 END) / 1000.0, 0) AS BIGINT) AS s2,&#xA;    CAST(ROUND(SUM(CASE &#xA;        WHEN acc_no LIKE '4[8]1222%' &#xA;             AND SUBSTRING(cst_cd, 6, 7) = '81' &#xA;             AND cst_cd NOT LIKE '11%' &#xA;        THEN db_vl - cr_vl &#xA;        ELSE 0 END) / 1000.0, 0) AS BIGINT) AS s3,&#xA;    CAST(ROUND(SUM(CASE &#xA;        WHEN (acc_no LIKE '4[8]126%' OR acc_no LIKE '4[8]1223%') &#xA;             AND SUBSTRING(cst_cd, 6, 7) = '81' &#xA;             AND cst_cd NOT LIKE '11%' &#xA;        THEN db_vl - cr_vl &#xA;        ELSE 0 END) / 1000.0, 0) AS BIGINT) AS s4,&#xA;&#xA;    (CAST(ROUND(SUM(CASE &#xA;        WHEN (acc_no LIKE '4[8]1221%' OR acc_no LIKE '4[8]125%') &#xA;             AND SUBSTRING(cst_cd, 6, 7) = '81' &#xA;             AND cst_cd NOT LIKE '11%' &#xA;        THEN db_vl - cr_vl &#xA;        ELSE 0 END) / 1000.0, 0) AS BIGINT) +&#xA;    CAST(ROUND(SUM(CASE &#xA;        WHEN acc_no LIKE '4[8]1222%' &#xA;             AND SUBSTRING(cst_cd, 6, 7) = '81' &#xA;             AND cst_cd NOT LIKE '11%' &#xA;        THEN db_vl - cr_vl &#xA;        ELSE 0 END) / 1000.0, 0) AS BIGINT) +&#xA;    CAST(ROUND(SUM(CASE &#xA;        WHEN (acc_no LIKE '4[8]126%' OR acc_no LIKE '4[8]1223%') &#xA;             AND SUBSTRING(cst_cd, 6, 7) = '81' &#xA;             AND cst_cd NOT LIKE '11%' &#xA;        THEN db_vl - cr_vl &#xA;        ELSE 0 END) / 1000.0, 0) AS BIGINT)) AS tot1,&#xA;    CAST(ROUND(SUM(CASE &#xA;        WHEN (acc_no LIKE '4[8]123%') &#xA;             AND SUBSTRING(cst_cd, 6, 7) = '81' &#xA;             AND cst_cd NOT LIKE '11%' &#xA;        THEN db_vl - cr_vl &#xA;        ELSE 0 END) / 1000.0, 0) AS BIGINT) AS s5&#xA;FROM gljrnld  &#xA;WHERE (acc_no LIKE '4[8]12%') &#xA;      AND SUBSTRING(cst_cd, 6, 7) = '81' &#xA;      AND cst_cd NOT LIKE '11%'  &#xA;      AND (1=1)&#xA;&#xA;UNION ALL&#xA;&#xA;SELECT 'مقايسات ومشروعات' AS s,&#xA;    CAST(ROUND(SUM(CASE &#xA;        WHEN acc_no LIKE '4[8]12%' &#xA;             AND SUBSTRING(cst_cd, 6, 7) IN ('82', '83') &#xA;             AND cst_cd NOT LIKE '11%' &#xA;        THEN db_vl - cr_vl &#xA;        ELSE 0 END) / 1000.0, 0) AS BIGINT) AS tot,&#xA;    CAST(ROUND(SUM(CASE &#xA;        WHEN (acc_no LIKE '4[8]121%' OR acc_no LIKE '4[8]124%') &#xA;             AND SUBSTRING(cst_cd, 6, 7) IN ('82', '83') &#xA;             AND cst_cd NOT LIKE '11%' &#xA;        THEN db_vl - cr_vl &#xA;        ELSE 0 END) / 1000.0, 0) AS BIGINT) AS s1,&#xA;    CAST(ROUND(SUM(CASE &#xA;        WHEN (acc_no LIKE '4[8]1221%' OR acc_no LIKE '4[8]125%') &#xA;             AND SUBSTRING(cst_cd, 6, 7) IN ('82', '83') &#xA;             AND cst_cd NOT LIKE '11%' &#xA;        THEN db_vl - cr_vl &#xA;        ELSE 0 END) / 1000.0, 0) AS BIGINT) AS s2,&#xA;    CAST(ROUND(SUM(CASE &#xA;        WHEN acc_no LIKE '4[8]1222%' &#xA;             AND SUBSTRING(cst_cd, 6, 7) IN ('82', '83') &#xA;             AND cst_cd NOT LIKE '11%' &#xA;        THEN db_vl - cr_vl &#xA;        ELSE 0 END) / 1000.0, 0) AS BIGINT) AS s3,&#xA;    CAST(ROUND(SUM(CASE &#xA;        WHEN (acc_no LIKE '4[8]126%' OR acc_no LIKE '4[8]1223%') &#xA;             AND SUBSTRING(cst_cd, 6, 7) IN ('82', '83') &#xA;             AND cst_cd NOT LIKE '11%' &#xA;        THEN db_vl - cr_vl &#xA;        ELSE 0 END) / 1000.0, 0) AS BIGINT) AS s4,&#xA;&#xA;    (CAST(ROUND(SUM(CASE &#xA;        WHEN (acc_no LIKE '4[8]1221%' OR acc_no LIKE '4[8]125%') &#xA;             AND SUBSTRING(cst_cd, 6, 7) IN ('82', '83') &#xA;             AND cst_cd NOT LIKE '11%' &#xA;        THEN db_vl - cr_vl &#xA;        ELSE 0 END) / 1000.0, 0) AS BIGINT) +&#xA;    CAST(ROUND(SUM(CASE &#xA;        WHEN acc_no LIKE '4[8]1222%' &#xA;             AND SUBSTRING(cst_cd, 6, 7) IN ('82', '83') &#xA;             AND cst_cd NOT LIKE '11%' &#xA;        THEN db_vl - cr_vl &#xA;        ELSE 0 END) / 1000.0, 0) AS BIGINT) +&#xA;    CAST(ROUND(SUM(CASE &#xA;        WHEN (acc_no LIKE '4[8]126%' OR acc_no LIKE '4[8]1223%') &#xA;             AND SUBSTRING(cst_cd, 6, 7) IN ('82', '83') &#xA;             AND cst_cd NOT LIKE '11%' &#xA;        THEN db_vl - cr_vl &#xA;        ELSE 0 END) / 1000.0, 0) AS BIGINT)) AS tot1,&#xA;    CAST(ROUND(SUM(CASE &#xA;        WHEN (acc_no LIKE '4[8]123%') &#xA;             AND SUBSTRING(cst_cd, 6, 7) IN ('82', '83') &#xA;             AND cst_cd NOT LIKE '11%' &#xA;        THEN db_vl - cr_vl &#xA;        ELSE 0 END) / 1000.0, 0) AS BIGINT) AS s5&#xA;FROM gljrnld  &#xA;WHERE (acc_no LIKE '4[8]12%') &#xA;      AND SUBSTRING(cst_cd, 6, 7) IN ('82', '83') &#xA;      AND cst_cd NOT LIKE '11%' &#xA;      AND (1=1)&#xA;&#xA;UNION ALL&#xA;&#xA;SELECT 'محطات التوليد' AS s,&#xA;    CAST(ROUND(SUM(CASE &#xA;        WHEN acc_no LIKE '4[8]12%' &#xA;             AND CST_CD LIKE '11%' &#xA;        THEN db_vl - cr_vl &#xA;        ELSE 0 END) / 1000.0, 0) AS BIGINT) AS tot,&#xA;    CAST(ROUND(SUM(CASE &#xA;        WHEN (acc_no LIKE '4[8]121%' OR acc_no LIKE '4[8]124%') &#xA;             AND CST_CD LIKE '11%' &#xA;        THEN db_vl - cr_vl &#xA;        ELSE 0 END) / 1000.0, 0) AS BIGINT) AS s1,&#xA;    CAST(ROUND(SUM(CASE &#xA;        WHEN (acc_no LIKE '4[8]1221%' OR acc_no LIKE '4[8]125%') &#xA;             AND CST_CD LIKE '11%' &#xA;        THEN db_vl - cr_vl &#xA;        ELSE 0 END) / 1000.0, 0) AS BIGINT) AS s2,&#xA;    CAST(ROUND(SUM(CASE &#xA;        WHEN acc_no LIKE '4[8]1222%' &#xA;             AND CST_CD LIKE '11%' &#xA;        THEN db_vl - cr_vl &#xA;        ELSE 0 END) / 1000.0, 0) AS BIGINT) AS s3,&#xA;    CAST(ROUND(SUM(CASE &#xA;        WHEN (acc_no LIKE '4[8]126%' OR acc_no LIKE '4[8]1223%') &#xA;             AND CST_CD LIKE '11%' &#xA;        THEN db_vl - cr_vl &#xA;        ELSE 0 END) / 1000.0, 0) AS BIGINT) AS s4,&#xA;&#xA;    (CAST(ROUND(SUM(CASE &#xA;        WHEN (acc_no LIKE '4[8]1221%' OR acc_no LIKE '4[8]125%') &#xA;             AND CST_CD LIKE '11%' &#xA;        THEN db_vl - cr_vl &#xA;        ELSE 0 END) / 1000.0, 0) AS BIGINT) +&#xA;    CAST(ROUND(SUM(CASE &#xA;        WHEN acc_no LIKE '4[8]1222%' &#xA;             AND CST_CD LIKE '11%' &#xA;        THEN db_vl - cr_vl &#xA;        ELSE 0 END) / 1000.0, 0) AS BIGINT) +&#xA;    CAST(ROUND(SUM(CASE &#xA;        WHEN (acc_no LIKE '4[8]126%' OR acc_no LIKE '4[8]1223%') &#xA;             AND CST_CD LIKE '11%' &#xA;        THEN db_vl - cr_vl &#xA;        ELSE 0 END) / 1000.0, 0) AS BIGINT)) AS tot1,&#xA;    CAST(ROUND(SUM(CASE &#xA;        WHEN (acc_no LIKE '4[8]123%') &#xA;             AND CST_CD LIKE '11%' &#xA;        THEN db_vl - cr_vl &#xA;        ELSE 0 END) / 1000.0, 0) AS BIGINT) AS s5&#xA;FROM gljrnld  &#xA;WHERE (acc_no LIKE '4[8]12%') &#xA;      AND CST_CD LIKE '11%' &#xA;      AND (1=1)&#xA;" Name="sqlDataSource1" />
