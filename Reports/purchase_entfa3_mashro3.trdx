        <TextBox Width="8.973cm" Height="0.4cm" Left="7.9cm" Top="16.14cm" Value="17 - فى حال ما إذا كانت الجهة الإدارية بشروط الطرح تسمح بعد مدة العقد." Name="textBox115">
