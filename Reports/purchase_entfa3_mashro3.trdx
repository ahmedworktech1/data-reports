        <TextBox Width="8.465cm" Height="0.4cm" Left="8.4cm" Top="13.9cm" Value="13 - أدخل طبيعة النشاط لمحل التعاقد وفقاً لكراسة الشروط والمواصفات." Name="textBox149">
