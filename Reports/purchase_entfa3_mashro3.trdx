        <TextBox Width="5.2cm" Height="0.5cm" Left="11.464cm" Top="0.361cm" Value="مجلــــــــــــــــــــــــــس الــــــــــــــــــــــوزراء" Name="textBox4">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="True" />
          </Style>
        </TextBox>
        <TextBox Width="6cm" Height="0.5cm" Left="10.664cm" Top="0.861cm" Value="صندوق تكريم شهداء و ضحايا و مفقودي ومصابي " Name="textBox2">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="True" />
          </Style>
        </TextBox>
        <TextBox Width="5.592cm" Height="0.4cm" Left="11.072cm" Top="1.361cm" Value="العمليات الحربيه و الارهابيه  والامنيه و اسرهم" Name="textBox3">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="True" />
