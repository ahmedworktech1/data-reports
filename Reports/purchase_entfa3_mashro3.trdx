        </TextBox>
        <TextBox Width="5.4cm" Height="0.4cm" Left="5.764cm" Top="3.361cm" Value="العقد النموذجي للترخيص بانتفاع مشروع" Name="textBox298">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="2.508cm" Height="0.4cm" Left="7.064cm" Top="3.961cm" Value="محعتويات نمط العقد" Name="textBox1">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
