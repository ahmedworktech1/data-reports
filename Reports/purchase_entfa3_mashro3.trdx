            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="3.704cm" Height="0.4cm" Left="6.064cm" Top="20.363cm" Value="تم إبرام هذا العقد بين كل من :" Name="textBox12">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="10cm" Height="0.4cm" Left="6.664cm" Top="20.963cm" Value="أولاً : وزارة / محافظة / الهيئة العامة / الصندوق / الجهاز أو الشخص الاعتباري العام" Name="textBox13">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="1.1cm" Height="0.4cm" Left="15.564cm" Top="21.563cm" Value="ومقرها " Name="textBox14">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="4.9cm" Height="0.4cm" Left="9.364cm" Top="21.463cm" Value="بصفتها المالك / صاحب الولاية , بموجب " Name="textBox15">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="3.9cm" Height="0.4cm" Left="3.564cm" Top="21.463cm" Value="وهي الجهة المعنية / المستفيدة" Name="textBox16">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="1.692cm" Height="0.4cm" Left="14.963cm" Top="22.063cm" Value="من مشروع" Name="textBox17">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="5.4cm" Height="0.4cm" Left="7.164cm" Top="21.963cm" Value="بما فيه من ( أرض / أصول مادية ) الكائن في" Name="textBox18">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="1.1cm" Height="0.4cm" Left="3.364cm" Top="21.963cm" Value="محافظة " Name="textBox19">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="2.7cm" Height="0.4cm" Left="13.963cm" Top="22.563cm" Value="والمقام علي مساحة (" Name="textBox20">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="2cm" Height="0.4cm" Left="9.964cm" Top="22.463cm" Value="متراً مربعاً ) / ( " Name="textBox21">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="0.7cm" Height="0.4cm" Left="7.964cm" Top="22.463cm" Value="سهم" Name="textBox22">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="0.8cm" Height="0.4cm" Left="6.264cm" Top="22.463cm" Value="قيراط" Name="textBox23">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="4.692cm" Height="0.4cm" Left="0.256cm" Top="22.463cm" Value="فدان ) , ويمثلها قانوناً في التوقيع علي" Name="textBox24">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="12.6cm" Height="0.4cm" Left="4.064cm" Top="22.963cm" Value="هذا العقد بصفته الوزير / المحافظ / رئيس مجلس الهيئة / رئيس جهاز أو الشخص الاعتباري العام المختص ." Name="textBox25">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="7.116cm" Height="0.4cm" Left="9.548cm" Top="23.463cm" Value="(إذا كان هناك مفوض لتوقيع العقد , تستكمل البيانات التالية ) " Name="textBox26">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="6.6cm" Height="0.4cm" Left="10.064cm" Top="23.963cm" Value="وينوب عنه في التوقيع علي هذا العقد ( السيد / السيدة ) " Name="textBox27">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="7.5cm" Height="0.4cm" Left="9.164cm" Top="28.663cm" Value="( إذا كان الطرف الثاني شخص طبيعي , تستكمل البيانات التالية ) " Name="textBox30">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="6.592cm" Height="0.4cm" Left="10.064cm" Top="32.063cm" Value="جيث أن الطرف الأول ( يمتلك / صاحب الولاية ) مشروع" Name="textBox29">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="4.681cm" Height="0.4cm" Left="12.083cm" Top="37.963cm" Value="1 - أدخل أسم الجهة الإدارية المتعاقدة." Name="textBox28">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="3.1cm" Height="0.4cm" Left="3.064cm" Top="23.963cm" Value="بصفته / بصفتها الوظيفية" Name="textBox31">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="3.692cm" Height="0.4cm" Left="12.964cm" Top="24.663cm" Value="بموجب التفويض الصادر رقم " Name="textBox32">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="1.4cm" Height="0.4cm" Left="7.464cm" Top="24.663cm" Value="الصادر في " Name="textBox33">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="1.6cm" Height="0.4cm" Left="0.664cm" Top="25.363cm" Value="(طرف أول )" Name="textBox34">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="9.5cm" Height="0.4cm" Left="7.164cm" Top="26.063cm" Value="ثانياً : ( إذا كان الطرف الثاني شخص اعتباري تكون البيانات علي النحو التالي ) " Name="textBox35">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="11.308cm" Height="0.4cm" Left="5.464cm" Top="38.463cm" Value="2 - أدخل عنوان الجهة الإدارية المتعاقدة تفصيلاً والذى سيتم توجيه المراسلات والمكاتبات عليه." Name="textBox36">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="6.7cm" Height="0.4cm" Left="10.064cm" Top="38.963cm" Value="3 - أدخل سند الولاية (قرار/ أو البروتوكول/ أو غيرها)." Name="textBox40">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="3cm" Height="0.4cm" Left="13.764cm" Top="39.463cm" Value="4 - أدخل أسم المشروع." Name="textBox39">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.4cm" Height="0.4cm" Left="0.364cm" Top="39.963cm" Value="5 - يستخدم قياس المتر المربع فى حالة الأراضى الصناعية أو المبانى، أما قياس (سهم/قيراط/فدان) فى حالة الأراضى الزراعية أو المعدة للاستصلاح الزراعى." Name="textBox38">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="2.808cm" Height="0.4cm" Left="13.963cm" Top="40.463cm" Value="للاستصلاح الزراعى ." Name="textBox37">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="11.308cm" Height="0.4cm" Left="5.456cm" Top="40.963cm" Value="6 - أدخل الشكل القانونى للشخص الاعتبارى (شركة/ نقابة/ جمعية/....إلخ)." Name="textBox48">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="11.308cm" Height="0.4cm" Left="5.456cm" Top="41.463cm" Value="7 - يقصد بالشكل القانونى (شركة مساهمة/ شركة توصية بسيطة/ شركة شخص واحد/....إلخ)." Name="textBox47">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="3.008cm" Height="0.4cm" Left="13.756cm" Top="41.963cm" Value="8 - أدخل أسم المشروع." Name="textBox46">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="8.408cm" Height="0.4cm" Left="8.364cm" Top="42.463cm" Value="9 - أدخل سند الولاية (قرار/ أو البروتوكول/ أو غيرها) ورقمه وتاريخه." Name="textBox45">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.4cm" Height="0.4cm" Left="0.337cm" Top="45.763cm" Value="ووفقا لما تضمنته كراسة الشروط الخاصة بموضوع هذا العقد , وما أوصت به ( لجنة البت في المزايدة/ لجنة الاتفاق المباشر ) بجلستها" Name="textBox44">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="1.861cm" Height="0.4cm" Left="14.875cm" Top="45.252cm" Value="- وذلك بغرض" Name="textBox51">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="0.992cm" Height="0.4cm" Left="15.763cm" Top="33.663cm" Value="بتاريخ" Name="textBox52">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="1.6cm" Height="0.4cm" Left="14.072cm" Top="26.463cm" Value="الكائن مقرها " Name="textBox53">
