          </Style>
        </TextBox>
        <TextBox Width="2.508cm" Height="0.4cm" Left="2.8cm" Top="22.9cm" Value=") وذلك بالحساب رقم " Name="textBox165">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="0.508cm" Height="0.4cm" Left="16.3cm" Top="23.9cm" Value="من" Name="textBox167">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="1.7cm" Height="0.4cm" Left="1.2cm" Top="23.4cm" Value=")  عن الفترة" Name="textBox166">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="0.8cm" Height="0.4cm" Left="11.8cm" Top="23.9cm" Value="وحتي" Name="textBox168">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="0.908cm" Height="0.4cm" Left="15.9cm" Top="24.9cm" Value="بالبنك" Name="textBox169">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="1.7cm" Height="0.4cm" Left="7.881cm" Top="27.3cm" Value="البند الثامن" Name="textBox170">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="1.773cm" Height="0.4cm" Left="8.1cm" Top="27.8cm" Value=") فقط وقدره (" Name="textBox171">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.04cm" Height="0.4cm" Left="0.76cm" Top="34.5cm" Value="الشروط والمواصفات , وإذا تأخر الطرف الثاني في بدء نتفيذ التزاماته عن الموعد سالف البيان يكون للطرف الأول الحق في توقيع الجزاءات" Name="textBox172">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="5.5cm" Height="0.4cm" Left="11.3cm" Top="35cm" Value=" الواردة بالبند الثاني والعشرون من هذا العقد ." Name="textBox173">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="5.701cm" Height="0.4cm" Left="11.164cm" Top="63.2cm" Value="والتنسيق مع الطرف الأول لتحقيق هذا الغرض ." Name="textBox174">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="2.808cm" Height="0.4cm" Left="13.965cm" Top="29.3cm" Value="أو بخطاب الضمان رقم " Name="textBox176">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="0.908cm" Height="0.4cm" Left="15.892cm" Top="28.8cm" Value="بالبنك" Name="textBox177">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="7.2cm" Height="0.4cm" Left="9.6cm" Top="31.7cm" Value="اتفق الطرفان علي اتباع الاجراءات التالية فى حالة تعديل العقد " Name="textBox175">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="10.992cm" Height="0.4cm" Left="5.781cm" Top="28.3cm" Value="هذا العقد / من اجمالي هذا العقد عن الثلاث سنوات الأولي ) كتأمين نهائي , وذلك بالحساب رقم " Name="textBox179">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="4.872cm" Height="0.4cm" Left="0.6cm" Top="27.8cm" Value=") بما يعادل نسبة ( 10 %) ( من إجمالي" Name="textBox178">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="1.808cm" Height="0.4cm" Left="6.692cm" Top="29.3cm" Value="صادر من بنك" Name="textBox180">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.672cm" Height="0.4cm" Left="0.101cm" Top="29.8cm" Value="ويظل التأمين سارياَ طوال مدة العقد ويجدد قبل بداية الثلاث سنوات التالية أو الفترة المتبقية من العقد أيهما أقل إذا كانت مدته أكثر من ثلاث سنوات" Name="textBox181">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="8.4cm" Height="0.4cm" Left="8.372cm" Top="30.3cm" Value="علي أن تراعى الزيادة السنوية في قيمة التعاقد المنصوص عليها بالعقد . " Name="textBox182">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="1.7cm" Height="0.4cm" Left="7.908cm" Top="31.2cm" Value="البند التاسع" Name="textBox183">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="1.7cm" Height="0.4cm" Left="7.9cm" Top="33.5cm" Value="البند العاشر" Name="textBox184">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="7.008cm" Height="0.4cm" Left="9.8cm" Top="34cm" Value="يلتزم الطرف الثاني بالبدء في تنفيذ التزاماته في موعد أقصاه " Name="textBox185">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="6.808cm" Height="0.4cm" Left="1cm" Top="34cm" Value="من تاريخ بدء نفاذ العقد ووفقاً للاشتراطات الواردة بكراسة " Name="textBox186">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="2.3cm" Height="0.4cm" Left="7.5cm" Top="36.2cm" Value="البند الحادي عشر" Name="textBox187">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.308cm" Height="0.4cm" Left="0.5cm" Top="36.7cm" Value="يسأل الطرف الثاني عن أية مخالفات تقع لأحكام القوانين واللوائح أو عن سلامة محل هذا العقد ولا يجوز له أو الغير الرجوع علي الطرف الأول " Name="textBox190">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="7.572cm" Height="0.4cm" Left="9.236cm" Top="37.2cm" Value="بالتعويض عن أية اضرار تترتب نتيجة عدم سلامته أو غير ذلك . " Name="textBox191">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="2.3cm" Height="0.4cm" Left="7.1cm" Top="47.4cm" Value="البند الثاني عشر" Name="textBox192">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="2.964cm" Height="0.4cm" Left="13.792cm" Top="40.4cm" Value="23 - أدخل تاريخ السداد." Name="textBox194">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="11.356cm" Height="0.4cm" Left="5.4cm" Top="40.9cm" Value="24 - فى العقود التى تزيد مدتها عن أكثر من سنة، وتنفيذاً لحكم المادة (95) من اللائحة التنفيذية." Name="textBox193">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="8.756cm" Height="0.4cm" Left="8cm" Top="39.9cm" Value="22 - فى حال ما إذا كانت الجهة الإدارية/شروط الطرح تسمح بمد مدة العقد." Name="textBox195">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="7.172cm" Height="0.4cm" Left="9.584cm" Top="41.4cm" Value="25 - إجراءات فسخ العقد وفقاً لحكم المادة (51) من القانون." Name="textBox196">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="9.172cm" Height="0.4cm" Left="7.584cm" Top="39.4cm" Value="21 - الالتزام بحكم المادة (40) من القانون والمادة (95) من اللائحة التنفيذية." Name="textBox197">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="14.375cm" Height="0.4cm" Left="2.381cm" Top="41.9cm" Value="26 - نسبة التأمين النهائى محددة بالمادة (40) من القانون، كما نظمت المادة (95) من اللائحة التنفيذية تحصيل المستحقات." Name="textBox199">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.324cm" Height="0.4cm" Left="0.432cm" Top="42.4cm" Value="27 - على الجهة الإدارية مراعاة حكم المادة (46) من القانون وتضمين كراسة الشروط والمواصفات إجراءات تعديل العقد وفقاً لطبيعة العملية." Name="textBox198">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="5.592cm" Height="0.4cm" Left="11.164cm" Top="42.9cm" Value="28 - أدخل التاريخ المتفق عليه بشروط الطرح." Name="textBox200">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.324cm" Height="0.4cm" Left="0.432cm" Top="44.5cm" Value="ويلتزم الطرف الثاني علي نفقته بإجراء ما يلزم من تحسينات وصيانة مستمرة لمحل هذا العقد ضماناً لإعادته للطرف الأول بحالة جيدة في نهاية" Name="textBox201">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.324cm" Height="0.4cm" Left="0.432cm" Top="45cm" Value="مدة التعاقد , وفي حالة تلف أو هلاك محل القعد يلتزم المتعاقد بسداد القيمة التي تقدرها الجهة الإدارية دون اعتراض أو اللجوء للقضاء ويتم" Name="textBox202">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="6.956cm" Height="0.4cm" Left="9.8cm" Top="45.5cm" Value="خصمها من مستحقاته لدي الجهة أو أي جهة إدارية أخري ." Name="textBox203">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="13.356cm" Height="0.4cm" Left="3.4cm" Top="46cm" Value="ويؤول محل العقد وما تم أضافته من قبل الطرف الثاني من تحسينات وغيرها للطرف الأول دون مقابل بنهاية التعاقد ." Name="textBox204">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.673cm" Height="0.4cm" Left="0.167cm" Top="47.9cm" Value="أقر الطرف الثانى بأنه عاين محل هذا العقد المعاينة التامة النافية للجهالة شرعاً وأنه قبل الانتفاع بحالته الراهنة دون أن يحق له الرجوع على الطرف" Name="textBox205">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="13.508cm" Height="0.4cm" Left="3.332cm" Top="48.4cm" Value="الطرف الأول بالتعويض عن أية أضرار تترتب نتيجة عدم سلامته أو عن تعرض الغير له أو أى عيب خفى أو غير ذلك." Name="textBox206">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.046cm" Height="0.5cm" Left="0.762cm" Top="51.6cm" Value="لتزم الطرف الثانى باستخدام محل هذا العقد فى الغرض الذى تم الترخيص بالانتفاع به من أجله ويعتبر هذا العقد مفسوخاً من تلقاء نفسه دون " Name="textBox207">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="2.3cm" Height="0.4cm" Left="7.1cm" Top="51.1cm" Value="البند الثالث عشر" Name="textBox208">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.673cm" Height="0.5cm" Left="0.135cm" Top="52.1cm" Value="الحاجة إلى اتخاذ أى إجراء حال مخالفة الطرف الثانى لذلك مع حق الطرف الأول فى التعويض إن كان له مقتضى، كما يسقط حق الطرف الثاني في" Name="textBox209">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.192cm" Height="0.5cm" Left="0.616cm" Top="52.6cm" Value="فى استرداد أية مبالغ سبق سدادها، ويسترد الطرف الأول محل التعاقد علاوة على ما أضافه الطرف الثانى من تجهيزات وأعمال تطوير وصيانة مستمرة" Name="textBox210">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="3.7cm" Height="0.5cm" Left="13.108cm" Top="53.1cm" Value="مستمرة عليه وذلك دون مقابل." Name="textBox211">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.808cm" Height="0.5cm" Left="0cm" Top="53.6cm" Value="كما يلتزم الطرف الثانى بعدم التصرف فى محل هذا العقد بأى نوع من أنواع التصرفات أو التعامل عليه بأى صورة من صور التعامل أو أى جزء منه" Name="textBox212">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.508cm" Height="0.5cm" Left="0.3cm" Top="54.1cm" Value="ويعد هذا التصرف غير نافذ فى مواجهة الطرف الأول ولا يجوز شهر محرره ، مع حق الطرف الأول فى توقيع الجزاءات الواردة بالبند الثاني" Name="textBox213">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="3.008cm" Height="0.5cm" Left="13.8cm" Top="54.6cm" Value="والعشرون من هذا العقد " Name="textBox137">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="4.34cm" Height="0.5cm" Left="12.5cm" Top="56.3cm" Value="كلف الطرف الأول ( السيد / السيدة ) " Name="textBox216">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="2.3cm" Height="0.4cm" Left="7.1cm" Top="55.8cm" Value="البند الرابع عشر" Name="textBox217">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="3.2cm" Height="0.5cm" Left="6.1cm" Top="56.3cm" Value="بصفته / بصفتها الوظيفية " Name="textBox218">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="1.008cm" Height="0.5cm" Left="0.292cm" Top="56.3cm" Value="بموجب" Name="textBox219">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="1.373cm" Height="0.5cm" Left="15.467cm" Top="56.9cm" Value="القرار رقم" Name="textBox220">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="1.373cm" Height="0.5cm" Left="11.3cm" Top="56.9cm" Value="الصارد في" Name="textBox221">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="4.6cm" Height="0.5cm" Left="3.9cm" Top="56.9cm" Value="مسئولاً / مسئولة عن إدارة هذا العقد ." Name="textBox222">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="2.3cm" Height="0.4cm" Left="7.1cm" Top="58.6cm" Value="البند الخامس عشر" Name="textBox223">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.64cm" Height="0.5cm" Left="0.225cm" Top="59.1cm" Value="أقر الطرف الثاني بحق الطرف الأول في أن يقوم بنفسه أو بواسطة أي شخص أو جهة يحددها الطرف الأول في المرور أو التفتيش علي محل هذا" Name="textBox224">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="6.673cm" Height="0.5cm" Left="10.192cm" Top="59.7cm" Value="القعد وفي أي وقت دون حاجة الي إخطار أو أذن مسبق ." Name="textBox225">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.284cm" Height="0.5cm" Left="0.581cm" Top="60.3cm" Value="وفي حالة اكتشاف مخالفة الطرف الثاني لالتزاماته يحق للطرف الأول توقيع أي من الجزاءات المنصوص عهليها في البند الثاني والعشرون من" Name="textBox226">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="1.433cm" Height="0.5cm" Left="15.432cm" Top="60.9cm" Value="هذا العقد ." Name="textBox227">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="2.3cm" Height="0.4cm" Left="7.1cm" Top="62.1cm" Value="البند السادس عشر" Name="textBox228">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="5.54cm" Height="0.5cm" Left="11.325cm" Top="62.6cm" Value="يقر الطرف الثاني بأن الغرض من هذا العقد هو" Name="textBox229">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="8.14cm" Height="0.5cm" Left="0.8cm" Top="62.6cm" Value="وفقاً للمتطلبات الواردة بكراسة الشروط والمواصفات ويلتزم بالتعاون" Name="textBox230">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.73cm" Height="0.5cm" Left="0.135cm" Top="63.8cm" Value="يتعين علي الطرف الثاني مراعاة كافة القوانين واللوائح والتعليمات والقواعد المعمول بها ذات الصلة بمحل التعاقد سواء كانت سابقة أو لاحقة" Name="textBox231">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="2.14cm" Height="0.5cm" Left="14.7cm" Top="64.4cm" Value="علي إبرام العقد ." Name="textBox232">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="6.365cm" Height="0.5cm" Left="10.5cm" Top="65.6cm" Value="29 - الالتزام بحكم المادة (150) من اللائحة التنفيذية." Name="textBox233">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.73cm" Height="0.5cm" Left="0.135cm" Top="66.2cm" Value="30 - إعمالاً لحكم المادة (87) من اللائحة التنفيذية لقانون تنظيم التعاقدات التى تبرمها الجهات العامة الصادر بالقانون رقم 182 لسنة 2018." Name="textBox234">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="7.765cm" Height="0.5cm" Left="9.108cm" Top="66.8cm" Value="31- مراجعة مضمون هذا البند بما يتماشي مع طبيعة محل التعاقد ." Name="textBox236">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.73cm" Height="0.5cm" Left="0.143cm" Top="67.4cm" Value="32 - يتعين على السلطة المختصة بالجهة الإدارية إصدار قرار بتكليف من تراه مناسباً من ذوى الخبرة بالجهة الإدارية لإدارة العقد وذلك التزاماً " Name="textBox235">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="4.681cm" Height="0.5cm" Left="12.192cm" Top="68cm" Value="بحكم المادة (87) من اللائحة التنفيذية." Name="textBox237">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="2.3cm" Height="0.4cm" Left="7.308cm" Top="69.4cm" Value="البند السابع عشر" Name="textBox238">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.73cm" Height="0.5cm" Left="0.135cm" Top="69.9cm" Value="يلتزم الطرف الثانى بالحصول على كافة الموافقات الإدارية والقانونية اللازمة من جهات الاختصاص لتمكنه من مزاولة مهامه الواردة بالعقد طبقاً" Name="textBox239">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="10.181cm" Height="0.5cm" Left="6.692cm" Top="70.5cm" Value="للقوانين واللوائح المتعلقة بها، ويلتزم بكافة الرسوم والمصاريف والالتزامات ذات الصلة." Name="textBox240">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="2.3cm" Height="0.4cm" Left="7.281cm" Top="71.9cm" Value="البند الثامن عشر" Name="textBox241">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.764cm" Height="0.5cm" Left="0.101cm" Top="72.4cm" Value="يلتزم الطرف الثانى والعاملين لديه بالمحافظة على سرية وخصوصية ما يحصلون عليه من معلومات ومستندات أياً كانت طبيعتها تكون متعلقة بالعقد" Name="textBox242">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.065cm" Height="0.5cm" Left="0.8cm" Top="73cm" Value="ويتعهد بعدم إفشائها للغير وذلك طوال مدة سريان العقد أو بعد انتهائه أو فسخه، ويعد الإخلال بمبدأ السرية والخصوصية بمثابة إخلالاً جسيماً" Name="textBox243">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="7.246cm" Height="0.5cm" Left="9.619cm" Top="73.6cm" Value="بشروط العقد ودون الإخلال بأية عقوبة مقررة في هذا الشأن ." Name="textBox244">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="2.3cm" Height="0.4cm" Left="7.308cm" Top="74.7cm" Value="البند التاسع عشر" Name="textBox245">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="10.165cm" Height="0.5cm" Left="6.7cm" Top="75.2cm" Value="يحظر على الطرف الثانى التنازل للغير عن العقد كلياً أو جزئياً أو التصرف فيه بأى وجه." Name="textBox246">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="1.881cm" Height="0.4cm" Left="7.6cm" Top="76.5cm" Value="البند العشرون" Name="textBox247">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.764cm" Height="0.5cm" Left="0.109cm" Top="77cm" Value="أقر الطرف الثانى عند توقيعه على هذا العقد بعدم صدور أحكام نهائية ضده فى إحدى الجرائم المنصوص عليها فى الباب الرابع من الكتاب الثانى من " Name="textBox248">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="7.289cm" Height="0.5cm" Left="9.584cm" Top="77.6cm" Value="قانون العقوبات، أو فى جرائم (التهرب الضريبى، أو الجمركى)." Name="textBox249">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="2.973cm" Height="0.4cm" Left="6.9cm" Top="78.8cm" Value="البند الحادى والعشرون" Name="textBox250">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="13.573cm" Height="0.5cm" Left="3.3cm" Top="79.3cm" Value="يلتزم الطرف الثانى بتحمل كافة الضرائب أو الرسوم أو غيرها التى تستحق على هذا العقد فى مواعيدها المحددة قانوناً." Name="textBox251">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="2.973cm" Height="0.4cm" Left="6.9cm" Top="80.6cm" Value="البند الثاني والعشرون" Name="textBox252">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.764cm" Height="0.5cm" Left="0.109cm" Top="81.1cm" Value="فى حالة إخلال الطرف الثانى بالتزامه بسداد قيمة الترخيص بالانتفاع السنوية، أو أخل بأى شرط من شروط التعاقد، يحق للطرف الأول فسخ العقد أو تنفيذه على حساب الطرف" Name="textBox253">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.5cm" Height="0.5cm" Left="0.373cm" Top="81.7cm" Value="تنفيذه على حساب الطرف الثانى كما يكون للطرف الأول أن يخصم ما يستحقه وقيمة كل خسارة تلحق به من أى مبالغ مستحقة أو تستحق للطرف" Name="textBox254">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.764cm" Height="0.5cm" Left="0.1cm" Top="82.3cm" Value="الثاني لديه، وفى حالة عدم كفايتها يلجأ الطرف الأول إلى خصمها من مستحقاته لدى أى جهة إدارية أخرى أياً كان سبب الاستحقاق، دون حاجة إلي " Name="textBox255">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.764cm" Height="0.5cm" Left="0.1cm" Top="82.8cm" Value="اتخاذ أى إجراءات قضائية، وذلك كله مع عدم الإخلال بحق الطرف الأول فى الرجوع على الطرف الثانى قضائياً بما لم يتمكن من استيفائه من حقوق" Name="textBox256">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.764cm" Height="0.5cm" Left="0.109cm" Top="83.4cm" Value="بالطريق الإدارى، ولا يحق للطرف الثانى المطالبة باسترداد ما سبق سداده، ولا قيمة ما أضافه من تجهيزات وأعمال تطوير وغيرها إلى محل هذا العقد." Name="textBox257">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="0.873cm" Height="0.5cm" Left="16cm" Top="84cm" Value="العقد." Name="textBox258">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="2.973cm" Height="0.4cm" Left="6.9cm" Top="84.7cm" Value="البند الثالث والعشرون" Name="textBox259">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="4.94cm" Height="0.5cm" Left="11.9cm" Top="85.2cm" Value="يفسخ هذا العقد تلقائياً في الحالات الآتية : " Name="textBox260">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="15.24cm" Height="0.5cm" Left="1.6cm" Top="85.8cm" Value="1- إذا تبين أن الطرف الثاني استعمل بنفسه أو بواسطة غيره الغش أو التلاعب في تعامله مع الطرف الأول أو في حصوله علي العقد ." Name="textBox261">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="10.04cm" Height="0.5cm" Left="6.8cm" Top="86.4cm" Value="2- إذا تبين وجود تواطؤ أو ممارسات احتيال أو فساد أو احتكار من قبل الطرف الثاني . " Name="textBox263">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.764cm" Height="0.5cm" Left="0.076cm" Top="88.3cm" Value="يسري علي هذا العقد أحكام قانون تنظيم التعاقدات التي تبرمها الجهات العامة الصادر بالقانون رقم 182 لسنة 2018 ولائحته التنفيذية الصادرة" Name="textBox262">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="10.84cm" Height="0.5cm" Left="6cm" Top="88.9cm" Value="بقرار وزير المالية رقم 692 لسنة 2019 , وذلك فيما لم يرد بشأنه نص خاص في هذا العقد ." Name="textBox267">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="4.44cm" Height="0.5cm" Left="12.4cm" Top="90.3cm" Value="33- الألتزام بحكم (92) من القانون ." Name="textBox266">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="2.973cm" Height="0.4cm" Left="6.9cm" Top="87.8cm" Value="البند الرابع والعشرون" Name="textBox268">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="2.973cm" Height="0.4cm" Left="6.9cm" Top="91.2cm" Value="البند الخامس والعشرون" Name="textBox269">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.764cm" Height="0.5cm" Left="0.101cm" Top="91.7cm" Value="يتم تسوية المنازعات والخلافات التي تنشأ أثناء التنفيذ وفقاً للطرق والشروط والأحكام المنصوص عليها في المادة (91) من قانون تنظيم التعاقدات" Name="textBox270">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.764cm" Height="0.5cm" Left="0.101cm" Top="92.3cm" Value="التي تبرمها الجهات العامة الصادر بالقانون رقم 182 لسنة 2018 , مع مراعاة ضرورة الحصول علي موافقة الوزير المختبص في حالة اللجوء" Name="textBox271">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="1.265cm" Height="0.5cm" Left="15.6cm" Top="92.9cm" Value="للتحكيم ." Name="textBox272">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="9.857cm" Height="0.5cm" Left="7.008cm" Top="93.5cm" Value="( إذا كان المتعاقد معه شخصاً طبيعياً أو اعتبارياً خاصاً يكون البند علي النحو التالي )" Name="textBox294">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="9.857cm" Height="0.5cm" Left="7.016cm" Top="94.7cm" Value="( إذا كان المتعاقد معه شخصاً طبيعياً أو اعتبارياً عاماً يكون البند علي النحو التالي )" Name="textBox295">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="9.965cm" Height="0.5cm" Left="6.899cm" Top="94.1cm" Value="تختص محاكم مجلس الدولة دون غيرها بالفصل في أي نزاع ينشأ عن تنفيذ هذا العقد . " Name="textBox300">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="15.673cm" Height="0.5cm" Left="1.2cm" Top="95.3cm" Value="تختص الجمعية العمومية لقسمي الفتوي والتشريع بمجلس الدولة بالفصل في كافة المنازعات التي قد تنشأ عن تنفيذ أو تفسير هذا العقد ." Name="textBox301">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="2.973cm" Height="0.4cm" Left="6.9cm" Top="96.5cm" Value="البند السادس والعشرون" Name="textBox302">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="7.637cm" Height="0.5cm" Left="9.236cm" Top="97cm" Value="يقبل الطرفان أي تعديلات قد يجريها مجلس الدولة علي هذا العقد ." Name="textBox303">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="2.973cm" Height="0.4cm" Left="6.899cm" Top="98.3cm" Value="البند السابع والعشرون" Name="textBox304">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.765cm" Height="0.5cm" Left="0.135cm" Top="98.8cm" Value="أقر الطرفان بأن العنوان المبين قرين كل منهما بصدر هذا العقد هو المحل المختار لهما , وأن جميع المكاتبات والمراسلات والإعلانات والإخطارات التي توجه أو ترسل أو تعلن أو تخطر عليه تكون صحيحة ومنتجة لكافة آثارها القانونية , وفي حالة تغيير أحد الطرفين لعنوانه " Name="textBox305">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.765cm" Height="0.5cm" Left="0.135cm" Top="99.4cm" Value="التي توجه أو ترسل أو تعلن أو تخطر عليه تكون صحيحة ومنتجة لكافة آثارها القانونية , وفي حالة تغيير أحد الطرفين لعنوانه يتعين عليه إخطار" Name="textBox306">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.764cm" Height="0.5cm" Left="0.136cm" Top="100cm" Value="الطرف الآخر بهذا العنوان الجديد خلال خمسة عشر يوماً , بخطاب مسجل بعلم الوصول , وإلا اعتبرت مكاتباته ومراسلته وإعلاناته وإخطاراته علي" Name="textBox307">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="6.1cm" Height="0.5cm" Left="10.8cm" Top="100.6cm" Value="هذا العنوان صحيحة ومنتجة لكافة آثارها القانونية ." Name="textBox308">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="2.973cm" Height="0.4cm" Left="6.9cm" Top="102.1cm" Value="البند الثامن والعشرون" Name="textBox309">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="15.408cm" Height="0.5cm" Left="1.4cm" Top="102.6cm" Value="تحرر هذا العقد من أربعة نسخ , سلمت إحداها إلي الطرف الثاني , واحتفظ الطرف الأول بالنسخ الأخري , للعمل بمقتضاها عند اللزوم . " Name="textBox310">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
      </Items>
    </DetailSection>
