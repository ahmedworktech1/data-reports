        <TextBox Width="2cm" Height="0.4cm" Left="9.964cm" Top="26.463cm" Value="وشكلها القانوني" Name="textBox54">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="1.6cm" Height="0.4cm" Left="6.764cm" Top="26.463cm" Value="سجل تجاري" Name="textBox55">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="1.792cm" Height="0.4cm" Left="14.664cm" Top="26.863cm" Value="بطاقة ضريبية" Name="textBox57">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="3cm" Height="0.4cm" Left="8.564cm" Top="26.866cm" Value="ويمثلها ( السيد / السيدة" Name="textBox58">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="0.9cm" Height="0.4cm" Left="5.133cm" Top="26.866cm" Value="جنسية" Name="textBox59">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
