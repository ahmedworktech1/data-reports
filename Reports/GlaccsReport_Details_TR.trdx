<Report DataSourceName="sqlDataSource1" Width="27.9cm" Name="Report1999999999" xmlns="http://schemas.telerik.com/reporting/2023/1.0">
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="GLDATA" SelectCommand="SELECT        TOP (100) PERCENT dbo.GLJRNLD.JRN_CD, dbo.GLJRNLD.TR_NO, dbo.GLJRNLD.LN_TY, dbo.GLCST.CST_CD, dbo.GLJRNLD.DOC_NO, dbo.GLTRSTBL.DOC_DS_Ar, dbo.GLJRNLD.TR_DT, dbo.GLJRNLD.DB_VL, &#xD;&#xA;                         dbo.GLJRNLD.CR_VL, dbo.GLMF.ACC_NO, dbo.GLMF.ACC_NM_Ar, dbo.GLJRNLD.TR_DS, dbo.GLSUMS.SUM_NM_Ar, dbo.GLCST.CST_NM_Ar, dbo.GLSCST.SCST_CD, dbo.GLSCST.SCST_NM_Ar, dbo.GLSSUMS.SSUM_CD, &#xD;&#xA;                         dbo.GLSSUMS.SSUM_NM_Ar, dbo.GLSUMS.SUM_CD, dbo.TRH.TR_DT AS TR_DTH, dbo.GLJRNLD.CUR_CD, dbo.GLCURRAT.CUR_NM_Ar, dbo.GLJRNLD.CUR_VL, dbo.GLJRNLD.RATE&#xD;&#xA;FROM            dbo.GLJRNLD INNER JOIN&#xD;&#xA;                         dbo.GLMF ON dbo.GLJRNLD.ACC_NO = dbo.GLMF.ACC_NO INNER JOIN&#xD;&#xA;                         dbo.GLTRSTBL ON dbo.GLJRNLD.JRN_CD = dbo.GLTRSTBL.DOC_TY INNER JOIN&#xD;&#xA;                         dbo.TRH ON dbo.GLJRNLD.JRN_CD = dbo.TRH.JRN_CD AND dbo.GLJRNLD.TR_NO = dbo.TRH.tr_n LEFT OUTER JOIN&#xD;&#xA;                         dbo.GLCURRAT ON dbo.GLJRNLD.CUR_CD = dbo.GLCURRAT.CUR_CD LEFT OUTER JOIN&#xD;&#xA;                         dbo.GLSCST ON dbo.GLJRNLD.scst_cd = dbo.GLSCST.SCST_CD LEFT OUTER JOIN&#xD;&#xA;                         dbo.GLSSUMS ON dbo.GLJRNLD.SSUM_CD = dbo.GLSSUMS.SSUM_CD LEFT OUTER JOIN&#xD;&#xA;                         dbo.GLSUMS ON dbo.GLJRNLD.SUM_CD = dbo.GLSUMS.SUM_CD LEFT OUTER JOIN&#xD;&#xA;                         dbo.GLCST ON dbo.GLJRNLD.CST_CD = dbo.GLCST.CST_CD&#xD;&#xA;WHERE        (1&lt;&gt;1)&#xD;&#xA;ORDER BY dbo.GLJRNLD.JRN_CD, dbo.GLJRNLD.TR_NO, dbo.GLJRNLD.TR_DT, dbo.GLJRNLD.LN_TY DESC, dbo.GLCST.CST_CD, dbo.GLJRNLD.SSUM_CD" Name="sqlDataSource1" />
  </DataSources>
