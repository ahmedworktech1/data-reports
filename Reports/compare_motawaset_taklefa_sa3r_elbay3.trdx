  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="glx2024" SelectCommand="select 'أولا : متوسط تكلفة ك.و.س مباع' as s,&#xD;&#xA;    ROUND(&#xD;&#xA;        CAST(&#xD;&#xA;            SUM(CASE WHEN acc_no LIKE '0%' THEN db_vl - cr_vl ELSE 0 END) &#xD;&#xA;            AS NUMERIC&#xD;&#xA;        ) &#xD;&#xA;        / &#xD;&#xA;        NULLIF(&#xD;&#xA;            SUM(CASE WHEN (acc_no LIKE '0%' OR acc_no LIKE '0%') THEN VAL1 ELSE 0 END), &#xD;&#xA;            0&#xD;&#xA;        ) &#xD;&#xA;        * 100, &#xD;&#xA;    3)&#xD;&#xA; as s2&#xD;&#xA;&#xD;&#xA;from gljrnld  WHERE (( acc_no like '4[6-8]11%' or acc_no like '4[6-8]12%' or acc_no like '4[6-8]2%' or acc_no like '4[6-8]31%' or acc_no LIKE '5[6-8]11111%' OR acc_no LIKE '5[6-8]1111102%'  ) ) &#xD;&#xA;&#xD;&#xA;and (1=1)&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;UNION ALL&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;select 'خامات ومواد ووقود وقطع غيار' as s,&#xD;&#xA;&#xD;&#xA;    ROUND(&#xD;&#xA;        CAST(&#xD;&#xA;            SUM(CASE WHEN acc_no LIKE '4[6-8]11%' and sum_cd = '11' THEN db_vl - cr_vl ELSE 0 END) &#xD;&#xA;            AS NUMERIC&#xD;&#xA;        ) &#xD;&#xA;        / &#xD;&#xA;        NULLIF(&#xD;&#xA;            SUM(CASE WHEN (acc_no LIKE '5[6-8]11111%' OR acc_no LIKE '5[6-8]1111102%') THEN VAL1 ELSE 0 END), &#xD;&#xA;            0&#xD;&#xA;        ) &#xD;&#xA;        * 100, &#xD;&#xA;    3)&#xD;&#xA; as s2&#xD;&#xA;from gljrnld  WHERE (( acc_no like '4[6-8]11%' or acc_no like '4[6-8]12%' or acc_no like '4[6-8]2%' or acc_no like '4[6-8]31%' or acc_no LIKE '5[6-8]1111101%' OR acc_no LIKE '5[6-8]1111102%'  ))and sum_cd = '11' and (1=1)&#xD;&#xA;&#xD;&#xA;UNION ALL&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;select 'الأجور' as s,&#xD;&#xA;&#xD;&#xA;    ROUND(&#xD;&#xA;        CAST(&#xD;&#xA;            SUM(CASE WHEN acc_no LIKE '4[6-8]12%' and sum_cd = '11' THEN db_vl - cr_vl ELSE 0 END) &#xD;&#xA;            AS NUMERIC&#xD;&#xA;        ) &#xD;&#xA;        / &#xD;&#xA;        NULLIF(&#xD;&#xA;            SUM(CASE WHEN (acc_no LIKE '5[6-8]11111%' OR acc_no LIKE '5[6-8]1111102%') THEN VAL1 ELSE 0 END), &#xD;&#xA;            0&#xD;&#xA;        ) &#xD;&#xA;        * 100, &#xD;&#xA;    3)&#xD;&#xA; as s2&#xD;&#xA;&#xD;&#xA;from gljrnld  WHERE (( acc_no like '4[6-8]11%' or acc_no like '4[6-8]12%' or acc_no like '4[6-8]2%' or acc_no like '4[6-8]31%' or acc_no LIKE '5[6-8]11111%' OR acc_no LIKE '5[6-8]1111102%'  ) ) and (1=1)&#xD;&#xA;&#xD;&#xA;UNION ALL&#xD;&#xA;select 'المصروفات' as s,&#xD;&#xA;    ROUND(&#xD;&#xA;        CAST(&#xD;&#xA;            SUM(CASE WHEN acc_no LIKE '0%' and sum_cd = '11' THEN db_vl - cr_vl ELSE 0 END) &#xD;&#xA;            AS NUMERIC&#xD;&#xA;        ) &#xD;&#xA;        / &#xD;&#xA;        NULLIF(&#xD;&#xA;            SUM(CASE WHEN (acc_no LIKE '0%' OR acc_no LIKE '0%') THEN VAL1 ELSE 0 END), &#xD;&#xA;            0&#xD;&#xA;        ) &#xD;&#xA;        * 100, &#xD;&#xA;    3)&#xD;&#xA; as s2&#xD;&#xA;&#xD;&#xA;from gljrnld  WHERE (( acc_no like '4[6-8]11%' or acc_no like '4[6-8]12%' or acc_no like '4[6-8]2%' or acc_no like '4[6-8]31%' or acc_no LIKE '5[6-8]11111%' OR acc_no LIKE '5[6-8]1111102%'  ) ) &#xD;&#xA;&#xD;&#xA;and (1=1)&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;UNION ALL&#xD;&#xA;select 'خدمات مشتراه' as s,&#xD;&#xA;    ROUND(&#xD;&#xA;        CAST(&#xD;&#xA;            SUM(CASE WHEN acc_no LIKE '4[6-8]21%' and sum_cd = '11' THEN db_vl - cr_vl ELSE 0 END) &#xD;&#xA;            AS NUMERIC&#xD;&#xA;        ) &#xD;&#xA;        / &#xD;&#xA;        NULLIF(&#xD;&#xA;            SUM(CASE WHEN (acc_no LIKE '5[6-8]11111%' OR acc_no LIKE '5[6-8]1111102%') THEN VAL1 ELSE 0 END), &#xD;&#xA;            0&#xD;&#xA;        ) &#xD;&#xA;        * 100, &#xD;&#xA;    3)&#xD;&#xA; as s2&#xD;&#xA;&#xD;&#xA;from gljrnld  WHERE (( acc_no LIKE '4[6-8]21%' or acc_no LIKE '5[6-8]11111%' OR acc_no LIKE '5[6-8]1111102%'  ) ) &#xD;&#xA;&#xD;&#xA;and (1=1)&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;UNION ALL&#xD;&#xA;select 'إهلاك واستهلاك' as s,&#xD;&#xA;    ROUND(&#xD;&#xA;        CAST(&#xD;&#xA;            SUM(CASE WHEN acc_no LIKE '4[6-8]22%' and sum_cd = '11' THEN db_vl - cr_vl ELSE 0 END) &#xD;&#xA;            AS NUMERIC&#xD;&#xA;        ) &#xD;&#xA;        / &#xD;&#xA;        NULLIF(&#xD;&#xA;            SUM(CASE WHEN (acc_no LIKE '5[6-8]11111%' OR acc_no LIKE '5[6-8]1111102%') THEN VAL1 ELSE 0 END), &#xD;&#xA;            0&#xD;&#xA;        ) &#xD;&#xA;        * 100, &#xD;&#xA;    3)&#xD;&#xA; as s2&#xD;&#xA;&#xD;&#xA;from gljrnld  WHERE (( acc_no LIKE '4[6-8]22%' or acc_no LIKE '5[6-8]11111%' OR acc_no LIKE '5[6-8]1111102%'  ) ) &#xD;&#xA;&#xD;&#xA;and (1=1)&#xD;&#xA;&#xD;&#xA;UNION ALL&#xD;&#xA;select 'فوائد' as s,&#xD;&#xA;    ROUND(&#xD;&#xA;        CAST(&#xD;&#xA;            SUM(CASE WHEN acc_no LIKE '4[6-8]231%' and sum_cd = '11' THEN db_vl - cr_vl ELSE 0 END) &#xD;&#xA;            AS NUMERIC&#xD;&#xA;        ) &#xD;&#xA;        / &#xD;&#xA;        NULLIF(&#xD;&#xA;            SUM(CASE WHEN (acc_no LIKE '5[6-8]11111%' OR acc_no LIKE '5[6-8]1111102%') THEN VAL1 ELSE 0 END), &#xD;&#xA;            0&#xD;&#xA;        ) &#xD;&#xA;        * 100, &#xD;&#xA;    3)&#xD;&#xA; as s2&#xD;&#xA;&#xD;&#xA;from gljrnld  WHERE (( acc_no LIKE '4[6-8]231%' or acc_no LIKE '5[6-8]11111%' OR acc_no LIKE '5[6-8]1111102%'  ) ) &#xD;&#xA;&#xD;&#xA;and (1=1)&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;UNION ALL&#xD;&#xA;select 'ضرائب وايجارات' as s,&#xD;&#xA;    ROUND(&#xD;&#xA;        CAST(&#xD;&#xA;            SUM(CASE WHEN (acc_no LIKE '4[6-8]24%' or acc_no LIKE '4[6-8]26%') and sum_cd = '11' THEN db_vl - cr_vl ELSE 0 END) &#xD;&#xA;            AS NUMERIC&#xD;&#xA;        ) &#xD;&#xA;        / &#xD;&#xA;        NULLIF(&#xD;&#xA;            SUM(CASE WHEN (acc_no LIKE '5[6-8]11111%' OR acc_no LIKE '5[6-8]1111102%') THEN VAL1 ELSE 0 END), &#xD;&#xA;            0&#xD;&#xA;        ) &#xD;&#xA;        * 100, &#xD;&#xA;    3)&#xD;&#xA; as s2&#xD;&#xA;&#xD;&#xA;from gljrnld  WHERE (( acc_no LIKE '4[6-8]24%' or acc_no LIKE '4[6-8]26%' or acc_no LIKE '5[6-8]11111%' OR acc_no LIKE '5[6-8]1111102%'  ) ) &#xD;&#xA;&#xD;&#xA;and (1=1)&#xD;&#xA;&#xD;&#xA;UNION ALL&#xD;&#xA;select 'إجمالي المصروفات' as s,&#xD;&#xA;    ROUND(&#xD;&#xA;        CAST(&#xD;&#xA;            SUM(CASE WHEN (acc_no LIKE '4[6-8]21%' or acc_no LIKE '4[6-8]22%' or acc_no LIKE '4[6-8]231%' or acc_no LIKE '4[6-8]24%' or acc_no LIKE '4[6-8]26%') and sum_cd = '11' THEN db_vl - cr_vl ELSE 0 END) &#xD;&#xA;            AS NUMERIC&#xD;&#xA;        ) &#xD;&#xA;        / &#xD;&#xA;        NULLIF(&#xD;&#xA;            SUM(CASE WHEN (acc_no LIKE '5[6-8]11111%' OR acc_no LIKE '5[6-8]1111102%') THEN VAL1 ELSE 0 END), &#xD;&#xA;            0&#xD;&#xA;        ) &#xD;&#xA;        * 100, &#xD;&#xA;    3)&#xD;&#xA; as s2&#xD;&#xA;&#xD;&#xA;from gljrnld  WHERE (( acc_no LIKE '4[6-8]21%' or acc_no LIKE '4[6-8]22%' or acc_no LIKE '4[6-8]231%' or acc_no LIKE '4[6-8]24%' or acc_no LIKE '4[6-8]26%' or acc_no LIKE '5[6-8]11111%' OR acc_no LIKE '5[6-8]1111102%'  ) ) &#xD;&#xA;&#xD;&#xA;and (1=1)&#xD;&#xA;&#xD;&#xA;UNION ALL&#xD;&#xA;select 'متوسط تكلفة توزيع وحدة الطاقة' as s,&#xD;&#xA;    ROUND(&#xD;&#xA;        CAST(&#xD;&#xA;            SUM(CASE WHEN (acc_no LIKE '4[6-8]1%' or acc_no LIKE '4[6-8]21%' or acc_no LIKE '4[6-8]22%' or acc_no LIKE '4[6-8]231%' or acc_no LIKE '4[6-8]24%' or acc_no LIKE '4[6-8]26%') and sum_cd = '11' THEN db_vl - cr_vl ELSE 0 END) &#xD;&#xA;            AS NUMERIC&#xD;&#xA;        ) &#xD;&#xA;        / &#xD;&#xA;        NULLIF(&#xD;&#xA;            SUM(CASE WHEN (acc_no LIKE '5[6-8]11111%' OR acc_no LIKE '5[6-8]1111102%') THEN VAL1 ELSE 0 END), &#xD;&#xA;            0&#xD;&#xA;        ) &#xD;&#xA;        * 100, &#xD;&#xA;    3)&#xD;&#xA; as s2&#xD;&#xA;&#xD;&#xA;from gljrnld  WHERE ((acc_no LIKE '4[6-8]1%' or acc_no LIKE '4[6-8]21%' or acc_no LIKE '4[6-8]22%' or acc_no LIKE '4[6-8]231%' or acc_no LIKE '4[6-8]24%' or acc_no LIKE '4[6-8]26%' or acc_no LIKE '5[6-8]11111%' OR acc_no LIKE '5[6-8]1111102%'  ) ) &#xD;&#xA;&#xD;&#xA;and (1=1)&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;UNION ALL&#xD;&#xA;select 'مشتريات بغرض البيع' as s,&#xD;&#xA;    ROUND(&#xD;&#xA;        CAST(&#xD;&#xA;            SUM(CASE WHEN (acc_no LIKE '4[6-8]3%' ) and sum_cd = '11' THEN db_vl - cr_vl ELSE 0 END) &#xD;&#xA;            AS NUMERIC&#xD;&#xA;        ) &#xD;&#xA;        / &#xD;&#xA;        NULLIF(&#xD;&#xA;            SUM(CASE WHEN (acc_no LIKE '5[6-8]11111%' OR acc_no LIKE '5[6-8]1111102%') THEN VAL1 ELSE 0 END), &#xD;&#xA;            0&#xD;&#xA;        ) &#xD;&#xA;        * 100, &#xD;&#xA;    3)&#xD;&#xA; as s2&#xD;&#xA;&#xD;&#xA;from gljrnld  WHERE ((acc_no LIKE '4[6-8]3%'  or acc_no LIKE '5[6-8]11111%' OR acc_no LIKE '5[6-8]1111102%'  ) ) &#xD;&#xA;&#xD;&#xA;and (1=1)&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;UNION ALL&#xD;&#xA;&#xD;&#xA;select 'متوسط تكلفة ك.و.س مباع' as s,&#xD;&#xA;    ROUND(&#xD;&#xA;        CAST(&#xD;&#xA;            SUM(CASE WHEN (acc_no like '4[6-8]11%' or acc_no like '4[6-8]12%' or acc_no like '4[6-8]2%' or acc_no like '4[6-8]31%' ) and sum_cd ='11' THEN db_vl - cr_vl ELSE 0 END) &#xD;&#xA;            AS NUMERIC&#xD;&#xA;        ) &#xD;&#xA;        / &#xD;&#xA;        NULLIF(&#xD;&#xA;            SUM(CASE WHEN (acc_no LIKE '5[6-8]11111%' OR acc_no LIKE '5[6-8]1111102%') THEN VAL1 ELSE 0 END), &#xD;&#xA;            0&#xD;&#xA;        ) &#xD;&#xA;        * 100, &#xD;&#xA;    3)&#xD;&#xA; as s2&#xD;&#xA;&#xD;&#xA;from gljrnld  WHERE (( acc_no like '4[6-8]11%' or acc_no like '4[6-8]12%' or acc_no like '4[6-8]2%' or acc_no like '4[6-8]31%' or acc_no LIKE '5[6-8]11111%' OR acc_no LIKE '5[6-8]1111102%'  ) )and sum_cd ='11' &#xD;&#xA; and (1=1)&#xD;&#xA;&#xD;&#xA;UNION ALL&#xD;&#xA;&#xD;&#xA;select 'ثانيا : متوسط سعر البيع' as s,&#xD;&#xA;    ROUND(&#xD;&#xA;        CAST(&#xD;&#xA;            SUM(CASE WHEN acc_no LIKE '0%' THEN db_vl - cr_vl ELSE 0 END) &#xD;&#xA;            AS NUMERIC&#xD;&#xA;        ) &#xD;&#xA;        / &#xD;&#xA;        NULLIF(&#xD;&#xA;            SUM(CASE WHEN (acc_no LIKE '0%' OR acc_no LIKE '0%') THEN VAL1 ELSE 0 END), &#xD;&#xA;            0&#xD;&#xA;        ) &#xD;&#xA;        * 100, &#xD;&#xA;    3)&#xD;&#xA; as s2&#xD;&#xA;&#xD;&#xA;from gljrnld  WHERE (( acc_no like '4[6-8]11%' or acc_no like '4[6-8]12%' or acc_no like '4[6-8]2%' or acc_no like '4[6-8]31%' or acc_no LIKE '5[6-8]11111%' OR acc_no LIKE '5[6-8]1111102%'  ) ) &#xD;&#xA;&#xD;&#xA;and (1=1)&#xD;&#xA;&#xD;&#xA;UNION ALL&#xD;&#xA;&#xD;&#xA;select '1- للمستهلكين' as s,&#xD;&#xA;&#xD;&#xA;    ROUND(&#xD;&#xA;        CAST(&#xD;&#xA;            SUM(CASE WHEN acc_no like '5[6-8]1111101%' and sum_cd ='11' and cst_cd not like '12%' THEN db_vl - cr_vl ELSE 0 END)*-1 &#xD;&#xA;            AS NUMERIC&#xD;&#xA;        ) &#xD;&#xA;        / &#xD;&#xA;        NULLIF(&#xD;&#xA;            SUM(CASE WHEN ( acc_no LIKE '5[6-8]1111101%') and sum_cd ='11' THEN VAL1 ELSE 0 END), &#xD;&#xA;            0&#xD;&#xA;        ) &#xD;&#xA;        * 100, &#xD;&#xA;    3)&#xD;&#xA; as s2&#xD;&#xA;from gljrnld  WHERE (( acc_no like '5[6-8]1111101%' or acc_no LIKE '5[6-8]11111%' OR acc_no LIKE '5[6-8]1111102%'  ) ) &#xD;&#xA;and (1=1)&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;UNION ALL&#xD;&#xA;&#xD;&#xA;select '2- شركات التوزيع الأخرى' as s,&#xD;&#xA;&#xD;&#xA;    ROUND(&#xD;&#xA;        CAST(&#xD;&#xA;            SUM(CASE WHEN acc_no like '5[6-8]1111102%' and sum_cd ='11'  THEN db_vl - cr_vl ELSE 0 END)*-1 &#xD;&#xA;            AS NUMERIC&#xD;&#xA;        ) &#xD;&#xA;        / &#xD;&#xA;        NULLIF(&#xD;&#xA;            SUM(CASE WHEN (acc_no LIKE '5[6-8]1111102%') and sum_cd ='11' THEN VAL1 ELSE 0 END), &#xD;&#xA;            0&#xD;&#xA;        ) &#xD;&#xA;        * 100, &#xD;&#xA;    3)&#xD;&#xA; as s2&#xD;&#xA;from gljrnld  WHERE (( acc_no like '5[6-8]1111102%' or acc_no LIKE '5[6-8]11111%' OR acc_no LIKE '5[6-8]1111102%'  ) ) &#xD;&#xA;and (1=1)&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;UNION ALL&#xD;&#xA;&#xD;&#xA;select 'متوسط سعر البيع' as s,&#xD;&#xA;&#xD;&#xA;    ROUND(&#xD;&#xA;        CAST(&#xD;&#xA;            SUM(CASE WHEN acc_no like '5[6-8]11111%' and sum_cd ='11' THEN db_vl - cr_vl ELSE 0 END)*-1 &#xD;&#xA;            AS NUMERIC&#xD;&#xA;        ) &#xD;&#xA;        / &#xD;&#xA;        NULLIF(&#xD;&#xA;            SUM(CASE WHEN (acc_no LIKE '5[6-8]11111%' OR acc_no LIKE '5[6-8]1111102%') and sum_cd ='11' THEN VAL1 ELSE 0 END), &#xD;&#xA;            0&#xD;&#xA;        ) &#xD;&#xA;        * 100, &#xD;&#xA;    3)&#xD;&#xA; as s2&#xD;&#xA;from gljrnld  WHERE (( acc_no like '5[6-8]11111%' or acc_no LIKE '5[6-8]11111%' OR acc_no LIKE '5[6-8]1111102%'  ) ) &#xD;&#xA;and (1=1)&#xD;&#xA;&#xD;&#xA;union all &#xD;&#xA;&#xD;&#xA;select 'هامش الربح او الخسارة' as s,&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;    ROUND(&#xD;&#xA;        CAST(&#xD;&#xA;            (SUM(CASE WHEN acc_no like '5[6-8]11111%' THEN db_vl - cr_vl ELSE 0 END)*-1&#xD;&#xA;&#x9;&#x9;&#x9;-&#xD;&#xA;&#x9;&#x9;&#x9;(SUM(CASE WHEN ( acc_no like '4[6-8]11%' or acc_no like '4[6-8]12%' or acc_no like '4[6-8]2%' or acc_no like '4[6-8]31%' ) and sum_cd ='11' THEN db_vl - cr_vl ELSE 0 END))) &#xD;&#xA;            AS NUMERIC&#xD;&#xA;        ) &#xD;&#xA;        / &#xD;&#xA;        NULLIF(&#xD;&#xA;            SUM(CASE WHEN (acc_no LIKE '5[6-8]11111%' OR acc_no LIKE '5[6-8]1111102%') THEN VAL1 ELSE 0 END), &#xD;&#xA;            0&#xD;&#xA;        ) &#xD;&#xA;        * 100, &#xD;&#xA;    3)&#xD;&#xA; as s2&#xD;&#xA;from gljrnld  WHERE ((acc_no like '4[6-8]11%' or acc_no like '4[6-8]12%' or acc_no like '4[6-8]2%' or acc_no like '4[6-8]31%' or acc_no like '5[6-8]11111%' OR acc_no LIKE '5[6-8]1111102%'  ) ) and sum_cd ='11' &#xD;&#xA;&#xD;&#xA;and (1=1)&#xD;&#xA;&#xD;&#xA;UNION ALL&#xD;&#xA;&#xD;&#xA;SELECT &#xA;    'مقابل خدمات مباعة تيار' AS s,&#xA;    FORMAT(&#xA;        ROUND(&#xA;            CAST(&#xA;                SUM(CASE WHEN acc_no LIKE '5[6-8]1122101%' THEN db_vl - cr_vl ELSE 0 END) * -1 &#xA;                AS NUMERIC&#xA;            ) / NULLIF(&#xA;                SUM(CASE WHEN (acc_no LIKE '5[6-8]11111%' OR acc_no LIKE '5[6-8]1111102%') THEN VAL1 ELSE 0 END), &#xA;                0&#xA;            ) * 100, &#xA;        3), &#xA;    '0.000') AS s2&#xA;FROM gljrnld&#xA;WHERE &#xA;    (acc_no LIKE '5[6-8]1122101%' OR acc_no LIKE '5[6-8]11111%' OR acc_no LIKE '5[6-8]1111102%') &#xA;    AND (1=1)&#xA;&#xD;&#xA;UNION ALL&#xD;&#xA;&#xD;&#xA;select 'مقابل خدمة عملاء' as s,&#xD;&#xA;    ROUND(&#xD;&#xA;        CAST(&#xD;&#xA;            SUM(CASE WHEN acc_no like '5[6-8]1122103%' THEN db_vl - cr_vl ELSE 0 END)*-1 &#xD;&#xA;            AS NUMERIC&#xD;&#xA;        ) &#xD;&#xA;        / &#xD;&#xA;        NULLIF(&#xD;&#xA;            SUM(CASE WHEN (acc_no LIKE '5[6-8]11111%' OR acc_no LIKE '5[6-8]1111102%') THEN VAL1 ELSE 0 END), &#xD;&#xA;            0&#xD;&#xA;        ) &#xD;&#xA;        * 100, &#xD;&#xA;    3)&#xD;&#xA; as s2&#xD;&#xA;&#xD;&#xA;from gljrnld  WHERE (( acc_no like '5[6-8]1122103%' or acc_no LIKE '5[6-8]11111%' OR acc_no LIKE '5[6-8]1111102%') ) &#xD;&#xA;and (1=1)&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;UNION ALL&#xD;&#xA;&#xD;&#xA;select 'نصيب الشركة من قيمة الدعم المستحق طرف وزارة المالية لكل ك.و.س' as s,&#xD;&#xA;    ROUND(&#xD;&#xA;        CAST(&#xD;&#xA;            SUM(CASE WHEN (acc_no like '512501%' or acc_no like '512503%' or acc_no like '512504%' ) and JRN_CD &lt;&gt; '0147' THEN db_vl - cr_vl ELSE 0 END)*-1 &#xD;&#xA;            AS NUMERIC&#xD;&#xA;        ) &#xD;&#xA;        / &#xD;&#xA;        NULLIF(&#xD;&#xA;            SUM(CASE WHEN (acc_no LIKE '5[6-8]11111%' OR acc_no LIKE '5[6-8]1111102%') THEN VAL1 ELSE 0 END), &#xD;&#xA;            0&#xD;&#xA;        ) &#xD;&#xA;        * 100, &#xD;&#xA;    3)&#xD;&#xA; as s2&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;from gljrnld  WHERE ((  acc_no like '512501%' or acc_no like '512503%' or acc_no like '512504%'  or acc_no LIKE '5[6-8]11111%' OR acc_no LIKE '5[6-8]1111102%') ) &#xD;&#xA; and jrn_Cd &lt;&gt; '0147' and (1=1)&#xD;&#xA;union all &#xD;&#xA;&#xD;&#xA;&#xD;&#xA;select 'متوسط سعر البيع بعد الدعم والخدمات المباعة' as s,&#xD;&#xA;    ROUND(&#xD;&#xA;        CAST(&#xD;&#xA;            SUM(CASE WHEN (acc_no like '5[6-8]11111%' or acc_no like '512501%' or acc_no like '512503%' or acc_no like '512504%'   or acc_no like '5[6-8]1122101%' or acc_no like '5[6-8]1122103%') THEN db_vl - cr_vl ELSE 0 END)*-1 &#xD;&#xA;            AS NUMERIC&#xD;&#xA;        ) &#xD;&#xA;        / &#xD;&#xA;        NULLIF(&#xD;&#xA;            SUM(CASE WHEN (acc_no LIKE '5[6-8]11111%' OR acc_no LIKE '5[6-8]1111102%') THEN VAL1 ELSE 0 END), &#xD;&#xA;            0&#xD;&#xA;        ) &#xD;&#xA;        * 100, &#xD;&#xA;    3)&#xD;&#xA; as s2&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;from gljrnld  WHERE ((acc_no like '5[6-8]11111%'or acc_no like '512501%' or acc_no like '512503%' or acc_no like '512504%'  or acc_no like '512503%' or acc_no like '512504%'   or acc_no like '5[6-8]1122101%' or acc_no like '5[6-8]1122103%' or acc_no like '512501%' or acc_no LIKE '5[6-8]11111%' OR acc_no LIKE '5[6-8]1111102%') ) &#xD;&#xA;and (1=1) and JRN_CD &lt;&gt; '0147'&#xD;&#xA;union all &#xD;&#xA;&#xD;&#xA;&#xD;&#xA;select 'هامش الربح او (الخسارة) بعد مقابل خدمة العملاء ودعم وزارة المالية' as s,&#xD;&#xA;&#xD;&#xA;    ROUND(&#xD;&#xA;        CAST(&#xD;&#xA;            (SUM(CASE WHEN acc_no like '5[6-8]11111%' THEN db_vl - cr_vl ELSE 0 END)*-1&#xD;&#xA;&#x9;&#x9;&#x9;-&#xD;&#xA;&#x9;&#x9;&#x9;(SUM(CASE WHEN ( acc_no like '4[6-8]11%' or acc_no like '4[6-8]12%' or acc_no like '4[6-8]2%' or acc_no like '4[6-8]31%' ) and sum_cd ='11' THEN db_vl - cr_vl ELSE 0 END))&#xD;&#xA;&#x9;&#x9;&#x9;-&#xD;&#xA;&#x9;&#x9;&#x9;CAST(ROUND(sum( case when (acc_no like '512501%' or acc_no like '512503%' or acc_no like '512504%'  ) then db_vl-cr_vl else 0 end ), 0) AS BIGINT)&#xD;&#xA;&#x9;&#x9;&#x9;-&#xD;&#xA;&#x9;&#x9;&#x9;(CAST(ROUND(sum( case when (acc_no like '5[6-8]1122101%' ) then db_vl-cr_vl else 0 end ), 0) AS BIGINT))&#xD;&#xA;&#x9;&#x9;&#x9;-&#xD;&#xA;&#x9;&#x9;&#x9;(CAST(ROUND(sum( case when (acc_no like '5[6-8]1122103%' ) then db_vl-cr_vl else 0 end ), 0) AS BIGINT))&#xD;&#xA;&#x9;&#x9;&#x9;) &#xD;&#xA;            AS NUMERIC&#xD;&#xA;        ) &#xD;&#xA;        / &#xD;&#xA;        NULLIF(&#xD;&#xA;            SUM(CASE WHEN (acc_no LIKE '5[6-8]11111%' OR acc_no LIKE '5[6-8]1111102%') THEN VAL1 ELSE 0 END), &#xD;&#xA;            0&#xD;&#xA;        ) &#xD;&#xA;        * 100, &#xD;&#xA;    3)&#xD;&#xA; as s2&#xD;&#xA;&#xD;&#xA;from gljrnld  WHERE ((acc_no like '4[6-8]11%' or acc_no like '4[6-8]12%' or acc_no like '4[6-8]2%' or acc_no like '4[6-8]31%' or acc_no like '5[6-8]1111101%' or acc_no LIKE '5[6-8]11111%' OR acc_no LIKE '5[6-8]1111102%' or acc_no like '512501%' or acc_no like '512503%' or acc_no like '512504%'   or acc_no like '5[6-8]1122101%' or acc_no like '5[6-8]1122103%'   ) ) &#xD;&#xA;&#xD;&#xA; and JRN_CD &lt;&gt; '0147'  and(1=1)&#xD;&#xA;&#xD;&#xA;union all&#xD;&#xA;&#xD;&#xA;select 'كمية الطاقة المباعة او المشتراه مليون ك.و.س' as s,&#xD;&#xA;    ROUND(&#xD;&#xA;        CAST(&#xD;&#xA;            SUM(CASE WHEN acc_no LIKE '0%' THEN db_vl - cr_vl ELSE 0 END) &#xD;&#xA;            AS NUMERIC&#xD;&#xA;        ) &#xD;&#xA;        / &#xD;&#xA;        NULLIF(&#xD;&#xA;            SUM(CASE WHEN (acc_no LIKE '0%' OR acc_no LIKE '0%') THEN VAL1 ELSE 0 END), &#xD;&#xA;            0&#xD;&#xA;        ) &#xD;&#xA;        * 100, &#xD;&#xA;    3)&#xD;&#xA; as s2&#xD;&#xA;&#xD;&#xA;from gljrnld  WHERE (( acc_no like '4[6-8]11%' or acc_no like '4[6-8]12%' or acc_no like '4[6-8]2%' or acc_no like '4[6-8]31%' or acc_no LIKE '5[6-8]11111%' OR acc_no LIKE '5[6-8]1111102%'  ) ) &#xD;&#xA;&#xD;&#xA;and (1=1)&#xD;&#xA;&#xD;&#xA;union all &#xD;&#xA;&#xD;&#xA;&#xD;&#xA;select '1- كمية الطاقة المتاحة' as s,&#xD;&#xA;&#xD;&#xA;ROUND(SUM(CASE &#xD;&#xA;        WHEN (acc_no LIKE '4[6-8]31%') AND sum_cd = '11' &#xD;&#xA;        THEN val1 &#xD;&#xA;        ELSE 0 &#xD;&#xA;    END) / 1000000, 3) AS s2&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;from gljrnld  WHERE (( acc_no like '4[6-8]31%') ) &#xD;&#xA;and (1=1)&#xD;&#xA;&#xD;&#xA;union all &#xD;&#xA;&#xD;&#xA;&#xD;&#xA;select '2- كمية الطاقة المباعة' as s,&#xD;&#xA;&#xD;&#xA;ROUND(sum( case when (acc_no LIKE '5[6-8]11111%' OR acc_no LIKE '5[6-8]1111102%') and sum_cd = '11' then val1 else 0 end )/1000000, 3)&#xD;&#xA; as s2&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;from gljrnld  WHERE ((acc_no LIKE '5[6-8]11111%' OR acc_no LIKE '5[6-8]1111102%') ) &#xD;&#xA;and (1=1)&#xD;&#xA;&#xD;&#xA;union all &#xD;&#xA;&#xD;&#xA;SELECT &#xA;    'الفقد' AS s,&#xA;    ROUND(&#xA;        (ROUND(SUM(CASE &#xA;            WHEN (acc_no LIKE '4[6-8]31%') AND sum_cd = '11' &#xA;            THEN val1 &#xA;            ELSE 0 &#xA;        END), 3)&#xA;        -&#xA;        ROUND(SUM(CASE &#xA;            WHEN (acc_no LIKE '5[6-8]11111%' OR acc_no LIKE '5[6-8]1111102%') AND sum_cd = '11' &#xA;            THEN val1 &#xA;            ELSE 0 &#xA;        END), 3)) / 1000000, &#xA;    3) AS s2&#xA;FROM gljrnld  &#xA;WHERE &#xA;    (acc_no LIKE '4[6-8]31%' OR acc_no LIKE '5[6-8]11111%' OR acc_no LIKE '5[6-8]1111102%') &#xA;    AND (1=1)&#xA;&#xD;&#xA;&#xD;&#xA;union all &#xD;&#xA;&#xD;&#xA;&#xD;&#xA;SELECT &#xA;    'نسبة الفقد' AS s,&#xA;    ROUND(&#xA;        (&#xA;            ROUND(SUM(CASE &#xA;                WHEN (acc_no LIKE '4[6-8]31%') AND sum_cd = '11' &#xA;                THEN val1 &#xA;                ELSE 0 &#xA;            END), 3)&#xA;            -&#xA;            ROUND(SUM(CASE &#xA;                WHEN (acc_no LIKE '5[6-8]11111%' OR acc_no LIKE '5[6-8]1111102%') AND sum_cd = '11' &#xA;                THEN val1 &#xA;                ELSE 0 &#xA;            END), 3)&#xA;        ) / 1000000 &#xA;        / &#xA;        NULLIF(&#xA;            ROUND(SUM(CASE &#xA;                WHEN (acc_no LIKE '4[6-8]31%') AND sum_cd = '11' &#xA;                THEN val1 &#xA;                ELSE 0 &#xA;            END) / 1000000, 3), &#xA;            0&#xA;        ) &#xA;        * 100, &#xA;    3) as s2&#xA;FROM gljrnld&#xA;WHERE &#xA;    (acc_no LIKE '4[6-8]31%' OR acc_no LIKE '5[6-8]11111%' OR acc_no LIKE '5[6-8]1111102%') &#xA;    AND (1=1)&#xA;&#xA;&#xA;" Name="sqlDataSource1" />
