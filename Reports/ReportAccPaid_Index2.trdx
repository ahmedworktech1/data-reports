            <TextBox Width="2.7cm" Height="8mm" Left="4.949cm" Top="8.71mm" Value="= Sum(Fields.PayAmt)" Format="{0:N2}" Name="textBox21">
              <Style BackgroundColor="White" Color="Black" TextAlign="Center" VerticalAlign="Middle">
                <Font Size="8pt" />
                <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
                <BorderColor Top="64, 64, 64" Bottom="64, 64, 64" Left="64, 64, 64" Right="64, 64, 64" />
                <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
                <Padding Top="0in" Bottom="0in" />
              </Style>
            </TextBox>
            <TextBox Width="2.7cm" Height="8mm" Left="8.34cm" Top="8.71mm" Value="=Sum(Fields.TotVal - Fields.PayAmt)&#xD;&#xA;" Format="{0:N2}" Name="textBox20">
              <Style BackgroundColor="White" Color="Black" TextAlign="Center" VerticalAlign="Middle">
                <Font Size="8pt" />
                <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
                <BorderColor Top="64, 64, 64" Bottom="64, 64, 64" Left="64, 64, 64" Right="64, 64, 64" />
                <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
                <Padding Top="0in" Bottom="0in" />
              </Style>
            </TextBox>
          </Items>
        </GroupFooterSection>
      </GroupFooter>
    </Group>
  </Groups>
