        <TextBox Width="1.43cm" Height="0.4cm" Left="6.17cm" Top="0cm" Value="=IIf(Fields.TR_DT Is Nothing, '-', Fields.TR_DT)" Format="{0:dd/MM/yyyy}" CanGrow="True" Culture="en" Name="textBox123">
          <Style TextAlign="Justify" VerticalAlign="Middle">
