<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource1" Width="17cm" Name="purchase_subreport_m7dr_fat7_mazryf" Zoom="1.5" xmlns="http://schemas.telerik.com/reporting/2023/1.0">
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="{&quot;@LocParam&quot;:&quot;50&quot;,&quot;@TrTyParam&quot;:&quot;115&quot;,&quot;@FNCLTRNO&quot;:&quot;2-مناقصه عامة-2026/2025&quot;}" ConnectionString="azxsandoaa" SelectCommand="SELECT&#xD;&#xA;    t.vst_no,&#xD;&#xA;    dbo.num_to_str(t.vst_no) AS tfqet,&#xD;&#xA;    t.tr_dt,&#xD;&#xA;    t.Rmrk7,&#xD;&#xA;    t.PYMNT_MTHD,&#xD;&#xA;    PM.DSCR_AR AS PYMNT_MTHD_Name,&#xD;&#xA;    t.acc_no,&#xD;&#xA;    t.acc_nm&#xD;&#xA;FROM (&#xD;&#xA;    SELECT *,&#xD;&#xA;        ROW_NUMBER() OVER (&#xD;&#xA;            PARTITION BY FNCL_TR_NO, acc_no&#xD;&#xA;            ORDER BY CASE WHEN PYMNT_MTHD IS NULL THEN 1 ELSE 0 END, TR_NO DESC&#xD;&#xA;        ) AS rn&#xD;&#xA;    FROM aztrh&#xD;&#xA;    WHERE AZTRH.loc = @LocParam&#xD;&#xA;      AND AZTRH.tr_ty = @TrTyParam&#xD;&#xA;      AND AZTRH.FNCL_TR_NO = @FNCLTRNO&#xD;&#xA;) t&#xD;&#xA;LEFT JOIN AppCodes PM&#xD;&#xA;    ON PM.ID = '11031'&#xD;&#xA;    AND PM.SEQ = t.PYMNT_MTHD&#xD;&#xA;WHERE t.rn = 1" Name="sqlDataSource1">
      <Parameters>
        <SqlDataSourceParameter DbType="String" Name="@LocParam">
          <Value>
            <String>= Parameters.Locparam.Value</String>
          </Value>
        </SqlDataSourceParameter>
        <SqlDataSourceParameter DbType="Int16" Name="@TrTyParam">
          <Value>
            <String>= Parameters.TrTyparam.Value</String>
          </Value>
        </SqlDataSourceParameter>
        <SqlDataSourceParameter DbType="String" Name="@FNCLTRNO">
          <Value>
            <String>= Parameters.FNCLTRNOparam.Value</String>
          </Value>
        </SqlDataSourceParameter>
      </Parameters>
    </SqlDataSource>
  </DataSources>
  <Items>
    <DetailSection Height="0.4cm" Name="detailSection1">
      <Items>
        <TextBox Width="4.07cm" Height="0.4cm" Left="0.0cm" Top="0cm" Value="= Fields.tfqet" CanGrow="True" CanShrink="True" Name="textBox3">
          <Style TextAlign="Right" VerticalAlign="Middle">
            <Font Size="7pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="0.41cm" Height="0.4cm" Left="4.07cm" Top="0cm" Value="فقط" Name="textBox4">
