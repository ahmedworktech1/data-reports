<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.telerik.com/reporting/2023/1.0" DataSourceName="sqlDataSource1" Width="15.748cm" Name="purchase_subreport_m7dr_fat7_mazryf" Zoom="1.5">
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="{&quot;@LocParam&quot;:&quot;50&quot;,&quot;@TrTyParam&quot;:&quot;115&quot;,&quot;@FNCLTRNO&quot;:&quot;2-مناقصه عامة-2026/2025&quot;}" ConnectionString="azxsandoaa" SelectCommand="SELECT&#13;&#10;    t.vst_no,&#13;&#10;    dbo.num_to_str(t.vst_no) AS tfqet,&#13;&#10;    t.tr_dt,&#13;&#10;    t.Rmrk7,&#13;&#10;    t.PYMNT_MTHD,&#13;&#10;    PM.DSCR_AR AS PYMNT_MTHD_Name,&#13;&#10;    t.acc_no,&#13;&#10;    t.acc_nm&#13;&#10;FROM (&#13;&#10;    SELECT *,&#13;&#10;        ROW_NUMBER() OVER (&#13;&#10;            PARTITION BY FNCL_TR_NO, acc_no&#13;&#10;            ORDER BY CASE WHEN PYMNT_MTHD IS NULL THEN 1 ELSE 0 END, TR_NO DESC&#13;&#10;        ) AS rn&#13;&#10;    FROM aztrh&#13;&#10;    WHERE AZTRH.loc = @LocParam&#13;&#10;      AND AZTRH.tr_ty = @TrTyParam&#13;&#10;      AND AZTRH.FNCL_TR_NO = @FNCLTRNO&#13;&#10;) t&#13;&#10;LEFT JOIN AppCodes PM&#13;&#10;    ON PM.ID = '11031'&#13;&#10;    AND PM.SEQ = t.PYMNT_MTHD&#13;&#10;WHERE t.rn = 1" Name="sqlDataSource1">
      <Parameters>
        <SqlDataSourceParameter DbType="String" Name="@LocParam">
          <Value>
            <String>= Parameters.Locparam.Value</String>
          </Value>
        </SqlDataSourceParameter>
        <SqlDataSourceParameter DbType="Int16" Name="@TrTyParam">
          <Value>
            <String>= Parameters.TrTyparam.Value</String>
          </Value>
        </SqlDataSourceParameter>
        <SqlDataSourceParameter DbType="String" Name="@FNCLTRNO">
          <Value>
            <String>= Parameters.FNCLTRNOparam.Value</String>
          </Value>
        </SqlDataSourceParameter>
      </Parameters>
    </SqlDataSource>
  </DataSources>
