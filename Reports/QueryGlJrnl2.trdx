        </TextBox>
        <TextBox Width="4.9cm" Height="0.6cm" Left="0.4cm" Top="0.1cm" Value="= Fields.acc_nm" Name="textBox18">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="8pt" Bold="True" />
            <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
      </Items>
    </DetailSection>
    <ReportFooterSection Height="1.4cm" Name="reportFooterSection1">
      <Style BackgroundColor="White" />
      <Items>
        <TextBox Width="3.2cm" Height="0.6cm" Left="7.4cm" Top="0cm" Value="= sum(Fields.db_vl)" Format="{0:#.00}" Name="textBox5">
          <Style BackgroundColor="Yellow" Color="Red" TextAlign="Center">
            <Font Bold="True" />
            <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="3.4cm" Height="0.6cm" Left="4cm" Top="0cm" Value="= sum(Fields.cr_vl)" Format="{0:#.00}" Name="textBox13">
          <Style BackgroundColor="Yellow" Color="Red" TextAlign="Center">
            <Font Bold="True" />
            <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="4.3cm" Height="0.6cm" Left="10.6cm" Top="0cm" Value="الاجمالى" Name="textBox20">
          <Style BackgroundColor="Yellow" Color="Red" TextAlign="Center" VerticalAlign="Middle">
