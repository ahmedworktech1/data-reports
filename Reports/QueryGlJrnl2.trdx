<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource1" Width="17cm" Name="QueryGlJrnl1" xmlns="http://schemas.telerik.com/reporting/2021/1.0">
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="glx2024" SelectCommand="select gljrnld.jrn_cd,gljrnld.tr_no,ln_no,gljrnld.tr_dt,db_vl,cr_vl,&#xD;&#xA;acc_no,(select acc_nm_ar from glmf where glmf.acc_no = gljrnld.acc_no) as acc_nm,TR_DS&#xD;&#xA;from gljrnld,gljrnlh  where gljrnld.jrn_cd= gljrnlh.jrn_cd and gljrnld.tr_no= gljrnlh.tr_no and 1=1&#xD;&#xA;order by gljrnld.jrn_cd,gljrnld.tr_no,gljrnld.tr_dt" Name="sqlDataSource1" />
  </DataSources>
  <Items>
    <PageHeaderSection Height="1.3cm" Name="pageHeaderSection1">
      <Style BackgroundColor="" />
      <Items>
        <TextBox Width="3cm" Height="0.5cm" Left="7.1cm" Top="0.1cm" Value="الاستعلام عن القيود" Name="textBox3">
          <Style TextAlign="Center">
            <Font Bold="True" />
          </Style>
        </TextBox>
        <TextBox Width="1cm" Height="0.6cm" Left="13.9cm" Top="0.7cm" Value="يومية" Name="textBox2">
          <Style BackgroundColor="Silver" Color="Red" TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" />
            <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
