          </Style>
        </TextBox>
        <TextBox Width="3.2cm" Height="0.6cm" Left="6cm" Top="0.8cm" Value="= sum(Fields.db_vl) - sum(Fields.cr_vl)" Format="{0:#.00}" Name="textBox21">
          <Style BackgroundColor="Yellow" Color="Red" TextAlign="Center">
            <Font Bold="True" />
            <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
