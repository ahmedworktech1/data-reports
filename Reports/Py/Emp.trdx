<Report DataSourceName="sqlDataSource1" Width="38.6cm" Name="Report1" xmlns="http://schemas.telerik.com/reporting/2021/1.0">
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="PY" SelectCommand="SELECT &#xD;&#xA;&#xD;&#xA;emp_no,emp_name&#xD;&#xA;--,(SELECT DSCR_AR FROM PYLISTS WHERE Rec_Type=1 AND CODE= Mngmnt_D) MNGMNT&#xD;&#xA;,isnull((SELECT DSCR_AR FROM PYLISTS WHERE Rec_Type=2 AND CODE= Dept_No),(SELECT DSCR_AR FROM PYLISTS WHERE Rec_Type=1 AND CODE= Mngmnt_D)) dept&#xD;&#xA;,(select dscr_ar from appcodes where id=12 and seq=PYEMPMFH.JOB_CD) pos&#xD;&#xA;,emp_date&#xD;&#xA;,Brth_Date&#xD;&#xA;,Home_Addr&#xD;&#xA;,nat_no&#xD;&#xA;,MOB_NO&#xD;&#xA;&#xD;&#xA;,comp_no&#xD;&#xA;,(select comp_name from pycomp where comp_no=PYEMPMFH.comp_no) plc  &#xD;&#xA;--,(select val from PYEMPMFd where dx_code='d5' and emp_no=PYEMPMFH.Emp_No) d5 --الراتب&#xD;&#xA;&#xD;&#xA;&#xD;&#xA; &#xD;&#xA;&#xD;&#xA; ,EDU_YR AS EDU_YR FROM PYEMPMFH&#xD;&#xA; where (1=1) and Sal_Status=1 &#xD;&#xA;&#xD;&#xA;&#xD;&#xA; order by comp_no,emp_no" Name="sqlDataSource1" />
  </DataSources>
