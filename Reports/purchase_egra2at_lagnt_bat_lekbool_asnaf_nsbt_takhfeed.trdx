<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource1" Width="20cm" Name="اجراءات لجنه بت لقبول اصناف بتخفيض" xmlns="http://schemas.telerik.com/reporting/2023/1.0">
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="azxsandoaa" SelectCommand="WITH ALLMEMBERS AS (&#xA;  SELECT &#xA;    A.TR_NO,&#xA;    A.FNCL_TR_NO,&#xA;    A.PURCHAS_NO,&#xA;    BOSS.EMP_NAME AS BOSS,&#xA;    BOSS.JOB_CD AS BOSS_DSC,&#xA;    L.DSCR_AR AS MEMPER_DWLA,&#xA;    E.EMP_NAME AS MEMBERNAME,&#xA;    E.JOB_CD&#xA;  FROM AZTRH A&#xA;  LEFT JOIN PYEMPMF_H BOSS ON BOSS.EMP_NO = A.CMMTTE_CHRMN_DCSN&#xA;  LEFT JOIN AZLISTS L &#xA;    ON TRY_CAST(REPLACE(REPLACE(COALESCE(A.CMMTTE_EXTRNL_MMBRS_DCSN,''),'''',''),'&quot;','') AS INT) = L.CODE &#xA;    AND L.REC_TYPE = 61&#xA;  OUTER APPLY (&#xA;    SELECT VALUE&#xA;    FROM STRING_SPLIT(REPLACE(REPLACE(COALESCE(A.CMMTTE_INTRNL_MMBRS_DCSN,''),'''',''),'&quot;',''),',')&#xA;    WHERE VALUE &lt;&gt; '' AND ISNUMERIC(VALUE)=1&#xA;  ) S&#xA;  LEFT JOIN PYEMPMF_H E ON TRY_CAST(S.VALUE AS INT)=E.EMP_NO&#xA;  WHERE A.TR_TY='119' AND E.EMP_NAME IS NOT NULL&#xA;&#xA;  UNION ALL&#xA;&#xA;  SELECT &#xA;    A.TR_NO,&#xA;    A.FNCL_TR_NO,&#xA;    A.PURCHAS_NO,&#xA;    BOSS.EMP_NAME,&#xA;    BOSS.JOB_CD,&#xA;    L.DSCR_AR,&#xA;    EL.DSCR_AR,&#xA;    NULL&#xA;  FROM AZTRH A&#xA;  LEFT JOIN PYEMPMF_H BOSS ON BOSS.EMP_NO=A.CMMTTE_CHRMN_OPN&#xA;  LEFT JOIN AZLISTS L &#xA;    ON TRY_CAST(REPLACE(REPLACE(COALESCE(A.CMMTTE_EXTRNL_MMBRS_DCSN,''),'''',''),'&quot;','') AS INT)=L.CODE &#xA;    AND L.REC_TYPE=61&#xA;  OUTER APPLY (&#xA;    SELECT VALUE&#xA;    FROM STRING_SPLIT(REPLACE(REPLACE(COALESCE(A.CMMTTE_EXTRNL_MMBRS_DCSN,''),'''',''),'&quot;',''),',')&#xA;    WHERE VALUE&lt;&gt;'' AND ISNUMERIC(VALUE)=1&#xA;  ) S&#xA;  LEFT JOIN AZLISTS EL ON TRY_CAST(S.VALUE AS INT)=EL.CODE AND EL.REC_TYPE=61&#xA;  WHERE A.TR_TY='119' AND EL.DSCR_AR IS NOT NULL&#xA;),&#xA;&#xA;WITHJOBNAME AS (&#xA;  SELECT &#xA;    A.TR_NO,&#xA;    A.FNCL_TR_NO,&#xA;    A.PURCHAS_NO,&#xA;    A.BOSS,&#xA;    A.BOSS_DSC,&#xA;    A.MEMPER_DWLA,&#xA;    A.MEMBERNAME,&#xA;    J.DSCR_AR AS JOBNAME&#xA;  FROM ALLMEMBERS A&#xA;  LEFT JOIN PYX_SANDOAA..APPCODES J &#xA;    ON J.ID=12 AND J.SEQ=A.JOB_CD&#xA;),&#xA;&#xA;NUMBERED AS (&#xA;  SELECT &#xA;    TR_NO,&#xA;    FNCL_TR_NO,&#xA;    PURCHAS_NO,&#xA;    BOSS,&#xA;    BOSS_DSC,&#xA;    MEMPER_DWLA,&#xA;    MEMBERNAME,&#xA;    JOBNAME,&#xA;    ROW_NUMBER() OVER (PARTITION BY TR_NO ORDER BY MEMBERNAME) RN&#xA;  FROM WITHJOBNAME&#xA;),&#xA;&#xA;COMMITTEEDATA AS (&#xA;  SELECT &#xA;    TR_NO,&#xA;    MAX(BOSS) BOSS,&#xA;    MAX(BOSS_DSC) BOSS_DSC,&#xA;    MAX(MEMPER_DWLA) MEMPER_DWLA,&#xA;    MAX(CASE WHEN RN=1 THEN MEMBERNAME END) MEMBER1,&#xA;    MAX(CASE WHEN RN=1 THEN JOBNAME END) MEMBER1JOB,&#xA;    MAX(CASE WHEN RN=2 THEN MEMBERNAME END) MEMBER2,&#xA;    MAX(CASE WHEN RN=2 THEN JOBNAME END) MEMBER2JOB,&#xA;    MAX(CASE WHEN RN=3 THEN MEMBERNAME END) MEMBER3,&#xA;    MAX(CASE WHEN RN=3 THEN JOBNAME END) MEMBER3JOB,&#xA;    MAX(CASE WHEN RN=4 THEN MEMBERNAME END) MEMBER4,&#xA;    MAX(CASE WHEN RN=4 THEN JOBNAME END) MEMBER4JOB&#xA;  FROM NUMBERED&#xA;  GROUP BY TR_NO&#xA;),&#xA;&#xA;HEADERDATA AS (&#xA;  SELECT &#xA;    TR_NO,&#xA;    FNCL_TR_NO,&#xA;    PURCHAS_NO,&#xA;    TCHNCL_DCSN_DT,&#xA;    ACC_NM&#xA;  FROM AZTRH&#xA;  WHERE TR_TY='119'&#xA;)&#xA;&#xA;SELECT&#xA;  D.TR_NO,&#xA;  HD.FNCL_TR_NO,&#xA;  HD.PURCHAS_NO,&#xA;  D.LN_NO,&#xA;  D.TR_DT,&#xA;  D.ITM_CD,&#xA;  ITM.ITM_NM_AR AS ITEM_NAME,&#xA;  ITM.ITM_CLS1 AS ITEM_SPECS,&#xA;  D.QTY,&#xA;  PK.PK_NM_AR AS UNIT_NAME,&#xA;  D.PKPRC AS ESTIMATED_PRICE,&#xA;  CAST(D.PKPRC AS INT) AS PKPRC_GNEH,&#xA;  CAST(ROUND((D.PKPRC - FLOOR(D.PKPRC)) * 100, 0) AS INT) AS PKPRC_QERSH,&#xA;  (D.QTY * D.PKPRC) AS LINE_TOTAL,&#xA;  D.SAL_DISC_PRCNT,&#xA;  D.RMRK,&#xA;  D.RMRK1,&#xA;  D.ENTEREDBY,&#xA;  LST.DSCR_AR AS REQUESTING_DEPT,&#xA;&#xA;  -- بيانات اللجنة&#xA;  CD.BOSS,&#xA;  CD.BOSS_DSC,&#xA;  CD.MEMPER_DWLA,&#xA;  CD.MEMBER1,&#xA;  CD.MEMBER1JOB,&#xA;  CD.MEMBER2,&#xA;  CD.MEMBER2JOB,&#xA;  CD.MEMBER3,&#xA;  CD.MEMBER3JOB,&#xA;  CD.MEMBER4,&#xA;  CD.MEMBER4JOB,&#xA;&#xA;  -- بيانات الرأس&#xA;  HD.TCHNCL_DCSN_DT,&#xA;  HD.ACC_NM,&#xA;&#xA;  -- إجمالي المعاملة&#xA;  (SELECT SUM(QTY * PKPRC) &#xA;   FROM AZTRD &#xA;   WHERE TR_NO = D.TR_NO AND TR_TY='119') AS TOTAL_VALUE&#xA;&#xA;FROM AZTRD D&#xA;&#xA;LEFT JOIN AZITMS ITM ON ITM.ITM_CD=D.ITM_CD&#xA;LEFT JOIN AZPKGDEF PK ON PK.PKID=D.PKID&#xA;LEFT JOIN AZLISTS LST ON LST.CODE=D.CAROWNER AND LST.REC_TYPE='2'&#xA;&#xA;LEFT JOIN COMMITTEEDATA CD &#xA;  ON CD.TR_NO=D.TR_NO&#xA;&#xA;LEFT JOIN HEADERDATA HD &#xA;  ON HD.TR_NO=D.TR_NO&#xA;&#xA;WHERE D.TR_TY='119'&#xA;&#xA;ORDER BY D.TR_NO, D.LN_NO;" Name="sqlDataSource1" />
  </DataSources>
