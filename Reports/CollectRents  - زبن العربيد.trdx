<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="webServiceDataSource1" Width="20.3cm" PageNumberingStyle="ResetNumberingAndCount" Name="CollectRents" xmlns="http://schemas.telerik.com/reporting/2021/1.0">
  <Style>
    <BorderStyle Top="None" Bottom="None" Left="None" Right="None" />
    <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
    <BorderWidth Top="1.5pt" Bottom="1.5pt" Left="1.5pt" Right="1.5pt" />
  </Style>
  <DataSources>
    <WebServiceDataSource ParameterValues="{&quot;.AspNetCore.Identity.Application&quot;:,&quot;@Url&quot;:,&quot;TrNoLkup&quot;:,&quot;TenantNo&quot;:,&quot;TenantName&quot;:,&quot;BldCd&quot;:,&quot;PayedAmtH&quot;:,&quot;PayedTy&quot;:,&quot;CheckNo&quot;:,&quot;Bnk&quot;:,&quot;Nots&quot;:,&quot;NotsEn&quot;:,&quot;AccNo&quot;:,&quot;TrDt&quot;:,&quot;DueDt&quot;:,&quot;DepstNo&quot;:,&quot;Revisd&quot;:,&quot;DptNo&quot;:}" AuthParameterValues="null" ServiceUrl="@Url" Name="webServiceDataSource1">
      <Parameters>
        <WebServiceParameter WebServiceParameterType="Cookie" Name=".AspNetCore.Identity.Application">
          <Value>
            <String>= Parameters.login.Value</String>
          </Value>
        </WebServiceParameter>
        <WebServiceParameter WebServiceParameterType="Inline" Name="@Url">
          <Value>
            <String>= Parameters.Url.Value + "aq/CollectRents/GetDataReport"</String>
          </Value>
        </WebServiceParameter>
        <WebServiceParameter WebServiceParameterType="Query" Name="TrNoLkup">
          <Value>
            <String>= Parameters.TrNoLkup.Value</String>
          </Value>
        </WebServiceParameter>
        <WebServiceParameter WebServiceParameterType="Query" Name="TenantNo">
          <Value>
            <String>= Parameters.TenantNo.Value</String>
          </Value>
        </WebServiceParameter>
        <WebServiceParameter WebServiceParameterType="Query" Name="TenantName">
          <Value>
            <String>= Parameters.TenantName.Value</String>
          </Value>
        </WebServiceParameter>
        <WebServiceParameter WebServiceParameterType="Query" Name="BldCd">
          <Value>
            <String>= Parameters.BldCd.Value</String>
          </Value>
        </WebServiceParameter>
        <WebServiceParameter WebServiceParameterType="Query" Name="PayedAmtH">
          <Value>
            <String>= Parameters.PayedAmtH.Value</String>
          </Value>
        </WebServiceParameter>
        <WebServiceParameter WebServiceParameterType="Query" Name="PayedTy">
          <Value>
            <String>= Parameters.PayedTy.Value</String>
          </Value>
        </WebServiceParameter>
        <WebServiceParameter WebServiceParameterType="Query" Name="CheckNo">
          <Value>
            <String>= Parameters.CheckNo.Value</String>
          </Value>
        </WebServiceParameter>
        <WebServiceParameter WebServiceParameterType="Query" Name="Bnk">
          <Value>
            <String>= Parameters.Bnk.Value</String>
          </Value>
        </WebServiceParameter>
        <WebServiceParameter WebServiceParameterType="Query" Name="Nots">
          <Value>
            <String>= Parameters.Nots.Value</String>
          </Value>
        </WebServiceParameter>
        <WebServiceParameter WebServiceParameterType="Query" Name="NotsEn">
          <Value>
            <String>= Parameters.NotsEn.Value</String>
          </Value>
        </WebServiceParameter>
        <WebServiceParameter WebServiceParameterType="Query" Name="AccNo">
          <Value>
            <String>= Parameters.AccNo.Value</String>
          </Value>
        </WebServiceParameter>
        <WebServiceParameter WebServiceParameterType="Query" Name="TrDt">
          <Value>
            <String>= Parameters.TrDt.Value</String>
          </Value>
        </WebServiceParameter>
        <WebServiceParameter WebServiceParameterType="Query" Name="DueDt">
          <Value>
            <String>= Parameters.DueDt.Value</String>
          </Value>
        </WebServiceParameter>
        <WebServiceParameter WebServiceParameterType="Query" Name="DepstNo">
          <Value>
            <String>= Parameters.DepstNo.Value</String>
          </Value>
        </WebServiceParameter>
        <WebServiceParameter WebServiceParameterType="Query" Name="Revisd">
          <Value>
            <String>= Parameters.Revisd.Value</String>
          </Value>
        </WebServiceParameter>
        <WebServiceParameter WebServiceParameterType="Query" Name="DptNo">
          <Value>
            <String>= Parameters.DptNo.Value</String>
          </Value>
        </WebServiceParameter>
      </Parameters>
    </WebServiceDataSource>
  </DataSources>
  <Items>
    <PageHeaderSection Height="0.132cm" Name="pageHeaderSection1">
      <Style Visible="False" />
    </PageHeaderSection>
    <DetailSection PageBreak="After" Height="13.536cm" Name="detailSection1">
      <Style Visible="True" BackgroundColor="White">
        <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
        <BorderColor Top="White" Bottom="White" Left="White" Right="White" />
        <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
      </Style>
      <Items>
        <PictureBox Image="" Width="20.3cm" Height="13.168cm" Left="0cm" Top="0cm" Sizing="Stretch" MimeType="image/jpeg" Name="pictureBox1" />
        <Panel Width="2.1cm" Height="0.9cm" Left="13cm" Top="9.968cm" Name="panel1">
          <Style BackgroundColor="White" />
        </Panel>
        <TextBox Width="4.4cm" Height="0.7cm" Left="13.6cm" Top="4.368cm" Value="= Fields.TrDtStr" Format="{0:d}" Multiline="False" Culture="uk" Name="textBox69">
          <Style Color="Black" TextAlign="Left" VerticalAlign="Middle">
            <Font Name="Times New Roman" Size="12pt" Bold="True" />
            <BorderStyle Top="None" Bottom="None" Left="None" Right="None" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="3.9cm" Height="0.825cm" Left="14.7cm" Top="2.868cm" Value="= Fields.TrNo" Culture="uk" Name="textBox63">
          <Style TextAlign="Center" VerticalAlign="Bottom">
            <Font Name="Times New Roman" Size="14pt" Bold="True" />
            <BorderStyle Top="None" Bottom="None" Left="None" Right="None" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="3.6cm" Height="0.9cm" Left="1.9cm" Top="2.868cm" Value="= Fields.Amt" Format="{0:N3}" Culture="uk" Name="textBox66">
          <Style TextAlign="Center" VerticalAlign="Bottom">
            <Font Name="Times New Roman" Size="14pt" Bold="True" />
            <BorderStyle Top="None" Bottom="None" Left="None" Right="None" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="16.1cm" Height="0.6cm" Left="0.5cm" Top="5.568cm" Value="=Fields.M_TenantNm" Name="textBox70">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Name="Times New Roman" Size="12pt" Bold="True" Underline="False" />
            <BorderStyle Top="None" Bottom="None" Left="None" Right="None" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="16cm" Height="0.639cm" Left="0.5cm" Top="6.668cm" Value="= brca.Core.Services.ReportStaticService.Tafqeet(Abs(Fields.AmtTafqeet))" Name="textBox73">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Name="Times New Roman" Size="12pt" Bold="True" />
            <BorderStyle Top="None" Bottom="None" Left="None" Right="None" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="4.6cm" Height="0.8cm" Left="0.2cm" Top="8.868cm" Value="=Fields.M_BldDscr" Name="textBox71">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Name="Times New Roman" Size="12pt" Bold="True" Underline="False" />
            <BorderStyle Top="None" Bottom="None" Left="None" Right="None" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="12.4cm" Height="0.7cm" Left="4.7cm" Top="10.168cm" Value="=Fields.Nots" Name="textBox72">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Name="Times New Roman" Size="12pt" Bold="True" />
            <BorderStyle Top="None" Bottom="None" Left="None" Right="None" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="7.036cm" Height="0.6cm" Left="8.864cm" Top="9.068cm" Value="=Fields.UntTyp" Name="textBox1">
          <Style TextAlign="Right" VerticalAlign="Middle">
            <Font Name="Times New Roman" Size="12pt" Bold="True" Underline="False" />
            <BorderStyle Top="None" Bottom="None" Left="None" Right="None" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="3.1cm" Height="0.7cm" Left="13.6cm" Top="7.868cm" Value="=Fields.M_PayedTy" Name="textBox3">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Name="Times New Roman" Size="12pt" Bold="True" Underline="False" />
            <BorderStyle Top="None" Bottom="None" Left="None" Right="None" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="2.8cm" Height="0.65cm" Left="8.4cm" Top="7.868cm" Value="=Fields.M_CheckNo" Name="textBox4">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Name="Times New Roman" Size="12pt" Bold="True" Underline="False" />
            <BorderStyle Top="None" Bottom="None" Left="None" Right="None" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="4.4cm" Height="0.65cm" Left="0.5cm" Top="7.868cm" Value="=Fields.M_Bnk" Name="textBox5">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Name="Times New Roman" Size="12pt" Bold="True" Underline="False" />
            <BorderStyle Top="None" Bottom="None" Left="None" Right="None" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="2.4cm" Height="0.6cm" Left="0.2cm" Top="0.668cm" Value="= CDate(Fields.M_DueDt)" Multiline="False" Culture="uk" Name="textBox6">
          <Style Color="White" TextAlign="Left" VerticalAlign="Middle">
            <Font Name="Times New Roman" Size="10pt" Bold="False" />
            <BorderStyle Top="None" Bottom="None" Left="None" Right="None" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <Panel Width="2.98cm" Height="0.9cm" Left="1.72cm" Top="9.968cm" Name="panel2">
          <Style BackgroundColor="White" />
        </Panel>
        <TextBox Width="3.3cm" Height="0.368cm" Left="0.2cm" Top="13.097cm" Value="=Fields.EntryDate" Format="{0:g}" Name="textBox7">
          <Style TextAlign="Center" VerticalAlign="Bottom">
            <Font Name="Times New Roman" Size="9pt" Bold="True" Underline="False" />
            <BorderStyle Top="None" Bottom="None" Left="None" Right="None" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
