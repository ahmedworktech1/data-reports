        </TextBox>
        <TextBox Width="3.3cm" Height="0.368cm" Left="4.4cm" Top="13.097cm" Value="=Fields.EnteredBy" Name="textBox2">
          <Style TextAlign="Center" VerticalAlign="Bottom">
            <Font Name="Times New Roman" Size="9pt" Bold="True" Underline="False" />
            <BorderStyle Top="None" Bottom="None" Left="None" Right="None" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="3.48cm" Height="0.6cm" Left="1.72cm" Top="4.368cm" Value="تخفيض مؤقت للايجار" Name="textBox8">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" />
          </Style>
          <Bindings>
            <Binding Path="Style.Visible" Expression="= IIf(Fields.Amt &lt;&gt; Fields.CollectAmt, true, false)" />
          </Bindings>
        </TextBox>
        <TextBox Width="3.3cm" Height="0.368cm" Left="8.4cm" Top="13.097cm" Value="=Fields.PrntdCount" Format="{0:g}" Name="textBox10">
          <Style TextAlign="Center" VerticalAlign="Bottom">
            <Font Name="Times New Roman" Size="9pt" Bold="True" Underline="False" />
            <BorderStyle Top="None" Bottom="None" Left="None" Right="None" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="3.3cm" Height="0.368cm" Left="12.6cm" Top="13.097cm" Value="=Fields.TrDt" Name="textBox9">
          <Style TextAlign="Center" VerticalAlign="Bottom">
            <Font Name="Times New Roman" Size="9pt" Bold="True" Underline="False" />
