      </Items>
    </DetailSection>
    <PageFooterSection Height="0.132cm" Name="pageFooterSection1">
      <Style Visible="True" />
    </PageFooterSection>
  </Items>
  <PageSettings PaperKind="Custom" PaperSize="210mm, 150mm" Landscape="False" ContinuousPaper="True">
    <Margins>
      <MarginsU Left="0.3cm" Right="0.3cm" Top="1cm" Bottom="0.5cm" />
    </Margins>
  </PageSettings>
  <StyleSheet>
    <StyleRule>
      <Style>
        <Padding Left="2pt" Right="2pt" />
      </Style>
      <Selectors>
        <TypeSelector Type="TextItemBase" />
        <TypeSelector Type="HtmlTextBox" />
      </Selectors>
    </StyleRule>
  </StyleSheet>
  <ReportParameters>
    <ReportParameter Name="login" AllowNull="True" />
    <ReportParameter Name="Url" Text="Url" />
    <ReportParameter Name="TrNoLkup" />
    <ReportParameter Name="TenantNo" />
    <ReportParameter Name="TenantName" />
    <ReportParameter Name="BldCd" />
