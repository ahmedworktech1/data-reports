        </TextBox>
        <TextBox Width="15.8cm" Height="2.541cm" Left="0.6cm" Top="24.6cm" Value="للمؤسسة حق التوقف عن إعمال الصيانة والتزيت والتشحيم في حالة تأخر الطرف الثاني عن&#xD;&#xA;سداد قيمة الصيانة المنصوص عليها في موعد أقصاه الخامس من كل شهر وفى حالة عدم&#xD;&#xA;السداد كليا دون أدنى مسئولية عليها&#xD;&#xA;" CanShrink="False" Culture="ar-EG" Name="textBox67">
          <Style BackgroundColor="White" TextAlign="Center" VerticalAlign="Middle">
            <Font Name="Times New Roman" Size="12pt" Bold="True" Underline="False" />
            <BorderStyle Default="Solid" Top="None" Bottom="None" Left="None" Right="None" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Default="0.5pt" Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="3cm" Height="0.8cm" Left="7cm" Top="27.3cm" Value="البند التاسع" Culture="ar-EG" Name="textBox36">
          <Style BackgroundColor="White" TextAlign="Center" VerticalAlign="Middle">
            <Font Name="Times New Roman" Size="14pt" Bold="True" Underline="True" />
            <BorderStyle Default="Solid" Top="None" Bottom="None" Left="None" Right="None" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Default="0.5pt" Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="15.8cm" Height="2.6cm" Left="0.6cm" Top="28.216cm" Value="مدة سريان العقد {Fields.PrdTy} من تاريخ التوقيع من الطرفين {Fields.CON_STRT_DT} إلى{Fields.CON_END_DT}&#xD;&#xA;ويتجدد تلقائيا ما لم يرغب أحد الطرفين في انهائة وفى هذه الحالة على الطرف الراغب في&#xD;&#xA;الإنهاء أخطار الطرف الأخر قبل انتهاء المدة المحددة بشهر على الأقل بخطاب مسجل بعلم&#xD;&#xA;الوصول وألا اعتبر العقد سارى المفعول&#xD;&#xA;" CanShrink="False" Culture="ar-EG" Name="textBox19">
          <Style BackgroundColor="White" TextAlign="Center" VerticalAlign="Middle">
            <Font Name="Times New Roman" Size="12pt" Bold="True" Underline="False" />
            <BorderStyle Default="Solid" Top="None" Bottom="None" Left="None" Right="None" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Default="0.5pt" Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="3cm" Height="0.8cm" Left="7cm" Top="31cm" Value="البند العاشر" Culture="ar-EG" Name="textBox40">
          <Style BackgroundColor="White" TextAlign="Center" VerticalAlign="Middle">
            <Font Name="Times New Roman" Size="14pt" Bold="True" Underline="True" />
            <BorderStyle Default="Solid" Top="None" Bottom="None" Left="None" Right="None" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Default="0.5pt" Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="15.8cm" Height="1.2cm" Left="0.6cm" Top="31.8cm" Value="تسرى احكام القانون المدنى فيما لم يرد بشانه نص" CanShrink="False" Culture="ar-EG" Name="textBox39">
          <Style BackgroundColor="White" TextAlign="Center" VerticalAlign="Middle">
            <Font Name="Times New Roman" Size="12pt" Bold="True" Underline="False" />
            <BorderStyle Default="Solid" Top="None" Bottom="None" Left="None" Right="None" />
