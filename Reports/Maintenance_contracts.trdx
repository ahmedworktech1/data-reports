<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource1" Width="17cm" Name="عقد مقدمي الخدمة" xmlns="http://schemas.telerik.com/reporting/2021/1.0">
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="aqxarmy2024" SelectCommand="SELECT &#xD;&#xA;[dbo].[_GetArabicNumbers]([dbo].[_GetFormatDate](TR_DT)) AS TR_DT,&#xD;&#xA;[dbo].[GetWeakDayNameAr](AQRENT_H.TR_DT) AS ArabicWeekdayName,&#xD;&#xA;[dbo].[_GetArabicNumbers](Servicproviders.SrvcPvTENANT_NO) AS SrvcPvTENANT_NO,&#xD;&#xA;[dbo].[_GetArabicNumbers](Servicproviders.SrvcPvTENANT_Nm_AR) AS SrvcPvTENANT_Nm_AR,&#xD;&#xA;[dbo].[_GetArabicNumbers](Servicproviders.ServiceProviderName) AS ServiceProviderName,&#xD;&#xA;[dbo].[_GetArabicNumbers](Servicproviders.SrvcPvPRSNL_ID) AS SrvcPvPRSNL_ID,&#xD;&#xA;[dbo].[_GetArabicNumbers](Servicproviders.SrvcPvPhone) AS SrvcPvPhone,&#xD;&#xA;[dbo].[_GetArabicNumbers](Servicproviders.SrvcPvADDRS) AS SrvcPvADDRS,&#xD;&#xA;[dbo].[_GetArabicNumbers](Servicproviders.SrvcPvSIGN_RESP_DSCR) AS SrvcPvSIGN_RESP_DSCR,&#xD;&#xA;[dbo].[_GetArabicNumbers](CONTRACTS_H.Con_Cd) AS Con_Cd,&#xD;&#xA;[dbo].[_GetArabicNumbers](Servicproviders.SrvcPvSIGN_RESP_ID) AS SrvcPvSIGN_RESP_ID,&#xD;&#xA;[dbo].[_GetArabicNumbers](AQRENT_H.InsPercentange) AS Ins,&#xD;&#xA;CONTRACTS_H.PRD,&#xD;&#xA;CONTRACTS_H.TYP_PRD,&#xD;&#xA;CONTRACTS_H.SERVIC_TYPE,&#xD;&#xA;(SELECT TOP 1 DSCR_AR FROM AppCodes WHERE ID = 141 AND SEQ = CONTRACTS_H.Rent_Type) AS Rent_Type,&#xD;&#xA;[dbo].[_GetArabicNumbers]([dbo].[_GetFormatDate](CONTRACTS_H.CON_DT)) AS CON_DT,&#xD;&#xA;[dbo].[_GetArabicNumbers]([dbo].[_GetFormatDate](CONTRACTS_H.CON_STRT_DT)) AS CON_STRT_DT,&#xD;&#xA;[dbo].[_GetArabicNumbers]([dbo].[_GetFormatDate](CONTRACTS_H.CON_END_DT)) AS CON_END_DT,&#xD;&#xA;case CONTRACTS_H.CONTRC_STATE &#xD;&#xA;  when 1 then 'جديد' &#xD;&#xA;  when 2 then 'سارى'&#xD;&#xA;  when 3 then 'منتهى'&#xD;&#xA;  when 4 then 'ملغى'&#xD;&#xA;  when 5 then 'طلب موافقه'&#xD;&#xA;  else ''&#xD;&#xA;end as ContractState,&#xD;&#xA;case CONTRACTS_H.PRD&#xD;&#xA;  when 1 then 'سنة' &#xD;&#xA;  when 2 then 'سنتين'&#xD;&#xA;  when 3 then 'ثلاث سنوات'&#xD;&#xA;  when 4 then 'اربع سنوات'&#xD;&#xA;  when 5 then 'خمس سنوات'&#xD;&#xA;  else ''&#xD;&#xA;end as PrdTy,&#xD;&#xA;[dbo].[_GetArabicNumbers](CONTRACTS_H.VAL) AS VAL,&#xD;&#xA;[dbo].[_GetArabicNumbers]((CONTRACTS_H.VAL * 12)) AS TOTAL_VAL,&#xD;&#xA;[dbo].[_GetArabicNumbers](CONTRACTS_H.InsPercentange) AS InsPercentange,&#xD;&#xA;[dbo].[_GetArabicNumbers](CONTRACTS_H.Ins) AS Ins,&#xD;&#xA;case CONTRACTS_H.Approval&#xD;&#xA;  when 1 then 'تحت التصديق'&#xD;&#xA;  when 2 then 'مصدق'&#xD;&#xA;  else 'تحت التصديق'&#xD;&#xA;end as Approval,&#xD;&#xA;CONTRACTS_H.SERVIC_LOC,&#xD;&#xA;CONTRACTS_H.CON_DSCR,&#xD;&#xA;Contracts_H.ComId&#xD;&#xA;FROM CONTRACTS_H&#xD;&#xA;INNER JOIN Servicproviders&#xD;&#xA;ON Servicproviders.SrvcPvTENANT_NO = CONTRACTS_H.TR_NO&#xD;&#xA;LEFT JOIN AQRENT_H ON AQRENT_H.Tr_NO = Contracts_H.TR_NO&#xD;&#xA;WHERE (1=1)&#xD;&#xA;" Name="sqlDataSource1" />
  </DataSources>
  <Items>
    <DetailSection Height="37.2cm" Name="detailSection1">
      <Items>
        <TextBox Width="3cm" Height="0.6cm" Left="7cm" Top="0.2cm" Value="تمهيد" Name="textBox12">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Size="14pt" Bold="True" Underline="True" />
          </Style>
        </TextBox>
        <TextBox Width="15.8cm" Height="2.3cm" Left="0.444cm" Top="0.8cm" Value="&#xD;&#xA;حيث أن الطرف الأول قد أقام قسما متخصصا للخدمة ولصيانة المصاعد الكهربائية من رجال&#xD;&#xA;ذو كفاءة وسيبذلون كل عناية للأجهزة حتى تعمل بدرجة جيدة فقد ارتضى الطرفان المتعاقدان&#xD;&#xA;الالتزام بالبنود آلاتية &#xD;&#xA;" Name="textBox13">
          <Style TextAlign="Center" VerticalAlign="Top">
            <Font Size="12pt" Bold="True" />
          </Style>
        </TextBox>
        <TextBox Width="15.8cm" Height="0.6cm" Left="0.6cm" Top="4.1cm" Value="يعتبر التمهيد جزء لا يتجزاء من هذا العقد" Name="textBox14">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Size="12pt" Bold="True" />
          </Style>
        </TextBox>
        <TextBox Width="3cm" Height="0.6cm" Left="7cm" Top="3.4cm" Value="البند الاول" Name="textBox15">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Size="14pt" Bold="True" Underline="True" />
          </Style>
        </TextBox>
        <TextBox Width="15.8cm" Height="2.1cm" Left="0.444cm" Top="6.2cm" Value="قبل بموجب هذا العقد الطرف الأول القيام بفحص وضبط وتشحيم وتزيت الأجهزة المملوكة&#xD;&#xA;للطرف الثاني وعددهم {Fields.UNITS} مصعد الكائن بالعنوان دار الأمل + دار الوفاء + مبنى الاقامة&#xD;&#xA;للعلاج الطبيعى&#xD;&#xA;" Name="textBox16">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Size="12pt" Bold="True" />
          </Style>
        </TextBox>
        <TextBox Width="3cm" Height="0.8cm" Left="7cm" Top="8.7cm" Value="البند الثالث" Culture="ar-EG" Name="textBox27">
          <Style BackgroundColor="White" TextAlign="Center" VerticalAlign="Middle">
            <Font Name="Times New Roman" Size="14pt" Bold="True" Underline="True" />
            <BorderStyle Default="Solid" Top="None" Bottom="None" Left="None" Right="None" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Default="0.5pt" Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="15.8cm" Height="2.25cm" Left="0.6cm" Top="9.5cm" Value="تتحمل المؤسسة صرف ما يلزم من الزيوت والشحومات المخصوصة واللازمة للصيانة وذلك&#xD;&#xA;بالمرور عليها مرة شهريا أما الإصلاحات الناتجة من الاستعمال العادي أو من ظروف غير&#xD;&#xA;عادية ............. الخ فتعمل عنها مقايسة تقدم للطرف الثاني للموافقة عليها قبل تنفيذها&#xD;&#xA;" CanShrink="False" Culture="ar-EG" Name="textBox26">
          <Style BackgroundColor="White" TextAlign="Center" VerticalAlign="Middle">
            <Font Name="Times New Roman" Size="12pt" Bold="True" Underline="False" />
            <BorderStyle Default="Solid" Top="None" Bottom="None" Left="None" Right="None" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Default="0.5pt" Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="3cm" Height="0.8cm" Left="7cm" Top="11.9cm" Value="البند الرابع" Culture="ar-EG" Name="textBox29">
          <Style BackgroundColor="White" TextAlign="Center" VerticalAlign="Middle">
            <Font Name="Times New Roman" Size="14pt" Bold="True" Underline="True" />
            <BorderStyle Default="Solid" Top="None" Bottom="None" Left="None" Right="None" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Default="0.5pt" Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="15.8cm" Height="1.6cm" Left="0.6cm" Top="12.7cm" Value="في حالة توقف المصاعد أثناء أوقات العمل الرئمية على المؤسسة إرسال احد عمالها فورا&#xD;&#xA;لإعادة المصاعد إلى عملها&#xD;&#xA;" CanShrink="False" Culture="ar-EG" Name="textBox28">
          <Style BackgroundColor="White" TextAlign="Center" VerticalAlign="Middle">
            <Font Name="Times New Roman" Size="12pt" Bold="True" Underline="False" />
            <BorderStyle Default="Solid" Top="None" Bottom="None" Left="None" Right="None" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Default="0.5pt" Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="3cm" Height="0.9cm" Left="7cm" Top="14.5cm" Value="البند الخامس" Culture="ar-EG" Name="textBox31">
          <Style BackgroundColor="White" TextAlign="Center" VerticalAlign="Middle">
            <Font Name="Times New Roman" Size="14pt" Bold="True" Underline="True" />
            <BorderStyle Default="Solid" Top="None" Bottom="None" Left="None" Right="None" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Default="0.5pt" Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="15.8cm" Height="1cm" Left="0.6cm" Top="15.4cm" Value="في حالة توريد وتركيب الاجهزة والاكسسوار بمعرفة الطرف الثاني تتقاضي المؤسسة مصنعية التركيب والاشراف " CanShrink="False" Culture="ar-EG" Name="textBox30">
          <Style BackgroundColor="White" TextAlign="Center" VerticalAlign="Middle">
            <Font Name="Times New Roman" Size="12pt" Bold="True" Underline="False" />
            <BorderStyle Default="Solid" Top="None" Bottom="None" Left="None" Right="None" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Default="0.5pt" Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="3cm" Height="0.8cm" Left="7cm" Top="16.601cm" Value="البند السادس" Culture="ar-EG" Name="textBox33">
          <Style BackgroundColor="White" TextAlign="Center" VerticalAlign="Middle">
            <Font Name="Times New Roman" Size="14pt" Bold="True" Underline="True" />
            <BorderStyle Default="Solid" Top="None" Bottom="None" Left="None" Right="None" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Default="0.5pt" Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="15.8cm" Height="2.501cm" Left="0.6cm" Top="17.5cm" Value="في حالة اختلال عمل المصاعد بأي شكل يتعهد الطرف الثاني بإيقافها بقطع التيار الكهربائي&#xD;&#xA;عنها ويتم أخطار المؤسسة رسميا حتى يحضر مندوب المؤسسة لاصلاحة وتشغيلها وذلك&#xD;&#xA;خلال ٤٨ ساعة فى ايام العمل الرسمية من الابلاغ وفى حالة التاخير او عدم الاستجابة يتم&#xD;&#xA;خصم مبلغ ٥٠٠ جنيه فقط خمسمائة جنيه من قيمة الصيانة&#xD;&#xA;" CanShrink="False" Culture="ar-EG" Name="textBox32">
          <Style BackgroundColor="White" TextAlign="Center" VerticalAlign="Middle">
            <Font Name="Times New Roman" Size="12pt" Bold="True" Underline="False" />
            <BorderStyle Default="Solid" Top="None" Bottom="None" Left="None" Right="None" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Default="0.5pt" Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="3cm" Height="0.8cm" Left="7cm" Top="20.2cm" Value="البند السابع" Culture="ar-EG" Name="textBox17">
          <Style BackgroundColor="White" TextAlign="Center" VerticalAlign="Middle">
            <Font Name="Times New Roman" Size="14pt" Bold="True" Underline="True" />
            <BorderStyle Default="Solid" Top="None" Bottom="None" Left="None" Right="None" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Default="0.5pt" Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="15.8cm" Height="2.501cm" Left="0.6cm" Top="21cm" Value="تتقاضى المؤسسة شهريا من الطرف الثاني نظير قيامها بالتعهدات السابقة ({Fields.VAL}) جنيه&#xD;&#xA;( الفان ومائة جنيها مصريا فقط لاغير) تزيد بنسبة {Fields.Ins}% سنويا&#xD;&#xA;" CanShrink="False" Culture="ar-EG" Name="textBox18">
          <Style BackgroundColor="White" TextAlign="Center" VerticalAlign="Middle">
            <Font Name="Times New Roman" Size="12pt" Bold="True" Underline="False" />
            <BorderStyle Default="Solid" Top="None" Bottom="None" Left="None" Right="None" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Default="0.5pt" Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="3cm" Height="0.8cm" Left="7cm" Top="23.7cm" Value="البند الثامن" Culture="ar-EG" Name="textBox68">
          <Style BackgroundColor="White" TextAlign="Center" VerticalAlign="Middle">
            <Font Name="Times New Roman" Size="14pt" Bold="True" Underline="True" />
