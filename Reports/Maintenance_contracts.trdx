        </TextBox>
        <TextBox Width="3.1cm" Height="0.8cm" Left="6.9cm" Top="33cm" Value="البند الحادي عشر" Culture="ar-EG" Name="textBox20">
          <Style BackgroundColor="White" TextAlign="Center" VerticalAlign="Middle">
            <Font Name="Times New Roman" Size="14pt" Bold="True" Underline="True" />
            <BorderStyle Default="Solid" Top="None" Bottom="None" Left="None" Right="None" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Default="0.5pt" Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="15.8cm" Height="3.4cm" Left="0.6cm" Top="33.8cm" Value="يلغى هذا العقد من تلقاء نفسة في الحالات الآتية.&#xD;&#xA;١- إذا اخل الطرف الثاني بالتزاماتة الموضحة بالعقد&#xD;&#xA;٢- إذا أخلت المؤسسة ببنود العقد&#xD;&#xA;٣- إذا سمح الطرف الثاني لاى شخص غريب عن المؤسسة بأجراء اى عمل في المصاعد&#xD;&#xA;مع حفظ حقوق المؤسسة كاملة من حيث التعويض بدون إنذار&#xD;&#xA;٤- إذا لم يتم سداد قيمة اشتراك الصيانة في موعد أقصاه الخامس من كل شهر&#xD;&#xA;" CanShrink="False" Culture="ar-EG" Name="textBox21">
          <Style BackgroundColor="White" TextAlign="Left" VerticalAlign="Middle">
            <Font Name="Times New Roman" Size="12pt" Bold="True" Underline="False" />
            <BorderStyle Default="Solid" Top="None" Bottom="None" Left="None" Right="None" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Default="0.5pt" Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
