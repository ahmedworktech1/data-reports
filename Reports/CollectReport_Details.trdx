<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource1" Width="28.7cm" Name="ReportANWAR" ShowSnapGrid="True" xmlns="http://schemas.telerik.com/reporting/2021/1.0">
  <Style>
    <Font Size="10pt" />
  </Style>
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="AQDATA20191" SelectCommand="SELECT        TOP (100) PERCENT dbo.AQRENT_H.Folder_Id, dbo.AQCOLLECT_H.Due_DT, dbo.AQCOLLECT_H.Tr_NO, dbo.AQCOLLECT_H.CONTRACT_NO, dbo.BLDMF.BLD_DSCR_AR, dbo.tenantMF.TENANT_Nm_AR, &#xD;&#xA;                         dbo.AQCOLLECT_d.rmrk, CASE WHEN AQCOLLECT_D.PAYED_TY IN (1, 7, 8, 9, 99) THEN AQCOLLECT_D.MNTH_AMT ELSE 0 END AS CASH, &#xD;&#xA;                         CASE WHEN AQCOLLECT_D.PAYED_TY = 2 THEN AQCOLLECT_D.MNTH_AMT ELSE 0 END AS SHEQ, CASE WHEN AQCOLLECT_D.PAYED_TY = 3 THEN AQCOLLECT_D.MNTH_AMT ELSE 0 END AS KNTE, &#xD;&#xA;                         CASE WHEN AQCOLLECT_D.PAYED_TY IN (100) THEN AQCOLLECT_D.MNTH_AMT ELSE 0 END AS LINK, CASE WHEN AQCOLLECT_D.PAYED_TY IN (4) THEN AQCOLLECT_D.MNTH_AMT ELSE 0 END AS BINK, &#xD;&#xA;                         dbo.AQCOLLECT_H.Check_NO, dbo.AQCOLLECT_H.PAYED_AMT, CASE WHEN Contrct_State = 1 THEN 'جديد' ELSE CASE WHEN Contrct_State = 2 THEN 'مؤجر' ELSE CASE WHEN Contrct_State = 3 THEN 'تنازل' ELSE NULL &#xD;&#xA;                         END END END AS DEC, dbo.OwnerFolder.NM_AR, dbo.Earn_Records.KnetRef,&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;   concat&#xD;&#xA;  (&#xD;&#xA;    (&#xD;&#xA;      select DSCR_AR from AppCodes&#xD;&#xA;      where ID = 139 and SEQ = (&#xD;&#xA;        select UNT_TYP from UNTMF&#xD;&#xA;        where BLD_CD = AQRENT_H.BLD_CD and UNT_CD = (&#xD;&#xA;          select top 1 UNT_CD from AQRENT_D&#xD;&#xA;          where Tr_NO = dbo.AQRENT_H.Tr_NO  &#xD;&#xA;        )&#xD;&#xA;      )&#xD;&#xA;    ), &#xD;&#xA;    ' ', &#xD;&#xA;    &#xD;&#xA;    ' ',&#xD;&#xA;    (&#xD;&#xA;      SELECT STRING_AGG(UNT_NO, ', ') from UNTMF&#xD;&#xA;    where BLD_CD = AQRENT_H.BLD_CD and UNT_CD in (&#xD;&#xA;        select UNT_CD from AQRENT_D&#xD;&#xA;        where Tr_NO = dbo.AQRENT_H.Tr_NO  &#xD;&#xA;      )&#xD;&#xA;    )&#xD;&#xA;  ) as Unts_Dscrs&#xD;&#xA;&#xD;&#xA;FROM            dbo.AQCOLLECT_H INNER JOIN&#xD;&#xA;                         dbo.AQRENT_H ON dbo.AQCOLLECT_H.CONTRACT_NO = dbo.AQRENT_H.Tr_NO AND dbo.AQCOLLECT_H.TENANT_NO = dbo.AQRENT_H.TENANT_NO INNER JOIN&#xD;&#xA;                         dbo.BLDMF ON dbo.AQCOLLECT_H.BLD_CD = dbo.BLDMF.BLD_CD INNER JOIN&#xD;&#xA;                         dbo.tenantMF ON dbo.AQCOLLECT_H.TENANT_NO = dbo.tenantMF.TENANT_NO INNER JOIN&#xD;&#xA;                         dbo.OwnerFolder ON dbo.AQRENT_H.Folder_Id = dbo.OwnerFolder.Folder_ID INNER JOIN&#xD;&#xA;                         dbo.AQCOLLECT_D ON dbo.AQCOLLECT_H.Tr_NO = dbo.AQCOLLECT_D.TR_NO AND dbo.AQCOLLECT_H.CONTRACT_NO = dbo.AQCOLLECT_D.CONTRACT_NO INNER JOIN&#xD;&#xA;                         dbo.Earn_Records ON dbo.AQCOLLECT_H.CONTRACT_NO = dbo.Earn_Records.TR_NO AND dbo.AQCOLLECT_H.Mnth = dbo.Earn_Records.MNTH AND dbo.AQCOLLECT_H.YR = dbo.Earn_Records.YR&#xD;&#xA;WHERE        (dbo.AQCOLLECT_H.PAYED_AMT &gt; 0)&#xD;&#xA;ORDER BY dbo.AQRENT_H.Folder_Id, dbo.AQCOLLECT_H.Due_DT, dbo.AQCOLLECT_H.Tr_NO" Name="sqlDataSource1" />
  </DataSources>
