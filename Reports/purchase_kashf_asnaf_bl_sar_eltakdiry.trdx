  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="azxsandoaa" SelectCommand="&#xD;&#xA;SELECT&#xD;&#xA;    AZTRd.LN_NO,&#xD;&#xA;    azitms.itm_nm_ar AS 'اسم الصنف',&#xD;&#xA;    AZTRD.RMRK2 AS 'مواصفات المنتج',&#xD;&#xA;    AZTRd.TR_DT,&#xD;&#xA;    AZTRD.RMRK3 AS 'مواصفات قياسيه',&#xD;&#xA;    AZTRd.ITM_CD,&#xD;&#xA;    AZTRd.PKPRC AS PKPRC,&#xD;&#xA;    --CAST(aztrd.QTY * AZTRd.PKPRC AS INT)&#xD;&#xA;    aztrh.LTOT,&#xD;&#xA;    aztrh.PURCHAS_NO,&#xD;&#xA;    AZTRd.QTY,&#xD;&#xA;    AZTRd.RMRK1,&#xD;&#xA;    AZTRd.ENTEREDBY,&#xD;&#xA;    AZPKGDEF.pk_nm_ar AS 'اسم الوحدة',&#xD;&#xA;    azlists.dscr_ar AS 'اسم الجهة الطالبة',&#xD;&#xA;    AZTRd.LOC,&#xD;&#xA;    AZTRd.TR_TY,&#xD;&#xA;    AZTRd.TR_NO,&#xD;&#xA;    FNCL_TR_NO,&#xD;&#xA;    aztrd.QTY * AZTRd.PKPRC AS kemaa,&#xD;&#xA;    AZTRD.RMRK AS ملاحظات&#xD;&#xA;FROM AZTRd&#xD;&#xA;LEFT JOIN azitms    ON azitms.itm_cd = AZTRd.itm_cd&#xD;&#xA;LEFT JOIN AZPKGDEF  ON AZPKGDEF.pkid = AZTRd.pkid&#xD;&#xA;LEFT JOIN azlists   ON azlists.code = AZTRd.CAROWNER AND azlists.REC_TYPE = '2'&#xD;&#xA;LEFT JOIN AZTRH     ON AZTRd.LOC = AZTRH.LOC&#xD;&#xA;                   AND AZTRd.TR_TY = AZTRH.TR_TY&#xD;&#xA;                   AND AZTRd.TR_NO = AZTRH.TR_NO&#xD;&#xA;WHERE AZTRd.TR_TY = '101' AND (1 = 1)" Name="sqlDataSource2" />
  </DataSources>
