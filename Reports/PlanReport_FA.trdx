  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="glx2023tarheel" SelectCommand="select &#xD;&#xA;TR_TY,(select DSCR_AR from AppCodes where id='1007' and SEQ=TR_TY)  as trNM,&#xD;&#xA;ItmCd,(select DSCR_AR from AppCodes where id='1006' and SEQ=ItmCd) as itm_NM&#xD;&#xA;,PKID,(select PK_NM_AR from GLPKGDEF where PKID=FA_PROJECTS_DETAILS.PKID) as pkNm&#xD;&#xA;,PRICE,QTY,Total,PERMISSION_NO,PERMISSION_DT&#xD;&#xA;&#xD;&#xA;from FA_PROJECTS_DETAILS where ProjNo='-99991' and TR_TY='1'&#xD;&#xA;union all&#xD;&#xA;select&#xD;&#xA;TR_TY,(select DSCR_AR from AppCodes where id='1007' and SEQ=TR_TY)  as trNM,&#xD;&#xA;ItmCd,(select DSCR_AR from AppCodes where id='1006' and SEQ=ItmCd) as itm_NM&#xD;&#xA;,PKID,(select PK_NM_AR from GLPKGDEF where PKID=FA_PROJECTS_DETAILS.PKID) as pkNm&#xD;&#xA;,PRICE,(QTY*-1) as qty ,(Total*-1) as total,PERMISSION_NO,PERMISSION_DT&#xD;&#xA;&#xD;&#xA;from FA_PROJECTS_DETAILS where ProjNo='-99991' and TR_TY='101'&#xD;&#xA;union all&#xD;&#xA;select &#xD;&#xA;TR_TY,(select DSCR_AR from AppCodes where id='1007' and SEQ=TR_TY) as trNM,&#xD;&#xA;ItmCd,NULL as itm_NM&#xD;&#xA;,PKID,(select PK_NM_AR from GLPKGDEF where PKID=FA_PROJECTS_DETAILS.PKID) as pkNm&#xD;&#xA;,(0) as PRICE,(0) as QTY,Total,PERMISSION_NO,PERMISSION_DT&#xD;&#xA;&#xD;&#xA;from FA_PROJECTS_DETAILS where ProjNo='-99991' and TR_TY='2'&#xD;&#xA;union all&#xD;&#xA;select &#xD;&#xA;TR_TY,(select DSCR_AR from AppCodes where id='1007' and SEQ=TR_TY) as trNM,&#xD;&#xA;ItmCd,NULL as itm_NM&#xD;&#xA;,PKID,(select PK_NM_AR from GLPKGDEF where PKID=FA_PROJECTS_DETAILS.PKID) as pkNm&#xD;&#xA;,(0) as PRICE,(0) as QTY,(Total*-1)as total,PERMISSION_NO,PERMISSION_DT&#xD;&#xA;&#xD;&#xA;from FA_PROJECTS_DETAILS where ProjNo='-99991' and TR_TY='102'&#xD;&#xA;union all&#xD;&#xA;select &#xD;&#xA;TR_TY,(select DSCR_AR from AppCodes where id='1007' and SEQ=TR_TY) as trNM,&#xD;&#xA;ItmCd,NULL as itm_NM&#xD;&#xA;,PKID,(select PK_NM_AR from GLPKGDEF where PKID=FA_PROJECTS_DETAILS.PKID) as pkNm&#xD;&#xA;,(0) as PRICE,(0) as QTY,Total,PERMISSION_NO,PERMISSION_DT&#xD;&#xA;&#xD;&#xA;from FA_PROJECTS_DETAILS where ProjNo='-99991' and TR_TY='4'&#xD;&#xA;union all&#xD;&#xA;select &#xD;&#xA;TR_TY,(select DSCR_AR from AppCodes where id='1007' and SEQ=TR_TY) as trNM,&#xD;&#xA;ItmCd,NULL as itm_NM&#xD;&#xA;,PKID,(select PK_NM_AR from GLPKGDEF where PKID=FA_PROJECTS_DETAILS.PKID) as pkNm&#xD;&#xA;,(0) as PRICE,(0) as QTY,(Total*-1)as total,PERMISSION_NO,PERMISSION_DT&#xD;&#xA;&#xD;&#xA;from FA_PROJECTS_DETAILS where ProjNo='-99991' and TR_TY='103'&#xD;&#xA;union all&#xD;&#xA;select &#xD;&#xA;TR_TY,(select DSCR_AR from AppCodes where id='1007' and SEQ=TR_TY) as trNM,&#xD;&#xA;ItmCd,NULL as itm_NM&#xD;&#xA;,PKID,(select PK_NM_AR from GLPKGDEF where PKID=FA_PROJECTS_DETAILS.PKID) as pkNm&#xD;&#xA;,(0) as PRICE,(0) as QTY,Total,PERMISSION_NO,PERMISSION_DT&#xD;&#xA;&#xD;&#xA;from FA_PROJECTS_DETAILS where ProjNo='-99991' and TR_TY='3'&#xD;&#xA;union all&#xD;&#xA;select &#xD;&#xA;TR_TY,(select DSCR_AR from AppCodes where id='1007' and SEQ=TR_TY) as trNM,&#xD;&#xA;ItmCd,NULL as itm_NM&#xD;&#xA;,PKID,(select PK_NM_AR from GLPKGDEF where PKID=FA_PROJECTS_DETAILS.PKID) as pkNm&#xD;&#xA;,(0) as PRICE,(0) as QTY,(Total*-1) as total,PERMISSION_NO,PERMISSION_DT&#xD;&#xA;&#xD;&#xA;from FA_PROJECTS_DETAILS where ProjNo='-99991' and TR_TY='104'&#xD;&#xA;&#xD;&#xA;" Name="sqlDataSource1" />
