<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource1" Width="17cm" Name="مذكرة عرض علي السيد رئيس مجلس إدارة الصندوق" xmlns="http://schemas.telerik.com/reporting/2023/1.0">
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="azxsandoaa" SelectCommand=";WITH SplitSuppliers AS (&#xA;    SELECT &#xA;        A.TR_NO,&#xA;        LTRIM(RTRIM(value)) AS ACC_NO_SINGLE&#xA;    FROM AZTRH A&#xA;    CROSS APPLY STRING_SPLIT(A.ACC_NO2, ',')&#xA;    WHERE A.TR_TY = '119'&#xA;),&#xA;&#xA;Suppliers AS (&#xA;    SELECT &#xA;        S.TR_NO,&#xA;        ACC.Acc_Nm_AR AS SupplierName,&#xA;        ROW_NUMBER() OVER (PARTITION BY S.TR_NO ORDER BY ACC.Acc_Nm_AR) AS rn&#xA;    FROM SplitSuppliers S&#xA;    LEFT JOIN AZACCMF ACC &#xA;        ON ACC.Acc_NO = S.ACC_NO_SINGLE&#xA;    WHERE ACC.Acc_Nm_AR IS NOT NULL&#xA;),&#xA;&#xA;FinalSuppliers AS (&#xA;    SELECT &#xA;        TR_NO,&#xA;        MAX(CASE WHEN rn = 1 THEN SupplierName END) AS Supplier1,&#xA;        MAX(CASE WHEN rn = 2 THEN SupplierName END) AS Supplier2,&#xA;        MAX(CASE WHEN rn = 3 THEN SupplierName END) AS Supplier3&#xA;    FROM Suppliers&#xA;    GROUP BY TR_NO&#xA;)&#xA;&#xA;SELECT DISTINCT&#xA;    AZTRH.FNCL_TR_NO,&#xA;    AZTRH.PURCHAS_NO,   -- ✅ إضافة&#xA;    AZTRH.Acc_Nm,&#xA;    AZTRH.tr_dt,&#xA;    AZTRH.RMRK1,&#xA;    AZTRH.LTOT AS Total_LTOT,&#xA;&#xA;    STRING_AGG(CAST(AZTRD.SAL_DISC_PRCNT AS NVARCHAR), N' - ') AS SAL_DISC_PRCNT,&#xA;    STRING_AGG(AZTRD.RMRK4, N' - ') AS RMRK4,&#xA;    STRING_AGG(CAST(AZTRD.PRCHS_DISC_PRCNT AS NVARCHAR), N' - ') AS PRCHS_DISC_PRCNT,&#xA;    STRING_AGG(CAST(AZTRD.INC_PRCNT AS NVARCHAR), N' - ') AS INC_PRCNT,&#xA;&#xA;    FinalSuppliers.Supplier1,&#xA;    FinalSuppliers.Supplier2,&#xA;    FinalSuppliers.Supplier3&#xA;&#xA;FROM AZTRH &#xA;&#xA;LEFT JOIN AZTRD  &#xA;    ON AZTRD.TR_NO = AZTRH.TR_NO&#xA;   AND AZTRD.TR_TY = AZTRH.TR_TY&#xA;   AND AZTRD.LOC   = AZTRH.LOC&#xA;&#xA;LEFT JOIN FinalSuppliers&#xA;    ON FinalSuppliers.TR_NO = AZTRH.TR_NO&#xA;&#xA;WHERE AZTRH.TR_TY = '119'&#xA;  AND (1=1)&#xA;&#xA;GROUP BY &#xA;    AZTRH.FNCL_TR_NO,&#xA;    AZTRH.PURCHAS_NO,&#xA;    AZTRH.Acc_Nm,&#xA;    AZTRH.tr_dt,&#xA;    AZTRH.RMRK1,&#xA;    AZTRH.LTOT,&#xA;    FinalSuppliers.Supplier1,&#xA;    FinalSuppliers.Supplier2,&#xA;    FinalSuppliers.Supplier3;" Name="sqlDataSource1" />
  </DataSources>
