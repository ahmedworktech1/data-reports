<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource1" Width="27.5cm" Name="QueryGlJrnl1" xmlns="http://schemas.telerik.com/reporting/2021/1.0">
  <Style>
    <BorderColor Bottom="Black" />
  </Style>
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="glx2024" SelectCommand="WITH AggregatedData AS (&#xA;    SELECT &#xA;        GLJRNLD.scst_cd,&#xA;        GLJRNLD.COM_ID,&#xA;        SUM(CASE &#xA;            WHEN acc_no LIKE '4[6-8]11210[1-5]%' THEN db_vl - cr_vl &#xA;            ELSE 0 &#xA;        END) AS s1,&#xA;        SUM(CASE &#xA;            WHEN acc_no LIKE '4[6-8]1123[13]%' THEN db_vl - cr_vl &#xA;            ELSE 0 &#xA;        END) AS s2,&#xA;        SUM(CASE &#xA;            WHEN acc_no LIKE '4[6-8]211104%' THEN db_vl - cr_vl &#xA;            ELSE 0 &#xA;        END) AS s3,&#xA;        SUM(CASE &#xA;            WHEN acc_no LIKE '4[6-8]1132%' THEN db_vl - cr_vl &#xA;            ELSE 0 &#xA;        END) AS s4,&#xA;        SUM(CASE &#xA;            WHEN acc_no LIKE '4[6-8]2182202%' THEN db_vl - cr_vl &#xA;            ELSE 0 &#xA;        END) AS s5,&#xA;        SUM(CASE &#xA;            WHEN acc_no LIKE '4[6-8]2182201%' THEN db_vl - cr_vl &#xA;            ELSE 0 &#xA;        END) AS s6,&#xA;        SUM(CASE &#xA;            WHEN acc_no LIKE '4[6-8]2602%' THEN db_vl - cr_vl &#xA;            ELSE 0 &#xA;        END) AS s7,&#xA;        SUM(&#xA;            CASE &#xA;                WHEN acc_no LIKE '4[6-8]11210[1-5]%' OR &#xA;                     acc_no LIKE '4[6-8]1123[13]%' OR &#xA;                     acc_no LIKE '4[6-8]211104%' OR &#xA;                     acc_no LIKE '4[6-8]1132%' OR &#xA;                     acc_no LIKE '4[6-8]218220[12]%' OR &#xA;                     acc_no LIKE '4[6-8]2602%' OR &#xA;                     acc_no LIKE '4[6-8]48302%' &#xA;                THEN db_vl - cr_vl &#xA;                ELSE 0 &#xA;            END&#xA;        ) AS tot&#xA;    FROM GLJRNLD &#xA;    WHERE &#xA;        acc_no LIKE '4[6-8]%' &#xA;        AND (scst_cd LIKE '113%' OR scst_cd LIKE '114%') and (1=1)&#xA;    GROUP BY &#xA;        GLJRNLD.scst_cd, GLJRNLD.COM_ID&#xA;)&#xA;SELECT &#xA;    main.scst_cd,&#xA;    main.COM_ID,&#xA;    main.s1, main.s2, main.s3, main.s4, main.s5, main.s6, main.s7, main.tot,&#xA;    glScst.Scst_nm_ar AS Scst_nm,&#xA;    glScst.PLT_NO AS pltno,&#xA;    glScst.MOT_NO AS motor,&#xA;    glScst.CHS_NO AS chsno,&#xA;    glLoc.unt_nm_ar AS untnm&#xA;FROM AggregatedData main&#xA;left JOIN glScst ON main.scst_cd = glScst.Scst_cd&#xA;left JOIN glLoc ON main.COM_ID = glLoc.UNT_CD&#xA;ORDER BY main.COM_ID, main.scst_cd;&#xA;" Name="sqlDataSource1" />
  </DataSources>
