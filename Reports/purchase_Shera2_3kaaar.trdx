            <Font Size="12pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="9.7cm" Height="0.4cm" Left="8.438cm" Top="6.635cm" Value="أقر الطرف الثاني بأنه مالك للعقار محل هذا العقد وأن ملكيته له قد آلت إليه بموجب " Name="textBox97">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="4.9cm" Height="0.4cm" Left="13.238cm" Top="7.435cm" Value="11-  أدخل اسم السلطة المختصة وصفتها الوظيفية." Name="textBox98">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="7.4cm" Height="0.4cm" Left="10.738cm" Top="7.935cm" Value="12- أدخل اسم المفوض عن السلطة المختصة وصفته الوظيفية." Name="textBox99">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="4.9cm" Height="0.4cm" Left="13.238cm" Top="8.435cm" Value="13-  أدخل اسم السلطة المختصة وصفتها الوظيفية." Name="textBox100">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="15.4cm" Height="0.4cm" Left="2.738cm" Top="8.935cm" Value="14- لا يجوز للسلطة المختصة التفويض في التعاقد بطريق الاتفاق المباشر وذلك طبقاً لحكم المادة (64) من قانون تنظيم التعاقدات التي  " Name="textBox101">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="7.147cm" Height="0.4cm" Left="11.038cm" Top="9.459cm" Value="تبرمها الجهات العامة الصادر بالقانون رقم 182 لسنة 2018." Name="textBox82">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="11.6cm" Height="0.4cm" Left="6.538cm" Top="9.959cm" Value="15-  أدخل اسم العملية كما ورد بالإعلان/الدعوة/طلب عرض السعر، وبكراسة الشروط والمواصفات." Name="textBox102">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="15.5cm" Height="0.4cm" Left="2.638cm" Top="10.459cm" Value="16-  إذا لم يستخدم أي من هذه الملاحق تضاف عبارة (غير مستخدم) قرين كل ملحق وعلى الصفحة المرفقة التي تحمل عنوان الملحق." Name="textBox103">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="9.7cm" Height="0.4cm" Left="8.438cm" Top="10.959cm" Value="17 -  يجب أن تكون كافة الملاحق وفقاً لما تضمنته كراسة الشروط والمواصفات." Name="textBox104">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="15.9cm" Height="0.4cm" Left="2.238cm" Top="13.535cm" Value="أقر الطرف الثانى أن العقار محل هذا العقد خال من كافة الحقوق العينية أياً كان نوعها كالرهن والاختصاص والوقف والحكر حقوق الانتفاع والارتفاق ظاهرة" Name="textBox105">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="14.2cm" Height="0.4cm" Left="3.938cm" Top="14.035cm" Value="والارتفاق ظاهرة أو خفية كما يقر أنه حائز لهذا العقار دون منازعة وبصفة ظاهرة وغير متقطعة ولم يسبق له التصرف فيه." Name="textBox106">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="14.9cm" Height="0.4cm" Left="3.238cm" Top="14.535cm" Value="ويضمن الطرف الثانى العقار محل هذا العقد ضماناً كاملاً من أى عيوب خفية سواء كانت قانونية أو مادية ويقر بمسئوليته عن ذلك." Name="textBox107">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="15.1cm" Height="0.4cm" Left="3.038cm" Top="15.035cm" Value="وفى حالة مخالفة الطرف الثانى لأى مما جاء بهذا البند يحق للطرف الأول اتخاذ الإجراءات المنصوص عليها بالبند الحادى والعشرون " Name="textBox108">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="1.7cm" Height="0.4cm" Left="16.438cm" Top="15.535cm" Value="من هذا العقد." Name="textBox109">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="2cm" Height="0.4cm" Left="9.238cm" Top="16.335cm" Value="البند الخامس" Name="textBox110">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Size="12pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="15.9cm" Height="0.4cm" Left="2.238cm" Top="16.935cm" Value="أقر الطرف الثانى بسلامة العقار محل هذا العقد بالكامل وموافقته على تنفيذ أو إدخال أى تعديلات أو أعمال إضافية عليه قد يطلبها الطرف" Name="textBox111">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="15.9cm" Height="0.4cm" Left="2.238cm" Top="17.435cm" Value="الأول توجيهاً للمسئولية، وأنه ملتزم بتنفيذ هذه الأعمال وفقاً لتعليمات الجهات الفنية المختصة ويلتزم الطرف الأول بمحاسبة الطرف الثانى استرشاداً بأسعار السوق." Name="textBox112">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="3cm" Height="0.4cm" Left="15.138cm" Top="17.935cm" Value="استرشاداً بأسعار السوق." Name="textBox113">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="15.9cm" Height="0.4cm" Left="2.238cm" Top="18.435cm" Value="ويحق للطرف الأول الرجوع على الطرف الثانى بالتعويض عن أية أضرار تترتب نتيجة عدم سلامة محل هذا العقد أو عن تعرض الغير له أو أى " Name="textBox114">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="6cm" Height="0.4cm" Left="12.138cm" Top="18.935cm" Value="عن تعرض الغير له أو أى عيب خفى أو غير ذلك." Name="textBox115">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="14.2cm" Height="0.4cm" Left="3.938cm" Top="20.235cm" Value="باع وأسقط وتنازل بكافة الضمانات الفعلية والقانونية الطرف الثانى البائع إلى الطرف الأول المشترى العقار المباع" Name="textBox116">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="2cm" Height="0.4cm" Left="9.238cm" Top="19.635cm" Value="البند السادس" Name="textBox117">
