            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="4.039cm" Height="0.4cm" Left="14.099cm" Top="1.311cm" Value="بين الطرفين ومحاضر ( لجنة البت " Name="textBox84">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="0.7cm" Height="0.4cm" Left="6.304cm" Top="1.308cm" Value="لسنة " Name="textBox85">
