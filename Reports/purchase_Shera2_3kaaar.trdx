        </TextBox>
        <TextBox Width="2cm" Height="0.4cm" Left="9.238cm" Top="2.811cm" Value="البند الثاني" Name="textBox89">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Size="12pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="7.1cm" Height="0.4cm" Left="11.038cm" Top="3.411cm" Value="تعتبر الملاحق التالية والمرفقة بهذا العقد جزءاً لا يتجزأ منه: " Name="textBox90">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
