        </TextBox>
        <TextBox Width="16.2cm" Height="0.4cm" Left="1.097cm" Top="0.746cm" Value="يعتبر التمهيد السابق وكراسة الشروط والمواصفات و( العطاء /  العرض) المقدم من الطرف الثاني، وكافة المكاتبات والمستندات المتبادلة بين " Name="textBox83">
