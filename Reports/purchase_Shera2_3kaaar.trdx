        </TextBox>
        <TextBox Width="4.2cm" Height="0.4cm" Left="13.938cm" Top="3.911cm" Value="ملحق (1): وصف موضوع العقد." Name="textBox91">
          <Style TextAlign="Left" VerticalAlign="Middle">
