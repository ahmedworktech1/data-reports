            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="1.9cm" Height="0.4cm" Left="12.338cm" Top="20.735cm" Value="متراً مربعاَ ) ." Name="textBox119">
          <Style TextAlign="Left" VerticalAlign="Middle">
