        <TextBox Width="6.5cm" Height="0.4cm" Left="7.038cm" Top="1.811cm" Value="جزءا لا بتجزأ من هذا العقد ومتمما ومكملا لأحكامه ." Name="textBox88">
          <Style TextAlign="Left" VerticalAlign="Middle">
