        <TextBox Width="16.247cm" Height="0.4cm" Left="2cm" Top="34.738cm" Value="وفعالية ويضمن اتنظام سير العمل, ووفقاُ لما تم تخصيصه من اعتمادات مالية , وحيث أبدي الطرف الثاني استعداده للقيام بذلك وإتمامه وفقاً" Name="textBox47">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="6.047cm" Height="0.4cm" Left="12.4cm" Top="34.238cm" Value="* حيث أن الطرف الأول أبدى رغبته في التعاقد على شراء" Name="textBox48">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="7.347cm" Height="0.4cm" Left="2cm" Top="34.238cm" Value="وذلك بغرض تلبية احتياجاته بما يمكنه من تحقيق أهدافه بكفاءة" Name="textBox49">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="1.047cm" Height="0.4cm" Left="10.1cm" Top="33.538cm" Value="تمهيد" Name="textBox50">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="11pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.247cm" Height="0.4cm" Left="2cm" Top="35.238cm" Value="للشروط والمواصفات وأية متطلبات أخري وكما هو منصوص عليه بكراسة الشروط والمواصفات و ( العطاء / العرض ) المقدم منه , والذي" Name="textBox51">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="2.447cm" Height="0.4cm" Left="15.8cm" Top="35.738cm" Value="قبله الطرف الاول . " Name="textBox52">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="11.947cm" Height="0.4cm" Left="6.5cm" Top="40cm" Value="7- أدخل التصنيف ويقصد بذلك (شركة كبيرة / مشروع متوسط/مشروع صغير/مشروع متناهي الصغر)." Name="textBox53">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="13.247cm" Height="0.4cm" Left="5.2cm" Top="40.5cm" Value="8- التليفون والفاكس والبريد الالكتروني بيانات أساسية يتعين استيفاءها ليتم إرسال إخطارات الطرف الثاني عليها . " Name="textBox54">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="11.347cm" Height="0.4cm" Left="7.1cm" Top="41cm" Value="9- أدخل اسم العملية كما ورد بالإعلان/الدعوة/طلب عرض السعر, وبكراسة الشروط والمواصفات ." Name="textBox55">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="13.647cm" Height="0.4cm" Left="4.8cm" Top="41.5cm" Value="10- مع مراعاة ما اذا كان طبيعة العملية تتطلب اعداد كراسة شروط ومواصفات في حلاة التعاقد بالاتفاق المباشر ." Name="textBox56">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="11.9cm" Height="0.4cm" Left="6.5cm" Top="36.4cm" Value="ـــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــــ" Name="textBox57">
