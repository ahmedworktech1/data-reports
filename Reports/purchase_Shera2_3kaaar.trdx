        <TextBox Width="4cm" Height="0.4cm" Left="14.138cm" Top="4.411cm" Value="ملحق (2): الاشتراطات الخاصة." Name="textBox92">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="4.2cm" Height="0.4cm" Left="13.938cm" Top="4.911cm" Value="ملحق (3): التزامات طرفي التعاقد." Name="textBox93">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="3.3cm" Height="0.4cm" Left="14.838cm" Top="5.411cm" Value="ملحق (4): كشف المساحة." Name="textBox94">
