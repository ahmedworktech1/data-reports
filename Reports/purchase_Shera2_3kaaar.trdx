            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="11.9cm" Height="0.4cm" Left="6.238cm" Top="25.835cm" Value="(إذا كان الطرف الأول قد قام بسداد دفعة مقدمة، يكون البند على النحو التالى وتستكمل المطلوبة فيه .)" Name="textBox143">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.2cm" Height="0.4cm" Left="2.097cm" Top="48.009cm" Value="الثاني حال تقاعس الطرف الأول عن الاستلام التقدم بطلب للسلطة المختصة لتشكيل لجنة محايدة لدراسة أسباب التقاعس , وصورة منه لمكتب" Name="textBox144">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="3.047cm" Height="0.4cm" Left="15.138cm" Top="25.235cm" Value=" وبإجمالى مبلغ مقداره (" Name="textBox145">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="1.9cm" Height="0.4cm" Left="10.538cm" Top="25.235cm" Value=") (فقط وقدره" Name="textBox146">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="0.6cm" Height="0.4cm" Left="1.238cm" Top="25.235cm" Value=")" Name="textBox147">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="6cm" Height="0.4cm" Left="12.138cm" Top="26.435cm" Value="قام الطرف الأول بسداد دفعة بمبلغ إجمالي مقداره (" Name="textBox148">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="2.2cm" Height="0.4cm" Left="15.938cm" Top="27.035cm" Value="بما يعادل نسبة (" Name="textBox149">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="1.8cm" Height="0.4cm" Left="8.185cm" Top="26.435cm" Value=") (فقط وقدره" Name="textBox150">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="0.6cm" Height="0.4cm" Left="1.238cm" Top="26.435cm" Value=")" Name="textBox151">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="7.8cm" Height="0.4cm" Left="4.538cm" Top="27.035cm" Value="% ) من قيمة التعاقد مقابل خطاب ضمان بنكي معتمد صادر من بنك " Name="textBox152">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="9.4cm" Height="0.4cm" Left="8.738cm" Top="27.635cm" Value="وغير مقترن بأي قيد أو شرط بالقيمة ذاتهما قدمة الطرف الثاني للطرف الأول ." Name="textBox153">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="2cm" Height="0.4cm" Left="9.238cm" Top="28.835cm" Value="البند الثامن" Name="textBox154">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Size="12pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="5.447cm" Height="0.4cm" Left="12.738cm" Top="29.535cm" Value="قام الطرف الأول بحجز مبلغاً إجمالياً مقداره (" Name="textBox155">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.2cm" Height="0.4cm" Left="2.097cm" Top="30.035cm" Value="ما يعادل نسبة (3%) من إجمالى هذا العقد كتأمين نهائى، ويظل هذا التأمين سارياً طوال مدة العقد بما فيها مدة الضمان، وعلى الطرف الأول" Name="textBox156">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="1.8cm" Height="0.4cm" Left="8.185cm" Top="29.535cm" Value=") (فقط وقدره" Name="textBox157">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="0.6cm" Height="0.4cm" Left="1.238cm" Top="29.535cm" Value=")" Name="textBox158">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.2cm" Height="0.4cm" Left="2.097cm" Top="30.535cm" Value="رد ما قام بحجزه فور تسجيل محل هذا العقد أو مضى عام من تاريخ تسلمه أيهما أبعد لمواجهة إصلاح أى عيوب قد تظهر خلال هذه المدة." Name="textBox159">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="2cm" Height="0.4cm" Left="9.238cm" Top="35.935cm" Value="البند التاسع" Name="textBox160">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Size="12pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.2cm" Height="0.4cm" Left="2.097cm" Top="59.876cm" Value="عن فترة التأخير وفقاً لسعر الائتمان والخصم المعلن من البنك المركزي وقت المحاسبة شريطة تقديم الطرف الثاني مستندات رسمية بالمبلغ" Name="textBox161">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.2cm" Height="0.4cm" Left="2.097cm" Top="32.735cm" Value="18- يستخدم قياس المتر المربع فى حالة الأراضى الصناعية أو المبانى، أما قياس (سهم/قيراط/فدان) فى حالة الأراضى الزراعية أو المعدة " Name="textBox162">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="2.647cm" Height="0.4cm" Left="15.538cm" Top="33.235cm" Value="للاستصلاح الزراعى." Name="textBox163">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="11.347cm" Height="0.4cm" Left="6.838cm" Top="33.735cm" Value="19- يستخدم هذا فى حالة ما إذا كانت قد تضمنت كراسة الشروط والمواصفات صرف دفعة مقدمة." Name="textBox164">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.247cm" Height="0.4cm" Left="2.097cm" Top="34.235cm" Value="20- أدخل النسبة وفقاً لما ورد بالمادة (92) من اللائحة التنفيذية، ومراعاة النسبة المخصصة للمشروعات المتوسطة والصغيرة والمتناهية " Name="textBox165">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="1.2cm" Height="0.4cm" Left="16.938cm" Top="34.735cm" Value="الصغر ." Name="textBox166">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.247cm" Height="0.4cm" Left="2.097cm" Top="36.535cm" Value="أقر الطرف الأول بأنه عاين محل هذا العقد المعاينة التامة النافية للجهالة شرعاً ووجده بحالة تناسبه ولا يوجد به ما يحول دون شرائه، وأنه " Name="textBox167">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="3.3cm" Height="0.4cm" Left="14.838cm" Top="37.035cm" Value="بل امتلاكه بحالته الراهنة." Name="textBox168">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="4.2cm" Height="0.4cm" Left="13.938cm" Top="38.735cm" Value="كلف الطرف الأول ( السيد/ السيدة)" Name="textBox169">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.247cm" Height="0.4cm" Left="2.097cm" Top="47.509cm" Value="يلتزم الطرف الأول باستلام العقار محل هذا العقد في المواعيد المحددة , وذلك حال مطابقته للمواصفات والشروط المتفق عليها , ويحق للطرف" Name="textBox170">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="2cm" Height="0.4cm" Left="9.238cm" Top="37.735cm" Value="البند العاشر" Name="textBox171">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Size="12pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.247cm" Height="0.4cm" Left="2.097cm" Top="38.235cm" Value="أقر الطرف الأول بأنه عاين محل هذا العقد المعاينة التامة النافية للجهالة شرعاً ووجده بحالة تناسبه ولا يوجد به ما يحول دون شرائه، وأنه " Name="textBox172">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="3cm" Height="0.4cm" Left="8.738cm" Top="38.735cm" Value="بصفته/ بصفتها الوظيفية" Name="textBox173">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="2.4cm" Height="0.4cm" Left="15.738cm" Top="39.235cm" Value="بموجب القرار رقم" Name="textBox174">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="1.4cm" Height="0.4cm" Left="10.338cm" Top="39.235cm" Value="الصادر فى" Name="textBox175">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="4.7cm" Height="0.4cm" Left="13.438cm" Top="39.735cm" Value=" مسئولا / مسئولة عن ادارة هذا العقد . " Name="textBox176">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="7.9cm" Height="0.4cm" Left="10.238cm" Top="41.235cm" Value="يلتزم الطرف الثانى بتسليم محل هذا العقد صالح للاستخدام خلال مدة" Name="textBox177">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="3.3cm" Height="0.4cm" Left="8.438cm" Top="40.735cm" Value="البند الحادي عشر" Name="textBox178">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Size="12pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="5.247cm" Height="0.4cm" Left="12.938cm" Top="48.568cm" Value="شكاوي التعاقدات العمومية وذلك للمتابعة ." Name="textBox179">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="2.8cm" Height="0.4cm" Left="15.338cm" Top="43.476cm" Value="حدد الطرف الأول يوم" Name="textBox180">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="5.2cm" Height="0.4cm" Left="12.938cm" Top="41.835cm" Value="تبدا من (اليوم التالي لاخطاره بامر الاسناد /" Name="textBox181">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="7.7cm" Height="0.4cm" Left="2.638cm" Top="41.835cm" Value=") وفقا للمتطلبات المنصوص عليها بكراسة الشروط والمواصفات ." Name="textBox182">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="3.3cm" Height="0.4cm" Left="8.438cm" Top="42.943cm" Value="البند الثاني عشر" Name="textBox183">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Size="12pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="1.1cm" Height="0.4cm" Left="11.938cm" Top="43.476cm" Value="الموافق" Name="textBox184">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="2.1cm" Height="0.4cm" Left="5.338cm" Top="43.476cm" Value="في تمام الساعة" Name="textBox185">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.247cm" Height="0.4cm" Left="2.097cm" Top="44.102cm" Value="موعداً لانعقاد اجتماع لحنة استلام محل هذا العقد , وإذا رفضت اللجنة الاستلام لوجود نقص أو مخالفة للمواصفات أو المتطلبات وجب علي " Name="textBox186">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="6.6cm" Height="0.4cm" Left="11.538cm" Top="44.676cm" Value="الطرف الأول إخطار الطرف الثاني بأسباب الرفض كتابة . " Name="textBox187">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="7.008cm" Height="0.4cm" Left="11.204cm" Top="45.169cm" Value="ويلتزك الطرف الثاني بتلافي أية ملاحظات خلال مدة لا تجاوز" Name="textBox189">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="10.027cm" Height="0.4cm" Left="8.185cm" Top="45.743cm" Value="للطرف الأول اتخاذ الإجراءات المنصوص عليها بالبند الخادي والعشرون من هذا العقد . " Name="textBox188">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="7.008cm" Height="0.4cm" Left="2.097cm" Top="45.169cm" Value="من تاريخ اليوم التالي لإخطاره , فإذا تأخر في ذلك فيحق" Name="textBox190">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="3.3cm" Height="0.4cm" Left="8.438cm" Top="46.943cm" Value="البند الثالث عشر" Name="textBox191">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Size="12pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="3.3cm" Height="0.4cm" Left="8.438cm" Top="49.609cm" Value="البند الرابع عشر" Name="textBox192">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Size="12pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="9.953cm" Height="0.4cm" Left="8.185cm" Top="50.65cm" Value="توفير كافة المستندات اللازمة لإجراءات نقل الملكية وتذليل أية عقبات تحول دون ذلك ." Name="textBox195">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.247cm" Height="0.4cm" Left="2.097cm" Top="50.15cm" Value="يلتزم الطرف الأول باتخاذ إجراءات نقل الملكية لمحل هذا العقد وذلك بالتزامن مع سداد كامل القيمة الإجمالية للعقد ويتعين علي الطرف الثاني توفير" Name="textBox194">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="15.547cm" Height="0.4cm" Left="2.638cm" Top="52.276cm" Value="إذا تأخر الطرف الثاني في نتفيذ هذا العقد عن الميعاد المحدد به لأسباب خارجة عن إرادتة يجوز للطرف الأول اعطائه مهلة بما لا يجاوز" Name="textBox193">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="13.688cm" Height="0.4cm" Left="2.097cm" Top="52.835cm" Value="من المدة الأصلية للتنفيذ دون توقيع مقابل تأخيرة , وفي حالة تأخره لأسباب راجعه إليه فيوقع عليه مقابل تأخير يحسب" Name="textBox196">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.321cm" Height="0.4cm" Left="2.097cm" Top="53.876cm" Value="21- إعمالاً لحكم المادة (87) من اللائحة التنفيذية لقانون تنظيم التعاقدات التي تبرمها الجهات العامة الصادر بالقانون رقم 182 لسنة 2018" Name="textBox197">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="7.008cm" Height="0.4cm" Left="11.204cm" Top="54.409cm" Value="22- أدخل مدة التسليم طبقاً لكراسة الشروط والمواصفات . " Name="textBox198">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="3.3cm" Height="0.4cm" Left="8.412cm" Top="51.609cm" Value="البند الخامس عشر" Name="textBox199">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Size="12pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="3.561cm" Height="0.4cm" Left="14.538cm" Top="53.343cm" Value="من بداية المهلة وفقاً للآتى :" Name="textBox200">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="7.874cm" Height="0.4cm" Left="10.338cm" Top="54.909cm" Value="23- أدخل تاريخ بداية التسليم طبقاً لكراسة الشروط والمواصفات ." Name="textBox202">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="3.374cm" Height="0.4cm" Left="14.838cm" Top="55.476cm" Value="24- أدخل المهلة المناسبة ." Name="textBox201">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.255cm" Height="0.4cm" Left="2.097cm" Top="56.009cm" Value="25- أدخل مقابل التأخير في تنفيذ العقد وفقاً للحدود والنسب المنصوص عليها بالمادة (98) من اللائحة التنفيذية لقانون تمظيم التعاقدات التي " Name="textBox204">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="7.455cm" Height="0.4cm" Left="10.738cm" Top="56.543cm" Value="تبرمها الجهات العامة الصادر بالقانون رقم 182 لسنة 2018 ." Name="textBox203">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="10.447cm" Height="0.4cm" Left="7.738cm" Top="58.276cm" Value="يلتزم الطرف الأول بأن يسدد للطرف الثاني ثمن العقار محل هذا العقد خلال مدة لا تتجاوز (" Name="textBox205">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="3.3cm" Height="0.4cm" Left="8.438cm" Top="57.609cm" Value="البند السادس عشر" Name="textBox206">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Size="12pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="2.874cm" Height="0.4cm" Left="15.338cm" Top="58.809cm" Value="وذلك علي حسابه رقم " Name="textBox207">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="3.253cm" Height="0.4cm" Left="2.097cm" Top="58.276cm" Value=") تحسب من تاريخ الاستلام" Name="textBox208">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="0.915cm" Height="0.4cm" Left="10.238cm" Top="58.809cm" Value="بالبنك" Name="textBox209">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.2cm" Height="0.4cm" Left="2.097cm" Top="59.343cm" Value="وفي حالة عدم وفاء الطرف الأول بالمبالغ المستحقة في المواعيد المحددة يلتزم بأن يؤدي للطرف الثاني ما يعادل تكلفة التمويل لقيمة المطالبة" Name="textBox210">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="1.747cm" Height="0.4cm" Left="16.438cm" Top="60.409cm" Value="المطالب له ." Name="textBox211">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.2cm" Height="0.4cm" Left="2.097cm" Top="69.235cm" Value="اتفق الطرفان علي بذل أقصي جهد للالتزام ببنود التعاقد طوال مدة تنفيذه طبقاً لما اشتمل عليه وبطريقة تتفق مع ما يوجبه حسن النية , وفي " Name="textBox213">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.263cm" Height="0.4cm" Left="2.097cm" Top="69.768cm" Value="حالة خدوث خلاف بينهما أثناء تنفيذه يتم عقد اجتماع مع مسئول إدارة العقد أو ممثل الجهه الإدارية بحسب الأحوال خلال مدة خمسة عشر يوماً من" Name="textBox212">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="3.3cm" Height="0.526cm" Left="8.438cm" Top="61.209cm" Value="البند السابع عشر" Name="textBox214">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Size="12pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="15.755cm" Height="0.4cm" Left="2.438cm" Top="64.81cm" Value="بالعقد ويتعهد بعدم إفشائها للغير وذلك طوال مدة سريان العقد أو بعد انتهاؤه أو انهاؤه أو فسخه , ويعد الإخلال بمبدأ السرية والخصوصية " Name="textBox219">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="15.955cm" Height="0.4cm" Left="2.238cm" Top="61.876cm" Value="أقر الطرف الثاني عند توقيعه علي هذا العقد بعدم صدور أحكام نهائية ضده فى إحدي الجرائم المنصوص عليها فى الباب الرابع من الكتاب " Name="textBox218">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="6.882cm" Height="0.4cm" Left="11.338cm" Top="62.409cm" Value="الثاني من قانون العقوبات , أو في جرائم التهرب الضريبي . " Name="textBox217">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.2cm" Height="0.4cm" Left="2.097cm" Top="64.277cm" Value="يلتزم الطرف الثاني والعاملين لديه بالمحافظه علي سرية وخصوصية ما يحصلون عليه من بيانات أو مستندات أياً كانت طبيعتها تكون متعلقة " Name="textBox216">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="13.955cm" Height="0.4cm" Left="4.238cm" Top="65.343cm" Value="بمثابة إخلالا بمبدأ السرية والخصوصية بمثابة إخلالا جسيماً بشروط العقد ودون الإخلال بأية عقوبة مقررة في هذا الشأن . " Name="textBox215">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="3.3cm" Height="0.526cm" Left="8.438cm" Top="63.635cm" Value="البند الثامن عشر" Name="textBox220">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Size="12pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="3.3cm" Height="0.526cm" Left="8.438cm" Top="66.435cm" Value="البند التاسع عشر" Name="textBox221">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Size="12pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.219cm" Height="0.4cm" Left="2.097cm" Top="67.076cm" Value="يلتزم الطرف الأول بتحمل كافة الضرائب والرسوم وغيرها التي تستحق علي هذا العقد من تاريخ توقيعه وسدادها فى مواعيدها المحددة قانوناً ." Name="textBox222">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="3.3cm" Height="0.526cm" Left="8.412cm" Top="68.543cm" Value="البند العشرون" Name="textBox223">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Size="12pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="7.937cm" Height="0.4cm" Left="10.238cm" Top="70.301cm" Value="نم تاريخ ظهور الخلاف وذلك لمناقشته , واتخاذ الإجراءات الأتية : " Name="textBox226">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="7.637cm" Height="0.4cm" Left="10.538cm" Top="70.835cm" Value="1- فحص شروط التعاقد بكل دقة واتخاذ الحل المناسب للمشكلة ." Name="textBox227">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.2cm" Height="0.4cm" Left="2.097cm" Top="71.368cm" Value="2- قيام إدارة التعاقدات بإعداد تصور عن موضوع الخلاف وتقديم رأي ومالي وقانوني للسلطة المختصة , ويجوز لها الاستعانة باستشاري" Name="textBox228">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="6.237cm" Height="0.4cm" Left="11.938cm" Top="71.901cm" Value="متخصص للمساعدة في جرساة الخال وتقديم الرأي ." Name="textBox229">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.2cm" Height="0.4cm" Left="2.097cm" Top="72.435cm" Value="3- تسوية الخلاف الذي نشأ بالطرق الودية بما لا يخل بحقوق والتزامات طرفي العقد , وإذا ترتب علي التسوية الودية أي أعباء مالية فيتم" Name="textBox230">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="12.655cm" Height="0.4cm" Left="5.538cm" Top="72.943cm" Value="عرضها علي السلطة المختصة للموافقة عليها بعد تفديم كافة المستندات والبيانات المبررات لتسوية الخلاف . " Name="textBox231">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="10.955cm" Height="0.4cm" Left="7.238cm" Top="73.476cm" Value="وفي جميع الحالات يلتزم طرفي التعاقد بالاستمرار في تنفيذ التزاماتهما الناشئة عن هذا العقد . " Name="textBox232">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.2cm" Height="0.4cm" Left="2.097cm" Top="74.009cm" Value="حالة حدوث خلاف بيهما أثناء تنفيذه يتم عقد اجتماع مع مسئول إداره العقد أو ممثل الجهة الإدارية يحسب الأحوال خلال مدة خمسة عشر يوماً" Name="textBox233">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="3.96cm" Height="0.526cm" Left="8.038cm" Top="75.076cm" Value="البند الحادي والعشرون" Name="textBox234">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Size="12pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.2cm" Height="0.4cm" Left="2.097cm" Top="75.743cm" Value="فى حالة إخلال الطرف الثانى بأى شرط جوهرى من شروط التعاقد، يحق للطرف الأول فسخ العقد أو تنفيذه على حساب الطرف الثانى وفى " Name="textBox235">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.2cm" Height="0.4cm" Left="2.097cm" Top="76.276cm" Value="الحالتين يكون التأمين النهائى من حق الطرف الأول كما يكون له أن يخصم ما يستحقه وقيمة كل خسارة تلحق به من أى مبالغ مستحقة أو" Name="textBox236">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.2cm" Height="0.4cm" Left="2.097cm" Top="76.809cm" Value="أو تستحق للطرف الثانى لديه، وفى حالة عدم كفايتها يحق للطرف الأول خصمها من مستحقاته لدى أى جهة إدارية إدارية أخرى أياً كان" Name="textBox237">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.2cm" Height="0.4cm" Left="2.097cm" Top="77.343cm" Value="سبب الاستحقاق، دون حاجة إلى اتخاذ أى إجراءات قضائية، وذلك كله مع عدم الإخلال بحق الطرف الأول فى الرجوع على الطرف الثانى" Name="textBox238">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.2cm" Height="0.4cm" Left="2.097cm" Top="77.876cm" Value="الثانى قضائياً بما لم يتمكن من استيفائه من حقوق بالطريق الإدارى، ولا يحق للطرف الثانى المطالبة باسترداد ما سبق سداده للطرف الأول." Name="textBox239">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="4.774cm" Height="0.4cm" Left="13.438cm" Top="79.743cm" Value="يفسخ هذا العقد تلقائياً فى الحالات الآتية:" Name="textBox240">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="3.96cm" Height="0.526cm" Left="8.012cm" Top="79.076cm" Value="البند الثاني والعشرون" Name="textBox241">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Size="12pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="15.174cm" Height="0.4cm" Left="3.038cm" Top="80.276cm" Value="1- إذا تبين أن الطرف الثانى استعمل بنفسه أو بواسطة غيره الغش أو التلاعب فى تعامله مع الطرف الاول أو فى حصوله على العقد." Name="textBox242">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="10.174cm" Height="0.4cm" Left="8.038cm" Top="80.809cm" Value="2- إذا تبين وجود تواطؤ أو ممارسات احتيال أو فساد أو احتكار من قبل الطرف الثانى." Name="textBox243">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="4.474cm" Height="0.4cm" Left="13.738cm" Top="81.343cm" Value="3- إذا أفلس الطرف الثانى أو أعسر." Name="textBox244">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.2cm" Height="0.4cm" Left="2.097cm" Top="82.943cm" Value="يسري علي هذا العقد أحكام قانون تنظيم التعاقدات التي تبرهما الجهات العامة الصادر بالقانون رقم 182 لسنة 2018 , ولائحته التنفيذية " Name="textBox245">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="12.055cm" Height="0.4cm" Left="6.138cm" Top="83.502cm" Value="الصادرة بقرار وزير المالية رثم 692 لسنة 2019 , وذلك فيما لم يرد بشأنه نص خاص في هذا العقد . " Name="textBox246">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="3.96cm" Height="0.526cm" Left="8.012cm" Top="82.276cm" Value="البند الثالث والعشرون" Name="textBox247">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Size="12pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="3.96cm" Height="0.526cm" Left="8.012cm" Top="84.409cm" Value="البند الرابع والعشرون" Name="textBox248">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Size="12pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.31cm" Height="0.4cm" Left="2.097cm" Top="85.076cm" Value="يتم تسوية المنازعات والخلافات التي تنشأ أثناء التنفيذ وفقاً للطرق والشروط والأحكام المنصوص عليها في المادة (91) من قانون تنظيم" Name="textBox249">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.322cm" Height="0.4cm" Left="2.097cm" Top="85.609cm" Value="التعاقدات التي تبرمها الجهات العامة الصادر بالقانون رقم 182 لسنة 2018 , مع مراعاة ضرورة الحصول علي موافقة الوزير المختص في خالة اللجوء إلي التحكيم . " Name="textBox250">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="3.663cm" Height="0.4cm" Left="14.538cm" Top="86.143cm" Value="في حالة اللجوء إلي التحكيم . " Name="textBox251">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="3.663cm" Height="0.4cm" Left="14.546cm" Top="88.809cm" Value="في حالة اللجوء إلي التحكيم . " Name="textBox252">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="14.463cm" Height="0.4cm" Left="3.738cm" Top="86.676cm" Value="( في حالة اللجوء إلي تسوية النزاع قضائيا وكان المتعاقد معه شخصاً طبيعياً أو اعتبارياً خاصاً يكون البند علي النحو التالي )" Name="textBox253">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="10.016cm" Height="0.4cm" Left="8.185cm" Top="87.209cm" Value="تختص محاكم مجلس الدولة دون غيرها بالفصل في أي نزاع ينشأ عن تنفيذ هذا العقد . " Name="textBox254">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.322cm" Height="0.4cm" Left="2.097cm" Top="87.743cm" Value="( في حالة اللجوء إلي تسوية النزاع قضائياً وكان المتعاقد معه شخصاً طبيعياً أو اعتبارياً عاماً يكون البند علي النحو التالي )" Name="textBox255">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.322cm" Height="0.4cm" Left="2.097cm" Top="88.276cm" Value="تختص الجمعية العمومية لقسمي الفتوى والتشريع بمجلس الدولة بالفصل في طافة المنازعات التي قد تنشأ عن تنفيذ أو تفسير هذا العقد ." Name="textBox256">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="3.96cm" Height="0.526cm" Left="8.012cm" Top="89.743cm" Value="البند الخامس والعشرون" Name="textBox257">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Size="12pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.2cm" Height="0.4cm" Left="2.097cm" Top="90.409cm" Value="أقر الطرفان بأن العنوان المبين فرين كل منهما بصدر هذا العقد هو المحل المختار لهما , وأن جميع المكاتبات والمراسلات والإعلانات " Name="textBox258">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.2cm" Height="0.4cm" Left="2.097cm" Top="90.943cm" Value="والإخطارات التي توجه أو ترسل أو تعلن أ, تخطر عليه تكون صحيحه ومنتجه لكافة آثارها القانونية , وفي حالة تغيير أحد الطرفين لعنوانه يتعين عليه اخطار الطرف الآحر بهذا العنوان الجديد خلال خمسة عشرة يوماً . بخطاب مسجل بعلم الوصول , وإلا اعتبرت مكاتباته ومراسلته وإعلاناته وإخطاراته علي هذا العنوان صحيحه ومنتجه لكافة آثارها القانونية ." Name="textBox259">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.2cm" Height="0.4cm" Left="2.097cm" Top="92.542cm" Value="تحرر هذا العقد من أصل وأربعة نسخ , سلمت إحداها إلي الطرف الثاني , واحتفظ الطرف الأول بالأصل والنسخ الآخري , للعمل بمقتضاها عند " Name="textBox261">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="0.972cm" Height="0.4cm" Left="17.325cm" Top="93.076cm" Value="اللزوم ." Name="textBox260">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="3.96cm" Height="0.526cm" Left="8.012cm" Top="91.876cm" Value="البند السادس والعشرون" Name="textBox262">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Size="12pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="3cm" Height="0.4cm" Left="11.099cm" Top="1.311cm" Value="= Fields.[نوع العملية]" Name="textBox332">
          <Style TextAlign="Right">
            <Font Bold="True" />
