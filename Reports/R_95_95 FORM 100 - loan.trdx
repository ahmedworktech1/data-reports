<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource1" Width="210mm" Name="Report" xmlns="http://schemas.telerik.com/reporting/2021/1.0">
  <Style BackgroundColor="Silver" />
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="STARData" SelectCommand="SELECT DB_VL+CR_VL AS NET, 1 AS NUM,&#xA;(SELECT SUM_NM_AR FROM GLSUMS WHERE SUM_CD=GLJRNLD.SUM_CD)AS SUMNM,&#xA;(SELECT CST_NM_AR FROM GLCST WHERE CST_CD=LEFT (GLJRNLD.CST_CD,2))AS CSTNM,&#xA;(SELECT CST_NM_AR FROM GLCST WHERE CST_CD=(SELECT LEFT (SUM_CST_CD,2) FROM GLSUMS WHERE SUM_CD=GLJRNLD.SUM_CD))AS CSTNM1,&#xA;(SELECT ACC_NM_AR FROM GLMF WHERE ACC_NO=GLJRNLD.ACC_NO)AS ACCTNM,&#xA;(SELECT FMLY FROM GLMF WHERE ACC_NO=GLJRNLD.ACC_NO)AS FMLY,&#xA;(SELECT BTCH_ID FROM GLCST WHERE CST_CD=GLJRNLD.CST_CD)AS BTICH ,&#xA;(SELECT LC_NO FROM GLLCMF WHERE SUM_CD=GLJRNLD.SUM_CD)AS LCNO ,&#xA;(SELECT LC_AMOUNT FROM GLLCMF WHERE SUM_CD=GLJRNLD.SUM_CD)AS LCAMOUNT ,&#xA;(SELECT LC_DSCR_AR FROM GLLCMF WHERE SUM_CD=GLJRNLD.SUM_CD)AS DSCR ,&#xA;(SELECT OPN_DT FROM GLLCMF WHERE SUM_CD=GLJRNLD.SUM_CD)AS OPENDATE ,&#xA;(SELECT LC_DSCR_EN FROM GLLCMF WHERE SUM_CD=GLJRNLD.SUM_CD)AS ADRESS ,&#xA;(SELECT REN_DT1 FROM GLLCMF WHERE SUM_CD=GLJRNLD.SUM_CD)AS REN1 ,&#xA;(SELECT REN_DT2 FROM GLLCMF WHERE SUM_CD=GLJRNLD.SUM_CD)AS REN2 , &#xA;(SELECT REN_DT3 FROM GLLCMF WHERE SUM_CD=GLJRNLD.SUM_CD)AS REN3 ,  &#xA;(SELECT REN_VL1 FROM GLLCMF WHERE SUM_CD=GLJRNLD.SUM_CD)AS RENVL1 , &#xA;(SELECT REN_VL2 FROM GLLCMF WHERE SUM_CD=GLJRNLD.SUM_CD)AS RENVL2 , &#xA;(SELECT REN_VL3 FROM GLLCMF WHERE SUM_CD=GLJRNLD.SUM_CD)AS RENVL3 ,&#xA;(SELECT EXP_DT1 FROM GLLCMF WHERE SUM_CD=GLJRNLD.SUM_CD)AS EXP_DT1 , &#xA;(SELECT EXP_DT1 FROM GLLCMF WHERE SUM_CD=GLJRNLD.SUM_CD)AS EXP_DT2 , &#xA;(SELECT EXP_DT1 FROM GLLCMF WHERE SUM_CD=GLJRNLD.SUM_CD)AS EXP_DT3 ,  &#xA;  (CUR_VL * LN_TY) AS CUR  ,&#xA;&#xA;* FROM  GLJRNLD&#xA;&#xA;WHERE ACC_NO BETWEEN '1001' AND '100799999'&#xA;AND JRN_CD='01'&#xA;AND 1=1&#xA;&#xA;" Name="sqlDataSource1" />
  </DataSources>
  <Items>
    <ReportFooterSection Height="269mm" Name="ReportFooterSection5">
