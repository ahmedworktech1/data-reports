<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource1" Width="28.7cm" Name="Contracts report-39" ShowSnapGrid="True" xmlns="http://schemas.telerik.com/reporting/2021/1.0">
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="AQArbid5" SelectCommand="SELECT TOP (100) PERCENT &#xD;&#xA; TR_NO, &#xD;&#xA; TR_DT, &#xD;&#xA; CUR_STRT_DT, &#xD;&#xA; CUR_END_DT, &#xD;&#xA; STRT_DT, &#xD;&#xA; END_DT, &#xD;&#xA; COLLECT_AMT, &#xD;&#xA; VAC_DATE, &#xD;&#xA; AMT, &#xD;&#xA; CUR_AMT, &#xD;&#xA; CUR_COLLCT_AMT,&#xD;&#xA; CONCAT&#xD;&#xA; (&#xD;&#xA;  (&#xD;&#xA;   SELECT DSCR_AR FROM APPCODES&#xD;&#xA;   WHERE ID = 139 AND SEQ = (&#xD;&#xA;    SELECT UNT_TYP FROM UNTMF&#xD;&#xA;    WHERE BLD_CD = AQRENT_H.BLD_CD AND UNT_CD = (&#xD;&#xA;     SELECT TOP 1 UNT_CD FROM AQRENT_D&#xD;&#xA;     WHERE TR_NO = DBO.AQRENT_H.TR_NO &#xD;&#xA;    )&#xD;&#xA;   )&#xD;&#xA;  ), &#xD;&#xA;  ' ', ' بالدور ' ,&#xD;&#xA;  (&#xD;&#xA;  SELECT DSCR_AR FROM AQLISTS&#xD;&#xA;  WHERE REC_TYPE = 12 AND CODE = (&#xD;&#xA;   SELECT UNT_FLOOR FROM UNTMF&#xD;&#xA;    WHERE BLD_CD = AQRENT_H.BLD_CD AND UNT_CD = (&#xD;&#xA;     SELECT TOP 1 UNT_CD FROM AQRENT_D&#xD;&#xA;     WHERE TR_NO = DBO.AQRENT_H.TR_NO &#xD;&#xA;    )&#xD;&#xA;   )&#xD;&#xA;  ),&#xD;&#xA;  ' ',' رقم الوحده' ,&#xD;&#xA;  (&#xD;&#xA;   SELECT STRING_AGG(UNT_NO, ', ') FROM UNTMF&#xD;&#xA;  WHERE BLD_CD = AQRENT_H.BLD_CD AND UNT_CD IN (&#xD;&#xA;    SELECT UNT_CD FROM AQRENT_D&#xD;&#xA;    WHERE TR_NO = DBO.AQRENT_H.TR_NO &#xD;&#xA;   )&#xD;&#xA;  )&#xD;&#xA; ) AS UNTS_DSCRS,&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;CASE &#xD;&#xA; WHEN CONTRCT_STATE = 1 THEN 'جديد' &#xD;&#xA;ELSE CASE &#xD;&#xA; WHEN CONTRCT_STATE = 2 THEN 'مؤجر' &#xD;&#xA;ELSE CASE &#xD;&#xA; WHEN CONTRCT_STATE = 3 THEN 'تنازل' ELSE NULL &#xD;&#xA;END &#xD;&#xA;END &#xD;&#xA;END AS DEC,&#xD;&#xA;  (&#xD;&#xA; SELECT TENANT_NM_AR&#xD;&#xA; FROM DBO.TENANTMF&#xD;&#xA; WHERE (TENANT_NO = DBO.AQRENT_H.TENANT_NO)&#xD;&#xA;  ) AS TENANT_NM_AR,&#xD;&#xA;  (&#xD;&#xA; SELECT BLD_DSCR_AR&#xD;&#xA;  FROM DBO.BLDMF&#xD;&#xA; WHERE (BLD_CD = DBO.AQRENT_H.BLD_CD)&#xD;&#xA;  ) AS BLD_DSCR_AR&#xD;&#xA;FROM DBO.AQRENT_H&#xD;&#xA;inner join UNTMF&#xD;&#xA;  on AQRENT_H.Tr_NO = UNTMF.DOC_NO&#xD;&#xA;WHERE (CONTRCT_STATE = 2)&#xD;&#xA; ORDER BY TR_NO" Name="sqlDataSource1" />
  </DataSources>
