    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="aqxarmy20241" SelectCommand="SELECT &#xD;&#xA;Servicproviders.SrvcPvTENANT_Nm_AR,&#xD;&#xA;Con_Cd,&#xD;&#xA;CONVERT(VARCHAR(10), CON_DT, 101) AS CON_DT,&#xD;&#xA;CON_DSCR,&#xD;&#xA;Introduction,&#xD;&#xA;VAL&#xD;&#xA;FROM CONTRACTS_H &#xD;&#xA;INNER JOIN Servicproviders&#xD;&#xA;ON CONTRACTS_H.TR_NO = Servicproviders.SrvcPvTENANT_NO" Name="sqlDataSource1" />
