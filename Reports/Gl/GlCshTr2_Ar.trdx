<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="webServiceDataSource1" Width="17cm" Name="GlCshTr2_Ar" xmlns="http://schemas.telerik.com/reporting/2023/1.0">
  <DataSources>
    <WebServiceDataSource ParameterValues="{&quot;trTy&quot;:,&quot;trNo&quot;:,&quot;.AspNetCore.Identity.Application&quot;:,&quot;@Url&quot;:}" AuthParameterValues="null" ServiceUrl="@Url" Name="webServiceDataSource1">
      <Parameters>
        <WebServiceParameter WebServiceParameterType="Query" Name="trTy">
          <Value>
            <String>= Parameters.trTy.Value</String>
          </Value>
        </WebServiceParameter>
        <WebServiceParameter WebServiceParameterType="Query" Name="trNo">
          <Value>
            <String>= Parameters.trNo.Value</String>
          </Value>
        </WebServiceParameter>
        <WebServiceParameter WebServiceParameterType="Cookie" Name=".AspNetCore.Identity.Application">
          <Value>
            <String>= Parameters.login.Value</String>
          </Value>
        </WebServiceParameter>
        <WebServiceParameter WebServiceParameterType="Inline" Name="@Url">
          <Value>
            <String>= Parameters.Url.Value + "gl/GlCshTr/GetGlCshTr"</String>
          </Value>
        </WebServiceParameter>
      </Parameters>
    </WebServiceDataSource>
  </DataSources>
  <Items>
    <PageHeaderSection Height="0.132cm" Name="pageHeaderSection1">
      <Style Visible="False" />
    </PageHeaderSection>
    <DetailSection PageBreak="BeforeAndAfter" Height="11.568cm" Name="detailSection1">
      <Style Visible="True" BackgroundColor="198, 217, 241">
        <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
        <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
        <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
      </Style>
      <Items>
        <TextBox Width="3.8cm" Height="1.4cm" Left="6.5cm" Top="1.068cm" Value="رابطة العالم الاسلامي" Name="textBox10">
          <Style TextAlign="Center" VerticalAlign="Top">
            <Font Name="Aldhabi" Size="24pt" Bold="False" />
          </Style>
        </TextBox>
        <Panel Width="16.6cm" Height="6.2cm" Left="0.2cm" Top="3.268cm" Name="panel1">
          <Style BackgroundColor="Silver">
            <BorderStyle Default="Solid" />
            <Padding Left="0cm" Right="0cm" Top="0cm" Bottom="0cm" />
          </Style>
          <Items>
            <TextBox Width="12.8cm" Height="0.8cm" Left="0.3cm" Top="2.2cm" Value="= Fields.TrDt" Format="{0:d}" Name="textBox4">
              <Style TextAlign="Justify" VerticalAlign="Middle">
                <Font Size="12pt" />
              </Style>
            </TextBox>
            <TextBox Width="3cm" Height="0.8cm" Left="13.4cm" Top="2.2cm" Value="التاريخ:" Name="textBox3">
              <Style TextAlign="Right" VerticalAlign="Middle">
                <Font Size="12pt" Bold="True" />
              </Style>
            </TextBox>
            <TextBox Width="3cm" Height="0.8cm" Left="13.4cm" Top="3.15cm" Value="تسلمنا من السيد:" Name="textBox5">
              <Style TextAlign="Right" VerticalAlign="Middle">
                <Font Size="12pt" Bold="True" />
              </Style>
            </TextBox>
            <TextBox Width="3cm" Height="0.8cm" Left="13.4cm" Top="4.1cm" Value="مبلغا وقدره فقط:" Name="textBox6">
              <Style TextAlign="Right" VerticalAlign="Middle">
                <Font Size="12pt" Bold="True" />
              </Style>
            </TextBox>
            <TextBox Width="3cm" Height="0.8cm" Left="13.4cm" Top="5.05cm" Value="وذلك عن:" Name="textBox7">
              <Style TextAlign="Right" VerticalAlign="Middle">
                <Font Size="12pt" Bold="True" />
              </Style>
            </TextBox>
            <TextBox Width="12.8cm" Height="0.8cm" Left="0.3cm" Top="4.1cm" Value="= brca.Core.Services.ReportStaticService.Tafqeet(Fields.TotAmt)" Name="textBox1">
              <Style TextAlign="Justify" VerticalAlign="Middle">
                <Font Size="12pt" />
              </Style>
            </TextBox>
            <TextBox Width="12.8cm" Height="0.8cm" Left="0.3cm" Top="3.15cm" Value="= Fields.ToNm" Name="textBox2">
              <Style TextAlign="Justify" VerticalAlign="Middle">
                <Font Size="12pt" />
              </Style>
            </TextBox>
            <TextBox Width="12.8cm" Height="0.8cm" Left="0.3cm" Top="5.05cm" Value="= Fields.Rmrk" Name="textBox8">
              <Style TextAlign="Justify" VerticalAlign="Middle">
                <Font Size="12pt" />
              </Style>
            </TextBox>
            <TextBox Width="12.8cm" Height="0.8cm" Left="0.3cm" Top="1.2cm" Value="= Fields.TrNo" Name="textBox11">
              <Style VerticalAlign="Middle">
                <Font Size="12pt" />
              </Style>
            </TextBox>
            <TextBox Width="3cm" Height="0.8cm" Left="13.4cm" Top="1.2cm" Value="رقم السند:" Name="textBox12">
              <Style TextAlign="Right" VerticalAlign="Middle">
                <Font Size="12pt" Bold="True" />
              </Style>
            </TextBox>
            <TextBox Width="12.8cm" Height="0.8cm" Left="0.3cm" Top="0.168cm" Value="= Fields.M_CshDscr" Name="textBox13">
              <Style VerticalAlign="Middle">
                <Font Size="12pt" />
              </Style>
            </TextBox>
            <TextBox Width="3cm" Height="0.8cm" Left="13.4cm" Top="0.168cm" Value="الخزينة:" Name="textBox14">
              <Style TextAlign="Right" VerticalAlign="Middle">
                <Font Size="12pt" Bold="True" />
              </Style>
            </TextBox>
          </Items>
        </Panel>
        <TextBox Width="3cm" Height="0.8cm" Left="5.2cm" Top="9.536cm" Value="أمين الصندوق:" Name="textBox15">
          <Style TextAlign="Right" VerticalAlign="Middle">
            <Font Size="12pt" Bold="True" />
          </Style>
        </TextBox>
        <TextBox Width="5cm" Height="0.8cm" Left="0.2cm" Top="9.536cm" Value="......................................................." Name="textBox16">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="8pt" Bold="True" />
          </Style>
        </TextBox>
        <TextBox Width="16.1cm" Height="0.7cm" Left="0.5cm" Top="2.468cm" Value="= Parameters.CompanyName.Value" Name="textBox17">
          <Style TextAlign="Center">
            <Font Size="18pt" />
          </Style>
        </TextBox>
        <PictureBox Value="= Parameters.Logo.Value" Width="3.8cm" Height="2.268cm" Left="12.5cm" Top="0.2cm" Sizing="Stretch" MimeType="" Name="LogoImage">
          <Style>
            <BackgroundImage ImageData="null" Repeat="NoRepeat" />
          </Style>
        </PictureBox>
      </Items>
    </DetailSection>
    <PageFooterSection Height="0.6cm" Name="pageFooterSection1">
      <Style Visible="False" />
    </PageFooterSection>
  </Items>
  <PageSettings PaperKind="A4" Landscape="False" ContinuousPaper="False">
    <Margins>
      <MarginsU Left="2cm" Right="2cm" Top="2cm" Bottom="2cm" />
    </Margins>
  </PageSettings>
  <StyleSheet>
    <StyleRule>
      <Style>
        <Padding Left="2pt" Right="2pt" />
      </Style>
      <Selectors>
        <TypeSelector Type="TextItemBase" />
        <TypeSelector Type="HtmlTextBox" />
      </Selectors>
    </StyleRule>
  </StyleSheet>
  <ReportParameters>
    <ReportParameter Name="login" AllowNull="True" />
    <ReportParameter Name="trNo" />
    <ReportParameter Name="trTy" />
    <ReportParameter Name="Url" Text="Url" />
    <ReportParameter Name="CompanyName">
      <Value>
        <String></String>
      </Value>
    </ReportParameter>
    <ReportParameter Name="Logo" />
    <ReportParameter Name="CompanyAddress" />
  </ReportParameters>
</Report>