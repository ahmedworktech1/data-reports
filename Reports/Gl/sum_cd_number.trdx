<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource1" Width="17cm" Name="QueryGlJrnl1" xmlns="http://schemas.telerik.com/reporting/2021/1.0">
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="glx2024" SelectCommand="select sum_cd,(select sum_nm_ar from glsums where glsums.sum_cd = gljrnld.sum_cd) as sum_nm,&#xD;&#xA;acc_no,(select acc_nm_ar from glmf where glmf.acc_no = gljrnld.acc_no) as acc_nm,count(*) as number&#xD;&#xA;from gljrnld where sum_cd is not null and 1=1 &#xD;&#xA;group by sum_cd,acc_no&#xD;&#xA;order by sum_cd&#xD;&#xA;" Name="sqlDataSource1" />
  </DataSources>
  <Items>
    <PageHeaderSection Height="1.3cm" Name="pageHeaderSection1">
      <Style BackgroundColor="" />
      <Items>
        <TextBox Width="2.1cm" Height="0.6cm" Left="14.8cm" Top="0.7cm" Value="رقم البند" Name="textBox2">
          <Style BackgroundColor="Silver" Color="Red" TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" />
            <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="4.8cm" Height="0.6cm" Left="10cm" Top="0.7cm" Value="اسم البند" Name="textBox6">
          <Style BackgroundColor="Silver" Color="Red" TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" />
            <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
