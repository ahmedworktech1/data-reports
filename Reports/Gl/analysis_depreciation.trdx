DPRC_Q.DSP_DPREXP) ,0)as decimal(18,4) ),2) else 0 end) as CdspAcc &#xD;&#xA;FROM (FAMF  LEFT JOIN FADPRC_Q ON FADPRC_Q.FA_CD=FAMF.FA_CD)&#xD;&#xA;WHERE (FAMF.FA_TY&lt;&gt;1) and  (FAMF.FA_TY&lt;&gt;5) and (FAMF.FA_CD like '11%' or FAMF.FA_CD like '15%') &#xD;&#xA;group by substring(famf.FA_CD,1,1)" Name="sqlDataSource1" />
