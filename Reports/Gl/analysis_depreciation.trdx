  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="glx2023tarheel" SelectCommand="SELECT&#xD;&#xA;'' as prd_nm&#xD;&#xA;,substring(famf.FA_CD,1,3) as FA_CD, 'الأراضي' as Fa_nm,'' as prd&#xD;&#xA; ,sum(case when prd='4' then (ISNULL(FADPRC_Q.FA_VL,0)) else 0 end) as CFaVl &#xD;&#xA;,sum(case when prd='4' then Cast( ISNULL(FADPRC_Q.TOTADD,0)as decimal(18,4)) else 0 end ) as Cadd&#xD;&#xA;,sum(case when prd='4' then Cast(ISNULL(FADPRC_Q.TOTDSP,0)as decimal(18,4)) else 0 end) as Cdsp&#xD;&#xA;,sum((Round(Cast((ISNULL((FADPRC_Q.DPREXP) ,0) )as decimal(18,4)),2) &#xD;&#xA;+ Cast(ISNULL(FAMF.PYRDPRC,0)as decimal(18,4)) )) as Dprexp1&#xD;&#xA;,sum(&#xD;&#xA;(Cast( ISNULL(FADPRC_Q.TOTADD,0)as decimal(18,4)) * Cast(ISNULL(FAMF.DPRC_VL,0) as decimal(18,4))/100)/4&#xD;&#xA;) as Dprexp1_cadd&#xD;&#xA;,sum(case when prd='4' then Cast(ISNULL(FAMF.DPRC,0)as decimal(18,4)) else 0 end) AS BgDPrc&#xD;&#xA;,sum(case when prd='4' then Cast(ISNULL((FADPRC_Q.TOTADDACC) ,0)as decimal(18,4)) else 0 end) as CaddAcc &#xD;&#xA;,sum(case when prd='4' then Round(Cast(ISNULL((FADPRC_Q.TOTDSPACC) ,0)as decimal(18,4) ),2) &#xD;&#xA;+Round(Cast(ISNULL((FADPRC_Q.DSP_DPREXP) ,0)as decimal(18,4) ),2) else 0 end) as CdspAcc &#xD;&#xA;FROM (FAMF  LEFT JOIN FADPRC_Q ON FADPRC_Q.FA_CD=FAMF.FA_CD)&#xD;&#xA;WHERE (FAMF.FA_TY&lt;&gt;1) and  (FAMF.FA_TY&lt;&gt;5) and (FAMF.FA_CD like '111%') &#xD;&#xA;group by substring(famf.FA_CD,1,3)&#xD;&#xA;-----------------------------------------&#xD;&#xA;union all&#xD;&#xA;SELECT&#xD;&#xA;'الربع الأول' as prd_nm&#xD;&#xA;,substring(famf.FA_CD,1,3) as FA_CD, 'مباني' as Fa_nm,prd as prd&#xD;&#xA;,sum(ISNULL(FADPRC_Q.FA_VL,0)) as CFaVl &#xD;&#xA;,sum(Cast( ISNULL(FADPRC_Q.TOTADD,0)as decimal(18,4))) as Cadd&#xD;&#xA;,sum(Cast(ISNULL(FADPRC_Q.TOTDSP,0)as decimal(18,4))) as Cdsp&#xD;&#xA;,sum((Round(Cast((ISNULL((FADPRC_Q.DPREXP) ,0) )as decimal(18,4)),2) &#xD;&#xA;+ Cast(ISNULL(FAMF.PYRDPRC1,0)as decimal(18,4)) )) as Dprexp1&#xD;&#xA;,sum(