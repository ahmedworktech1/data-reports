<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource1" Width="21cm" Name="Report" xmlns="http://schemas.telerik.com/reporting/2021/1.0">
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="STARData" SelectCommand="select  1 AS NUM,&#xD;&#xA;SUM(CASE when GLJRNLD.ACC_NO = '102112' and cur_cd='02' and jrn_cd='01' THEN CUR_VL ELSE 0 END * ln_ty) AS dd,&#xD;&#xA;SUM(CASE when GLJRNLD.ACC_NO BETWEEN '1001' AND '100799999' and jrn_cd='01' and (tr_dt between '01/01/1901' and '01/01/1902')&#xD;&#xA; and&#xD;&#xA;( GLJRNLD.SUM_CD NOT LIKE '0103%' OR SUM_CD ='' OR SUM_CD IS NULL) THEN round(CUR_VL,2)*ln_ty ELSE 0 END  ) AS dd1,&#xD;&#xA;(select  CNTRCT_VAL from glmf where acc_no=102111)as d,&#xD;&#xA;(select  CNTRCTR_NM from glmf where acc_no=102111)as d55555,&#xD;&#xA;(select  PROJ_DSCR from glmf where acc_no=102111)as d1 ,&#xD;&#xA; (select  piec_no from glmf where acc_no=102111)as d11111,&#xD;&#xA; (select location from glmf where acc_no=102111)as ddd22&#xD;&#xA;  &#xD;&#xA;&#xD;&#xA; from  gljrnld&#xD;&#xA; WHERE (1=1) and (tr_dt&lt;='01/01/1902')&#xD;&#xA; &#xD;&#xA; &#xD;&#xA; &#xD;&#xA; &#xD;&#xA; &#xD;&#xA; &#xD;&#xA;" Name="sqlDataSource1" />
  </DataSources>
