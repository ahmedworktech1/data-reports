  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="GLXAsset" SelectCommand="SELECT FAMF.FA_CD as FaCd, PRD,FAMF.FA_NM_AR AS FaNm  ,FAMF.FA_NM_EN,FAMF.CHS_NO,FAMF.PLT_NO,FAMF.MOT_NO,FAMF.STRT_DT,FAMF.RSRV,FAMF.X_RSRV ,FAMF.VEND &#xD;&#xA;,FAMF.VRTX,FAMF.RESP,FAMF.FADSCR,FAMF.GIS,FAMF.SPND_TY_DSCR,FAMF.FA_KIND,FAMF.DOC_TYPE,FAMF.DOC_NO,FAMF.DOC_DT,FADPRC_Q.FA_KIND AS FA_KIND_Q,FADPRC_Q.DOC_TYPE &#xD;&#xA;AS DOC_TYPE_Q,Famf.PYRDPRC0,Famf.PYRDPRC1,Famf.PYRDPRC2,Famf.PYRDPRC3,Famf.PYRDPRC4 ,''  as cstcd,''  as CST_NM,'' as &#xD;&#xA;MCST_CD,FAMF.MFA_CD1 as MfaCd1 ,FAMF.MFA_CD2 as MfaCd2,FAMF.MFA_CD3 as MfaCd3,FAMF.MFA_CD4 as&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;MfaCd4,FAMF.FAACC_NO,FAMF.UNT_CD  , Round(FAMF.DDPRC, 3)  as DDPRC  , Round(FAMF.PYRDPRC, 3)  as PYRDPRC  &#xD;&#xA;, Round(FADPRC_Q.FA_VL, 3)  as CFaVl  , Round(FAMF.QTY, 3)  AS BG_QTY  , Round(FADPRC_Q.FA_QTY, 3)  as FA_QTY  , &#xD;&#xA;Round((ISNull(FADPRC_Q.FA_VL,0)+ISNull(FADPRC_Q.TOTADD,0)-ISNull(FADPRC_Q.TOTDSP,0)), 3)  AS AFaVl  , Round((ISNull(FAMF.DPRC,0)), 3)  AS Qodpr  , &#xD;&#xA;Round(FAMF.DPRC, 3)   AS YDPRC  ,(select sum(dprexp) from fadprc_q  FQ where Fq.fa_cd=fadprc_q.fa_cd and fq.prd &lt;=fadprc_q.prd )  AS Dprexp  , &#xD;&#xA;Round(FAMF.DPRC_VL, 3)  as DPrcVl  , Round(FADPRC_Q.BKVAL, 3)  as QBkVal    , Round(FADPRC_Q.TOTADD, 3)  as Cadd  , Round(FADPRC_Q.OADD, 3)  as OADD  , &#xD;&#xA;Round(FADPRC_Q.TOTDSP, 3)  as Cdsp  , Round(FADPRC_Q.ODSP, 3)  as ODSP  , Round(FADPRC_Q.DPREXP, 3)  as DPREXP2  , Round(FADPRC_Q.ODPR, 3)  as ODPR  , Round(FADPRC_Q.TOTADDACC, 3)  as CaddAcc  , Round(FADPRC_Q.TOTADDQTY, 3)  as TOTADDQTY  , Round(FADPRC_Q.OADDACC, 3)  as OADDACC  , Round(FADPRC_Q.TOTDSPACC, 3)  as CdspAcc  , Round(FADPRC_Q.TOTDSPQTY, 3)  as TOTDSPQTY  , Round(FADPRC_Q.ODSPACC, 3)  as ODSPACC  , Round(FADPRC_Q.ACCDPR, 3)  as QAccDpr  , Round(FADPRC_Q.ADD_DPREXP, 3)  as ADD_DPREXP  , Round(FADPRC_Q.DSP_DPREXP, 3)  as DSP_DPREXP  , Round(FADPRC_Q.Q_PYRDPRC, 3)  as Q_PYRDPRC  , Round(FADPRC_Q.TOTDSPDPR, 3)  as TOTDSPDPR  , Round(FADPRC_Q.totDSP_DPREXP, 3)  as totDSP_DPREXP  , Round(FADPRC_Q.TOTCDSP_ACC, 3)  as TOTCDSP_ACC  , Round(FADPRC_Q.YDSP_DPREXP, 3)  as YDSP_DPREXP  , Round((ISNull(FADPRC_Q.TOTADDACC,0)+ISNull(FADPRC_Q.ADD_DPREXP,0)+ISNull(FAMF.PYRDPRC,0)), 3)  AS EF_DPRC  , Round((ISNull(FADPRC_Q.TOTADD,0)-(ISNull(FADPRC_Q.TOTADDACC,0)+ISNull(FADPRC_Q.ADD_DPREXP,0)+ISNull(FAMF.PYRDPRC,0))), 3)  AS EF_NET  , Round((ISNull(FADPRC_Q.FA_VL,0)-ISNull(FADPRC_Q.TOTDSP,0)), 3)   AS BD_BKVAL  , Round((ISNull(FADPRC_Q.TOTDSPACC,0)+ISNull(FAMF.ddprc,0)), 3)   AS BD_DSPACC  , Round((ISNull(FADPRC_Q.DPREXP,0)-ISNull(FADPRC_Q.DSP_DPREXP,0)), 3)  AS BD_DPREXP  , Round((ISNull(FAMF.DPRC,0)-ISNull(FADPRC_Q.TOTDSPACC,0)-ISNull(FAMF.DDPRC,0)+ISNull(FADPRC_Q.DPREXP,0)-ISNull(FADPRC_Q.ADD_DPREXP,0)), 3)   AS BD_DPRC  , Round((ISNull(FADPRC_Q.FA_VL,0)-ISNull(FADPRC_Q.TOTDSP,0)- (ISNull(FAMF.DPRC,0)-ISNull(FADPRC_Q.TOTDSPACC,0)-ISNull(FAMF.DDPRC,0)+ISNull(FADPRC_Q.DPREXP,0)-ISNull(FADPRC_Q.ADD_DPREXP,0))), 3)   AS BD_NET  , Round(FADPRC_Q.DSPDPR, 3)  as DSPDPR  FROM (FAMF  LEFT JOIN FADPRC_Q ON FADPRC_Q.FA_CD=FAMF.FA_CD) LEFT JOIN  GLCST ON FAMF.CST_CD=GLCST.CST_CD  WHERE (FAMF.FA_TY&lt;&gt;1) and  (FAMF.FA_TY&lt;&gt;5) And 1=1  ORDER BY  FAMF.FA_CD &#xD;&#xA;" Name="sqlDataSource1" />
  </DataSources>
