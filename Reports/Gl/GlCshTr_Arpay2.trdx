    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="GLXYathreb" SelectCommand="SELECT&#xD;&#xA;&#x9;GLCSH_TR_H.TR_TY, &#xD;&#xA;(select csh_dscr from GLCSHMF where CSH_CD=GLCSH_TR_H.CSH_CD) as M_CshDscr,&#xD;&#xA;&#x9;GLCSH_TR_H.TR_NO, &#xD;&#xA;&#x9;GLCSH_TR_H.TR_DT, &#xD;&#xA;&#x9;GLCSH_TR_H.CSH_CD, &#xD;&#xA;&#x9;GLCSH_TR_H.CST_CD,&#xD;&#xA;(select cst_NM_Ar from glcst where CST_CD=GLCSH_TR_H.CST_CD ) as cst_name_ar,&#xD;&#xA;&#x9;GLCSH_TR_H.TOT_AMT, &#xD;&#xA;&#x9;GLCSH_TR_H.TO_NM, &#xD;&#xA;&#x9;GLCSH_TR_H.TOADR, &#xD;&#xA;&#x9;GLCSH_TR_H.DOC_TY, &#xD;&#xA;&#x9;GLCSH_TR_H.DOC_NO, &#xD;&#xA;&#x9;GLCSH_TR_H.CHK_NO, &#xD;&#xA;&#x9;GLCSH_TR_H.BNK_ID, &#xD;&#xA;&#x9;GLCSH_TR_H.BNK_BRNCH, &#xD;&#xA;&#x9;GLCSH_TR_H.BACC_NO, &#xD;&#xA;&#x9;GLCSH_TR_H.RMRK, &#xD;&#xA;&#x9;GLCSH_TR_H.REP_CD, &#xD;&#xA;&#x9;GLCSH_TR_H.REP_CD1, &#xD;&#xA;&#x9;GLCSH_TR_H.POSTED, &#xD;&#xA;&#x9;GLCSH_TR_H.PJRN_CD, &#xD;&#xA;&#x9;GLCSH_TR_H.PTR_NO, &#xD;&#xA;&#x9;GLCSH_TR_H.POSTED_DT, &#xD;&#xA;&#x9;GLCSH_TR_H.POSTED_BY, &#xD;&#xA;&#x9;GLCSH_TR_H.EnteredBy, &#xD;&#xA;&#x9;GLCSH_TR_H.UpdatedBy, &#xD;&#xA;&#x9;GLCSH_TR_H.EntryDate, &#xD;&#xA;&#x9;GLCSH_TR_H.UpdateDate, &#xD;&#xA;&#x9;GLCSH_TR_H.DOCS, &#xD;&#xA;&#x9;GLCSH_TR_H.RDOCS, &#xD;&#xA;&#x9;GLCSH_TR_H.PAID, &#xD;&#xA;&#x9;GLCSH_TR_H.PAID_DT, &#xD;&#xA;&#x9;GLCSH_TR_H.PAID_BY, &#xD;&#xA;&#x9;GLCSH_TR_H.CSH_TY, &#xD;&#xA;&#x9;GLCSH_TR_H.PRNTD, &#xD;&#xA;&#x9;GLCSH_TR_H.CUR_CD, &#xD;&#xA;&#x9;GLCSH_TR_H.HCUR_VL, &#xD;&#xA;&#x9;GLCSH_TR_H.HRATE, &#xD;&#xA;&#x9;GLCSH_TR_H.REVISD, &#xD;&#xA;&#x9;GLCSH_TR_H.REVISD_BY, &#xD;&#xA;&#x9;GLCSH_TR_H.REVISD_DT, &#xD;&#xA;&#x9;GLCSH_TR_H.R_DT, &#xD;&#xA;&#x9;GLCSH_TR_H.DblAct, &#xD;&#xA;&#x9;GLCSH_TR_H.DblAct_ty, &#xD;&#xA;&#x9;GLCSH_TR_H.DblAct_No, &#xD;&#xA;&#x9;GLCSH_TR_H.SRC, &#xD;&#xA;&#x9;GLCSH_TR_H.HPJRN_CD, &#xD;&#xA;&#x9;GLCSH_TR_H.HPTR_NO, &#xD;&#xA;&#x9;GLCSH_TR_H.TOT_NUM_WRD, &#xD;&#xA;&#x9;GLCSH_TR_H.tmp_no, &#xD;&#xA;&#x9;GLCSH_TR_H.HDUE_DT, &#xD;&#xA;&#x9;GLCSH_TR_H.COM_ID, &#xD;&#xA;&#x9;GLCSH_TR_H.ROLL_NO, &#xD;&#xA;&#x9;GLCSH_TR_H.SUM_CD, &#xD;&#xA;&#x9;(select sum_NM_Ar from GLSUMS where SUM_CD=GLCSH_TR_H.SUM_CD) as sum_name_Ar ,&#xD;&#xA;&#x9;GLCSH_TR_H.SSUM_CD,&#xD;&#xA;&#x9;(select SSUM_NM_Ar from GLSSUMS where SSUM_CD=GLCSH_TR_H.SSUM_CD ) as ssum_name_Ar ,&#xD;&#xA;&#x9;GLCSH_TR_H.ALT_CHK_NO, &#xD;&#xA;&#x9;GLCSH_TR_H.DIST_DON, &#xD;&#xA;&#x9;GLCSH_TR_H.CHK_stat, &#xD;&#xA;&#x9;GLCSH_TR_H.chk_stat_DT, &#xD;&#xA;&#x9;GLCSH_TR_H.ALT_TR_NO, &#xD;&#xA;&#x9;GLCSH_TR_H.TO_FRST_ACC, &#xD;&#xA;&#x9;GLCSH_TR_H.BY_ACC_RPT, &#xD;&#xA;&#x9;GLCSH_TR_H.tmp_jrn_cd, &#xD;&#xA;&#x9;GLCSH_TR_H.SCST_CD, &#xD;&#xA;&#x9;GLCSH_TR_H.RMRK_EN, &#xD;&#xA;&#x9;GLCSH_TR_H.HCHK_NO, &#xD;&#xA;&#x9;GLCSH_TR_H.HBNK_ID, &#xD;&#xA;&#x9;GLCSH_TR_H.HJ_TR_DT, &#xD;&#xA;&#x9;GLCSH_TR_H.HJ_POSTED_DT, &#xD;&#xA;&#x9;GLCSH_TR_H.HJ_PAID_DT, &#xD;&#xA;&#x9;GLCSH_TR_H.HJ_REVISD_DT, &#xD;&#xA;&#x9;GLCSH_TR_H.HJ_R_DT, &#xD;&#xA;&#x9;GLCSH_TR_H.HJ_HDUE_DT, &#xD;&#xA;&#x9;GLCSH_TR_H.HJ_chk_stat_DT, &#xD;&#xA;&#x9;GLCSH_TR_H.LOC, &#xD;&#xA;&#x9;GLCSH_TR_H.Ptr_ty, &#xD;&#xA;&#x9;GLCSH_TR_H.Ptr_no1, &#xD;&#xA;&#x9;GLCSH_TR_H.Sp_ty, &#xD;&#xA;&#x9;GLCSH_TR_H.SPD_Id, &#xD;&#xA;&#x9;GLCSH_TR_H.SP_Id, &#xD;&#xA;&#x9;GLCSH_TR_H.SP_NO, &#xD;&#xA;&#x9;GLCSH_TR_H.EgBatch, &#xD;&#xA;&#x9;GLCSH_TR_H.CntryId, &#xD;&#xA;&#x9;GLCSH_TR_H.Posted1F2, &#xD;&#xA;&#x9;GLCSH_TR_H.EgPayOffNumber, &#xD;&#xA;&#x9;GLCSH_TR_H.EgTransfereNumber, &#xD;&#xA;&#x9;GLCSH_TR_H.EgEndorseNumber, &#xD;&#xA;&#x9;GLCSH_TR_H.REFS_X, &#xD;&#xA;&#x9;GLCSH_TR_H.WF_TR_NO, &#xD;&#xA;&#x9;GLCSH_TR_H.WF_LN_NO, &#xD;&#xA;&#x9;GLCSH_TR_H.FTR_DT, &#xD;&#xA;&#x9;GLCSH_TR_H.TTR_DT, &#xD;&#xA;&#x9;GLCSH_TR_H.CNT_ID, &#xD;&#xA;&#x9;GLCSH_TR_H.HJ_FTR_DT, &#xD;&#xA;&#x9;GLCSH_TR_H.RMRK, &#xD;&#xA;&#x9;GLCSH_TR_H.HJ_TTR_DT,&#xD;&#xA;&#x9;GLCSH_TR.TO_ACC,&#xD;&#xA;&#x9;(select Acc_NM_Ar from GLMF where ACC_NO=GLCSH_TR.TO_ACC) as GLMF_name_Ar&#xD;&#xA;FROM &#xD;&#xA;GLCSH_TR_H join &#xD;&#xA;GLCSH_TR&#xD;&#xA;on GLCSH_TR_H.TR_TY = GLCSH_TR.TR_TY AND GLCSH_TR_H.TR_NO = GLCSH_TR.TR_NO" Name="sqlDataSource2" />
