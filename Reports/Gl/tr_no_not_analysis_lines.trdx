  <Style Visible="True" />
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="glx2023" SelectCommand="select &#xD;&#xA; m678.jrn_cd as cst_jrn_cd,m678.tr_no as cst_tr_no&#xD;&#xA;,gljrnld.jrn_cd,gljrnld.tr_no,gljrnld.ln_no&#xD;&#xA;,m678.GL_jrn_cd,m678.GL_tr_no,m678.GL_ln_no&#xD;&#xA;,gljrnld.db_vl,gljrnld.cr_vl,gljrnld.acc_no&#xD;&#xA;,(select acc_nm_ar from glmf where glmf.acc_no=gljrnld.acc_no) as acc_nm&#xD;&#xA;,(select doc_ds_ar from gltrstbl where gltrstbl.doc_ty=m678.jrn_cd) as jrn_nm&#xD;&#xA;,count(gljrnld.acc_no) as cacc&#xD;&#xA;,sum(m678.db_vl)  AS sum_db_678&#xD;&#xA;,sum(m678.cr_vl) AS sum_cr_678,&#xD;&#xA;&#xD;&#xA;((gljrnld.db_vl-gljrnld.cr_vl)-&#xD;&#xA;(sum(m678.db_vl)-sum(m678.cr_vl))) as net&#xD;&#xA;,sum(case when substring(m678.acc_no,2,1)='6' then m678.db_vl-m678.cr_vl else 0 end) as sum_net_6&#xD;&#xA;,sum(case when substring(m678.acc_no,2,1)='7' then m678.db_vl-m678.cr_vl else 0 end) as sum_net_7&#xD;&#xA;,sum(case when substring(m678.acc_no,2,1)='8' then m678.db_vl-m678.cr_vl else 0 end) as sum_net_8&#xD;&#xA;&#xD;&#xA;from &#xD;&#xA; gljrnld inner join gljrnld as m678 &#xD;&#xA;&#xD;&#xA;on &#xD;&#xA; gljrnld.jrn_cd=m678.gl_jrn_cd &#xD;&#xA; and gljrnld.tr_no=m678.gl_tr_no &#xD;&#xA; and gljrnld.ln_no=m678.gl_ln_no &#xD;&#xA; and (gljrnld.acc_no  like '4[1-3]%' or gljrnld.acc_no  like '51[1-2]%' )&#xD;&#xA; where (select revisd from gljrnlh where jrn_Cd = gljrnld.jrn_Cd and tr_no = GLJRNLD.tr_no) = 1&#xD;&#xA;&#xD;&#xA;group by &#xD;&#xA; m678.jrn_cd,m678.tr_no&#xD;&#xA;,gljrnld.jrn_cd,gljrnld.tr_no,gljrnld.ln_no&#xD;&#xA;,m678.GL_jrn_cd,m678.GL_tr_no,m678.GL_ln_no&#xD;&#xA;,gljrnld.db_vl,gljrnld.cr_vl,gljrnld.acc_no&#xD;&#xA;&#xD;&#xA;having &#xD;&#xA; (isnull(gljrnld.db_vl,0)-isnull(gljrnld.cr_vl,0))&lt;&gt;isnull(sum(m678.db_vl-m678.cr_vl),0)&#xD;&#xA;&#xD;&#xA;order by m678.jrn_cd,m678.tr_no" Name="sqlDataSource2" />
  </DataSources>
