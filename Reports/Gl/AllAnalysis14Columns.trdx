                <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
              </Style>
            </TextBox>
          </Items>
        </GroupHeaderSection>
      </GroupHeader>
      <GroupFooter>
        <GroupFooterSection Height="0.132cm" Name="groupFooterSection1">
          <Style Visible="False" BackgroundColor="White" />
        </GroupFooterSection>
      </GroupFooter>
      <Groupings>
        <Grouping Expression="= Fields.FLD2" />
      </Groupings>
    </Group>
  </Groups>
  <ReportParameters>
    <ReportParameter Name="CompanyName" AllowNull="True" />
    <ReportParameter Name="CompanyAddress" AllowNull="True" />
    <ReportParameter Name="Logo" AllowNull="True" />
    <ReportParameter Name="FromDate" AllowNull="True" />
    <ReportParameter Name="ToDate" AllowNull="True" />
    <ReportParameter Name="ColumnsNames" AllowNull="True" />
    <ReportParameter Name="ReportTitle" />
