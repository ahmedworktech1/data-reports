  <Style Visible="True" />
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="glx2024" SelectCommand="with Rrpt as (select ROW_NUMBER() OVER (ORDER BY (LN_NT),LN_NO) AS RROWNUMBER, * from AZGLRPT_OUT_Temp&#xD;&#xA;where ln_nt = 2 and 1=1),&#xD;&#xA;Lrpt as (select ROW_NUMBER() OVER (ORDER BY (LN_NT),LN_NO) AS LROWNUMBER,* from AZGLRPT_OUT_Temp&#xD;&#xA;where ln_nt = 1 and 1=1)&#xD;&#xA;&#xD;&#xA;select RROWNUMBER,LROWNUMBER,Rrpt.acc_no,Rrpt.acc_nm,Rrpt.Neta , Rrpt.Neta1 as Neta_1,&#xD;&#xA;Rrpt.Neta2 as Neta_2,Rrpt.Neta3 as Neta_3,Rrpt.LYR,&#xD;&#xA;Lrpt.acc_no as acc_no1,Lrpt.acc_nm as acc_nm2,Lrpt.Neta , Lrpt.Neta1 as Neta_1,Lrpt.Neta2 as Neta_21,Lrpt.Neta3 as Neta_31,Lrpt.LYR as Lyr1&#xD;&#xA;from  Rrpt FULL OUTER JOIN  Lrpt on&#xD;&#xA;LROWNUMBER=RROWNUMBER&#xD;&#xA;order by ISNULL(RROWNUMBER,LROWNUMBER) asc" Name="sqlDataSource1" />
  </DataSources>
