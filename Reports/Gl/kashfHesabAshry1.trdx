<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource1" Width="29.7cm" Name="kashf_Hesab" xmlns="http://schemas.telerik.com/reporting/2023/1.0">
  <Style>
    <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
    <BorderColor Top="84, 142, 213" Bottom="84, 142, 213" Left="84, 142, 213" Right="84, 142, 213" />
    <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
  </Style>
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="glx20241" SelectCommand=";WITH Transactions AS (&#xD;&#xA;    SELECT &#xD;&#xA;        GLJRNLD.TR_NO,&#xD;&#xA;        GLJRNLD.TR_DT,&#xD;&#xA;        GLJRNLD.TR_DS,&#xD;&#xA;        GLJRNLD.DB_VL,&#xD;&#xA;        GLJRNLD.CR_VL,&#xD;&#xA;        GLJRNLD.SCST_CD,&#xD;&#xA;        GLJRNLD.DOC_TY,&#xD;&#xA;        GLJRNLD.SSUM_CD,&#xD;&#xA;        GLJRNLD.ACC_NO,        -- رقم الحساب&#xD;&#xA;        GLJRNLD.COM_ID,        -- الشركة/الفرع&#xD;&#xA;        (GLJRNLD.DB_VL - GLJRNLD.CR_VL) AS Movement&#xD;&#xA;    FROM GLJRNLD  &#xD;&#xA;    WHERE (1=1) &#xD;&#xA;)&#xD;&#xA;SELECT &#xD;&#xA;    Transactions.TR_NO,&#xD;&#xA;    Transactions.TR_DT,&#xD;&#xA;    Transactions.TR_DS,&#xD;&#xA;    Transactions.DB_VL,&#xD;&#xA;    Transactions.CR_VL,&#xD;&#xA;    Transactions.SCST_CD,&#xD;&#xA;    Transactions.DOC_TY,&#xD;&#xA;    Transactions.SSUM_CD,&#xD;&#xA;    Transactions.ACC_NO,        &#xD;&#xA;    GLMF.ACC_NM_AR,             -- اسم الحساب&#xD;&#xA;    GLSSUMS.SSUM_NM_AR,&#xD;&#xA;    GLSCST.CONTRACT_NO,&#xD;&#xA;    AppCodes.Dscr_Ar,  &#xD;&#xA;    GLLOC.UNT_NM_AR,            -- اسم الوحدة / الفرع&#xD;&#xA;    SUM(Transactions.Movement) OVER (ORDER BY Transactions.TR_DT, Transactions.TR_NO ROWS UNBOUNDED PRECEDING) AS Balance&#xD;&#xA;FROM Transactions&#xD;&#xA;LEFT JOIN GLSSUMS  ON Transactions.SSUM_CD = GLSSUMS.SSUM_CD&#xD;&#xA;LEFT JOIN GLSCST   ON Transactions.SCST_CD = GLSCST.SCST_CD&#xD;&#xA;LEFT JOIN AppCodes ON AppCodes.Seq = Transactions.DOC_TY  &#xD;&#xA;LEFT JOIN GLMF     ON Transactions.ACC_NO  = GLMF.ACC_NO   -- الربط مع جدول الحسابات&#xD;&#xA;LEFT JOIN GLLOC    ON Transactions.COM_ID  = GLLOC.UNT_CD  -- الربط الجديد مع جدول GLLOCS&#xD;&#xA;ORDER BY Transactions.TR_DT, Transactions.TR_NO;&#xD;&#xA;" Name="sqlDataSource1" />
  </DataSources>
