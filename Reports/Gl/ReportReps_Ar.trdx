    <PageFooterSection Height="0.676cm" Name="pageFooterSection1">
      <Style>
        <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
        <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
        <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
      </Style>
      <Items>
        <TextBox Width="0.618in" Height="0.266in" Left="6.075in" Top="0in" Value="الاجمالي" Name="textBox18">
          <Style BackgroundColor="217, 217, 217" TextAlign="Center" VerticalAlign="Middle">
            <Font Size="8pt" Bold="True" />
            <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="3.552cm" Height="0.676cm" Left="11.878cm" Top="0cm" Value="= Count(Fields.RepNameArabic)" Name="textBox19">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
      </Items>
    </PageFooterSection>
    <ReportFooterSection Height="1.3cm" Name="reportFooterSection1">
      <Style>
        <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
        <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
        <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
      </Style>
      <ConditionalFormatting>
        <FormattingRule>
          <Style Visible="False" />
          <Filters>
            <Filter Expression="Count(1) &gt; 0" Operator="Equal" Value="true" />
          </Filters>
        </FormattingRule>
      </ConditionalFormatting>
    </ReportFooterSection>
  </Items>
  <PageSettings PaperKind="A4" Landscape="False">
    <Margins>
      <MarginsU Left="2cm" Right="2cm" Top="2cm" Bottom="2cm" />
    </Margins>
  </PageSettings>
  <StyleSheet>
    <StyleRule>
      <Style>
        <Padding Left="2pt" Right="2pt" />
      </Style>
      <Selectors>
        <TypeSelector Type="TextItemBase" />
        <TypeSelector Type="HtmlTextBox" />
      </Selectors>
    </StyleRule>
  </StyleSheet>
  <ReportParameters>
    <ReportParameter Name="Url" AllowNull="True" />
    <ReportParameter Name="login" AllowNull="True" />
    <ReportParameter Name="Type" AllowNull="True" />
    <ReportParameter Name="OfficeName" AllowNull="True" />
    <ReportParameter Name="BrokerType" AllowNull="True" />
    <ReportParameter Name="Office" AllowNull="True" />
    <ReportParameter Name="CompanyName" />
    <ReportParameter Name="CompanyAddress" />
    <ReportParameter Name="Logo" />
  </ReportParameters>
</Report>