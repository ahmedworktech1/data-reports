<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="webServiceDataSource1" Width="17cm" Name="ReportReps" xmlns="http://schemas.telerik.com/reporting/2019/2.0">
  <DataSources>
    <WebServiceDataSource ServiceUrl="@Url" Name="webServiceDataSource1" ParameterValues="{&quot;Type&quot;:,&quot;Office&quot;:,&quot;BrokerType&quot;:,&quot;.AspNetCore.Identity.Application&quot;:,&quot;@Url&quot;:}">
      <Parameters>
        <WebServiceParameter WebServiceParameterType="Query" Name="Type">
          <Value>
            <String>= Parameters.Type.Value</String>
          </Value>
        </WebServiceParameter>
        <WebServiceParameter WebServiceParameterType="Query" Name="Office">
          <Value>
            <String>= Parameters.Office.Value</String>
          </Value>
        </WebServiceParameter>
        <WebServiceParameter WebServiceParameterType="Query" Name="BrokerType">
          <Value>
            <String>= Parameters.BrokerType.Value</String>
          </Value>
        </WebServiceParameter>
        <WebServiceParameter WebServiceParameterType="Cookie" Name=".AspNetCore.Identity.Application">
          <Value>
            <String>= Parameters.login.Value</String>
          </Value>
        </WebServiceParameter>
        <WebServiceParameter WebServiceParameterType="Inline" Name="@Url">
          <Value>
            <String>= Parameters.Url.Value + "eg/ReportReps/GetDataReportReps"</String>
          </Value>
        </WebServiceParameter>
      </Parameters>
    </WebServiceDataSource>
  </DataSources>
  <Items>
    <PageHeaderSection Height="4.176cm" Name="pageHeaderSection1">
      <Style>
        <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
        <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
        <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
      </Style>
      <Items>
        <TextBox Width="2.6in" Height="0.4in" Left="2.126in" Top="0.039in" Value="تقرير المعينين بالمكاتب" Name="textBox2">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Size="16pt" Bold="True" Underline="True" />
          </Style>
        </TextBox>
        <TextBox Width="1.8cm" Height="0.6cm" Left="14.9cm" Top="0.299cm" Value="= &quot;بواسطة :&quot;+Cstr(UserIdentity.Name)" Name="textBox23">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="8pt" />
          </Style>
        </TextBox>
        <TextBox Width="1.6cm" Height="0.6cm" Left="12.8cm" Top="0.299cm" Value="= &quot; صفحة &quot; + CStr(PageNumber) + &quot; من &quot;  + CStr(PageCount)" Name="textBox20">
          <Style VerticalAlign="Middle">
            <Font Size="8pt" />
            <BorderStyle Top="None" Bottom="None" Left="None" Right="None" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="1.26in" Height="0.266in" Left="0in" Top="1.378in" Value="البريد الإلكتروني" Name="textBox4">
          <Style BackgroundColor="217, 217, 217" TextAlign="Center" VerticalAlign="Middle">
            <Font Size="8pt" Bold="True" />
            <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="0.916in" Height="0.266in" Left="2.155in" Top="1.378in" Value="الجوال" Name="textBox5">
          <Style BackgroundColor="217, 217, 217" TextAlign="Center" VerticalAlign="Middle">
            <Font Size="8pt" Bold="True" />
            <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="0.922in" Height="0.266in" Left="3.071in" Top="1.378in" Value="الهاتف" Name="textBox7">
          <Style BackgroundColor="217, 217, 217" TextAlign="Center" VerticalAlign="Middle">
