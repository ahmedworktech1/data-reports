<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource1" Width="17cm" Name="QueryGlJrnl1" xmlns="http://schemas.telerik.com/reporting/2023/1.0">
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="glx2023" SelectCommand="SELECT GLJRNLD.TR_NO as from_tr_no, (SELECT DOC_DS_Ar FROM GLTRSTBL WHERE GLTRSTBL.DOC_TY = GLJRNLD.JRN_CD) AS from_doc_nm,&#xD;&#xA;(SELECT UNT_NM_Ar FROM GLLOC WHERE GLLOC.UNT_CD = GLJRNLD.COM_ID) AS from_unt_nm&#xD;&#xA;, GLJRNLD.TR_DT as from_tr_dt , GLJRNLD.LN_NO from_ln_no, GLJRNLD.db_vl, GLJRNLD.cr_vl,&#xD;&#xA;&#xD;&#xA;G1.TR_NO AS to_tr_no,&#xD;&#xA;(SELECT DOC_DS_Ar FROM GLTRSTBL WHERE GLTRSTBL.DOC_TY = G1.JRN_CD) AS to_doc_nm,&#xD;&#xA;(SELECT UNT_NM_Ar FROM GLLOC WHERE GLLOC.UNT_CD = G1.COM_ID) AS to_unt_nm,&#xD;&#xA;g1.tr_dt as to_tr_dt,&#xD;&#xA;(isnull(g1.DB_VL,0) + isnull(g1.CR_VL,0)) AS 'payed'&#xD;&#xA;FROM dbo.GLJRNLD &#xD;&#xA;LEFT JOIN dbo.GLJRNLD G1&#xD;&#xA;ON [g1].[POSTED1_F5] = CONCAT(GLJRNLD.JRN_CD,'-',GLJRNLD.TR_NO,'-',GLJRNLD.LN_NO)&#xD;&#xA;WHERE --To_Com_Id = ISNULL((SELECT COM_ID FROM ZGLUSRS WHERE USRID = '{USER}'), '01') AND&#xD;&#xA;GLJRNLD.POSTED1_F6 IS NULL        AND GLJRNLD.POSTED1_F5 IS NULL       &#xD;&#xA;AND GLJRNLD.ACC_NO IN ( '3242201', '3242202', '3242203', '3242204', '3242205', '3242206', '3242207', '3242208', '1237111001', '1237111002', '1237111003', '1237111004', '1237111005', '1237111006', '1237111007','1237111008') &#xD;&#xA;AND ((GLJRNLD.[CR_VL] + GLJRNLD.[DB_VL]) = (SELECT COALESCE(SUM([g1].[CR_VL] + [g1].[DB_VL]), 0.0)                    FROM [GLJRNLD] AS [g1]                    WHERE [g1].[POSTED1_F5] = CONCAT(GLJRNLD.JRN_CD,'-',GLJRNLD.TR_NO,'-',GLJRNLD.LN_NO))) &#xD;&#xA;and 1=1 &#xD;&#xA;order by gljrnld.jrn_cd,gljrnld.tr_dt,gljrnld.tr_no" Name="sqlDataSource1" />
  </DataSources>
