<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource1" Width="34.025in" Culture="ar-EG" UnitOfMeasure="Mm" Name="TestFaProjects" Zoom="0.6666667" SnapToGrid="False" SnapToSnapLines="False" ShowDimensions="False" ShowWatermarks="False" xmlns="http://schemas.telerik.com/reporting/2021/1.0">
  <Style BackgroundColor="White" TextAlign="Center" />
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="GLXMonth" SelectCommand="SELECT&#xD;&#xA;    PROJNO,&#xD;&#xA;    CONCAT(&#xD;&#xA;&#x9;&#x9;' | ', ISNULL((SELECT CST_NM_AR FROM GLCST WHERE GLCST.CST_CD = d.CST_CD), ''), &#xD;&#xA;        ' | ',ISNULL((SELECT PROJ_NM_AR FROM FA_PROJECTSCODING WHERE PROJ_NO = d.PROJNO), ''), &#xD;&#xA;        ' | ' ,ISNULL((SELECT DSCR_AR FROM APPCODES WHERE ID = 1007 AND SEQ = TR_TY), ''),&#xD;&#xA;        ' | ',ISNULL(TR_NO, ''),&#xD;&#xA;&#x9;&#x9;' | ' , CONVERT(date,TR_DT), &#xD;&#xA;        ' | ',ISNULL(PERMISSION_NO, ''),&#xD;&#xA;        ' | ' ,CONVERT(date, PERMISSION_DT),' | ',&#xD;&#xA;&#x9;&#x9;&#xD;&#xA;&#x9;&#x9;(sum(case when TR_TY='200' then QTY*PRICE else 0 end ))&#xD;&#xA;&#xD;&#xA;    ) AS CONCATENATEDFIELD,&#xD;&#xA;    ' | ' AS COMP_TR_NM,&#xD;&#xA;    CONCAT( MAX(COMP_TR_NO),' | ', MAX(convert(date,COMP_TR_DT)),&#xD;&#xA;&#x9;' | ',MAX(SECT_TR_NO),' | ', MAX(convert(date,SECT_TR_DT)),' | ', MAX(DOC_VAL) ) AS CONCATENATEDFIELD2,&#xD;&#xA;    ITMCD,&#xD;&#xA;    (SELECT DSCR_AR FROM APPCODES WHERE ID = 1006 AND SEQ = ITMCD) AS ITM_NM,&#xD;&#xA;    SUM(QTY) AS QTY&#xD;&#xA;FROM&#xD;&#xA;    FA_PROJECTS_DETAILS D &#xD;&#xA;    LEFT JOIN FA_PROJECTS h ON D.FAPROJ_NO = h.FAPROJ_NO AND d.PROJNO = h.PROJ_NO&#xD;&#xA;WHERE&#xD;&#xA;   1&lt;&gt;1&#xD;&#xA;    AND ITMCD IS NOT NULL&#xD;&#xA;    AND TR_TY ='200'&#xD;&#xA;GROUP BY&#xD;&#xA;    PROJNO, d.FAPROJ_NO, d.CST_CD, TR_TY, TR_NO, TR_DT, PERMISSION_NO, PERMISSION_DT, ITMCD&#xD;&#xA;union all&#xD;&#xA;SELECT&#xD;&#xA;    PROJNO,&#xD;&#xA;    CONCAT(&#xD;&#xA;&#x9;&#x9;' | ', ISNULL((SELECT CST_NM_AR FROM GLCST WHERE GLCST.CST_CD = d.CST_CD), ''),&#xD;&#xA;        ' | ',ISNULL((SELECT PROJ_NM_AR FROM FA_PROJECTSCODING WHERE PROJ_NO = d.PROJNO), ''),&#xD;&#xA;        ' | ' ,ISNULL((SELECT DSCR_AR FROM APPCODES WHERE ID = 1007 AND SEQ = TR_TY), ''), &#xD;&#xA;        ' | ',ISNULL(TR_NO, ''),&#xD;&#xA;&#x9;&#x9;' | ' , CONVERT(date,TR_DT), &#xD;&#xA;        ' | ',ISNULL(PERMISSION_NO, ''), &#xD;&#xA;        ' | ' ,CONVERT(date, PERMISSION_DT),' | ' ,&#xD;&#xA;&#x9;&#x9;&#xD;&#xA;&#x9;&#x9;(sum(case when TR_TY='1' then QTY*PRICE else 0 end ) +&#xD;&#xA;(sum(case when TR_TY='2' then QTY*PRICE else 0 end )&#xD;&#xA;- sum(case when TR_TY='102' then QTY*PRICE else 0 end )) +&#xD;&#xA;(sum(case when TR_TY='4' then QTY*PRICE else 0 end ) &#xD;&#xA;- sum(case when TR_TY='103' then QTY*PRICE else 0 end )) +&#xD;&#xA;(sum(case when TR_TY in ('3','5') then QTY*PRICE else 0 end )&#xD;&#xA;- sum(case when TR_TY in ('104','105') then QTY*PRICE else 0 end )) -&#xD;&#xA;sum(case when TR_TY='101' then QTY*PRICE else 0 end ))&#xD;&#xA;&#xD;&#xA;    ) AS CONCATENATEDFIELD,&#xD;&#xA;    ' | ' AS COMP_TR_NM,&#xD;&#xA;    CONCAT( MAX(COMP_TR_NO),' | ', MAX(convert(date,COMP_TR_DT)),&#xD;&#xA;&#x9;' | ',MAX(SECT_TR_NO),' | ', MAX(convert(date,SECT_TR_DT)),' | ', MAX(DOC_VAL) ) AS CONCATENATEDFIELD2,&#xD;&#xA;    ITMCD,&#xD;&#xA;    (SELECT DSCR_AR FROM APPCODES WHERE ID = 1006 AND SEQ = ITMCD) AS ITM_NM,&#xD;&#xA;    SUM(QTY) AS QTY&#xD;&#xA;FROM&#xD;&#xA;    FA_PROJECTS_DETAILS D &#xD;&#xA;    LEFT JOIN FA_PROJECTS h ON D.FAPROJ_NO = h.FAPROJ_NO AND d.PROJNO = h.PROJ_NO&#xD;&#xA;WHERE&#xD;&#xA;   1&lt;&gt;1&#xD;&#xA;    AND ITMCD IS NOT NULL&#xD;&#xA;    AND TR_TY &lt;&gt;'200'&#xD;&#xA;GROUP BY&#xD;&#xA;    PROJNO, d.FAPROJ_NO, d.CST_CD, TR_TY, TR_NO, TR_DT, PERMISSION_NO, PERMISSION_DT, ITMCD" Name="sqlDataSource1">
      <CalculatedFields>
        <CalculatedField Name="tot" Expression="= IsNull(Fields.VAL01_1,0) +&#xD;&#xA; IsNull(Fields.VAL02_1,0) +&#xD;&#xA; IsNull(Fields.VAL03_1,0) +&#xD;&#xA; IsNull(Fields.VAL04_1,0) +&#xD;&#xA; IsNull(Fields.VAL05_1,0) +&#xD;&#xA; IsNull(Fields.VAL06_1,0) +&#xD;&#xA; IsNull(Fields.VAL07_1,0) +&#xD;&#xA; IsNull(Fields.VAL08_1,0) +&#xD;&#xA; IsNull(Fields.VAL09_1,0)">
          <DataType>System.Double</DataType>
        </CalculatedField>
        <CalculatedField Name="Field1" Expression="=Item(1, Split(&quot;|&quot;, Fields.FLD1_DSCR))">
