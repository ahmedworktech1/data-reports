<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource1" Width="287mm" Name="Report" Zoom="0.6666667" xmlns="http://schemas.telerik.com/reporting/2023/1.0">
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="GLX" SelectCommand="SELECT LEFT (GLJRNLD.ACC_NO,4) ,&#xD;&#xA;(SELECT ACC_NM_AR FROM GLMF WHERE ACC_NO=LEFT (GLJRNLD.ACC_NO,4))AS NM,&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;(SUM(CASE WHEN LN_TY=1 AND (ACC_NO like'100[1-6]%'  and jrn_cd = '2' ) and (7=7)  THEN CUR_VL ELSE 0 END)-&#xD;&#xA;SUM(CASE WHEN LN_TY=-1 AND (ACC_NO like'100[1-6]%'  and jrn_cd = '2' ) and (7=7)  THEN CUR_VL ELSE 0 END))  AS CUR,&#xD;&#xA;&#xD;&#xA;(SUM(CASE WHEN LN_TY=1 AND (ACC_NO like'100[1-6]%'  and jrn_cd = '2' ) and (7=7) THEN (DB_VL-CR_VL) ELSE 0 END)-&#xD;&#xA;SUM(CASE WHEN LN_TY=-1 AND (ACC_NO like'100[1-6]%'  and jrn_cd = '2' ) and (7=7)  THEN (DB_VL-CR_VL) ELSE 0 END))  AS NET,&#xD;&#xA;&#xD;&#xA;SUM(CASE WHEN SUM_CD like '0102%' and (7=7) THEN (CUR_VL) ELSE 0 END )  AS MMMM,&#xD;&#xA;SUM(CASE WHEN SUM_CD like '0102%' and (7=7) THEN (DB_VL-CR_VL) ELSE 0 END ) AS MMMM1&#xD;&#xA;&#xD;&#xA;&#xD;&#xA; FROM GLJRNLD &#xD;&#xA;&#xD;&#xA;GROUP BY LEFT (GLJRNLD.ACC_NO,4)" Name="sqlDataSource1" />
  </DataSources>
