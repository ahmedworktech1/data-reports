<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="webServiceDataSource1" Width="17cm" Name="ReportSummaryPayment" ShowSnapGrid="True" xmlns="http://schemas.telerik.com/reporting/2019/2.0">
  <DataSources>
    <WebServiceDataSource ServiceUrl="@Url" Name="webServiceDataSource1" ParameterValues="{&quot;.AspNetCore.Identity.Application&quot;:&quot;O3jM2zSOKNKYurRmorA54J_jG7vNvTr3PQC41WgHQeF1xNoXZ9gySsVXSQ&quot;,&quot;@Url&quot;:&quot;http://localhost:56226/gl/ReportSummaryPayment/GetDataReportSummaryPayment&quot;}">
      <Parameters>
        <WebServiceParameter WebServiceParameterType="Cookie" Name=".AspNetCore.Identity.Application">
          <Value>
            <String>= Parameters.login.Value</String>
          </Value>
        </WebServiceParameter>
        <WebServiceParameter WebServiceParameterType="Inline" Name="@Url">
          <Value>
            <String>= Parameters.Url.Value + "gl/ReportSummaryPayment/GetDataReportSummaryPayment"</String>
          </Value>
        </WebServiceParameter>
      </Parameters>
    </WebServiceDataSource>
  </DataSources>
  <Items>
    <PageHeaderSection Height="3.467cm" Name="pageHeaderSection1">
      <Style>
        <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
        <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
        <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
      </Style>
      <Items>
        <TextBox Width="8.1cm" Height="0.8cm" Left="4.4cm" Top="0cm" Value="صفحات كشف صرف" Name="textBox1">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Name="Arial" Size="16pt" Bold="True" />
            <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="1.8cm" Height="0.6cm" Left="14.6cm" Top="0cm" Value="= &quot;بواسطة :&quot;+Cstr(UserIdentity.Name)" Name="textBox23">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="8pt" />
          </Style>
        </TextBox>
        <TextBox Width="1.6cm" Height="0.6cm" Left="12.7cm" Top="0cm" Value="= &quot; صفحة &quot; + CStr(PageNumber) + &quot; من &quot;  + CStr(PageCount)" Name="textBox20">
          <Style VerticalAlign="Middle">
            <Font Size="8pt" />
            <BorderStyle Top="None" Bottom="None" Left="None" Right="None" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="16.1cm" Height="0.7cm" Left="0.5cm" Top="2.5cm" Value="= Parameters.CompanyName.Value" Name="textBox71">
          <Style TextAlign="Center">
            <Font Size="18pt" />
          </Style>
        </TextBox>
        <PictureBox Value="= Parameters.Logo.Value" Width="3.4cm" Height="2.067cm" Left="0.3cm" Top="0.2cm" Sizing="Stretch" MimeType="" Name="pictureBox1">
          <Style>
            <BackgroundImage ImageData="null" Repeat="NoRepeat" />
          </Style>
        </PictureBox>
      </Items>
    </PageHeaderSection>
    <DetailSection Height="0.6cm" Name="detailSection1">
      <Items>
        <TextBox Width="5.9cm" Height="0.6cm" Left="11.1cm" Top="0cm" Value="= Fields.ProjectDescription" Name="textBox12">
          <Style VerticalAlign="Middle">
            <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
