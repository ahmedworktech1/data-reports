        <TextBox Width="2.5cm" Height="0.6cm" Left="2.6cm" Top="0.7cm" Value="دائن" Name="textBox10">
          <Style BackgroundColor="Silver" Color="Red" TextAlign="Center" VerticalAlign="Middle">
