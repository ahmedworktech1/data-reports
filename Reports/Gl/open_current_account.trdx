        </TextBox>
        <TextBox Width="2.4cm" Height="0.6cm" Left="5.1cm" Top="0.7cm" Value="مدين" Name="textBox9">
          <Style BackgroundColor="Silver" Color="Red" TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" />
            <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
