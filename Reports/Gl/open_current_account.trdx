        </TextBox>
      </Items>
    </PageHeaderSection>
    <DetailSection Height="0.8cm" Name="detailSection1">
      <Style BackgroundColor="White" />
      <Items>
        <TextBox Width="2.4cm" Height="0.6cm" Left="5.1cm" Top="0.1cm" Value="= Fields.db_vl" Format="{0:#.00}" Name="textBox1">
          <Style TextAlign="Center" VerticalAlign="Middle">
