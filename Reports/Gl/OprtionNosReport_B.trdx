  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="glxaboghaly2" SelectCommand=" select top 1 ACC_NO as ee from EXPENSE_FORMS&#xD;&#xA;" Name="sqlDataSource1" />
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="glxaboghaly2" SelectCommand="SELECT OPERATION_NO, LN_NO,Page_Mode,m.manacc macc1,(select Acc_NM_AR from glmf where acc_no = m.manacc) as MainAcc_AR_1, d.ACC_NO AS AccNo1,(select Acc_NM_AR from glmf where acc_no = d.ACC_NO) as Acc_NM_AR_1, AMT AS Db,&#xD;&#xA;     ROW_NUMBER() OVER(PARTITION BY OPERATION_NO ORDER BY TR_DT) AS RowNum&#xD;&#xA;     FROM glmf m inner join EXPENSE_FORMS d on d.acc_no = m.ACC_NO WHERE LN_TY = 1  and d.Page_Mode = @Page_Mode and  d.OPERATION_NO = @OPERATION_NO" Name="sqlDataSource2">
      <Parameters>
        <SqlDataSourceParameter DbType="String" Name="@Page_Mode">
          <Value>
            <String>= Parameters.PageMode.Value</String>
          </Value>
        </SqlDataSourceParameter>
        <SqlDataSourceParameter DbType="String" Name="@OPERATION_NO">
          <Value>
            <String>= Parameters.OperationNo.Value</String>
          </Value>
        </SqlDataSourceParameter>
      </Parameters>
    </SqlDataSource>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="glxaboghaly2" SelectCommand="SELECT OPERATION_NO, LN_NO,Page_Mode, m.manacc macc2, (select Acc_NM_AR from glmf where acc_no = m.manacc) as MainAcc_AR_2 , d.ACC_NO AS AccNo2,(select Acc_NM_AR from glmf where acc_no = d.ACC_NO) as Acc_NM_AR_2 , AMT AS CR, ROW_NUMBER() OVER (PARTITION BY OPERATION_NO ORDER BY TR_DT) AS RowNum FROM glmf m inner join EXPENSE_FORMS d on d.ACC_NO = m.ACC_NO WHERE LN_TY = -1 and d.Page_Mode = @Page_Mode and  d.OPERATION_NO = @OperationNo" Name="sqlDataSource3">
      <Parameters>
        <SqlDataSourceParameter DbType="String" Name="@Page_Mode">
          <Value>
            <String>= Parameters.PageMode.Value</String>
          </Value>
        </SqlDataSourceParameter>
        <SqlDataSourceParameter DbType="String" Name="@OperationNo">
          <Value>
            <String>= Parameters.OperationNo.Value</String>
          </Value>
        </SqlDataSourceParameter>
      </Parameters>
    </SqlDataSource>
  </DataSources>
