<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource1" Width="19.002cm" Name="QueryVisits" Zoom="0.6666667" xmlns="http://schemas.telerik.com/reporting/2023/1.0">
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="archx" SelectCommand="select V.VisitDate as VisitDate, VIS.NationalID as NationalID, VIS.VisitorName as VisitorName, V.OrganizationID as OrganizationID, V.DepartmentID as DepartmentID, V.VisitReason as VisitReason, V.ArrivalTime as ArrivalTime, V.DepartureTime as DepartureTime&#xD;&#xA;, VIS.PhoneNumber as PhoneNumber from Visits AS V inner join Visitors AS VIS on v.VisitorID = VIS.VisitorID;" Name="sqlDataSource1" />
  </DataSources>
  <Items>
    <PageHeaderSection Height="1.1cm" Name="pageHeaderSection1">
      <Style BackgroundColor="242, 242, 242" TextAlign="Center" VerticalAlign="Middle" />
      <Items>
        <TextBox Width="2.5cm" Height="0.6cm" Left="1.5cm" Top="0.5cm" Value="توقيت الانصراف" Name="textBox8" />
        <TextBox Width="2.498cm" Height="0.6cm" Left="14.503cm" Top="0.5cm" Value="الرقم القومي" Name="textBox2" />
