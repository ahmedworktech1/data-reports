        <TextBox Width="1.499cm" Height="0.6cm" Left="10cm" Top="0.5cm" Value="الجهه" Name="textBox4" />
        <TextBox Width="2cm" Height="0.6cm" Left="6.001cm" Top="0.5cm" Value="سبب الزياره" Name="textBox6" />
        <TextBox Width="2cm" Height="0.6cm" Left="3.999cm" Top="0.5cm" Value="توقيت الحضور" Name="textBox7" />
        <TextBox Width="1.5cm" Height="0.6cm" Left="0cm" Top="0.5cm" Value="التيلفون" Name="textBox9" />
        <TextBox Width="1.999cm" Height="0.6cm" Left="8.001cm" Top="0.5cm" Value="الاداره المعنيه" Name="textBox5" />
        <TextBox Width="1.999cm" Height="0.6cm" Left="17.002cm" Top="0.5cm" Value="التاريخ" Name="textBox1" />
      </Items>
    </PageHeaderSection>
    <DetailSection Height="1cm" Name="detailSection1">
      <Style BackgroundColor="217, 217, 217" />
      <Items>
        <TextBox Width="2cm" Height="0.5cm" Left="17.002cm" Top="0.5cm" Value="= Fields.VisitDate" Name="textBox10" />
        <TextBox Width="2.498cm" Height="0.5cm" Left="14.503cm" Top="0.5cm" Value="= Fields.NationalID" Name="textBox11" />
        <TextBox Width="3cm" Height="0.5cm" Left="11.499cm" Top="0.5cm" Value="= Fields.VisitorName" Name="textBox12" />
        <TextBox Width="1.499cm" Height="0.5cm" Left="10cm" Top="0.5cm" Value="= Fields.OrganizationID" Name="textBox13" />
        <TextBox Width="1.999cm" Height="0.5cm" Left="8.001cm" Top="0.5cm" Value="= Fields.DepartmentID" Name="textBox14" />
        <TextBox Width="2cm" Height="0.5cm" Left="6.001cm" Top="0.5cm" Value="= Fields.VisitReason" Name="textBox15" />
        <TextBox Width="2cm" Height="0.5cm" Left="3.999cm" Top="0.5cm" Value="= Fields.ArrivalTime" Name="textBox16" />
        <TextBox Width="2.5cm" Height="0.5cm" Left="1.5cm" Top="0.5cm" Value="= Fields.DepartureTime" Name="textBox17" />
        <TextBox Width="1.5cm" Height="0.5cm" Left="0cm" Top="0.5cm" Value="= Fields.PhoneNumber" Name="textBox18" />
