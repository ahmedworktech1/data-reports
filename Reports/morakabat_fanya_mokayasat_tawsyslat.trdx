    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="glx2024" SelectCommand="select   'إيرادات النشاط الجاري الأخرى' as s,&#xD;&#xA;CAST(ROUND(sum( case when (((  acc_no like '0%') &#xD;&#xA;and  SUM_CD IN ('0')) ) and cst_Cd not like '0%' then db_vl-cr_vl else 0 end )/1000, null) AS BIGINT)  as s1,&#xD;&#xA;&#xD;&#xA;CAST(ROUND(sum( case when ((( acc_no like '0%' ) &#xD;&#xA;and  SUM_CD IN ('11','12','13')) ) then db_vl-cr_vl else 0 end )/1000, 0)*-1 AS BIGINT)  as s2&#xD;&#xA;&#xD;&#xA;from gljrnld  where (1=1)&#xD;&#xA; &#xD;&#xA;&#xD;&#xA;  UNION ALL&#xD;&#xA;&#xD;&#xA;select   'خدمات مباعة مقايسات' as s,&#xD;&#xA;CAST(ROUND(sum( case when ((( acc_no like '5[6-8]1122102%' ) &#xD;&#xA;and  SUM_CD IN ('11','12','13')) ) then db_vl-cr_vl else 0 end )/1000, 0)*-1 AS BIGINT)  as s1,&#xD;&#xA;&#xD;&#xA;CAST(ROUND(sum( case when ((( acc_no like '0%' ) &#xD;&#xA;and  SUM_CD IN ('11','12','13')) ) then db_vl-cr_vl else 0 end )/1000, 0)*-1 AS BIGINT)  as s2&#xD;&#xA;from gljrnld  WHERE (((  acc_no like '5[6-8]1122102%' )&#xD;&#xA;&#xD;&#xA; and  SUM_CD IN ('11','12','13')) )  and (1=1)&#xD;&#xA;&#xD;&#xA;  UNION ALL&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;select   'إيرادات تشغيل للغير' as s,&#xD;&#xA;CAST(ROUND(sum( case when ((( acc_no like '5[6-8]122%' ) &#xD;&#xA;and  SUM_CD IN ('11','12','13')) ) then db_vl-cr_vl else 0 end )/1000, 0)*-1 AS BIGINT)  as s1,&#xD;&#xA;&#xD;&#xA;CAST(ROUND(sum( case when ((( acc_no like '0%' ) &#xD;&#xA;and  SUM_CD IN ('11','12','13')) ) then db_vl-cr_vl else 0 end )/1000, 0)*-1 AS BIGINT)  as s2&#xD;&#xA;from gljrnld  WHERE ((( acc_no like '5[6-8]122%' )&#xD;&#xA;&#xD;&#xA; and  SUM_CD IN ('11','12','13')) ) and (1=1)&#xD;&#xA;&#xD;&#xA;  UNION ALL&#xD;&#xA;&#xD;&#xA;  select   'إيرادات بيع لمبات موفرة' as s,&#xD;&#xA;CAST(ROUND(sum( case when ((( acc_no like '0%' ) &#xD;&#xA;and  SUM_CD IN ('11','12','13')) ) then db_vl-cr_vl else 0 end )/1000, 0)*-1 AS BIGINT)  as s1,&#xD;&#xA;&#xD;&#xA;CAST(ROUND(sum( case when (