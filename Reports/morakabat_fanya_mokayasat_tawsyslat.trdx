#xD;&#xA;CAST(ROUND(sum( case when  (acc_no like '4[6-8]111%' or acc_no like '4[6-8]113%'  )    and sum_Cd in ('12','13')  and cst_cd not like '11%'  then  db_vl-cr_vl else 0 end )/1000, 0) AS BIGINT)  as s1,&#xD;&#xA;&#xD;&#xA;CAST(ROUND(sum( case when ((( acc_no like '0%' ) &#xD;&#xA;and  SUM_CD IN ('11','12','13')) ) then db_vl-cr_vl else 0 end )/1000, 0)*-1 AS BIGINT)  as s2&#xD;&#xA;&#xD;&#xA;from gljrnld  WHERE ( acc_no like '4[6-8]111%' or acc_no like '4[6-8]113%') and  SUM_CD IN ('12','13') and cst_Cd not like '11%' and (1=1)&#xD;&#xA;&#xD;&#xA;  UNION ALL&#xD;&#xA;&#xD;&#xA;select   'باقي خامات ومواد ووقود وقطع غيار' as s,&#xD;&#xA;CAST(ROUND(sum( case when (((acc_no like '4[6-8]1122%' &#xD;&#xA;or acc_no like '4[6-8]1121%' or  acc_no like '4[6-8]1123%' &#xD;&#xA; or acc_no like '4[6-8]114%' or  acc_no like '4[6-8]115%' or  acc_no like '4[6-8]116%' ) &#xD;&#xA;and  SUM_CD IN ('12','13')) ) and cst_Cd not like '11%' then db_vl-cr_vl else 0 end )/1000, 0) AS BIGINT)  as s1,&#xD;&#xA;&#xD;&#xA;CAST(ROUND(sum( case when ((( acc_no like '0%' ) &#xD;&#xA;and  SUM_CD IN ('11','12','13')) ) then db_vl-cr_vl else 0 end )/1000, 0)*-1 AS BIGINT)  as s2&#xD;&#xA;&#xD;&#xA;from gljrnld  WHERE ( acc_no like '4[6-8]1122%' &#xD;&#xA;or acc_no like '4[6-8]1121%' or  acc_no like '4[6-8]1123%' &#xD;&#xA; or acc_no like '4[6-8]114%' or  acc_no like '4[6-8]115%' or  acc_no like '4[6-8]116%' ) and  SUM_CD IN ('12','13') and cst_Cd not like '11%' and (1=1)&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;  UNION ALL&#xD;&#xA;&#xD;&#xA;select   'الأجور' as s,&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;CAST(ROUND(sum( case when ((( acc_no like '0%' ) &#xD;&#xA;and  SUM_CD IN ('11','12','13')) ) then db_vl-cr_vl else 0 end )/1000, 0)*-1 AS BIGINT)  as s1,&#xD;&#xA;CAST(ROUND(sum( case when ( acc_no like '4[6-8]12%'  )  and sum_Cd in ('12','13')  and cst_cd not like '11%'then  db_vl-cr_vl else 0 end )/1000, 0) AS BIGINT)  as s2&#xD;&#xA;&#xD;&#xA;from gljrnld  WHERE (   acc_no like '4[6-8]12%') and  SUM_CD 