13') and cst_Cd not like '11%' and (1=1)&#xD;&#xA;&#xD;&#xA;  UNION ALL&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;select   'نتيجة النشاط' as s,&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;CAST(ROUND(sum( case when ((( acc_no like '0%' ) &#xD;&#xA;and  SUM_CD IN ('11','12','13')) ) then db_vl-cr_vl else 0 end )/1000, 0)*-1 AS BIGINT)  as s1,&#xD;&#xA;(CAST(ROUND(sum( case when ((( acc_no like '5[6-8]122%' or acc_no like '5[6-8]1122102%' ) &#xD;&#xA;and  SUM_CD IN ('11','12','13')) ) then db_vl-cr_vl else 0 end )/1000, 0)*-1 AS BIGINT) &#xD;&#xA;-&#xD;&#xA;&#xD;&#xA;CAST(ROUND(sum( case when (( acc_no like '4[6-8]1%' or acc_no like '4[6-8]2%'   )and sum_cd in ('12','13') and cst_Cd not like '11%')  then db_vl-cr_vl else 0 end )/1000, 0) AS BIGINT))&#xD;&#xA; &#xD;&#xA;&#xD;&#xA; as s2&#xD;&#xA;&#xD;&#xA;from gljrnld  WHERE (acc_no like '5[6-8]122%' or acc_no like '5[6-8]1122102%' or acc_no like '4[6-8]1%'   or acc_no like '4[6-8]2%') and  SUM_CD IN ('12','13') and cst_Cd not like '11%' and (1=1)&#xD;&#xA;" Name="sqlDataSource1" />
