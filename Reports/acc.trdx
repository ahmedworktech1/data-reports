  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="glx2023" SelectCommand="select acc_no,ACC_NM_Ar ,MANACC,dbo.GetAcc_NM(MANACC,0) as man_nm,&#xD;&#xA;(case when acc_ty=1 then 'رئيسي'else 'فرعي' end ) as acc_ty&#xD;&#xA;from glmf &#xD;&#xA;order by acc_no" Name="sqlDataSource1" />
  </DataSources>
