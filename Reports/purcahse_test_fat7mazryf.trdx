<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource1" Width="17cm" Name="purcahse_test_fat7mazryf" xmlns="http://schemas.telerik.com/reporting/2023/1.0">
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="{&quot;@TrNoParam&quot;:&quot;1&quot;,&quot;@LocParam&quot;:&quot;50&quot;,&quot;@TrTyParam&quot;:&quot;115&quot;,&quot;@FNCLTRNO&quot;:&quot;2-مناقصه عامة-2026/2025&quot;}" ConnectionString="azxsandoaa" SelectCommand="SELECT DISTINCT&#xD;&#xA;    aztrh.vst_no,&#xD;&#xA;    aztrh.Rmrk7,&#xD;&#xA;    aztrh.PYMNT_MTHD,&#xD;&#xA;    PM.DSCR_AR AS PYMNT_MTHD_Name,&#xD;&#xA;    aztrh.acc_no,&#xD;&#xA;    aztrh.acc_nm&#xD;&#xA;FROM aztrh&#xD;&#xA;&#xD;&#xA;LEFT JOIN AppCodes PM &#xD;&#xA;    ON PM.ID = '11031' &#xD;&#xA;    AND PM.SEQ = aztrh.PYMNT_MTHD&#xD;&#xA;WHERE &#xD;&#xA;     AZTRH.loc = @LocParam&#xD;&#xA;    AND AZTRH.tr_ty =  @TrTyParam&#xD;&#xA;    AND AZTRH.FNCL_TR_NO = @FNCLTRNO" Name="sqlDataSource1">
      <Parameters>
      <SqlDataSourceParameter DbType="String" Name="@TrNoParam">
          <Value>
            <String>= Parameters.TrNoParam.Value</String>
          </Value>
        </SqlDataSourceParameter>
        <SqlDataSourceParameter DbType="String" Name="@LocParam">
          <Value>
            <String>= Parameters.LocParam.Value</String>
          </Value>
        </SqlDataSourceParameter>
        <SqlDataSourceParameter DbType="Int16" Name="@TrTyParam">
          <Value>
            <String>= Parameters.TrTyParam.Value</String>
          </Value>
        </SqlDataSourceParameter>
        <SqlDataSourceParameter DbType="String" Name="@FNCLTRNO">
          <Value>
            <String>= Parameters.FNCLTRNOparam.Value</String>
          </Value>
        </SqlDataSourceParameter>
      </Parameters>
    </SqlDataSource>
  </DataSources>
