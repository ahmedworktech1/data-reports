<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource1" Width="17cm" Name="MORDEN_AGRA2AT" xmlns="http://schemas.telerik.com/reporting/2023/1.0">
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="azxsandoaa" SelectCommand="SELECT DISTINCT&#xD;&#xA;    aztrh.vst_no,&#xD;&#xA;    azaccmf.acc_no,&#xD;&#xA;    azaccmf.acc_nm_ar&#xD;&#xA;FROM aztrh&#xD;&#xA;INNER JOIN azaccmf &#xD;&#xA;    ON (&#xD;&#xA;        (',' + ISNULL(aztrh.acc_no2, '') + ',' &#xD;&#xA;         LIKE '%,' + '''' + azaccmf.acc_no + '''' + ',%')&#xD;&#xA;        OR (&#xD;&#xA;            ISNULL(aztrh.acc_no2, '') = ''&#xD;&#xA;            AND dbo.StringIntersect(aztrh.RMRK_EXTRA, azaccmf.Acc_Actv, ',') = 1&#xD;&#xA;        )&#xD;&#xA;    )&#xD;&#xA;WHERE aztrh.vst_no = @Vst_No" Name="sqlDataSource1">
      <Parameters>
        <SqlDataSourceParameter DbType="String" Name="@Vst_No" />
      </Parameters>
    </SqlDataSource>
  </DataSources>
  <Items>
    <PageHeaderSection Height="2cm" Name="pageHeaderSection1">
      <Items>
        <TextBox Width="3cm" Height="0.6cm" Left="9.4cm" Top="1.4cm" Value="المورد" Name="textBox2">
          <Style TextAlign="Center" VerticalAlign="Middle" />
        </TextBox>
      </Items>
    </PageHeaderSection>
    <DetailSection Height="1.6cm" Name="detailSection1">
      <Items>
        <TextBox Width="3cm" Height="0.6cm" Left="9.4cm" Top="0cm" Value="= Fields.acc_nm_ar" Name="textBox1" />
      </Items>
    </DetailSection>
    <PageFooterSection Height="0.132cm" Name="pageFooterSection1" />
  </Items>
  <PageSettings PaperKind="A4" Landscape="False">
    <Margins>
      <MarginsU Left="2cm" Right="2cm" Top="2cm" Bottom="2cm" />
    </Margins>
  </PageSettings>
  <StyleSheet>
    <StyleRule>
      <Style>
        <Padding Left="2pt" Right="2pt" />
      </Style>
      <Selectors>
        <TypeSelector Type="TextItemBase" />
        <TypeSelector Type="HtmlTextBox" />
      </Selectors>
    </StyleRule>
  </StyleSheet>
  <ReportParameters>
    <ReportParameter Name="Vst_No" />
  </ReportParameters>
</Report>