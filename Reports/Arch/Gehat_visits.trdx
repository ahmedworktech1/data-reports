<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource1" Width="17cm" Name="Gehat_visits" xmlns="http://schemas.telerik.com/reporting/2023/1.0">
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="archlocal" SelectCommand="SELECT &#xD;&#xA;    ORG_NM_AR as org_nm,&#xD;&#xA;    FORMAT(VISITDATE, 'yyyy-MM') AS visit_dt,&#xD;&#xA;    COUNT(*) AS no_visits&#xD;&#xA;FROM &#xD;&#xA;    visits  &#xD;&#xA;JOIN &#xD;&#xA;    Organization ON visits.OrganizationID = Organization.ORG_NO&#xD;&#xA;WHERE 1=1&#xD;&#xA;    --VISITDATE BETWEEN @StartDate AND @EndDate&#xD;&#xA;GROUP BY  &#xD;&#xA;    ORG_NM_AR, FORMAT(VISITDATE, 'yyyy-MM')&#xD;&#xA;ORDER BY ORG_NM_AR, visit_dt;&#xD;&#xA;" Name="sqlDataSource1" />
  </DataSources>
  <Items>
    <DetailSection Height="1.3cm" Name="detailSection1">
      <Items>
        <TextBox Width="6cm" Height="1.3cm" Left="2.5cm" Top="0cm" Value="= Fields.no_visits" Name="textBox9">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" />
            <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="6.5cm" Height="1.3cm" Left="8.5cm" Top="0cm" Value="= Fields.org_nm" Name="textBox4">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" />
            <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
      </Items>
    </DetailSection>
    <ReportFooterSection Height="0.132cm" Name="reportFooterSection1" />
    <ReportHeaderSection Height="4.8cm" Name="reportHeaderSection1">
      <Style TextAlign="Center" VerticalAlign="Middle" />
