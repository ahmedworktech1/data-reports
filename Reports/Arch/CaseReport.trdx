<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource1" Width="6.5in" Name="CaseReport" xmlns="http://schemas.telerik.com/reporting/2023/1.0">
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="archx" SelectCommand=" SELECT &#xD;&#xA;    c.[CaseID],&#xD;&#xA;    c.[CourtID],&#xD;&#xA;    CASE c.[CaseType]&#xD;&#xA;        WHEN 1 THEN N'القضاء المدني'&#xD;&#xA;        WHEN 2 THEN N'القضاء الإداري'&#xD;&#xA;        WHEN 3 THEN N'القضاء الجنائي'&#xD;&#xA;        ELSE N'غير معروف'&#xD;&#xA;    END AS [CaseTypeName],&#xD;&#xA;    CASE c.[CaseDegree]&#xD;&#xA;        WHEN 11 THEN N'القضية'&#xD;&#xA;        WHEN 12 THEN N'استئناف'&#xD;&#xA;        WHEN 13 THEN N'نقض'&#xD;&#xA;        WHEN 21 THEN N'القضية'&#xD;&#xA;        WHEN 22 THEN N'طعن'&#xD;&#xA;        WHEN 31 THEN N'محكمة جنح أو جنايات'&#xD;&#xA;        WHEN 32 THEN N'محكمة جنح مستأنف/ جنايات مستأنف'&#xD;&#xA;        WHEN 33 THEN N'الطعن بالنقض'&#xD;&#xA;        ELSE N'غير معروف'&#xD;&#xA;    END AS [CaseDegreeName],&#xD;&#xA;    c.[CaseType],&#xD;&#xA;    c.[CaseDegree],&#xD;&#xA;    c.[CaseNumber],&#xD;&#xA;    c.[CaseDescription],&#xD;&#xA;    c.[PlaintiffName],&#xD;&#xA;    c.[DefendantName],&#xD;&#xA;    c.[FilingDate],&#xD;&#xA;    c.[CourtDecision] AS CaseCourtDecision,&#xD;&#xA;    c.[GovernorateID],&#xD;&#xA;    c.[CityID],&#xD;&#xA;    cd.[CaseDId],&#xD;&#xA;    cd.[SessionDate],&#xD;&#xA;    cd.[CourtDecision] AS SessionCourtDecision,&#xD;&#xA;    cd.[CourtName],&#xD;&#xA;    cd.[Governorate],&#xD;&#xA;    cd.[City],&#xD;&#xA;&#x9;ci.DscrAr as CityName,&#xD;&#xA;&#x9;g.DscrAr as GovermentName,&#xD;&#xA;&#x9;cr.CourtName as CrtName&#xD;&#xA;FROM [Cases] c&#xD;&#xA;JOIN [dbo].[CasesD] cd&#xD;&#xA;    ON c.[CaseID] = cd.[CaseId]&#xD;&#xA;JOIN [dbo].[Courts] cr&#xD;&#xA;&#x9;ON cd.CourtName = cr.CourtID&#xD;&#xA;Join [brca_archx12].[Brca].[AppCodes] ci&#xD;&#xA;    ON cd.City = ci.Seq AND ci.Id = 72&#xD;&#xA;Join [brca_archx12].[Brca].[AppCodes] g&#xD;&#xA;    ON cd.Governorate = g.Seq AND g.Id = 71" Name="sqlDataSource1" />
  </DataSources>
  <Items>
    <PageHeaderSection Height="0.5in" Name="pageHeaderSection1" />
    <DetailSection Height="0.2in" Name="detailSection1">
      <Items>
        <TextBox Width="1.2in" Height="0.2in" Left="4.9in" Top="0in" Value="= Fields.CaseDId" Name="textBox9">
          <Style>
            <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="1.5in" Height="0.2in" Left="3.4in" Top="0in" Value="= Fields.SessionDate" Name="textBox12">
          <Style>
            <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="0.8in" Height="0.2in" Left="0.1in" Top="0in" Value="= Fields.SessionCourtDecision" Name="textBox14">
