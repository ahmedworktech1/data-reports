<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="MARTYR NAME" Width="20.3cm" Name="كارت الشهيد" xmlns="http://schemas.telerik.com/reporting/2021/1.0">
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="archxsandoaa" SelectCommand="SELECT&#xD;&#xA;    B.BENEFICIARIE_ID,&#xD;&#xA;    O.ORG_NM_AR AS OrgName,&#xD;&#xA;    B.BENEFICIARIE_NM_AR AS BENEFICIARIE_NM_A,&#xD;&#xA;    dbo._GetArabicNumbers(B.NAT_ID) AS NAT_ID,&#xD;&#xA;    R.RankName,&#xD;&#xA;    RL.DscrAr AS Religion,&#xD;&#xA;    Gov.DscrAr AS Governorate,&#xD;&#xA;    MS.DscrAr AS MaritalStatus,&#xD;&#xA;    CONVERT(NVARCHAR(10), B.DATE_OF_BIRTH, 103) AS DateOfBirth,&#xD;&#xA;    CONVERT(NVARCHAR(10), B.Citation_Date, 103) AS CitationDate,&#xD;&#xA;    CONVERT(NVARCHAR(10), B.Injury_Date, 103) AS InjuryDate,&#xD;&#xA;    B.Mobile1,&#xD;&#xA;    dbo._GetArabicNumbers(B.INSURNC_NO) AS INSURNC_NO,&#xD;&#xA;    B.File_NO,&#xD;&#xA;    B.Last_Decision_No,&#xD;&#xA;    CASE&#xD;&#xA;        WHEN B.Gender = 1 THEN N'ذكر'&#xD;&#xA;        WHEN B.Gender = 2 THEN N'أنثى'&#xD;&#xA;    END AS Gender&#xD;&#xA;FROM BENEFICIARIE B&#xD;&#xA;&#xD;&#xA;LEFT JOIN Organization O&#xD;&#xA;    ON O.ORG_NO = B.ORG&#xD;&#xA;&#xD;&#xA;LEFT JOIN Ranks R&#xD;&#xA;    ON R.RankID = B.RNK&#xD;&#xA;&#xD;&#xA;LEFT JOIN erpx_sandoaa_br.BRCA.AppCodes Gov&#xD;&#xA;    ON Gov.Id = 71&#xD;&#xA;   AND Gov.Seq = B.GOV&#xD;&#xA;&#xD;&#xA;LEFT JOIN erpx_sandoaa_br.BRCA.AppCodes RL&#xD;&#xA;    ON RL.Id = 77&#xD;&#xA;   AND RL.Seq = B.RLGN&#xD;&#xA;&#xD;&#xA;LEFT JOIN erpx_sandoaa_br.BRCA.AppCodes MS&#xD;&#xA;    ON MS.Id = 76&#xD;&#xA;   AND MS.Seq = B.MaritalStatus&#xD;&#xA;WHERE&#xD;&#xA;(&#xD;&#xA;    CAST(B.BENEFICIARIE_ID AS NVARCHAR(50)) = @SearchValue&#xD;&#xA;    OR B.NAT_ID = @SearchValue&#xD;&#xA;    OR B.BENEFICIARIE_NM_AR LIKE N'%' + @SearchValue + N'%'&#xD;&#xA;)" Name="MARTYR NAME">
      <Parameters>
        <SqlDataSourceParameter DbType="String" Name="@SearchValue">
          <Value>
            <String>= Parameters.BeneficiarieId.Value</String>
          </Value>
        </SqlDataSourceParameter>
      </Parameters>
    </SqlDataSource>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="archxsandoaa1" SelectCommand="SELECT&#xD;&#xA;    Rel.DscrAr AS RelationName,&#xD;&#xA;    MB.FullName,&#xD;&#xA;    dbo._GetArabicNumbers(MB.NationalId) AS NationalId,&#xD;&#xA;    EC.Eligibility_Name AS EligibilityStatus,&#xD;&#xA;    Q.DscrAr AS Qualification,&#xD;&#xA;    MB.JobTitle,&#xD;&#xA;    MB.Mobile1,&#xD;&#xA;    MB.FamilyAddress AS Address,&#xD;&#xA;    CASE&#xD;&#xA;        WHEN MB.Gender = 1 THEN N'ذكر'&#xD;&#xA;        WHEN MB.Gender = 2 THEN N'أنثى'&#xD;&#xA;    END AS Gender,&#xD;&#xA;     A.FileName as ImageName&#xD;&#xA;FROM MartyrsBeneficiarie MB&#xD;&#xA;&#xD;&#xA;INNER JOIN BENEFICIARIE B&#xD;&#xA;    ON CAST(B.BENEFICIARIE_ID AS NVARCHAR(50)) = MB.MartyrName&#xD;&#xA;&#xD;&#xA;LEFT JOIN Brca_Appcodes_View Rel&#xD;&#xA;    ON Rel.Id = 79&#xD;&#xA;   AND Rel.Seq = MB.FamilyRelation&#xD;&#xA;&#xD;&#xA;LEFT JOIN EligibilityCases EC&#xD;&#xA;    ON EC.Eligibility_Id = MB.EligibilityStatus&#xD;&#xA;&#xD;&#xA;LEFT JOIN erpx_sandoaa_br.BRCA.AppCodes Q&#xD;&#xA;    ON Q.Id = 78&#xD;&#xA;   AND Q.Seq = MB.Qualification&#xD;&#xA;   LEFT JOIN&#xD;&#xA;(&#xD;&#xA;    SELECT *&#xD;&#xA;    FROM erpx_sandoaa_br.Brca.Attachments&#xD;&#xA;    WHERE EntityName = 'MartyrsBeneficiarie'&#xD;&#xA;      AND Note = N'الصورة الشخصية'&#xD;&#xA;) A&#xD;&#xA;ON A.EntityKey = CAST(MB.MartyrsBeneficiarieId AS NVARCHAR(50))&#xD;&#xA; &#xD;&#xA;WHERE &#xD;&#xA;(&#xD;&#xA;    CAST(B.BENEFICIARIE_ID AS NVARCHAR(50)) = @SearchValue&#xD;&#xA;    OR B.NAT_ID = @SearchValue&#xD;&#xA;    OR B.BENEFICIARIE_NM_AR LIKE N'%' + @SearchValue + N'%'&#xD;&#xA;)&#xD;&#xA;AND MB.FamilyRelation IN (1, 2)" Name="fath&amp;moth">
      <Parameters>
        <SqlDataSourceParameter DbType="String" Name="@SearchValue">
          <Value>
            <String>= Parameters.BeneficiarieId.Value</String>
          </Value>
        </SqlDataSourceParameter>
      </Parameters>
    </SqlDataSource>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="archxsandoaa2" SelectCommand="SELECT&#xD;&#xA;    Rel.DscrAr AS RelationName,&#xD;&#xA;    MB.FullName,&#xD;&#xA;    dbo._GetArabicNumbers(MB.NationalId) AS NationalId,&#xD;&#xA;    EC.Eligibility_Name AS EligibilityStatus,&#xD;&#xA;    Q.DscrAr AS Qualification,&#xD;&#xA;    MB.JobTitle,&#xD;&#xA;    MB.Mobile1,&#xD;&#xA;    MB.FamilyAddress AS Address,&#xD;&#xA;    CONVERT(NVARCHAR(10), MB.DateOfBirth, 103) AS DateOfBirth,&#xD;&#xA;    MB.Age,&#xD;&#xA;    CASE&#xD;&#xA;        WHEN MB.Gender = 1 THEN N'ذكر'&#xD;&#xA;        WHEN MB.Gender = 2 THEN N'أنثى'&#xD;&#xA;    END AS Gender&#xD;&#xA;    ,&#xD;&#xA;     A.FileName as ImageName&#xD;&#xA;FROM MartyrsBeneficiarie MB&#xD;&#xA;&#xD;&#xA;INNER JOIN BENEFICIARIE B&#xD;&#xA;    ON CAST(B.BENEFICIARIE_ID AS NVARCHAR(50)) = MB.MartyrName&#xD;&#xA;&#xD;&#xA;LEFT JOIN Brca_Appcodes_View Rel&#xD;&#xA;    ON Rel.Id = 79&#xD;&#xA;   AND Rel.Seq = MB.FamilyRelation&#xD;&#xA;&#xD;&#xA;LEFT JOIN EligibilityCases EC&#xD;&#xA;    ON EC.Eligibility_Id = MB.EligibilityStatus&#xD;&#xA;&#xD;&#xA;LEFT JOIN erpx_sandoaa_br.BRCA.AppCodes Q&#xD;&#xA;    ON Q.Id = 78&#xD;&#xA;   AND Q.Seq = MB.Qualification&#xD;&#xA;   LEFT JOIN&#xD;&#xA;(&#xD;&#xA;    SELECT *&#xD;&#xA;    FROM erpx_sandoaa_br.Brca.Attachments&#xD;&#xA;    WHERE EntityName = 'MartyrsBeneficiarie'&#xD;&#xA;      AND Note = N'الصورة الشخصية'&#xD;&#xA;) A&#xD;&#xA;ON A.EntityKey = CAST(MB.MartyrsBeneficiarieId AS NVARCHAR(50))&#xD;&#xA;&#xD;&#xA;WHERE&#xD;&#xA;(&#xD;&#xA;    CAST(B.BENEFICIARIE_ID AS NVARCHAR(50)) = @SearchValue&#xD;&#xA;    OR B.NAT_ID = @SearchValue&#xD;&#xA;    OR B.BENEFICIARIE_NM_AR LIKE N'%' + @SearchValue + N'%'&#xD;&#xA;)&#xD;&#xA;AND MB.FamilyRelation IN (3, 4, 5, 6)&#xD;&#xA;&#xD;&#xA;ORDER BY&#xD;&#xA;    MB.FamilyRelation,&#xD;&#xA;    MB.DateOfBirth;" Name="wife&amp;child">
      <Parameters>
        <SqlDataSourceParameter DbType="String" Name="@SearchValue">
          <Value>
            <String>= Parameters.BeneficiarieId.Value</String>
          </Value>
        </SqlDataSourceParameter>
      </Parameters>
    </SqlDataSource>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="archxsandoaa3" SelectCommand="SELECT&#xD;&#xA;    ST.ServiceName AS Service,&#xD;&#xA;    Rel.DscrAr AS RelationName,&#xD;&#xA;    ISNULL(MB.FullName, B.BENEFICIARIE_NM_AR) AS FullName,&#xD;&#xA;    dbo._GetArabicNumbers(GSS.Cost) AS Amount,&#xD;&#xA;    ISNULL(GSS.TR_NO, GSS.JRN_CD) AS ExchangeCode,&#xD;&#xA;    CONVERT(NVARCHAR(10), GSS.Payment_Date, 103) AS ServiceDate&#xD;&#xA;FROM Guidance_Study_Services GSS&#xD;&#xA;&#xD;&#xA;INNER JOIN BENEFICIARIE B&#xD;&#xA;    ON B.BENEFICIARIE_ID = GSS.MartyrId&#xD;&#xA;&#xD;&#xA;LEFT JOIN ServicesTypes ST&#xD;&#xA;    ON ST.Service_Type = GSS.Service_Type&#xD;&#xA;&#xD;&#xA;LEFT JOIN MartyrsBeneficiarie MB&#xD;&#xA;    ON MB.MartyrsBeneficiarieId = GSS.Beneficiary_Code&#xD;&#xA;&#xD;&#xA;LEFT JOIN Brca_Appcodes_View Rel&#xD;&#xA;    ON Rel.Id = 79&#xD;&#xA;   AND Rel.Seq = GSS.FamilyRelation&#xD;&#xA;&#xD;&#xA;WHERE&#xD;&#xA;(&#xD;&#xA;    CAST(B.BENEFICIARIE_ID AS NVARCHAR(50)) = @SearchValue&#xD;&#xA;    OR B.NAT_ID = @SearchValue&#xD;&#xA;    OR B.BENEFICIARIE_NM_AR LIKE N'%' + @SearchValue + N'%'&#xD;&#xA;)&#xD;&#xA;AND GSS.Payment_Status = 1&#xD;&#xA;&#xD;&#xA;ORDER BY GSS.Payment_Date DESC;" Name="Services">
      <Parameters>
        <SqlDataSourceParameter DbType="String" Name="@SearchValue">
          <Value>
            <String>= Parameters.BeneficiarieId.Value</String>
          </Value>
        </SqlDataSourceParameter>
      </Parameters>
    </SqlDataSource>
  </DataSources>
