<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource1" Width="29.7cm" Name="VisitsQuery" xmlns="http://schemas.telerik.com/reporting/2023/1.0">
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="archlocal" SelectCommand="SELECT FORMAT(VISITDATE, 'yyyy-MM-dd') AS VISIT_DATE,NATIONALID,VisitorName,ORG_NM_AR,(SELECT ORG_NM_AR FROM Organization &#xD;&#xA; JOIN VISITS ON Visits.DepartmentID = Organization.ORG_NO)AS DEP_NM,VisitReason,FORMAT(ArrivalTime, 'HH:mm') AS ARRIVAL_DATE,FORMAT(DepartureTime, 'HH:mm') AS DEP_DATE,PhoneNumber FROM Visits LEFT JOIN Visitors ON Visits.VisitorID = Visitors.VisitorID LEFT JOIN Organization ON Visits.OrganizationID=Organization.ORG_NO AND Visits.OrganizationID = Organization.ORG_NO&#xD;&#xA;" Name="sqlDataSource1" />
  </DataSources>
  <Items>
    <DetailSection Height="1.3cm" Name="detailSection1">
      <Items>
        <TextBox Width="2.4cm" Height="1.3cm" Left="27.2cm" Top="0cm" Value="= Fields.VISIT_DATE" Name="textBox11">
