<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="webServiceDataSource1" Width="17cm" PageNumberingStyle="Continue" Name="VisitorsPerPeriodrpt" xmlns="http://schemas.telerik.com/reporting/2023/1.0">
  <Style>
    <BorderStyle Bottom="None" />
    <BorderColor Bottom="Black" />
    <BorderWidth Bottom="1pt" />
  </Style>
  <DataSources>
    <WebServiceDataSource ParameterValues="{&quot;.AspNetCore.Identity.Application&quot;:,&quot;@Url&quot;:,&quot;FromStrtDt&quot;:,&quot;ToStrtDt&quot;:,&quot;FromMonth&quot;:,&quot;ToMonth&quot;:}" AuthParameterValues="null" ServiceUrl="@Url" Name="webServiceDataSource1">
      <Parameters>
        <WebServiceParameter WebServiceParameterType="Cookie" Name=".AspNetCore.Identity.Application">
          <Value>
            <String>= Parameters.login.Value</String>
          </Value>
        </WebServiceParameter>
        <WebServiceParameter WebServiceParameterType="Inline" Name="@Url">
          <Value>
            <String>= Parameters.Url.Value + "arch/QueryVisits/GetVisits"</String>
          </Value>
        </WebServiceParameter>
        <WebServiceParameter WebServiceParameterType="Query" Name="FromStrtDt">
          <Value>
            <String>= Parameters.FromStrtDt.Value</String>
          </Value>
        </WebServiceParameter>
        <WebServiceParameter WebServiceParameterType="Query" Name="ToStrtDt">
          <Value>
            <String>= Parameters.ToStrtDt.Value</String>
          </Value>
        </WebServiceParameter>
        <WebServiceParameter WebServiceParameterType="Query" Name="FromMonth">
          <Value>
            <String>= Parameters.FromMonth.Value</String>
          </Value>
        </WebServiceParameter>
        <WebServiceParameter WebServiceParameterType="Query" Name="ToMonth">
          <Value>
            <String>= Parameters.ToMonth.Value</String>
          </Value>
        </WebServiceParameter>
      </Parameters>
    </WebServiceDataSource>
  </DataSources>
