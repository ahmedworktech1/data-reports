<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="MainInformation" Width="21cm" Name="Injured_Details" Zoom="1.5" xmlns="http://schemas.telerik.com/reporting/2023/1.0">
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="archxsandoaa" SelectCommand="SELECT *FROM (&#xD;&#xA;SELECT&#xD;&#xA;    G.Guidance_Study_No,&#xD;&#xA;    REVERSE(dbo._GetArabicNumbers(G.Guidance_Study_No)) AS Guidance_Study_No_Arabic,&#xD;&#xA;    G.Service_Type,&#xD;&#xA;&#xD;&#xA;    -- Optimized service name selection&#xD;&#xA;     dbo._GetArabicNumbers(CASE G.Service_Type &#xD;&#xA;        WHEN 1 THEN SMain.ServiceName&#xD;&#xA;        WHEN 2 THEN SSub.ServiceName&#xD;&#xA;        WHEN 3 THEN SSub.ServiceName&#xD;&#xA;        ELSE N'غير معروف'&#xD;&#xA;    END) AS ServiceName,&#xD;&#xA;&#xD;&#xA;    -- Format date&#xD;&#xA;    dbo._GetArabicNumbers(CONVERT(varchar, G.Guidance_Study_Dt, 111)) AS GuidanceStudyDt,&#xD;&#xA;&#xD;&#xA;&#x9;-- Cost&#xD;&#xA;&#x9;HPR.PROPOSAL_NO,&#xD;&#xA;&#x9;HPR.PROPOSAL_DSCR,&#xD;&#xA;&#x9;HPR.COST&#xD;&#xA;&#xD;&#xA;FROM GuidanceStudy_H G&#xD;&#xA;LEFT JOIN ServicesTypes SMain ON SMain.ServiceID = G.Main_Service&#xD;&#xA;LEFT JOIN ServicesTypes SSub ON SSub.ServiceID = G.Sub_Service&#xD;&#xA;LEFT JOIN Guidance_Study_Financ_Propsls HPR ON HPR.Guidance_Study_No = G.Guidance_Study_No&#xD;&#xA;) AS Results&#xD;&#xA;WHERE 1=1" Name="MainInformation" />
    <SqlDataSource QueryDesignerState="null" ParameterValues="{&quot;@StudyNo&quot;:&quot;01000000&quot;,&quot;@ProposalNo&quot;:&quot;1&quot;}" ConnectionString="archxsandoaa" SelectCommand="SELECT &#xD;&#xA;    GTN.Guidance_Study_No,&#xD;&#xA;    ORG.ORG_NM_AR AS Org_Name_Arabic,&#xD;&#xA;    ORG.ORG_NO,&#xD;&#xA;    &#xD;&#xA;    CASE GTN.Service_Type&#xD;&#xA;        WHEN 1 THEN N'نعويض المرة الواحدة'&#xD;&#xA;        WHEN 2 THEN N'منحة مالية'&#xD;&#xA;        WHEN 3 THEN N'خدمة مالية'&#xD;&#xA;        ELSE N'غير معروف'&#xD;&#xA;    END AS Service_Type_Desc,&#xD;&#xA;    &#xD;&#xA;    FORMAT(GTN.EntryDate, 'dd/MM/yy') AS EntryDate,&#xD;&#xA;    GTN.Martyrs_Or_Victims,&#xD;&#xA;    GTN.Injured,&#xD;&#xA;    &#xD;&#xA;    ISNULL(BI.RejectedInjured, 0) AS RejectedInjured,&#xD;&#xA;    ISNULL(BM.RejectedMartyrs, 0) AS RejectedMartyrs,&#xD;&#xA;&#xD;&#xA;&#x9;-- Cost Details&#xD;&#xA;    SUM(CASE WHEN SCT.FileType = 1 AND SCT.org = GTN.Org THEN ISNULL(SCT.ServiceCost, 0) ELSE 0 END) AS MartyrsCost,&#xD;&#xA;    SUM(CASE WHEN SCT.FileType = 3 AND SCT.org = GTN.Org THEN ISNULL(SCT.ServiceCost, 0) ELSE 0 END) AS InjuredCost,&#xD;&#xA;&#x9;SCT.ProposalNo&#xD;&#xA;&#xD;&#xA;FROM Guidance_Total_Number GTN&#xD;&#xA;&#xD;&#xA;LEFT JOIN Organization ORG &#xD;&#xA;    ON ORG.ORG_NO = GTN.Org&#xD;&#xA;&#xD;&#xA;LEFT JOIN Guidance_Study_ServiceCostingTmp SCT &#xD;&#xA;    ON SCT.GuidanceStudyNo = GTN.Guidance_Study_No&#xD;&#xA;&#xD;&#xA;OUTER APPLY (&#xD;&#xA;    SELECT COUNT(*) AS RejectedInjured&#xD;&#xA;    FROM BENEFICIARIE B&#xD;&#xA;    WHERE &#xD;&#xA;        B.Guidance_Study_Related LIKE '%' + @StudyNo + 'R%' &#xD;&#xA;        AND B.FILE_TYP = 3 &#xD;&#xA;        AND B.ORG = GTN.Org&#xD;&#xA;) BI&#xD;&#xA;&#xD;&#xA;OUTER APPLY (&#xD;&#xA;    SELECT COUNT(*) AS RejectedMartyrs&#xD;&#xA;    FROM BENEFICIARIE B&#xD;&#xA;    WHERE &#xD;&#xA;        B.Guidance_Study_Related LIKE '%' + @StudyNo + 'R%' &#xD;&#xA;        AND B.FILE_TYP = 1 &#xD;&#xA;        AND B.ORG = GTN.Org&#xD;&#xA;) BM&#xD;&#xA;&#xD;&#xA;WHERE &#xD;&#xA;    GTN.Guidance_Study_No = @StudyNo&#xD;&#xA;&#xD;&#xA;GROUP BY&#xD;&#xA;    GTN.Guidance_Study_No,&#xD;&#xA;&#x9;SCT.ProposalNo,&#xD;&#xA;    ORG.ORG_NM_AR,&#xD;&#xA;    ORG.ORG_NO,&#xD;&#xA;    GTN.Service_Type,&#xD;&#xA;    GTN.EntryDate,&#xD;&#xA;    GTN.Martyrs_Or_Victims,&#xD;&#xA;    GTN.Injured,&#xD;&#xA;    BI.RejectedInjured,&#xD;&#xA;    BM.RejectedMartyrs&#xD;&#xA;&#xD;&#xA;ORDER BY &#xD;&#xA;    ORG.ORG_NO ASC;" Name="TotalsNumbers">
      <Parameters>
        <SqlDataSourceParameter DbType="String" Name="@StudyNo">
          <Value>
            <String>= Parameters.StudyNoParam.Value</String>
          </Value>
        </SqlDataSourceParameter>
      </Parameters>
    </SqlDataSource>
  </DataSources>
  <Items>
