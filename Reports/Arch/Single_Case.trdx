<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource1" Width="19cm" Name="Single_Case" xmlns="http://schemas.telerik.com/reporting/2023/1.0">
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="ArchAswan1" SelectCommand="&#xD;&#xA;WITH PartyData AS&#xD;&#xA;(&#xD;&#xA;    SELECT&#xD;&#xA;        CASES.CaseID,&#xD;&#xA;&#x9;Cases.CaseType,&#xD;&#xA;        MAX(CASE WHEN CaseParticipant.PartyType = 1 THEN CaseParticipant.PartyName END) AS Party_1,&#xD;&#xA;        MAX(CASE WHEN CaseParticipant.PartyType = 1 THEN N'مدعي' END) AS Party_1_Type,&#xD;&#xA;        MAX(CASE WHEN CaseParticipant.PartyType = 1 THEN CaseParticipant.NationalId END) AS Party_1_Nat_NO,&#xD;&#xA;        MAX(CASE WHEN CaseParticipant.PartyType = 2 THEN CaseParticipant.PartyName END) AS Party_2,&#xD;&#xA;        MAX(CASE WHEN CaseParticipant.PartyType = 2 THEN N'مدعي عليه' END) AS Party_2_Type,&#xD;&#xA;        MAX(CASE WHEN CaseParticipant.PartyType = 2 THEN CaseParticipant.NationalId END) AS Party_2_Nat_NO&#xD;&#xA;    FROM CASES&#xD;&#xA;    OUTER APPLY&#xD;&#xA;    (&#xD;&#xA;        SELECT *&#xD;&#xA;        FROM CaseParticipant&#xD;&#xA;        WHERE CaseParticipant.CaseParticipantId IN&#xD;&#xA;        (&#xD;&#xA;            SELECT TRY_CAST(&#xD;&#xA;                   REPLACE(REPLACE(REPLACE(LTRIM(RTRIM(value)), '''', ''), ',', ''), ' ', '') AS INT)&#xD;&#xA;            FROM STRING_SPLIT(&#xD;&#xA;                ISNULL(CASES.PlaintiffName,'') + ',' + ISNULL(CASES.DefendantName,''),&#xD;&#xA;                ','&#xD;&#xA;            )&#xD;&#xA;            WHERE value &lt;&gt; ''&#xD;&#xA;        )&#xD;&#xA;    ) CaseParticipant&#xD;&#xA;    GROUP BY CASES.CaseID,Cases.CaseType&#xD;&#xA;)&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;, Events AS&#xD;&#xA;(&#xD;&#xA;&#xD;&#xA;    SELECT &#xD;&#xA;        CASES.CaseID,&#xD;&#xA;&#x9;Cases.CaseType,&#xD;&#xA;        CONVERT(VARCHAR(10), CasesD.SessionDate, 103) AS Event_Date,&#xD;&#xA;        CasesD.CourtDecision AS Event_Decision,&#xD;&#xA;        'جلسة' AS Event_Type&#xD;&#xA;    FROM CASES&#xD;&#xA;    LEFT JOIN CasesD ON CASES.CaseID = CasesD.CaseId&#xD;&#xA;&#xD;&#xA;    UNION ALL&#xD;&#xA;&#xD;&#xA; &#xD;&#xA;    SELECT&#xD;&#xA;        CASES.CaseID,&#xD;&#xA;&#x9;Cases.CaseType,&#xD;&#xA;        CONVERT(VARCHAR(10), Appeals.AppealDate, 103) AS Event_Date,&#xD;&#xA;        Appeals.ApealDecision AS Event_Decision,&#xD;&#xA;        'استئناف' AS Event_Type&#xD;&#xA;    FROM CASES&#xD;&#xA;    LEFT JOIN Appeals ON CASES.CaseID = Appeals.CaseId&#xD;&#xA;)&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;SELECT &#xD;&#xA;    Cases.CaseID,&#xD;&#xA;    Cases.CaseType,&#xD;&#xA;    CASES.CaseNumber AS CASE_NUM,&#xD;&#xA;    YEAR(CASES.FILINGDATE) AS CASE_YEAR,&#xD;&#xA;    Courts.CourtName AS COURT_NAM,&#xD;&#xA;    Courts.Circuit,&#xD;&#xA;    CASES.AppealNumber,&#xD;&#xA;    YEAR(CASES.APPEALDATE) AS APP_YEAR,&#xD;&#xA;    PYEMPMF_H.EMP_NAME AS SPECIALST,&#xD;&#xA;    CASES.Managment_WaredNo AS MANG_WARED,&#xD;&#xA;&#xD;&#xA; &#xD;&#xA;    PartyData.Party_1,&#xD;&#xA;    PartyData.Party_1_Type,&#xD;&#xA;    PartyData.Party_1_Nat_NO,&#xD;&#xA;    PartyData.Party_2,&#xD;&#xA;    PartyData.Party_2_Type,&#xD;&#xA;    PartyData.Party_2_Nat_NO,&#xD;&#xA;&#xD;&#xA;    CASES.LawyerName AS VS_Lawyer,&#xD;&#xA;    CASES.CaseDescription AS descr,&#xD;&#xA;&#xD;&#xA;    Events.Event_Date,&#xD;&#xA;    Events.Event_Type,&#xD;&#xA;    Events.Event_Decision&#xD;&#xA;&#xD;&#xA;FROM CASES&#xD;&#xA;&#xD;&#xA;LEFT JOIN Courts ON CASES.CourtID = Courts.CourtID&#xD;&#xA;LEFT JOIN PYEMPMF_H ON CASES.SpecialistName = PYEMPMF_H.EMP_NO&#xD;&#xA;LEFT JOIN PartyData ON CASES.CaseID = PartyData.CaseID&#xD;&#xA;LEFT JOIN Events ON CASES.CaseID = Events.CaseID&#xD;&#xA;&#xD;&#xA;WHERE (1=1)&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;ORDER BY CASES.CaseNumber, Events.Event_Date;&#xD;&#xA;" Name="sqlDataSource1" />
  </DataSources>
