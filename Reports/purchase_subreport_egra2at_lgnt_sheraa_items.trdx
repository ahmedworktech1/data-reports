<?xml version="1.0" encoding="utf-8"?>
<Report Width="6.5in" Name="egra2at_lgnt_sheraa_items" xmlns="http://schemas.telerik.com/reporting/2023/1.0">
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="azxsandoaa" SelectCommand="SELECT&#xD;&#xA;    T.ITM_CD,&#xD;&#xA;    I.ITM_NM_AR,&#xD;&#xA;    T.TR_TY,&#xD;&#xA;    T.TR_NO,&#xD;&#xA;    T.LOC,&#xD;&#xA;    T.QTY1,&#xD;&#xA;    T.PKPRC,&#xD;&#xA;    (T.QTY1 * T.PKPRC) AS TOTAL_PRC,&#xD;&#xA;    T.purchas_NO,&#xD;&#xA;    T.RMRK2,&#xD;&#xA;&#xD;&#xA;    TRANSLATE(CAST(ROW_NUMBER() OVER (ORDER BY T.ITM_CD, T.TR_NO) AS nvarchar(10)), N'0123456789', N'٠١٢٣٤٥٦٧٨٩') AS ROW_NO_TXT,&#xD;&#xA;    TRANSLATE(FORMAT(T.QTY1, '#,##0.##', 'en-US'), N'0123456789', N'٠١٢٣٤٥٦٧٨٩') AS QTY1_TXT,&#xD;&#xA;    TRANSLATE(FORMAT(T.QTY1 * T.PKPRC, 'N2', 'en-US'), N'0123456789', N'٠١٢٣٤٥٦٧٨٩') AS TOTAL_PRC_TXT,&#xD;&#xA;    TRANSLATE(FORMAT(SUM(T.QTY1 * T.PKPRC) OVER (), 'N2', 'en-US'), N'0123456789', N'٠١٢٣٤٥٦٧٨٩') AS GRAND_TOTAL_TXT&#xD;&#xA;FROM&#xD;&#xA;    AZTRD T&#xD;&#xA;INNER JOIN&#xD;&#xA;    AZITMS I ON T.ITM_CD = I.ITM_CD&#xD;&#xA;WHERE&#xD;&#xA;    T.TR_TY = 311&#xD;&#xA;    AND T.TR_NO = @TR_NO&#xD;&#xA;ORDER BY&#xD;&#xA;    T.ITM_CD, T.TR_NO;" Name="sqlDataSource1">
      <Parameters>
        <SqlDataSourceParameter Name="@TR_NO">
          <Value>
            <String>=Parameters.TR_NO.Value</String>
          </Value>
        </SqlDataSourceParameter>
      </Parameters>
    </SqlDataSource>
  </DataSources>
