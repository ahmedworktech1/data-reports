  <Style BackgroundColor="198, 217, 241" />
  <DataSources>
    <WebServiceDataSource ParameterValues="{&quot;.AspNetCore.Identity.Application&quot;:,&quot;@Url&quot;:,&quot;FromBldCd&quot;:,&quot;ToBldCd&quot;:,&quot;BldCds&quot;:,&quot;BldCd&quot;:,&quot;FromOwner&quot;:,&quot;ToOwner&quot;:,&quot;Country&quot;:,&quot;AreaCd&quot;:,&quot;BldState&quot;:,&quot;BldCat&quot;:}" AuthParameterValues="null" ServiceUrl="@Url" Name="webServiceDataSource1">
      <Parameters>
        <WebServiceParameter WebServiceParameterType="Cookie" Name=".AspNetCore.Identity.Application">
          <Value>
            <String>= Parameters.login.Value</String>
          </Value>
        </WebServiceParameter>
        <WebServiceParameter WebServiceParameterType="Inline" Name="@Url">
