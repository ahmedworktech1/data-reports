<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource1" Width="20cm" Name="Contracts report-39" ShowSnapGrid="True" xmlns="http://schemas.telerik.com/reporting/2021/1.0">
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="AQALHAFEZ" SelectCommand="SELECT        TOP (100) PERCENT dbo.AQRENT_H.Tr_NO,&#xD;&#xA;                             (SELECT        BLD_DSCR_AR&#xD;&#xA;                                FROM            dbo.BLDMF&#xD;&#xA;                                WHERE        (BLD_CD = dbo.AQRENT_H.BLD_CD)) AS BLD_DSCR_AR,&#xD;&#xA;                             (SELECT        TENANT_Nm_AR&#xD;&#xA;                                FROM            dbo.tenantMF&#xD;&#xA;                                WHERE        (TENANT_NO = dbo.AQRENT_H.TENANT_NO)) AS TENANT_NM_AR, UNTMF_1.UNT_DSCR_AR, dbo.AQRENT_H.INS, ISNULL(dbo.REP_AQCOLLECT_H.collect_ty, 0) AS collect_ty, &#xD;&#xA;                         CASE WHEN collect_ty = 1 THEN 'محصل' ELSE 'غير محصل' END AS DEC, CASE WHEN REP_AQCOLLECT_H.Collect_Stat = 1 THEN 'منشأ' ELSE 'غير منشأ' END AS CREAT, &#xD;&#xA;                         CASE WHEN DOC_TYP = 1 THEN 'سارى' ELSE CASE WHEN DOC_TYP = 2 THEN 'ملغى' ELSE ' ' END END AS STAT, ISNULL(dbo.REP_AQCOLLECT_H.PAYED_AMT, 0) AS PAYED_AMT, dbo.REP_AQCOLLECT_H.RCPT_NO&#xD;&#xA;FROM            dbo.AQRENT_H INNER JOIN&#xD;&#xA;                         dbo.UNTMF AS UNTMF_1 ON dbo.AQRENT_H.Tr_NO = UNTMF_1.DOC_NO LEFT OUTER JOIN&#xD;&#xA;                         dbo.REP_AQCOLLECT_H ON dbo.AQRENT_H.Tr_NO = dbo.REP_AQCOLLECT_H.CONTRACT_NO&#xD;&#xA;WHERE        (NOT (dbo.AQRENT_H.INS IS NULL))&#xD;&#xA;ORDER BY dbo.AQRENT_H.Tr_NO" Name="sqlDataSource1" />
  </DataSources>
