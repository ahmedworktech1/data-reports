<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="webServiceDataSource1" Width="9.716in" UnitOfMeasure="Mm" Name="OwnerReport" SnapToGrid="False" SnapToSnapLines="False" ShowDimensions="False" ShowWatermarks="False" xmlns="http://schemas.telerik.com/reporting/2021/1.0">
  <Style BackgroundColor="198, 217, 241" />
  <DataSources>
    <WebServiceDataSource ParameterValues="{&quot;.AspNetCore.Identity.Application&quot;:,&quot;@Url&quot;:,&quot;FromOwner&quot;:,&quot;ToOwner&quot;:,&quot;Owners&quot;:,&quot;Owner&quot;:,&quot;FromBldCd&quot;:,&quot;ToBldCd&quot;:,&quot;Nationality&quot;:}" AuthParameterValues="null" ServiceUrl="@Url" Name="webServiceDataSource1">
      <Parameters>
        <WebServiceParameter WebServiceParameterType="Cookie" Name=".AspNetCore.Identity.Application">
          <Value>
            <String>= Parameters.login.Value</String>
          </Value>
        </WebServiceParameter>
        <WebServiceParameter WebServiceParameterType="Inline" Name="@Url">
          <Value>
            <String>= Parameters.Url.Value + "aq/ReportOwner/GetData"</String>
          </Value>
        </WebServiceParameter>
        <WebServiceParameter WebServiceParameterType="Query" Name="FromOwner">
          <Value>
            <String>= Parameters.FromOwner.Value</String>
