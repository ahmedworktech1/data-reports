  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="{&quot;@Loc&quot;:&quot;50&quot;,&quot;@FnclTrNo&quot;:&quot;3-ممارسه محدودة-2026/2025&quot;}" ConnectionString="azxsandoaa" SelectCommand="SELECT DISTINCT&#xD;&#xA;    aztrh.LTOT AS المبلغ,&#xD;&#xA;    aztrh.acc_nm AS اسم_الشركة&#xD;&#xA;FROM aztrh&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;WHERE &#xD;&#xA;  --  azaccmf.stpd = '1'&#xD;&#xA;     AZTRH.loc = @Loc&#xD;&#xA;    AND AZTRH.tr_ty =  @TrTy&#xD;&#xA;    AND AZTRH.FNCL_TR_NO = @FnclTrNo" Name="sqlDataSource1">
      <Parameters>
        <SqlDataSourceParameter DbType="String" Name="@Loc">
          <Value>
            <String>= Parameters.Loc.Value</String>
          </Value>
        </SqlDataSourceParameter>
        <SqlDataSourceParameter DbType="Int16" Name="@TrTy">
          <Value>
            <String>= Parameters.TrTy.Value</String>
          </Value>
        </SqlDataSourceParameter>
        <SqlDataSourceParameter DbType="String" Name="@FnclTrNo">
          <Value>
            <String>= Parameters.FnclTrNo.Value</String>
          </Value>
        </SqlDataSourceParameter>
      </Parameters>
    </SqlDataSource>
