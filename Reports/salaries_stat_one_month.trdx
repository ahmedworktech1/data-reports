<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource1" Width="29.7cm" Name="QueryGlJrnl1" xmlns="http://schemas.telerik.com/reporting/2021/1.0">
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="glx" SelectCommand="select sum_Cd ,&#xD;&#xA;(select SUM_NM_Ar from glsums where sum_Cd=gljrnld.sum_Cd)as sumname,&#xD;&#xA;(Select DSCR_AR From AppCodes  where AppCodes.ID ='106' and seq = (select SUM_CATG from glsums where sum_Cd = GLJRNLD.sum_cd  ))as JOB ,&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;sum(case when (GLJRNLD.ACC_NO LIKE '100601%' ) AND  gljrnld.sum_Cd &lt;&gt;0   then db_vl-cr_vl else 0 end) as tot,&#xD;&#xA;MIN(YEAR(GLJRNLD.TR_dT)) YYM,&#xD;&#xA;MAX(YEAR(GLJRNLD.TR_dT)) YYMN&#xD;&#xA;&#xD;&#xA; &#xD;&#xA; &#xD;&#xA;from gljrnld where  (GLJRNLD.ACC_NO LIKE '100601%' ) AND gljrnld.sum_Cd &lt;&gt;0   and (1=1)&#xD;&#xA;&#xD;&#xA;GROUP BY   GLJRNLD.sum_Cd,GLJRNLD.SUM_cD&#xD;&#xA;" Name="sqlDataSource1" />
  </DataSources>
