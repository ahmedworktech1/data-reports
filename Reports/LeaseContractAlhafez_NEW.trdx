  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="AQDATA20191" SelectCommand="SELECT dbo.AQ_vacate.SNO, dbo.AQ_vacate.TR_NO, dbo.AQ_vacate.TR_DT, dbo.tenantMF.TENANT_Nm_AR, dbo.tenantMF.TENANT_Nm_EN, dbo.AQRENT_H.UNTS, dbo.BLDMF.BLD_DSCR_AR, dbo.BLDMF.BLD_DSCR_EN, &#xD;&#xA;                 dbo.AQ_vacate.Rmrk, dbo.AQRENT_H.INS, dbo.AQRENT_H.Unts_Dscrs, dbo.AQ_vacate.Exit_dt, dbo.BLDMF.AREA_CD, dbo.AQLISTS.REC_TYPE, dbo.AQLISTS.DSCR_AR&#xD;&#xA;FROM    dbo.AQRENT_H INNER JOIN&#xD;&#xA;                 dbo.AQ_vacate ON dbo.AQRENT_H.Tr_NO = dbo.AQ_vacate.TR_NO INNER JOIN&#xD;&#xA;                 dbo.tenantMF ON dbo.AQRENT_H.TENANT_NO = dbo.tenantMF.TENANT_NO INNER JOIN&#xD;&#xA;                 dbo.BLDMF ON dbo.AQRENT_H.BLD_CD = dbo.BLDMF.BLD_CD INNER JOIN&#xD;&#xA;                 dbo.AQLISTS ON dbo.BLDMF.AREA_CD = dbo.AQLISTS.CODE&#xD;&#xA;WHERE ( dbo.AQLISTS.REC_TYPE = 2) " Name="sqlDataSource1" />
  </DataSources>
