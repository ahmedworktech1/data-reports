  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="archxsandoaa" SelectCommand="SELECT&#xD;&#xA;    -- الشهداء اللي ليهم مستفيدين&#xD;&#xA;    COUNT(DISTINCT CASE WHEN B.ORG = 1 AND MB.MartyrName IS NOT NULL THEN B.BENEFICIARIE_ID END) AS dfnsBenf,&#xD;&#xA;    COUNT(DISTINCT CASE WHEN B.ORG = 2 AND MB.MartyrName IS NOT NULL THEN B.BENEFICIARIE_ID END) AS policeBenf,&#xD;&#xA;    COUNT(DISTINCT CASE WHEN B.ORG = 3 AND MB.MartyrName IS NOT NULL THEN B.BENEFICIARIE_ID END) AS tadamnBenf,&#xD;&#xA;&#xD;&#xA;    -- الشهداء اللي ماعندهمش مستفيدين&#xD;&#xA;    COUNT(DISTINCT CASE WHEN B.ORG = 1 AND MB.MartyrName IS NULL THEN B.BENEFICIARIE_ID END) AS dfnsNoBenf,&#xD;&#xA;    COUNT(DISTINCT CASE WHEN B.ORG = 2 AND MB.MartyrName IS NULL THEN B.BENEFICIARIE_ID END) AS policeNoBenf,&#xD;&#xA;    COUNT(DISTINCT CASE WHEN B.ORG = 3 AND MB.MartyrName IS NULL THEN B.BENEFICIARIE_ID END) AS tadamnNoBenf&#xD;&#xA;FROM &#xD;&#xA;    BENEFICIARIE B&#xD;&#xA;LEFT JOIN &#xD;&#xA;    MartyrsBeneficiarie MB ON B.BENEFICIARIE_ID = MB.MartyrName&#xD;&#xA;WHERE &#xD;&#xA;    B.FILE_TYP = 1&#xD;&#xA;    AND B.ORG IN (1, 2, 3)" Name="sqlDataSource2" />
  </DataSources>
