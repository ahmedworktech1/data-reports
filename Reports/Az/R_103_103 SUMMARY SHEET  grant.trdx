<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource1" Width="297mm" Name="Report" xmlns="http://schemas.telerik.com/reporting/2021/1.0">
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="GLELmostdama" SelectCommand="SELECT LEFT (GLJRNLD.ACC_NO,4) ,&#xD;&#xA;(SELECT ACC_NM_AR FROM GLMF WHERE ACC_NO=LEFT (GLJRNLD.ACC_NO,4))AS NM,&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;SUM(CASE WHEN LN_TY=1 AND ( SUM_CD not like'0102%' AND GLJRNLD.SUM_CD NOT LIKE '0103%' OR SUM_CD ='' OR SUM_CD IS NULL) THEN CUR_VL ELSE 0 END)-SUM(CASE WHEN LN_TY=-1 AND ( SUM_CD not like '0102%' OR SUM_CD ='' OR SUM_CD IS NULL) THEN CUR_VL ELSE 0 END) AS CUR,&#xD;&#xA;SUM(CASE WHEN ( SUM_CD not like '0102%' AND GLJRNLD.SUM_CD NOT LIKE '0103%' OR SUM_CD ='' OR SUM_CD IS NULL) THEN DB_VL-CR_VL ELSE 0 END ) AS NET,&#xD;&#xA;SUM(CASE WHEN SUM_CD like '0102%' THEN (CUR_VL) ELSE 0 END ) AS MMMM,&#xD;&#xA;SUM(CASE WHEN SUM_CD like '0102%' THEN (DB_VL-CR_VL) ELSE 0 END ) AS MMMM1,&#xD;&#xA;(SUM(CASE WHEN LN_TY=1 AND ( SUM_CD not like '0102%' AND GLJRNLD.SUM_CD NOT LIKE '0103%' OR SUM_CD ='' OR SUM_CD IS NULL) THEN CUR_VL ELSE 0 END)-&#xD;&#xA;SUM(CASE WHEN LN_TY=-1 AND ( SUM_CD not like '0102%' AND GLJRNLD.SUM_CD NOT LIKE '0103%' OR SUM_CD ='' OR SUM_CD IS NULL) THEN CUR_VL ELSE 0 END))+&#xD;&#xA;SUM(CASE WHEN SUM_CD like '0102%' THEN (CUR_VL) ELSE 0 END ) AS NET111,&#xD;&#xA;SUM(CASE WHEN ( SUM_CD not like '0102%' AND GLJRNLD.SUM_CD NOT LIKE '0103%' OR SUM_CD ='' OR SUM_CD IS NULL) THEN DB_VL-CR_VL ELSE 0 END )+&#xD;&#xA;SUM(CASE WHEN SUM_CD like '0102%' THEN (DB_VL-CR_VL) ELSE 0 END ) AS NET22222&#xD;&#xA; FROM GLJRNLD&#xD;&#xA;WHERE 1=1&#xD;&#xA;GROUP BY LEFT (GLJRNLD.ACC_NO,4)" Name="sqlDataSource1" />
  </DataSources>
