  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="azxaboghalyreal" SelectCommand="SELECT  *,&#xD;&#xA;       &#xD;&#xA; -- Running total for CUR_VL_D - CUR_VL_C&#xD;&#xA;       CASE  WHEN SUM(ACCSTAT_W.CUR_VL_D - ACCSTAT_W.CUR_VL_C) OVER (PARTITION BY ACCSTAT_W.acc_no ORDER BY ACCSTAT_W.tr_no) &gt; 0 &#xD;&#xA;           THEN SUM(ACCSTAT_W.CUR_VL_D - ACCSTAT_W.CUR_VL_C) OVER (PARTITION BY ACCSTAT_W.acc_no ORDER BY ACCSTAT_W.tr_no)&#xD;&#xA;           ELSE 0&#xD;&#xA;       END AS DB1,&#xD;&#xA; -- Running total for CUR_VL_C - CUR_VL_D&#xD;&#xA;       CASE WHEN SUM(ACCSTAT_W.CUR_VL_C - ACCSTAT_W.CUR_VL_D) OVER (PARTITION BY ACCSTAT_W.acc_no ORDER BY ACCSTAT_W.tr_no) &gt; 0 &#xD;&#xA;           THEN SUM(ACCSTAT_W.CUR_VL_C - ACCSTAT_W.CUR_VL_D) OVER (PARTITION BY ACCSTAT_W.acc_no ORDER BY ACCSTAT_W.tr_no)&#xD;&#xA;           ELSE 0&#xD;&#xA;       END AS CR1&#xD;&#xA;FROM ACCSTAT_W &#xD;&#xA;WHERE ACCSTAT_W.TR_TY in ('307' ,'101') &#xD;&#xA;and 1=1&#xD;&#xA;" Name="sqlDataSource1" />
  </DataSources>
