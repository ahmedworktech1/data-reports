  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="glx2024meniakahraba" SelectCommand="SELECT 'الأجور' AS s,&#xD;&#xA;    CAST(ROUND(SUM(CASE WHEN acc_no LIKE '0%' THEN db_vl - cr_vl ELSE 0 END), 3) AS DECIMAL (18,3)) AS s1,&#xD;&#xA;    CAST(ROUND(SUM(CASE WHEN acc_no LIKE '0%' THEN db_vl - cr_vl ELSE 0 END), 3) AS DECIMAL (18,3)) AS s2,&#xD;&#xA;    CAST(ROUND(SUM(CASE WHEN acc_no LIKE '0%' THEN db_vl - cr_vl ELSE 0 END), 3) AS DECIMAL (18,3)) AS s3,&#xD;&#xA;    CAST(ROUND(SUM(CASE WHEN acc_no LIKE '0%' THEN db_vl - cr_vl ELSE 0 END), 3) AS DECIMAL (18,3)) AS s4,&#xD;&#xA;    CAST(ROUND(SUM(CASE WHEN acc_no LIKE '0%' THEN db_vl - cr_vl ELSE 0 END), 3) AS DECIMAL (18,3)) AS s5,&#xD;&#xA;    CAST(ROUND(SUM(CASE WHEN acc_no LIKE '0%' THEN db_vl - cr_vl ELSE 0 END), 3) AS DECIMAL (18,3)) AS s6,&#xD;&#xA;    CAST(ROUND(SUM(CASE WHEN acc_no LIKE '0%' THEN db_vl - cr_vl ELSE 0 END), 3) AS DECIMAL (18,3)) AS s7,&#xD;&#xA;    CAST(ROUND(SUM(CASE WHEN acc_no LIKE '0%' THEN db_vl - cr_vl ELSE 0 END), 3) AS DECIMAL (18,3)) AS s8,&#xD;&#xA;    CAST(ROUND(SUM(CASE WHEN acc_no LIKE '0%' THEN db_vl - cr_vl ELSE 0 END), 3) AS DECIMAL (18,3)) AS s9,&#xD;&#xA;    CAST(ROUND(SUM(CASE WHEN acc_no LIKE '0%' THEN db_vl - cr_vl ELSE 0 END), 3) AS DECIMAL (18,3)) AS tot&#xD;&#xA;FROM gljrnld  &#xD;&#xA;WHERE acc_no LIKE '0%' AND 1 &lt;&gt; 1&#xD;&#xA;&#xD;&#xA;UNION ALL&#xD;&#xA;&#xD;&#xA;SELECT 'مراكز الإنتاج' AS s,&#xD;&#xA;    ROUND(&#xD;&#xA;        CAST(&#xD;&#xA;            SUM(CASE WHEN acc_no LIKE '4[6]12%' AND SUM_CD = '11' AND gljrnld.cst_Cd LIKE '0402%' THEN db_vl - cr_vl ELSE 0 END) &#xD;&#xA;            AS NUMERIC&#xD;&#xA;        ) &#xD;&#xA;        / &#xD;&#xA;        NULLIF(&#xD;&#xA;            SUM(CASE WHEN (acc_no LIKE '5[6-8]1111101%' OR acc_no LIKE '5[6-8]1111102%') AND gljrnld.cst_Cd LIKE '0402%' THEN VAL1 ELSE 0 END), &#xD;&#xA;            0&#xD;&#xA;        ) &#xD;&#xA;        * 100, &#xD;&#xA;    3) AS s1,&#xD;&#xA;&#xD;&#xA;   