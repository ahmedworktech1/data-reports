     AS NUMERIC&#xD;&#xA;        ) &#xD;&#xA;        / &#xD;&#xA;        NULLIF(&#xD;&#xA;            SUM(CASE WHEN (acc_no LIKE '5[6-8]1111101%' OR acc_no LIKE '5[6-8]1111102%') AND gljrnld.cst_Cd LIKE '0407%' THEN VAL1 ELSE 0 END), &#xD;&#xA;            0&#xD;&#xA;        ) &#xD;&#xA;        * 100, &#xD;&#xA;    3)*-1&#xD;&#xA;&#x9;-&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;    ROUND(&#xD;&#xA;        CAST(&#xD;&#xA;            SUM(CASE WHEN (acc_no like '4[6-8]1%' or acc_no like '4[6-8]2%' or acc_no like '4[6-8]3%') AND SUM_CD = '11' AND gljrnld.cst_Cd LIKE '0407%' THEN db_vl - cr_vl ELSE 0 END) &#xD;&#xA;            AS NUMERIC&#xD;&#xA;        ) &#xD;&#xA;        / &#xD;&#xA;        NULLIF(&#xD;&#xA;            SUM(CASE WHEN (acc_no LIKE '5[6-8]1111101%' OR acc_no LIKE '5[6-8]1111102%') AND gljrnld.cst_Cd LIKE '0407%' THEN VAL1 ELSE 0 END), &#xD;&#xA;            0&#xD;&#xA;        ) &#xD;&#xA;        * 100, &#xD;&#xA;    3)) AS s6,&#xD;&#xA;    (ROUND(&#xD;&#xA;        CAST(&#xD;&#xA;            SUM(CASE WHEN (acc_no LIKE '5[6-8]1111101%' OR acc_no LIKE '5[6-8]1111102%') AND SUM_CD = '11' AND gljrnld.cst_Cd LIKE '0408%' THEN db_vl - cr_vl ELSE 0 END) &#xD;&#xA;            AS NUMERIC&#xD;&#xA;        ) &#xD;&#xA;        / &#xD;&#xA;        NULLIF(&#xD;&#xA;            SUM(CASE WHEN (acc_no LIKE '5[6-8]1111101%' OR acc_no LIKE '5[6-8]1111102%') AND gljrnld.cst_Cd LIKE '0408%' THEN VAL1 ELSE 0 END), &#xD;&#xA;            0&#xD;&#xA;        ) &#xD;&#xA;        * 100, &#xD;&#xA;    3)*-1&#xD;&#xA;&#x9;-&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;    ROUND(&#xD;&#xA;        CAST(&#xD;&#xA;            SUM(CASE WHEN (acc_no like '4[6-8]1%' or acc_no like '4[6-8]2%' or acc_no like '4[6-8]3%') AND SUM_CD = '11' AND gljrnld.cst_Cd LIKE '0408%' THEN db_vl - cr_vl ELSE 0 END) &#xD;&#xA;            AS NUMERIC&#xD;&#xA;        ) &#xD;&#xA;        / &#xD;&#xA;        NULLIF(&#xD;&#xA;            SUM(CASE WHEN (acc_no LIKE '5[6-8]1111101%' OR acc_no LIKE '5[6-8]1111102%') AND gljrnld.cst_Cd LIK