<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource1" Width="28cm" Name="testReportNew" xmlns="http://schemas.telerik.com/reporting/2023/1.0">
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="azx2024" SelectCommand=";WITH MainData AS (&#xD;&#xA;    SELECT &#xD;&#xA;        accstat_w.ACC_NM, &#xD;&#xA;        accstat_w.ACC_NO,&#xD;&#xA;        accstat_w.TR_NO,&#xD;&#xA;        accstat_w.TR_TY,&#xD;&#xA;        accstat_w.LOC,&#xD;&#xA;        accstat_w.C_BAL, &#xD;&#xA;        accstat_w.CR_VL, &#xD;&#xA;        accstat_w.CST_CD, &#xD;&#xA;        accstat_w.CST_NM, &#xD;&#xA;        accstat_w.DB_VL, &#xD;&#xA;        accstat_w.GRP,&#xD;&#xA;        accstat_w.ITM_CD, &#xD;&#xA;        accstat_w.ITM_NM, &#xD;&#xA;        accstat_w.LN_NO, &#xD;&#xA;        accstat_w.PKPRC, &#xD;&#xA;        accstat_w.PRD_NO, &#xD;&#xA;        accstat_w.QTY, &#xD;&#xA;        accstat_w.RC_TY, &#xD;&#xA;        accstat_w.SSUM_CD, &#xD;&#xA;        accstat_w.SSUM_NM, &#xD;&#xA;        accstat_w.SUM_CD, &#xD;&#xA;        accstat_w.SUM_NM, &#xD;&#xA;        accstat_w.TR_DS, &#xD;&#xA;        accstat_w.TR_DSCR, &#xD;&#xA;        accstat_w.TR_DT, &#xD;&#xA;        accstat_w.TR_NM&#xD;&#xA;    FROM dbo.accstat_w&#xD;&#xA;    WHERE 1=1&#xD;&#xA;),&#xD;&#xA;&#xD;&#xA;OpeningBalance AS (&#xD;&#xA;    SELECT &#xD;&#xA;        ACC_NM,&#xD;&#xA;        ACC_NO,&#xD;&#xA;        CAST(NULL AS VARCHAR(50))  AS TR_NO,&#xD;&#xA;        CAST(NULL AS VARCHAR(50))  AS TR_TY,&#xD;&#xA;        CAST(NULL AS VARCHAR(50))  AS LOC,&#xD;&#xA;        CAST(NULL AS NUMERIC(18,2)) AS C_BAL,&#xD;&#xA;        CASE WHEN SUM(CR_VL - DB_VL) &gt; 0 THEN SUM(CR_VL - DB_VL) ELSE 0 END AS CR_VL,&#xD;&#xA;        CAST(NULL AS VARCHAR(50))  AS CST_CD,&#xD;&#xA;        CAST(NULL AS VARCHAR(50))  AS CST_NM,&#xD;&#xA;        CASE WHEN SUM(DB_VL - CR_VL) &gt; 0 THEN SUM(DB_VL - CR_VL) ELSE 0 END AS DB_VL,&#xD;&#xA;        CAST(NULL AS VARCHAR(50))  AS GRP,&#xD;&#xA;        CAST(NULL AS VARCHAR(50))  AS ITM_CD,&#xD;&#xA;        CAST(NULL AS VARCHAR(50))  AS ITM_NM,&#xD;&#xA;        CAST(NULL AS INT)           AS LN_NO,&#xD;&#xA;        CAST(NULL AS NUMERIC(18,2)) AS PKPRC,&#xD;&#xA;        CAST(NULL AS VARCHAR(50))  AS PRD_NO,&#xD;&#xA;        CAST(NULL AS NUMERIC(18,2)) AS QTY,&#xD;&#xA;        CAST(NULL AS VARCHAR(50))  AS RC_TY,&#xD;&#xA;        CAST(NULL AS VARCHAR(50))  AS SSUM_CD,&#xD;&#xA;        CAST(NULL AS VARCHAR(50))  AS SSUM_NM,&#xD;&#xA;        CAST(NULL AS VARCHAR(50))  AS SUM_CD,&#xD;&#xA;        CAST(NULL AS VARCHAR(50))  AS SUM_NM,&#xD;&#xA;        CAST(NULL AS VARCHAR(50))  AS TR_DS,&#xD;&#xA;        CAST(N'رصيد أول المدة' AS NVARCHAR(200)) AS TR_DSCR,&#xD;&#xA;        CAST(DATEADD(DAY, -1, @DateFrom) AS DATE)  AS TR_DT,&#xD;&#xA;        CAST(N'رصيد أول المدة' AS NVARCHAR(200)) AS TR_NM&#xD;&#xA;    FROM dbo.accstat_w&#xD;&#xA;    WHERE 1=1&#xD;&#xA;    GROUP BY ACC_NM, ACC_NO&#xD;&#xA;)&#xD;&#xA;&#xD;&#xA;SELECT &#xD;&#xA;    ob_or_main.ACC_NM,&#xD;&#xA;    ob_or_main.ACC_NO,&#xD;&#xA;    ob_or_main.TR_NO,&#xD;&#xA;    ob_or_main.TR_TY,&#xD;&#xA;    ob_or_main.LOC,&#xD;&#xA;    ob_or_main.C_BAL,&#xD;&#xA;    ob_or_main.CR_VL,&#xD;&#xA;    ob_or_main.CST_CD,&#xD;&#xA;    ob_or_main.CST_NM,&#xD;&#xA;    ob_or_main.DB_VL,&#xD;&#xA;    ob_or_main.GRP,&#xD;&#xA;&#xD;&#xA;    CASE &#xD;&#xA;        WHEN SUM(COALESCE(DB_VL,0) - COALESCE(CR_VL,0)) OVER (&#xD;&#xA;            PARTITION BY ACC_NO &#xD;&#xA;            ORDER BY TR_DT, LOC, TR_TY, TR_NO, LN_NO&#xD;&#xA;        ) &gt; 0 &#xD;&#xA;        THEN SUM(COALESCE(DB_VL,0) - COALESCE(CR_VL,0)) OVER (&#xD;&#xA;            PARTITION BY ACC_NO &#xD;&#xA;            ORDER BY TR_DT, LOC, TR_TY, TR_NO, LN_NO&#xD;&#xA;        )&#xD;&#xA;        ELSE 0 &#xD;&#xA;    END AS DB1,&#xD;&#xA;&#xD;&#xA;    CASE &#xD;&#xA;        WHEN SUM(COALESCE(CR_VL,0) - COALESCE(DB_VL,0)) OVER (&#xD;&#xA;            PARTITION BY ACC_NO &#xD;&#xA;            ORDER BY TR_DT, LOC, TR_TY, TR_NO, LN_NO&#xD;&#xA;        ) &gt; 0 &#xD;&#xA;        THEN SUM(COALESCE(CR_VL,0) - COALESCE(DB_VL,0)) OVER (&#xD;&#xA;            PARTITION BY ACC_NO &#xD;&#xA;            ORDER BY TR_DT, LOC, TR_TY, TR_NO, LN_NO&#xD;&#xA;        )&#xD;&#xA;        ELSE 0 &#xD;&#xA;    END AS CR1,&#xD;&#xA;&#xD;&#xA;    SUM(COALESCE(DB_VL, 0) - COALESCE(CR_VL, 0)) OVER (&#xD;&#xA;        PARTITION BY ACC_NO &#xD;&#xA;        ORDER BY TR_DT, LOC, TR_TY, TR_NO, LN_NO&#xD;&#xA;    ) AS Balance,&#xD;&#xA;&#xD;&#xA;    ob_or_main.ITM_CD,&#xD;&#xA;    ob_or_main.ITM_NM,&#xD;&#xA;    ob_or_main.LN_NO,&#xD;&#xA;    ob_or_main.PKPRC,&#xD;&#xA;    ob_or_main.PRD_NO,&#xD;&#xA;    ob_or_main.QTY,&#xD;&#xA;    ob_or_main.RC_TY,&#xD;&#xA;    ob_or_main.SSUM_CD,&#xD;&#xA;    ob_or_main.SSUM_NM,&#xD;&#xA;    ob_or_main.SUM_CD,&#xD;&#xA;    ob_or_main.SUM_NM,&#xD;&#xA;    ob_or_main.TR_DS,&#xD;&#xA;    ob_or_main.TR_DSCR,&#xD;&#xA;    ob_or_main.TR_DT,&#xD;&#xA;    ob_or_main.TR_NM&#xD;&#xA;&#xD;&#xA;FROM (&#xD;&#xA;    SELECT * FROM OpeningBalance&#xD;&#xA;    UNION ALL&#xD;&#xA;    SELECT * FROM MainData&#xD;&#xA;) AS ob_or_main&#xD;&#xA;&#xD;&#xA;ORDER BY TR_DT, LOC, TR_TY, TR_NO, LN_NO" Name="sqlDataSource1" />
    <SqlDataSource QueryDesignerState="null" ParameterValues="{&quot;@AccNoParam&quot;:&quot;1&quot;}" ConnectionString="azx2024" SelectCommand="SELECT (select SSUM_NM_Ar from GLSSUMS where glssums.ssum_cd =GLCHKSMF_V.SSUM_CD)sum_nm_ar,&#xD;&#xA; (select dscr_ar from glx2026..AppCodes where id =50 and AppCodes.SEQ = GLCHKSMF_V.CHK_TYP )no3_chek,* from GLCHKSMF_V where stat = '1'  AND SSUM_CD = @AccNoParam&#xD;&#xA;and 1=1&#xD;&#xA;ORDER BY DUE_DT" Name="sqlDataSource2">
      <Parameters>
        <SqlDataSourceParameter DbType="String" Name="@AccNoParam">
          <Value>
            <String>= Parameters.AccNoParam.Value</String>
          </Value>
        </SqlDataSourceParameter>
      </Parameters>
    </SqlDataSource>
