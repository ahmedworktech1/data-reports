            <TextBox Width="2.2cm" Height="0.6cm" Left="14.7cm" Top="0.098cm" Value="=Sum(Fields.CR_VL)" Format="{0:0.00}" Name="txtTotalCR_VL">
              <Style BackgroundColor="185, 205, 229" TextAlign="Center" VerticalAlign="Bottom">
