<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource1" Width="21cm" Name="Report" xmlns="http://schemas.telerik.com/reporting/2023/1.0">
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="GLX" SelectCommand="SELECT 1 AS NUM,&#xD;&#xA;(SUM(CASE WHEN LN_TY=1 AND (ACC_NO='102122' and jrn_cd = '2') and (9=9) THEN CUR_VL ELSE 0 END)-&#xD;&#xA;SUM(CASE WHEN LN_TY=-1 AND (ACC_NO='102122' and jrn_cd = '2') and (9=9) THEN CUR_VL ELSE 0 END))&#xD;&#xA;  AS DD,&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;(SUM(CASE WHEN LN_TY=1 AND (ACC_NO like '100[1-6]%' and jrn_cd = '2') and (7=7) THEN CUR_VL ELSE 0 END)-&#xD;&#xA;SUM(CASE WHEN LN_TY=-1 AND (ACC_NO like '100[1-6]%' and jrn_cd = '2') and (7=7) THEN CUR_VL ELSE 0 END))&#xD;&#xA;AS DD1,&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;(SUM(CASE WHEN LN_TY=1 AND (ACC_NO ='2002' and jrn_cd = '2') and (9=9) THEN CUR_VL ELSE 0 END)-&#xD;&#xA;SUM(CASE WHEN LN_TY=-1 AND (ACC_NO='2002' and jrn_cd = '2') and (9=9) THEN CUR_VL ELSE 0 END))*-1 AS D,&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;(SUM(CASE WHEN LN_TY=1 AND (ACC_NO='102121' and jrn_cd = '2') and (9=9) THEN CUR_VL ELSE 0 END)-&#xD;&#xA;SUM(CASE WHEN LN_TY=-1 AND (ACC_NO='102121' and jrn_cd = '2') and (9=9) THEN CUR_VL ELSE 0 END)) AS D1,&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;(SUM(CASE WHEN LN_TY=1 AND ((ACC_NO='199901' or ACC_NO='199902' or ACC_NO='199904') and jrn_cd = '2') and (9=9) THEN CUR_VL ELSE 0 END)-&#xD;&#xA;SUM(CASE WHEN LN_TY=-1 AND ((ACC_NO='199901' or ACC_NO='199902' or ACC_NO='199904') and jrn_cd = '2') and (9=9) THEN CUR_VL ELSE 0 END)) AS D111111,&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;(select  CNTRCTR_NM from glmf where acc_no=102121) as d55555,&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;SUM(CASE WHEN GLJRNLD.ACC_NO = '102121'AND JRN_CD='04'and ln_ty=1 and (9=9) THEN CUR_VL ELSE 0 END )-&#xD;&#xA;SUM(CASE WHEN GLJRNLD.ACC_NO = '102121'AND JRN_CD='04'and ln_ty=-1 and (9=9) THEN CUR_VL ELSE 0 END )&#xD;&#xA; AS DDDD,&#xD;&#xA; &#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA; &#xD;&#xA; (select location from glmf where acc_no='102121')as ddd22&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA; FROM GLJRNLD&#xD;&#xA; WHERE jrn_Cd = '2' &#xD;&#xA;SELECT 1 AS NUM,&#xD;&#xA;(SUM(CASE WHEN LN_TY=1 AND (ACC_NO='102122' and jrn_cd = '2') and (9=9) THEN CUR_VL ELSE 0 END)-&#xD;&#xA;SUM(CASE WHEN LN_TY=-1 AND (ACC_NO='102122' and jrn_cd = '2') and (9=9) THEN CUR_VL ELSE 0 END))&#xD;&#xA;  AS DD,&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;(SUM(CASE WHEN LN_TY=1 AND (ACC_NO like '100[1-6]%' and jrn_cd = '2') and (7=7) THEN CUR_VL ELSE 0 END)-&#xD;&#xA;SUM(CASE WHEN LN_TY=-1 AND (ACC_NO like '100[1-6]%' and jrn_cd = '2') and (7=7) THEN CUR_VL ELSE 0 END))&#xD;&#xA;AS DD1,&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;(SUM(CASE WHEN LN_TY=1 AND (ACC_NO ='2002' and jrn_cd = '2') and (9=9) THEN CUR_VL ELSE 0 END)-&#xD;&#xA;SUM(CASE WHEN LN_TY=-1 AND (ACC_NO='2002' and jrn_cd = '2') and (9=9) THEN CUR_VL ELSE 0 END))*-1 AS D,&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;(SUM(CASE WHEN LN_TY=1 AND (ACC_NO='102121' and jrn_cd = '2') and (9=9) THEN CUR_VL ELSE 0 END)-&#xD;&#xA;SUM(CASE WHEN LN_TY=-1 AND (ACC_NO='102121' and jrn_cd = '2') and (9=9) THEN CUR_VL ELSE 0 END)) AS D1,&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;(SUM(CASE WHEN LN_TY=1 AND ((ACC_NO='199901' or ACC_NO='199902' or ACC_NO='199904') and jrn_cd = '2') and (9=9) THEN CUR_VL ELSE 0 END)-&#xD;&#xA;SUM(CASE WHEN LN_TY=-1 AND ((ACC_NO='199901' or ACC_NO='199902' or ACC_NO='199904') and jrn_cd = '2') and (9=9) THEN CUR_VL ELSE 0 END)) AS D111111,&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;(select  CNTRCTR_NM from glmf where acc_no=102121) as d55555,&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;SUM(CASE WHEN GLJRNLD.ACC_NO = '102121'AND JRN_CD='04'and ln_ty=1 and (9=9) THEN CUR_VL ELSE 0 END )-&#xD;&#xA;SUM(CASE WHEN GLJRNLD.ACC_NO = '102121'AND JRN_CD='04'and ln_ty=-1 and (9=9) THEN CUR_VL ELSE 0 END )&#xD;&#xA; AS DDDD,&#xD;&#xA; &#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA; &#xD;&#xA; (select location from glmf where acc_no='102121')as ddd22&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA; FROM GLJRNLD&#xD;&#xA; WHERE jrn_Cd = '2' &#xD;&#xA;" Name="sqlDataSource1" />
  </DataSources>
