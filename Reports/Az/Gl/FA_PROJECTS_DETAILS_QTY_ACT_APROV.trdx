  </Style>
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="glx2023tarheel" SelectCommand="select ItmCd,(select DSCR_AR from AppCodes where id='1006' and SEQ=ItmCd) as itmNm&#xD;&#xA;,ProjNo,&#xD;&#xA;(select proj_nm_ar from FA_PROJECTSCoding where PROJ_NO=FA_PROJECTS_DETAILS.ProjNo) as proNm,&#xD;&#xA;sum(case when TR_TY='200' then QTY else 0 end) as qtyDone&#xD;&#xA;,(sum(case when TR_TY='1'  then QTY else 0 end)&#xD;&#xA;-&#xD;&#xA;sum(case when TR_TY='101' then QTY else 0 end)) as qtyAct&#xD;&#xA;from FA_PROJECTS_DETAILS where&#xD;&#xA;ItmCd is not null&#xD;&#xA;and 1=1&#xD;&#xA;group by ProjNo,ItmCd&#xD;&#xA; having (&#xD;&#xA;(sum(case when TR_TY='1'  then QTY else 0 end)&#xD;&#xA;-&#xD;&#xA;sum(case when TR_TY='101' then QTY else 0 end)) &gt;&#xD;&#xA;sum(case when TR_TY='200' then QTY else 0 end)&#xD;&#xA; )&#xD;&#xA; order by ProjNo,ItmCd&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;" Name="sqlDataSource1" />
  </DataSources>
