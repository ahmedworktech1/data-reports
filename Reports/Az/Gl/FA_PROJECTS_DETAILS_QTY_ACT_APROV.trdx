<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource1" Width="21.2cm" UnitOfMeasure="Cm" Name="FA_PROJECTS_DETAILS_QTY_ACT_APROV" ShowDimensions="False" xmlns="http://schemas.telerik.com/reporting/2021/1.0">
  <Style Visible="True">
    <BorderStyle Top="Groove" Bottom="Groove" Left="Groove" Right="Groove" />
    <BorderColor Top="37, 64, 97" Bottom="37, 64, 97" Left="37, 64, 97" Right="37, 64, 97" />
