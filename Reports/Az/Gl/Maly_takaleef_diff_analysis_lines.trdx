  <Style Visible="True" />
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="glx2024" SelectCommand="select case when (Acc_NO like '4[6-8]1%' or  Acc_NO like '4[6-8]2%' or Acc_NO like '4[6-8]3%' or Acc_NO like '5[6-8]111%' or Acc_NO like '5[6-8]112%' or Acc_NO like '5[6-8]121%'  or Acc_NO like '5[6-8]122%'  ) then left(acc_no,1)+substring(acc_no,3,15) else acc_no end  as acc ,&#xD;&#xA;DBO.getAcc_NM(case when (Acc_NO like '4[6-8]1%' or  Acc_NO like '4[6-8]2%' or Acc_NO like '4[6-8]3%' or Acc_NO like '5[6-8]111%' or Acc_NO like '5[6-8]112%' or Acc_NO like '5[6-8]121%'  or Acc_NO like '5[6-8]122%' ) then left(acc_no,1)+substring(acc_no,3,15) else acc_no end,0)as acc_nm,&#xD;&#xA;case when (Acc_NO like '4[6-8]1%' or  Acc_NO like '4[6-8]2%' or Acc_NO like '4[6-8]3%' or Acc_NO like '5[6-8]111%' or Acc_NO like '5[6-8]112%' or Acc_NO like '5[6-8]121%'  or Acc_NO like '5[6-8]122%' ) then left(acc_no,1)+substring(acc_no,3,1) else left(acc_no,2) end  as macc ,&#xD;&#xA;DbO.GEtACC_NM(case when (Acc_NO like '4[6-8]1%' or  Acc_NO like '4[6-8]2%' or Acc_NO like '4[6-8]3%' or Acc_NO like '5[6-8]111%' or Acc_NO like '5[6-8]112%' or Acc_NO like '5[6-8]121%'  or Acc_NO like '5[6-8]122%' ) then left(acc_no,1)+substring(acc_no,3,1) else left(acc_no,2) end,0 ) as macc_nm ,&#xD;&#xA;LEFT(case when (Acc_NO like '4[6-8]1%' or  Acc_NO like '4[6-8]2%' or Acc_NO like '4[6-8]3%' or Acc_NO like '5[6-8]111%' or Acc_NO like '5[6-8]112%' or Acc_NO like '5[6-8]121%'  or Acc_NO like '5[6-8]122%' ) then left(acc_no,1)+substring(acc_no,3,15) else acc_no end,3)  as acc3 ,&#xD;&#xA;DbO.GEtACC_NM(LEFT(case when (Acc_NO like '4[6-8]1%' or  Acc_NO like '4[6-8]2%' or Acc_NO like '4[6-8]3%' or Acc_NO like '5[6-8]111%' or Acc_NO like '5[6-8]112%' or Acc_NO like '5[6-8]121%'  or Acc_NO like '5[6-8]122%' ) then left(acc_no,1)+substring(acc_no,3,15) else acc_no end,3),0)  as acc_NM3 ,&#xD;&#xA;sum(case when (acc_no like '41%') or (acc_no like '42%') OR (acc_no like '43%') or Acc_NO like '5111%' or Acc_NO like '5112%' or Acc_NO like '5121%'  or Acc_NO like '5122%'   then db_vl-cr_vl else 0 end) as s3,&#xD;&#xA; sum(case when (acc_no like '461%') or (acc_no like '462%')  or (acc_no like '463%') or Acc_NO like '5[6]111%' or Acc_NO like '5[6]112%' or Acc_NO like '5[6]121%'  or Acc_NO like '5[6]122%'  then db_vl-cr_vl else 0 end) as s36,&#xD;&#xA; sum(case when (acc_no like '471%') or (acc_no like '472%')  or (acc_no like '473%') or Acc_NO like '5[7]111%' or Acc_NO like '5[7]112%' or Acc_NO like '5[7]121%'  or Acc_NO like '5[7]122%'  then db_vl-cr_vl else 0 end) as s37,&#xD;&#xA; sum(case when (acc_no like '481%') or (acc_no like '482%') or (acc_no like '483%') or Acc_NO like '5[8]111%' or Acc_NO like '5[8]112%' or Acc_NO like '5[8]121%'  or Acc_NO like '5[8]122%' then db_vl-cr_vl else 0 end) as s38,&#xD;&#xA; sum(case when ((Acc_NO like '4[6-8]1%' or  Acc_NO like '4[6-8]2%' or Acc_NO like '4[6-8]3%' or Acc_NO like '5[6-8]1%' ) ) then db_vl-cr_vl else 0 end) as s678,&#xD;&#xA; (sum(case when (acc_no like '41%') or (acc_no like '42%') or (acc_no like '43%') or Acc_NO like '5111%' or Acc_NO like '5112%' or Acc_NO like '5121%'  or Acc_NO like '5122%'  then db_vl-cr_vl else 0 end)&#xD;&#xA; -&#xD;&#xA; (sum(case when (acc_no like '461%') or (acc_no like '462%')  or (acc_no like '463%') or Acc_NO like '5[6]111%' or Acc_NO like '5[6]112%' or Acc_NO like '5[6]121%'  or Acc_NO like '5[6]122%'  then db_vl-cr_vl else 0 end)&#xD;&#xA; +&#xD;&#xA;  sum(case when (acc_no like '471%') or (acc_no like '472%') or (acc_no like '473%')  or Acc_NO like '5[7]111%' or Acc_NO like '5[7]112%' or Acc_NO like '5[7]121%'  or Acc_NO like '5[7]122%'  then db_vl-cr_vl else 0 end)&#xD;&#xA;  +&#xD;&#xA;  sum(case when (acc_no like '481%') or (acc_no like '482%')  or (acc_no like '483%') or Acc_NO like '5[8]111%' or Acc_NO like '5[8]112%' or Acc_NO like '5[8]121%'  or Acc_NO like '5[8]122%' then db_vl-cr_vl else 0 end))) as diff&#xD;&#xA;&#xD;&#xA;&#xD;&#xA; from gljrnld &#xD;&#xA;where ((acc_no like '41%') or (acc_no like '42%') OR (acc_no like '43%') or Acc_NO like '5111%' or Acc_NO like '5112%' or Acc_NO like '5121%'  or Acc_NO like '5122%' or Acc_NO like '4[6-8]1%' or  Acc_NO like '4[6-8]2%' or Acc_NO like '4[6-8]3%' or Acc_NO like '5[6-8]111%' or Acc_NO like '5[6-8]112%' or Acc_NO like '5[6-8]121%'  or Acc_NO like '5[6-8]122%')and (1=1) &#xD;&#xA;group by  case when (Acc_NO like '4[6-8]1%' or  Acc_NO like '4[6-8]2%' or Acc_NO like '4[6-8]3%' or Acc_NO like '5[6-8]111%' or Acc_NO like '5[6-8]112%' or Acc_NO like '5[6-8]121%'  or Acc_NO like '5[6-8]122%' ) then left(acc_no,1)+substring(acc_no,3,15) else acc_no end,&#xD;&#xA;DBO.getAcc_NM(case when (Acc_NO like '4[6-8]1%' or  Acc_NO like '4[6-8]2%' or Acc_NO like '4[6-8]3%' or Acc_NO like '5[6-8]111%' or Acc_NO like '5[6-8]112%' or Acc_NO like '5[6-8]121%'  or Acc_NO like '5[6-8]122%' ) then left(acc_no,1)+substring(acc_no,3,15) else acc_no end ,0),&#xD;&#xA;case when (Acc_NO like '4[6-8]1%' or  Acc_NO like '4[6-8]2%' or Acc_NO like '4[6-8]3%' or Acc_NO like '5[6-8]111%' or Acc_NO like '5[6-8]112%' or Acc_NO like '5[6-8]121%'  or Acc_NO like '5[6-8]122%' ) then left(acc_no,1)+substring(acc_no,3,1) else left(acc_no,2) end ,&#xD;&#xA;DbO.GEtACC_NM(case when (Acc_NO like '4[6-8]1%' or  Acc_NO like '4[6-8]2%' or Acc_NO like '4[6-8]3%' or Acc_NO like '5[6-8]111%' or Acc_NO like '5[6-8]112%' or Acc_NO like '5[6-8]121%'  or Acc_NO like '5[6-8]122%' ) then left(acc_no,1)+substring(acc_no,3,1) else left(acc_no,2) end,0 ) ,&#xD;&#xA;LEFT(case when (Acc_NO like '4[6-8]1%' or  Acc_NO like '4[6-8]2%' or Acc_NO like '4[6-8]3%' or Acc_NO like '5[6-8]111%' or Acc_NO like '5[6-8]112%' or Acc_NO like '5[6-8]121%'  or Acc_NO like '5[6-8]122%' ) then left(acc_no,1)+substring(acc_no,3,15) else acc_no end,3)  ,&#xD;&#xA;DbO.GEtACC_NM(LEFT(case when (Acc_NO like '4[6-8]1%' or  Acc_NO like '4[6-8]2%' or Acc_NO like '4[6-8]3%' or Acc_NO like '5[6-8]111%' or Acc_NO like '5[6-8]112%' or Acc_NO like '5[6-8]121%'  or Acc_NO like '5[6-8]122%' ) then left(acc_no,1)+substring(acc_no,3,15) else acc_no end,3),0)  &#xD;&#xA;order by acc,acc3,macc&#xD;&#xA;&#xD;&#xA;" Name="sqlDataSource2" />
