  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="glx2023tarheel" SelectCommand="select fa_cd,fa_nm,fa_nm_en,n1,sum(AFaVl) as AFaVl , sum(AFaVl_MV) as AFaVl_MV, sum(AFaVl_lv) as AFaVl_lv&#xD;&#xA;from (&#xD;&#xA;SELECT &#xD;&#xA;substring(famf.FA_CD,1,3) as fa_cd,'الأصول' as fa_nm&#xD;&#xA;,'Assets' as fa_nm_en,&#xD;&#xA;0 AS AFaVl  &#xD;&#xA;,0 as AFaVl_MV&#xD;&#xA;,0 as AFaVl_lv&#xD;&#xA;,'' as n1&#xD;&#xA;FROM (FAMF  LEFT JOIN FADPRC_Q ON FADPRC_Q.FA_CD=FAMF.FA_CD) &#xD;&#xA;WHERE (FAMF.FA_TY&lt;&gt;1) and  (FAMF.FA_TY&lt;&gt;5) and (FAMF.FA_CD like '111%' )&#xD;&#xA;and FADPRC_Q.PRD='-99991'&#xD;&#xA;) as t &#xD;&#xA;group by t.fa_cd,t.fa_nm,t.n1,t.fa_nm_en&#xD;&#xA;union all&#xD;&#xA;select fa_cd,fa_nm,fa_nm_en,n1,sum(AFaVl) as AFaVl , sum(AFaVl_MV) as AFaVl_MV, sum(AFaVl_lv) as AFaVl_lv&#xD;&#xA;from (&#xD;&#xA;SELECT &#xD;&#xA;substring(famf.FA_CD,1,3) as fa_cd,'اراضي' as fa_nm&#xD;&#xA;,'Land' as fa_nm_en,&#xD;&#xA;(ISNULL(FADPRC_Q.FA_VL,0) + Round(Cast(( + ISNULL(FADPRC_Q.TOTADD,0) - &#xD;&#xA;ISNULL(FADPRC_Q.TOTDSP,0))as decimal(18,4)),2)) AS AFaVl  &#xD;&#xA;,((ISNULL(FADPRC_Q.FA_VL,0) + Round(Cast(( + ISNULL(FADPRC_Q.TOTADD,0) - &#xD;&#xA;ISNULL(FADPRC_Q.TOTDSP,0))as decimal(18,4)),2)) *2/3 ) as AFaVl_MV&#xD;&#xA;,((ISNULL(FADPRC_Q.FA_VL,0) + Round(Cast(( + ISNULL(FADPRC_Q.TOTADD,0) - &#xD;&#xA;ISNULL(FADPRC_Q.TOTDSP,0))as decimal(18,4)),2)) *1/3 ) as AFaVl_lv&#xD;&#xA;,'' as n1&#xD;&#xA;FROM (FAMF  LEFT JOIN FADPRC_Q ON FADPRC_Q.FA_CD=FAMF.FA_CD) &#xD;&#xA;WHERE (FAMF.FA_TY&lt;&gt;1) and  (FAMF.FA_TY&lt;&gt;5) and (FAMF.FA_CD like '111%' )&#xD;&#xA;and FADPRC_Q.PRD='-99991'&#xD;&#xA;) as t &#xD;&#xA;group by t.fa_cd,t.fa_nm,t.n1,t.fa_nm_en&#xD;&#xA;union all&#xD;&#xA;select fa_cd,fa_nm,fa_nm_en,n1,sum(AFaVl) as AFaVl , sum(AFaVl_MV) as AFaVl_MV, sum(AFaVl_lv) as AFaVl_lv&#xD;&#xA;from (&#xD;&#xA;SELECT &#xD;&#xA;substring(famf.FA_CD,1,3) as fa_cd,'مباني' as fa_nm&#xD;&#xA;,'' as fa_nm_en,&#xD;&#xA;0 AS AFaVl  &#xD;&#xA;,0 as AFaVl_MV&#xD;&#xA;,0 as AFaVl_lv&#xD;&#xA;,'' as n1&#xD;&#xA;FROM (FAMF  LEFT JOIN FADPRC_Q ON FADPRC_Q.FA_CD=FAMF.FA_CD) &#xD;&#xA;WHERE (FAMF.FA_TY&lt;&gt;1) and  (FAMF.FA_TY&lt;&gt;5) and (FAMF.FA_CD like '112%' )&#xD;&#xA;and FADPRC_Q.PRD='-99991'&#xD;&#xA;) as t &#xD;&#xA;group by t.fa_cd,t.fa_nm,t.n1,t.fa_nm_en&#xD;&#xA;union all&#xD;&#xA;select fa_cd,fa_nm,fa_nm_en,n1,sum(AFaVl) as AFaVl , sum(AFaVl_MV) as AFaVl_MV, sum(AFaVl_lv) as AFaVl_lv&#xD;&#xA;from (&#xD;&#xA;SELECT &#xD;&#xA;substring(famf.FA_CD,1,3) as fa_cd,'القيمة الدفترية' as fa_nm&#xD;&#xA;,'Book' as fa_nm_en,&#xD;&#xA;(ISNULL(FADPRC_Q.FA_VL,0) + Round(Cast(( + ISNULL(FADPRC_Q.TOTADD,0) - &#xD;&#xA;ISNULL(FADPRC_Q.TOTDSP,0))as decimal(18,4)),2)) AS AFaVl  &#xD;&#xA;,((ISNULL(FADPRC_Q.FA_VL,0) + Round(Cast(( + ISNULL(FADPRC_Q.TOTADD,0) - &#xD;&#xA;ISNULL(FADPRC_Q.TOTDSP,0))as decimal(18,4)),2)) *2/3 ) as AFaVl_MV&#xD;&#xA;,((ISNULL(FADPRC_Q.FA_VL,0) + Round(Cast(( + ISNULL(FADPRC_Q.TOTADD,0) - &#xD;&#xA;ISNULL(FADPRC_Q.TOTDSP,0))as decimal(18,4)),2)) *1/3 ) as AFaVl_lv&#xD;&#xA;,'' as n1&#xD;&#xA;FROM (FAMF  LEFT JOIN FADPRC_Q ON FADPRC_Q.FA_CD=FAMF.FA_CD) &#xD;&#xA;WHERE (FAMF.FA_TY&lt;&gt;1) and  (FAMF.FA_TY&lt;&gt;5) and (FAMF.FA_CD like '112%' )&#xD;&#xA;and FADPRC_Q.PRD='-99991'&#xD;&#xA;) as t &#xD;&#xA;group by t.fa_cd,t.fa_nm,t.n1,t.fa_nm_en&#xD;&#xA;union all&#xD;&#xA;select fa_cd,fa_nm,fa_nm_en,n1,sum(AFaVl) as AFaVl , sum(AFaVl_MV) as AFaVl_MV, sum(AFaVl_lv) as AFaVl_lv&#xD;&#xA;from (&#xD;&#xA;SELECT &#xD;&#xA;substring(famf.FA_CD,1,3) as fa_cd,'مجمع الإهلاك' as fa_nm&#xD;&#xA;,'accumulated' as fa_nm_en,&#xD;&#xA;(&#xD;&#xA;Cast(ISNULL(FAMF.DPRC,0)as decimal(18,4)) + &#xD;&#xA;Round(Cast((ISNULL((select sum(FADPRC_Q.DPREXP)from FADPRC_Q  &#xD;&#xA;where FAMF.FA_CD= FADPRC_Q.FA_CD and FADPRC_Q.PRD &lt;='-99991') ,0) )as decimal(18,4)),2) &#xD;&#xA;+ Cast(ISNULL(FAMF.PYRDPRC,0)as decimal(18,4))&#xD;&#xA;+ Cast(ISNULL((select sum(FADPRC_Q.TOTADDACC)from FADPRC_Q  &#xD;&#xA;where FAMF.FA_CD= FADPRC_Q.FA_CD and FADPRC_Q.PRD='-99991') ,0)as decimal(18,4))&#xD;&#xA;-&#xD;&#xA;Round(Cast(ISNULL((select sum(FADPRC_Q.TOTDSPACC)from FADPRC_Q  &#xD;&#xA;where FAMF.FA_CD= FADPRC_Q.FA_CD and FADPRC_Q.PRD='-99991') ,0)as decimal(18,4)),2)&#xD;&#xA;-Round(Cast((ISNULL((select sum(FADPRC_Q.DSP_DPREXP)from FADPRC_Q  &#xD;&#xA;where FAMF.FA_CD= FADPRC_Q.FA_CD and FADPRC_Q.PRD &lt;='-99991') ,0) )as decimal(18,4)),2)&#xD;&#xA;) as AFaVl&#xD;&#xA;,((&#xD;&#xA;Cast(ISNULL(FAMF.DPRC,0)as decimal(18,4)) + &#xD;&#xA;Round(Cast((ISNULL((select sum(FADPRC_Q.DPREXP)from FADPRC_Q  &#xD;&#xA;where FAMF.FA_CD= FADPRC_Q.FA_CD and FADPRC_Q.PRD &lt;='-99991') ,0) )as decimal(18,4)),2) &#xD;&#xA;+ Cast(ISNULL(FAMF.PYRDPRC,0)as decimal(18,4))&#xD;&#xA;+ Cast(ISNULL((select sum(FADPRC_Q.TOTADDACC)from FADPRC_Q  &#xD;&#xA;where FAMF.FA_CD= FADPRC_Q.FA_CD and FADPRC_Q.PRD='-99991') ,0)as decimal(18,4))&#xD;&#xA;-&#xD;&#xA;Round(Cast(ISNULL((select sum(FADPRC_Q.TOTDSPACC)from FADPRC_Q  &#xD;&#xA;where FAMF.FA_CD= FADPRC_Q.FA_CD and FADPRC_Q.PRD='-99991') ,0)as decimal(18,4)),2)&#xD;&#xA;-Round(Cast((ISNULL((select sum(FADPRC_Q.DSP_DPREXP)from FADPRC_Q  &#xD;&#xA;where FAMF.FA_CD= FADPRC_Q.FA_CD and FADPRC_Q.PRD &lt;='-99991') ,0) )as decimal(18,4)),2)&#xD;&#xA;)*2/3) as AFaVl_MV&#xD;&#xA;,((&#xD;&#xA;Cast(ISNULL(FAMF.DPRC,0)as decimal(18,4)) + &#xD;&#xA;Round(Cast((ISNULL((select sum(FADPRC_Q.DPREXP)from FADPRC_Q  &#xD;&#xA;where FAMF.FA_CD= FADPRC_Q.FA_CD and FADPRC_Q.PRD &lt;='-99991') ,0) )as decimal(18,4)),2) &#xD;&#xA;+ Cast(ISNULL(FAMF.PYRDPRC,0)as decimal(18,4))&#xD;&#xA;+ Cast(ISNULL((select sum(FADPRC_Q.TOTADDACC)from FADPRC_Q  &#xD;&#xA;where FAMF.FA_CD= FADPRC_Q.FA_CD and FADPRC_Q.PRD='-99991') ,0)as decimal(18,4))&#xD;&#xA;-&#xD;&#xA;Round(Cast(ISNULL((select sum(FADPRC_Q.TOTDSPACC)from FADPRC_Q  &#xD;&#xA;where FAMF.FA_CD= FADPRC_Q.FA_CD and FADPRC_Q.PRD='-99991') ,0)as decimal(18,4)),2)&#xD;&#xA;-Round(Cast((ISNULL((select sum(FADPRC_Q.DSP_DPREXP)from FADPRC_Q  &#xD;&#xA;where FAMF.FA_CD= FADPRC_Q.FA_CD and FADPRC_Q.PRD &lt;='-99991') ,0) )as decimal(18,4)),2)&#xD;&#xA;)*1/3) as AFaVl_Lv&#xD;&#xA;,'' as n1&#xD;&#xA;&#xD;&#xA;FROM (FAMF  LEFT JOIN FADPRC_Q ON FADPRC_Q.FA_CD=FAMF.FA_CD) &#xD;&#xA;WHERE (FAMF.FA_TY&lt;&gt;1) and  (FAMF.FA_TY&lt;&gt;5) and (FAMF.FA_CD like '112%' )&#xD;&#xA;and FADPRC_Q.PRD='-99991'&#xD;&#xA;) as t &#xD;&#xA;group by t.fa_cd,t.fa_nm,t.n1,t.fa_nm_en&#xD;&#xA;------&#xD;&#xA;union all&#xD;&#xA;select fa_cd,fa_nm,fa_nm_en,n1,sum(AFaVl) as AFaVl , sum(AFaVl_MV) as AFaVl_MV, sum(AFaVl_lv) as AFaVl_lv&#xD;&#xA;from (&#xD;&#xA;SELECT &#xD;&#xA;substring(famf.FA_CD,1,3) as fa_cd,'صافي الأصل' as fa_nm&#xD;&#xA;,'net' as fa_nm_en,&#xD;&#xA;((ISNULL(FADPRC_Q.FA_VL,0) + Round(Cast(( + ISNULL(FADPRC_Q.TOTADD,0) - &#xD;&#xA;ISNULL(FADPRC_Q.TOTDSP,0))as decimal(18,4)),2))&#xD;&#xA;-(&#xD;&#xA;Cast(ISNULL(FAMF.DPRC,0)as decimal(18,4)) + &#xD;&#xA;Round(Cast((ISNULL((select sum(FADPRC_Q.DPREXP)from FADPRC_Q  &#xD;&#xA;where FAMF.FA_CD= FADPRC_Q.FA_CD and FADPRC_Q.PRD &lt;='-99991') ,0) )as decimal(18,4)),2) &#xD;&#xA;+ Cast(ISNULL(FAMF.PYRDPRC,0)as decimal(18,4))&#xD;&#xA;+ Cast(ISNULL((select sum(FADPRC_Q.TOTADDACC)from FADPRC_Q  &#xD;&#xA;where FAMF.FA_CD= FADPRC_Q.FA_CD and FADPRC_Q.PRD='-99991') ,0)as decimal(18,4))&#xD;&#xA;-&#xD;&#xA;Round(Cast(ISNULL((select sum(FADPRC_Q.TOTDSPACC)from FADPRC_Q  &#xD;&#xA;where FAMF.FA_CD= FADPRC_Q.FA_CD and FADPRC_Q.PRD='-99991') ,0)as decimal(18,4)),2)&#xD;&#xA;-Round(Cast((ISNULL((select sum(FADPRC_Q.DSP_DPREXP)from FADPRC_Q  &#xD;&#xA;where FAMF.FA_CD= FADPRC_Q.FA_CD and FADPRC_Q.PRD &lt;='-99991') ,0) )as decimal(18,4)),2)&#xD;&#xA;))  as AFaVl&#xD;&#xA;,&#xD;&#xA;(((ISNULL(FADPRC_Q.FA_VL,0) + Round(Cast(( + ISNULL(FADPRC_Q.TOTADD,0) - &#xD;&#xA;ISNULL(FADPRC_Q.TOTDSP,0))as decimal(18,4)),2)) *2/3 )&#xD;&#xA;-&#xD;&#xA;((&#xD;&#xA;Cast(ISNULL(FAMF.DPRC,0)as decimal(18,4)) + &#xD;&#xA;Round(Cast((ISNULL((select sum(FADPRC_Q.DPREXP)from FADPRC_Q  &#xD;&#xA;where FAMF.FA_CD= FADPRC_Q.FA_CD and FADPRC_Q.PRD &lt;='-99991') ,0) )as decimal(18,4)),2) &#xD;&#xA;+ Cast(ISNULL(FAMF.PYRDPRC,0)as decimal(18,4))&#xD;&#xA;+ Cast(ISNULL((select sum(FADPRC_Q.TOTADDACC)from FADPRC_Q  &#xD;&#xA;where FAMF.FA_CD= FADPRC_Q.FA_CD and FADPRC_Q.PRD='-99991') ,0)as decimal(18,4))&#xD;&#xA;-&#xD;&#xA;Round(Cast(ISNULL((select sum(FADPRC_Q.TOTDSPACC)from FADPRC_Q  &#xD;&#xA;where FAMF.FA_CD= FADPRC_Q.FA_CD and FADPRC_Q.PRD='-99991') ,0)as decimal(18,4)),2)&#xD;&#xA;-Round(Cast((ISNULL((select sum(FADPRC_Q.DSP_DPREXP)from FADPRC_Q  &#xD;&#xA;where FAMF.FA_CD= FADPRC_Q.FA_CD and FADPRC_Q.PRD &lt;='-99991') ,0) )as decimal(18,4)),2)&#xD;&#xA;)*2/3)) as AFaVl_MV&#xD;&#xA;,&#xD;&#xA;(((ISNULL(FADPRC_Q.FA_VL,0) + Round(Cast(( + ISNULL(FADPRC_Q.TOTADD,0) - &#xD;&#xA;ISNULL(FADPRC_Q.TOTDSP,0))as decimal(18,4)),2)) *1/3 )&#xD;&#xA;-((&#xD;&#xA;Cast(ISNULL(FAMF.DPRC,0)as decimal(18,4)) + &#xD;&#xA;Round(Cast((ISNULL((select sum(FADPRC_Q.DPREXP)from FADPRC_Q  &#xD;&#xA;where FAMF.FA_CD= FADPRC_Q.FA_CD and FADPRC_Q.PRD &lt;='-99991') ,0) )as decimal(18,4)),2) &#xD;&#xA;+ Cast(ISNULL(FAMF.PYRDPRC,0)as decimal(18,4))&#xD;&#xA;+ Cast(ISNULL((select sum(FADPRC_Q.TOTADDACC)from FADPRC_Q  &#xD;&#xA;where FAMF.FA_CD= FADPRC_Q.FA_CD and FADPRC_Q.PRD='-99991') ,0)as decimal(18,4))&#xD;&#xA;-&#xD;&#xA;Round(Cast(ISNULL((select sum(FADPRC_Q.TOTDSPACC)from FADPRC_Q  &#xD;&#xA;where FAMF.FA_CD= FADPRC_Q.FA_CD and FADPRC_Q.PRD='-99991') ,0)as decimal(18,4)),2)&#xD;&#xA;-Round(Cast((ISNULL((select sum(FADPRC_Q.DSP_DPREXP)from FADPRC_Q  &#xD;&#xA;where FAMF.FA_CD= FADPRC_Q.FA_CD and FADPRC_Q.PRD &lt;='-99991') ,0) )as decimal(18,4)),2)&#xD;&#xA;)*1/3)) as AFaVl_Lv&#xD;&#xA;,'' as n1&#xD;&#xA;FROM (FAMF  LEFT JOIN FADPRC_Q ON FADPRC_Q.FA_CD=FAMF.FA_CD) &#xD;&#xA;WHERE (FAMF.FA_TY&lt;&gt;1) and  (FAMF.FA_TY&lt;&gt;5) and (FAMF.FA_CD like '112%' )&#xD;&#xA;and FADPRC_Q.PRD='-99991'&#xD;&#xA;) as t &#xD;&#xA;group by t.fa_cd,t.fa_nm,t.n1,t.fa_nm_en&#xD;&#xA;-----&#xD;&#xA;union all&#xD;&#xA;select fa_cd,fa_nm,fa_nm_en,n1,convert(nvarchar(50),AFaVl) as AFaVl , convert(nvarchar(50),AFaVl_MV) as AFaVl_MV, convert(nvarchar(50),AFaVl_lv) as AFaVl_lv&#xD;&#xA;from (&#xD;&#xA;SELECT &#xD;&#xA;substring(famf.FA_CD,1,3) as fa_cd,'نسبة الإهلاك' as fa_nm&#xD;&#xA;,'Depreciation' as fa_nm_en,&#xD;&#xA;'' AS AFaVl  &#xD;&#xA;,'' as AFaVl_MV&#xD;&#xA;,''  as AFaVl_lv&#xD;&#xA;,'2% _ 2.5%' as n1&#xD;&#xA;&#xD;&#xA;FROM (FAMF  LEFT JOIN FADPRC_Q ON FADPRC_Q.FA_CD=FAMF.FA_CD) &#xD;&#xA;WHERE (FAMF.FA_TY&lt;&gt;1) and  (FAMF.FA_TY&lt;&gt;5) and (FAMF.FA_CD like '112%' )&#xD;&#xA;and FADPRC_Q.PRD='-99991'&#xD;&#xA;) as t &#xD;&#xA;group by t.fa_cd,t.fa_nm,t.n1,t.fa_nm_en,AFaVl,AFaVl_MV,AFaVl_lv&#xD;&#xA;union all&#xD;&#xA;select fa_cd,fa_nm,fa_nm_en,n1,sum(AFaVl) as AFaVl , sum(AFaVl_MV) as AFaVl_MV, sum(AFaVl_lv) as AFaVl_lv&#xD;&#xA;from (&#xD;&#xA;SELECT &#xD;&#xA;substring(famf.FA_CD,1,3) as fa_cd,'الالات ومعدات' as fa_nm&#xD;&#xA;,'' as fa_nm_en,&#xD;&#xA;0 AS AFaVl  &#xD;&#xA;,0 as AFaVl_MV&#xD;&#xA;,0 as AFaVl_lv&#xD;&#xA;,'' as n1&#xD;&#xA;FROM (FAMF  LEFT JOIN FADPRC_Q ON FADPRC_Q.FA_CD=FAMF.FA_CD) &#xD;&#xA;WHERE (FAMF.FA_TY&lt;&gt;1) and  (FAMF.FA_TY&lt;&gt;5) and (FAMF.FA_CD like '113%' )&#xD;&#xA;and FADPRC_Q.PRD='-99991'&#xD;&#xA;) as t group by t.fa_cd,t.fa_nm,t.n1,t.fa_nm_en&#xD;&#xA;union all&#xD;&#xA;select fa_cd,fa_nm,fa_nm_en,n1,sum(AFaVl) as AFaVl , sum(AFaVl_MV) as AFaVl_MV, sum(AFaVl_lv) as AFaVl_lv&#xD;&#xA;from (&#xD;&#xA;SELECT &#xD;&#xA;substring(famf.FA_CD,1,3) as fa_cd,'لوحات توزيع' as fa_nm&#xD;&#xA;,'Machines' as fa_nm_en,&#xD;&#xA;0 AS AFaVl  &#xD;&#xA;,0 as AFaVl_MV&#xD;&#xA;,0 as AFaVl_lv&#xD;&#xA;,'6% من الشبكة ' as n1&#xD;&#xA;FROM (FAMF  LEFT JOIN FADPRC_Q ON FADPRC_Q.FA_CD=FAMF.FA_CD) &#xD;&#xA;WHERE (FAMF.FA_TY&lt;&gt;1) and  (FAMF.FA_TY&lt;&gt;5) and (FAMF.FA_CD like '113%' )&#xD;&#xA;and FADPRC_Q.PRD='-99991'&#xD;&#xA;) as t group by t.fa_cd,t.fa_nm,t.n1,t.fa_nm_en&#xD;&#xA;union all&#xD;&#xA;select fa_cd,fa_nm,fa_nm_en,n1,sum(AFaVl) as AFaVl , sum(AFaVl_MV) as AFaVl_MV, sum(AFaVl_lv) as AFaVl_lv&#xD;&#xA;from (&#xD;&#xA;SELECT &#xD;&#xA;substring(famf.FA_CD,1,3) as fa_cd,'القيمة الدفترية' as fa_nm&#xD;&#xA;,'Book' as fa_nm_en,&#xD;&#xA;(ISNULL(FADPRC_Q.FA_VL,0) + Round(Cast(( + ISNULL(FADPRC_Q.TOTADD,0) - &#xD;&#xA;ISNULL(FADPRC_Q.TOTDSP,0))as decimal(18,4)),2)) *0.06 AS AFaVl  &#xD;&#xA;,((ISNULL(FADPRC_Q.FA_VL,0) + Round(Cast(( + ISNULL(FADPRC_Q.TOTADD,0) - &#xD;&#xA;ISNULL(FADPRC_Q.TOTDSP,0))as decimal(18,4)),2)) *2/3 )*0.06 as AFaVl_MV&#xD;&#xA;,((ISNULL(FADPRC_Q.FA_VL,0) + Round(Cast(( + ISNULL(FADPRC_Q.TOTADD,0) - &#xD;&#xA;ISNULL(FADPRC_Q.TOTDSP,0))as decimal(18,4)),2)) *1/3 )*0.06 as AFaVl_lv&#xD;&#xA;,'' as n1&#xD;&#xA;FROM (FAMF  LEFT JOIN FADPRC_Q ON FADPRC_Q.FA_CD=FAMF.FA_CD) &#xD;&#xA;WHERE (FAMF.FA_TY&lt;&gt;1) and  (FAMF.FA_TY&lt;&gt;5) and (FAMF.FA_CD like '1131%' or FAMF.FA_CD like '1134%' &#xD;&#xA;or FAMF.FA_CD like '1135%' or FAMF.FA_CD like '1136%' or FAMF.FA_CD like '1137%')&#xD;&#xA;and FADPRC_Q.PRD='-99991'&#xD;&#xA;) as t &#xD;&#xA;group by t.fa_cd,t.fa_nm,t.n1,t.fa_nm_en&#xD;&#xA;union all&#xD;&#xA;select fa_cd,fa_nm,fa_nm_en,n1,sum(AFaVl) as AFaVl , sum(AFaVl_MV) as AFaVl_MV, sum(AFaVl_lv) as AFaVl_lv&#xD;&#xA;from (&#xD;&#xA;SELECT &#xD;&#xA;substring(famf.FA_CD,1,3) as fa_cd,'مجمع الإهلاك' as fa_nm&#xD;&#xA;,'accumulated' as fa_nm_en,&#xD;&#xA;(&#xD;&#xA;Cast(ISNULL(FAMF.DPRC,0)as decimal(18,4)) + &#xD;&#xA;Round(Cast((ISNULL((select sum(FADPRC_Q.DPREXP)from FADPRC_Q  &#xD;&#xA;where FAMF.FA_CD= FADPRC_Q.FA_CD and FADPRC_Q.PRD &lt;='-99991') ,0) )as decimal(18,4)),2) &#xD;&#xA;+ Cast(ISNULL(FAMF.PYRDPRC,0)as decimal(18,4))&#xD;&#xA;+ Cast(ISNULL((select sum(FADPRC_Q.TOTADDACC)from FADPRC_Q  &#xD;&#xA;where FAMF.FA_CD= FADPRC_Q.FA_CD and FADPRC_Q.PRD='-99991') ,0)as decimal(18,4))&#xD;&#xA;-&#xD;&#xA;Round(Cast(ISNULL((select sum(FADPRC_Q.TOTDSPACC)from FADPRC_Q  &#xD;&#xA;where FAMF.FA_CD= FADPRC_Q.FA_CD and FADPRC_Q.PRD='-99991') ,0)as decimal(18,4)),2)&#xD;&#xA;-Round(Cast((ISNULL((select sum(FADPRC_Q.DSP_DPREXP)from FADPRC_Q  &#xD;&#xA;where FAMF.FA_CD= FADPRC_Q.FA_CD and FADPRC_Q.PRD &lt;='-99991') ,0) )as decimal(18,4)),2)&#xD;&#xA;)*0.06 as AFaVl&#xD;&#xA;,((&#xD;&#xA;Cast(ISNULL(FAMF.DPRC,0)as decimal(18,4)) + &#xD;&#xA;Round(Cast((ISNULL((select sum(FADPRC_Q.DPREXP)from FADPRC_Q  &#xD;&#xA;where FAMF.FA_CD= FADPRC_Q.FA_CD and FADPRC_Q.PRD &lt;='-99991') ,0) )as decimal(18,4)),2) &#xD;&#xA;+ Cast(ISNULL(FAMF.PYRDPRC,0)as decimal(18,4))&#xD;&#xA;+ Cast(ISNULL((select sum(FADPRC_Q.TOTADDACC)from FADPRC_Q  &#xD;&#xA;where FAMF.FA_CD= FADPRC_Q.FA_CD and FADPRC_Q.PRD='-99991') ,0)as decimal(18,4))&#xD;&#xA;-&#xD;&#xA;Round(Cast(ISNULL((select sum(FADPRC_Q.TOTDSPACC)from FADPRC_Q  &#xD;&#xA;where FAMF.FA_CD= FADPRC_Q.FA_CD and FADPRC_Q.PRD='-99991') ,0)as decimal(18,4)),2)&#xD;&#xA;-Round(Cast((ISNULL((select sum(FADPRC_Q.DSP_DPREXP)from FADPRC_Q  &#xD;&#xA;where FAMF.FA_CD= FADPRC_Q.FA_CD and FADPRC_Q.PRD &lt;='-99991') ,0) )as decimal(18,4)),2)&#xD;&#xA;)*2/3)*0.06 as AFaVl_MV&#xD;&#xA;,((&#xD;&#xA;Cast(ISNULL(FAMF.DPRC,0)as decimal(18,4)) + &#xD;&#xA;Round(Cast((ISNULL((select sum(FADPRC_Q.DPREXP)from FADPRC_Q  &#xD;&#xA;where FAMF.FA_CD= FADPRC_Q.FA_CD and FADPRC_Q.PRD &lt;='-99991') ,0) )as decimal(18,4)),2) &#xD;&#xA;+ Cast(ISNULL(FAMF.PYRDPRC,0)as decimal(18,4))&#xD;&#xA;+ Cast(ISNULL((select sum(FADPRC_Q.TOTADDACC)from FADPRC_Q  &#xD;&#xA;where FAMF.FA_CD= FADPRC_Q.FA_CD and FADPRC_Q.PRD='-99991') ,0)as decimal(18,4))&#xD;&#xA;-&#xD;&#xA;Round(Cast(ISNULL((select sum(FADPRC_Q.TOTDSPACC)from FADPRC_Q  &#xD;&#xA;where FAMF.FA_CD= FADPRC_Q.FA_CD and FADPRC_Q.PRD='-99991') ,0)as decimal(18,4)),2)&#xD;&#xA;-Round(Cast((ISNULL((select sum(FADPRC_Q.DSP_DPREXP)from FADPRC_Q  &#xD;&#xA;where FAMF.FA_CD= FADPRC_Q.FA_CD and FADPRC_Q.PRD &lt;='-99991') ,0) )as decimal(18,4)),2)&#xD;&#xA;)*1/3)*0.06 as AFaVl_Lv&#xD;&#xA;,'' as n1&#xD;&#xA;&#xD;&#xA;FROM (FAMF  LEFT JOIN FADPRC_Q ON FADPRC_Q.FA_CD=FAMF.FA_CD) &#xD;&#xA;WHERE (FAMF.FA_TY&lt;&gt;1) and  (FAMF.FA_TY&lt;&gt;5) and (FAMF.FA_CD like '1131%' or FAMF.FA_CD like '1134%' &#xD;&#xA;or FAMF.FA_CD like '1135%' or FAMF.FA_CD like '1136%' or FAMF.FA_CD like '1137%')&#xD;&#xA;and FADPRC_Q.PRD='-99991'&#xD;&#xA;) as t &#xD;&#xA;group by t.fa_cd,t.fa_nm,t.n1,t.fa_nm_en&#xD;&#xA;union all&#xD;&#xA;select fa_cd,fa_nm,fa_nm_en,n1,sum(AFaVl) as AFaVl , sum(AFaVl_MV) as AFaVl_MV, sum(AFaVl_lv) as AFaVl_lv&#xD;&#xA;from (&#xD;&#xA;SELECT &#xD;&#xA;substring(famf.FA_CD,1,3) as fa_cd,'صافي الأصل' as fa_nm&#xD;&#xA;,'net' as fa_nm_en,&#xD;&#xA;((ISNULL(FADPRC_Q.FA_VL,0) + Round(Cast(( + ISNULL(FADPRC_Q.TOTADD,0) - &#xD;&#xA;ISNULL(FADPRC_Q.TOTDSP,0))as decimal(18,4)),2))&#xD;&#xA;-(&#xD;&#xA;Cast(ISNULL(FAMF.DPRC,0)as decimal(18,4)) + &#xD;&#xA;Round(Cast((ISNULL((select sum(FADPRC_Q.DPREXP)from FADPRC_Q  &#xD;&#xA;where FAMF.FA_CD= FADPRC_Q.FA_CD and FADPRC_Q.PRD &lt;='-99991') ,0) )as decimal(18,4)),2) &#xD;&#xA;+ Cast(ISNULL(FAMF.PYRDPRC,0)as decimal(18,4))&#xD;&#xA;+ Cast(ISNULL((select sum(FADPRC_Q.TOTADDACC)from FADPRC_Q  &#xD;&#xA;where FAMF.FA_CD= FADPRC_Q.FA_CD and FADPRC_Q.PRD='-99991') ,0)as decimal(18,4))&#xD;&#xA;-&#xD;&#xA;Round(Cast(ISNULL((select sum(FADPRC_Q.TOTDSPACC)from FADPRC_Q  &#xD;&#xA;where FAMF.FA_CD= FADPRC_Q.FA_CD and FADPRC_Q.PRD='-99991') ,0)as decimal(18,4)),2)&#xD;&#xA;-Round(Cast((ISNULL((select sum(FADPRC_Q.DSP_DPREXP)from FADPRC_Q  &#xD;&#xA;where FAMF.FA_CD= FADPRC_Q.FA_CD and FADPRC_Q.PRD &lt;='-99991') ,0) )as decimal(18,4)),2)&#xD;&#xA;))*0.06  as AFaVl&#xD;&#xA;,&#xD;&#xA;(((ISNULL(FADPRC_Q.FA_VL,0) + Round(Cast(( + ISNULL(FADPRC_Q.TOTADD,0) - &#xD;&#xA;ISNULL(FADPRC_Q.TOTDSP,0))as decimal(18,4)),2)) *2/3 )&#xD;&#xA;-&#xD;&#xA;((&#xD;&#xA;Cast(ISNULL(FAMF.DPRC,0)as decimal(18,4)) + &#xD;&#xA;Round(Cast((ISNULL((select sum(FADPRC_Q.DPREXP)from FADPRC_Q  &#xD;&#xA;where FAMF.FA_CD= FADPRC_Q.FA_CD and FADPRC_Q.PRD &lt;='-99991') ,0) )as decimal(18,4)),2) &#xD;&#xA;+ Cast(ISNULL(FAMF.PYRDPRC,0)as decimal(1