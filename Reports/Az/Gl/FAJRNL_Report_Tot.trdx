<Report DataSourceName="sqlDataSource1" Width="11.679in" UnitOfMeasure="Mm" Name="FAJRNL_Report_Tot" Zoom="0.6666667" ShowDimensions="False" xmlns="http://schemas.telerik.com/reporting/2021/1.0">
  <Style Visible="True">
    <BorderStyle Top="Groove" Bottom="Groove" Left="Groove" Right="Groove" />
    <BorderColor Top="37, 64, 97" Bottom="37, 64, 97" Left="37, 64, 97" Right="37, 64, 97" />
