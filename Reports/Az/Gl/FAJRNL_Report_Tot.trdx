  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="GLXAssets" SelectCommand="select&#xD;&#xA;month(tr_dt) as mnth&#xD;&#xA;,FAJRNL.DOC_NO as DOC_NNO&#xD;&#xA;,TR_DT as DoC_DTT&#xD;&#xA;,(sum(case when FAJRNL.FA_CD like '111%' and tr_ty='1' then FAJRNL.VAL else 0 end )) as Add_111&#xD;&#xA;,(sum(case when FAJRNL.FA_CD like '111%' and tr_ty='2' then FAJRNL.VAL else 0 end )) as Out_111&#xD;&#xA;,(sum(case when FAJRNL.FA_CD like '112%' and tr_ty='1' then FAJRNL.VAL else 0 end )) as Add_112&#xD;&#xA;,(sum(case when FAJRNL.FA_CD like '112%' and tr_ty='2' then FAJRNL.VAL else 0 end )) as Out_112&#xD;&#xA;,(sum(case when FAJRNL.FA_CD like '113%' and tr_ty='1' then FAJRNL.VAL else 0 end )) as Add_113&#xD;&#xA;,(sum(case when FAJRNL.FA_CD like '113%' and tr_ty='2' then FAJRNL.VAL else 0 end )) as Out_113&#xD;&#xA;,(sum(case when FAJRNL.FA_CD like '114%' and tr_ty='1' then FAJRNL.VAL else 0 end )) as Add_114&#xD;&#xA;,(sum(case when FAJRNL.FA_CD like '114%' and tr_ty='2' then FAJRNL.VAL else 0 end )) as Out_114&#xD;&#xA;,(sum(case when FAJRNL.FA_CD like '115%' and tr_ty='1' then FAJRNL.VAL else 0 end )) as Add_115&#xD;&#xA;,(sum(case when FAJRNL.FA_CD like '115%' and tr_ty='2' then FAJRNL.VAL else 0 end )) as Out_115&#xD;&#xA;,(sum(case when FAJRNL.FA_CD like '116%' and tr_ty='1' then FAJRNL.VAL else 0 end )) as Add_116&#xD;&#xA;,(sum(case when FAJRNL.FA_CD like '116%' and tr_ty='2' then FAJRNL.VAL else 0 end )) as Out_116&#xD;&#xA;&#xD;&#xA;,(sum(case when FAJRNL.FA_CD like '11%' and tr_ty='1' then FAJRNL.VAL else 0 end )) as Tot_Add&#xD;&#xA;,(sum(case when FAJRNL.FA_CD like '11%' and tr_ty='2' then FAJRNL.VAL else 0 end )) as Tot_Out&#xD;&#xA;&#xD;&#xA;from FAJRNL where 1=1&#xD;&#xA;group by FAJRNL.DOC_NO,TR_DT&#xD;&#xA;order by FAJRNL.DOC_NO&#xD;&#xA;" Name="sqlDataSource1" />
  </DataSources>
