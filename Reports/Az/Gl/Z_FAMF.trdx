        </TextBox>
        <TextBox Width="2.754cm" Height="0.6cm" Left="2.86cm" Top="0.053cm" Value="= Count(Fields.FA_CD)" CanGrow="True" Name="fA_CDCountFunctionTextBox1" StyleName="Data" />
