  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="glx2023tarheel" SelectCommand="select FA_CD,Fa_nm&#xD;&#xA;,sum(DPrcVl) as DPrcVl,SUM(CFaVl) as CFaVl,sum(CFaVl) as CFaVl,sum(Cadd) as Cadd&#xD;&#xA;,sum(Cdsp) as Cdsp,sum(AFaVl) as AFaVl,sum(BgDPrc) as BgDPrc,sum(CaddAcc) as CaddAcc&#xD;&#xA;,sum(CdspAcc) as CdspAcc,sum(Dprexp1) as Dprexp1,sum(DSP_DPREXP) as DSP_DPREXP&#xD;&#xA;,sum(QPYrdPrc) as QPYrdPrc&#xD;&#xA;from (&#xD;&#xA;SELECT &#xD;&#xA;substring(famf.FA_CD,1,3) as FA_CD, 'مباني' as Fa_nm,&#xD;&#xA;Cast(ISNULL(FAMF.DPRC_VL,0) as decimal(18,4)) as DPrcVl , &#xD;&#xA;ISNULL(FADPRC_Q.FA_VL,0) as CFaVl ,&#xD;&#xA;Cast( ISNULL(FADPRC_Q.TOTADD,0)as decimal(18,4)) as Cadd  ,&#xD;&#xA;Cast(ISNULL(FADPRC_Q.TOTDSP,0)as decimal(18,4)) as Cdsp  ,&#xD;&#xA;(ISNULL(FADPRC_Q.FA_VL,0) + Round(Cast(( + ISNULL(FADPRC_Q.TOTADD,0) - &#xD;&#xA;ISNULL(FADPRC_Q.TOTDSP,0))as decimal(18,4)),2)) AS AFaVl  ,&#xD;&#xA;Cast(ISNULL(FAMF.DPRC,0)as decimal(18,4)) AS BgDPrc  ,&#xD;&#xA;Cast(ISNULL((select sum(FADPRC_Q.TOTADDACC)from FADPRC_Q  &#xD;&#xA;where FAMF.FA_CD= FADPRC_Q.FA_CD and FADPRC_Q.PRD='-99991') ,0)as decimal(18,4)) as CaddAcc ,&#xD;&#xA;Round(Cast(ISNULL((select sum(FADPRC_Q.TOTDSPACC)from FADPRC_Q  &#xD;&#xA;where FAMF.FA_CD= FADPRC_Q.FA_CD and FADPRC_Q.PRD='-99991') ,0)as decimal(18,4)),2) as CdspAcc , &#xD;&#xA;Round(Cast((ISNULL((select sum(FADPRC_Q.DPREXP)from FADPRC_Q  &#xD;&#xA;where FAMF.FA_CD= FADPRC_Q.FA_CD and FADPRC_Q.PRD &lt;='-99991') ,0) )as decimal(18,4)),2) AS Dprexp1 ,&#xD;&#xA;Round(Cast((ISNULL((select sum(FADPRC_Q.DSP_DPREXP)from FADPRC_Q  &#xD;&#xA;where FAMF.FA_CD= FADPRC_Q.FA_CD and FADPRC_Q.PRD &lt;='-99991') ,0) )as decimal(18,4)),2) AS DSP_DPREXP,&#xD;&#xA;Cast(ISNULL(FAMF.PYRDPRC,0)as decimal(18,4)) as QPYrdPrc &#xD;&#xA;FROM (FAMF  LEFT JOIN FADPRC_Q ON FADPRC_Q.FA_CD=FAMF.FA_CD) LEFT JOIN  GLCST &#xD;&#xA;ON FAMF.CST_CD=GLCST.CST_CD &#xD;&#xA;WHERE (FAMF.FA_TY&lt;&gt;1) and  (FAMF.FA_TY&lt;&gt;5) and (FAMF.FA_CD like '112%')&#xD;&#xA;and FADPRC_Q.PRD='-99991'&#xD;&#xA;) as t&#xD;&#xA;group by t.FA_CD,t.Fa_nm&#xD;&#xA;union all&#xD;&#xA;select FA_CD,Fa_nm&#xD;&#xA;,sum(DPrcVl) as DPrcVl,SUM(CFaVl) as CFaVl,sum(CFaVl) as CFaVl,sum(Cadd) as Cadd&#xD;&#xA;,sum(Cdsp) as Cdsp,sum(AFaVl) as AFaVl,sum(BgDPrc) as BgDPrc,sum(CaddAcc) as CaddAcc&#xD;&#xA;,sum(CdspAcc) as CdspAcc,sum(Dprexp1) as Dprexp1,sum(DSP_DPREXP) as DSP_DPREXP&#xD;&#xA;,sum(QPYrdPrc) as QPYrdPrc&#xD;&#xA;from (&#xD;&#xA;SELECT &#xD;&#xA;substring(famf.FA_CD,1,3) as FA_CD, 'الات' as Fa_nm,&#xD;&#xA;Cast(ISNULL(FAMF.DPRC_VL,0) as decimal(18,4)) as DPrcVl , &#xD;&#xA;ISNULL(FADPRC_Q.FA_VL,0) as CFaVl ,&#xD;&#xA;Cast( ISNULL(FADPRC_Q.TOTADD,0)as decimal(18,4)) as Cadd  ,&#xD;&#xA;Cast(ISNULL(FADPRC_Q.TOTDSP,0)as decimal(18,4)) as Cdsp  ,&#xD;&#xA;(ISNULL(FADPRC_Q.FA_VL,0) + Round(Cast(( + ISNULL(FADPRC_Q.TOTADD,0) - &#xD;&#xA;ISNULL(FADPRC_Q.TOTDSP,0))as decimal(18,4)),2)) AS AFaVl  ,&#xD;&#xA;Cast(ISNULL(FAMF.DPRC,0)as decimal(18,4)) AS BgDPrc  ,&#xD;&#xA;Cast(ISNULL((select sum(FADPRC_Q.TOTADDACC)from FADPRC_Q  &#xD;&#xA;where FAMF.FA_CD= FADPRC_Q.FA_CD and FADPRC_Q.PRD='-99991') ,0)as decimal(18,4)) as CaddAcc ,&#xD;&#xA;Round(Cast(ISNULL((select sum(FADPRC_Q.TOTDSPACC)from FADPRC_Q  &#xD;&#xA;where FAMF.FA_CD= FADPRC_Q.FA_CD and FADPRC_Q.PRD='-99991') ,0)as decimal(18,4)),2) as CdspAcc , &#xD;&#xA;Round(Cast((ISNULL((select sum(FADPRC_Q.DPREXP)from FADPRC_Q  &#xD;&#xA;where FAMF.FA_CD= FADPRC_Q.FA_CD and FADPRC_Q.PRD &lt;='-99991') ,0) )as decimal(18,4)),2) AS Dprexp1 ,&#xD;&#xA;Round(Cast((ISNULL((select sum(FADPRC_Q.DSP_DPREXP)from FADPRC_Q  &#xD;&#xA;where FAMF.FA_CD= FADPRC_Q.FA_CD and FADPRC_Q.PRD &lt;='-99991') ,0) )as decimal(18,4)),2) AS DSP_DPREXP,&#xD;&#xA;Cast(ISNULL(FAMF.PYRDPRC,0)as decimal(18,4)) as QPYrdPrc &#xD;&#xA;FROM (FAMF  LEFT JOIN FADPRC_Q ON FADPRC_Q.FA_CD=FAMF.FA_CD) LEFT JOIN  GLCST &#xD;&#xA;ON FAMF.CST_CD=GLCST.CST_CD &#xD;&#xA;WHERE (FAMF.FA_TY&lt;&gt;1) and  (FAMF.FA_TY&lt;&gt;5) and (FAMF.FA_CD like '113%')&#xD;&#xA;and FADPRC_Q.PRD='-99991'&#xD;&#xA;) as t&#xD;&#xA;group by t.FA_CD,t.Fa_nm&#xD;&#xA;union all&#xD;&#xA;select FA_CD,Fa_nm&#xD;&#xA;,sum(DPrcVl) as DPrcVl,SUM(CFaVl) as CFaVl,sum(CFaVl) as CFaVl,sum(Cadd) as Cadd&#xD;&#xA;,sum(Cdsp) as Cdsp,sum(AFaVl) as AFaVl,sum(BgDPrc) as BgDPrc,sum(CaddAcc) as CaddAcc&#xD;&#xA;,sum(CdspAcc) as CdspAcc,sum(Dprexp1) as Dprexp1,sum(DSP_DPREXP) as DSP_DPREXP&#xD;&#xA;,sum(QPYrdPrc) as QPYrdPrc&#xD;&#xA;from (&#xD;&#xA;SELECT &#xD;&#xA;substring(famf.FA_CD,1,3) as FA_CD, 'وسائل نقل' as Fa_nm,&#xD;&#xA;Cast(ISNULL(FAMF.DPRC_VL,0) as decimal(18,4)) as DPrcVl , &#xD;&#xA;ISNULL(FADPRC_Q.FA_VL,0) as CFaVl ,&#xD;&#xA;Cast( ISNULL(FADPRC_Q.TOTADD,0)as decimal(18,4)) as Cadd  ,&#xD;&#xA;Cast(ISNULL(FADPRC_Q.TOTDSP,0)as decimal(18,4)) as Cdsp  ,&#xD;&#xA;(ISNULL(FADPRC_Q.FA_VL,0) + Round(Cast(( + ISNULL(FADPRC_Q.TOTADD,0) - &#xD;&#xA;ISNULL(FADPRC_Q.TOTDSP,0))as decimal(18,4)),2)) AS AFaVl  ,&#xD;&#xA;Cast(ISNULL(FAMF.DPRC,0)as decimal(18,4)) AS BgDPrc  ,&#xD;&#xA;Cast(ISNULL((select sum(FADPRC_Q.TOTADDACC)from FADPRC_Q  &#xD;&#xA;where FAMF.FA_CD= FADPRC_Q.FA_CD and FADPRC_Q.PRD='-99991') ,0)as decimal(18,4)) as CaddAcc ,&#xD;&#xA;Round(Cast(ISNULL((select sum(FADPRC_Q.TOTDSPACC)from FADPRC_Q  &#xD;&#xA;where FAMF.FA_CD= FADPRC_Q.FA_CD and FADPRC_Q.PRD='-99991') ,0)as decimal(18,4)),2) as CdspAcc , &#xD;&#xA;Round(Cast((ISNULL((select sum(FADPRC_Q.DPREXP)from FADPRC_Q  &#xD;&#xA;where FAMF.FA_CD= FADPRC_Q.FA_CD and FADPRC_Q.PRD &lt;='-99991') ,0) )as decimal(18,4)),2) AS Dprexp1 ,&#xD;&#xA;Round(Cast((ISNULL((select sum(FADPRC_Q.DSP_DPREXP)from FADPRC_Q  &#xD;&#xA;where FAMF.FA_CD= FADPRC_Q.FA_CD and FADPRC_Q.PRD &lt;='-99991') ,0) )as decimal(18,4)),2) AS DSP_DPREXP,&#xD;&#xA;Cast(ISNULL(FAMF.PYRDPRC,0)as decimal(18,4)) as QPYrdPrc &#xD;&#xA;FROM (FAMF  LEFT JOIN FADPRC_Q ON FADPRC_Q.FA_CD=FAMF.FA_CD) LEFT JOIN  GLCST &#xD;&#xA;ON FAMF.CST_CD=GLCST.CST_CD &#xD;&#xA;WHERE (FAMF.FA_TY&lt;&gt;1) and  (FAMF.FA_TY&lt;&gt;5) and (FAMF.FA_CD like '114%')&#xD;&#xA;and FADPRC_Q.PRD='-99991'&#xD;&#xA;) as t&#xD;&#xA;group by t.FA_CD,t.Fa_nm&#xD;&#xA;union all&#xD;&#xA;select FA_CD,Fa_nm&#xD;&#xA;,sum(DPrcVl) as DPrcVl,SUM(CFaVl) as CFaVl,sum(CFaVl) as CFaVl,sum(Cadd) as Cadd&#xD;&#xA;,sum(Cdsp) as Cdsp,sum(AFaVl) as AFaVl,sum(BgDPrc) as BgDPrc,sum(CaddAcc) as CaddAcc&#xD;&#xA;,sum(CdspAcc) as CdspAcc,sum(Dprexp1) as Dprexp1,sum(DSP_DPREXP) as DSP_DPREXP&#xD;&#xA;,sum(QPYrdPrc) as QPYrdPrc&#xD;&#xA;from (&#xD;&#xA;SELECT &#xD;&#xA;substring(famf.FA_CD,1,3) as FA_CD, 'عدد وأدوات' as Fa_nm,&#xD;&#xA;Cast(ISNULL(FAMF.DPRC_VL,0) as decimal(18,4)) as DPrcVl , &#xD;&#xA;ISNULL(FADPRC_Q.FA_VL,0) as CFaVl ,&#xD;&#xA;Cast( ISNULL(FADPRC_Q.TOTADD,0)as decimal(18,4)) as Cadd  ,&#xD;&#xA;Cast(ISNULL(FADPRC_Q.TOTDSP,0)as decimal(18,4)) as Cdsp  ,&#xD;&#xA;(ISNULL(FADPRC_Q.FA_VL,0) + Round(Cast(( + ISNULL(FADPRC_Q.TOTADD,0) - &#xD;&#xA;ISNULL(FADPRC_Q.TOTDSP,0))as decimal(18,4)),2)) AS AFaVl  ,&#xD;&#xA;Cast(ISNULL(FAMF.DPRC,0)as decimal(18,4)) AS BgDPrc  ,&#xD;&#xA;Cast(ISNULL((select sum(FADPRC_Q.TOTADDACC)from FADPRC_Q  &#xD;&#xA;where FAMF.FA_CD= FADPRC_Q.FA_CD and FADPRC_Q.PRD='-99991') ,0)as decimal(18,4)) as CaddAcc ,&#xD;&#xA;Round(Cast(ISNULL((select sum(FADPRC_Q.TOTDSPACC)from FADPRC_Q  &#xD;&#xA;where FAMF.FA_CD= FADPRC_Q.FA_CD and FADPRC_Q.PRD='-99991') ,0)as decimal(18,4)),2) as CdspAcc , &#xD;&#xA;Round(Cast((ISNULL((select sum(FADPRC_Q.DPREXP)from FADPRC_Q  &#xD;&#xA;where FAMF.FA_CD= FADPRC_Q.FA_CD and FADPRC_Q.PRD &lt;='-99991') ,0) )as decimal(18,4)),2) AS Dprexp1 ,&#xD;&#xA;Round(Cast((ISNULL((select sum(FADPRC_Q.DSP_DPREXP)from FADPRC_Q  &#xD;&#xA;where FAMF.FA_CD= FADPRC_Q.FA_CD and FADPRC_Q.PRD &lt;='-99991') ,0) )as decimal(18,4)),2) AS DSP_DPREXP,&#xD;&#xA;Cast(ISNULL(FAMF.PYRDPRC,0)as decimal(18,4)) as QPYrdPrc &#xD;&#xA;FROM (FAMF  LEFT JOIN FADPRC_Q ON FADPRC_Q.FA_CD=FAMF.FA_CD) LEFT JOIN  GLCST &#xD;&#xA;ON FAMF.CST_CD=GLCST.CST_CD &#xD;&#xA;WHERE (FAMF.FA_TY&lt;&gt;1) and  (FAMF.FA_TY&lt;&gt;5) and (FAMF.FA_CD like '115%')&#xD;&#xA;and FADPRC_Q.PRD='-99991'&#xD;&#xA;) as t&#xD;&#xA;group by t.FA_CD,t.Fa_nm&#xD;&#xA;union all&#xD;&#xA;select FA_CD,Fa_nm&#xD;&#xA;,sum(DPrcVl) as DPrcVl,SUM(CFaVl) as CFaVl,sum(CFaVl) as CFaVl,sum(Cadd) as Cadd&#xD;&#xA;,sum(Cdsp) as Cdsp,sum(AFaVl) as AFaVl,sum(BgDPrc) as BgDPrc,sum(CaddAcc) as CaddAcc&#xD;&#xA;,sum(CdspAcc) as CdspAcc,sum(Dprexp1) as Dprexp1,sum(DSP_DPREXP) as DSP_DPREXP&#xD;&#xA;,sum(QPYrdPrc) as QPYrdPrc&#xD;&#xA;from (&#xD;&#xA;SELECT &#xD;&#xA;substring(famf.FA_CD,1,3) as FA_CD, 'أثاث ومعدات مكتبية' as Fa_nm,&#xD;&#xA;Cast(ISNULL(FAMF.DPRC_VL,0) as decimal(18,4)) as DPrcVl , &#xD;&#xA;ISNULL(FADPRC_Q.FA_VL,0) as CFaVl ,&#xD;&#xA;Cast( ISNULL(FADPRC_Q.TOTADD,0)as decimal(18,4)) as Cadd  ,&#xD;&#xA;Cast(ISNULL(FADPRC_Q.TOTDSP,0)as decimal(18,4)) as Cdsp  ,&#xD;&#xA;(ISNULL(FADPRC_Q.FA_VL,0) + Round(Cast(( + ISNULL(FADPRC_Q.TOTADD,0) - &#xD;&#xA;ISNULL(FADPRC_Q.TOTDSP,0))as decimal(18,4)),2)) AS AFaVl  ,&#xD;&#xA;Cast(ISNULL(FAMF.DPRC,0)as decimal(18,4)) AS BgDPrc  ,&#xD;&#xA;Cast(ISNULL((select sum(FADPRC_Q.TOTADDACC)from FADPRC_Q  &#xD;&#xA;where FAMF.FA_CD= FADPRC_Q.FA_CD and FADPRC_Q.PRD='-99991') ,0)as decimal(18,4)) as CaddAcc ,&#xD;&#xA;Round(Cast(ISNULL((select sum(FADPRC_Q.TOTDSPACC)from FADPRC_Q  &#xD;&#xA;where FAMF.FA_CD= FADPRC_Q.FA_CD and FADPRC_Q.PRD='-99991') ,0)as decimal(18,4)),2) as CdspAcc , &#xD;&#xA;Round(Cast((ISNULL((select sum(FADPRC_Q.DPREXP)from FADPRC_Q  &#xD;&#xA;where FAMF.FA_CD= FADPRC_Q.FA_CD and FADPRC_Q.PRD &lt;='-99991') ,0) )as decimal(18,4)),2) AS Dprexp1 ,&#xD;&#xA;Round(Cast((ISNULL((select sum(FADPRC_Q.DSP_DPREXP)from FADPRC_Q  &#xD;&#xA;where FAMF.FA_CD= FADPRC_Q.FA_CD and FADPRC_Q.PRD &lt;='-99991') ,0) )as decimal(18,4)),2) AS DSP_DPREXP,&#xD;&#xA;Cast(ISNULL(FAMF.PYRDPRC,0)as decimal(18,4)) as QPYrdPrc &#xD;&#xA;FROM (FAMF  LEFT JOIN FADPRC_Q ON FADPRC_Q.FA_CD=FAMF.FA_CD) LEFT JOIN  GLCST &#xD;&#xA;ON FAMF.CST_CD=GLCST.CST_CD &#xD;&#xA;WHERE (FAMF.FA_TY&lt;&gt;1) and  (FAMF.FA_TY&lt;&gt;5) and (FAMF.FA_CD like '116%')&#xD;&#xA;and FADPRC_Q.PRD='-99991'&#xD;&#xA;) as t&#xD;&#xA;group by t.FA_CD,t.Fa_nm&#xD;&#xA;&#xD;&#xA;" Name="sqlDataSource1" />
