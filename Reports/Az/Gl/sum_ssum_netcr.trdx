<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource1" Width="29.9cm" Name="QueryGlJrnl1" xmlns="http://schemas.telerik.com/reporting/2021/1.0">
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="glx2023" SelectCommand="select &#xD;&#xA;sum_cd,(select sum_nm_ar from glsums where glsums.sum_cd= gljrnld.sum_cd) as sum_nm,&#xD;&#xA;SSUM_CD,(select ssum_nm_ar from glssums where glssums.ssum_cd= gljrnld.ssum_cd) as ssum_nm,&#xD;&#xA;sum(case when PRD='202300' or tr_dt &lt; '01/01/1901' then (cr_vl-db_vl) else 0 end) as s0,&#xD;&#xA;sum(case when PRD&lt;&gt;'202300' and tr_dt &gt;= '01/01/1901' and tr_dt&lt;='01/01/1902' then (db_vl) else 0 end) as db_vl,&#xD;&#xA;sum(case when PRD&lt;&gt;'202300' and tr_dt &gt;= '01/01/1901' and tr_dt&lt;='01/01/1902' then (cr_vl) else 0 end) as cr_vl,&#xD;&#xA;(sum(case when PRD='202300' or tr_dt &lt; '01/01/1901' then (cr_vl-db_vl) else 0 end) &#xD;&#xA;-&#xD;&#xA;sum(case when PRD&lt;&gt;'202300' and tr_dt &gt;= '01/01/1901' and tr_dt&lt;='01/01/1902' then (db_vl) else 0 end)&#xD;&#xA;+&#xD;&#xA;sum(case when PRD&lt;&gt;'202300' and tr_dt &gt;= '01/01/1901' and tr_dt&lt;='01/01/1902' then (cr_vl) else 0 end) &#xD;&#xA;) as bal&#xD;&#xA;from gljrnld where 1=1 and tr_dt&lt;='01/01/1902'&#xD;&#xA;group by sum_cd,SSUM_CD&#xD;&#xA;order by sum_cd,SSUM_CD&#xD;&#xA;" Name="sqlDataSource1" />
  </DataSources>
