        <TextBox Width="12.4cm" Height="0.5cm" Left="2.411cm" Top="7.712cm" Value="قامت اللجنة بأعمــال الجرد الفعلى للنقدية الموجـودة بالخزينــة و الإطــلاع علــى دفتـــر حركــة الخزينــة -" Name="textBox20">
