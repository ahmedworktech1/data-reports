<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource1" Width="16.6cm" Name="محضر اجرءات جرد خزينة الصندوق" Zoom="1.5" xmlns="http://schemas.telerik.com/reporting/2023/1.0">
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="glxsandoaa" SelectCommand="WITH Member_CTE AS (&#xD;&#xA;    SELECT &#xD;&#xA;        C.InventoryID,&#xD;&#xA;        emp.empname AS MemberName,&#xD;&#xA;        ROW_NUMBER() OVER (PARTITION BY C.InventoryID ORDER BY (SELECT NULL)) AS rn&#xD;&#xA;    FROM Committee_Cash_Inventory C&#xD;&#xA;    CROSS APPLY STRING_SPLIT(REPLACE(REPLACE(C.CommitteeMembers, '''', ''), ' ', ''), ',') AS split&#xD;&#xA;    LEFT JOIN Pyemployees emp ON emp.EmpNo = TRY_CAST(split.value AS INT)&#xD;&#xA;)&#xD;&#xA;SELECT &#xD;&#xA;    (SELECT TOP 1 empname FROM Pyemployees WHERE Committee_Cash_Inventory.CommitteePresident = Pyemployees.EmpNo) AS CommitteePresident,&#xD;&#xA;    MAX(CASE WHEN M.rn = 1 THEN M.MemberName END) AS Member1,&#xD;&#xA;    MAX(CASE WHEN M.rn = 2 THEN M.MemberName END) AS Member2,&#xD;&#xA;    MAX(CASE WHEN M.rn = 3 THEN M.MemberName END) AS Member3,&#xD;&#xA;    MAX(CASE WHEN M.rn = 4 THEN M.MemberName END) AS Member4,&#xD;&#xA;    MAX(CASE WHEN M.rn = 5 THEN M.MemberName END) AS Member5,&#xD;&#xA;    Committee_Cash_Inventory.ActualBalance,&#xD;&#xA;    SUM(D.totalValue) AS balance,&#xD;&#xA;    Committee_Cash_Inventory.ActualBalance - SUM(D.totalValue) AS difference,&#xD;&#xA;    Committee_Cash_Inventory.InventoryDate,&#xD;&#xA;    MAX(CASE WHEN D.CurrencyDenomination = '1' THEN D.Quantity END) AS s1,&#xD;&#xA;    MAX(CASE WHEN D.CurrencyDenomination = '2' THEN D.Quantity END) AS s2,&#xD;&#xA;    MAX(CASE WHEN D.CurrencyDenomination = '3' THEN D.Quantity END) AS s3,&#xD;&#xA;    MAX(CASE WHEN D.CurrencyDenomination = '4' THEN D.Quantity END) AS s4,&#xD;&#xA;    MAX(CASE WHEN D.CurrencyDenomination = '5' THEN D.Quantity END) AS s5,&#xD;&#xA;    MAX(CASE WHEN D.CurrencyDenomination = '6' THEN D.Quantity END) AS s6,&#xD;&#xA;    MAX(CASE WHEN D.CurrencyDenomination = '7' THEN D.Quantity END) AS s7,&#xD;&#xA;    MAX(CASE WHEN D.CurrencyDenomination = '8' THEN D.Quantity END) AS s8,&#xD;&#xA;    MAX(CASE WHEN D.CurrencyDenomination = '9' THEN D.Quantity END) AS s9,&#xD;&#xA;    MAX(CASE WHEN D.CurrencyDenomination = '10' THEN D.Quantity END) AS s10,&#xD;&#xA;    MAX(CASE WHEN D.CurrencyDenomination = '11' THEN D.Quantity END) AS s11,&#xD;&#xA;    MAX(CASE WHEN D.CurrencyDenomination = '12' THEN D.Quantity END) AS s12,&#xD;&#xA;    MAX(CASE WHEN D.CurrencyDenomination = '1' THEN D.TotalValue END) AS ss1,&#xD;&#xA;    MAX(CASE WHEN D.CurrencyDenomination = '2' THEN D.TotalValue END) AS ss2,&#xD;&#xA;    MAX(CASE WHEN D.CurrencyDenomination = '3' THEN D.TotalValue END) AS ss3,&#xD;&#xA;    MAX(CASE WHEN D.CurrencyDenomination = '4' THEN D.TotalValue END) AS ss4,&#xD;&#xA;    MAX(CASE WHEN D.CurrencyDenomination = '5' THEN D.TotalValue END) AS ss5,&#xD;&#xA;    MAX(CASE WHEN D.CurrencyDenomination = '6' THEN D.TotalValue END) AS ss6,&#xD;&#xA;    MAX(CASE WHEN D.CurrencyDenomination = '7' THEN D.TotalValue END) AS ss7,&#xD;&#xA;    MAX(CASE WHEN D.CurrencyDenomination = '8' THEN D.TotalValue END) AS ss8,&#xD;&#xA;    MAX(CASE WHEN D.CurrencyDenomination = '9' THEN D.TotalValue END) AS ss9,&#xD;&#xA;    MAX(CASE WHEN D.CurrencyDenomination = '10' THEN D.TotalValue END) AS ss10,&#xD;&#xA;    MAX(CASE WHEN D.CurrencyDenomination = '11' THEN D.TotalValue END) AS ss11,&#xD;&#xA;    MAX(CASE WHEN D.CurrencyDenomination = '12' THEN D.TotalValue END) AS ss12,&#xD;&#xA;    SUM(CASE WHEN D.CurrencyDenomination IN ('10', '11', '12') THEN D.Quantity ELSE 0 END) AS sss1,&#xD;&#xA;    COALESCE(MAX(CASE WHEN D.CurrencyDenomination = '1' THEN D.TotalValue END), 0) +&#xD;&#xA;    COALESCE(MAX(CASE WHEN D.CurrencyDenomination = '2' THEN D.TotalValue END), 0) +&#xD;&#xA;    COALESCE(MAX(CASE WHEN D.CurrencyDenomination = '3' THEN D.TotalValue END), 0) +&#xD;&#xA;    COALESCE(MAX(CASE WHEN D.CurrencyDenomination = '4' THEN D.TotalValue END), 0) +&#xD;&#xA;    COALESCE(MAX(CASE WHEN D.CurrencyDenomination = '5' THEN D.TotalValue END), 0) +&#xD;&#xA;    COALESCE(MAX(CASE WHEN D.CurrencyDenomination = '6' THEN D.TotalValue END), 0) +&#xD;&#xA;    COALESCE(MAX(CASE WHEN D.CurrencyDenomination = '7' THEN D.TotalValue END), 0) +&#xD;&#xA;    COALESCE(MAX(CASE WHEN D.CurrencyDenomination = '8' THEN D.TotalValue END), 0) +&#xD;&#xA;    COALESCE(MAX(CASE WHEN D.CurrencyDenomination = '9' THEN D.TotalValue END), 0) +&#xD;&#xA;    COALESCE(MAX(CASE WHEN D.CurrencyDenomination = '10' THEN D.TotalValue END), 0) AS مجموع&#xD;&#xA;FROM &#xD;&#xA;    Committee_Cash_Inventory&#xD;&#xA;INNER JOIN &#xD;&#xA;    Committee_Cash_Details D ON Committee_Cash_Inventory.InventoryID = D.InventoryID&#xD;&#xA;LEFT JOIN &#xD;&#xA;    Member_CTE M ON Committee_Cash_Inventory.InventoryID = M.InventoryID&#xD;&#xA;where (1=1)&#xD;&#xA;GROUP BY &#xD;&#xA;    Committee_Cash_Inventory.InventoryID, Committee_Cash_Inventory.CommitteePresident, Committee_Cash_Inventory.ActualBalance, Committee_Cash_Inventory.InventoryDate;" Name="sqlDataSource1" />
  </DataSources>
