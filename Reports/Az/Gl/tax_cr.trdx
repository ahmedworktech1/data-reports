    <ReportFooterSection Height="0.9cm" Name="reportFooterSection1">
      <Style BackgroundColor="White" />
      <Items>
        <TextBox Width="12.9cm" Height="0.6cm" Left="4.1cm" Top="0cm" Value="الاجمالى" Name="textBox17">
          <Style BackgroundColor="Yellow" Color="Red" TextAlign="Center" VerticalAlign="Middle">
            <Font Size="9pt" Bold="True" />
