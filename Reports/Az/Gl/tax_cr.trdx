<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource1" Width="17cm" Name="QueryGlJrnl1" xmlns="http://schemas.telerik.com/reporting/2023/1.0">
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="glx2023" SelectCommand="select &#xD;&#xA;acc_no,(select acc_nm_ar from glmf where glmf.acc_no = gljrnld.acc_no) as acc_nm,&#xD;&#xA;sum_cd,(select sum_nm_ar from glsums where glsums.sum_cd = gljrnld.sum_cd) as sum_nm,&#xD;&#xA;jrn_cd,(select DOC_DS_Ar from GLTRSTBL where GLTRSTBL.DOC_TY=gljrnld.jrn_cd) as doc_nm,&#xD;&#xA;tr_no,tr_dt,tr_ds,CR_VL&#xD;&#xA;from gljrnld &#xD;&#xA;where CR_VL&gt;0 and acc_no like '324320%' and 1=1&#xD;&#xA;order by jrn_cd,tr_dt,tr_no,acc_no,sum_cd&#xD;&#xA;" Name="sqlDataSource1" />
  </DataSources>
  <Items>
    <PageHeaderSection Height="1.3cm" Name="pageHeaderSection1">
      <Style BackgroundColor="" />
      <Items>
        <TextBox Width="5.7cm" Height="0.5cm" Left="5.2cm" Top="0.1cm" Value="طباعه دفتر الضرائب دائن" Name="textBox3">
          <Style TextAlign="Center">
            <Font Bold="True" />
          </Style>
        </TextBox>
        <TextBox Width="1.6cm" Height="0.6cm" Left="15.3cm" Top="0.7cm" Value="رقم الحساب" Name="textBox2">
