        <TextBox Width="4cm" Height="0.6cm" Left="0.1cm" Top="0cm" Value="= sum(Fields.CR_VL)" Format="{0:#.00}" Name="textBox19">
          <Style BackgroundColor="Yellow" Color="Red" TextAlign="Center" VerticalAlign="Middle">
            <Font Size="9pt" Bold="True" />
