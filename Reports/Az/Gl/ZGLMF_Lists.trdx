<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource1" Width="17cm" Culture="ar" Name="ZGLMF_Lists" DocumentMapText="" xmlns="http://schemas.telerik.com/reporting/2021/1.0">
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="GLACCOUNTELMENIA" SelectCommand="SELECT * FROM GLMF" Name="sqlDataSource1" />
  </DataSources>
  <Items>
    <PageHeaderSection Height="0.9cm" Name="pageHeaderSection1">
      <Items>
        <TextBox Width="3cm" Height="0.6cm" Left="1cm" Top="0.3cm" Value="Account No" Name="textBox6">
          <Style TextAlign="Right">
            <BorderStyle Default="Solid" />
          </Style>
        </TextBox>
        <TextBox Width="3cm" Height="0.6cm" Left="4cm" Top="0.3cm" Value="Account Name Ar" Name="textBox7">
          <Style TextAlign="Right">
            <BorderStyle Default="Solid" />
          </Style>
        </TextBox>
        <TextBox Width="3cm" Height="0.6cm" Left="7cm" Top="0.3cm" Value="Account Name En" Name="textBox8">
          <Style TextAlign="Right">
            <BorderStyle Default="Solid" />
          </Style>
        </TextBox>
        <TextBox Width="3cm" Height="0.6cm" Left="10.001cm" Top="0.3cm" Value="Account Level" Name="textBox9">
          <Style TextAlign="Right">
            <BorderStyle Default="Solid" />
          </Style>
        </TextBox>
        <TextBox Width="3cm" Height="0.6cm" Left="13.001cm" Top="0.3cm" Value="Account Type" Name="textBox10">
          <Style TextAlign="Right">
            <BorderStyle Default="Solid" />
          </Style>
        </TextBox>
      </Items>
    </PageHeaderSection>
    <DetailSection Height="0.6cm" Name="detailSection1">
      <Items>
        <TextBox Width="3cm" Height="0.6cm" Left="1cm" Top="0cm" Value="= Fields.ACC_NO" Name="textBox1">
          <Style TextAlign="Right">
            <BorderStyle Default="Solid" />
          </Style>
        </TextBox>
        <TextBox Width="3cm" Height="0.6cm" Left="4cm" Top="0cm" Value="= Fields.ACC_NM_Ar" Name="textBox2">
          <Style TextAlign="Right">
            <BorderStyle Default="Solid" />
          </Style>
        </TextBox>
        <TextBox Width="3cm" Height="0.6cm" Left="7cm" Top="0cm" Value="= Fields.ACC_NM_En" Name="textBox3">
          <Style TextAlign="Right">
            <BorderStyle Default="Solid" />
          </Style>
        </TextBox>
        <TextBox Width="3cm" Height="0.6cm" Left="10.001cm" Top="0cm" Value="= Fields.ACC_LVL" Name="textBox4">
          <Style TextAlign="Right">
            <BorderStyle Default="Solid" />
          </Style>
        </TextBox>
        <TextBox Width="3cm" Height="0.6cm" Left="13.001cm" Top="0cm" Value="= Fields.ACC_TY" Name="textBox5">
          <Style TextAlign="Right">
            <BorderStyle Default="Solid" />
          </Style>
        </TextBox>
      </Items>
    </DetailSection>
    <PageFooterSection Height="2cm" Name="pageFooterSection1" />
  </Items>
  <PageSettings PaperKind="A4" Landscape="False">
    <Margins>
      <MarginsU Left="2cm" Right="2cm" Top="2cm" Bottom="2cm" />
    </Margins>
  </PageSettings>
  <StyleSheet>
    <StyleRule>
      <Style TextAlign="Right">
        <Padding Left="2pt" Right="2pt" />
      </Style>
      <Selectors>
        <TypeSelector Type="TextItemBase" />
        <TypeSelector Type="HtmlTextBox" />
      </Selectors>
    </StyleRule>
  </StyleSheet>
</Report>