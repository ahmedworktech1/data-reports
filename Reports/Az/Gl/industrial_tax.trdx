<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource1" Width="17cm" Name="QueryGlJrnl1" xmlns="http://schemas.telerik.com/reporting/2023/1.0">
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="glx2023" SelectCommand="select &#xD;&#xA;sum_cd,(select sum_nm_ar from glsums where glsums.sum_cd = gljrnld.sum_cd) as sum_nm,&#xD;&#xA;   CASE &#xA;        WHEN ISNULL(Fpon, 0) = 0 THEN 0  &#xA;        ELSE ((ISNULL(CR_VL, 0) * 100) / ISNULL(Fpon, 0)) - ISNULL(DB_VL, 0)&#xA;    END AS val,&#xD;&#xA;&#xD;&#xA;isnull(Fpon,0) as fpon,CR_VL,tr_no,ln_no,tr_ds,tr_dt,&#xD;&#xA;jrn_cd,(select DOC_DS_Ar from GLTRSTBL where GLTRSTBL.DOC_TY = GLJRNLd.JRN_CD) as jrn_nm&#xD;&#xA;from gljrnld where acc_no = '3243205' and sum_cd is not null --and CR_VL &gt;0 &#xD;&#xA;order by jrn_cd,tr_dt,tr_no,sum_cd&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;" Name="sqlDataSource1" />
  </DataSources>
