as s2,&#xD;&#xA;&#xD;&#xA;(CAST(ROUND(sum( case when (( ( acc_no like '5[6-8]1222%' ) and  SUM_CD IN ('11','12','13')) ) then db_vl-cr_vl else 0 end ), 0) AS BIGINT)*-1&#xD;&#xA;+&#xD;&#xA;(CAST(ROUND(sum( case when (( ( acc_no like '5[6-8]1122102%') and  SUM_CD IN ('11','12','13')) ) then db_vl-cr_vl else 0 end ), 0) AS BIGINT)*-1)&#xD;&#xA;+&#xD;&#xA;CAST(ROUND(sum( case when (( ( acc_no like '5[6-8]122208%' ) and  SUM_CD IN ('11','12','13')) ) then db_vl-cr_vl else 0 end ), 0) AS BIGINT)*-1)&#xD;&#xA;-&#xD;&#xA;(CAST(ROUND(sum( case when  (( acc_no like '4[6]31%' OR  acc_no like '4[6]32%' OR  acc_no like '4[6]11%' OR  acc_no like '4[6]12%' OR  acc_no like '4[6]2%') and  SUM_CD IN ('12') ) then db_vl-cr_vl else 0 end ), 0) AS BIGINT)&#xD;&#xA;+&#xD;&#xA; CAST(ROUND(sum( case when  ( ( acc_no like '4[7]11%' OR  acc_no like '4[7]12%' OR  acc_no like '4[7]2%') and  SUM_CD IN ('12') ) then db_vl-cr_vl else 0 end ), 0) AS BIGINT)&#xD;&#xA;+&#xD;&#xA; CAST(ROUND(sum( case when  ( ( acc_no like '4[8]11%' OR  acc_no like '4[8]12%' OR  acc_no like '4[8]2%') and  SUM_CD IN ('12') ) then db_vl-cr_vl else 0 end ), 0) AS BIGINT))&#xD;&#xA; &#xD;&#xA; as s3,&#xD;&#xA;&#xD;&#xA;(CAST(ROUND(sum( case when (( ( acc_no like '5[6-8]1221%' ) and  substring(cst_cd,6,7) in ('63','73','83')) ) then db_vl-cr_vl else 0 end ), 0) AS BIGINT)*-1)&#xD;&#xA;-&#xD;&#xA;(CAST(ROUND(sum( case when (( acc_no like '4[6]31%' OR  acc_no like '4[6]32%' OR  acc_no like '4[6]11%' OR  acc_no like '4[6]12%' OR  acc_no like '4[6]2%') and  SUM_CD IN ('13')  ) then db_vl-cr_vl else 0 end ), 0) AS BIGINT)&#xD;&#xA;+&#xD;&#xA;CAST(ROUND(sum( case when ( ( acc_no like '4[7]11%' OR  acc_no like '4[7]12%' OR  acc_no like '4[7]2%') and  SUM_CD IN ('13')  ) then db_vl-cr_vl else 0 end ), 0) AS BIGINT)&#xD;&#xA;+&#xD;&#xA;CAST(ROUND(sum( case when ( ( acc_no like '4[8]11%' OR  acc_no like '4[8]12%' OR  acc_no like '4[8]2%') and  SUM_CD IN ('13')  ) then db_vl-cr_vl else 0 end ), 0) AS BIGINT))&#xD;&#xA;&#xD;&#xA; as