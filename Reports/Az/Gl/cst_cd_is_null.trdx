  <Style Visible="True" />
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="glx2023" SelectCommand="select jrn_Cd,(select DOC_DS_Ar from GLTRSTBL where doc_ty = gljrnld.JRN_CD) as nm,tr_no,LN_NO,acc_no,(select acc_nm_ar from glmf where acc_no = gljrnld.acc_no ) as acnm from gljrnld where (cst_cd is null or cst_Cd = '') and (acc_no like '4[6-8][1-2]%' or ACC_NO like '5[6-8]1%' ) order by jrn_Cd,tr_no,LN_NO" Name="sqlDataSource2" />
  </DataSources>
