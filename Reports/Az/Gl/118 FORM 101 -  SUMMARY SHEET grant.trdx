<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource1" Width="297mm" Name="Report" xmlns="http://schemas.telerik.com/reporting/2023/1.0">
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="GLX" SelectCommand="SELECT &#xD;&#xA;(SELECT (select ssum_nm_ar from glssums where ssum_Cd = LC_DSCR_Ar) FROM GLLCMF WHERE SUM_CD=GLJRNLD.SUM_CD)AS DSCR ,&#xD;&#xA;(SELECT btch_id FROM glcst WHERE cst_cd = gljrnld.cst_cd) AS btich,&#xD;&#xA;TR_NO as tr_no,&#xD;&#xA;rate as rate,&#xD;&#xA;tr_ds AS tr_dsc,&#xD;&#xA;acc_no ,&#xD;&#xA;(cur_vl * ln_ty) AS cur,&#xD;&#xA;(select EQU from glmf where acc_no=LEFT (GLJRNLD.ACC_NO,4))as wano,&#xD;&#xA;(SELECT LC_NO FROM GLLCMF WHERE SUM_CD=GLJRNLD.SUM_CD)AS LCNO , -- رقم العقد&#xD;&#xA;sum(db_vl-cr_vl) as summ,&#xD;&#xA;(SELECT fmly FROM glmf WHERE acc_no = gljrnld.acc_no) AS fmly,&#xD;&#xA;(SELECT CNTRCT_VAL FROM GLSUMS WHERE SUM_CD=GLJRNLD.SUM_CD)AS val -- قيمة العقد&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;FROM GLJRNLD&#xD;&#xA;group by TR_NO,GLJRNLD.SUM_CD , gljrnld.cst_cd,rate,tr_ds,GLJRNLD.CUR_VL,GLJRNLD.LN_TY,GLJRNLD.ACC_NO&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;  " Name="sqlDataSource1" />
  </DataSources>
