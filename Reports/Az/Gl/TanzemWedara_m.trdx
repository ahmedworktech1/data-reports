  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="glx2023tarheel" SelectCommand="select FA_CD,Fa_nm&#xD;&#xA;,sum(DPrcVl) as DPrcVl,SUM(CFaVl) as CFaVl,sum(CFaVl) as CFaVl,sum(Cadd) as Cadd&#xD;&#xA;,sum(Cdsp) as Cdsp,sum(AFaVl) as AFaVl,sum(BgDPrc) as BgDPrc,sum(CaddAcc) as CaddAcc&#xD;&#xA;,sum(CdspAcc) as CdspAcc,sum(Dprexp1) as Dprexp1,sum(DSP_DPREXP) as DSP_DPREXP&#xD;&#xA;,sum(QPYrdPrc) as QPYrdPrc&#xD;&#xA;from (&#xD;&#xA;SELECT &#xD;&#xA;substring(famf.FA_CD,1,3) as FA_CD, 'أراضي' as Fa_nm,&#xD;&#xA;Cast(ISNULL(FAMF.DPRC_VL,0) as decimal(18,4)) as DPrcVl , &#xD;&#xA;ISNULL(FADPRC.FA_VL,0) as CFaVl ,&#xD;&#xA;Cast( ISNULL(FADPRC.TOTADD,0)as decimal(18,4)) as Cadd  ,&#xD;&#xA;Cast(ISNULL(FADPRC.TOTDSP,0)as decimal(18,4)) as Cdsp  ,&#xD;&#xA;(ISNULL(FADPRC.FA_VL,0) + Round(Cast(( + ISNULL(FADPRC.TOTADD,0) - &#xD;&#xA;ISNULL(FADPRC.TOTDSP,0))as decimal(18,4)),2)) AS AFaVl  ,&#xD;&#xA;Cast(ISNULL(FAMF.DPRC,0)as decimal(18,4)) AS BgDPrc  ,&#xD;&#xA;Cast(ISNULL((select sum(FADPRC.TOTADDACC)from FADPRC  &#xD;&#xA;where FAMF.FA_CD= FADPRC.FA_CD and FADPRC.PRD='-99991') ,0)as decimal(18,4)) as CaddAcc ,&#xD;&#xA;Round(Cast(ISNULL((select sum(FADPRC.TOTDSPACC)from FADPRC  &#xD;&#xA;where FAMF.FA_CD= FADPRC.FA_CD and FADPRC.PRD='-99991') ,0)as decimal(18,4)),2) as CdspAcc , &#xD;&#xA;Round(Cast((ISNULL((select sum(FADPRC.DPREXP)from FADPRC  &#xD;&#xA;where FAMF.FA_CD= FADPRC.FA_CD and FADPRC.PRD &lt;='-99991') ,0) )as decimal(18,4)),2) AS Dprexp1 ,&#xD;&#xA;Round(Cast((ISNULL((select sum(FADPRC.DSP_DPREXP)from FADPRC  &#xD;&#xA;where FAMF.FA_CD= FADPRC.FA_CD and FADPRC.PRD &lt;='-99991') ,0) )as decimal(18,4)),2) AS DSP_DPREXP,&#xD;&#xA;Cast(ISNULL(FAMF.PYRDPRC,0)as decimal(18,4)) as QPYrdPrc &#xD;&#xA;FROM (FAMF  LEFT JOIN FADPRC ON FADPRC.FA_CD=FAMF.FA_CD) LEFT JOIN  GLCST &#xD;&#xA;ON FAMF.CST_CD=GLCST.CST_CD &#xD;&#xA;WHERE (FAMF.FA_TY&lt;&gt;1) and  (FAMF.FA_TY&lt;&gt;5) and (FAMF.FA_CD like '111%')&#xD;&#xA;and FADPRC.PRD='-99991' and 1=1&#xD;&#xA;) as t&#xD;&#xA;group by t.FA_CD,t.Fa_nm&#xD;&#xA;union all&#xD;&#xA;select FA_CD,Fa_nm&#xD;&#xA;,sum(DPrcVl) as DPrcVl,SUM(CFaVl) as CFaVl,sum(CFaVl) as CFaVl,sum(Cadd) as Cadd&#xD;&#xA;,sum(Cdsp) as Cdsp,sum(AFaVl) as AFaVl,sum(BgDPrc) as BgDPrc,sum(CaddAcc) as CaddAcc&#xD;&#xA;,sum(CdspAcc) as CdspAcc,sum(Dprexp1) as Dprexp1,sum(DSP_DPREXP) as DSP_DPREXP&#xD;&#xA;,sum(QPYrdPrc) as QPYrdPrc&#xD;&#xA;from (&#xD;&#xA;SELECT &#xD;&#xA;substring(famf.FA_CD,1,3) as FA_CD, 'مباني' as Fa_nm,&#xD;&#xA;Cast(ISNULL(FAMF.DPRC_VL,0) as decimal(18,4)) as DPrcVl , &#xD;&#xA;ISNULL(FADPRC.FA_VL,0) as CFaVl ,&#xD;&#xA;Cast( ISNULL(FADPRC.TOTADD,0)as decimal(18,4)) as Cadd  ,&#xD;&#xA;Cast(ISNULL(FADPRC.TOTDSP,0)as decimal(18,4)) as Cdsp  ,&#xD;&#xA;(ISNULL(FADPRC.FA_VL,0) + Round(Cast(( + ISNULL(FADPRC.TOTADD,0) - &#xD;&#xA;ISNULL(FADPRC.TOTDSP,0))as decimal(18,4)),2)) AS AFaVl  ,&#xD;&#xA;Cast(ISNULL(FAMF.DPRC,0)as decimal(18,4)) AS BgDPrc  ,&#xD;&#xA;Cast(ISNULL((select sum(FADPRC.TOTADDACC)from FADPRC  &#xD;&#xA;where FAMF.FA_CD= FADPRC.FA_CD and FADPRC.PRD='-99991') ,0)as decimal(18,4)) as CaddAcc ,&#xD;&#xA;Round(Cast(ISNULL((select sum(FADPRC.TOTDSPACC)from FADPRC  &#xD;&#xA;where FAMF.FA_CD= FADPRC.FA_CD and FADPRC.PRD='-99991') ,0)as decimal(18,4)),2) as CdspAcc , &#xD;&#xA;Round(Cast((ISNULL((select sum(FADPRC.DPREXP)from FADPRC  &#xD;&#xA;where FAMF.FA_CD= FADPRC.FA_CD and FADPRC.PRD &lt;='-99991') ,0) )as decimal(18,4)),2) AS Dprexp1 ,&#xD;&#xA;Round(Cast((ISNULL((select sum(FADPRC.DSP_DPREXP)from FADPRC  &#xD;&#xA;where FAMF.FA_CD= FADPRC.FA_CD and FADPRC.PRD &lt;='-99991') ,0) )as decimal(18,4)),2) AS DSP_DPREXP,&#xD;&#xA;Cast(ISNULL(FAMF.PYRDPRC,0)as decimal(18,4)) as QPYrdPrc &#xD;&#xA;FROM (FAMF  LEFT JOIN FADPRC ON FADPRC.FA_CD=FAMF.FA_CD) LEFT JOIN  GLCST &#xD;&#xA;ON FAMF.CST_CD=GLCST.CST_CD &#xD;&#xA;WHERE (FAMF.FA_TY&lt;&gt;1) and  (FAMF.FA_TY&lt;&gt;5) and (FAMF.FA_CD like '112%')&#xD;&#xA;and FADPRC.PRD='-99991' and 1=1&#xD;&#xA;) as t&#