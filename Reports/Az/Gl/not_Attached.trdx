  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="glx20231" SelectCommand="SELECT jrn_cd, (select DOC_DS_Ar from GLTRSTBL where GLTRSTBL.DOC_TY=gljrnlh.jrn_cd) as jrn_nm,&#xD;&#xA;tr_no,tr_dt,HDSCR&#xD;&#xA;FROM dbo.GLJRNLH&#xD;&#xA;WHERE not EXISTS(&#xD;&#xA;SELECT 1 FROM glx2023_db.Brca.Attachments&#xD;&#xA;WHERE finacialyear = '2025' and EntityName = 'GLJRNLH' AND EntityKey =CONCAT(dbo.GLJRNLH.JRN_CD,'|',dbo.GLJRNLH.TR_NO))&#xD;&#xA;and 1=1&#xD;&#xA;order by jrn_cd,tr_dt" Name="sqlDataSource1" />
  </DataSources>
