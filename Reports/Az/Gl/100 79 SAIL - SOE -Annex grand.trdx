<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource1" Width="277mm" Name="Report" xmlns="http://schemas.telerik.com/reporting/2023/1.0">
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="GLX" SelectCommand="SELECT &#xD;&#xA;    DENSE_RANK() OVER (ORDER BY tr_no) AS item_no,&#xD;&#xA;&#x9;(SELECT HDSCR_EN FROM glJRNLH &#xD;&#xA;        WHERE TR_NO = gljrnld.TR_NO &#xD;&#xA;        AND JRN_CD = gljrnld.JRN_CD &#xD;&#xA;        AND TR_DT = gljrnld.TR_DT) AS DSC, &#xD;&#xA;    db_vl - cr_vl AS net,&#xD;&#xA;&#x9;rate,&#xD;&#xA;&#x9;TR_NO,&#xD;&#xA;&#x9;tr_dt as dat,&#xD;&#xA;    (SELECT cst_nm_ar FROM glcst WHERE cst_cd = gljrnld.cst_cd) AS cstnm,  &#xD;&#xA;&#x9;   (SELECT btch_id FROM glcst WHERE cst_cd = gljrnld.cst_cd) AS btich, &#xD;&#xA;    (cur_vl * ln_ty) AS cur,&#xD;&#xA;    (SELECT acc_nm_ar FROM glmf WHERE acc_no = LEFT(gljrnld.acc_no, 4)) AS acctnm,&#xD;&#xA;    ((db_vl - cr_vl) * LN_TY) / NULLIF(RATE, 0) AS EGP, &#xD;&#xA;    (SELECT fmly FROM glmf WHERE acc_no = gljrnld.acc_no) AS fmly,&#xD;&#xA; &#xD;&#xA;    (SELECT LC_NO FROM glLCMF WHERE SUM_cd = gljrnld.SUM_cd AND lc_no &lt;&gt; '47') AS LCNO,&#xD;&#xA;     &#xD;&#xA;    (SELECT LC_AMOUNT FROM glLCMF WHERE SUM_cd = gljrnld.SUM_cd AND lc_no &lt;&gt; '47') AS LCAMOUNT,&#xD;&#xA;    (SELECT LC_DSCR_AR FROM glLCMF WHERE SUM_cd = gljrnld.SUM_cd AND lc_no &lt;&gt; '47') AS DSCR&#xD;&#xA;     &#xD;&#xA;FROM gljrnld&#xD;&#xA;WHERE jrn_cd = '2' and acc_no like '1003%' and (1=1)  &#xD;&#xA;ORDER BY TR_NO; &#xD;&#xA;" Name="sqlDataSource1" />
  </DataSources>
