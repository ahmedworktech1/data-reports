<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource2" Width="11.69in" UnitOfMeasure="Mm" Name="ReportGlunbaljrn" xmlns="http://schemas.telerik.com/reporting/2021/1.0">
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="glx2023" SelectCommand="select  'تيار' as s,&#xD;&#xA;sum( case when (acc_no like '4[7]112%' or acc_no like '4[7]113%' or acc_no like '4[7]115%' or acc_no like '4[7]116%') and  substring(cst_cd,6,7) = ('71') then db_vl-cr_vl else 0 end ) as tot,&#xD;&#xA;sum( case when acc_no like '4[7]112%' and  substring(cst_cd,6,7) = ('71')   then db_vl-cr_vl else 0 end) as s1,&#xD;&#xA;sum( case when  acc_no like '4[7]113%' and  substring(cst_cd,6,7) = ('71')  then db_vl-cr_vl else 0 end) as s2,&#xD;&#xA;sum( case when acc_no like '4[7]115%' and  substring(cst_cd,6,7) = ('71')  then db_vl-cr_vl else 0 end) as s3,&#xD;&#xA;sum( case when  acc_no like '4[7]116%' and  substring(cst_cd,6,7) = ('71')  then db_vl-cr_vl else 0 end) as s4&#xD;&#xA;&#xD;&#xA;from gljrnld  WHERE  (acc_no like '4[7]112%' or acc_no like '4[7]113%' or acc_no like '4[7]115%' or acc_no like '4[7]116%') and  substring(cst_cd,6,7) = ('71') &#xD;&#xA;and (1=1)&#xD;&#xA;union all&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;select  'مقايسات' as s,&#xD;&#xA;sum( case when (acc_no like '4[7]112%' or acc_no like '4[7]113%' or acc_no like '4[7]115%' or acc_no like '4[7]116%') and  substring(cst_cd,6,7) = ('72') then db_vl-cr_vl else 0 end ) as tot,&#xD;&#xA;sum( case when acc_no like '4[7]112%' and  substring(cst_cd,6,7) = ('72')   then db_vl-cr_vl else 0 end) as s1,&#xD;&#xA;sum( case when  acc_no like '4[7]113%' and  substring(cst_cd,6,7) = ('72')  then db_vl-cr_vl else 0 end) as s2,&#xD;&#xA;sum( case when acc_no like '4[7]115%' and  substring(cst_cd,6,7) = ('72')  then db_vl-cr_vl else 0 end) as s3,&#xD;&#xA;sum( case when  acc_no like '4[7]116%' and  substring(cst_cd,6,7) = ('72')  then db_vl-cr_vl else 0 end) as s4&#xD;&#xA;&#xD;&#xA;from gljrnld  WHERE  (acc_no like '4[7]112%' or acc_no like '4[7]113%' or acc_no like '4[7]115%' or acc_no like '4[7]116%') and  substring(cst_cd,6,7) = ('72') &#xD;&#xA;and (1=1)&#xD;&#xA;&#xD;&#xA;union all&#xD;&#xA; &#xD;&#xA;select  'محطات التوليد' as s,&#xD;&#xA;sum( case when (acc_no like '4[7]112%' or acc_no like '4[7]113%' or acc_no like '4[7]115%' or acc_no like '4[7]116%') and  CST_CD like '11%'  then db_vl-cr_vl else 0 end ) as tot,&#xD;&#xA;sum( case when acc_no like '4[7]112%'  and  CST_CD like '11%'   then db_vl-cr_vl else 0 end) as s1,&#xD;&#xA;sum( case when  acc_no like '4[7]113%'  and  CST_CD like '11%'  then db_vl-cr_vl else 0 end) as s2,&#xD;&#xA;sum( case when acc_no like '4[7]115%'  and  CST_CD like '11%'  then db_vl-cr_vl else 0 end) as s3,&#xD;&#xA;sum( case when  acc_no like '4[7]116%'  and  CST_CD like '11%'  then db_vl-cr_vl else 0 end) as s4&#xD;&#xA;&#xD;&#xA;from gljrnld  WHERE  (acc_no like '4[7]112%' or acc_no like '4[7]113%' or acc_no like '4[7]115%' or acc_no like '4[7]116%')  and  CST_CD like '11%' &#xD;&#xA;  &#xD;&#xA;and (1=1)&#xD;&#xA;&#xD;&#xA;" Name="sqlDataSource2" />
  </DataSources>
