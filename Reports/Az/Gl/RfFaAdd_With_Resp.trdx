  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="glx2023tarheel" SelectCommand="SELECT FAMF.FA_CD as FaCd,FAMF.FA_NM_Ar AS FaNm ,FAMF.STRT_DT as StrtDt ,&#xD;&#xA;FAMF.MFA_CD4 as MfaCd4,&#xD;&#xA;FADPRC_Q.TOTADDQTY,&#xD;&#xA;famf.cst_cd as cst_cd,(select CST_NM_Ar from GLCST where CST_CD=FAMF.CST_CD) as cst_nm ,&#xD;&#xA;substring(famf.cst_cd,1,2) as mcst_cd,(select CST_NM_Ar from GLCST where CST_CD=substring(famf.cst_cd,1,2)) as mcst_nm,&#xD;&#xA;FAMF.fa_kind,(select DSCR_AR from AppCodes where id='84' and SEQ=FAMF.fa_kind) as momyz,&#xD;&#xA;Cast(ISNULL(FAMF.DPRC_VL,0) as decimal(18,4)) as DPrcVl , &#xD;&#xA;&#xD;&#xA;ISNULL(FADPRC_Q.FA_VL,0) as CFaVl ,&#xD;&#xA;&#xD;&#xA;Cast( ISNULL(FADPRC_Q.TOTADD,0)as decimal(18,4)) as Cadd  ,&#xD;&#xA;&#xD;&#xA;Cast(ISNULL(FADPRC_Q.TOTDSP,0)as decimal(18,4)) as Cdsp  ,&#xD;&#xA;&#xD;&#xA;(ISNULL(FADPRC_Q.FA_VL,0) + Round(Cast(( + ISNULL(FADPRC_Q.TOTADD,0) - &#xD;&#xA;ISNULL(FADPRC_Q.TOTDSP,0))as decimal(18,4)),2)) AS AFaVl  ,&#xD;&#xA;&#xD;&#xA;Cast(ISNULL(FAMF.DPRC,0)as decimal(18,4)) AS BgDPrc  ,&#xD;&#xA;&#xD;&#xA;Cast(ISNULL((select sum(FADPRC_Q.TOTADDACC)from FADPRC_Q  &#xD;&#xA;where FAMF.FA_CD= FADPRC_Q.FA_CD and FADPRC_Q.PRD='-99991') ,0)as decimal(18,4)) as CaddAcc ,&#xD;&#xA;Round(Cast(ISNULL((select sum(FADPRC_Q.TOTDSPACC)from FADPRC_Q  &#xD;&#xA;where FAMF.FA_CD= FADPRC_Q.FA_CD and FADPRC_Q.PRD='-99991') ,0)as decimal(18,4)),2) as CdspAcc , &#xD;&#xA;Round(Cast((ISNULL((select sum(FADPRC_Q.DPREXP)from FADPRC_Q  &#xD;&#xA;where FAMF.FA_CD= FADPRC_Q.FA_CD and FADPRC_Q.PRD &lt;='-99991') ,0) )as decimal(18,4)),2) AS Dprexp1 ,&#xD;&#xA;&#xD;&#xA;Round(Cast((ISNULL((select sum(FADPRC_Q.DSP_DPREXP)from FADPRC_Q  &#xD;&#xA;where FAMF.FA_CD= FADPRC_Q.FA_CD and FADPRC_Q.PRD &lt;='-99991') ,0) )as decimal(18,4)),2) AS DSP_DPREXP,&#xD;&#xA;&#xD;&#xA;Cast(ISNULL(FAMF.PYRDPRC,0)as decimal(18,4)) as QPYrdPrc &#xD;&#xA;,FADPRC_Q.prd&#xD;&#xA;,FAMF.STAT,(select DSCR_AR from AppCodes where id='13' and SEQ=FAMF.STAT) as STAT_NM&#xD;&#xA;,VRTX as place&#xD;&#xA;,FAMF.DOC_NO,FAMF.DOC_DT,FAMF.QTY,FAMF.fa_dcsion as heyaza,FAMF.area &#xD;&#xA;,FAMF.NOTES as wsf_fa_cd,FAMF.NET_TY,(select DSCR_AR from AppCodes where id='99' &#xD;&#xA;and SEQ=FAMF.NET_TY) as no3_alard&#xD;&#xA;,FAMF.MDL_NO,FAMF.CHS_NO,FAMF.PLT_NO,FAMF.MOT_NO,FAMF.PLT_NO_N,FAMF.Mot_No_N,&#xD;&#xA;FAMF.LIC_STRT_DT,FAMF.RESP,(select Dscr_Ar from GLLISTS where Rec_Type='5' and Code=FAMF.RESP) as resp_nm&#xD;&#xA;FROM (FAMF  LEFT JOIN FADPRC_Q ON FADPRC_Q.FA_CD=FAMF.FA_CD) LEFT JOIN  GLCST &#xD;&#xA;ON FAMF.CST_CD=GLCST.CST_CD &#xD;&#xA;WHERE (FAMF.FA_TY&lt;&gt;1) and  (FAMF.FA_TY&lt;&gt;5)   and  (FADPRC_Q.TOTADD&lt;&gt;0)&#xD;&#xA;and FADPRC_Q.PRD='-99991'&#xD;&#xA;and 1&lt;&gt;1&#xD;&#xA;order by FAMF.FA_CD, FAMF.CST_CD&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;" Name="sqlDataSource1" />
  </DataSources>
