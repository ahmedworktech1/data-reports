  <StyleSheet>
    <StyleRule>
      <Style>
        <Padding Left="2pt" Right="2pt" />
      </Style>
      <Selectors>
        <TypeSelector Type="TextItemBase" />
        <TypeSelector Type="HtmlTextBox" />
      </Selectors>
    </StyleRule>
  </StyleSheet>
  <Groups>
    <Group GroupKeepTogether="All" Name="group">
      <GroupHeader>
        <GroupHeaderSection Height="0.9cm" Name="groupHeaderSection">
          <Style Visible="True" BackgroundColor="White">
            <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
          <Items>
            <TextBox Width="3.592cm" Height="0.554cm" Left="16.7cm" Top="0.346cm" Value="= Fields.AccNo" CanGrow="False" CanShrink="True" TextWrap="False" Name="textBox24">
              <Style BackgroundColor="White" Color="Red" TextAlign="Right" VerticalAlign="Middle">
                <Font Size="12pt" Bold="True" />
                <BorderStyle Top="None" Bottom="None" Left="None" Right="None" />
                <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
                <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
              </Style>
            </TextBox>
            <TextBox Width="3.592cm" Height="0.475cm" Left="3.592cm" Top="0.346cm" Value="= Fields.Sum_CD" CanGrow="False" CanShrink="True" TextWrap="False" Name="textBox16">
              <Style BackgroundColor="White" Color="Red" TextAlign="Right" VerticalAlign="Middle">
                <Font Size="12pt" Bold="True" />
                <BorderStyle Top="None" Bottom="None" Left="None" Right="None" />
                <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
                <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
              </Style>
