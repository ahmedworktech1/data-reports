                <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
              </Style>
            </TextBox>
            <TextBox Width="1.706cm" Height="0.554cm" Left="7.184cm" Top="0.346cm" Value="بند إحصائي" Name="textBox22">
              <Style BackgroundColor="White" Color="Red" TextAlign="Center" VerticalAlign="Middle">
                <Font Size="11pt" Bold="True" />
              </Style>
              <Bindings>
                <Binding Path="Style.Visible" Expression="=IIf(Parameters.FromSumCd.Value Is Nothing, False, True)" />
              </Bindings>
            </TextBox>
          </Items>
        </GroupHeaderSection>
      </GroupHeader>
      <GroupFooter>
        <GroupFooterSection PageBreak="After" Height="3.349cm" Name="groupFooterSection">
          <Style BackgroundColor="White">
            <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
          <Items>
            <TextBox Width="1in" Height="0.284in" Left="6.3in" Top="0in" Value="= IIf((Sum(Fields.DbVl) - Sum(Fields.CrVl)) &gt;= 0,Sum(Fields.DbVl) - Sum(Fields.CrVl), 0)" Format="{0:N3}" Multiline="False" Culture="en" Name="textBox35">
              <Style Color="Blue" TextAlign="Center" VerticalAlign="Middle">
                <Font Bold="True" />
                <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
                <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
                <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
              </Style>
            </TextBox>
            <TextBox Width="2.286cm" Height="0.721cm" Left="9.398cm" Top="0cm" Value="=Sum (Fields.TCR_VL)" Format="{0:N3}" Multiline="False" Culture="en" Name="textBox19">
              <Style Color="192, 0, 0" TextAlign="Justify" VerticalAlign="Middle">
                <Font Bold="True" />
                <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
                <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
                <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
              </Style>
            </TextBox>
            <TextBox Width="0.821in" Height="0.284in" Left="5.479in" Top="0in" Value="= IIf((Sum(Fields.DbVl) - Sum(Fields.CrVl)) &lt; 0,Abs(Sum(Fields.DbVl) - Sum(Fields.CrVl)), 0)" Format="{0:N3}" Multiline="False" Culture="en" Name="textBox34">
              <Style Color="192, 0, 0" TextAlign="Center" VerticalAlign="Middle">
                <Font Bold="True" />
                <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
                <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
                <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
              </Style>
            </TextBox>
            <TextBox Width="1.2in" Height="0.276in" Left="5.479in" Top="0.333in" Value="= Abs(Sum(Fields.DbVl) - Sum(Fields.CrVl))" Format="{0:N3}" Multiline="False" Culture="en" Name="textBox38">
              <Style Color="Blue" TextAlign="Center" VerticalAlign="Middle">
                <Font Size="12pt" Bold="True" />
                <BorderStyle Top="None" Bottom="None" Left="None" Right="None" />
                <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
                <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
              </Style>
            </TextBox>
            <TextBox Width="2.032cm" Height="0.721cm" Left="18.542cm" Top="0cm" Value="الإجمالي" Name="textBox17">
              <Style TextAlign="Center" VerticalAlign="Middle">
                <Font Size="16pt" Bold="True" />
                <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
                <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
                <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
              </Style>
            </TextBox>
            <TextBox Width="2.48cm" Height="0.7cm" Left="17.272cm" Top="0.821cm" Value="= IIf((Sum(Fields.DbVl) - Sum(Fields.CrVl)) &lt; 0,'رصيد دائن','رصيد مدين')" Culture="en" Name="textBox31">
              <Style TextAlign="Center" VerticalAlign="Middle">
                <Font Size="14pt" Bold="True" />
                <BorderStyle Top="None" Bottom="None" Left="None" Right="None" />
                <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
                <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
              </Style>
            </TextBox>
            <TextBox Width="2.216cm" Height="0.721cm" Left="11.684cm" Top="0cm" Value="= Sum(Fields.DBBAL)" Format="{0:N3}" Multiline="False" Culture="en" Name="textBox18">
              <Style Color="Blue" TextAlign="Justify" VerticalAlign="Middle">
                <Font Bold="True" />
                <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
                <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
                <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
              </Style>
            </TextBox>
            <TextBox Width="3.048cm" Height="0.276in" Left="7.312cm" Top="0.845cm" Value="=Sum (Fields.TCR_VL)" Format="{0:N3}" Multiline="False" Culture="en" Name="textBox39">
              <Style Color="192, 0, 0" TextAlign="Justify" VerticalAlign="Middle">
                <Font Size="12pt" Bold="True" />
                <BorderStyle Top="None" Bottom="None" Left="None" Right="None" />
                <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
                <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
              </Style>
            </TextBox>
            <TextBox Width="9.398cm" Height="0.721cm" Left="0cm" Top="0cm" Value="= 0.00" Format="{0:N2}" Culture="en" Name="textBox40">
              <Style Color="Red" TextAlign="Center" VerticalAlign="Middle">
                <Font Size="14pt" Bold="True" />
                <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
                <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
                <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
              </Style>
            </TextBox>
            <TextBox Width="1.181in" Height="0.276in" Left="4.179in" Top="0.333in" Value="=Sum (Fields.DbVl)" Format="{0:N3}" Multiline="False" Culture="en" Name="textBox41">
              <Style Color="Blue" TextAlign="Center" VerticalAlign="Middle">
                <Font Size="12pt" Bold="True" />
                <BorderStyle Top="None" Bottom="None" Left="None" Right="None" />
                <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
                <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
              </Style>
            </TextBox>
            <TextBox Width="1.653in" Height="0.275in" Left="0.118in" Top="0.599in" Value="= (Sum(Fields.DbVl - Fields.CrVl) -Sum(Fields.DBBAL) + Sum (Fields.CrVl))" Format="{0:N3}" Culture="en" Name="textBox42">
              <Style Color="Black" TextAlign="Center" VerticalAlign="Middle">
                <Font Size="14pt" Bold="True" />
                <BorderStyle Top="None" Bottom="None" Left="None" Right="None" />
                <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
                <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
              </Style>
            </TextBox>
            <TextBox Width="2.2cm" Height="0.7cm" Left="4.5cm" Top="1.521cm" Value="أول المدة" Name="textBox43">
              <Style TextAlign="Center" VerticalAlign="Middle">
                <Font Size="14pt" Bold="True" />
                <BorderStyle Top="None" Bottom="None" Left="None" Right="None" />
                <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
                <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
              </Style>
            </TextBox>
            <TextBox Width="2.2cm" Height="0.7cm" Left="4.5cm" Top="0.821cm" Value="فرق الحركة" Name="textBox44">
              <Style TextAlign="Center" VerticalAlign="Middle">
                <Font Size="14pt" Bold="True" />
                <BorderStyle Top="None" Bottom="None" Left="None" Right="None" />
                <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
                <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
              </Style>
            </TextBox>
            <TextBox Width="1.653in" Height="0.276in" Left="0.118in" Top="0.323in" Value="= &#xD;&#xA;(Sum(Fields.DbVl) - Sum(Fields.CrVl)) - (Sum(Fields.DbVl - Fields.CrVl) -Sum(Fields.DBBAL) + Sum (Fields.CrVl))" Format="{0:#,##0;(#,##0)}" Culture="en" Name="textBox45">
              <Style Color="Black" TextAlign="Center" VerticalAlign="Middle">
                <Font Size="14pt" Bold="True" />
                <BorderStyle Top="None" Bottom="None" Left="None" Right="None" />
                <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
                <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
              </Style>
            </TextBox>
            <TextBox Width="18.2cm" Height="0.8cm" Left="1.358cm" Top="2.549cm" Value="= brca.Core.Services.ReportStaticService.Tafqeet(Abs(Sum(Fields.DbVl) - Sum(Fields.CrVl)))" Format="{0:N3}" Name="textBox28">
              <Style TextAlign="Center" VerticalAlign="Middle">
                <Font Size="12pt" Bold="True" />
              </Style>
            </TextBox>
          </Items>
        </GroupFooterSection>
      </GroupFooter>
      <Groupings>
        <Grouping Expression="= Fields.AccNo" />
      </Groupings>
    </Group>
