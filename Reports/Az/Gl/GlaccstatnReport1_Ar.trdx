            <TextBox Width="3.084cm" Height="0.492cm" Left="0.508cm" Top="0.346cm" Value="= Fields.SUM_NM" CanGrow="False" CanShrink="True" TextWrap="False" Name="textBox15">
              <Style BackgroundColor="White" Color="Red" TextAlign="Right" VerticalAlign="Middle">
                <Font Size="12pt" Bold="True" />
                <BorderStyle Top="None" Bottom="None" Left="None" Right="None" />
                <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
                <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
              </Style>
              <Bindings>
                <Binding Path="Visible" Expression="=IIf(Parameters.FromSumCd.Value Is Nothing, False, True)" />
              </Bindings>
            </TextBox>
            <TextBox Width="7.702cm" Height="0.475cm" Left="8.997cm" Top="0.346cm" Value="= Fields.AccNmAr" CanGrow="False" CanShrink="True" Multiline="False" TextWrap="False" Name="textBox25">
              <Style BackgroundColor="White" TextAlign="Left" VerticalAlign="Middle">
                <Font Name="Microsoft Sans Serif" Size="12pt" Bold="True" />
                <BorderStyle Top="None" Bottom="None" Left="None" Right="None" />
