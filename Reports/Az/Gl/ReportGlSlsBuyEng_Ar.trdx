<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource1" Width="9in" Name="ReportGlSlsBuyEng_Ar" xmlns="http://schemas.telerik.com/reporting/2021/1.0">
  <Style>
    <BorderStyle Top="None" Bottom="None" Left="None" Right="None" />
    <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
    <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
  </Style>
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="glx2023" SelectCommand="select * ,dbo.GetCst_NM(mcst_cd)mcst_nm,dbo.GetCst_NM(cst_cd)cst_nm,&#xD;&#xA;BUYENG-SLSENG QTYLESS,&#xD;&#xA;(case when BUYENG=0 then 0 else (isnull(BUYENG,0)-isnull(SLSENG,0))/BUYENG end)  *100 PRCLRSS&#xD;&#xA;from(&#xD;&#xA;select   gljrnld.cst_cd , glcst.MCST_CD, left(gljrnld.cst_cd,1) as mcst_1,&#xD;&#xA;SUM(case when (gljrnld.acc_no like '4[6-8]311%' or gljrnld.acc_no like '4[6-8]312%') then isnull(DB_VL,0)-isnull(cr_VL,0) else 0 end  ) AS valBUYENG,&#xD;&#xA;SUM(case when (gljrnld.acc_no like '5[6-8]1111101%' or gljrnld.acc_no like '5[6-8]1111102%')  then cr_VL - DB_VL else 0 end ) AS valsENG,&#xD;&#xA;SUM(case when (gljrnld.acc_no like '4[6-8]311%' or gljrnld.acc_no like '4[6-8]312%') then val1 else 0 end ) AS BUYENG ,&#xD;&#xA;SUM(case when (gljrnld.acc_no like '5[6-8]1111101%' or gljrnld.acc_no like '5[6-8]1111102%') then val1 else 0 end) AS SLSENG,&#xD;&#xA;&#xD;&#xA;(SUM(case when (gljrnld.acc_no like '5[6-8]1111101%' or gljrnld.acc_no like '5[6-8]1111102%') then ((db_vl-CR_VL)*-1) else 0 end )&#xD;&#xA;/&#xD;&#xA;SUM(case when (gljrnld.acc_no like '5[6-8]1111101%' or gljrnld.acc_no like '5[6-8]1111102%') then val1 else null end )*100) as AVGPRC &#xD;&#xA;&#xD;&#xA; from GLJRNLD inner join glcst on gljrnld.CST_CD=GLCST.cst_cd &#xD;&#xA; where 1=1 and glcst.mcst_cd &gt; 0 &#xD;&#xA; group by glcst.mcst_cd,gljrnld.cst_cd) t&#xD;&#xA;where t.valBUYENG + t.valsENG + t.BUYENG + t.SLSENG &gt;0" Name="sqlDataSource1" />
  </DataSources>
