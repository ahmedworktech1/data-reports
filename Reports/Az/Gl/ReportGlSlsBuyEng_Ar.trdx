                <Font Name="Microsoft Sans Serif" Size="8pt" Bold="False" />
                <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
                <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
                <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
              </Style>
            </TextBox>
            <TextBox Width="2.286cm" Height="0.6cm" Left="2.334cm" Top="0cm" Value="= Sum(QTYLESS)" Format="{0:#.}" Name="textBox44">
              <Style BackgroundColor="106, 221, 94" TextAlign="Center" VerticalAlign="Middle">
                <Font Name="Microsoft Sans Serif" Size="8pt" Bold="False" />
                <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
                <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
                <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
              </Style>
            </TextBox>
            <TextBox Width="2.042cm" Height="0.6cm" Left="4.621cm" Top="0cm" Value="= Sum(valsENG) /Sum(SLSENG) * 100" Format="{0:#.000}" Name="textBox43">
              <Style BackgroundColor="106, 221, 94" TextAlign="Center" VerticalAlign="Middle">
                <Font Name="Microsoft Sans Serif" Size="8pt" Bold="False" />
                <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
                <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
                <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
              </Style>
            </TextBox>
            <TextBox Width="1.558cm" Height="0.6cm" Left="21.301cm" Top="0cm" Value="إجمالي" Format="{0:N2}" Name="textBox42">
              <Style BackgroundColor="106, 221, 94" TextAlign="Center" VerticalAlign="Middle">
                <Font Name="Microsoft Sans Serif" Size="9pt" />
                <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
                <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
                <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
              </Style>
            </TextBox>
            <TextBox Width="2.4cm" Height="0.6cm" Left="18.9cm" Top="0cm" Value="= Fields.MCST_NM" Multiline="False" Name="textBox50">
              <Style Visible="True" BackgroundColor="106, 221, 94" TextAlign="Center" VerticalAlign="Middle">
                <Font Name="Microsoft Sans Serif" Size="11pt" Bold="True" />
                <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
                <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
                <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
              </Style>
            </TextBox>
          </Items>
        </GroupFooterSection>
      </GroupFooter>
      <Groupings>
        <Grouping Expression="=MCST_CD" />
      </Groupings>
      <Sortings>
        <Sorting Expression="= Fields.mcst_cd" Direction="Asc" />
      </Sortings>
    </Group>
  </Groups>
  <ReportParameters>
    <ReportParameter Name="ShowTotal" Type="Boolean" AllowNull="True" />
