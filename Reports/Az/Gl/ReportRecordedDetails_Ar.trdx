<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="webServiceDataSource1" Width="17cm" Name="ReportRecordedDetails" xmlns="http://schemas.telerik.com/reporting/2019/2.0">
  <DataSources>
    <WebServiceDataSource ServiceUrl="@Url" Name="webServiceDataSource1" ParameterValues="{&quot;CountryId&quot;:&quot;\&quot;1\&quot;&quot;,&quot;FromDate&quot;:&quot;\&quot;1\&quot;&quot;,&quot;GranteeId&quot;:&quot;\&quot;1\&quot;&quot;,&quot;MainParty&quot;:&quot;\&quot;1\&quot;&quot;,&quot;GranteeTypeId&quot;:&quot;\&quot;1\&quot;&quot;,&quot;ToDate&quot;:&quot;\&quot;1\&quot;&quot;,&quot;.AspNetCore.Identity.Application&quot;:,&quot;@Url&quot;:&quot;http://localhost:56226/eg/ReportRecordedDetails/GetDataRecordedDetails&quot;}">
      <Parameters>
        <WebServiceParameter WebServiceParameterType="Query" Name="CountryId">
          <Value>
            <String>= Parameters.CountryId.Value</String>
          </Value>
        </WebServiceParameter>
        <WebServiceParameter WebServiceParameterType="Query" Name="FromDate">
          <Value>
            <String>= Parameters.FromDate.Value</String>
          </Value>
        </WebServiceParameter>
        <WebServiceParameter WebServiceParameterType="Query" Name="GranteeId">
          <Value>
            <String>= Parameters.GranteeId.Value</String>
          </Value>
        </WebServiceParameter>
        <WebServiceParameter WebServiceParameterType="Query" Name="MainParty">
          <Value>
            <String>= Parameters.MainParty.Value</String>
          </Value>
        </WebServiceParameter>
        <WebServiceParameter WebServiceParameterType="Query" Name="GranteeTypeId">
          <Value>
            <String>= Parameters.GranteeTypeId.Value</String>
          </Value>
        </WebServiceParameter>
        <WebServiceParameter WebServiceParameterType="Query" Name="ToDate">
          <Value>
            <String>= Parameters.ToDate.Value</String>
          </Value>
        </WebServiceParameter>
        <WebServiceParameter WebServiceParameterType="Cookie" Name=".AspNetCore.Identity.Application">
          <Value>
            <String>= Parameters.login.Value</String>
          </Value>
        </WebServiceParameter>
        <WebServiceParameter WebServiceParameterType="Inline" Name="@Url">
          <Value>
            <String>= Parameters.Url.Value + "eg/ReportRecordedDetails/GetDataRecordedDetails"</String>
          </Value>
        </WebServiceParameter>
      </Parameters>
    </WebServiceDataSource>
  </DataSources>
  <Items>
    <PageHeaderSection Height="3.667cm" Name="pageHeaderSection1">
      <Style>
        <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
        <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
        <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
