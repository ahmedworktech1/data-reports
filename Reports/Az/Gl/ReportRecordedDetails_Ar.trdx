        <TypeSelector Type="HtmlTextBox" />
      </Selectors>
    </StyleRule>
  </StyleSheet>
  <ReportParameters>
    <ReportParameter Name="Url" AllowNull="True" />
    <ReportParameter Name="login" AllowNull="True" />
    <ReportParameter Name="FromDate" AllowNull="True" />
    <ReportParameter Name="ToDate" AllowNull="True" />
    <ReportParameter Name="GranteeId" AllowNull="True" />
    <ReportParameter Name="MainParty" AllowNull="True" />
    <ReportParameter Name="CountryId" AllowNull="True" />
    <ReportParameter Name="GranteeTypeId" AllowNull="True" />
