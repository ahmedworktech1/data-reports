  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="glx2023tarheel" SelectCommand="SELECT FAMF.FA_CD as FaCd,FAMF.FA_NM_Ar AS FaNm ,FAMF.STRT_DT as StrtDt ,&#xD;&#xA;FAMF.MFA_CD1 as MfaCd1,&#xD;&#xA;famf.cst_cd as cst_cd,(select CST_NM_Ar from GLCST where CST_CD=FAMF.CST_CD) as cst_nm ,&#xD;&#xA;substring(famf.cst_cd,1,2) as mcst_cd,(select CST_NM_Ar from GLCST where CST_CD=substring(famf.cst_cd,1,2)) as mcst_nm,&#xD;&#xA;FAMF.fa_kind,(select DSCR_AR from AppCodes where id='84' and SEQ=FAMF.fa_kind) as momyz,&#xD;&#xA;Cast(ISNULL(FAMF.DPRC_VL,0) as decimal(18,4)) as DPrcVl , &#xD;&#xA;&#xD;&#xA;ISNULL(FADPRC.FA_VL,0) as CFaVl ,&#xD;&#xA;&#xD;&#xA;Cast( ISNULL(FADPRC.TOTADD,0)as decimal(18,4)) as Cadd  ,&#xD;&#xA;&#xD;&#xA;Cast(ISNULL(FADPRC.TOTDSP,0)as decimal(18,4)) as Cdsp  ,&#xD;&#xA;&#xD;&#xA;(ISNULL(FADPRC.FA_VL,0) + Round(Cast(( + ISNULL(FADPRC.TOTADD,0) - &#xD;&#xA;ISNULL(FADPRC.TOTDSP,0))as decimal(18,4)),2)) AS AFaVl  ,&#xD;&#xA;&#xD;&#xA;Cast(ISNULL(FAMF.DPRC,0)as decimal(18,4)) AS BgDPrc  ,&#xD;&#xA;&#xD;&#xA;Cast(ISNULL((select sum(FADPRC.TOTADDACC)from FADPRC  &#xD;&#xA;where FAMF.FA_CD= FADPRC.FA_CD and FADPRC.PRD='-99991') ,0)as decimal(18,4)) as CaddAcc ,&#xD;&#xA;Round(Cast(ISNULL((select sum(FADPRC.TOTDSPACC)from FADPRC  &#xD;&#xA;where FAMF.FA_CD= FADPRC.FA_CD and FADPRC.PRD='-99991') ,0)as decimal(18,4)),2) as CdspAcc , &#xD;&#xA;Round(Cast((ISNULL((select sum(FADPRC.DPREXP)from FADPRC  &#xD;&#xA;where FAMF.FA_CD= FADPRC.FA_CD and FADPRC.PRD &lt;='-99991') ,0) )as decimal(18,4)),2) AS Dprexp1 ,&#xD;&#xA;&#xD;&#xA;Round(Cast((ISNULL((select sum(FADPRC.DSP_DPREXP)from FADPRC  &#xD;&#xA;where FAMF.FA_CD= FADPRC.FA_CD and FADPRC.PRD &lt;='-99991') ,0) )as decimal(18,4)),2) AS DSP_DPREXP,&#xD;&#xA;&#xD;&#xA;Cast(ISNULL(FAMF.PYRDPRC,0)as decimal(18,4)) as QPYrdPrc &#xD;&#xA;,FADPRC.prd&#xD;&#xA;,FAMF.STAT,(select DSCR_AR from AppCodes where id='13' and SEQ=FAMF.STAT) as STAT_NM&#xD;&#xA;,VRTX as place&#xD;&#xA;,FAMF.DOC_NO,FAMF.DOC_DT,FAMF.QTY,FAMF.fa_dcsion as heyaza,FAMF.area &#xD;&#xA;,FAMF.NOTES as wsf_fa_cd,FAMF.NET_TY,(select DSCR_AR from AppCodes where id='99' &#xD;&#xA;and SEQ=FAMF.NET_TY) as no3_alard&#xD;&#xA;FROM (FAMF  LEFT JOIN FADPRC ON FADPRC.FA_CD=FAMF.FA_CD) LEFT JOIN  GLCST &#xD;&#xA;ON FAMF.CST_CD=GLCST.CST_CD &#xD;&#xA;WHERE (FAMF.FA_TY&lt;&gt;1) and  (FAMF.FA_TY&lt;&gt;5) &#xD;&#xA;and FAMF.FA_CD like '111%'&#xD;&#xA;and FADPRC.PRD='-99991'&#xD;&#xA;order by FAMF.CST_CD, FAMF.FA_CD" Name="sqlDataSource1" />
  </DataSources>
