<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource1" Width="298mm" UnitOfMeasure="Mm" Name="TOT_FA" ShowDimensions="False" xmlns="http://schemas.telerik.com/reporting/2021/1.0">
  <Style Visible="True">
    <BorderStyle Top="Groove" Bottom="Groove" Left="Groove" Right="Groove" />
    <BorderColor Top="37, 64, 97" Bottom="37, 64, 97" Left="37, 64, 97" Right="37, 64, 97" />
    <BorderWidth Top="1.5pt" Bottom="1.5pt" Left="1.5pt" Right="1.5pt" />
  </Style>
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="glx2023tarheel" SelectCommand="select &#xD;&#xA;CST_CD,(select cst_nm_ar from GLCST where CST_CD=FA_PROJECTS_DETAILS.CST_CD) as cst_nm&#xD;&#xA;,ProjNo,(select PROJ_NM_AR from FA_PROJECTSCoding where PROJ_NO=FA_PROJECTS_DETAILS.ProjNo) as proNM&#xD;&#xA;,CONST_SCHDL,&#xD;&#xA;(select DSCR_AR from AppCodes where ID='1005' and seq=&#xD;&#xA;(select PROJ_CTGRY from FA_PROJECTSCoding where PROJ_NO=FA_PROJECTS_DETAILS.ProjNo)) as Category &#xD;&#xA;,sum(case when TR_TY='200' then QTY*PRICE else 0 end ) as TotAprov&#xD;&#xA;,sum(case when TR_TY='1' then QTY*PRICE else 0 end ) as Totout&#xD;&#xA;,(&#xD;&#xA;sum(case when TR_TY='2' then QTY*PRICE else 0 end )&#xD;&#xA;- sum(case when TR_TY='102' then QTY*PRICE else 0 end )) as mokawl&#xD;&#xA;,sum(case when TR_TY='101' then QTY*PRICE else 0 end ) as returnn&#xD;&#xA;,(sum(case when TR_TY='4' then QTY*PRICE else 0 end ) &#xD;&#xA;- sum(case when TR_TY='103' then QTY*PRICE else 0 end )) as salary&#xD;&#xA;,(sum(case when TR_TY in ('3','5') then QTY*PRICE else 0 end )&#xD;&#xA;- sum(case when TR_TY in ('104','105') then QTY*PRICE else 0 end )) as other&#xD;&#xA;,(&#xD;&#xA;sum(case when TR_TY='1' then QTY*PRICE else 0 end ) +&#xD;&#xA;(&#xD;&#xA;sum(case when TR_TY='2' then QTY*PRICE else 0 end )&#xD;&#xA;- sum(case when TR_TY='102' then QTY*PRICE else 0 end )) +&#xD;&#xA;(sum(case when TR_TY='4' then QTY*PRICE else 0 end ) &#xD;&#xA;- sum(case when TR_TY='103' then QTY*PRICE else 0 end )) +&#xD;&#xA;(sum(case when TR_TY in ('3','5') then QTY*PRICE else 0 end )&#xD;&#xA;- sum(case when TR_TY in ('104','105') then QTY*PRICE else 0 end )) -&#xD;&#xA;sum(case when TR_TY='101' then QTY*PRICE else 0 end )&#xD;&#xA;) as Tot&#xD;&#xA;,&#xD;&#xA;(&#xD;&#xA;sum(case when (TR_TY='1' and dist_Stat is not null) then QTY*PRICE else 0 end ) +&#xD;&#xA;(&#xD;&#xA;sum(case when (TR_TY='2' and dist_Stat is not null) then QTY*PRICE else 0 end )&#xD;&#xA;- sum(case when (TR_TY='102' and dist_Stat is not null) then QTY*PRICE else 0 end )) +&#xD;&#xA;(sum(case when (TR_TY='4' and dist_Stat is not null) then QTY*PRICE else 0 end ) &#xD;&#xA;- sum(case when (TR_TY='103' and dist_Stat is not null) then QTY*PRICE else 0 end )) +&#xD;&#xA;(sum(case when (TR_TY in ('3','5') and dist_Stat is not null) then QTY*PRICE else 0 end )&#xD;&#xA;- sum(case when (TR_TY in ('104','105') and dist_Stat is not null) then QTY*PRICE else 0 end )) -&#xD;&#xA;sum(case when (TR_TY='101' and dist_Stat is not null) then QTY*PRICE else 0 end )&#xD;&#xA;) as TotAssets&#xD;&#xA;&#xD;&#xA;from FA_PROJECTS_DETAILS where 1=1&#xD;&#xA;group by ProjNo,CST_CD,CONST_SCHDL&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;" Name="sqlDataSource1" />
  </DataSources>
