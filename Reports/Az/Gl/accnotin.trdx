<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource1" Width="17.1cm" Name="QueryGlJrnl1" xmlns="http://schemas.telerik.com/reporting/2021/1.0">
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="accmain" SelectCommand="select acc_no,ACC_NM_Ar  &#xD;&#xA;from glmf &#xD;&#xA;where  ACC_TY =2 and CST_GRP=1 and acc_no like '999101%'&#xD;&#xA;and acc_no not in (select acc_no from gljrnld where gljrnld.acc_no = glmf.acc_no and 1=1 )&#xD;&#xA;order by acc_no" Name="sqlDataSource1" />
  </DataSources>
  <Items>
    <PageHeaderSection Height="1.9cm" Name="pageHeaderSection1">
      <Style BackgroundColor="242, 242, 242" />
      <Items>
        <TextBox Width="5cm" Height="0.6cm" Left="6.5cm" Top="0.2cm" Value="حسابات لم تتم عليها حركه" Name="textBox3">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" />
          </Style>
        </TextBox>
        <TextBox Width="4.2cm" Height="0.6cm" Left="12.7cm" Top="1.2cm" Value="رقم الحساب" Name="textBox2">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" />
            <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="8.6cm" Height="0.6cm" Left="4.1cm" Top="1.2cm" Value="اسم الحساب" Name="textBox6">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" />
            <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
      </Items>
    </PageHeaderSection>
    <DetailSection Height="0.8cm" Name="detailSection1">
      <Style BackgroundColor="217, 217, 217" />
      <Items>
        <TextBox Width="4.2cm" Height="0.6cm" Left="12.7cm" Top="0.1cm" Value="= Fields.acc_no" Name="textBox1">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" />
            <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="8.6cm" Height="0.6cm" Left="4.1cm" Top="0.1cm" Value="= Fields.ACC_NM_Ar" Name="textBox4">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" />
            <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
      </Items>
    </DetailSection>
    <PageFooterSection Height="0.132cm" Name="pageFooterSection1">
      <Style BackgroundColor="215, 228, 188" />
    </PageFooterSection>
  </Items>
  <PageSettings PaperKind="A4" Landscape="False">
    <Margins>
      <MarginsU Left="2cm" Right="2cm" Top="2cm" Bottom="2cm" />
    </Margins>
  </PageSettings>
  <StyleSheet>
    <StyleRule>
      <Style>
        <Padding Left="2pt" Right="2pt" />
      </Style>
      <Selectors>
        <TypeSelector Type="TextItemBase" />
        <TypeSelector Type="HtmlTextBox" />
      </Selectors>
    </StyleRule>
  </StyleSheet>
  <ReportParameters>
    <ReportParameter Name="Url" Text="Url" />
    <ReportParameter Name="login" Text="login" />
    <ReportParameter Name="filter" AllowNull="True" />
  </ReportParameters>
</Report>