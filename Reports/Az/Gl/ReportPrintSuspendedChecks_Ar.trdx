<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="webServiceDataSource1" Width="11.614in" UnitOfMeasure="Mm" Name="ReportPrintSuspendedChecks" SnapToGrid="False" xmlns="http://schemas.telerik.com/reporting/2019/2.0">
  <DataSources>
    <WebServiceDataSource ServiceUrl="@Url" Name="webServiceDataSource1" ParameterValues="{&quot;FromDate&quot;:,&quot;ToDate&quot;:,&quot;.AspNetCore.Identity.Application&quot;:,&quot;@Url&quot;:}">
      <Parameters>
        <WebServiceParameter WebServiceParameterType="Query" Name="FromDate">
          <Value>
            <String>= Parameters.FromDate.Value</String>
          </Value>
        </WebServiceParameter>
        <WebServiceParameter WebServiceParameterType="Query" Name="ToDate">
          <Value>
            <String>= Parameters.ToDate.Value</String>
          </Value>
        </WebServiceParameter>
        <WebServiceParameter WebServiceParameterType="Cookie" Name=".AspNetCore.Identity.Application">
          <Value>
            <String>= Parameters.login.Value</String>
          </Value>
        </WebServiceParameter>
        <WebServiceParameter WebServiceParameterType="Inline" Name="@Url">
          <Value>
            <String>= Parameters.Url.Value + "eg/ReportSuspendedOrphans/GetDataReportPrintSuspendedChecks"</String>
          </Value>
        </WebServiceParameter>
      </Parameters>
    </WebServiceDataSource>
  </DataSources>
