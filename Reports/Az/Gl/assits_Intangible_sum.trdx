  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="glx2023" SelectCommand="SELECT  &#xD;&#xA;  &#xD;&#xA;  (sum(isnull(DPRC,0))- isnull((SELECT sum(isnull(val,0)) FROM FAJRNL where FAJRNL.fa_cd = famf.fa_cd  and tr_ty = '1' ),0)) AS famf_dprc,&#xD;&#xA;  isnull((SELECT sum(isnull(val,0)) FROM FAJRNL where FAJRNL.fa_cd = famf.fa_cd  and tr_ty = '1' ),0) as TOTADD,&#xD;&#xA;  isnull((SELECT sum(isnull(Q_PYRDPRC,0)) FROM FADPRC where FADPRC.fa_cd = famf.fa_cd ),0) as Q_PYRDPRC,&#xD;&#xA;  isnull((SELECT sum(isnull(dprexp,0)) FROM FADPRC where FADPRC.fa_cd = famf.fa_cd   ),0) as dprexp,&#xD;&#xA;  ( (sum(isnull(DPRC,0))- isnull((SELECT sum(isnull(val,0)) FROM FAJRNL where FAJRNL.fa_cd = famf.fa_cd  and tr_ty = '1' ),0))&#xD;&#xA;  +&#xD;&#xA;  isnull((SELECT sum(isnull(val,0)) FROM FAJRNL where FAJRNL.fa_cd = famf.fa_cd  and tr_ty = '1' ),0)&#xD;&#xA;  -&#xD;&#xA;  isnull((SELECT sum(isnull(Q_PYRDPRC,0)) FROM FADPRC where FADPRC.fa_cd = famf.fa_cd ),0)&#xD;&#xA;  -&#xD;&#xA;  isnull((SELECT sum(isnull(dprexp,0)) FROM FADPRC where FADPRC.fa_cd = famf.fa_cd   ),0)) as tot  &#xD;&#xA;FROM &#xD;&#xA;    famf &#xD;&#xA;WHERE fa_cd like '119230%' and 1=1&#xD;&#xA;group by fa_cd" Name="sqlDataSource1" />
  </DataSources>
