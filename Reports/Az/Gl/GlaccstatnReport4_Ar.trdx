        </TextBox>
        <TextBox Width="0.983in" Height="0.284in" Left="7.284in" Top="0in" Value="= IIf((Sum(Fields.DbVl) - Sum(Fields.CrVl)) &lt; 0,Abs(Sum(Fields.DbVl) - Sum(Fields.CrVl)), 0)" Format="{0:N3}" Name="textBox34">
          <Style Color="192, 0, 0" TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" />
            <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="1.006in" Height="0.284in" Left="8.268in" Top="0in" Value="= IIf((Sum(Fields.DbVl) - Sum(Fields.CrVl)) &gt;= 0,Sum(Fields.DbVl) - Sum(Fields.CrVl),0)" Format="{0:N3}" Name="textBox35">
          <Style Color="Blue" TextAlign="Center" VerticalAlign="Middle">
