        <TextBox Width="2.6cm" Height="0.7cm" Left="22.405cm" Top="0.95cm" Value="= IIf((Sum(Fields.DbVl) - Sum(Fields.CrVl)) &lt; 0,'رصيد دائن','رصيد مدين')" Name="textBox31">
