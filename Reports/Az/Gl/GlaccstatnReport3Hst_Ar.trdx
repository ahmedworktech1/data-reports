        <TextBox Width="0.989in" Height="0.63in" Left="0in" Top="0in" Value="= IIf((Sum(Fields.DbVl) - Sum(Fields.CrVl)) &lt; 0,Sum(Fields.DbVl) - Sum(Fields.CrVl), 0)" Name="textBox34">
          <Style Color="Red" TextAlign="Center" VerticalAlign="Middle" />
        </TextBox>
        <TextBox Width="2cm" Height="1.6cm" Left="7.212cm" Top="0.025cm" Value="= Sum(Fields.DbVl)" Name="textBox18">
