    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="glx2024" SelectCommand="select  'المراقبات الفنية' as s,&#xD;&#xA;CAST(ROUND(sum( case when ( acc_no like '4[6-8]1122%' )   and sum_Cd in ('12')  and cst_cd not like '11%' and jrn_Cd not like '017%'   then  db_vl-cr_vl else 0 end )/1000, 0) AS BIGINT) as s1,&#xD;&#xA;CAST(ROUND(sum( case when (( acc_no like '4[6-7]1121%' or  acc_no like '4[6-7]1123%'))    and sum_Cd in ('12','13')    and substring(cst_Cd,3,2)not  in ('01','20','21','22','23','24','25','26') and cst_cd not like '01%' and cst_cd not like '11%' and jrn_Cd not like '017%'   then  db_vl-cr_vl else 0 end )/1000, 0) AS BIGINT) &#xD;&#xA;+&#xD;&#xA;CAST(ROUND(sum( case when (( acc_no like '4[6-7]1121%' or  acc_no like '4[6-7]1123%'))    and sum_Cd in ('12')    and substring(cst_Cd,3,2)not  in ('01','20','21','22','23','24','25','26') and cst_cd not like '01%' and cst_cd not like '11%' and jrn_Cd = '0173'   then  db_vl-cr_vl else 0 end )/1000, 0) AS BIGINT) &#xD;&#xA;&#xD;&#xA;&#xD;&#xA;as s2,&#xD;&#xA;CAST(ROUND(sum( case when  (acc_no like '4[6-8]111%' or acc_no like '4[6-8]113%'  )     and sum_Cd in ('12','13')    and substring(cst_Cd,3,2)not  in ('01','20','21','22','23','24','25','26') and cst_cd not like '01%' and cst_cd not like '11%' and jrn_Cd not like '017%'  then  db_vl-cr_vl else 0 end )/1000, 0) AS BIGINT) &#xD;&#xA;+&#xD;&#xA;CAST(ROUND(sum( case when  (acc_no like '4[6-8]111%' or acc_no like '4[6-8]113%'  )    and sum_Cd in ('12')    and substring(cst_Cd,3,2)not  in ('01','20','21','22','23','24','25','26') and cst_cd not like '01%' and cst_cd not like '11%' and jrn_Cd = '0173'  then  db_vl-cr_vl else 0 end )/1000, 0) AS BIGINT) &#xD;&#xA;&#xD;&#xA;&#xD;&#xA;as s3,&#xD;&#xA;CAST(ROUND(sum( case when (( acc_no like '4[6-8]114%' or  acc_no like '4[6-8]115%' or  acc_no like '4[6-8]116%') )    and sum_Cd in ('12','13')    and substring(cst_Cd,3,2)not  in ('01','20','21','22','23','24','25','26') and cst_cd not li