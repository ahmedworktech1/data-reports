<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource1" Width="29.7cm" Name="QueryGlJrnl1" xmlns="http://schemas.telerik.com/reporting/2021/1.0">
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="kahrabaelmeniadata" SelectCommand="WITH CurrentPeriod AS (&#xD;&#xA;    SELECT &#xD;&#xA;        CAST(ROUND(SUM(CASE WHEN acc_no LIKE '4[6-8]31%' AND SUM_CD LIKE '11%' THEN val1 ELSE 0 END), 0) AS BIGINT) AS s1,&#xD;&#xA;        CAST(ROUND(SUM(CASE WHEN acc_no LIKE '4[6-8]31%' AND SUM_CD LIKE '11%' THEN db_vl - cr_vl ELSE 0 END), 0) AS BIGINT) AS s2,&#xD;&#xA;        CAST(ROUND(SUM(CASE WHEN acc_no LIKE '5[6-8]1111101%' OR acc_no LIKE '5[6-8]1111102%' AND SUM_CD LIKE '11%' THEN val1 ELSE 0 END), 0) AS BIGINT) AS s3,&#xD;&#xA;        CAST(ROUND(SUM(CASE WHEN acc_no LIKE '5[6-8]1111101%' OR acc_no LIKE '5[6-8]1111102%' AND SUM_CD LIKE '11%' THEN db_vl - cr_vl ELSE 0 END), 0) AS BIGINT) * -1 AS s4&#xD;&#xA;    FROM GLJRNLD_A&#xD;&#xA;    WHERE TR_DT &gt;=   '01011901'   AND TR_DT &lt;=  '01011902' and (1=1)&#xD;&#xA;),&#xD;&#xA;PreviousPeriod AS (&#xD;&#xA;    SELECT &#xD;&#xA;        CAST(ROUND(SUM(CASE WHEN acc_no LIKE '4[6-8]31%' AND SUM_CD LIKE '11%' AND DATEADD(YEAR, -1, TR_DT) IS NOT NULL THEN val1 ELSE 0 END), 0) AS BIGINT) AS s5,&#xD;&#xA;        CAST(ROUND(SUM(CASE WHEN acc_no LIKE '4[6-8]31%' AND SUM_CD LIKE '11%' AND DATEADD(YEAR, -1, TR_DT) IS NOT NULL THEN db_vl - cr_vl ELSE 0 END), 0) AS BIGINT) AS s6,&#xD;&#xA;        CAST(ROUND(SUM(CASE WHEN acc_no LIKE '5[6-8]1111101%' OR acc_no LIKE '5[6-8]1111102%' AND SUM_CD LIKE '11%' AND DATEADD(YEAR, -1, TR_DT) IS NOT NULL THEN val1 ELSE 0 END), 0) AS BIGINT) AS s7,&#xD;&#xA;        CAST(ROUND(SUM(CASE WHEN acc_no LIKE '5[6-8]1111101%' OR acc_no LIKE '5[6-8]1111102%' AND SUM_CD LIKE '11%' AND DATEADD(YEAR, -1, TR_DT) IS NOT NULL THEN db_vl - cr_vl ELSE 0 END), 0) AS BIGINT) * -1 AS s8&#xD;&#xA;    FROM GLJRNLD_A&#xD;&#xA;    WHERE TR_DT &gt;=   '01/01/1903'   AND TR_DT &lt;=  '01/01/1904' and (1=1)&#xD;&#xA;)&#xD;&#xA;SELECT &#xD;&#xA;    cp.s1, cp.s2, cp.s3, cp.s4, &#xD;&#xA;    pp.s5, pp.s6, pp.s7, pp.s8&#xD;&#xA;FROM CurrentPeriod cp&#xD;&#xA;JOIN PreviousPeriod pp ON 1=1;" Name="sqlDataSource1" />
  </DataSources>
