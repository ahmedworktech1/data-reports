                <NavigateToUrlAction Url="=&#xA; Parameters.Url.Value + &quot;az/Aztrh/CreateEdit/?loc=&quot; + Fields.Loc +&quot;&amp;trTy=&quot; + Fields.TrTy + &quot;&amp;trNo=&quot; + Fields.TrNo + &quot;&amp;lnNo=&quot; + Fields.LnNo + &#xA;    &quot;&amp;editMode=1&amp;isNotNewAndFromIndex=true&quot;&#xA;" />
              </Action>
              <Bindings>
