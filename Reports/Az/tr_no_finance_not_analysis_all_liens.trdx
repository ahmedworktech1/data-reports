  <Style Visible="True" />
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="glx2023" SelectCommand="&#xD;&#xA;select distinct jrn_cd,(SELECT DOC_DS_Ar FROM GLTRSTBL where doc_ty = gljrnld.jrn_Cd) as nm ,tr_no,tr_dt,ACC_NO,cr_vl,DB_VL,ln_no,(select revisd from gljrnlh where jrn_Cd = gljrnld.jrn_Cd and tr_no = GLJRNLD.tr_no) as revisd from gljrnld&#xD;&#xA; where (acc_no like '4[1-3]%' or (acc_no like '511%' and acc_no like '512%')) and  (select revisd from gljrnlh where jrn_Cd = gljrnld.jrn_Cd and tr_no = GLJRNLD.tr_no) = 1&#xD;&#xA;and not exists(select 1 from gljrnld c where c.gl_jrn_Cd=gljrnld.jrn_cd &#xD;&#xA;and c.gl_tr_no=gljrnld.tr_no  and c.GL_LN_NO=gljrnld.LN_NO ) order by TR_DT,jrn_cd,tr_no&#xD;&#xA;" Name="sqlDataSource2" />
  </DataSources>
