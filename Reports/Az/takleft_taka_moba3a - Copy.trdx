N (acc_no LIKE '5[6-8]11111%' OR acc_no LIKE '5[6-8]1111102%') THEN VAL1 ELSE 0 END), &#xD;&#xA;            0&#xD;&#xA;        ) &#xD;&#xA;        * 100, &#xD;&#xA;    3)&#xD;&#xA; as s2,&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;    ROUND(&#xD;&#xA;        CAST(&#xD;&#xA;            SUM(CASE WHEN acc_no like '0%' THEN db_vl - cr_vl ELSE 0 END) &#xD;&#xA;            AS NUMERIC&#xD;&#xA;        ) &#xD;&#xA;        / &#xD;&#xA;        NULLIF(&#xD;&#xA;            SUM(CASE WHEN (acc_no LIKE '0%' OR acc_no LIKE '0%') THEN VAL1 ELSE 0 END), &#xD;&#xA;            0&#xD;&#xA;        ) &#xD;&#xA;        * 100, &#xD;&#xA;   0)&#xD;&#xA; &#xD;&#xA; as s3&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;from gljrnld  WHERE (( acc_no like '5[6-8]1122101%' or acc_no LIKE '5[6-8]11111%' OR acc_no LIKE '5[6-8]1111102%') ) &#xD;&#xA;and (1=1)&#xD;&#xA;&#xD;&#xA;UNION ALL&#xD;&#xA;&#xD;&#xA;select 'خدمة عملاء' as s,&#xD;&#xA;CAST(ROUND(sum( case when (acc_no like '5[6-8]1122103%' ) then db_vl-cr_vl else 0 end ), 0) AS BIGINT)*-1 as s1,&#xD;&#xA;    ROUND(&#xD;&#xA;        CAST(&#xD;&#xA;            SUM(CASE WHEN acc_no like '5[6-8]1122103%' THEN db_vl - cr_vl ELSE 0 END)*-1 &#xD;&#xA;            AS NUMERIC&#xD;&#xA;        ) &#xD;&#xA;        / &#xD;&#xA;        NULLIF(&#xD;&#xA;            SUM(CASE WHEN (acc_no LIKE '5[6-8]11111%' OR acc_no LIKE '5[6-8]1111102%') THEN VAL1 ELSE 0 END), &#xD;&#xA;            0&#xD;&#xA;        ) &#xD;&#xA;        * 100, &#xD;&#xA;    3)&#xD;&#xA; as s2,&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;    ROUND(&#xD;&#xA;        CAST(&#xD;&#xA;            SUM(CASE WHEN acc_no like '0%' THEN db_vl - cr_vl ELSE 0 END) &#xD;&#xA;            AS NUMERIC&#xD;&#xA;        ) &#xD;&#xA;        / &#xD;&#xA;        NULLIF(&#xD;&#xA;            SUM(CASE WHEN (acc_no LIKE '0%' OR acc_no LIKE '0%') THEN VAL1 ELSE 0 END), &#xD;&#xA;            0&#xD;&#xA;        ) &#xD;&#xA;        * 100, &#xD;&#xA;   0)&#xD;&#xA; &#xD;&#xA; as s3&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;from gljrnld  WHERE (( acc_no like '5[6-8]1122103%' or acc_no LIKE '5[6-8]11111%' OR acc_no LIKE '5[6-8]1111102%') ) &#xD;&#xA;and (1=1)&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;union all &#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;select 'النتيجة بعد الخدمات المباعة' as s,&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;(CAST(ROUND(sum( case when (acc_no like '5[6-8]11111%' ) then db_vl-cr_vl else 0 end ), 0) AS BIGINT)*-1&#xD;&#xA;-&#xD;&#xA;CAST(ROUND(sum( case when ( acc_no like '4[6-8]11%' or acc_no like '4[6-8]12%' or acc_no like '4[6-8]2%' or acc_no like '4[6-8]31%' ) and sum_cd ='11' then db_vl-cr_vl else 0 end ), 0) AS BIGINT)&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;)&#xD;&#xA;-&#xD;&#xA;(CAST(ROUND(sum( case when (acc_no like '512501%' ) then db_vl-cr_vl else 0 end ), 0) AS BIGINT))&#xD;&#xA;-&#xD;&#xA;(CAST(ROUND(sum( case when (acc_no like '5[6-8]1122101%' ) then db_vl-cr_vl else 0 end ), 0) AS BIGINT))&#xD;&#xA;-&#xD;&#xA;(CAST(ROUND(sum( case when (acc_no like '5[6-8]1122103%' ) then db_vl-cr_vl else 0 end ), 0) AS BIGINT))&#xD;&#xA; as s1,&#xD;&#xA;    ROUND(&#xD;&#xA;        CAST(&#xD;&#xA;            (SUM(CASE WHEN acc_no like '5[6-8]11111%' THEN db_vl - cr_vl ELSE 0 END)*-1&#xD;&#xA;&#x9;&#x9;&#x9;-&#xD;&#xA;&#x9;&#x9;&#x9;(SUM(CASE WHEN ( acc_no like '4[6-8]11%' or acc_no like '4[6-8]12%' or acc_no like '4[6-8]2%' or acc_no like '4[6-8]31%' ) and sum_cd ='11' THEN db_vl - cr_vl ELSE 0 END))&#xD;&#xA;&#x9;&#x9;&#x9;-&#xD;&#xA;&#x9;&#x9;&#x9;CAST(ROUND(sum( case when (acc_no like '512501%' ) then db_vl-cr_vl else 0 end ), 0) AS BIGINT)*-1&#xD;&#xA;&#x9;&#x9;&#x9;-&#xD;&#xA;&#x9;&#x9;&#x9;(CAST(ROUND(sum( case when (acc_no like '5[6-8]1122101%' ) then db_vl-cr_vl else 0 end ), 0) AS BIGINT))&#xD;&#xA;&#x9;&#x9;&#x9;-&#xD;&#xA;&#x9;&#x9;&#x9;(CAST(ROUND(sum( case when (acc_no like '5[6-8]1122103%' ) then db_vl-cr_vl else 0 end ), 0) AS BIGINT))&#xD;&#xA;&#x9;&#x9;&#x9;) &#xD;&#xA;            AS NUMERIC&#xD;&#xA;        ) &#xD;&#xA;        / &#xD;&#xA;        NULLIF(&#xD;&#xA;            SUM(CASE WHEN (acc_no LIKE '5[6-8]11111%' OR acc_no LIKE '5[6-8]1111102%') THEN VAL1 ELSE 0 END), &#xD;&#xA;            0&#xD;&#xA;        ) &#xD;&#xA;        * 100, &#xD;&#xA;    3)&#xD;&#xA; as s2,&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;    ROUND(&#xD;&#xA;        CAST(&#xD;&#xA;            SUM(CASE WHEN acc_no like '0%' THEN db_vl - cr_vl ELSE 0 END) &#xD;&#xA;            AS NUMERIC&#xD;&#xA;        ) &#xD;&#xA;        / &#xD;&#xA;        NULLIF(&#xD;&#xA;            SUM(CASE WHEN (acc_no LIKE '0%' OR acc_no LIKE '0%') THEN VAL1 ELSE 0 END), &#xD;&#xA;            0&#xD;&#xA;        ) &#xD;&#xA;        * 100, &#xD;&#xA;   0)&#xD;&#xA; &#xD;&#xA; as s3&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;from gljrnld  WHERE ((acc_no like '4[6-8]11%' or acc_no like '4[6-8]12%' or acc_no like '4[6-8]2%' or acc_no like '4[6-8]31%' or acc_no like '5[6-8]1111101%' or acc_no LIKE '5[6-8]11111%' OR acc_no LIKE '5[6-8]1111102%' or acc_no like '512501%' or acc_no like '5[6-8]1122101%' or acc_no like '5[6-8]1122103%'   ) ) &#xD;&#xA;&#xD;&#xA;and (1=1)&#xD;&#xA;&#xD;&#xA;;WITH TotalCost AS (&#xA;    SELECT&#xA;        SUM(CASE WHEN (acc_no LIKE '4[6-8]11%' OR acc_no LIKE '4[6-8]12%' OR acc_no LIKE '4[6-8]2%' OR acc_no LIKE '4[6-8]31%') AND sum_cd = '11'&#xA;                 THEN db_vl - cr_vl ELSE 0 END) AS total_cost,&#xA;        SUM(CASE WHEN acc_no LIKE '5[6-8]11111%' OR acc_no LIKE '5[6-8]1111102%' THEN VAL1 ELSE 0 END) AS total_value1&#xA;    FROM gljrnld&#xA;    WHERE (acc_no LIKE '4[6-8]11%' OR acc_no LIKE '4[6-8]12%' OR acc_no LIKE '4[6-8]2%' OR acc_no LIKE '4[6-8]31%' OR acc_no LIKE '5[6-8]11111%' OR acc_no LIKE '5[6-8]1111102%')&#xA;      AND sum_cd = '11'&#xA;      and (1=1)&#xA;)&#xA;SELECT&#xA;    'التكلفة الكلية' AS s,&#xA;    CAST(ROUND(total_cost, 0) AS BIGINT) AS s11,&#xA;    ROUND(&#xA;        CAST(total_cost AS NUMERIC) &#xA;        / NULLIF(total_value1, 0) * 100, &#xA;        3&#xA;    ) AS s12,&#xA;    (ROUND(total_cost, 0) / ROUND(total_cost, 0)) * 100 AS s13,&#xA;    total_cost AS total_cost_alias&#xA;FROM TotalCost;&#xA;&#xD;&#xA;;WITH RevenueCurrentActivity AS (&#xA;    SELECT&#xA;        SUM(CASE WHEN acc_no LIKE '5[6-8]11111%' THEN (db_vl - cr_vl) ELSE 0 END) AS total_revenue,&#xA;        SUM(CASE WHEN acc_no LIKE '0%' THEN (db_vl - cr_vl) ELSE 0 END) AS total_value1&#xA;    FROM gljrnld&#xA;    WHERE (acc_no LIKE '5[6-8]11111%' OR acc_no LIKE '5[6-8]1111102%')&#xA;      and (1=1)&#xA;)&#xA;SELECT&#xA;    'ايرادات النشاط الجاري' AS s,&#xA;    CAST(ROUND(total_revenue, 0) AS BIGINT) * -1 AS s15,&#xA;    ROUND(&#xA;        CAST(total_revenue AS NUMERIC) &#xA;        / NULLIF(total_value1, 0) * 100, &#xA;        3&#xA;    ) AS s16,&#xA;    (ROUND(total_revenue, 0) / ROUND(total_revenue, 0)) * 100 AS s17,&#xA;    total_revenue AS total_revenue_alias&#xA;FROM RevenueCurrentActivity;&#xA;&#xD;&#xA;;WITH EnergyPurchases AS (&#xA;    SELECT&#xA;        SUM(CASE WHEN acc_no LIKE '4[6-8]31%' THEN (db_vl - cr_vl) ELSE 0 END) AS total_energy_purchases,&#xA;        SUM(CASE WHEN acc_no LIKE '5[6-8]11111%' OR acc_no LIKE '5[6-8]1111102%' THEN VAL1 ELSE 0 END) AS total_value1&#xA;    FROM gljrnld&#xA;    WHERE (acc_no LIKE '4[6-8]31%' OR acc_no LIKE '5[6-8]11111%' OR acc_no LIKE '5[6-8]1111102%')&#xA;      and (1=1)&#xA;)&#xA;SELECT&#xA;    'مشتريات الطاقة' AS s,&#xA;    CAST(ROUND(total_energy_purchases, 0) AS BIGINT) AS s1,&#xA;    CAST(ROUND(total_value1, 0) AS BIGINT) AS s20,&#xA;    (ROUND(total_energy_purchases, 0) / ROUND((SELECT SUM(CASE WHEN (acc_no LIKE '4[6-8]11%' OR acc_no LIKE '4[6-8]12%' OR acc_no LIKE '4[6-8]2%' OR acc_no LIKE '4[6-8]31%') AND sum_cd = '11' THEN (db_vl - cr_vl) ELSE 0 END) FROM gljrnld WHERE (acc_no LIKE '4[6-8]11%' OR acc_no LIKE '4[6-8]12%' OR acc_no LIKE '4[6-8]2%' OR acc_no LIKE '4[6-8]31%') and (1=1)), 0)) * 100 AS s3&#xA;FROM EnergyPurchases;&#xA;&#xD;&#xA;&#xD;&#xA;" Name="sqlDataSource1" />
  </DataSources>
