<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource2" Width="241mm" UnitOfMeasure="Mm" Name="ReportGlunbaljrn" ShowWatermarks="False" xmlns="http://schemas.telerik.com/reporting/2021/1.0">
  <Style Visible="True" />
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="glx2024" SelectCommand="WITH CTE AS (&#xD;&#xA;    SELECT &#xD;&#xA;        SUBSTRING(cst_cd, 1, 2) AS cst_cd_2,&#xD;&#xA;        cst_nm_Ar,&#xD;&#xA;        ROW_NUMBER() OVER (PARTITION BY SUBSTRING(cst_cd, 1, 2) ORDER BY cst_cd) AS rn&#xD;&#xA;    FROM &#xD;&#xA;        GLCST&#xD;&#xA;)&#xD;&#xA;SELECT &#xD;&#xA;    SUBSTRING(GLJRNLD.cst_cd, 1, 2) AS cst_cd_2,&#xD;&#xA;    CTE.cst_nm_Ar,&#xD;&#xA;    SUM(CASE WHEN GLJRNLD.acc_no LIKE '4[6-8]1112%' THEN (GLJRNLD.db_vl - GLJRNLD.cr_vl) ELSE 0 END) AS sum_461112,&#xD;&#xA;    SUM(CASE WHEN GLJRNLD.acc_no LIKE '5[6-8]122201%' THEN (GLJRNLD.db_vl - GLJRNLD.cr_vl) ELSE 0 END)*-1 AS sum_46122201,&#xD;&#xA;&#xD;&#xA;&#x9;    ROUND((SUM(CASE WHEN GLJRNLD.acc_no LIKE '4[6-8]1113%' THEN (GLJRNLD.db_vl - GLJRNLD.cr_vl) ELSE 0 END) -&#xD;&#xA;    (SUM(CASE WHEN GLJRNLD.acc_no LIKE '5[6-8]122202%' THEN (GLJRNLD.db_vl - GLJRNLD.cr_vl) ELSE 0 END)*-1))*-1,3) AS DIFFEXPENSS1,&#xD;&#xA;&#xD;&#xA;    ROUND((SUM(CASE WHEN GLJRNLD.acc_no LIKE '5[6-8]122201%' THEN (GLJRNLD.db_vl - GLJRNLD.cr_vl) ELSE 0 END)*-1) /&#xD;&#xA;    NULLIF(SUM(CASE WHEN GLJRNLD.acc_no LIKE '4[6-8]1112%' THEN (GLJRNLD.db_vl - GLJRNLD.cr_vl) ELSE 0 END), 0) * 100, 0) AS PERCENT1,&#xD;&#xA;&#xD;&#xA;    SUM(CASE WHEN GLJRNLD.acc_no LIKE '4[6-8]1113%' THEN (GLJRNLD.db_vl - GLJRNLD.cr_vl) ELSE 0 END) AS sum_461113,&#xD;&#xA;    SUM(CASE WHEN GLJRNLD.acc_no LIKE '5[6-8]122202%' THEN (GLJRNLD.db_vl - GLJRNLD.cr_vl) ELSE 0 END)*-1 AS sum_4622202,&#xD;&#xA;&#xD;&#xA;    ROUND((SUM(CASE WHEN GLJRNLD.acc_no LIKE '4[6-8]1113%' THEN (GLJRNLD.db_vl - GLJRNLD.cr_vl) ELSE 0 END) -&#xD;&#xA;    (SUM(CASE WHEN GLJRNLD.acc_no LIKE '5[6-8]122202%' THEN (GLJRNLD.db_vl - GLJRNLD.cr_vl) ELSE 0 END)*-1))*-1,3) AS DIFFEXPENSS2,&#xD;&#xA;&#xD;&#xA;&#x9;ROUND((SUM(CASE WHEN GLJRNLD.acc_no LIKE '5[6-8]122202%' THEN (GLJRNLD.db_vl - GLJRNLD.cr_vl) ELSE 0 END)*-1) /&#xD;&#xA;    NULLIF(SUM(CASE WHEN GLJRNLD.acc_no LIKE '4[6-8]1113%' THEN (GLJRNLD.db_vl - GLJRNLD.cr_vl) ELSE 0 END), 0) * 100, 0) AS PERCENT2&#xD;&#xA;FROM &#xD;&#xA;    GLJRNLD&#xD;&#xA;JOIN &#xD;&#xA;    (SELECT cst_cd_2, cst_nm_Ar FROM CTE WHERE rn = 1) AS CTE ON SUBSTRING(GLJRNLD.cst_cd, 1, 2) = CTE.cst_cd_2&#xD;&#xA;WHERE &#xD;&#xA;    SUBSTRING(GLJRNLD.cst_cd, 1, 2) &lt;&gt; '01' AND  substring(cst_Cd, 3, 2) not in ('01','20','21','22','23','24','25','26')&#xD;&#xA;GROUP BY &#xD;&#xA;    SUBSTRING(GLJRNLD.cst_cd, 1, 2),&#xD;&#xA;    CTE.cst_nm_Ar&#xD;&#xA;&#x9;HAVING &#xA;    SUM(CASE WHEN GLJRNLD.acc_no LIKE '4[6-8]1112%' THEN (GLJRNLD.db_vl - GLJRNLD.cr_vl) ELSE 0 END) +&#xA;    SUM(CASE WHEN GLJRNLD.acc_no LIKE '5[6-8]122201%' THEN (GLJRNLD.db_vl - GLJRNLD.cr_vl) ELSE 0 END)*-1 +&#xA;    SUM(CASE WHEN GLJRNLD.acc_no LIKE '4[6-8]1113%' THEN (GLJRNLD.db_vl - GLJRNLD.cr_vl) ELSE 0 END) +&#xA;    SUM(CASE WHEN GLJRNLD.acc_no LIKE '5[6-8]122202%' THEN (GLJRNLD.db_vl - GLJRNLD.cr_vl) ELSE 0 END)*-1 &lt;&gt; 0&#xA;&#xD;&#xA;ORDER BY &#xD;&#xA;    cst_cd_2&#xD;&#xA;" Name="sqlDataSource2" />
  </DataSources>
