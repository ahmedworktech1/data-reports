            <TextBox Width="2.267cm" Height="0.721cm" Left="14.486cm" Top="0cm" Value="=Sum (Fields.CrVl)" Format="{0:#.000}" Name="textBox19">
              <Style Color="192, 0, 0" TextAlign="Justify" VerticalAlign="Middle">
                <Font Size="9pt" Bold="False" />
                <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
                <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
                <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
              </Style>
            </TextBox>
            <TextBox Width="0.909in" Height="0.284in" Left="7.48in" Top="0in" Value="= IIf((Sum(Fields.DbVl) - Sum(Fields.CrVl)) &lt; 0,Abs(Sum(Fields.DbVl) - Sum(Fields.CrVl)), 0)" Format="{0:#.000}" Name="textBox34">
              <Style Color="192, 0, 0" TextAlign="Center" VerticalAlign="Middle">
                <Font Size="9pt" Bold="False" />
                <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
                <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
                <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
              </Style>
            </TextBox>
            <TextBox Width="0.885in" Height="0.284in" Left="8.389in" Top="0in" Value="= IIf((Sum(Fields.DbVl) - Sum(Fields.CrVl)) &gt;= 0,Sum(Fields.DbVl) - Sum(Fields.CrVl), 0)" Format="{0:#.000}" Name="textBox35">
              <Style Color="Blue" TextAlign="Center" VerticalAlign="Middle">
                <Font Size="9pt" Bold="False" />
                <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
                <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
