<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource1" Width="297mm" Name="Report" xmlns="http://schemas.telerik.com/reporting/2021/1.0">
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="STARData" SelectCommand="SELECT &#xD;&#xA;    DB_VL + CR_VL AS NET,&#xD;&#xA;    1 AS NUM,&#xD;&#xA;    ISNULL((DB_VL - CR_VL), 0) AS NNET,&#xD;&#xA;    (SELECT SUM_NM_AR FROM GLSUMS WHERE SUM_CD = GLJRNLD.SUM_CD) AS SUMNM,&#xD;&#xA;    (SELECT CST_NM_AR FROM GLCST WHERE CST_CD = LEFT(GLJRNLD.CST_CD, 2)) AS CSTNM,&#xD;&#xA;    (SELECT CST_NM_AR FROM GLCST WHERE CST_CD = (SELECT LEFT(SUM_CST_CD, 1) FROM GLSUMS WHERE SUM_CD = GLJRNLD.SUM_CD)) AS CSTNM1,&#xD;&#xA;    (SELECT ACC_NM_AR FROM GLMF WHERE ACC_NO = GLJRNLD.ACC_NO) AS ACCTNM,&#xD;&#xA;    (SELECT FMLY FROM GLMF WHERE ACC_NO = GLJRNLD.ACC_NO) AS FMLY,&#xD;&#xA;    (SELECT BTCH_ID FROM GLCST WHERE CST_CD = GLJRNLD.CST_CD) AS BTICH,&#xD;&#xA;    (SELECT LC_NO FROM GLLCMF WHERE SUM_CD = GLJRNLD.SUM_CD) AS LCNO,&#xD;&#xA;    (SELECT LC_AMOUNT FROM GLLCMF WHERE SUM_CD = GLJRNLD.SUM_CD) AS LCAMOUNT,&#xD;&#xA;    (SELECT LC_DSCR_AR FROM GLLCMF WHERE SUM_CD = GLJRNLD.SUM_CD) AS DSCR,&#xD;&#xA;    (SELECT GOOD_DSCR FROM GLLCMF WHERE SUM_CD = GLJRNLD.SUM_CD) AS GOODDSCR,&#xD;&#xA;    (SELECT OPN_DT FROM GLLCMF WHERE SUM_CD = GLJRNLD.SUM_CD) AS OPENDATE,&#xD;&#xA;    (SELECT LC_DSCR_EN FROM GLLCMF WHERE SUM_CD = GLJRNLD.SUM_CD) AS ADRESS,&#xD;&#xA;    (SELECT REN_DT1 FROM GLLCMF WHERE SUM_CD = GLJRNLD.SUM_CD) AS REN1,&#xD;&#xA;    (SELECT REN_DT2 FROM GLLCMF WHERE SUM_CD = GLJRNLD.SUM_CD) AS REN2,&#xD;&#xA;    (SELECT REN_DT3 FROM GLLCMF WHERE SUM_CD = GLJRNLD.SUM_CD) AS REN3,&#xD;&#xA;    (SELECT REN_VL1 FROM GLLCMF WHERE SUM_CD = GLJRNLD.SUM_CD) AS RENVL1,&#xD;&#xA;    (SELECT REN_VL2 FROM GLLCMF WHERE SUM_CD = GLJRNLD.SUM_CD) AS RENVL2,&#xD;&#xA;    (SELECT REN_VL3 FROM GLLCMF WHERE SUM_CD = GLJRNLD.SUM_CD) AS RENVL3,&#xD;&#xA;    (SELECT EXP_DT1 FROM GLLCMF WHERE SUM_CD = GLJRNLD.SUM_CD) AS EXP_DT1,&#xD;&#xA;    (SELECT EXP_DT2 FROM GLLCMF WHERE SUM_CD = GLJRNLD.SUM_CD) AS EXP_DT2,&#xD;&#xA;    (SELECT EXP_DT3 FROM GLLCMF WHERE SUM_CD = GLJRNLD.SUM_CD) AS EXP_DT3,&#xD;&#xA;    (CASE WHEN GLJRNLD.LN_TY = 1 AND GLJRNLD.SUM_CD LIKE '0102%' THEN GLJRNLD.CUR_VL ELSE 0 END) -&#xD;&#xA;    (CASE WHEN GLJRNLD.LN_TY = -1 AND GLJRNLD.SUM_CD LIKE '0102%' THEN GLJRNLD.CUR_VL ELSE 0 END) AS CUR,&#xD;&#xA;    *&#xD;&#xA;FROM GLJRNLD&#xD;&#xA;WHERE GLJRNLD.SUM_CD LIKE '0102%' and (1=1)&#xD;&#xA;" Name="sqlDataSource1" />
  </DataSources>
