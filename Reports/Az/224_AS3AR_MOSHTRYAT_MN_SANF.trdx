  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="azx20241" SelectCommand="select loc,(select loc_nm_ar from azlocs where aztrd.loc = azlocs.loc) as 'اسم المخزن',tr_ty,&#xD;&#xA;(select dscr_ar from aztrty where aztrd.tr_ty = aztrty.tr_ty) as 'اسم الحركة',tr_no,tr_dt,acc_no,&#xD;&#xA;(select acc_nm_ar from azaccmf where aztrd.acc_no = azaccmf.acc_no) as 'اسم الحساب',qty,pkprc,&#xD;&#xA;itm_cd,(select itm_nm_ar from azitms where aztrd.itm_cd = azitms.itm_cd) as 'اسم الصنف' ,&#xD;&#xA;(((100-isnull(sDISC1,0))/100)*PKPRC)as nprc&#xD;&#xA;,TRY_CONVERT(DATETIME, '01/01/1901', 102)  AS FROM_date, &#xD;&#xA;TRY_CONVERT(DATETIME, '01/01/1902', 102) AS TO_date&#xD;&#xA;from aztrd &#xD;&#xA;where 1=1&#xD;&#xA;order by tr_dt,tr_ty,tr_no" Name="sqlDataSource1" />
  </DataSources>
