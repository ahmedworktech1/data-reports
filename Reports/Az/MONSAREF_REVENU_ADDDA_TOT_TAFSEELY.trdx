<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource2" Width="241.3mm" UnitOfMeasure="Mm" Name="ReportGlunbaljrn" ShowWatermarks="False" xmlns="http://schemas.telerik.com/reporting/2021/1.0">
  <Style Visible="True" />
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="glx2024" SelectCommand="WITH CTE AS (&#xA;    SELECT &#xA;        SUBSTRING(cst_cd, 1, 4) AS cst_cd_4,&#xA;        cst_nm_Ar,&#xA;        ROW_NUMBER() OVER (PARTITION BY SUBSTRING(cst_cd, 1, 4) ORDER BY cst_cd) AS rn&#xA;    FROM &#xA;        GLCST&#xA;)&#xA;SELECT &#xA;    SUBSTRING(GLJRNLD.cst_cd, 1, 2) AS cst_cd_2,&#xA;    SUBSTRING(GLJRNLD.cst_cd, 1, 4) AS cst_cd_4,&#xA;    CTE.cst_nm_Ar,&#xA;    SUM(CASE WHEN GLJRNLD.acc_no LIKE '4[6-8]1112%' THEN (GLJRNLD.db_vl - GLJRNLD.cr_vl) ELSE 0 END) AS sum_461112,&#xA;    SUM(CASE WHEN GLJRNLD.acc_no LIKE '5[6-8]122201%' THEN (GLJRNLD.db_vl - GLJRNLD.cr_vl) ELSE 0 END)*-1 AS sum_46122201,&#xA;&#xA;    ROUND((SUM(CASE WHEN GLJRNLD.acc_no LIKE '4[6-8]1112%' THEN (GLJRNLD.db_vl - GLJRNLD.cr_vl) ELSE 0 END) -&#xA;    (SUM(CASE WHEN GLJRNLD.acc_no LIKE '5[6-8]122201%' THEN (GLJRNLD.db_vl - GLJRNLD.cr_vl) ELSE 0 END)*-1))*-1, 3) AS DIFFEXPENSS1,&#xA;&#xA;    ROUND((SUM(CASE WHEN GLJRNLD.acc_no LIKE '5[6-8]122201%' THEN (GLJRNLD.db_vl - GLJRNLD.cr_vl) ELSE 0 END)*-1) /&#xA;    NULLIF(SUM(CASE WHEN GLJRNLD.acc_no LIKE '4[6-8]1112%' THEN (GLJRNLD.db_vl - GLJRNLD.cr_vl) ELSE 0 END), 0) * 100, 0) AS PERCENT1,&#xA;&#xA;    SUM(CASE WHEN GLJRNLD.acc_no LIKE '4[6-8]1113%' THEN (GLJRNLD.db_vl - GLJRNLD.cr_vl) ELSE 0 END) AS sum_461113,&#xA;    SUM(CASE WHEN GLJRNLD.acc_no LIKE '5[6-8]122202%' THEN (GLJRNLD.db_vl - GLJRNLD.cr_vl) ELSE 0 END)*-1 AS sum_4622202,&#xA;&#xA;    ROUND((SUM(CASE WHEN GLJRNLD.acc_no LIKE '4[6-8]1113%' THEN (GLJRNLD.db_vl - GLJRNLD.cr_vl) ELSE 0 END) -&#xA;    (SUM(CASE WHEN GLJRNLD.acc_no LIKE '5[6-8]122202%' THEN (GLJRNLD.db_vl - GLJRNLD.cr_vl) ELSE 0 END)*-1))*-1, 3) AS DIFFEXPENSS2,&#xA;&#xA;    ROUND((SUM(CASE WHEN GLJRNLD.acc_no LIKE '5[6-8]122202%' THEN (GLJRNLD.db_vl - GLJRNLD.cr_vl) ELSE 0 END)*-1) /&#xA;    NULLIF(SUM(CASE WHEN GLJRNLD.acc_no LIKE '4[6-8]1113%' THEN (GLJRNLD.db_vl - GLJRNLD.cr_vl) ELSE 0 END), 0) * 100, 0) AS PERCENT2&#xA;FROM &#xA;    GLJRNLD&#xA;JOIN &#xA;    (SELECT cst_cd_4, cst_nm_Ar FROM CTE WHERE rn = 1) AS CTE ON SUBSTRING(GLJRNLD.cst_cd, 1, 4) = CTE.cst_cd_4&#xA;WHERE &#xA;    SUBSTRING(GLJRNLD.cst_cd, 1, 2) &lt;&gt; '01' AND  SUBSTRING(cst_cd, 3, 2) NOT IN ('01','20','21','22','23','24','25','26')&#xA;GROUP BY &#xA;    SUBSTRING(GLJRNLD.cst_cd, 1, 2),&#xA;    SUBSTRING(GLJRNLD.cst_cd, 1, 4),&#xA;    CTE.cst_nm_Ar&#xA;HAVING &#xA;    SUM(CASE WHEN GLJRNLD.acc_no LIKE '4[6-8]1112%' THEN (GLJRNLD.db_vl - GLJRNLD.cr_vl) ELSE 0 END) +&#xA;    SUM(CASE WHEN GLJRNLD.acc_no LIKE '5[6-8]122201%' THEN (GLJRNLD.db_vl - GLJRNLD.cr_vl) ELSE 0 END)*-1 +&#xA;    SUM(CASE WHEN GLJRNLD.acc_no LIKE '4[6-8]1113%' THEN (GLJRNLD.db_vl - GLJRNLD.cr_vl) ELSE 0 END) +&#xA;    SUM(CASE WHEN GLJRNLD.acc_no LIKE '5[6-8]122202%' THEN (GLJRNLD.db_vl - GLJRNLD.cr_vl) ELSE 0 END)*-1 &lt;&gt; 0&#xA;ORDER BY &#xA;    cst_cd_2, cst_cd_4;&#xA;" Name="sqlDataSource2" />
  </DataSources>
