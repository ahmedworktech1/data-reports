  <Style Visible="True" />
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="glx2023" SelectCommand="select&#xD;&#xA;m678.jrn_cd as cst_jrn_cd,m678.tr_no as cst_tr_no,m678.ln_no as cst_ln_no&#xD;&#xA;,gljrnld.jrn_cd,gljrnld.tr_no,gljrnld.ln_no&#xD;&#xA;,m678.GL_jrn_cd,m678.GL_tr_no,m678.GL_ln_no&#xD;&#xA;,gljrnld.db_vl,gljrnld.cr_vl,gljrnld.acc_no,m678.acc_no as cst_acc_no&#xD;&#xA;,(select acc_nm_ar from glmf where glmf.acc_no=gljrnld.acc_no) as acc_nm&#xD;&#xA;,(select doc_ds_ar from gltrstbl where gltrstbl.doc_ty=m678.jrn_cd) as jrn_nm&#xD;&#xA;,( SELECT UNT_cD FROM GLLOC WHERE UNT_cD = GLJRNLD.COM_ID) AS COMID&#xD;&#xA;&#xD;&#xA;from&#xD;&#xA;gljrnld , gljrnld as m678&#xD;&#xA;&#xD;&#xA;Where&#xD;&#xA;gljrnld.jrn_cd=m678.gl_jrn_cd&#xD;&#xA;and gljrnld.tr_no=m678.gl_tr_no&#xD;&#xA;and gljrnld.ln_no=m678.gl_ln_no&#xD;&#xA;and (gljrnld.acc_no like'4[1-2]%' OR gljrnld.ACC_NO like '511111%'  or  gljrnld.ACC_NO like '51221%' or  gljrnld.ACC_NO like '51222%' )&#xD;&#xA;and gljrnld.acc_no&lt;&gt;left(m678.acc_no,1)+substring(m678.acc_no,3,15) &#xD;&#xA;&#xD;&#xA;order by gljrnld.jrn_cd,gljrnld.tr_no,gljrnld.ln_no" Name="sqlDataSource2" />
  </DataSources>
