  <Items>
    <PageHeaderSection Height="4.3cm" Name="pageHeaderSection1">
      <Style Visible="True" Color="0, 32, 96">
        <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
        <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
        <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
      </Style>
      <Items>
        <TextBox Width="2.892in" Height="0.226in" Left="8.504in" Top="0.1in" Value="= Parameters.CompanyName.Value" Name="textBox56">
          <Style TextAlign="Center">
            <Font Size="12pt" Bold="True" />
            <BorderStyle Top="None" Bottom="None" Left="None" Right="None" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="2.889in" Height="0.226in" Left="8.507in" Top="0.326in" Value="= Parameters.CompanyAddress.Value" Name="textBox55">
          <Style TextAlign="Center">
            <Font Size="12pt" Bold="True" />
            <BorderStyle Top="None" Bottom="None" Left="None" Right="None" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="2.8cm" Height="0.6cm" Left="0.5cm" Top="0.656cm" Value="= &quot; صفحة &quot; + CStr(PageNumber) + &quot; من &quot;  + CStr(PageCount)" Name="textBox20">
          <Style VerticalAlign="Middle">
            <Font Size="8pt" />
            <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="1.8cm" Height="0.6cm" Left="3.3cm" Top="0.656cm" Value="= &quot;بواسطة :&quot;+Cstr(UserIdentity.Name)" Name="textBox23">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="8pt" />
            <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="12cm" Height="0.9cm" Left="8.4cm" Top="0.356cm" Value="= Parameters.ReportTitle.Value" Name="textBox47">
          <Style BackgroundColor="196, 189, 150" Color="23, 54, 93" TextAlign="Center" VerticalAlign="Middle">
            <Font Size="14pt" Bold="True" />
          </Style>
        </TextBox>
      </Items>
    </PageHeaderSection>
    <DetailSection PageBreak="None" Height="0.778cm" Name="detailSection1">
      <Style Visible="True" BackgroundColor="White">
        <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
        <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
        <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
      </Style>
      <Items>
        <TextBox Width="2.108cm" Height="6.72mm" Left="25.792cm" Top="0mm" Value="= IIf(&#xD;&#xA;        Fields.CtrQty &gt;= 0,&#xD;&#xA;        Fields.CtrQty,&quot;&quot;    &#xD;&#xA;    )&#xD;&#xA; &#xD;&#xA;" Format="{0:N2}" Multiline="False" Name="textBox27">
          <Style BackgroundColor="White" Color="Black" TextAlign="Center" VerticalAlign="Middle">
            <Font Size="12pt" />
            <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
            <Padding Top="0in" Bottom="0in" />
          </Style>
        </TextBox>
        <TextBox Width="2.4cm" Height="6.72mm" Left="19.4cm" Top="0mm" Value="= Fields.TrDscr" Format="{0:N2}" Multiline="False" Name="textBox3">
          <Style BackgroundColor="White" Color="Black" TextAlign="Center" VerticalAlign="Middle">
            <Font Size="12pt" />
            <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
            <Padding Top="0in" Bottom="0in" />
          </Style>
        </TextBox>
        <TextBox Width="2cm" Height="6.72mm" Left="23.792cm" Top="0mm" Value="= IIf(&#xD;&#xA;        Fields.CtrQty &gt;= 0,&#xD;&#xA;       0, Abs(Fields.CtrQty)    &#xD;&#xA;    )" Format="{0:N2}" Multiline="False" Name="textBox29">
          <Style BackgroundColor="White" Color="Black" TextAlign="Center" VerticalAlign="Middle">
            <Font Size="12pt" />
            <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
            <Padding Top="0in" Bottom="0in" />
          </Style>
        </TextBox>
        <TextBox Width="2cm" Height="6.72mm" Left="17.4cm" Top="0mm" Value="= Fields.TrNo" Format="{0}" Multiline="False" Name="textBox4">
          <Style BackgroundColor="White" Color="0, 112, 192" TextAlign="Center" VerticalAlign="Middle">
            <Font Size="12pt" />
            <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
            <Padding Top="0in" Bottom="0in" />
          </Style>
          <Action>
            <NavigateToUrlAction Url="= Parameters.Url.Value + &quot;az/Aztrh/CreateEdit/?loc=&quot; + Fields.Dloc + &quot;&amp;trTy=&quot; + Fields.TrTy + &quot;&amp;trNo=&quot; + Fields.TrNo + &quot;&amp;lnNo=&quot; + Fields.LnNo + &quot;&amp;editMode=1&amp;isNotNewAndFromIndex=true&quot;" />
          </Action>
        </TextBox>
        <TextBox Width="2.1cm" Height="6.72mm" Left="14cm" Top="0mm" Value="= Fields.TrPkprc" Format="{0:N2}" Multiline="False" Name="textBox8">
          <Style BackgroundColor="White" Color="Black" TextAlign="Center" VerticalAlign="Middle">
            <Font Size="12pt" />
            <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
            <Padding Top="0in" Bottom="0in" />
          </Style>
        </TextBox>
        <TextBox Width="2.3cm" Height="6.72mm" Left="11.7cm" Top="0mm" Value="= Fields.TrLoccst" Format="{0:N2}" Multiline="False" Name="textBox11">
          <Style BackgroundColor="White" Color="Black" TextAlign="Center" VerticalAlign="Middle">
            <Font Size="12pt" />
            <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
            <Padding Top="0in" Bottom="0in" />
          </Style>
        </TextBox>
        <TextBox Width="1.6cm" Height="6.72mm" Left="10.1cm" Top="0mm" Value="= Round(Abs(&#xA; Round(Fields.TrQty, 3) * Round(Fields.TrPkprc, 3)+ Sign(Fields.TrQty) * (Fields.TrStaxVl - Fields.TrDisc)&#xA;),&#xA;3&#xA;)" Format="{0:N2}" Multiline="False" Name="textBox14">
          <Style BackgroundColor="White" Color="Black" TextAlign="Center" VerticalAlign="Middle">
            <Font Size="12pt" />
            <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
            <Padding Top="0in" Bottom="0in" />
          </Style>
        </TextBox>
        <TextBox Width="2.2cm" Height="6.72mm" Left="7.9cm" Top="0mm" Value="= Fields.CtrCst * RunningValue(scope, Sum(Fields.TrQty))" Format="{0:N2}" Multiline="False" Name="textBox16">
          <Style BackgroundColor="White" Color="Black" TextAlign="Center" VerticalAlign="Middle">
            <Font Size="12pt" />
            <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
            <Padding Top="0in" Bottom="0in" />
          </Style>
        </TextBox>
        <TextBox Width="1.3cm" Height="6.72mm" Left="16.1cm" Top="0mm" Value="= Fields.LnNo" Format="{0}" Multiline="False" Name="textBox6">
          <Style BackgroundColor="White" Color="Black" TextAlign="Center" VerticalAlign="Middle">
            <Font Size="12pt" />
            <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
            <Padding Top="0in" Bottom="0in" />
          </Style>
        </TextBox>
        <TextBox Width="3.4cm" Height="6.72mm" Left="4.5cm" Top="0mm" Value="= Fields.AccNm" Format="{0:N2}" Multiline="False" Name="textBox40">
          <Style BackgroundColor="White" Color="Black" TextAlign="Center" VerticalAlign="Middle">
            <Font Size="12pt" />
            <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
            <Padding Top="0in" Bottom="0in" />
