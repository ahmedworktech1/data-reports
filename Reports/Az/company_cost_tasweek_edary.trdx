  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="glx2024" SelectCommand="select  'تكاليف الإنتاج' as s,&#xD;&#xA;(CAST(ROUND(sum( case when acc_no like '4[6]12%'   then db_vl-cr_vl else 0 end)/1000, 0) AS BIGINT))as s1,&#xD;&#xA;(CAST(ROUND(sum( case when acc_no like '4[6]11%'   then db_vl-cr_vl else 0 end)/1000, 0) AS BIGINT))as s2,&#xD;&#xA;(CAST(ROUND(sum( case when acc_no like '4[6]3%'   then db_vl-cr_vl else 0 end)/1000, 0) AS BIGINT))as s3,&#xD;&#xA;(CAST(ROUND(sum( case when acc_no like '4[6]2%'   then db_vl-cr_vl else 0 end)/1000, 0) AS BIGINT))as s4,&#xD;&#xA;&#xD;&#xA;((CAST(ROUND(sum( case when acc_no like '4[6]12%'   then db_vl-cr_vl else 0 end)/1000, 0) AS BIGINT))+&#xD;&#xA;(CAST(ROUND(sum( case when acc_no like '4[6]11%'   then db_vl-cr_vl else 0 end)/1000, 0) AS BIGINT))+&#xD;&#xA;(CAST(ROUND(sum( case when acc_no like '4[6]3%'   then db_vl-cr_vl else 0 end)/1000, 0) AS BIGINT))+&#xD;&#xA;(CAST(ROUND(sum( case when acc_no like '4[6]2%'   then db_vl-cr_vl else 0 end)/1000, 0) AS BIGINT))) as tot,&#xD;&#xA;(SELECT val4 FROM CST_VAR WHERE ANALS_TYP = 16 and sno = '35') AS 'numb' &#xD;&#xA;from gljrnld  WHERE  (acc_no like '4[6]11%' or acc_no like '4[6]12%' or acc_no like '4[6]3%' or acc_no like '4[6]2%' ) &#xD;&#xA;and (1=1)&#xD;&#xA;union all&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;select  'التكاليف التسويقية' as s,&#xD;&#xA;(CAST(ROUND(sum( case when acc_no like '4[7]12%'   then db_vl-cr_vl else 0 end)/1000, 0) AS BIGINT))as s1,&#xD;&#xA;(CAST(ROUND(sum( case when acc_no like '4[7]11%'   then db_vl-cr_vl else 0 end)/1000, 0) AS BIGINT))as s2,&#xD;&#xA;(CAST(ROUND(sum( case when acc_no like '4[7]3%'   then db_vl-cr_vl else 0 end)/1000, 0) AS BIGINT))as s3,&#xD;&#xA;(CAST(ROUND(sum( case when acc_no like '4[7]2%'   then db_vl-cr_vl else 0 end)/1000, 0) AS BIGINT))as s4,&#xD;&#xA;&#xD;&#xA;((CAST(ROUND(sum( case when acc_no like '4[7]12%'   then db_vl-cr_vl else 0 end)/1000, 0) AS BIGINT))+&#xD;&#xA;(CAST(ROUND(sum( case when acc_no like '4[7]11%'   then db_vl-cr_vl else 0 end)/1000, 0) AS BIGINT))+&#xD;&#xA;(CAST(ROUND(sum( case when acc_no like '4[7]3%'   then db_vl-cr_vl else 0 end)/1000, 0) AS BIGINT))+&#xD;&#xA;(CAST(ROUND(sum( case when acc_no like '4[7]2%'   then db_vl-cr_vl else 0 end)/1000, 0) AS BIGINT)))as tot,&#xD;&#xA;(SELECT val4 FROM CST_VAR WHERE ANALS_TYP = 16 and sno = '36') AS 'numb' &#xD;&#xA;from gljrnld  WHERE  (acc_no like '4[7]11%' or acc_no like '4[7]12%' or acc_no like '4[7]3%' or acc_no like '4[7]2%' ) and (1=1)&#xD;&#xA;&#xD;&#xA;union all&#xD;&#xA; &#xD;&#xA;select  'التكاليف الإدارية' as s,&#xD;&#xA;(CAST(ROUND(sum( case when acc_no like '4[8]12%'   then db_vl-cr_vl else 0 end)/1000, 0) AS BIGINT))as s1,&#xD;&#xA;(CAST(ROUND(sum( case when acc_no like '4[8]11%'   then db_vl-cr_vl else 0 end)/1000, 0) AS BIGINT))as s2,&#xD;&#xA;(CAST(ROUND(sum( case when acc_no like '4[8]3%'   then db_vl-cr_vl else 0 end)/1000, 0) AS BIGINT))as s3,&#xD;&#xA;(CAST(ROUND(sum( case when acc_no like '4[8]2%'   then db_vl-cr_vl else 0 end)/1000, 0) AS BIGINT))as s4,&#xD;&#xA;&#xD;&#xA;((CAST(ROUND(sum( case when acc_no like '4[8]12%'   then db_vl-cr_vl else 0 end)/1000, 0) AS BIGINT))+&#xD;&#xA;(CAST(ROUND(sum( case when acc_no like '4[8]11%'   then db_vl-cr_vl else 0 end)/1000, 0) AS BIGINT))+&#xD;&#xA;(CAST(ROUND(sum( case when acc_no like '4[8]3%'   then db_vl-cr_vl else 0 end)/1000, 0) AS BIGINT))+&#xD;&#xA;(CAST(ROUND(sum( case when acc_no like '4[8]2%'   then db_vl-cr_vl else 0 end)/1000, 0) AS BIGINT)))as tot,&#xD;&#xA;(SELECT val4 FROM CST_VAR WHERE ANALS_TYP = 16 and sno = '37') AS 'numb' &#xD;&#xA;from gljrnld  WHERE  (acc_no like '4[8]11%' or acc_no like '4[8]12%' or acc_no like '4[8]3%' or acc_no like '4[8]2%' ) and (1=1)&#xD;&#xA;" Name="sqlDataSource1" />
