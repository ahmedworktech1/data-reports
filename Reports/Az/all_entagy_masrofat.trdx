  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="glx2024" SelectCommand="SELECT 'تيار' AS s,&#xA;    CAST(ROUND(SUM(CASE &#xA;        WHEN acc_no LIKE '4[6]2%' &#xA;             AND SUBSTRING(cst_cd, 6, 7) = '61' &#xA;             AND cst_cd NOT LIKE '11%' &#xA;        THEN db_vl - cr_vl &#xA;        ELSE 0 END) / 1000.0, 0) AS BIGINT) AS tot,&#xA;    CAST(ROUND(SUM(CASE &#xA;        WHEN (acc_no LIKE '4[6]211%') &#xA;             AND SUBSTRING(cst_cd, 6, 7) = '61' &#xA;             AND cst_cd NOT LIKE '11%' &#xA;        THEN db_vl - cr_vl &#xA;        ELSE 0 END) / 1000.0, 0) AS BIGINT) AS s1,&#xA;    CAST(ROUND(SUM(CASE &#xA;        WHEN (acc_no LIKE '4[6]215%') &#xA;             AND SUBSTRING(cst_cd, 6, 7) = '61' &#xA;             AND cst_cd NOT LIKE '11%' &#xA;        THEN db_vl - cr_vl &#xA;        ELSE 0 END) / 1000.0, 0) AS BIGINT) AS s2,&#xA;    CAST(ROUND(SUM(CASE &#xA;        WHEN acc_no LIKE '4[6]216%' &#xA;             AND SUBSTRING(cst_cd, 6, 7) = '61' &#xA;             AND cst_cd NOT LIKE '11%' &#xA;        THEN db_vl - cr_vl &#xA;        ELSE 0 END) / 1000.0, 0) AS BIGINT) AS s3,&#xA;    CAST(ROUND(SUM(CASE &#xA;        WHEN (acc_no LIKE '4[6]218%' or acc_no LIKE '4[6]217%' or acc_no LIKE '4[6]214%' or acc_no LIKE '4[6]213%' or acc_no LIKE '4[6]212%'  ) &#xA;             AND SUBSTRING(cst_cd, 6, 7) = '61' &#xA;             AND cst_cd NOT LIKE '11%' &#xA;        THEN db_vl - cr_vl &#xA;        ELSE 0 END) / 1000.0, 0) AS BIGINT) AS s4,&#xA;    CAST(ROUND(SUM(CASE &#xA;        WHEN (acc_no LIKE '4[6]218%' or acc_no LIKE '4[6]217%' or acc_no LIKE '4[6]216%'  or acc_no LIKE '4[6]215%'  or acc_no LIKE '4[6]214%' or acc_no LIKE '4[6]213%' or acc_no LIKE '4[6]212%' or acc_no LIKE '4[6]211%' ) &#xA;             AND SUBSTRING(cst_cd, 6, 7) = '61' &#xA;             AND cst_cd NOT LIKE '11%' &#xA;        THEN db_vl - cr_vl &#xA;        ELSE 0 END) / 1000.0, 0) AS BIGINT) AS tot1,&#xA;&#x9;&#x9;  CAST(ROUND(SUM(CASE &#xA;        WHEN (acc_no LIKE '4[6]22%') &#xA;             AND SUBSTRING(cst_cd, 6, 7) = '61' &#xA;             AND cst_cd NOT LIKE '11%' &#xA;        THEN db_vl - cr_vl &#xA;        ELSE 0 END) / 1000.0, 0) AS BIGINT) AS s6,&#xA;&#x9;&#x9;&#x9;&#x9;  CAST(ROUND(SUM(CASE &#xA;        WHEN (acc_no LIKE '4[6]23%') &#xA;             AND SUBSTRING(cst_cd, 6, 7) = '61' &#xA;             AND cst_cd NOT LIKE '11%' &#xA;        THEN db_vl - cr_vl &#xA;        ELSE 0 END) / 1000.0, 0) AS BIGINT) AS s7,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  CAST(ROUND(SUM(CASE &#xA;        WHEN (acc_no LIKE '4[6]24%') &#xA;             AND SUBSTRING(cst_cd, 6, 7) = '61' &#xA;             AND cst_cd NOT LIKE '11%' &#xA;        THEN db_vl - cr_vl &#xA;        ELSE 0 END) / 1000.0, 0) AS BIGINT) AS s8,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  CAST(ROUND(SUM(CASE &#xA;        WHEN (acc_no LIKE '4[6]25%') &#xA;             AND SUBSTRING(cst_cd, 6, 7) = '61' &#xA;             AND cst_cd NOT LIKE '11%' &#xA;        THEN db_vl - cr_vl &#xA;        ELSE 0 END) / 1000.0, 0) AS BIGINT) AS s9,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  CAST(ROUND(SUM(CASE &#xA;        WHEN (acc_no LIKE '4[6]26%') &#xA;             AND SUBSTRING(cst_cd, 6, 7) = '61' &#xA;             AND cst_cd NOT LIKE '11%' &#xA;        THEN db_vl - cr_vl &#xA;        ELSE 0 END) / 1000.0, 0) AS BIGINT) AS s10&#xA;&#xA;&#xA;FROM gljrnld  &#xA;WHERE (acc_no LIKE '4[6]2%') &#xA;      AND SUBSTRING(cst_cd, 6, 7) = '61' &#xA;      AND cst_cd NOT LIKE '11%'  &#xA;      AND (1=1)&#xA;&#xA;UNION ALL&#xA;SELECT 'مقايسات' AS s,&#xA;    CAST(ROUND(SUM(CASE &#xA;        WHEN acc_no LIKE '4[6]2%' &#xA;             AND SUBSTRING(cst_cd, 6, 7) IN ('62', '63')&#xA;             AND cst_cd NOT LIKE '11%' &#xA;        THEN db_vl - cr_vl &#xA;        ELSE 0 END) / 1000.0, 0) AS BIGINT) AS tot,&#xA;    CAST(ROUND(SUM(CASE &#xA;        WHEN (acc_no LIKE '4[6]211%') &#xA;             AND SUBSTRING(cst_cd, 6, 7) IN ('62', '63')&#xA;             AND cst_cd NOT LIKE '11%' &#xA;        THEN db_vl - cr_vl &#xA;        ELSE 0 END) / 1000.0, 0) AS BIGINT) AS s1,&#xA;    CAST(ROUND(SUM(CASE &#xA;        WHEN (acc_no LIKE '4[6]215%') &#xA;             AND SUBSTRING(cst_cd, 6, 7) IN ('62', '63')&#xA;             AND cst_cd NOT LIKE '11%' &#xA;        THEN db_vl - cr_vl &#xA;        ELSE 0 END) / 1000.0, 0) AS BIGINT) AS s2,&#xA;    CAST(ROUND(SUM(CASE &#xA;        WHEN acc_no LIKE '4[6]216%' &#xA;             AND SUBSTRING(cst_cd, 6, 7) IN ('62', '63')&#xA;             AND cst_cd NOT LIKE '11%' &#xA;        THEN db_vl - cr_vl &#xA;        ELSE 0 END) / 1000.0, 0) AS BIGINT) AS s3,&#xA;    CAST(ROUND(SUM(CASE &#xA;        WHEN (acc_no LIKE '4[6]218%' or acc_no LIKE '4[6]217%' or acc_no LIKE '4[6]214%' or acc_no LIKE '4[6]213%' or acc_no LIKE '4[6]212%'  ) &#xA;             AND SUBSTRING(cst_cd, 6, 7) IN ('62', '63')&#xA;             AND cst_cd NOT LIKE '11%' &#xA;        THEN db_vl - cr_vl &#xA;        ELSE 0 END) / 1000.0, 0) AS BIGINT) AS s4,&#xA;&#xA;    CAST(ROUND(SUM(CASE &#xA;        WHEN (acc_no LIKE '4[6]218%' or acc_no LIKE '4[6]217%' or acc_no LIKE '4[6]216%'  or acc_no LIKE '4[6]215%'  or acc_no LIKE '4[6]214%' or acc_no LIKE '4[6]213%' or acc_no LIKE '4[6]212%' or acc_no LIKE '4[6]211%' ) &#xA;             AND SUBSTRING(cst_cd, 6, 7) IN ('62', '63')&#xA;             AND cst_cd NOT LIKE '11%' &#xA;        THEN db_vl - cr_vl &#xA;        ELSE 0 END) / 1000.0, 0) AS BIGINT) AS tot1,&#xA;&#x9;&#x9;  CAST(ROUND(SUM(CASE &#xA;        WHEN (acc_no LIKE '4[6]22%') &#xA;             AND SUBSTRING(cst_cd, 6, 7) IN ('62', '63')&#xA;             AND cst_cd NOT LIKE '11%' &#xA;        THEN db_vl - cr_vl &#xA;        ELSE 0 END) / 1000.0, 0) AS BIGINT) AS s6,&#xA;&#x9;&#x9;&#x9;&#x9;  CAST(ROUND(SUM(CASE &#xA;        WHEN (acc_no LIKE '4[6]23%') &#xA;             AND SUBSTRING(cst_cd, 6, 7) IN ('62', '63')&#xA;             AND cst_cd NOT LIKE '11%' &#xA;        THEN db_vl - cr_vl &#xA;        ELSE 0 END) / 1000.0, 0) AS BIGINT) AS s7,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  CAST(ROUND(SUM(CASE &#xA;        WHEN (acc_no LIKE '4[6]24%') &#xA;             AND SUBSTRING(cst_cd, 6, 7) IN ('62', '63')&#xA;             AND cst_cd NOT LIKE '11%' &#xA;        THEN db_vl - cr_vl &#xA;        ELSE 0 END) / 1000.0, 0) AS BIGINT) AS s8,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  CAST(ROUND(SUM(CASE &#xA;        WHEN (acc_no LIKE '4[6]25%') &#xA;             AND SUBSTRING(cst_cd, 6, 7) IN ('62', '63')&#xA;             AND cst_cd NOT LIKE '11%' &#xA;        THEN db_vl - cr_vl &#xA;        ELSE 0 END) / 1000.0, 0) AS BIGINT) AS s9,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  CAST(ROUND(SUM(CASE &#xA;        WHEN (acc_no LIKE '4[6]26%') &#xA;             AND SUBSTRING(cst_cd, 6, 7) IN ('62', '63')&#xA;             AND cst_cd NOT LIKE '11%' &#xA;        THEN db_vl - cr_vl &#xA;        ELSE 0 END) / 1000.0, 0) AS BIGINT) AS s10&#xA;&#xA;&#xA;FROM gljrnld  &#xA;WHERE (acc_no LIKE '4[6]2%') &#xA;      AND SUBSTRING(cst_cd, 6, 7) IN ('62', '63')&#xA;      AND cst_cd NOT LIKE '11%'  &#xA;      AND (1=1)&#xA;&#xA;UNION ALL&#xA;SELECT 'محطات التوليد' AS s,&#xA;CAST(ROUND(SUM(CASE &#xA;WHEN acc_no LIKE '4[6]2%' &#xA;&#xA;   AND CST_CD LIKE '11%'&#xA;THEN db_vl - cr_vl &#xA;ELSE 0 END) / 1000.0, 0) AS BIGINT) AS tot,&#xA;CAST(ROUND(SUM(CASE &#xA;WHEN (acc_no LIKE '4[6]211%') &#xA;&#xA;   AND CST_CD LIKE '11%'&#xA;THEN db_vl - cr_vl &#xA;ELSE 0 END) / 1000.0, 0) AS BIGINT) AS s1,&#xA;CAST(ROUND(SUM(CASE &#xA;WHEN (acc_no LIKE '4[6]215%') &#xA;&#xA;   AND CST_CD LIKE '11%'&#xA;THEN db_vl - cr_vl &#xA;ELSE 0 END) / 1000.0, 0) AS BIGINT) AS s2,&#xA;CAST(ROUND(SUM(CASE &#xA;WHEN acc_no LIKE '4[6]216%' &#xA;&#xA;   AND CST_CD LIKE '11%'&#xA;THEN db_vl - cr_vl &#xA;ELSE 0 END) / 1000.0, 0) AS BIGINT) AS s3,&#xA;CAST(ROUND(SUM(CASE &#xA;WHEN (acc_no LIKE '4[6]218%' or acc_no LIKE '4[6]217%' or acc_no LIKE '4[6]214%' or acc_no LIKE '4[6]213%' or acc_no LIKE '4[6]212%'  ) &#xA;&#xA;   AND CST_CD LIKE '11%'&#xA;THEN db_vl - cr_vl &#xA;ELSE 0 END) / 1000.0, 0) AS BIGINT) AS s4,&#xA;&#xA;CAST(ROUND(SUM(CASE &#xA;WHEN (acc_no LIKE '4[6]218%' or acc_no LIKE '4[6]217%' or acc_no LIKE '4[6]216%'  or acc_no LIKE '4[6]215%'  or acc_no LIKE '4[6]214%' or acc_no LIKE '4[6]213%' or acc_no LIKE '4[6]212%' or acc_no LIKE '4[6]211%' ) &#xA;&#xA;   AND CST_CD LIKE '11%'&#xA;THEN db_vl - cr_vl &#xA;ELSE 0 END) / 1000.0, 0) AS BIGINT) AS tot1,&#xA;&#x9;&#x9;  CAST(ROUND(SUM(CASE &#xA;WHEN (acc_no LIKE '4[6]22%') &#xA;&#xA;   AND CST_CD LIKE '11%'&#xA;THEN db_vl - cr_vl &#xA;ELSE 0 END) / 1000.0, 0) AS BIGINT) AS s6,&#xA;&#x9;&#x9;&#x9;&#x9;  CAST(ROUND(SUM(CASE &#xA;WHEN (acc_no LIKE '4[6]23%') &#xA;&#xA;   AND CST_CD LIKE '11%'&#xA;THEN db_vl - cr_vl &#xA;ELSE 0 END) / 1000.0, 0) AS BIGINT) AS s7,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  CAST(ROUND(SUM(CASE &#xA;WHEN (acc_no LIKE '4[6]24%') &#xA;&#xA;   AND CST_CD LIKE '11%'&#xA;THEN db_vl - cr_vl &#xA;ELSE 0 END) / 1000.0, 0) AS BIGINT) AS s8,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  CAST(ROUND(SUM(CASE &#xA;WHEN (acc_no LIKE '4[6]25%') &#xA;&#xA;   AND CST_CD LIKE '11%'&#xA;THEN db_vl - cr_vl &#xA;ELSE 0 END) / 1000.0, 0) AS BIGINT) AS s9,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  CAST(ROUND(SUM(CASE &#xA;WHEN (acc_no LIKE '4[6]26%') &#xA;&#xA;   AND CST_CD LIKE '11%'&#xA;THEN db_vl - cr_vl &#xA;ELSE 0 END) / 1000.0, 0) AS BIGINT) AS s10&#xA;&#xA;&#xA;FROM gljrnld  &#xA;WHERE (acc_no LIKE '4[6]2%') &#xA;&#xA;AND CST_CD LIKE '11%' &#xA;  AND (1=1)&#xA;" Name="sqlDataSource1" />
