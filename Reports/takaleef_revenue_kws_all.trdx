,'81')  and  SUM_CD IN ('11') and substring(cst_Cd,6,7) in ('61','71','81')  and  SUM_CD IN ('11') AND gljrnld.cst_Cd LIKE '05%' THEN db_vl - cr_vl ELSE 0 END) &#xD;&#xA;            AS NUMERIC&#xD;&#xA;        ) &#xD;&#xA;        / &#xD;&#xA;        NULLIF(&#xD;&#xA;            SUM(CASE WHEN (acc_no LIKE '5[6-8]1111101%' OR acc_no LIKE '5[6-8]1111102%') and substring(cst_Cd,6,7) in ('61','71','81')  and  SUM_CD IN ('11') AND gljrnld.cst_Cd LIKE '05%' THEN VAL1 ELSE 0 END), &#xD;&#xA;            0&#xD;&#xA;        ) &#xD;&#xA;        * 100, &#xD;&#xA;    3)*-1&#xD;&#xA;&#xD;&#xA;&#x9;-&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;    ROUND(&#xD;&#xA;        CAST(&#xD;&#xA;            SUM(CASE WHEN (acc_no like '4[6-8]1%' or acc_no like '4[6-8]2%' or acc_no like '4[6-8]3%') and substring(cst_Cd,6,7) in ('61','71','81')  and  SUM_CD IN ('11') AND gljrnld.cst_Cd LIKE '05%' THEN db_vl - cr_vl ELSE 0 END) &#xD;&#xA;            AS NUMERIC&#xD;&#xA;        ) &#xD;&#xA;        / &#xD;&#xA;        NULLIF(&#xD;&#xA;            SUM(CASE WHEN (acc_no LIKE '5[6-8]1111101%' OR acc_no LIKE '5[6-8]1111102%') and substring(cst_Cd,6,7) in ('61','71','81')  and  SUM_CD IN ('11') AND gljrnld.cst_Cd LIKE '05%' THEN VAL1 ELSE 0 END), &#xD;&#xA;            0&#xD;&#xA;        ) &#xD;&#xA;        * 100, &#xD;&#xA;    3)) AS s4,&#xD;&#xA;&#xD;&#xA;&#x9;(ROUND(&#xD;&#xA;        CAST(&#xD;&#xA;            SUM(CASE WHEN (acc_no LIKE '5[6-8]1111101%' OR acc_no LIKE '5[6-8]1111102%') and substring(cst_Cd,6,7) in ('61','71','81')  and  SUM_CD IN ('11') and substring(cst_Cd,6,7) in ('61','71','81')  and  SUM_CD IN ('11') AND gljrnld.cst_Cd LIKE '07%' THEN db_vl - cr_vl ELSE 0 END) &#xD;&#xA;            AS NUMERIC&#xD;&#xA;        ) &#xD;&#xA;        / &#xD;&#xA;        NULLIF(&#xD;&#xA;            SUM(CASE WHEN (acc_no LIKE '5[6-8]1111101%' OR acc_no LIKE '5[6-8]1111102%') and substring(cst_Cd,6,7) in ('61','71','81')  and  SUM_CD IN ('11') AND gljrnld.cst_Cd LIKE '07%' THEN VAL1 ELSE 0 END), &#xD;&#xA;            0&#xD;&#xA;        ) &#xD;&#xA;        * 100, &#xD;&#xA;    3)*-1&#xD;&#xA;&#x9;-&#xD;&#xA;&#xD;&#xA;    ROUND(&#xD;&#xA;        CAST(&#xD;&#xA;            SUM(CASE WHEN (acc_no like '4[6-8]1%' or acc_no like '4[6-8]2%' or acc_no like '4[6-8]3%') and substring(cst_Cd,6,7) in ('61','71','81')  and  SUM_CD IN ('11') AND gljrnld.cst_Cd LIKE '07%' THEN db_vl - cr_vl ELSE 0 END) &#xD;&#xA;            AS NUMERIC&#xD;&#xA;        ) &#xD;&#xA;        / &#xD;&#xA;        NULLIF(&#xD;&#xA;            SUM(CASE WHEN (acc_no LIKE '5[6-8]1111101%' OR acc_no LIKE '5[6-8]1111102%') and substring(cst_Cd,6,7) in ('61','71','81')  and  SUM_CD IN ('11') AND gljrnld.cst_Cd LIKE '07%' THEN VAL1 ELSE 0 END), &#xD;&#xA;            0&#xD;&#xA;        ) &#xD;&#xA;        * 100, &#xD;&#xA;    3)) AS s5,&#xD;&#xA;&#xD;&#xA;  (ROUND(&#xD;&#xA;        CAST(&#xD;&#xA;            SUM(CASE WHEN (acc_no LIKE '5[6-8]1111101%' OR acc_no LIKE '5[6-8]1111102%') and substring(cst_Cd,6,7) in ('61','71','81')  and  SUM_CD IN ('11') and substring(cst_Cd,6,7) in ('61','71','81')  and  SUM_CD IN ('11') AND gljrnld.cst_Cd LIKE '09%' THEN db_vl - cr_vl ELSE 0 END) &#xD;&#xA;            AS NUMERIC&#xD;&#xA;        ) &#xD;&#xA;        / &#xD;&#xA;        NULLIF(&#xD;&#xA;            SUM(CASE WHEN (acc_no LIKE '5[6-8]1111101%' OR acc_no LIKE '5[6-8]1111102%') and substring(cst_Cd,6,7) in ('61','71','81')  and  SUM_CD IN ('11') AND gljrnld.cst_Cd LIKE '09%' THEN VAL1 ELSE 0 END), &#xD;&#xA;            0&#xD;&#xA;        ) &#xD;&#xA;        * 100, &#xD;&#xA;    3)*-1&#xD;&#xA;&#x9;-&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;    ROUND(&#xD;&#xA;        CAST(&#xD;&#xA;            SUM(CASE WHEN (acc_no like '4[6-8]1%' or acc_no like '4[6-8]2%' or acc_no like '4[6-8]3%') and substring(cst_Cd,6,7) in ('61','71','81')  and  SUM_CD IN ('11') AND gljrnld.cst_Cd LIKE '09%' THEN db_vl - cr_vl ELSE 0 END) &#xD;&#xA;            AS NUMERIC&#xD;&#xA;        ) &#xD;&#xA;        / &#xD;&#xA;        NULLIF(&#xD;&#xA;            SUM(CASE WHEN (acc_no LIKE '5[6-8]1111101%' OR acc_no LIKE '5[6-8]1111102%') and substring(cst_Cd,6,7) in ('61','71','81')  and  SUM_CD IN ('11') AND gljrnld.cst_Cd LIKE '09%' THEN VAL1 ELSE 0 END), &#xD;&#xA;            0&#xD;&#xA;        ) &#xD;&#xA;        * 100, &#xD;&#xA;    3)) AS s6,&#xD;&#xA;    (ROUND(&#xD;&#xA;        CAST(&#xD;&#xA;            SUM(CASE WHEN (acc_no LIKE '5[6-8]1111101%' OR acc_no LIKE '5[6-8]1111102%') and substring(cst_Cd,6,7) in ('61','71','81')  and  SUM_CD IN ('11') and substring(cst_Cd,6,7) in ('61','71','81')  and  SUM_CD IN ('11') AND  gljrnld.cst_Cd LIKE '06%' OR gljrnld.cst_cd like '13%' THEN db_vl - cr_vl ELSE 0 END) &#xD;&#xA;            AS NUMERIC&#xD;&#xA;        ) &#xD;&#xA;        / &#xD;&#xA;        NULLIF(&#xD;&#xA;            SUM(CASE WHEN (acc_no LIKE '5[6-8]1111101%' OR acc_no LIKE '5[6-8]1111102%') and substring(cst_Cd,6,7) in ('61','71','81')  and  SUM_CD IN ('11') AND  gljrnld.cst_Cd LIKE '06%' OR gljrnld.cst_cd like '13%' THEN VAL1 ELSE 0 END), &#xD;&#xA;            0&#xD;&#xA;        ) &#xD;&#xA;        * 100, &#xD;&#xA;    3)*-1&#xD;&#xA;&#x9;-&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;    ROUND(&#xD;&#xA;        CAST(&#xD;&#xA;            SUM(CASE WHEN (acc_no like '4[6-8]1%' or acc_no like '4[6-8]2%' or acc_no like '4[6-8]3%') and substring(cst_Cd,6,7) in ('61','71','81')  and  SUM_CD IN ('11') AND  gljrnld.cst_Cd LIKE '06%' OR gljrnld.cst_cd like '13%' THEN db_vl - cr_vl ELSE 0 END) &#xD;&#xA;            AS NUMERIC&#xD;&#xA;        ) &#xD;&#xA;        / &#xD;&#xA;        NULLIF(&#xD;&#xA;            SUM(CASE WHEN (acc_no LIKE '5[6-8]1111101%' OR acc_no LIKE '5[6-8]1111102%') and substring(cst_Cd,6,7) in ('61','71','81')  and  SUM_CD IN ('11') AND  gljrnld.cst_Cd LIKE '06%' OR gljrnld.cst_cd like '13%' THEN VAL1 ELSE 0 END), &#xD;&#xA;            0&#xD;&#xA;        ) &#xD;&#xA;        * 100, &#xD;&#xA;    3)) AS s7,&#xD;&#xA;&#xD;&#xA;(ROUND(&#xD;&#xA;        CAST(&#xD;&#xA;            SUM(CASE WHEN (acc_no LIKE '5[6-8]1111101%' OR acc_no LIKE '5[6-8]1111102%') and substring(cst_Cd,6,7) in ('61','71','81')  and  SUM_CD IN ('11') and substring(cst_Cd,6,7) in ('61','71','81')  and  SUM_CD IN ('11') AND (gljrnld.cst_Cd LIKE '02%' OR gljrnld.cst_Cd LIKE '03%' OR gljrnld.cst_Cd LIKE '04%'&#xD;&#xA;                        OR gljrnld.cst_Cd LIKE '05%' OR  gljrnld.cst_Cd LIKE '06%' OR gljrnld.cst_cd like '13%' OR gljrnld.cst_Cd LIKE '07%' OR gljrnld.cst_Cd LIKE '09%' OR gljrnld.cst_Cd LIKE '11%' OR gljrnld.cst_Cd LIKE '12%')&#xD;&#xA;                 THEN db_vl - cr_vl ELSE 0 END) &#xD;&#xA;            AS NUMERIC&#xD;&#xA;        ) &#xD;&#xA;        / &#xD;&#xA;        NULLIF(&#xD;&#xA;            SUM(CASE WHEN (acc_no LIKE '5[6-8]1111101%' OR acc_no LIKE '5[6-8]1111102%') and substring(cst_Cd,6,7) in ('61','71','81')  and  SUM_CD IN ('11') AND (gljrnld.cst_Cd LIKE '02%' OR gljrnld.cst_Cd LIKE '03%' OR gljrnld.cst_Cd LIKE '04%'&#xD;&#xA;                        OR gljrnld.cst_Cd LIKE '05%' OR  gljrnld.cst_Cd LIKE '06%' OR gljrnld.cst_cd like '13%' OR gljrnld.cst_Cd LIKE '07%' OR gljrnld.cst_Cd LIKE '09%' OR gljrnld.cst_Cd LIKE '11%' OR gljrnld.cst_Cd LIKE '12%') THEN VAL1 ELSE 0 END), &#xD;&#xA;            0&#xD;&#xA;        ) &#xD;&#xA;        * 100, &#xD;&#xA;    3)*-1 &#xD;&#xA;&#x9;-&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;    ROUND(&#xD;&#xA;        CAST(&#xD;&#xA;            SUM(CASE WHEN (acc_no like '4[6-8]1%' or acc_no like '4[6-8]2%' or acc_no like '4[6-8]3%') and substring(cst_Cd,6,7) in ('61','71','81')  and  SUM_CD IN ('11') AND (gljrnld.cst_Cd LIKE '02%' OR gljrnld.cst_Cd LIKE '03%' OR gljrnld.cst_Cd LIKE '04%'&#xD;&#xA;                        OR gljrnld.cst_Cd LIKE '05%' OR  gljrnld.cst_Cd LIKE '06%' OR gljrnld.cst_cd like '13%' OR gljrnld.cst_Cd LIKE '07%' OR gljrnld.cst_Cd LIKE '09%' OR gljrnld.cst_Cd LIKE '11%' OR gljrnld.cst_Cd LIKE '12%')&#xD;&#xA;                 THEN db_vl - cr_vl ELSE 0 END) &#xD;&#xA;            AS NUMERIC&#xD;&#xA;        ) &#xD;&#xA;        / &#xD;&#xA;        NULLIF(&#xD;&#xA;            SUM(CASE WHEN (acc_no LIKE '5[6-8]1111101%' OR acc_no LIKE '5[6-8]1111102%') and substring(cst_Cd,6,7) in ('61','71','81')  and  SUM_CD IN ('11') AND (gljrnld.cst_Cd LIKE '02%' OR gljrnld.cst_Cd LIKE '03%' OR gljrnld.cst_Cd LIKE '04%'&#xD;&#xA;                        OR gljrnld.cst_Cd LIKE '05%' OR  gljrnld.cst_Cd LIKE '06%' OR gljrnld.cst_cd like '13%' OR gljrnld.cst_Cd LIKE '07%' OR gljrnld.cst_Cd LIKE '09%' OR gljrnld.cst_Cd LIKE '11%' OR gljrnld.cst_Cd LIKE '12%') THEN VAL1 ELSE 0 END), &#xD;&#xA;            0&#xD;&#xA;        ) &#xD;&#xA;        * 100, &#xD;&#xA;    3)) AS tot&#xD;&#xA;&#xD;&#xA;FROM gljrnld  &#xD;&#xA;WHERE ( acc_no like '4[6-8]1%' or acc_no like '4[6-8]2%' or acc_no like '4[6-8]3%' or acc_no LIKE '5[6-8]1111101%' OR acc_no LIKE '5[6-8]1111102%') and substring(cst_Cd,6,7) in ('61','71','81')  and  SUM_CD IN ('11')&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;" Name="sqlDataSource1" />
