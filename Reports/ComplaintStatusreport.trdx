    <DetailSection Height="0.6cm" Name="detailSection1">
      <Items>
        <TextBox Width="1.6cm" Height="0.6cm" Left="7.101cm" Top="0cm" Value="= Fields.OrganizationId" Culture="en" Name="textBox18">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Name="Times New Roman" />
            <BorderStyle Top="Dotted" Bottom="Dotted" Left="Dotted" Right="Dotted" />
            <BorderColor Top="217, 217, 217" Bottom="217, 217, 217" Left="217, 217, 217" Right="217, 217, 217" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="3.301cm" Height="0.6cm" Left="10.498cm" Top="0cm" Value="= Fields.ComplaintContent" Culture="en" Name="textBox21">
          <Style TextAlign="Right" VerticalAlign="Middle">
            <Font Name="Times New Roman" Size="10pt" />
            <BorderStyle Top="Dotted" Bottom="Dotted" Left="Dotted" Right="Dotted" />
            <BorderColor Top="217, 217, 217" Bottom="217, 217, 217" Left="217, 217, 217" Right="217, 217, 217" />
