        <TextBox Width="3cm" Height="0.6cm" Left="13.8cm" Top="0cm" Value="= Fields.Beneficiary" Culture="en" Name="textBox12">
          <Style Visible="False" TextAlign="Right" VerticalAlign="Middle">
            <Font Name="Times New Roman" Size="10pt" />
            <BorderStyle Top="Dotted" Bottom="Dotted" Left="Dotted" Right="Dotted" />
            <BorderColor Top="217, 217, 217" Bottom="217, 217, 217" Left="217, 217, 217" Right="217, 217, 217" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="1.7cm" Height="0.6cm" Left="16.8cm" Top="0cm" Value="= Fields.RegistrationDate" Format="{0}" Culture="en" Name="textBox16">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Name="Times New Roman" Size="10pt" />
            <BorderStyle Top="Dotted" Bottom="Dotted" Left="Dotted" Right="Dotted" />
            <BorderColor Top="217, 217, 217" Bottom="217, 217, 217" Left="217, 217, 217" Right="217, 217, 217" />
