<?xml version="1.0" encoding="utf-8"?>
<Report Width="21.2cm" Name="ComplaintStatusreport" ShowSnapGrid="True" xmlns="http://schemas.telerik.com/reporting/2021/1.0">
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="archx" SelectCommand="Select * from Complaints" Name="sqlDataSource1" />
  </DataSources>
  <Items>
