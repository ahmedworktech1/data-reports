  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="GLXELMNIA" SelectCommand="SELECT&#x9;&#xD;&#xA;    fa_cd,&#xD;&#xA;    FA_NM_AR,&#xD;&#xA;&#x9;(SELECT DPRC_VL FROM famf WHERE fa_cd = fadprc.fa_cd) AS famf_DPRC_VL,&#xD;&#xA;&#x9;(SELECT DOC_NO FROM famf WHERE fa_cd = fadprc.fa_cd) AS famf_doc_no,&#xD;&#xA;&#x9;(SELECT DOC_DT FROM famf WHERE fa_cd = fadprc.fa_cd) AS famf_doc_dt,&#xD;&#xA;&#x9;(SELECT DLV_TR_NO FROM famf WHERE fa_cd = fadprc.fa_cd) AS famf_DLV_TR_NO,&#xD;&#xA;&#x9;(SELECT DLV_TR_DT FROM famf WHERE fa_cd = fadprc.fa_cd) AS famf_DLV_TR_DT,&#xD;&#xA;&#x9;isnull (FA_VL,0) as famf_FA_VL,&#xD;&#xA;    isnull (TOTADD,0)as famf_TOTADD,&#xD;&#xA;&#x9;isnull (TOTDSP,0)as famf_TOTDSP,&#xD;&#xA;    (isnull (FA_VL,0)+isnull (TOTADD,0)-isnull (TOTDSP,0)) as tot_cst,&#xD;&#xA;&#x9;(SELECT dprc FROM famf WHERE fa_cd = fadprc.fa_cd) AS famf_dprc,&#xD;&#xA;    dprexp,&#xD;&#xA;    ---accdpr,&#xD;&#xA;    ---odpr,&#xD;&#xA;    ---TotDSPAcc,&#xD;&#xA;    prd,&#xD;&#xA;&#x9;isnull(Q_PYRDPRC,0) as Q_PYRDPRC,&#xD;&#xA;   &#xD;&#xA;    Round(Cast((ISNULL((select sum(DPREXP)from FADPRC s   where s.fa_cd = fadprc.fa_cd )  ,0) )as decimal(18,4)),2) AS Dprexp1,&#xD;&#xA;&#x9;((SELECT dprc FROM famf WHERE fa_cd = fadprc.fa_cd)&#xD;&#xA;&#x9;-&#xD;&#xA;&#x9;Round(Cast((ISNULL((select sum(DPREXP)from FADPRC s   where s.fa_cd = fadprc.fa_cd )  ,0) )as decimal(18,4)),2))&#xD;&#xA;&#x9; as 'الصافى'&#xD;&#xA;FROM &#xD;&#xA;    FADPRC &#xD;&#xA;WHERE&#xD;&#xA; (1&lt;&gt;1)" Name="sqlDataSource1" />
  </DataSources>
