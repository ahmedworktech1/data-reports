<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource1" Width="17cm" Name="محضر اجراءات لجنة شراء باممارسه المحدودة" Zoom="1.5" xmlns="http://schemas.telerik.com/reporting/2023/1.0">
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="azxsandoaa" SelectCommand="WITH AllMembers AS (&#xD;&#xA;    -- الأعضاء الداخليين&#xD;&#xA;    SELECT DISTINCT&#xD;&#xA;        A.TR_NO, A.PURCHAS_NO, A.MTNG_DT_PRCHS, A.FNCL_TR_NO, A.TR_DT,&#xD;&#xA;        A.ACC_NO, A.Acc_Nm AS VendorName, A.VST_NO,&#xD;&#xA;        COALESCE(A.PYMNT_MTHD, 2) AS PYMNT_MTHD,&#xD;&#xA;        (SELECT DSCR_AR FROM AppCodes WHERE ID = '11031' AND SEQ = COALESCE(A.PYMNT_MTHD, 2)) AS PaymentMethodName,&#xD;&#xA;        A.TCHNCL_DCSN_DT AS Technical_Date,&#xD;&#xA;        A.Ltot, A.RMRK6,&#xD;&#xA;        Boss.EMP_NAME AS Boss,&#xD;&#xA;        JobBoss.DSCR_AR AS Boss_dsc,&#xD;&#xA;        (SELECT DSCR_AR FROM AZLISTS WHERE REC_TYPE = 61 AND CODE = A.NT_EXTRNL_MMBR_PRCHS) AS memper_dwla,&#xD;&#xA;        E.EMP_NAME AS MemberName,&#xD;&#xA;        E.JOB_CD&#xD;&#xA;    FROM AZTRH A&#xD;&#xA;    LEFT JOIN PYEMPMF_H AS Boss ON Boss.EMP_NO = A.CMMTTE_CHRMN_PRCHS&#xD;&#xA;    LEFT JOIN pyx_sandoaa..AppCodes AS JobBoss ON JobBoss.ID = 12 AND JobBoss.SEQ = Boss.JOB_CD&#xD;&#xA;    OUTER APPLY (&#xD;&#xA;        SELECT DISTINCT value&#xD;&#xA;        FROM STRING_SPLIT(REPLACE(REPLACE(COALESCE(A.CMMTTE_INTRNL_MMBRS_PRCHS, ''), '''', ''), '&quot;', ''), ',')&#xD;&#xA;        WHERE value &lt;&gt; '' AND ISNUMERIC(value) = 1&#xD;&#xA;    ) AS S&#xD;&#xA;    LEFT JOIN PYEMPMF_H AS E ON TRY_CAST(S.value AS INT) = E.EMP_NO&#xD;&#xA;    WHERE A.TR_TY = '106'&#xD;&#xA;      AND A.CMMTTE_INTRNL_MMBRS_PRCHS IS NOT NULL&#xD;&#xA;      AND A.CMMTTE_INTRNL_MMBRS_PRCHS &lt;&gt; ''&#xD;&#xA;      AND E.EMP_NAME IS NOT NULL&#xD;&#xA;&#xD;&#xA;    UNION&#xD;&#xA;&#xD;&#xA;    -- الأعضاء الخارجيين&#xD;&#xA;    SELECT DISTINCT&#xD;&#xA;        A.TR_NO, A.PURCHAS_NO, A.MTNG_DT_PRCHS, A.FNCL_TR_NO, A.TR_DT,&#xD;&#xA;        A.ACC_NO, A.Acc_Nm AS VendorName, A.VST_NO,&#xD;&#xA;        COALESCE(A.PYMNT_MTHD, 2) AS PYMNT_MTHD,&#xD;&#xA;        (SELECT DSCR_AR FROM AppCodes WHERE ID = '11031' AND SEQ = COALESCE(A.PYMNT_MTHD, 2)) AS PaymentMethodName,&#xD;&#xA;        A.TCHNCL_DCSN_DT AS Technical_Date,&#xD;&#xA;        A.Ltot, A.RMRK6,&#xD;&#xA;        Boss.EMP_NAME AS Boss,&#xD;&#xA;        JobBoss.DSCR_AR AS Boss_dsc,&#xD;&#xA;        (SELECT DSCR_AR FROM AZLISTS WHERE REC_TYPE = 61 AND CODE = A.NT_EXTRNL_MMBR_PRCHS) AS memper_dwla,&#xD;&#xA;        L.DSCR_AR AS MemberName,&#xD;&#xA;        NULL AS JOB_CD&#xD;&#xA;    FROM AZTRH A&#xD;&#xA;    LEFT JOIN PYEMPMF_H AS Boss ON Boss.EMP_NO = A.CMMTTE_CHRMN_OPN&#xD;&#xA;    LEFT JOIN pyx_sandoaa..AppCodes AS JobBoss ON JobBoss.ID = 12 AND JobBoss.SEQ = Boss.JOB_CD&#xD;&#xA;    OUTER APPLY (&#xD;&#xA;        SELECT DISTINCT value&#xD;&#xA;        FROM STRING_SPLIT(REPLACE(REPLACE(COALESCE(A.NT_EXTRNL_MMBR_PRCHS, ''), '''', ''), '&quot;', ''), ',')&#xD;&#xA;        WHERE value &lt;&gt; '' AND ISNUMERIC(value) = 1&#xD;&#xA;    ) AS S&#xD;&#xA;    LEFT JOIN AZLISTS AS L ON TRY_CAST(S.value AS INT) = L.CODE&#xD;&#xA;    WHERE A.TR_TY = '106'&#xD;&#xA;      AND A.NT_EXTRNL_MMBR_PRCHS IS NOT NULL&#xD;&#xA;      AND A.NT_EXTRNL_MMBR_PRCHS &lt;&gt; ''&#xD;&#xA;      AND L.DSCR_AR IS NOT NULL&#xD;&#xA;      AND L.REC_TYPE = 61&#xD;&#xA;),&#xD;&#xA;&#xD;&#xA;WithJobName AS (&#xD;&#xA;    SELECT DISTINCT&#xD;&#xA;        TR_NO, PURCHAS_NO, FNCL_TR_NO, MTNG_DT_PRCHS, TR_DT,&#xD;&#xA;        ACC_NO, VendorName, VST_NO, PYMNT_MTHD, PaymentMethodName,&#xD;&#xA;        Technical_Date, Ltot, RMRK6, Boss, Boss_dsc, memper_dwla,&#xD;&#xA;        MemberName,&#xD;&#xA;        J.DSCR_AR AS JobName&#xD;&#xA;    FROM AllMembers A&#xD;&#xA;    LEFT JOIN pyx_sandoaa..AppCodes J ON J.ID = 12 AND J.SEQ = A.JOB_CD&#xD;&#xA;    WHERE A.MemberName IS NOT NULL&#xD;&#xA;),&#xD;&#xA;&#xD;&#xA;Numbered AS (&#xD;&#xA;    SELECT *,&#xD;&#xA;        ROW_NUMBER() OVER (PARTITION BY TR_NO ORDER BY MemberName) AS rn&#xD;&#xA;    FROM WithJobName&#xD;&#xA;),&#xD;&#xA;&#xD;&#xA;AggregatedMembers AS (&#xD;&#xA;    SELECT&#xD;&#xA;        TR_NO,&#xD;&#xA;        MAX(CASE WHEN rn = 1 THEN MemberName END) AS Member1,&#xD;&#xA;        MAX(CASE WHEN rn = 1 THEN JobName END) AS Job1,&#xD;&#xA;        MAX(CASE WHEN rn = 2 THEN MemberName END) AS Member2,&#xD;&#xA;        MAX(CASE WHEN rn = 2 THEN JobName END) AS Job2,&#xD;&#xA;        MAX(CASE WHEN rn = 3 THEN MemberName END) AS Member3,&#xD;&#xA;        MAX(CASE WHEN rn = 3 THEN JobName END) AS Job3,&#xD;&#xA;        MAX(CASE WHEN rn = 4 THEN MemberName END) AS Member4,&#xD;&#xA;        MAX(CASE WHEN rn = 4 THEN JobName END) AS Job4&#xD;&#xA;    FROM Numbered&#xD;&#xA;    GROUP BY TR_NO&#xD;&#xA;),&#xD;&#xA;&#xD;&#xA;ItemsCTE AS (&#xD;&#xA;    SELECT DISTINCT&#xD;&#xA;        H.TR_NO,&#xD;&#xA;        STRING_AGG(I.ITM_NM_AR, N' - ') AS ItemsNames,&#xD;&#xA;        dbo.Num_To_Str(H.Ltot) AS tfqet&#xD;&#xA;    FROM AZTRH H&#xD;&#xA;    LEFT JOIN AZTRD D ON D.TR_NO = H.TR_NO AND D.TR_TY = H.TR_TY&#xD;&#xA;    LEFT JOIN AZITMS I ON I.ITM_CD = D.ITM_CD&#xD;&#xA;    WHERE H.TR_TY = '106'&#xD;&#xA;      AND I.ITM_NM_AR IS NOT NULL&#xD;&#xA;    GROUP BY H.TR_NO, H.Ltot&#xD;&#xA;),&#xD;&#xA;&#xD;&#xA;SplitSuppliers AS (&#xD;&#xA;    SELECT&#xD;&#xA;        A.TR_NO,&#xD;&#xA;        LTRIM(RTRIM(value)) AS ACC_NO2_SINGLE&#xD;&#xA;    FROM AZTRH A&#xD;&#xA;    CROSS APPLY STRING_SPLIT(A.RMRK1, ',')&#xD;&#xA;    WHERE A.TR_TY = '106'&#xD;&#xA;),&#xD;&#xA;&#xD;&#xA;Suppliers AS (&#xD;&#xA;    SELECT&#xD;&#xA;        S.TR_NO,&#xD;&#xA;        ACC.Acc_Nm_AR AS SupplierName,&#xD;&#xA;        ROW_NUMBER() OVER (PARTITION BY S.TR_NO ORDER BY ACC.Acc_Nm_AR) AS rn&#xD;&#xA;    FROM SplitSuppliers S&#xD;&#xA;    LEFT JOIN AZACCMF ACC ON ACC.Acc_NO = S.ACC_NO2_SINGLE&#xD;&#xA;    WHERE ACC.Acc_Nm_AR IS NOT NULL&#xD;&#xA;),&#xD;&#xA;&#xD;&#xA;FinalSuppliers AS (&#xD;&#xA;    SELECT&#xD;&#xA;        TR_NO,&#xD;&#xA;        MAX(CASE WHEN rn = 1 THEN SupplierName END) AS Supplier1,&#xD;&#xA;        MAX(CASE WHEN rn = 2 THEN SupplierName END) AS Supplier2,&#xD;&#xA;        MAX(CASE WHEN rn = 3 THEN SupplierName END) AS Supplier3&#xD;&#xA;    FROM Suppliers&#xD;&#xA;    GROUP BY TR_NO&#xD;&#xA;),&#xD;&#xA;&#xD;&#xA;-- ✅ أول صنف بس لكل transaction&#xD;&#xA;ItemsDetails AS (&#xD;&#xA;    SELECT&#xD;&#xA;        D.TR_NO,&#xD;&#xA;        D.LN_NO,&#xD;&#xA;        D.TR_DT AS Item_TR_DT,&#xD;&#xA;        D.ITM_CD,&#xD;&#xA;        ITM.ITM_NM_AR AS Item_Name,&#xD;&#xA;        ITM.ITM_CLS1 AS Item_Specs,&#xD;&#xA;        D.QTY,&#xD;&#xA;        PK.pk_nm_ar AS Unit_Name,&#xD;&#xA;        D.PKPRC AS Estimated_Price,&#xD;&#xA;        CAST(D.PKPRC AS INT) AS PKPRC_Gneh,&#xD;&#xA;        CAST(ROUND((D.PKPRC - FLOOR(D.PKPRC)) * 100, 0) AS INT) AS PKPRC_Qersh,&#xD;&#xA;        (D.QTY * D.PKPRC) AS Line_Total&#xD;&#xA;    FROM (&#xD;&#xA;        SELECT *,&#xD;&#xA;            ROW_NUMBER() OVER (PARTITION BY TR_NO ORDER BY LN_NO) AS rn_item&#xD;&#xA;        FROM AZTRD&#xD;&#xA;        WHERE TR_TY = '106'&#xD;&#xA;    ) D&#xD;&#xA;    LEFT JOIN AZITMS ITM ON ITM.ITM_CD = D.ITM_CD&#xD;&#xA;    LEFT JOIN AZPKGDEF PK ON PK.PKID = D.PKID&#xD;&#xA;    WHERE D.rn_item = 1  -- ✅ أول سطر بس&#xD;&#xA;),&#xD;&#xA;&#xD;&#xA;-- ✅ أول Company_Name بس لكل transaction&#xD;&#xA;CompanyNames AS (&#xD;&#xA;    SELECT&#xD;&#xA;        TR_NO,&#xD;&#xA;        Company_Name&#xD;&#xA;    FROM (&#xD;&#xA;        SELECT&#xD;&#xA;            H.TR_NO,&#xD;&#xA;            ACC2.acc_nm_ar AS Company_Name,&#xD;&#xA;            ROW_NUMBER() OVER (PARTITION BY H.TR_NO ORDER BY ACC2.acc_nm_ar) AS rn_co&#xD;&#xA;        FROM AZTRH H&#xD;&#xA;        LEFT JOIN AZACCMF ACC2&#xD;&#xA;            ON (&#xD;&#xA;                (',' + ISNULL(H.acc_no2, '') + ','&#xD;&#xA;                 LIKE '%,' + '''' + ACC2.acc_no + '''' + ',%')&#xD;&#xA;                OR (&#xD;&#xA;                    ISNULL(H.acc_no2, '') = ''&#xD;&#xA;                    AND dbo.StringIntersect(H.RMRK_EXTRA, ACC2.Acc_Actv, ',') = 1&#xD;&#xA;                )&#xD;&#xA;            )&#xD;&#xA;        WHERE H.TR_TY = '106'&#xD;&#xA;    ) X&#xD;&#xA;    WHERE rn_co = 1&#xD;&#xA;),&#xD;&#xA;&#xD;&#xA;FinalResult AS (&#xD;&#xA;    SELECT&#xD;&#xA;        N.*,&#xD;&#xA;        IT.tfqet,&#xD;&#xA;        IT.ItemsNames,&#xD;&#xA;        FS.Supplier1, FS.Supplier2, FS.Supplier3,&#xD;&#xA;        AM.Member1, AM.Job1, AM.Member2, AM.Job2,&#xD;&#xA;        AM.Member3, AM.Job3, AM.Member4, AM.Job4,&#xD;&#xA;        ID.LN_NO, ID.Item_TR_DT, ID.ITM_CD,&#xD;&#xA;        ID.Item_Name, ID.Item_Specs, ID.QTY,&#xD;&#xA;        ID.Unit_Name, ID.Estimated_Price,&#xD;&#xA;        ID.PKPRC_Gneh, ID.PKPRC_Qersh,&#xD;&#xA;        ID.Line_Total,&#xD;&#xA;        CN.Company_Name&#xD;&#xA;    FROM (&#xD;&#xA;        SELECT DISTINCT TR_NO FROM Numbered&#xD;&#xA;    ) uniq&#xD;&#xA;    INNER JOIN Numbered N ON N.TR_NO = uniq.TR_NO AND N.rn = 1&#xD;&#xA;    LEFT JOIN AggregatedMembers AM ON AM.TR_NO = N.TR_NO&#xD;&#xA;    LEFT JOIN ItemsCTE IT ON IT.TR_NO = N.TR_NO&#xD;&#xA;    LEFT JOIN FinalSuppliers FS ON FS.TR_NO = N.TR_NO&#xD;&#xA;    LEFT JOIN ItemsDetails ID ON ID.TR_NO = N.TR_NO&#xD;&#xA;    LEFT JOIN CompanyNames CN ON CN.TR_NO = N.TR_NO  -- ✅ بدل JOIN المباشر&#xD;&#xA;)&#xD;&#xA;&#xD;&#xA;SELECT *&#xD;&#xA;FROM FinalResult&#xD;&#xA;ORDER BY TR_NO;" Name="sqlDataSource1" />
  </DataSources>
