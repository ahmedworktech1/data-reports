<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource1" Width="17cm" Name="Contracts_Agreements" xmlns="http://schemas.telerik.com/reporting/2023/1.0">
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="archlocal" SelectCommand="SELECT &#xD;&#xA;    sum(CASE WHEN Agreements.[Type] = 1 THEN 1 else 0 END) AS s1, -- بروتوكول&#xD;&#xA;    sum(CASE WHEN Agreements.[Type] = 3 THEN 1 else 0 END) AS s2, -- مذكرة تفاهم&#xD;&#xA;    sum(CASE WHEN Agreements.[Type] = 2 THEN 1 else 0 END) AS s3, -- اتفاقية&#xD;&#xA;    sum(CASE WHEN Agreements.[Type] = 4 THEN 1 else 0 END) AS s3 -- اخري&#xD;&#xA;  &#xD;&#xA;&#xD;&#xA;FROM Agreements " Name="sqlDataSource1" />
  </DataSources>
  <Items>
    <DetailSection Height="5cm" Name="detailSection1">
