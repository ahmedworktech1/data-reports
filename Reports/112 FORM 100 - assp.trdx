<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource1" Width="210mm" Name="Report" xmlns="http://schemas.telerik.com/reporting/2021/1.0">
  <Style BackgroundColor="Silver" />
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="GLELmostdama" SelectCommand="select db_vl+cr_vl as net, 1 AS NUM,&#xD;&#xA;(select sum_nm_ar from glsums where sum_cd=gljrnld.sum_cd)as sumnm,&#xD;&#xA;(select cst_nm_ar from glcst where cst_cd=left (gljrnld.cst_cd,2))as cstnm,&#xD;&#xA;(select cst_nm_ar from glcst where cst_cd=(select left (sum_cst_cd,2) from glsums where sum_cd=gljrnld.sum_cd))as cstnm1,&#xD;&#xA;(select acc_nm_ar from glmf where acc_no=gljrnld.acc_no)as acctnm,&#xD;&#xA;(select fmly from glmf where acc_no=gljrnld.acc_no)as fmly,&#xD;&#xA;(select btch_id from glcst where cst_cd=gljrnld.cst_cd)as btich ,&#xD;&#xA;(select LC_NO from glLCMF where SUM_cd=gljrnld.SUM_cd)as LCNO ,&#xD;&#xA;(select LC_AMOUNT from glLCMF where SUM_cd=gljrnld.SUM_cd)as LCAMOUNT ,&#xD;&#xA;(select LC_DSCR_AR from glLCMF where SUM_cd=gljrnld.SUM_cd)as DSCR ,&#xD;&#xA;(select opn_dt from glLCMF where SUM_cd=gljrnld.SUM_cd)as opendate ,&#xD;&#xA;(select LC_dscr_en from glLCMF where SUM_cd=gljrnld.SUM_cd)as adress ,&#xD;&#xA;(select ren_dt1 from glLCMF where SUM_cd=gljrnld.SUM_cd)as ren1 ,&#xD;&#xA;(select ren_dt2 from glLCMF where SUM_cd=gljrnld.SUM_cd)as ren2 , &#xD;&#xA;(select ren_dt3 from glLCMF where SUM_cd=gljrnld.SUM_cd)as ren3 ,  &#xD;&#xA;(select ren_vl1 from glLCMF where SUM_cd=gljrnld.SUM_cd)as renvl1 , &#xD;&#xA;(select ren_vl2 from glLCMF where SUM_cd=gljrnld.SUM_cd)as renvl2 , &#xD;&#xA;(select ren_vl3 from glLCMF where SUM_cd=gljrnld.SUM_cd)as renvl3 ,&#xD;&#xA;(select exp_dt1 from glLCMF where SUM_cd=gljrnld.SUM_cd)as exp_dt1 , &#xD;&#xA;(select exp_dt1 from glLCMF where SUM_cd=gljrnld.SUM_cd)as exp_dt2 , &#xD;&#xA;(select exp_dt1 from glLCMF where SUM_cd=gljrnld.SUM_cd)as exp_dt3 ,  &#xD;&#xA;&#xD;&#xA;&#xD;&#xA;* from  gljrnld&#xD;&#xA;&#xD;&#xA;WHERE ACC_NO BETWEEN '1001' AND '100799999'&#xD;&#xA;and jrn_cd='03'&#xD;&#xA;AND 1=1&#xD;&#xA;" Name="sqlDataSource1" />
  </DataSources>
  <Items>
    <ReportFooterSection Height="260mm" Name="ReportFooterSection5">
