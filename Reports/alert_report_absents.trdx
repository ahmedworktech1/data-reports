        </TextBox>
        <TextBox Width="4.754cm" Height="0.609cm" Left="2.863cm" Top="4.991cm" Value="المسمى الوظيفى" Name="textBox12" StyleName="">
          <Style BackgroundColor="AliceBlue" TextAlign="Center" VerticalAlign="Middle">
