<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource1" Width="21cm" Name="alert_report_absents" xmlns="http://schemas.telerik.com/reporting/2021/1.0">
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="PY" SelectCommand="SELECT  PYEMPMFH.EMP_NO &quot;رقم الموظف&quot;, PYEMPMFH .EMP_NAME   &quot;اسم الموظف&quot;&#xD;&#xA;,(SELECT COMP_NAME FROM PYCOMP WHERE COMP_NO  = PYEMPMFH.COMP_NO )  &quot;مكان العمل&quot;&#xD;&#xA;,PYEMPMFH .JOB_DSCR &quot;المسمى الوظيفي&quot; &#xD;&#xA;, case when PYEMPMFH .Stat =9905 then 'غياب' else (select TR_DSCR  from PLTR_TYPES where   TR_Code  =PYEMPMFH .Stat) end &quot;الحالة الحالية&quot; &#xD;&#xA;   FROM PYEMPMFH  INNER  JOIN  PYINOUT_S ON  ( CONVERT( DATE,PYINOUT_S.DT) = CONVERT( DATE,GETDATE())  AND  PYEMPMFH .EMP_NO  = PYINOUT_S.EMP_NO ) " Name="sqlDataSource1" />
  </DataSources>
  <Items>
    <PageHeaderSection Height="5.6cm" Name="pageHeaderSection1">
      <Style>
        <Font Bold="True" />
      </Style>
      <Items>
        <TextBox Width="3.1cm" Height="0.9cm" Left="0.4cm" Top="0.4cm" Value="= Now()" Format="{0:d}" Culture="en" Name="textBox1">
          <Style BackgroundColor="AliceBlue" TextAlign="Center" VerticalAlign="Middle">
            <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="3.1cm" Height="0.9cm" Left="0.4cm" Top="1.5cm" Value="= Now()" Format="{0:t}" Culture="en" Name="textBox2">
          <Style BackgroundColor="AliceBlue" TextAlign="Center" VerticalAlign="Middle">
            <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="3.1cm" Height="0.9cm" Left="0.4cm" Top="2.6cm" Value="= &quot;Page &quot; + PageNumber + &quot; of &quot; + PageCount&#xD;&#xA;" Name="textBox3">
          <Style BackgroundColor="AliceBlue" TextAlign="Center" VerticalAlign="Middle">
            <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="6.3cm" Height="1cm" Left="7.3cm" Top="3cm" Value="الغائبين اليوم بالامانة العامة" Name="textBox5">
          <Style BackgroundColor="AliceBlue" TextAlign="Center" VerticalAlign="Middle">
            <Font Size="16pt" />
            <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <PictureBox Image="" Width="2.6cm" Height="1.8cm" Left="9.2cm" Top="0.6cm" MimeType="image/png" Name="pictureBox1">
          <Style>
            <BorderStyle Top="None" Bottom="None" Left="None" Right="None" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </PictureBox>
        <TextBox Width="2.582cm" Height="0.609cm" Left="18.063cm" Top="4.991cm" Value="رقم الموظف" Name="textBox10">
          <Style BackgroundColor="AliceBlue" TextAlign="Center" VerticalAlign="Middle">
            <Font Size="14pt" Bold="True" />
            <BorderStyle Default="Solid" Bottom="Solid" />
          </Style>
        </TextBox>
        <TextBox Width="7.463cm" Height="0.609cm" Left="10.6cm" Top="4.991cm" Value="اسم الموظف" Name="textBox8">
