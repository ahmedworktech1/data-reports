<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource1" Width="20cm" Name="محضر_اجراءات_لجنه_بت" Zoom="1.5" xmlns="http://schemas.telerik.com/reporting/2023/1.0">
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="AZXSANDOAA" SelectCommand=";WITH AllMembers AS (&#xD;&#xA;    -- 🧩 الأعضاء الداخليين&#xD;&#xA;    SELECT DISTINCT&#xD;&#xA;        A.TR_NO,&#xD;&#xA;        A.Purchas_no,&#xD;&#xA;        A.CMMTTE_END_DT,&#xD;&#xA;        A.CMMTTE_RMRK_DCSN,&#xD;&#xA;        A.TCHNCL_DCSN_DT,&#xD;&#xA;        A.FNCL_TR_MO,&#xD;&#xA;        A.TR_DT,&#xD;&#xA;        A.PRCHS_OPRTN_TYP,&#xD;&#xA;        A.TCHNCL_OPN_DT,&#xD;&#xA;        A.ACC_NM, -- 🆕 Added ACC_NM&#xD;&#xA;        A.ORDER_NO, -- 🆕 Added ORDER_NO&#xD;&#xA;        Boss.EMP_NAME AS Boss,&#xD;&#xA;        N'رئيسا' AS Boss_dsc,&#xD;&#xA;        L.DSCR_AR AS memper_dwla,&#xD;&#xA;        E.EMP_NAME AS MemberName&#xD;&#xA;    FROM AZTRH A&#xD;&#xA;    LEFT JOIN PYEMPMF_H AS Boss&#xD;&#xA;        ON Boss.EMP_NO = A.CMMTTE_CHRMN_DCSN&#xD;&#xA;    LEFT JOIN AZLISTS AS L&#xD;&#xA;        ON TRY_CAST(REPLACE(REPLACE(COALESCE(A.CMMTTE_EXTRNL_MMBRS_DCSN, ''), '''', ''), '&quot;', '') AS INT) = L.CODE&#xD;&#xA;        AND L.REC_TYPE = 61&#xD;&#xA;    OUTER APPLY (&#xD;&#xA;        SELECT DISTINCT value &#xD;&#xA;        FROM STRING_SPLIT(REPLACE(REPLACE(COALESCE(A.CMMTTE_INTRNL_MMBRS_DCSN, ''), '''', ''), '&quot;', ''), ',')&#xD;&#xA;        WHERE value &lt;&gt; '' AND ISNUMERIC(value) = 1&#xD;&#xA;    ) AS S&#xD;&#xA;    LEFT JOIN PYEMPMF_H AS E&#xD;&#xA;        ON TRY_CAST(S.value AS INT) = E.EMP_NO&#xD;&#xA;    WHERE A.TR_TY = '116'&#xD;&#xA;      AND A.CMMTTE_INTRNL_MMBRS_DCSN IS NOT NULL&#xD;&#xA;      AND A.CMMTTE_INTRNL_MMBRS_DCSN &lt;&gt; ''&#xD;&#xA;      AND E.EMP_NAME IS NOT NULL&#xD;&#xA;&#xD;&#xA;    UNION ALL&#xD;&#xA;&#xD;&#xA;    -- 🧩 الأعضاء الخارجيين&#xD;&#xA;    SELECT DISTINCT&#xD;&#xA;        A.TR_NO,&#xD;&#xA;        A.Purchas_no,&#xD;&#xA;        A.CMMTTE_END_DT,&#xD;&#xA;        A.CMMTTE_RMRK_DCSN,&#xD;&#xA;        A.TCHNCL_DCSN_DT,&#xD;&#xA;        A.FNCL_TR_MO,&#xD;&#xA;        A.TR_DT,&#xD;&#xA;        A.PRCHS_OPRTN_TYP,&#xD;&#xA;        A.TCHNCL_OPN_DT,&#xD;&#xA;        A.ACC_NM, -- 🆕 Added ACC_NM&#xD;&#xA;        A.ORDER_NO, -- 🆕 Added ORDER_NO&#xD;&#xA;        Boss.EMP_NAME AS Boss,&#xD;&#xA;        N'رئيسا' AS Boss_dsc,&#xD;&#xA;        L.DSCR_AR AS memper_dwla,&#xD;&#xA;        EL.DSCR_AR AS MemberName&#xD;&#xA;    FROM AZTRH A&#xD;&#xA;    LEFT JOIN PYEMPMF_H AS Boss&#xD;&#xA;        ON Boss.EMP_NO = A.CMMTTE_CHRMN_OPN&#xD;&#xA;    LEFT JOIN AZLISTS AS L&#xD;&#xA;        ON TRY_CAST(REPLACE(REPLACE(COALESCE(A.CMMTTE_EXTRNL_MMBRS_DCSN, ''), '''', ''), '&quot;', '') AS INT) = L.CODE&#xD;&#xA;        AND L.REC_TYPE = 61&#xD;&#xA;    OUTER APPLY (&#xD;&#xA;        SELECT DISTINCT value &#xD;&#xA;        FROM STRING_SPLIT(REPLACE(REPLACE(COALESCE(A.CMMTTE_EXTRNL_MMBRS_DCSN, ''), '''', ''), '&quot;', ''), ',')&#xD;&#xA;        WHERE value &lt;&gt; '' AND ISNUMERIC(value) = 1&#xD;&#xA;    ) AS S&#xD;&#xA;    LEFT JOIN AZLISTS AS EL&#xD;&#xA;        ON TRY_CAST(S.value AS INT) = EL.CODE&#xD;&#xA;        AND EL.REC_TYPE = 61&#xD;&#xA;    WHERE A.TR_TY = '116'&#xD;&#xA;      AND A.CMMTTE_EXTRNL_MMBRS_DCSN IS NOT NULL&#xD;&#xA;      AND A.CMMTTE_EXTRNL_MMBRS_DCSN &lt;&gt; ''&#xD;&#xA;      AND EL.DSCR_AR IS NOT NULL&#xD;&#xA;),&#xD;&#xA;-- 🟩 الأصناف + رقم التفرير + اسم المعمل&#xD;&#xA;ItemsCTE AS (&#xD;&#xA;    SELECT DISTINCT &#xD;&#xA;        H.TR_NO,&#xD;&#xA;        STRING_AGG(I.ITM_NM_AR, N' - ') AS ItemsNames,&#xD;&#xA;        STRING_AGG(D.tel1, N' - ') AS TelNumber,&#xD;&#xA;        STRING_AGG(D.delv_no3, N' - ') AS LabName&#xD;&#xA;    FROM AZTRH H&#xD;&#xA;    LEFT JOIN AZTRD D ON D.TR_NO = H.TR_NO&#xD;&#xA;    LEFT JOIN AZITMS I ON I.ITM_CD = D.ITM_CD&#xD;&#xA;    WHERE H.TR_TY = '116'&#xD;&#xA;      AND I.ITM_NM_AR IS NOT NULL&#xD;&#xA;    GROUP BY H.TR_NO&#xD;&#xA;),&#xD;&#xA;-- 🟩 عضو مجلس الدولة&#xD;&#xA;CouncilMember AS (&#xD;&#xA;    SELECT &#xD;&#xA;        H.TR_NO,&#xD;&#xA;        L.DSCR_AR AS CouncilMemberName&#xD;&#xA;    FROM AZTRH H&#xD;&#xA;    LEFT JOIN AZLISTS AS L&#xD;&#xA;        ON TRY_CAST(REPLACE(REPLACE(COALESCE(H.NT_EXTRNL_MMBR_INSPCTN, ''), '''', ''), '&quot;', '') AS INT) = L.CODE&#xD;&#xA;        AND L.REC_TYPE = 61&#xD;&#xA;    WHERE H.TR_TY = '116'&#xD;&#xA;),&#xD;&#xA;-- 🟩 عضو خارجي إضافي + نوعه&#xD;&#xA;ExternalMember AS (&#xD;&#xA;    SELECT DISTINCT&#xD;&#xA;        A.TR_NO,&#xD;&#xA;        L1.DSCR_AR AS ExternalMemberName,&#xD;&#xA;        L2.DSCR_AR AS ExternalMemberType&#xD;&#xA;    FROM AZTRH A&#xD;&#xA;    LEFT JOIN AZLISTS AS L1&#xD;&#xA;        ON TRY_CAST(REPLACE(REPLACE(COALESCE(A.NT_EXTRNL_MMBR_DCSN, ''), '''', ''), '&quot;', '') AS INT) = L1.CODE&#xD;&#xA;        AND L1.REC_TYPE = 61&#xD;&#xA;    LEFT JOIN AZLISTS AS L2&#xD;&#xA;        ON TRY_CAST(REPLACE(REPLACE(COALESCE(A.NT_EXTRNL_MMBR_TYP_DCSN, ''), '''', ''), '&quot;', '') AS INT) = L2.CODE&#xD;&#xA;        AND L2.REC_TYPE = 60&#xD;&#xA;    WHERE A.TR_TY = '116'&#xD;&#xA;      AND A.NT_EXTRNL_MMBR_DCSN IS NOT NULL&#xD;&#xA;      AND A.NT_EXTRNL_MMBR_DCSN &lt;&gt; ''&#xD;&#xA;      AND ISNUMERIC(REPLACE(REPLACE(COALESCE(A.NT_EXTRNL_MMBR_DCSN, ''), '''', ''), '&quot;', '')) = 1&#xD;&#xA;),&#xD;&#xA;-- 🟩 نوع العملية&#xD;&#xA;OprType AS (&#xD;&#xA;    SELECT &#xD;&#xA;        T.TR_TY,&#xD;&#xA;        T.DSCR_AR AS OprTypeName&#xD;&#xA;    FROM AZTRTY T&#xD;&#xA;    WHERE T.TR_TY IS NOT NULL&#xD;&#xA;),&#xD;&#xA;-- 🟩 عضو الأمن الخارجي&#xD;&#xA;SecurityMember AS (&#xD;&#xA;    SELECT DISTINCT&#xD;&#xA;        A.TR_NO,&#xD;&#xA;        STRING_AGG(Sec.DSCR_AR, N', ') AS ExternalSecurityMember&#xD;&#xA;    FROM AZTRH A&#xD;&#xA;    OUTER APPLY (&#xD;&#xA;        SELECT DISTINCT value &#xD;&#xA;        FROM STRING_SPLIT(&#xD;&#xA;            REPLACE(REPLACE(COALESCE(A.CMMTTE_EXTRNL_SCRTY_DCSN, ''), '''', ''), '&quot;', ''), ','&#xD;&#xA;        )&#xD;&#xA;        WHERE value &lt;&gt; '' AND ISNUMERIC(value) = 1&#xD;&#xA;    ) AS S&#xD;&#xA;    LEFT JOIN AZLISTS AS Sec&#xD;&#xA;        ON TRY_CAST(S.value AS INT) = Sec.CODE&#xD;&#xA;        AND Sec.REC_TYPE = 61&#xD;&#xA;    WHERE A.TR_TY = '116'&#xD;&#xA;      AND A.CMMTTE_EXTRNL_SCRTY_DCSN IS NOT NULL&#xD;&#xA;      AND A.CMMTTE_EXTRNL_SCRTY_DCSN &lt;&gt; ''&#xD;&#xA;      AND Sec.DSCR_AR IS NOT NULL&#xD;&#xA;    GROUP BY A.TR_NO&#xD;&#xA;),&#xD;&#xA;-- 🧮 ترتيب الأعضاء&#xD;&#xA;Numbered AS (&#xD;&#xA;    SELECT&#xD;&#xA;        TR_NO,&#xD;&#xA;        Purchas_no,&#xD;&#xA;        FNCL_TR_MO,&#xD;&#xA;        TCHNCL_DCSN_DT,&#xD;&#xA;        CMMTTE_END_DT,&#xD;&#xA;        CMMTTE_RMRK_DCSN,&#xD;&#xA;        TR_DT,&#xD;&#xA;        PRCHS_OPRTN_TYP,&#xD;&#xA;        TCHNCL_OPN_DT,&#xD;&#xA;        ACC_NM, -- 🆕 Added ACC_NM&#xD;&#xA;        ORDER_NO, -- 🆕 Added ORDER_NO&#xD;&#xA;        Boss,&#xD;&#xA;        Boss_dsc,&#xD;&#xA;        memper_dwla,&#xD;&#xA;        MemberName,&#xD;&#xA;        ROW_NUMBER() OVER (PARTITION BY TR_NO ORDER BY MemberName) AS rn&#xD;&#xA;    FROM AllMembers&#xD;&#xA;),&#xD;&#xA;-- ✅ النتيجة النهائية&#xD;&#xA;FinalResult AS (&#xD;&#xA;    SELECT&#xD;&#xA;        N.TR_NO,&#xD;&#xA;        N.Purchas_no,&#xD;&#xA;        N.FNCL_TR_MO,&#xD;&#xA;        N.TR_DT,&#xD;&#xA;        N.CMMTTE_END_DT,&#xD;&#xA;        N.TCHNCL_DCSN_DT,&#xD;&#xA;        N.TCHNCL_OPN_DT,&#xD;&#xA;        N.CMMTTE_RMRK_DCSN,&#xD;&#xA;        N.PRCHS_OPRTN_TYP,&#xD;&#xA;        N.ACC_NM, -- 🆕 Added ACC_NM&#xD;&#xA;        N.ORDER_NO, -- 🆕 Added ORDER_NO&#xD;&#xA;        OT.OprTypeName,&#xD;&#xA;        N.Boss,&#xD;&#xA;        N.Boss_dsc,&#xD;&#xA;        N.memper_dwla,&#xD;&#xA;        I.ItemsNames,&#xD;&#xA;        I.TelNumber,&#xD;&#xA;        I.LabName,&#xD;&#xA;        C.CouncilMemberName,&#xD;&#xA;        E.ExternalMemberName,&#xD;&#xA;        E.ExternalMemberType,&#xD;&#xA;        S.ExternalSecurityMember,&#xD;&#xA;        MAX(CASE WHEN N.rn = 1 THEN N.MemberName END) AS Member1,&#xD;&#xA;        MAX(CASE WHEN N.rn = 2 THEN N.MemberName END) AS Member2,&#xD;&#xA;        MAX(CASE WHEN N.rn = 3 THEN N.MemberName END) AS Member3,&#xD;&#xA;        MAX(CASE WHEN N.rn = 4 THEN N.MemberName END) AS Member4&#xD;&#xA;    FROM Numbered N&#xD;&#xA;    LEFT JOIN ItemsCTE I ON I.TR_NO = N.TR_NO&#xD;&#xA;    LEFT JOIN OprType OT ON CAST(N.PRCHS_OPRTN_TYP AS NVARCHAR(50)) = CAST(OT.TR_TY AS NVARCHAR(50))&#xD;&#xA;    LEFT JOIN CouncilMember C ON C.TR_NO = N.TR_NO&#xD;&#xA;    LEFT JOIN ExternalMember E ON E.TR_NO = N.TR_NO&#xD;&#xA;    LEFT JOIN SecurityMember S ON S.TR_NO = N.TR_NO&#xD;&#xA;    GROUP BY&#xD;&#xA;        N.TR_NO,&#xD;&#xA;        N.Purchas_no,&#xD;&#xA;        N.FNCL_TR_MO,&#xD;&#xA;        N.TR_DT,&#xD;&#xA;        N.CMMTTE_END_DT,&#xD;&#xA;        N.TCHNCL_DCSN_DT,&#xD;&#xA;        N.TCHNCL_OPN_DT,&#xD;&#xA;        N.CMMTTE_RMRK_DCSN,&#xD;&#xA;        N.PRCHS_OPRTN_TYP,&#xD;&#xA;        N.ACC_NM, -- 🆕 Added ACC_NM&#xD;&#xA;        N.ORDER_NO, -- 🆕 Added ORDER_NO&#xD;&#xA;        OT.OprTypeName,&#xD;&#xA;        N.Boss,&#xD;&#xA;        N.Boss_dsc,&#xD;&#xA;        N.memper_dwla,&#xD;&#xA;        I.ItemsNames,&#xD;&#xA;        I.TelNumber,&#xD;&#xA;        I.LabName,&#xD;&#xA;        C.CouncilMemberName,&#xD;&#xA;        E.ExternalMemberName,&#xD;&#xA;        E.ExternalMemberType,&#xD;&#xA;        S.ExternalSecurityMember&#xD;&#xA;)&#xD;&#xA;SELECT TOP 1&#xD;&#xA;    Purchas_no,&#xD;&#xA;    FNCL_TR_MO,&#xD;&#xA;    TR_DT,&#xD;&#xA;    CMMTTE_END_DT,&#xD;&#xA;    TCHNCL_DCSN_DT,&#xD;&#xA;    TCHNCL_OPN_DT,&#xD;&#xA;    CMMTTE_RMRK_DCSN,&#xD;&#xA;    OprTypeName,&#xD;&#xA;    Boss,&#xD;&#xA;    Boss_dsc,&#xD;&#xA;    memper_dwla,&#xD;&#xA;    ItemsNames,&#xD;&#xA;    TelNumber,&#xD;&#xA;    LabName,&#xD;&#xA;    CouncilMemberName,&#xD;&#xA;    ExternalMemberName,&#xD;&#xA;    ExternalMemberType,&#xD;&#xA;    ExternalSecurityMember,&#xD;&#xA;    Member1,&#xD;&#xA;    Member2,&#xD;&#xA;    Member3,&#xD;&#xA;    Member4,&#xD;&#xA;    ACC_NM, -- 🆕 Added ACC_NM&#xD;&#xA;    ORDER_NO -- 🆕 Added ORDER_NO&#xD;&#xA;FROM FinalResult&#xD;&#xA;WHERE Member1 IS NOT NULL&#xD;&#xA;ORDER BY FNCL_TR_MO DESC, TR_DT DESC;" Name="sqlDataSource1" />
  </DataSources>
