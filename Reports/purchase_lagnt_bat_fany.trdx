        <TextBox Width="3.2cm" Height="0.447cm" Left="12.9cm" Top="1.753cm" Value="= Replace(&#xD;&#xA;Replace(&#xD;&#xA;Replace(&#xD;&#xA;Replace(&#xD;&#xA;Replace(&#xD;&#xA;Replace(&#xD;&#xA;Replace(&#xD;&#xA;Replace(&#xD;&#xA;Replace(&#xD;&#xA;Replace(Fields.FNCL_TR_MO, &quot;0&quot;, &quot;٠&quot;), &#xD;&#xA;&quot;1&quot;, &quot;١&quot;), &#xD;&#xA;&quot;2&quot;, &quot;٢&quot;), &#xD;&#xA;&quot;3&quot;, &quot;٣&quot;), &#xD;&#xA;&quot;4&quot;, &quot;٤&quot;), &#xD;&#xA;&quot;5&quot;, &quot;٥&quot;), &#xD;&#xA;&quot;6&quot;, &quot;٦&quot;), &#xD;&#xA;&quot;7&quot;, &quot;٧&quot;), &#xD;&#xA;&quot;8&quot;, &quot;٨&quot;), &#xD;&#xA;&quot;9&quot;, &quot;٩&quot;)&#xD;&#xA;" Culture="ar-EG" Name="textBox127">
