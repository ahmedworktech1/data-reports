        <TextBox Width="6.449cm" Height="0.7cm" Left="9.8cm" Top="31.474cm" Value="النظر فى العطاءات الآتية لمطابقتهـــــا لشروط الإدارة :" Name="textBox96">
          <Style TextAlign="Right" VerticalAlign="Middle">
            <Font Bold="True" Underline="True" />
