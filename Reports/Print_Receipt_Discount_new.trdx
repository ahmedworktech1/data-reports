<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource1" Width="20.4cm" Name="Print_Receipt_Discount_new" ShowSnapGrid="True" xmlns="http://schemas.telerik.com/reporting/2021/1.0">
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="AQDATA1" SelectCommand="SELECT        TOP (100) PERCENT dbo.AQCOLLECT_H.Tr_NO AS TRNO, dbo.AQCOLLECT_H.TR_Dt AS TRDT, dbo.tenantMF.TENANT_Nm_AR AS M_TenantNm, dbo.BLDMF.BLD_DSCR_AR AS M_BldDscr, dbo.AQCOLLECT_H.NOTS, &#xD;&#xA;                         dbo.AQRENT_H.Unts_Dscrs&#xD;&#xA;FROM            dbo.AQCOLLECT_H INNER JOIN&#xD;&#xA;                         dbo.tenantMF ON dbo.AQCOLLECT_H.TENANT_NO = dbo.tenantMF.TENANT_NO INNER JOIN&#xD;&#xA;                         dbo.BLDMF ON dbo.AQCOLLECT_H.BLD_CD = dbo.BLDMF.BLD_CD INNER JOIN&#xD;&#xA;                         dbo.AQRENT_H ON dbo.AQCOLLECT_H.TENANT_NO = dbo.AQRENT_H.TENANT_NO AND dbo.AQCOLLECT_H.CONTRACT_NO = dbo.AQRENT_H.Tr_NO&#xD;&#xA;WHERE        (1=1)&#xD;&#xA;ORDER BY TRNO" Name="sqlDataSource1" />
  </DataSources>
  <Items>
    <PageHeaderSection Height="0.132cm" Name="pageHeaderSection1" />
    <DetailSection Height="11.768cm" Name="detailSection1">
      <Items>
        <PictureBox Image="" Width="20.4cm" Height="9.6cm" Left="0cm" Top="1.968cm" Sizing="Stretch" MimeType="image/jpeg" Name="pictureBox1" />
        <TextBox Width="3.3cm" Height="0.6cm" Left="14.5cm" Top="3.368cm" KeepTogether="True" Value="= Fields.TRNO" Multiline="False" Culture="en" Name="textBox18">
          <Style BackgroundColor="White" Color="Black" TextAlign="Center" VerticalAlign="Middle">
            <Font Name="Times New Roman" Size="10pt" Bold="True" />
            <BorderStyle Top="None" Bottom="None" Left="None" Right="None" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
            <Padding Top="0pt" Bottom="0pt" />
          </Style>
        </TextBox>
        <TextBox Width="3.3cm" Height="0.6cm" Left="13.5cm" Top="4.068cm" Value="= CDate(Fields.TrDt)" Format="{0:dd/MM/yyyy}" Multiline="False" Culture="uk" Name="textBox69">
          <Style TextAlign="Right" VerticalAlign="Middle">
            <Font Name="Times New Roman" Size="9pt" Bold="True" />
            <BorderStyle Top="None" Bottom="None" Left="None" Right="None" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="12.38cm" Height="0.6cm" Left="2.5cm" Top="4.768cm" Value="=Fields.M_TenantNm" Name="textBox70">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Name="Times New Roman" Size="10pt" Bold="True" Underline="False" />
            <BorderStyle Top="None" Bottom="None" Left="None" Right="None" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="7.464cm" Height="0.5cm" Left="8.8cm" Top="7.268cm" Value="=Fields.Unts_Dscrs" Name="textBox2">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Name="Times New Roman" Size="9pt" Bold="True" Underline="False" />
            <BorderStyle Top="None" Bottom="None" Left="None" Right="None" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="9.454cm" Height="0.6cm" Left="7.332cm" Top="8.068cm" Value="=Fields.Nots" Name="textBox72">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Name="Times New Roman" Size="12pt" Bold="True" />
            <BorderStyle Top="None" Bottom="None" Left="None" Right="None" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="2.7cm" Height="0.5cm" Left="1.1cm" Top="7.368cm" Value="=Fields.M_BldDscr" Name="textBox71">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Name="Times New Roman" Size="9pt" Bold="True" Underline="False" />
            <BorderStyle Top="None" Bottom="None" Left="None" Right="None" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
      </Items>
    </DetailSection>
    <PageFooterSection Height="0.4cm" Name="pageFooterSection1" />
  </Items>
  <PageSettings PaperKind="Custom" PaperSize="210mm, 150mm" Landscape="False" ContinuousPaper="False">
    <Margins>
      <MarginsU Left="0.3cm" Right="0.3cm" Top="1cm" Bottom="0.5cm" />
