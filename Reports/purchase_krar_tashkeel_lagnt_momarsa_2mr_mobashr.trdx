<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource1" Width="17cm" Name="قرار_تشكيل_لجنه_ممارسه_محدودة" Zoom="1.5" xmlns="http://schemas.telerik.com/reporting/2023/1.0">
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="azxsandoaa" SelectCommand=";WITH AllMembers AS (&#xA;    -- 🔹 الأعضاء الداخليين&#xA;    SELECT DISTINCT&#xA;        A.TR_NO,&#xA;        A.PURCHAS_NO,   -- ✅ إضافة&#xA;        A.MTNG_DT_PRCHS, &#xA;        A.FNCL_TR_NO,&#xA;        A.TR_DT,&#xA;        A.Acc_Nm,&#xA;        Boss.EMP_NAME AS Boss,&#xA;        JobBoss.DSCR_AR AS Boss_dsc,&#xA;        (SELECT DSCR_AR FROM AZLISTS WHERE REC_TYPE = 61 AND CODE = A.NT_EXTRNL_MMBR_PRCHS) AS memper_dwla,&#xA;        E.EMP_NAME AS MemberName,&#xA;        E.JOB_CD&#xA;    FROM AZTRH A&#xA;    LEFT JOIN PYEMPMF_H AS Boss&#xA;        ON Boss.EMP_NO = A.CMMTTE_CHRMN_PRCHS    &#xA;    LEFT JOIN pyx_sandoaa..AppCodes AS JobBoss&#xA;        ON JobBoss.ID = 12 AND JobBoss.SEQ = Boss.JOB_CD&#xA;    OUTER APPLY (&#xA;        SELECT DISTINCT value &#xA;        FROM STRING_SPLIT(REPLACE(REPLACE(COALESCE(A.CMMTTE_INTRNL_MMBRS_PRCHS, ''), '''', ''), '&quot;', ''), ',')&#xA;        WHERE value &lt;&gt; '' AND ISNUMERIC(value) = 1&#xA;    ) AS S&#xA;    LEFT JOIN PYEMPMF_H AS E&#xA;        ON TRY_CAST(S.value AS INT) = E.EMP_NO&#xA;    WHERE A.TR_TY = '112'&#xA;      AND A.CMMTTE_INTRNL_MMBRS_PRCHS IS NOT NULL&#xA;      AND A.CMMTTE_INTRNL_MMBRS_PRCHS &lt;&gt; ''&#xA;      AND E.EMP_NAME IS NOT NULL&#xA;&#xA;    UNION ALL&#xA;&#xA;    -- 🔹 الأعضاء الخارجيين&#xA;    SELECT DISTINCT&#xA;        A.TR_NO,&#xA;        A.PURCHAS_NO,   -- ✅ إضافة&#xA;        A.MTNG_DT_PRCHS,&#xA;        A.FNCL_TR_NO,&#xA;        A.TR_DT,&#xA;        A.Acc_Nm,&#xA;        Boss.EMP_NAME AS Boss,&#xA;        JobBoss.DSCR_AR AS Boss_dsc,&#xA;        (SELECT DSCR_AR FROM AZLISTS WHERE REC_TYPE = 61 AND CODE = A.NT_EXTRNL_MMBR_PRCHS) AS memper_dwla,&#xA;        L.DSCR_AR AS MemberName,&#xA;        NULL AS JOB_CD&#xA;    FROM AZTRH A&#xA;    LEFT JOIN PYEMPMF_H AS Boss&#xA;        ON Boss.EMP_NO = A.CMMTTE_CHRMN_OPN&#xA;    LEFT JOIN pyx_sandoaa..AppCodes AS JobBoss&#xA;        ON JobBoss.ID = 12 AND JobBoss.SEQ = Boss.JOB_CD&#xA;    OUTER APPLY (&#xA;        SELECT DISTINCT value &#xA;        FROM STRING_SPLIT(REPLACE(REPLACE(COALESCE(A.NT_EXTRNL_MMBR_PRCHS, ''), '''', ''), '&quot;', ''), ',')&#xA;        WHERE value &lt;&gt; '' AND ISNUMERIC(value) = 1&#xA;    ) AS S&#xA;    LEFT JOIN AZLISTS AS L&#xA;        ON TRY_CAST(S.value AS INT) = L.CODE&#xA;    WHERE A.TR_TY = '112'&#xA;      AND A.NT_EXTRNL_MMBR_PRCHS IS NOT NULL&#xA;      AND A.NT_EXTRNL_MMBR_PRCHS &lt;&gt; ''&#xA;      AND L.DSCR_AR IS NOT NULL &#xA;      AND L.REC_TYPE = 61&#xA;),&#xA;&#xA;WithJobName AS (&#xA;    SELECT DISTINCT&#xA;        A.TR_NO,&#xA;        A.PURCHAS_NO,   -- ✅&#xA;        A.FNCL_TR_NO,&#xA;        A.MTNG_DT_PRCHS,&#xA;        A.TR_DT,&#xA;        A.Acc_Nm,&#xA;        A.Boss,&#xA;        A.Boss_dsc,&#xA;        A.memper_dwla,&#xA;        A.MemberName,&#xA;        J.DSCR_AR AS JobName&#xA;    FROM AllMembers A&#xA;    LEFT JOIN pyx_sandoaa..AppCodes J&#xA;        ON J.ID = 12&#xA;        AND J.SEQ = A.JOB_CD&#xA;    WHERE A.MemberName IS NOT NULL&#xA;),&#xA;&#xA;Numbered AS (&#xA;    SELECT&#xA;        TR_NO,&#xA;        PURCHAS_NO,   -- ✅&#xA;        FNCL_TR_NO,&#xA;        MTNG_DT_PRCHS,&#xA;        TR_DT,&#xA;        Acc_Nm,&#xA;        Boss,&#xA;        Boss_dsc,&#xA;        memper_dwla,&#xA;        MemberName,&#xA;        JobName,&#xA;        ROW_NUMBER() OVER (PARTITION BY TR_NO ORDER BY MemberName) AS rn&#xA;    FROM WithJobName&#xA;),&#xA;&#xA;ItemsCTE AS (&#xA;    SELECT &#xA;        D.TR_NO,&#xA;        STRING_AGG(I.ITM_NM_AR, N' - ') AS ItemsNames&#xA;    FROM AZTRD D&#xA;    LEFT JOIN AZITMS I ON I.ITM_CD = D.ITM_CD&#xA;    WHERE D.TR_TY = '112'&#xA;    GROUP BY D.TR_NO&#xA;),&#xA;&#xA;FinalResult AS (&#xA;    SELECT&#xA;        N.TR_NO,&#xA;        N.PURCHAS_NO,   -- ✅&#xA;        N.FNCL_TR_NO,&#xA;        N.TR_DT,&#xA;        N.MTNG_DT_PRCHS,&#xA;        N.Acc_Nm,&#xA;        N.Boss,&#xA;        N.Boss_dsc,&#xA;        N.memper_dwla,&#xA;        IT.ItemsNames,&#xA;        MAX(CASE WHEN N.rn = 1 THEN N.MemberName END) AS Member1,&#xA;        MAX(CASE WHEN N.rn = 1 THEN N.JobName END) AS Job1,&#xA;        MAX(CASE WHEN N.rn = 2 THEN N.MemberName END) AS Member2,&#xA;        MAX(CASE WHEN N.rn = 2 THEN N.JobName END) AS Job2,&#xA;        MAX(CASE WHEN N.rn = 3 THEN N.MemberName END) AS Member3,&#xA;        MAX(CASE WHEN N.rn = 3 THEN N.JobName END) AS Job3,&#xA;        MAX(CASE WHEN N.rn = 4 THEN N.MemberName END) AS Member4,&#xA;        MAX(CASE WHEN N.rn = 4 THEN N.JobName END) AS Job4&#xA;    FROM Numbered N&#xA;    LEFT JOIN ItemsCTE IT ON IT.TR_NO = N.TR_NO&#xA;    GROUP BY&#xA;        N.TR_NO,&#xA;        N.PURCHAS_NO,&#xA;        N.FNCL_TR_NO,&#xA;        N.TR_DT,&#xA;        N.MTNG_DT_PRCHS,&#xA;        N.Acc_Nm,&#xA;        N.Boss,&#xA;        N.Boss_dsc,&#xA;        N.memper_dwla,&#xA;        IT.ItemsNames&#xA;)&#xA;&#xA;SELECT TOP 1&#xA;    PURCHAS_NO,   -- ✅&#xA;    FNCL_TR_NO,&#xA;    TR_DT,&#xA;    MTNG_DT_PRCHS,&#xA;    Acc_Nm,&#xA;    Boss,&#xA;    Boss_dsc,&#xA;    memper_dwla,&#xA;    ItemsNames,&#xA;    Member1,&#xA;    Job1,&#xA;    Member2,&#xA;    Job2,&#xA;    Member3,&#xA;    Job3,&#xA;    Member4,&#xA;    Job4&#xA;FROM FinalResult&#xA;WHERE Member1 IS NOT NULL&#xA;ORDER BY FNCL_TR_NO DESC, TR_DT DESC;" Name="sqlDataSource1" />
  </DataSources>
