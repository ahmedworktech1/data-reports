<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource1" Width="20cm" Name="Empty units data report-45" ShowSnapGrid="True" xmlns="http://schemas.telerik.com/reporting/2021/1.0">
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="AQArbid3" SelectCommand="SELECT TOP (100) PERCENT dbo.BLDMF.BLD_CD, dbo.UNTMF.UNT_CD, dbo.UNTMF.UNT_DSCR_AR, dbo.UNTMF.UNT_FLOOR, dbo.UNTMF.UNT_STATE, &#xD;&#xA;                      dbo.UNTMF.UNT_RENT, dbo.UNTMF.TENANT_NO, dbo.UNTMF.DOC_NO, dbo.UNTMF.DOC_EDT, dbo.UNTMF.AMT_RENT, dbo.BLDMF.BLD_DSCR_AR, &#xD;&#xA;                      dbo.tenantMF.TENANT_Nm_AR, &#xD;&#xA;                      CASE WHEN [UNTMF].[UNT_STATE] = 1 THEN ' خالية' ELSE CASE WHEN [UNTMF].[UNT_STATE] = 2 THEN 'محجوزة ' ELSE CASE WHEN [UNTMF].[UNT_STATE] = 3 THEN 'مؤجرة '&#xD;&#xA;                       ELSE CASE WHEN [UNTMF].[UNT_STATE] = 4 THEN 'صيانة ' END END END END AS STATE, dbo.AQLISTS.REC_TYPE, dbo.AQLISTS.DSCR_AR, dbo.UNTMF.ID_NO&#xD;&#xA;FROM dbo.UNTMF &#xD;&#xA;INNER JOIN dbo.BLDMF ON dbo.UNTMF.BLD_CD = dbo.BLDMF.BLD_CD &#xD;&#xA;INNER JOIN dbo.AQLISTS ON dbo.UNTMF.UNT_FLOOR = dbo.AQLISTS.CODE &#xD;&#xA;LEFT OUTER JOIN dbo.tenantMF ON dbo.UNTMF.TENANT_NO = dbo.tenantMF.TENANT_NO&#xD;&#xA;WHERE 1=1&#xD;&#xA;GROUP BY dbo.BLDMF.BLD_CD, dbo.UNTMF.UNT_CD, dbo.UNTMF.UNT_DSCR_AR, dbo.UNTMF.UNT_FLOOR, dbo.UNTMF.UNT_STATE, dbo.UNTMF.UNT_RENT, &#xD;&#xA;                      dbo.UNTMF.TENANT_NO, dbo.UNTMF.DOC_NO, dbo.UNTMF.DOC_EDT, dbo.UNTMF.AMT_RENT, dbo.BLDMF.BLD_DSCR_AR, dbo.tenantMF.TENANT_Nm_AR, &#xD;&#xA;                      dbo.AQLISTS.REC_TYPE, dbo.AQLISTS.DSCR_AR, dbo.UNTMF.ID_NO&#xD;&#xA;HAVING (dbo.AQLISTS.REC_TYPE = 12) &#xD;&#xA;ORDER BY dbo.BLDMF.BLD_CD;&#xD;&#xA;" Name="sqlDataSource1" />
  </DataSources>
