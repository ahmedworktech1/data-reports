        </TextBox>
        <TextBox Width="7.118cm" Height="0.5cm" Left="11.4cm" Top="2.9cm" Value="تعتبر الملاحق التالية والمرفقة بهذا العقد جزءاً لا يتجزأ منه :" Name="textBox141">
