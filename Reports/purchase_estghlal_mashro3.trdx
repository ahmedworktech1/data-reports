        </TextBox>
        <TextBox Width="8.792cm" Height="0.5cm" Left="10.226cm" Top="42.291cm" Value="6 - أدخل الشكل القانونى للشخص الاعتبارى (شركة/ نقابة/ جمعية/....إلخ)." Name="textBox97">
