        <TextBox Width="11.087cm" Height="0.5cm" Left="7.931cm" Top="42.791cm" Value="7 - يقصد بالشكل القانونى (شركة مساهمة/ شركة توصية بسيطة/ شركة شخص واحد/....إلخ)." Name="textBox96">
