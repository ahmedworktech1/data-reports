          </Style>
        </TextBox>
        <TextBox Width="0.865cm" Height="0.5cm" Left="17.7cm" Top="27.6cm" Value="وحتي" Name="textBox183">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.628cm" Height="0.5cm" Left="1.9cm" Top="28.2cm" Value="ويلتزم الطرف الثاني بسداد قيمة الترخيص بالاستغلال السنوية المنصوص عليها بالبند ( السادس ) مُضافاً إليها قيمة الزيادة التراكمية السنوية" Name="textBox184">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="2.323cm" Height="0.5cm" Left="16.205cm" Top="28.752cm" Value="المقررة وذلك في (" Name="textBox185">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="6.312cm" Height="0.5cm" Left="7.1cm" Top="28.752cm" Value=") المنصوص عليها بشروط الطرح , وذلك الحساب رقم" Name="textBox186">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="0.828cm" Height="0.5cm" Left="17.7cm" Top="29.4cm" Value="بالبنك " Name="textBox187">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.725cm" Height="0.5cm" Left="1.84cm" Top="30cm" Value="ويلتزم المتعاقد قبل نهاية الشهر التاسع من السنة الأولي والسنوات التي تليها تقديم خطاب بنكي بالقيمة المستحقة عن السنة التالية , علي أن يكون" Name="textBox188">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.725cm" Height="0.5cm" Left="1.84cm" Top="30.6cm" Value="خطال الضمان ساري لمدة شهر بعد انقضاء السنة التي يقوم خلالها التعاقد , وفي حالة عدم الالتزام بشروط السداد يتم اتخاذ الإجراءات المنصوص" Name="textBox189">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="5.065cm" Height="0.5cm" Left="13.5cm" Top="31.2cm" Value="عنها بالبند الثاني والعشرون من هذا العقد .&#xD;&#xA;" Name="textBox190">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="1.647cm" Height="0.4cm" Left="8.9cm" Top="31.91cm" Value="البند الثامن" Name="textBox191">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="4.865cm" Height="0.5cm" Left="13.7cm" Top="32.4cm" Value="سدد الطرف الثاني مبلغاً إجمالياً مقداره (" Name="textBox192">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="1.747cm" Height="0.5cm" Left="8.8cm" Top="32.4cm" Value=")( فقط وقدره" Name="textBox193">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="3.152cm" Height="0.5cm" Left="2.2cm" Top="32.4cm" Value=") بما يعادل نسبة (10%)" Name="textBox194">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="12.365cm" Height="0.5cm" Left="6.2cm" Top="33cm" Value="(من إجمالي هذا العقد / من اجمالي هذا العقد عن الثلاث سنوات الأولي ) كتأمين نهائي , وذلك بالحساب رقم " Name="textBox195">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="0.865cm" Height="0.5cm" Left="17.7cm" Top="33.6cm" Value="بالبنك" Name="textBox196">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="2.7cm" Height="0.5cm" Left="12.4cm" Top="33.6cm" Value="أو بخطاب الضمان رقم " Name="textBox197">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="1.7cm" Height="0.5cm" Left="7.8cm" Top="33.6cm" Value="صادر من بنك" Name="textBox198">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="3.612cm" Height="0.5cm" Left="1.84cm" Top="33.6cm" Value="ويظل التأمين سارياً طوال مدة" Name="textBox199">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.725cm" Height="0.5cm" Left="1.84cm" Top="34.2cm" Value="العقد قبل بداية الثلاث سنوات التالية أو الفترة المتبقية من العقد أيهما أقل إذا كانت مدته أكثر من ثلاث سنوات , علي أن تراعي الزيادة السنوية في قيمة" Name="textBox200">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="4.383cm" Height="0.5cm" Left="14.2cm" Top="34.8cm" Value="قيمة التعاقد المنصوص عليها بالعقد ." Name="textBox201">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="7.378cm" Height="0.5cm" Left="11.205cm" Top="35.9cm" Value="اتفق الطرفان علي إتباع الإجراءات التالية في حالة تعديل العقد ." Name="textBox202">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="1.647cm" Height="0.4cm" Left="9.126cm" Top="35.4cm" Value="البند التاسع" Name="textBox203">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="1.647cm" Height="0.4cm" Left="9.126cm" Top="36.8cm" Value="البند العاشر" Name="textBox204">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="7.065cm" Height="0.5cm" Left="11.5cm" Top="37.4cm" Value="يلتزم الطرف الثاني بالبدي في تنفيذ التزاماته في موعد أقصاه" Name="textBox205">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="6.765cm" Height="0.5cm" Left="2.2cm" Top="37.4cm" Value="من تاريخ بدء نفاذ العقد ووفقاً للاشتراطات الواردة بكراسة" Name="textBox206">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="15.983cm" Height="0.5cm" Left="2.6cm" Top="38cm" Value="الشروط والمواصفات , وإذا تأخر الطرف الثاني في بدء تنفيذ التزاماته عن الموعد سالف البيان يكون للطرف الأول الحق في توقيع الجزاءات الواردة بالبند الثاني والعشرون من هذا العقد" Name="textBox207">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="5.383cm" Height="0.5cm" Left="13.2cm" Top="38.6cm" Value="الواردة بالبند الثاني والعشرون من هذا العقد ." Name="textBox208">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="9.265cm" Height="0.5cm" Left="9.3cm" Top="39.2cm" Value="21 - الالتزام بحكم المادة (40) من القانون والمادة (95) من اللائحة التنفيذية." Name="textBox209">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="8.765cm" Height="0.5cm" Left="9.8cm" Top="39.8cm" Value="22 - فى حال ما إذا كانت الجهة الإدارية/شروط الطرح تسمح بمد مدة العقد." Name="textBox210">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="3.065cm" Height="0.5cm" Left="15.5cm" Top="40.4cm" Value="23 - أدخل تاريخ السداد." Name="textBox212">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="11.365cm" Height="0.5cm" Left="7.2cm" Top="41cm" Value="24 - فى العقود التى تزيد مدتها عن أكثر من سنة، وتنفيذاً لحكم المادة (95) من اللائحة التنفيذية." Name="textBox211">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="7.165cm" Height="0.5cm" Left="11.4cm" Top="41.6cm" Value="25 - إجراءات فسخ العقد وفقاً لحكم المادة (51) من القانون." Name="textBox214">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="14.519cm" Height="0.5cm" Left="4.046cm" Top="42.2cm" Value="26 - نسبة التأمين النهائى محددة بالمادة (40) من القانون، كما نظمت المادة (95) من اللائحة التنفيذية تحصيل المستحقات." Name="textBox213">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.365cm" Height="0.5cm" Left="2.2cm" Top="42.8cm" Value="27 - على الجهة الإدارية مراعاة حكم المادة (46) من القانون وتضمين كراسة الشروط والمواصفات إجراءات تعديل العقد وفقاً لطبيعة العملية." Name="textBox217">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="5.565cm" Height="0.5cm" Left="13cm" Top="43.4cm" Value="28 - أدخل التاريخ المتفق عليه بشروط الطرح." Name="textBox216">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.265cm" Height="0.5cm" Left="2.3cm" Top="44.8cm" Value="يسأل الطرف الثانى عن أية مخالفات تقع لأحكام القوانين واللوائح أو عن سلامة محل هذا العقد ولايجوز له أو للغير الرجوع على الطرف الأول " Name="textBox215">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="2.811cm" Height="0.4cm" Left="8.389cm" Top="44.3cm" Value="البند الحادي عشر" Name="textBox218">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.265cm" Height="0.5cm" Left="2.3cm" Top="45.4cm" Value="بالتعويض عن أية أضرار تترتب نتيجة عدم سلامته أو غير ذلك، ويلتزم الطرف الثانى على نفقته بإجراء ما يلزم من تحسينات وصيانة مستمرة" Name="textBox219">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.665cm" Height="0.5cm" Left="1.918cm" Top="46cm" Value="لمحل هذا العقد ضماناً لإعادته للطرف الأول بحالة جيدة فى نهاية مدة التعاقد، وفى حالة تلف أو هلاك محل العقد يلتزم المتعاقدالمتعاقد بسداد القيمة" Name="textBox221">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="14.383cm" Height="0.5cm" Left="4.2cm" Top="46.6cm" Value="التى تقدرها الجهة الإدارية دون اعتراض أو اللجوء للقضاء ويتم خصمها من مستحقاته لدى الجهة أو أى جهة إدارية أخرى." Name="textBox220">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="14.141cm" Height="0.5cm" Left="4.442cm" Top="47.2cm" Value="ويؤول محل العقد وما تم إضافته من قبل الطرف الثانى من تحسينات وغيرها للطرف الأول دون مقابل نهائياً بانتهاء التعاقد." Name="textBox225">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.683cm" Height="0.5cm" Left="1.918cm" Top="51cm" Value="يلتزم الطرف الثانى باستخدام محل هذا العقد فى الغرض الذى تم الترخيص باستغلاله من أجله ويعتبر هذا العقد مفسوخاً من تلقاء نفسه دون الحاجة" Name="textBox224">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.701cm" Height="0.5cm" Left="1.9cm" Top="51.6cm" Value="إلى اتخاذ أى إجراء حال مخالفة الطرف الثانى لذلك مع حق الطرف الأول فى التعويض إن كان له مقتضى، كما يسقط حق الطرف الثانى فى استرداد" Name="textBox223">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.401cm" Height="0.5cm" Left="2.2cm" Top="52.2cm" Value="أية مبالغ سبق سدادها، ويسترد الطرف الأول محل التعاقد علاوة على ما أضافه الطرف الثانى من تجهيزات وأعمال تطوير وصيانة مستمرة عليه" Name="textBox222">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="2.811cm" Height="0.4cm" Left="8.389cm" Top="48.1cm" Value="البند الثاني عشر" Name="textBox226">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.265cm" Height="0.5cm" Left="2.318cm" Top="48.6cm" Value="أقر الطرف الثانى بأنه عاين محل هذا العقد المعاينة التامة النافية للجهالة شرعاً وأنه قبل استغلاله بحالته الراهنة دون أن يحق له الرجوع على" Name="textBox227">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="13.457cm" Height="0.5cm" Left="5.126cm" Top="49.2cm" Value="الطرف الأول بالتعويض عن أية أضرار تترتب نتيجة عدم سلامته أو عن تعرض الغير له أو أى عيب خفى أو غير ذلك." Name="textBox228">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="2.811cm" Height="0.4cm" Left="8.389cm" Top="50.5cm" Value="البند الثالث عشر" Name="textBox229">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="2.096cm" Height="0.5cm" Left="16.505cm" Top="52.8cm" Value="وذلك دون مقابل." Name="textBox230">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.743cm" Height="0.5cm" Left="1.858cm" Top="53.7cm" Value="كما يلتزم الطرف الثانى بعدم التصرف فى محل هذا العقد بأى نوع من أنواع التصرفات أو التعامل عليه بأى صورة من صور التعامل أو أى جزء منه" Name="textBox231">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.301cm" Height="0.5cm" Left="2.3cm" Top="54.3cm" Value="منه ويعد هذا التصرف غير نافذ فى مواجهة الطرف الأول ولا يجوز شهر محرره ، مع حق الطرف الأول فى توقيع الجزاءات الواردة بالبند الثانى" Name="textBox232">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="3.801cm" Height="0.5cm" Left="14.8cm" Top="54.9cm" Value="الثانى والعشرون من هذا العقد." Name="textBox233">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="2.811cm" Height="0.4cm" Left="8.389cm" Top="55.9cm" Value="البند الرابع عشر" Name="textBox234">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="4.401cm" Height="0.5cm" Left="14.2cm" Top="56.4cm" Value="كلف الطرف الأول ( السيد / السيدة )" Name="textBox236">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="7.102cm" Height="0.5cm" Left="11.5cm" Top="74.9cm" Value="بشروط العقد ودون الإخلال بأية عقوبة مقررة فى هذا الشأن." Name="textBox235">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.202cm" Height="0.5cm" Left="2.4cm" Top="59.9cm" Value="وفي حالة اكتشاف مخالفة الطرف الثاني لالتزاماته يحق للطرف الأول توقيع أي من الجزاءات المنصوص عليها في البند الثاني والعشرون من" Name="textBox238">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="4.494cm" Height="0.5cm" Left="1.918cm" Top="57cm" Value="مسئولا / مسئولة عن إدارة هذا العقد .&#xD;&#xA;" Name="textBox237">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.092cm" Height="0.5cm" Left="2.509cm" Top="84.666cm" Value="أو تنفيذه على حساب الطرف الثانى كما يكون للطرف الأول أن يخصم ما يستحقه وقيمة كل خسارة تلحق به من أى مبالغ مستحقة أو تستحق" Name="textBox242">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.702cm" Height="0.5cm" Left="1.899cm" Top="85.893cm" Value="حاجة إلى اتخاذ أى إجراءات قضائية، وذلك كله مع عدم الإخلال بحق الطرف الأول فى الرجوع على الطرف الثانى قضائياً بما لم يتمكن من استيفائه" Name="textBox241">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.702cm" Height="0.5cm" Left="1.899cm" Top="86.506cm" Value="من حقوق بالطريق الإدارى، ولا يحق للطرف الثانى المطالبة باسترداد ما سبق سداده، ولا قيمة ما أضافه من تجهيزات وأعمال تطوير وغيرها إلي محل" Name="textBox240">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="1.401cm" Height="0.5cm" Left="17.2cm" Top="87.119cm" Value="هذا العقد ." Name="textBox239">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="4.744cm" Height="0.5cm" Left="13.857cm" Top="88.993cm" Value="يفسخ هذا العقد تلقائياً فى الحالات الآتية:" Name="textBox243">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="15.301cm" Height="0.5cm" Left="3.3cm" Top="89.693cm" Value="1 - إذا تبين أن الطرف الثانى استعمل بنفسه أو بواسطة غيره الغش أو التلاعب فى تعامله مع الطرف الأول أو فى حصوله على العقد." Name="textBox244">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="10.001cm" Height="0.5cm" Left="8.6cm" Top="90.293cm" Value="2 - إذا تبين وجود تواطؤ أو ممارسات احتيال أو فساد أو احتكار من قبل الطرف الثانى." Name="textBox245">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.401cm" Height="0.5cm" Left="2.2cm" Top="92.033cm" Value="سرى على هذا العقد أحكام قانون تنظيم التعاقدات التى تبرمها الجهات العامة الصادر بالقانون رقم 182 لسنة 2018 ولائحته التنفيذية الصادرة " Name="textBox247">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="10.801cm" Height="0.5cm" Left="7.8cm" Top="92.633cm" Value="بقرار وزير المالية رقم 692 لسنة 2019، وذلك فيما لم يرد بشأنه نص خاص فى هذا العقد." Name="textBox248">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="2.202cm" Height="0.5cm" Left="16.4cm" Top="57cm" Value="بموجب القرار رقم" Name="textBox249">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="2.811cm" Height="0.4cm" Left="8.389cm" Top="58.1cm" Value="البند الخامس عشر" Name="textBox250">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.596cm" Height="0.5cm" Left="2.005cm" Top="58.7cm" Value="أقر الطرف الثاني بحق الطرف الأول في أن يقوم بنفسه أو بواسطة أي شخص أو جهة يحددها الطرف الأول في المرور أو التفتيش علي محل هذا العقد" Name="textBox251">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="1.501cm" Height="0.5cm" Left="17.1cm" Top="60.5cm" Value="هذا العقد ." Name="textBox252">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="1.401cm" Height="0.5cm" Left="11.005cm" Top="57cm" Value="الصادر في " Name="textBox253">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="5.601cm" Height="0.5cm" Left="13cm" Top="62.8cm" Value="يقر الطرف الثاني بأن الغرض من هذا العقد هو" Name="textBox254">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="6.565cm" Height="0.5cm" Left="1.758cm" Top="62.8cm" Value=" والمواصفات ويلتزم بالتعاون والتنسيق مع الطرف الأول " Name="textBox255">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="6.502cm" Height="0.5cm" Left="12.1cm" Top="64.7cm" Value="٢٩ - الالتزام بحكم المادة (١٥٠) من اللائحة التنفيذية." Name="textBox256">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="6.601cm" Height="0.5cm" Left="12cm" Top="59.3cm" Value="العقد وفي أي وقت دون حاجه الي إخطار أو أذن مسبق ." Name="textBox257">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.375cm" Height="0.5cm" Left="2.227cm" Top="65.3cm" Value="30 - إعمالاً لحكم المادة (87) من اللائحة التنفيذية لقانون تنظيم التعاقدات التى تبرمها الجهات العامة الصادر بالقانون رقم 182 لسنة 2018." Name="textBox258">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="7.902cm" Height="0.5cm" Left="10.7cm" Top="65.9cm" Value="31 - مراجعة مضمون هذا البند بما يتماشى مع طبيعة محل التعاقد." Name="textBox259">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.702cm" Height="0.5cm" Left="1.9cm" Top="66.5cm" Value="32- يتعين على السلطة المختصة بالجهة الإدارية إصدار قرار بتكليف من تراه مناسباً من ذوى الخبرة بالجهة الإدارية لإدارة العقد وذلك التزاماً" Name="textBox260">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="5.244cm" Height="0.5cm" Left="13.358cm" Top="67.1cm" Value="وذلك بحكم المادة (87) من اللائحة التنفيذية." Name="textBox261">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.683cm" Height="0.5cm" Left="1.918cm" Top="69.4cm" Value="يتعين علي الطرف الثاني مراعاة كافة القوانين واللوائح والتعليمات والقواعد المعمول بها ذات الصلة بمحل التعاقد سواء كانت سابقة أو لاحقة علي" Name="textBox262">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="1.501cm" Height="0.5cm" Left="17.1cm" Top="70cm" Value="إبرام العقد ." Name="textBox263">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.744cm" Height="0.5cm" Left="1.858cm" Top="79cm" Value="أقر الطرف الثانى عند توقيعه على هذا العقد بعدم صدور أحكام نهائية ضده فى إحدى الجرائم المنصوص عليها فى الباب الرابع من الكتاب الثانى من" Name="textBox264">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="7.302cm" Height="0.5cm" Left="11.3cm" Top="79.6cm" Value="قانون العقوبات، أو فى جرائم (التهرب الضريبى، أو الجمركى)." Name="textBox265">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="13.567cm" Height="0.5cm" Left="5.035cm" Top="81.773cm" Value="يلتزم الطرف الثانى بتحمل كافة الضرائب أو الرسوم أو غيرها التى تستحق على هذا العقد فى مواعيدها المحددة قانوناً." Name="textBox266">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.702cm" Height="0.5cm" Left="1.899cm" Top="84.053cm" Value="فى حالة إخلال الطرف الثانى بالتزامه بسداد قيمة الترخيص بالاستغلال السنوية، أو أخل بأى شرط من شروط التعاقد، يحق للطرف الأول فسخ العقد" Name="textBox267">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.583cm" Height="0.5cm" Left="2cm" Top="85.279cm" Value="للطرف الثانى لديه، وفى حالة عدم كفايتها يلجأ الطرف الأول إلى خصمها من مستحقاته لدى أى جهة إدارية أخرى أياً كان سبب الاستحقاق، دون" Name="textBox268">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="2.811cm" Height="0.4cm" Left="8.389cm" Top="62.2cm" Value="البند السادس عشر" Name="textBox269">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="2.601cm" Height="0.5cm" Left="16cm" Top="63.4cm" Value="لتحقيق هذا الغرض ." Name="textBox270">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="10.213cm" Height="0.5cm" Left="8.389cm" Top="76.8cm" Value="يحظر على الطرف الثانى التنازل للغير عن العقد كلياً أو جزئياً أو التصرف فيه بأى وجه." Name="textBox271">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="10.212cm" Height="0.5cm" Left="8.389cm" Top="71.9cm" Value="للقوانين واللوائح المتعلقة بها، ويلتزم بكافة الرسوم والمصاريف والالتزامات ذات الصلة." Name="textBox272">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.761cm" Height="0.5cm" Left="1.841cm" Top="73.7cm" Value="يلتزم الطرف الثانى والعاملين لديه بالمحافظة على سرية وخصوصية ما يحصلون عليه من معلومات ومستندات أياً كانت طبيعتها تكون متعلقة بالعقد" Name="textBox273">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.001cm" Height="0.5cm" Left="2.6cm" Top="74.3cm" Value="ويتعهد بعدم إفشائها للغير وذلك طوال مدة سريان العقد أو بعد انتهائه أو فسخه، ويعد الإخلال بمبدأ السرية والخصوصية بمثابة إخلالاً جسيماً" Name="textBox274">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.683cm" Height="0.5cm" Left="1.918cm" Top="71.3cm" Value="يلتزم الطرف الثانى بالحصول على كافة الموافقات الإدارية والقانونية اللازمة من جهات الاختصاص لتمكنه من مزاولة مهامه الواردة بالعقد طبقاً" Name="textBox275">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.742cm" Height="0.5cm" Left="1.841cm" Top="94.693cm" Value="يتم تسوية المنازعات والخلافات التى تنشأ أثناء التنفيذ وفقاً للطرق والشروط والأحكام المنصوص عليها فى المادة (91) من قانون تنظيم التعاقدات " Name="textBox276">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.578cm" Height="0.5cm" Left="2.005cm" Top="95.293cm" Value="التى تبرمها الجهات العامة الصادر بالقانون رقم 182 لسنة 2018، مع مراعاة ضرورة الحصول على موافقة الوزير المختص فى حالة اللجوء" Name="textBox277">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="1.588cm" Height="0.5cm" Left="16.995cm" Top="95.893cm" Value="إلى التحكيم." Name="textBox278">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="9.583cm" Height="0.5cm" Left="9cm" Top="96.493cm" Value="(إذا كان المتعاقد معه شخصاً طبيعياً أو اعتبارياً خاصاً يكون البند على النحو التالى)" Name="textBox279">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="9.983cm" Height="0.5cm" Left="8.6cm" Top="97.093cm" Value="تختص محاكم مجلس الدولة دون غيرها بالفصل فى أى نزاع ينشأ عن تنفيذ هذا العقد." Name="textBox280">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="9.457cm" Height="0.5cm" Left="9.126cm" Top="97.693cm" Value="(إذا كان المتعاقد معه شخصاً طبيعياً أو اعتبارياً عاماً يكون البند على النحو التالى)" Name="textBox281">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="15.483cm" Height="0.5cm" Left="3.1cm" Top="98.293cm" Value="تختص الجمعية العمومية لقسمى الفتوى والتشريع بمجلس الدولة بالفصل فى كافة المنازعات التى قد تنشأ عن تنفيذ أو تفسير هذا العقد." Name="textBox282">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="6.001cm" Height="0.5cm" Left="12.6cm" Top="103.813cm" Value="هذا العنوان صحيحة ومنتجة لكافة آثارها القانونية." Name="textBox283">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="2.811cm" Height="0.4cm" Left="8.389cm" Top="70.8cm" Value="البند السابع عشر" Name="textBox285">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="2.811cm" Height="0.4cm" Left="8.389cm" Top="73.2cm" Value="البند الثامن عشر" Name="textBox286">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="2.811cm" Height="0.4cm" Left="8.389cm" Top="76.3cm" Value="البند التاسع عشر" Name="textBox287">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="1.846cm" Height="0.4cm" Left="8.8cm" Top="78.479cm" Value="البند العشرون" Name="textBox288">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="4.102cm" Height="0.4cm" Left="7.705cm" Top="81.266cm" Value="البند الحادي و العشرون" Name="textBox289">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="4.102cm" Height="0.4cm" Left="7.705cm" Top="83.506cm" Value="البند الثاني و العشرون" Name="textBox290">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="4.102cm" Height="0.4cm" Left="7.705cm" Top="88.4cm" Value="البند الثالث و العشرون" Name="textBox291">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="4.102cm" Height="0.4cm" Left="7.705cm" Top="91.526cm" Value="البند الرابع و العشرون" Name="textBox292">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="4.102cm" Height="0.4cm" Left="7.705cm" Top="94.186cm" Value="البند الخامس و العشرون" Name="textBox293">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.701cm" Height="0.5cm" Left="1.9cm" Top="102.11cm" Value="أقر الطرفان بأن العنوان المبين قرين كل منهما بصدر هذا العقد هو المحل المختار لهما، وأن جميع المكاتبات والمراسلات والإعلانات والإخطارات" Name="textBox294">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="7.596cm" Height="0.5cm" Left="11.005cm" Top="100.508cm" Value="يقبل الطرفان أى تعديلات قد يجريها مجلس الدولة على هذا العقد." Name="textBox295">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.374cm" Height="0.5cm" Left="2.227cm" Top="102.677cm" Value="التى توجه أو ترسل أو تعلن أو تخطر عليه تكون صحيحة ومنتجة لكافة آثارها القانونية، وفى حالة تغيير أحد الطرفين لعنوانه يتعين عليه إخطار" Name="textBox296">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.702cm" Height="0.5cm" Left="1.899cm" Top="103.245cm" Value="الطرف الآخر بهذا العنوان الجديد خلال خمسة عشر يوماً، بخطاب مسجل بعلم الوصول، وإلا اعتبرت مكاتباته ومراسلاته وإعلاناته وإخطاراته على" Name="textBox297">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.702cm" Height="0.5cm" Left="1.899cm" Top="105.713cm" Value="تحرر هذا العقد من أصل وأربعة نسخ، سلمت إحداها إلى الطرف الثانى، واحتفظ الطرف الأول بالأصل والنسخ الأخرى للعمل بمقتضاها عند اللزوم." Name="textBox299">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="4.102cm" Height="0.4cm" Left="7.705cm" Top="100.013cm" Value="البند السادس و العشرون" Name="textBox300">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="4.102cm" Height="0.4cm" Left="7.705cm" Top="101.533cm" Value="البند السابع و العشرون" Name="textBox301">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="4.102cm" Height="0.4cm" Left="7.705cm" Top="105.2cm" Value="البند الثامن و العشرون" Name="textBox302">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
      </Items>
    </DetailSection>
    <PageFooterSection Height="4.967cm" Name="pageFooterSection1">
      <Items>
        <TextBox Width="2.882cm" Height="0.4cm" Left="12.537cm" Top="0.492cm" Value="الطرف الأول المتعاقد" Name="textBox322">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="2.882cm" Height="0.4cm" Left="3.337cm" Top="0.492cm" Value="الطرف الثاني المتعاقد" Name="textBox321">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="0.955cm" Height="0.4cm" Left="16.037cm" Top="1.166cm" Value="الاسم :" Name="textBox320">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="1.308cm" Height="0.4cm" Left="15.755cm" Top="1.793cm" Value="الصفة :" Name="textBox319">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
