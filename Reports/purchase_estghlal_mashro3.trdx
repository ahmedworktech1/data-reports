        <TextBox Width="8.792cm" Height="0.5cm" Left="10.205cm" Top="43.791cm" Value="9 - أدخل سند الولاية (قرار/ أو البروتوكول/ أو غيرها) ورقمه وتاريخه." Name="textBox106">
