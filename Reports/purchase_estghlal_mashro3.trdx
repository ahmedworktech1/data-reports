        <TextBox Width="8.839cm" Height="0.5cm" Left="9.726cm" Top="18.163cm" Value="19 - فى حال ما إذا كانت الجهة الإدارية/شروط الطرح تسمح بمد مدة العقد." Name="textBox164">
