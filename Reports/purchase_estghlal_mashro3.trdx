        <TextBox Width="9.765cm" Height="0.5cm" Left="8.8cm" Top="5.963cm" Value="رخص الطرف الأول للطرف الثاني بكافة الضمانات القانونية والفعلية في الاستغلال بــ" Name="textBox129">
