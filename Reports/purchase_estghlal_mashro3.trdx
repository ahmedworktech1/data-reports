        </TextBox>
        <TextBox Width="11.087cm" Height="0.5cm" Left="7.478cm" Top="7.805cm" Value="وفقاً لكراسة الشروط والمواصفات , تكون المدة الأساسية للترخيص بالاستغلال لمحل هذا العقد (&#xD;&#xA;" Name="textBox146">
