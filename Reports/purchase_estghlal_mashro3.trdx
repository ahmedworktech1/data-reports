            <Font Size="10pt" Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="12.8cm" Height="0.5cm" Left="6.205cm" Top="36.5cm" Value="رقم 692 لسنة 2019 , والإعلان وكراسة الشروط والمواصفات المنشورين علي بوابة التعاقدات العامة بتاريخ" Name="textBox88">
