<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource1" Width="20cm" Name="طلب احتياج اعمال" Zoom="1.5" xmlns="http://schemas.telerik.com/reporting/2023/1.0">
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="azxsandoaa" SelectCommand="SELECT &#xD;&#xA;    AZTRd.CAROWNER,&#xD;&#xA;    azitms.itm_nm_ar AS 'اسم الصنف',&#xD;&#xA;    azitms.ITM_CLS1 AS 'مواصفات',&#xD;&#xA;    AZTRd.TR_DT, &#xD;&#xA;    AZTRd.ITM_CD,&#xD;&#xA;    AZTRd.QTY,  &#xD;&#xA;    Aztrd.LN_NO,&#xD;&#xA;    AZTRd.RMRK,&#xD;&#xA;    AZTRd.ENTEREDBY,&#xD;&#xA;    (SELECT Emp_Name FROM PYEMPMF_H WHERE PYEMPMF_H.emp_no = AZTRd.ENTEREDBY) AS nm,&#xD;&#xA;    AZPKGDEF.pk_nm_ar AS 'اسم الوحدة',&#xD;&#xA;    azlists.dscr_ar AS 'اسم الجهة الطالبة',&#xD;&#xA;    AZTRd.LOC,&#xD;&#xA;    AZTRd.TR_TY,&#xD;&#xA;    AZTRd.TR_NO,&#xD;&#xA;    CASE &#xD;&#xA;        WHEN AZTRd.sing = 3  THEN 'تدبير'&#xD;&#xA;        WHEN AZTRd.sing = 2  THEN 'صرف'&#xD;&#xA;        WHEN AZTRd.sing = -1 THEN 'ملغي'&#xD;&#xA;        WHEN AZTRd.sing = 0  THEN 'مؤجل'&#xD;&#xA;        WHEN AZTRd.sing = 5  THEN 'طلب صرف'&#xD;&#xA;&#xD;&#xA;    END AS sing_name&#xD;&#xA;FROM AZTRd &#xD;&#xA;LEFT JOIN azitms   ON azitms.itm_cd     = AZTRd.itm_cd&#xD;&#xA;LEFT JOIN AZPKGDEF ON AZPKGDEF.pkid     = AZTRd.pkid&#xD;&#xA;LEFT JOIN azlists  ON azlists.code      = AZTRd.CAROWNER AND azlists.REC_TYPE = '2'&#xD;&#xA;LEFT JOIN AZTRH    ON AZTRd.LOC         = AZTRH.LOC &#xD;&#xA;                  AND AZTRd.TR_TY       = AZTRH.TR_TY &#xD;&#xA;                  AND AZTRd.TR_NO       = AZTRH.TR_NO&#xD;&#xA;WHERE AZTRd.TR_TY = '333' AND (1=1)" Name="sqlDataSource1" />
  </DataSources>
