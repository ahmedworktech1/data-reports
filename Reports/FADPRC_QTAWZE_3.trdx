  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="GLXAssets" SelectCommand="select cst,[cst_nm],&#xD;&#xA;sum([s11]) as [s11]&#xD;&#xA;,sum([s112]) as [s112]&#xD;&#xA;,sum([s112s]) as [s112s]&#xD;&#xA;,sum([s112ss]) as [s112ss]&#xD;&#xA;,sum([s112tot])as [s112tot]&#xD;&#xA;,sum([s113tot]) as [s113tot]&#xD;&#xA;,sum([s114]) as [s114]&#xD;&#xA;,sum([s114s]) as [s114s]&#xD;&#xA;,sum([s114ss]) as [s114ss]&#xD;&#xA;,sum([s114ss]) as [s114ss]&#xD;&#xA;,sum([s114tot]) as [s114tot]&#xD;&#xA;,sum([s115tot]) as  [s115tot]&#xD;&#xA;,sum([s116]) as [s116]&#xD;&#xA;,sum([s116s]) as [s116s]&#xD;&#xA;,sum([s116ss]) as [s116ss]&#xD;&#xA;,sum([s116tot]) as [s116tot]&#xD;&#xA;from (&#xD;&#xA;SELECT &#xD;&#xA;&#xD;&#xA;FAMF.CST_CD as cst,&#xD;&#xA;(select cst_nm_ar from GLCST where CST_CD =FAMF.CST_CD ) as [cst_nm],&#xD;&#xA;Round(Sum((case when [FAMF].FA_CD like '11%'  then DPREXP else 0 end)),2) as [s11],&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;Round(Sum((case when [FADPRC_Q].FA_CD like '112%'  then  DPREXP  else 0 end)),2) * dbo.Getrat6([FAMF].FA_CD) as [s112],&#xD;&#xA;Round(Sum((case when [FADPRC_Q].FA_CD like '112%'  then  DPREXP  else 0 end)),2) * dbo.Getrat7([FAMF].FA_CD) as [s112s],&#xD;&#xA;Round(Sum((case when [FADPRC_Q].FA_CD like '112%'  then  DPREXP else 0 end)),2) * dbo.Getrat8([FAMF].FA_CD) as [s112ss],&#xD;&#xA;&#xD;&#xA;Round(Sum(isnull((case when [FADPRC_Q].FA_CD like '112%'  then  DPREXP else 0 end),0)),2)as [s112tot], -------&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;Round(Sum((case when [FADPRC_Q].FA_CD like '113%'  then  DPREXP else 0 end)),2) as [s113tot],&#xD;&#xA;&#xD;&#xA;Round(Sum((case when [FADPRC_Q].FA_CD like '114%'  then  DPREXP else 0 end)),2) * dbo.Getrat6([FAMF].FA_CD) as [s114],&#xD;&#xA;Round(Sum((case when [FADPRC_Q].FA_CD like '114%'  then  DPREXP else 0 end)),2) * dbo.Getrat7([FAMF].FA_CD) as [s114s],&#xD;&#xA;Round(Sum((case when [FADPRC_Q].FA_CD like '114%'  then  DPREXP else 0 end)),2) * dbo.Getrat8([FAMF].FA_CD) as [s114ss],&#xD;&#xA;Round(Sum((case when [FADPRC_Q].FA_CD like '114%'  then  DPREXP else 0 end)),2)as [s114tot],&#xD;&#xA;&#xD;&#xA;Round(Sum(isnull((case when [FADPRC_Q].FA_CD like '115%'  then  DPREXP else 0 end),0)),2)as [s115tot],&#xD;&#xA;&#xD;&#xA;Round(Sum((case when [FADPRC_Q].FA_CD like '116%'  then  DPREXP else 0 end)),2) * dbo.Getrat6([FAMF].FA_CD) as [s116],&#xD;&#xA;Round(Sum((case when [FADPRC_Q].FA_CD like '116%'  then  DPREXP else 0 end)),2) * dbo.Getrat7([FAMF].FA_CD) as [s116s],&#xD;&#xA;Round(Sum((case when [FADPRC_Q].FA_CD like '116%'  then  DPREXP else 0 end)),2) * dbo.Getrat8([FAMF].FA_CD) as [s116ss],&#xD;&#xA;&#xD;&#xA;Round(Sum(isnull((case when [FAMF].FA_CD like '116%'  then  DPREXP else 0 end),0)),2)as [s116tot]&#xD;&#xA;FROM FADPRC_Q &#xD;&#xA;INNER JOIN FAMF&#xD;&#xA;ON [FADPRC_Q].FA_CD = [FAMF].FA_CD&#xD;&#xA;WHERE [FADPRC_Q].DPREXP &gt; 0 &#xD;&#xA;and 1&lt;&gt;1&#xD;&#xA;group by [FAMF].FA_CD,[FAMF].CST_CD&#xD;&#xA;) t&#xD;&#xA;group by t.cst,t.cst_nm&#xD;&#xA;order by t.cst" Name="sqlDataSource1" />
  </DataSources>
