<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource1" Width="11.693in" Name="FADPRC_QTAWZE_3" Zoom="0.6666667" xmlns="http://schemas.telerik.com/reporting/2021/1.0">
  <Style>
    <BorderStyle Top="None" Bottom="None" Left="None" Right="None" />
