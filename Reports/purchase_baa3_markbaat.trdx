    <DetailSection Height="54.118cm" Name="detailSection1">
      <Items>
        <TextBox Width="16.446cm" Height="0.5cm" Left="2.3cm" Top="1.186cm" Value="يعتبر التمهيد السابق وكراسة الشروط والمواصفات و (العطاء / العرض ) المقدم من الطرف الثاني , وكافة المكاتبات والمستندات بين الطرفين" Name="textBox99">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="7.295cm" Height="0.5cm" Left="11.311cm" Top="3.395cm" Value="تعتبر الملاحق التالية والمرفقة بهذا العقد جزءاً لا يتجزأ منه : " Name="textBox98">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
