        <TextBox Width="11.4cm" Height="0.4cm" Left="7.775cm" Top="17.276cm" Value="وحيث انتهت ( لجنة البيع في المزايدة / لجنة البت / لجنة الاتفاق المباشر) في الجلسة المنعقدة يوم " Name="textBox21">
