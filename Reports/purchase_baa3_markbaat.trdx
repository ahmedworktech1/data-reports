          </Style>
        </TextBox>
        <TextBox Width="2.918cm" Height="0.4cm" Left="15.857cm" Top="25.676cm" Value="وقد سدد مبلغاُ وقدره (" Name="textBox64">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="1.784cm" Height="0.4cm" Left="12.549cm" Top="25.676cm" Value=") فقط وقدره (" Name="textBox65">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="7.7cm" Height="0.4cm" Left="2.423cm" Top="25.676cm" Value="بما يمثل نسبة (30%) من اجمالي ثمن البيع فور الترسية , وذلك" Name="textBox66">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="10.018cm" Height="0.4cm" Left="8.757cm" Top="26.701cm" Value="لا تكون الترسية نافذة وتظل مرهونة باعتماد نتيجة جلسة المزاد من السلطة المختصة ." Name="textBox67">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="1.746cm" Height="0.4cm" Left="17.057cm" Top="26.176cm" Value="بالحساب رقم" Name="textBox68">
