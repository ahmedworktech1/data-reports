            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="1.987cm" Height="0.4cm" Left="16.816cm" Top="13.498cm" Value="في ضوء اعتماد" Name="textBox5">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="3.259cm" Height="0.4cm" Left="15.198cm" Top="11.076cm" Value="النبد السادس عشر : النسخ" Name="textBox6">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="4.133cm" Height="0.4cm" Left="10.083cm" Top="13.498cm" Value="أو المفوض عنه (صفته الوظيفية)" Name="textBox7">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="1.467cm" Height="0.4cm" Left="5.78cm" Top="13.498cm" Value="بالقرار رقم" Name="textBox8">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
