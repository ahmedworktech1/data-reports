        </TextBox>
        <TextBox Width="8.174cm" Height="0.5cm" Left="10.434cm" Top="7.551cm" Value="وبأوصافها الواردة بكراسة الشروط والمواصفات تفصيلاً , وذلك بغرض " Name="textBox101">
          <Style TextAlign="Left" VerticalAlign="Middle">
