        </TextBox>
        <TextBox Width="3.118cm" Height="0.5cm" Left="15.534cm" Top="20.9cm" Value="28- أدخل تاريخ السداد ." Name="textBox190">
          <Style TextAlign="Left" VerticalAlign="Middle">
