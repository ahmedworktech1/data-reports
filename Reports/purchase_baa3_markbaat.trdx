        <TextBox Width="3.692cm" Height="0.4cm" Left="15.082cm" Top="25.209cm" Value="اجمالي ثمن البيع مبلغ وقدره (" Name="textBox61">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="1.151cm" Height="0.4cm" Left="11.557cm" Top="25.209cm" Value=") فقط (" Name="textBox62">
