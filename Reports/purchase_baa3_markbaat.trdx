            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.52cm" Height="0.5cm" Left="2.3cm" Top="6.951cm" Value="باع وأسقط وتنازل بكافة الضمانات الفعلية والقانونية الطرف الأول البائع إلي الطرف الثاني المشتري المركبة محل هذا العقد المشار إليه بالتمهيد " Name="textBox102">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
