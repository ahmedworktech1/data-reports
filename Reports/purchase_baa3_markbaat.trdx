        <TextBox Width="1.764cm" Height="0.4cm" Left="13.883cm" Top="27.476cm" Value="اعضاء اللجنة" Name="textBox72">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="1.764cm" Height="0.4cm" Left="5.483cm" Top="27.476cm" Value="رئيس اللجنة" Name="textBox73">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="4.874cm" Height="0.4cm" Left="13.883cm" Top="29.676cm" Value="1- أدخل اسم السلطة المختصة وصفاتها." Name="textBox74">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="6.262cm" Height="0.4cm" Left="12.495cm" Top="30.209cm" Value="2- اختيار طريق التعاقد الذى تم اتباعه لطرح العملية." Name="textBox75">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="16.388cm" Height="0.4cm" Left="2.423cm" Top="30.676cm" Value="3- لا يجوز للسلطة المختصة التفويض فى التعاقد بطريق الاتفاق المباشر وذلك طبقاً لحكم المادة (71) من قانون تنظيم التعاقدات التى تبرمها" Name="textBox76">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="8.662cm" Height="0.4cm" Left="10.083cm" Top="31.676cm" Value="4- أدخل الشكل القانونى للشخص الاعتبارى (شركة/ نقابة/ جمعية/ ...إلخ)." Name="textBox77">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="10.788cm" Height="0.4cm" Left="7.941cm" Top="32.142cm" Value="5- يقصد بالشكل القانونى شركة مساهمة/ شركة توصية بسيطة/ شركة شخص واحد/...إلخ)." Name="textBox78">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="13.088cm" Height="0.4cm" Left="5.641cm" Top="32.609cm" Value="6- التليفون والفاكس والبريد الإلكترونى بيانات أساسية يتعين استيفاؤها ليتم إرسال إخطارات الطرف الثانى عليها." Name="textBox79">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="7.764cm" Height="0.4cm" Left="10.965cm" Top="33.142cm" Value="7- أدخل وصف المركبة بالكامل طبقاً لكراسة الشروط والمواصفات." Name="textBox80">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="8.372cm" Height="0.4cm" Left="10.357cm" Top="33.676cm" Value="8- (دمغة التعاقد، دمغة التسليم، دمغة الإقرار، دمغة التنمية... وغيرها)." Name="textBox81">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="2.872cm" Height="0.4cm" Left="15.857cm" Top="34.209cm" Value="9- أدخل تاريخ السداد." Name="textBox82">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="7.718cm" Height="0.4cm" Left="11.011cm" Top="50.55cm" Value="وبعد ان اقر الطرفان بأهليتهما وصفتيهما للتعاقد اتفقا علي الآتي : " Name="textBox83">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="6.293cm" Height="0.4cm" Left="7.218cm" Top="35.95cm" Value="نمط العقد النموئجي لبيع مركبات مسموج بترخيصها" Name="textBox84">
          <Style TextAlign="Center" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
        </TextBox>
        <TextBox Width="1.472cm" Height="0.4cm" Left="17.257cm" Top="36.65cm" Value="انه في يوم" Name="textBox85">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
          </Style>
