        </TextBox>
        <TextBox Width="9.974cm" Height="0.5cm" Left="8.678cm" Top="19.272cm" Value="25- ٢٥ - يجب أن تكون كافة الملاحق وفقاً لما تضمنته كراسة الشروط والمواصفات." Name="textBox187">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Bold="True" Underline="False" />
