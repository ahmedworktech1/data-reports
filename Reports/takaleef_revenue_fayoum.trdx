]%'))  &#xD;&#xA;and sum_cd in ('11','12','13') then db_vl-cr_vl else 0 end)) *100) else 0 end) as tot&#xD;&#xA;&#xD;&#xA;from gljrnld  WHERE  ((acc_no like '4[6-8]3%' or acc_no like '4[6-8]11%' or acc_no like '4[6-8]12%'  or acc_no like '4[6-8]2%' or acc_no like '5[6-8]11%' or acc_no like '5[6-8]12%' )   &#xD;&#xA; and (gljrnld.cst_Cd like '090[2-9]%' or gljrnld.cst_Cd like'091[0-5]%')) &#xD;&#xA;and (1=1)&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;" Name="sqlDataSource1" />
