    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="glx2023hassan" SelectCommand="select  'مشتريات بغرض البيع' as s,&#xD;&#xA;COALESCE(sum( case when (acc_no like '4[6-8]3%' and substring(cst_Cd,6,7) in ('63','73','83') and gljrnld.cst_Cd like '050[2]%') then db_vl-cr_vl else 0 end ) /1000,0) as s1, &#xD;&#xA;COALESCE(sum( case when (acc_no like '4[6-8]3%' and substring(cst_Cd,6,7) in ('63','73','83') and gljrnld.cst_Cd like '050[3]%')   then db_vl-cr_vl else 0 end)/1000,0) as s2,&#xD;&#xA;COALESCE(sum( case when  (acc_no like '4[6-8]3%' and substring(cst_Cd,6,7) in ('63','73','83') and gljrnld.cst_Cd like '050[4]%') then db_vl-cr_vl else 0 end)/1000,0) as s3,&#xD;&#xA;COALESCE(sum( case when (acc_no like '4[6-8]3%' and substring(cst_Cd,6,7) in ('63','73','83') and gljrnld.cst_Cd like '050[5]%')  then db_vl-cr_vl else 0 end)/1000,0) as s4,&#xD;&#xA;COALESCE(sum( case when (acc_no like '4[6-8]3%' and substring(cst_Cd,6,7) in ('63','73','83') and gljrnld.cst_Cd like '050[6]%')  then db_vl-cr_vl else 0 end)/1000,0) as s5,&#xD;&#xA;COALESCE(sum( case when (acc_no like '4[6-8]3%' and substring(cst_Cd,6,7) in ('63','73','83') and gljrnld.cst_Cd like '050[7]%')  then db_vl-cr_vl else 0 end)/1000,0) as s6,&#xD;&#xA;COALESCE(sum( case when (acc_no like '4[6-8]3%' and substring(cst_Cd,6,7) in ('63','73','83') and gljrnld.cst_Cd like '050[8]%')  then db_vl-cr_vl else 0 end)/1000,0) as s7,&#xD;&#xA;COALESCE(sum( case when (acc_no like '4[6-8]3%' and substring(cst_Cd,6,7) in ('63','73','83') and gljrnld.cst_Cd like '050[9]%')  then db_vl-cr_vl else 0 end)/1000,0) as s8,&#xD;&#xA;COALESCE(sum( case when (acc_no like '4[6-8]3%' and substring(cst_Cd,6,7) in ('63','73','83') and gljrnld.cst_Cd like '051[0]%')  then db_vl-cr_vl else 0 end)/1000,0) as s9,&#xD;&#xA;COALESCE(sum( case when (acc_no like '4[6-8]3%' and substring(cst_Cd,6,7) in ('63','73','83') and gljrnld.cst_Cd like '051[1]%')  then db_vl-cr_vl else 0 end)/1000,0) as s10,&#xD;&#xA;COALESCE(sum( case when  (acc_no like '4[6-8]3%' and substring(cst_Cd,6,7) in ('63','73','83') and (gljrnld.cst_Cd like '050[2-9]%' or gljrnld.cst_Cd like '0510%' or gljrnld.cst_Cd like '0511%'))  then db_vl-cr_vl else 0 end)/1000,0) as tot&#xD;&#xA;&#xD;&#xA;from gljrnld  WHERE  (acc_no like '4[6-8]3%' and substring(cst_Cd,6,7) in ('63','73','83') and (gljrnld.cst_Cd like '050[2-9]%' or gljrnld.cst_Cd like '0510%' or gljrnld.cst_Cd like '0511%')) &#xD;&#xA;and (1=1)&#xD;&#xA;&#xD;&#xA;union all&#xD;&#xA;select  'مواد وخامات ووقود' as s,&#xD;&#xA;COALESCE(sum( case when (acc_no like '4[6-8]11%' and substring(cst_Cd,6,7) in ('63','73','83') and gljrnld.cst_Cd like '050[2]%') then db_vl-cr_vl else 0 end ) /1000,0) as s1, &#xD;&#xA;COALESCE(sum( case when (acc_no like '4[6-8]11%' and substring(cst_Cd,6,7) in ('63','73','83') and gljrnld.cst_Cd like '050[3]%')   then db_vl-cr_vl else 0 end)/1000,0) as s2,&#xD;&#xA;COALESCE(sum( case when  (acc_no like '4[6-8]11%' and substring(cst_Cd,6,7) in ('63','73','83') and gljrnld.cst_Cd like '050[4]%') then db_vl-cr_vl else 0 end)/1000,0) as s3,&#xD;&#xA;COALESCE(sum( case when (acc_no like '4[6-8]11%' and substring(cst_Cd,6,7) in ('63','73','83') and gljrnld.cst_Cd like '050[5]%')  then db_vl-cr_vl else 0 end)/1000,0) as s4,&#xD;&#xA;COALESCE(sum( case when (acc_no like '4[6-8]11%' and substring(cst_Cd,6,7) in ('63','73','83') and gljrnld.cst_Cd like '050[6]%')  then db_vl-cr_vl else 0 end)/1000,0) as s5,&#xD;&#xA;COALESCE(sum( case when (acc_no like '4[6-8]11%' and substring(cst_Cd,6,7) in ('63','73','83') and gljrnld.cst_Cd like '050[7]%')  then db_vl-cr_vl else 0 end)/1000,0) as s6,&#xD;&#xA;COALESCE(sum( case when (acc_no like '4[6-8]11%' and substring(cst_Cd,6,7) in ('63','73','83') and gljrnld.cst_Cd like '050[8]%')  then db_vl-cr_vl else 0 end)/1000,0) as s7,&#xD;&#xA;COALESCE(sum( case when (acc_no like '4[6-8]11%' and substring(cst_Cd,6,7) in ('63','73','83') and gljrnld.cst_Cd like '050[9]%')  then db_vl-cr_vl else 0 end)/10