    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="glx2024meniakahraba" SelectCommand="SELECT 'الأجور' AS s,&#xD;&#xA;    CAST(ROUND(SUM(CASE WHEN acc_no LIKE '0%' THEN db_vl - cr_vl ELSE 0 END), 3) AS DECIMAL (18,3)) AS s1,&#xD;&#xA;    CAST(ROUND(SUM(CASE WHEN acc_no LIKE '0%' THEN db_vl - cr_vl ELSE 0 END), 3) AS DECIMAL (18,3)) AS s2,&#xD;&#xA;    CAST(ROUND(SUM(CASE WHEN acc_no LIKE '0%' THEN db_vl - cr_vl ELSE 0 END), 3) AS DECIMAL (18,3)) AS s3,&#xD;&#xA;    CAST(ROUND(SUM(CASE WHEN acc_no LIKE '0%' THEN db_vl - cr_vl ELSE 0 END), 3) AS DECIMAL (18,3)) AS s4,&#xD;&#xA;    CAST(ROUND(SUM(CASE WHEN acc_no LIKE '0%' THEN db_vl - cr_vl ELSE 0 END), 3) AS DECIMAL (18,3)) AS s5,&#xD;&#xA;    CAST(ROUND(SUM(CASE WHEN acc_no LIKE '0%' THEN db_vl - cr_vl ELSE 0 END), 3) AS DECIMAL (18,3)) AS s6,&#xD;&#xA;    CAST(ROUND(SUM(CASE WHEN acc_no LIKE '0%' THEN db_vl - cr_vl ELSE 0 END), 3) AS DECIMAL (18,3)) AS s7,&#xD;&#xA;    CAST(ROUND(SUM(CASE WHEN acc_no LIKE '0%' THEN db_vl - cr_vl ELSE 0 END), 3) AS DECIMAL (18,3)) AS s8,&#xD;&#xA;    CAST(ROUND(SUM(CASE WHEN acc_no LIKE '0%' THEN db_vl - cr_vl ELSE 0 END), 3) AS DECIMAL (18,3)) AS s9,&#xD;&#xA;    CAST(ROUND(SUM(CASE WHEN acc_no LIKE '0%' THEN db_vl - cr_vl ELSE 0 END), 3) AS DECIMAL (18,3)) AS s10,&#xD;&#xA;&#x9;CAST(ROUND(SUM(CASE WHEN acc_no LIKE '0%' THEN db_vl - cr_vl ELSE 0 END), 3) AS DECIMAL (18,3)) AS s11,&#xD;&#xA;    CAST(ROUND(SUM(CASE WHEN acc_no LIKE '0%' THEN db_vl - cr_vl ELSE 0 END), 3) AS DECIMAL (18,3)) AS s12,&#xD;&#xA;    CAST(ROUND(SUM(CASE WHEN acc_no LIKE '0%' THEN db_vl - cr_vl ELSE 0 END), 3) AS DECIMAL (18,3)) AS s13,&#xD;&#xA;    CAST(ROUND(SUM(CASE WHEN acc_no LIKE '0%' THEN db_vl - cr_vl ELSE 0 END), 3) AS DECIMAL (18,3)) AS s14,&#xD;&#xA;    CAST(ROUND(SUM(CASE WHEN acc_no LIKE '0%' THEN db_vl - cr_vl ELSE 0 END), 3) AS DECIMAL (18,3)) AS tot&#xD;&#xA;FROM gljrnld  &#xD;&#xA;WHERE acc_no LIKE '0%' AND 1 &lt;&gt; 1&#xD;&#xA;&#xD;&#xA;UNION ALL&#xD;&#xA