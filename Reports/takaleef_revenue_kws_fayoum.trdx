A;            0&#xD;&#xA;        ) &#xD;&#xA;        * 100, &#xD;&#xA;    3)) AS s10,&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#x9; (ROUND(&#xD;&#xA;        CAST(&#xD;&#xA;            SUM(CASE WHEN (acc_no LIKE '5[6-8]1111101%' OR acc_no LIKE '5[6-8]1111102%') AND SUM_CD = '11' AND gljrnld.cst_Cd LIKE '0912%' THEN db_vl - cr_vl ELSE 0 END) &#xD;&#xA;            AS NUMERIC&#xD;&#xA;        ) &#xD;&#xA;        / &#xD;&#xA;        NULLIF(&#xD;&#xA;            SUM(CASE WHEN (acc_no LIKE '5[6-8]1111101%' OR acc_no LIKE '5[6-8]1111102%') AND gljrnld.cst_Cd LIKE '0912%' THEN VAL1 ELSE 0 END), &#xD;&#xA;            0&#xD;&#xA;        ) &#xD;&#xA;        * 100, &#xD;&#xA;    3)*-1&#xD;&#xA;&#x9;-&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;    ROUND(&#xD;&#xA;        CAST(&#xD;&#xA;            SUM(CASE WHEN (acc_no like '4[6-8]1%' or acc_no like '4[6-8]2%' or acc_no like '4[6-8]3%') AND SUM_CD = '11' AND gljrnld.cst_Cd LIKE '0912%' THEN db_vl - cr_vl ELSE 0 END) &#xD;&#xA;            AS NUMERIC&#xD;&#xA;        ) &#xD;&#xA;        / &#xD;&#xA;        NULLIF(&#xD;&#xA;            SUM(CASE WHEN (acc_no LIKE '5[6-8]1111101%' OR acc_no LIKE '5[6-8]1111102%') AND gljrnld.cst_Cd LIKE '0912%' THEN VAL1 ELSE 0 END), &#xD;&#xA;            0&#xD;&#xA;        ) &#xD;&#xA;        * 100, &#xD;&#xA;    3)) AS s11,&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#x9;(ROUND(&#xD;&#xA;        CAST(&#xD;&#xA;            SUM(CASE WHEN (acc_no LIKE '5[6-8]1111101%' OR acc_no LIKE '5[6-8]1111102%') AND SUM_CD = '11' AND gljrnld.cst_Cd LIKE '0913%' THEN db_vl - cr_vl ELSE 0 END) &#xD;&#xA;            AS NUMERIC&#xD;&#xA;        ) &#xD;&#xA;        / &#xD;&#xA;        NULLIF(&#xD;&#xA;            SUM(CASE WHEN (acc_no LIKE '5[6-8]1111101%' OR acc_no LIKE '5[6-8]1111102%') AND gljrnld.cst_Cd LIKE '0913%' THEN VAL1 ELSE 0 END), &#xD;&#xA;            0&#xD;&#xA;        ) &#xD;&#xA;        * 100, &#xD;&#xA;    3)*-1&#xD;&#xA;&#x9;-&#xD;&#xA;&#xD;&#xA;    ROUND(&#xD;&#xA;        CAST(&#xD;&#xA;            SUM(CASE WHEN (acc_no like '4[6-8]1%' or acc_no like '4[6-8]2%' or acc_no like '4[6-8]3%') AND SUM_CD = '11' AND gljrnld.cst_Cd LIKE '0913%' THEN db_vl - cr_vl ELSE 0 END) &#xD;&#xA;            AS NUMERIC&#xD;&#xA;        ) &#xD;&#xA;        / &#xD;&#xA;        NULLIF(&#xD;&#xA;            SUM(CASE WHEN (acc_no LIKE '5[6-8]1111101%' OR acc_no LIKE '5[6-8]1111102%') AND gljrnld.cst_Cd LIKE '0913%' THEN VAL1 ELSE 0 END), &#xD;&#xA;            0&#xD;&#xA;        ) &#xD;&#xA;        * 100, &#xD;&#xA;    3)) AS s12,&#xD;&#xA;&#xD;&#xA;  (ROUND(&#xD;&#xA;        CAST(&#xD;&#xA;            SUM(CASE WHEN (acc_no LIKE '5[6-8]1111101%' OR acc_no LIKE '5[6-8]1111102%') AND SUM_CD = '11' AND gljrnld.cst_Cd LIKE '0914%' THEN db_vl - cr_vl ELSE 0 END) &#xD;&#xA;            AS NUMERIC&#xD;&#xA;        ) &#xD;&#xA;        / &#xD;&#xA;        NULLIF(&#xD;&#xA;            SUM(CASE WHEN (acc_no LIKE '5[6-8]1111101%' OR acc_no LIKE '5[6-8]1111102%') AND gljrnld.cst_Cd LIKE '0914%' THEN VAL1 ELSE 0 END), &#xD;&#xA;            0&#xD;&#xA;        ) &#xD;&#xA;        * 100, &#xD;&#xA;    3)*-1&#xD;&#xA;&#x9;-&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;    ROUND(&#xD;&#xA;        CAST(&#xD;&#xA;            SUM(CASE WHEN (acc_no like '4[6-8]1%' or acc_no like '4[6-8]2%' or acc_no like '4[6-8]3%') AND SUM_CD = '11' AND gljrnld.cst_Cd LIKE '0914%' THEN db_vl - cr_vl ELSE 0 END) &#xD;&#xA;            AS NUMERIC&#xD;&#xA;        ) &#xD;&#xA;        / &#xD;&#xA;        NULLIF(&#xD;&#xA;            SUM(CASE WHEN (acc_no LIKE '5[6-8]1111101%' OR acc_no LIKE '5[6-8]1111102%') AND gljrnld.cst_Cd LIKE '0914%' THEN VAL1 ELSE 0 END), &#xD;&#xA;            0&#xD;&#xA;        ) &#xD;&#xA;        * 100, &#xD;&#xA;    3)) AS s13,&#xD;&#xA;    (ROUND(&#xD;&#xA;        CAST(&#xD;&#xA;            SUM(CASE WHEN (acc_no LIKE '5[6-8]1111101%' OR acc_no LIKE '5[6-8]1111102%') AND SUM_CD = '11' AND gljrnld.cst_Cd LIKE '0915%' THEN db_vl - cr_vl ELSE 0 END) &#xD;&#xA;            AS NUMERIC&#xD;&#xA;        ) &#xD;&#xA;        / &#xD;&#xA;        NULLIF(&#xD;&#xA;            SUM(CASE WHEN (acc_no LIKE '5[6-8]1111101%' OR acc_no LIKE '5[6-8]1111102%') AND gljrnld.cst_Cd LIKE '0915%' THEN VAL1 ELSE 0 END), &#xD;&#xA;            0&#xD;&#xA;        ) &#xD;&#xA;        * 100, &#xD;&#xA;    3)*-1&#xD;&#xA;&#x9;-&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;    ROUND(&#xD;&#xA;        CAST(&#xD;&#xA;            SUM(CASE WHEN (acc_no like '4[6-8]1%' or acc_no like '4[6-8]2%' or acc_no like '4[6-8]3%') AND SUM_CD = '11' AND gljrnld.cst_Cd LIKE '0915%' THEN db_vl - cr_vl ELSE 0 END) &#xD;&#xA;            AS NUMERIC&#xD;&#xA;        ) &#xD;&#xA;        / &#xD;&#xA;        NULLIF(&#xD;&#xA;            SUM(CASE WHEN (acc_no LIKE '5[6-8]1111101%' OR acc_no LIKE '5[6-8]1111102%') AND gljrnld.cst_Cd LIKE '0915%' THEN VAL1 ELSE 0 END), &#xD;&#xA;            0&#xD;&#xA;        ) &#xD;&#xA;        * 100, &#xD;&#xA;    3)) AS s14,&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;(ROUND(&#xD;&#xA;        CAST(&#xD;&#xA;            SUM(CASE WHEN (acc_no LIKE '5[6-8]1111101%' OR acc_no LIKE '5[6-8]1111102%') AND SUM_CD = '11' AND (gljrnld.cst_Cd LIKE '09%')&#xD;&#xA;&#xD;&#xA;                 THEN db_vl - cr_vl ELSE 0 END) &#xD;&#xA;            AS NUMERIC&#xD;&#xA;        ) &#xD;&#xA;        / &#xD;&#xA;        NULLIF(&#xD;&#xA;            SUM(CASE WHEN (acc_no LIKE '5[6-8]1111101%' OR acc_no LIKE '5[6-8]1111102%') AND (gljrnld.cst_Cd LIKE '09%')&#xD;&#xA;THEN VAL1 ELSE 0 END), &#xD;&#xA;            0&#xD;&#xA;        ) &#xD;&#xA;        * 100, &#xD;&#xA;    3)*-1 &#xD;&#xA;&#x9;-&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;    ROUND(&#xD;&#xA;        CAST(&#xD;&#xA;            SUM(CASE WHEN (acc_no like '4[6-8]1%' or acc_no like '4[6-8]2%' or acc_no like '4[6-8]3%') AND SUM_CD = '11' AND (gljrnld.cst_Cd LIKE '09%')&#xD;&#xA;&#xD;&#xA;                 THEN db_vl - cr_vl ELSE 0 END) &#xD;&#xA;            AS NUMERIC&#xD;&#xA;        ) &#xD;&#xA;        / &#xD;&#xA;        NULLIF(&#xD;&#xA;            SUM(CASE WHEN (acc_no LIKE '5[6-8]1111101%' OR acc_no LIKE '5[6-8]1111102%') AND (gljrnld.cst_Cd LIKE '09%')&#xD;&#xA;THEN VAL1 ELSE 0 END), &#xD;&#xA;            0&#xD;&#xA;        ) &#xD;&#xA;        * 100, &#xD;&#xA;    3)) AS tot&#xD;&#xA;&#xD;&#xA;FROM gljrnld  &#xD;&#xA;WHERE ( acc_no like '4[6-8]1%' or acc_no like '4[6-8]2%' or acc_no like '4[6-8]3%' or acc_no LIKE '5[6-8]1111101%' OR acc_no LIKE '5[6-8]1111102%') AND SUM_CD = '11'&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;" Name="sqlDataSource1" />
