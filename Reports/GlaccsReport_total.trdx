  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="LocalSqlServer" SelectCommand="SELECT        TOP (100) PERCENT dbo.GLJRNLD.JRN_CD, dbo.GLJRNLD.TR_NO, dbo.GLJRNLD.LN_NO, dbo.GLTRSTBL.DOC_DS_Ar, dbo.GLJRNLD.TR_DT, dbo.GLJRNLD.DB_VL, dbo.GLJRNLD.CR_VL, dbo.GLMF.ACC_NO, &#xD;&#xA;                         dbo.GLMF.ACC_NM_Ar, dbo.GLJRNLD.TR_DS, dbo.GLSUMS.SUM_NM_Ar, dbo.GLCST.CST_NM_Ar, dbo.GLSCST.SCST_CD, dbo.GLSCST.SCST_NM_Ar, dbo.GLSSUMS.SSUM_CD, dbo.GLSSUMS.SSUM_NM_Ar, &#xD;&#xA;                         dbo.GLSUMS.SUM_CD, dbo.GLCST.CST_CD, dbo.GLJRNLH.TR_DT AS TR_DTH, dbo.GLJRNLH.COM_ID, dbo.GLLOC.UNT_NM_Ar&#xD;&#xA;FROM            dbo.GLJRNLD INNER JOIN&#xD;&#xA;                         dbo.GLMF ON dbo.GLJRNLD.ACC_NO = dbo.GLMF.ACC_NO INNER JOIN&#xD;&#xA;                         dbo.GLTRSTBL ON dbo.GLJRNLD.JRN_CD = dbo.GLTRSTBL.DOC_TY INNER JOIN&#xD;&#xA;                         dbo.GLJRNLH ON dbo.GLJRNLD.JRN_CD = dbo.GLJRNLH.JRN_CD AND dbo.GLJRNLD.TR_NO = dbo.GLJRNLH.TR_NO LEFT OUTER JOIN&#xD;&#xA;                         dbo.GLLOC ON dbo.GLJRNLH.COM_ID = dbo.GLLOC.UNT_CD LEFT OUTER JOIN&#xD;&#xA;                         dbo.GLSCST ON dbo.GLJRNLD.scst_cd = dbo.GLSCST.SCST_CD LEFT OUTER JOIN&#xD;&#xA;                         dbo.GLSSUMS ON dbo.GLJRNLD.SSUM_CD = dbo.GLSSUMS.SSUM_CD LEFT OUTER JOIN&#xD;&#xA;                         dbo.GLSUMS ON dbo.GLJRNLD.SUM_CD = dbo.GLSUMS.SUM_CD LEFT OUTER JOIN&#xD;&#xA;                         dbo.GLCST ON dbo.GLJRNLD.CST_CD = dbo.GLCST.CST_CD&#xD;&#xA;WHERE        (1&lt;&gt;1)&#xD;&#xA;ORDER BY dbo.GLJRNLD.JRN_CD, dbo.GLJRNLD.TR_NO, dbo.GLJRNLD.LN_NO&#xD;&#xA;" Name="sqlDataSource1" />
  </DataSources>
