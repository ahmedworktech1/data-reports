<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource1" Width="21cm" Name="Budget_Execution_Report" xmlns="http://schemas.telerik.com/reporting/2023/1.0">
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="glxsandoaaAhmedHasan" SelectCommand="WITH &#xD;&#xA;&#xD;&#xA;-- الفترة&#xD;&#xA;ReportPeriod AS (&#xD;&#xA;    SELECT &#xD;&#xA;        MAX(CAST(G.fPRD_No AS VARCHAR(20))) AS fprd_no,&#xD;&#xA;        MAX(CAST(G.tPRD_NO AS VARCHAR(20))) AS tPRD_NO&#xD;&#xA;    FROM GLBDG G&#xD;&#xA;    WHERE G.CHKTOT = '0'&#xD;&#xA;),&#xD;&#xA;&#xD;&#xA;-- 1. تفاصيل الإيرادات (موازنة + فعلي) - ديناميكي من GLMF + appcodes&#xD;&#xA;RevenueDetails AS (&#xD;&#xA;    SELECT &#xD;&#xA;        A.SEQ AS Seq, &#xD;&#xA;        MAX(A.DSCR_AR) AS Text, &#xD;&#xA;        CAST(SUM(ISNULL(BdgCalc.BudgetAmt, 0)) AS DECIMAL(18,2)) AS Amount,&#xD;&#xA;        CAST(SUM(ISNULL(ActCalc.ActualAmt, 0)) * -1 AS DECIMAL(18,2)) AS ActualAmount,&#xD;&#xA;        10 + A.SEQ AS SortOrder&#xD;&#xA;    FROM GLMF M&#xD;&#xA;    INNER JOIN appcodes A &#xD;&#xA;        ON A.SEQ = M.BDG_CTG &#xD;&#xA;       AND A.ID = 63&#xD;&#xA;    CROSS APPLY (&#xD;&#xA;        SELECT SUM(G.BDG) AS BudgetAmt &#xD;&#xA;        FROM GLBDG G &#xD;&#xA;        WHERE G.ACC_NO = M.ACC_NO AND G.CHKTOT = '0'&#xD;&#xA;    ) BdgCalc&#xD;&#xA;    CROSS APPLY (&#xD;&#xA;        SELECT SUM(J.db_vl - J.cr_vl) AS ActualAmt &#xD;&#xA;        FROM gljrnld J &#xD;&#xA;        WHERE J.ACC_NO = M.ACC_NO&#xD;&#xA;    ) ActCalc&#xD;&#xA;    WHERE M.ACC_NO LIKE '40%'&#xD;&#xA;      AND M.BDG_CTG IS NOT NULL&#xD;&#xA;    GROUP BY A.SEQ&#xD;&#xA;),&#xD;&#xA;&#xD;&#xA;-- 2. تفاصيل المصروفات (موازنة + فعلي) - ديناميكي من GLMF + appcodes&#xD;&#xA;ExpenseDetails AS (&#xD;&#xA;    SELECT &#xD;&#xA;        A.SEQ AS Seq, &#xD;&#xA;        MAX(A.DSCR_AR) AS Text,&#xD;&#xA;        CAST(SUM(ISNULL(BdgCalc.BudgetAmt, 0)) AS DECIMAL(18,2)) AS Amount,&#xD;&#xA;        CAST(SUM(ISNULL(ActCalc.ActualAmt, 0)) AS DECIMAL(18,2)) AS ActualAmount,&#xD;&#xA;        110 + A.SEQ AS SortOrder&#xD;&#xA;    FROM GLMF M&#xD;&#xA;    INNER JOIN appcodes A &#xD;&#xA;        ON A.SEQ = M.BDG_CTG &#xD;&#xA;       AND A.ID = 63&#xD;&#xA;    CROSS APPLY (&#xD;&#xA;        SELECT SUM(G.BDG) AS BudgetAmt &#xD;&#xA;        FROM GLBDG G &#xD;&#xA;        WHERE G.ACC_NO = M.ACC_NO AND G.CHKTOT = '0'&#xD;&#xA;    ) BdgCalc&#xD;&#xA;    CROSS APPLY (&#xD;&#xA;        SELECT SUM(J.db_vl - J.cr_vl) AS ActualAmt &#xD;&#xA;        FROM gljrnld J &#xD;&#xA;        WHERE J.ACC_NO = M.ACC_NO&#xD;&#xA;    ) ActCalc&#xD;&#xA;    WHERE M.ACC_NO LIKE '30%'&#xD;&#xA;      AND M.BDG_CTG IS NOT NULL&#xD;&#xA;    GROUP BY A.SEQ&#xD;&#xA;),&#xD;&#xA;&#xD;&#xA;-- 3. التجميع النهائي مع أعمدة الزيادة / العجز / نسبة التنفيذ&#xD;&#xA;CombinedReport AS (&#xD;&#xA;    -- أولاً: الإيرادات&#xD;&#xA;    SELECT NULL AS SerialNo, 'أولاً: الإيرادات' AS StatementText, &#xD;&#xA;           CAST(NULL AS DECIMAL(18,2)) AS Amount, CAST(NULL AS DECIMAL(18,2)) AS ActualAmount,&#xD;&#xA;           CAST(NULL AS DECIMAL(18,2)) AS Increase, CAST(NULL AS DECIMAL(18,2)) AS Deficit,&#xD;&#xA;           CAST(NULL AS DECIMAL(9,4)) AS ExecPct,&#xD;&#xA;           100 AS SortOrder, 'SectionTitle' AS SectionType&#xD;&#xA;    UNION ALL&#xD;&#xA;    SELECT &#xD;&#xA;        Seq, Text, Amount, ActualAmount,&#xD;&#xA;        CASE WHEN ActualAmount &lt; Amount THEN Amount - ActualAmount ELSE 0 END,&#xD;&#xA;        CASE WHEN ActualAmount &gt; Amount THEN ActualAmount - Amount ELSE 0 END,&#xD;&#xA;        CASE WHEN ISNULL(Amount, 0) = 0 THEN NULL ELSE CAST(ActualAmount AS DECIMAL(18,4)) / Amount END,&#xD;&#xA;        100 + Seq, 'Detail'&#xD;&#xA;    FROM RevenueDetails&#xD;&#xA;    UNION ALL&#xD;&#xA;    SELECT NULL, 'إجمالي الإيرادات (موازنة)', SUM(Amount), SUM(ActualAmount),&#xD;&#xA;        CASE WHEN SUM(ActualAmount) &lt; SUM(Amount) THEN SUM(Amount) - SUM(ActualAmount) ELSE 0 END,&#xD;&#xA;        CASE WHEN SUM(ActualAmount) &gt; SUM(Amount) THEN SUM(ActualAmount) - SUM(Amount) ELSE 0 END,&#xD;&#xA;        CASE WHEN SUM(Amount) = 0 THEN NULL ELSE CAST(SUM(ActualAmount) AS DECIMAL(18,4)) / SUM(Amount) END,&#xD;&#xA;        150, 'BudgetTotal'&#xD;&#xA;    FROM RevenueDetails&#xD;&#xA;&#xD;&#xA;    -- ثانياً: المصروفات&#xD;&#xA;    UNION ALL&#xD;&#xA;    SELECT NULL, 'ثانياً: المصروفات', NULL, NULL, NULL, NULL, NULL, 200, 'SectionTitle'&#xD;&#xA;    UNION ALL&#xD;&#xA;    SELECT &#xD;&#xA;        Seq, Text, Amount, ActualAmount,&#xD;&#xA;        CASE WHEN ActualAmount &lt; Amount THEN Amount - ActualAmount ELSE 0 END,&#xD;&#xA;        CASE WHEN ActualAmount &gt; Amount THEN ActualAmount - Amount ELSE 0 END,&#xD;&#xA;        CASE WHEN ISNULL(Amount, 0) = 0 THEN NULL ELSE CAST(ActualAmount AS DECIMAL(18,4)) / Amount END,&#xD;&#xA;        200 + Seq, 'Detail'&#xD;&#xA;    FROM ExpenseDetails&#xD;&#xA;    UNION ALL&#xD;&#xA;    SELECT NULL, 'إجمالي المصروفات (موازنة)', SUM(Amount), SUM(ActualAmount),&#xD;&#xA;        CASE WHEN SUM(ActualAmount) &lt; SUM(Amount) THEN SUM(Amount) - SUM(ActualAmount) ELSE 0 END,&#xD;&#xA;        CASE WHEN SUM(ActualAmount) &gt; SUM(Amount) THEN SUM(ActualAmount) - SUM(Amount) ELSE 0 END,&#xD;&#xA;        CASE WHEN SUM(Amount) = 0 THEN NULL ELSE CAST(SUM(ActualAmount) AS DECIMAL(18,4)) / SUM(Amount) END,&#xD;&#xA;        250, 'BudgetTotal'&#xD;&#xA;    FROM ExpenseDetails&#xD;&#xA;)&#xD;&#xA;&#xD;&#xA;-- النهائي&#xD;&#xA;SELECT &#xD;&#xA;    CR.SerialNo, &#xD;&#xA;    CR.StatementText, &#xD;&#xA;    CR.Amount,&#xD;&#xA;    CR.ActualAmount,&#xD;&#xA;    CR.Increase,&#xD;&#xA;    CR.Deficit,&#xD;&#xA;    CR.ExecPct,&#xD;&#xA;    CR.SectionType,&#xD;&#xA;    RP.fprd_no,&#xD;&#xA;    RP.tPRD_NO,&#xD;&#xA;    CR.SortOrder,&#xD;&#xA;    CASE &#xD;&#xA;        WHEN CR.SortOrder BETWEEN 100 AND 150 THEN 1&#xD;&#xA;        WHEN CR.SortOrder BETWEEN 200 AND 250 THEN 2&#xD;&#xA;        ELSE 0 &#xD;&#xA;    END AS ReportSection&#xD;&#xA;FROM CombinedReport CR&#xD;&#xA;CROSS JOIN ReportPeriod RP&#xD;&#xA;ORDER BY CR.SortOrder;" Name="sqlDataSource1" />
  </DataSources>
