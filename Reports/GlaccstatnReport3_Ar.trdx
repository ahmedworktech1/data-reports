        <TextBox Width="1.8cm" Height="0.6cm" Left="9cm" Top="0cm" Value="= &quot;بواسطة :&quot;+Cstr(UserIdentity.Name)" Name="textBox23">
          <Style TextAlign="Left" VerticalAlign="Middle">
            <Font Size="8pt" />
            <BorderStyle Top="Dotted" Bottom="Dotted" Left="Dotted" Right="Dotted" />
            <BorderColor Top="141, 179, 227" Bottom="141, 179, 227" Left="141, 179, 227" Right="141, 179, 227" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
        <TextBox Width="2.4cm" Height="0.6cm" Left="6.3cm" Top="0cm" Value="= &quot; صفحة &quot; + CStr(PageNumber) + &quot; من &quot;  + CStr(PageCount)" Name="textBox20">
          <Style VerticalAlign="Middle">
            <Font Size="8pt" />
            <BorderStyle Top="Dotted" Bottom="Dotted" Left="Dotted" Right="Dotted" />
            <BorderColor Top="141, 179, 227" Bottom="141, 179, 227" Left="141, 179, 227" Right="141, 179, 227" />
            <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
          </Style>
        </TextBox>
      </Items>
    </PageFooterSection>
  </Items>
  <PageSettings PaperKind="A4" Landscape="False" ContinuousPaper="False">
    <Margins>
      <MarginsU Left="0.5cm" Right="0.5cm" Top="1cm" Bottom="1cm" />
    </Margins>
  </PageSettings>
  <StyleSheet>
    <StyleRule>
      <Style>
        <Padding Left="2pt" Right="2pt" />
      </Style>
      <Selectors>
        <TypeSelector Type="TextItemBase" />
        <TypeSelector Type="HtmlTextBox" />
      </Selectors>
    </StyleRule>
  </StyleSheet>
  <Groups>
    <Group Name="group">
      <GroupHeader>
        <GroupHeaderSection Height="0.704cm" Name="groupHeaderSection">
          <Items>
            <TextBox Width="0.984in" Height="0.247in" Left="0.906in" Top="0in" Value="= IIf(Sum(Fields.DbVl - Fields.CrVl) &gt;= 0,&#xD;&#xA;&#xD;&#xA;Sum(Fields.DbVl - Fields.CrVl),0)" Format="{0:N3}" Culture="en" Name="textBox32">
              <Style Color="28, 0, 155" TextAlign="Center" VerticalAlign="Middle">
                <Font Size="9pt" />
                <BorderStyle Top="Dotted" Bottom="Dotted" Left="Dotted" Right="Dotted" />
                <BorderColor Top="141, 179, 227" Bottom="141, 179, 227" Left="141, 179, 227" Right="141, 179, 227" />
                <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
              </Style>
            </TextBox>
            <TextBox Width="0.901in" Height="0.247in" Left="0in" Top="0in" Value="= IIf(Sum(Fields.DbVl - Fields.CrVl) &lt; 0,&#xD;&#xA;&#xD;&#xA;Abs(Sum(Fields.DbVl - Fields.CrVl)),0)" Format="{0:N3}" Culture="en" Name="textBox33">
              <Style Color="192, 0, 0" TextAlign="Center" VerticalAlign="Middle">
                <Font Size="9pt" />
                <BorderStyle Top="Dotted" Bottom="Dotted" Left="Dotted" Right="Dotted" />
                <BorderColor Top="141, 179, 227" Bottom="141, 179, 227" Left="141, 179, 227" Right="141, 179, 227" />
                <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
              </Style>
            </TextBox>
            <TextBox Width="2.247cm" Height="0.247in" Left="7.153cm" Top="0cm" Value="= Sum(Fields.DBBAL)" Format="{0:N3}" Culture="en" Name="textBox12">
              <Style Color="28, 0, 155" TextAlign="Center" VerticalAlign="Middle">
                <Font Size="9pt" Bold="False" />
                <BorderStyle Top="Dotted" Bottom="Dotted" Left="Dotted" Right="Dotted" />
                <BorderColor Top="141, 179, 227" Bottom="141, 179, 227" Left="141, 179, 227" Right="141, 179, 227" />
                <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
              </Style>
            </TextBox>
            <TextBox Width="2.353cm" Height="0.247in" Left="4.8cm" Top="0cm" Value="=Sum (Fields.TCR_VL)" Format="{0:N3}" Culture="en" Name="textBox13">
              <Style Color="192, 0, 0" TextAlign="Center" VerticalAlign="Middle">
                <Font Size="9pt" />
                <BorderStyle Top="Dotted" Bottom="Dotted" Left="Dotted" Right="Dotted" />
                <BorderColor Top="141, 179, 227" Bottom="141, 179, 227" Left="141, 179, 227" Right="141, 179, 227" />
                <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
              </Style>
            </TextBox>
            <TextBox Width="2.1cm" Height="0.247in" Left="17.9cm" Top="0cm" Value="= Fields.AccNo" Culture="en" Name="textBox24">
              <Style BackgroundColor="White" TextAlign="Right" VerticalAlign="Middle">
                <Font Size="8pt" Bold="False" />
                <BorderStyle Top="Dotted" Bottom="Dotted" Left="Dotted" Right="Dotted" />
                <BorderColor Top="141, 179, 227" Bottom="141, 179, 227" Left="141, 179, 227" Right="141, 179, 227" />
                <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
              </Style>
            </TextBox>
            <TextBox Width="6cm" Height="0.247in" Left="11.8cm" Top="0cm" Value="= Fields.AccNmAr" Multiline="False" Name="textBox25">
              <Style BackgroundColor="White" TextAlign="Left" VerticalAlign="Middle">
                <Font Size="10pt" />
                <BorderStyle Top="Dotted" Bottom="Dotted" Left="Dotted" Right="Dotted" />
                <BorderColor Top="141, 179, 227" Bottom="141, 179, 227" Left="141, 179, 227" Right="141, 179, 227" />
                <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
              </Style>
            </TextBox>
            <TextBox Width="0.273cm" Height="0.6cm" Left="11.5cm" Top="0.104cm" Value="(" Name="textBox15">
              <Style>
                <Font Bold="True" />
              </Style>
              <Bindings>
                <Binding Path="Visible" Expression="= (Sum(Fields.DbVl - Fields.CrVl) - Sum(Fields.DBBAL) + Sum (Fields.TCR_VL)) &lt; 0" />
              </Bindings>
            </TextBox>
            <TextBox Width="0.273cm" Height="0.6cm" Left="9.4cm" Top="0.076cm" Value=")" Name="textBox16">
              <Style>
                <Font Bold="True" />
              </Style>
              <Bindings>
                <Binding Path="Visible" Expression="= (Sum(Fields.DbVl - Fields.CrVl) - Sum(Fields.DBBAL) + Sum (Fields.TCR_VL)) &lt; 0" />
              </Bindings>
            </TextBox>
            <TextBox Width="0.94in" Height="0.247in" Left="9.4cm" Top="0cm" Value="= Abs(Sum(Fields.DbVl - Fields.CrVl) - Sum(Fields.DBBAL) + Sum (Fields.TCR_VL))" Format="{0:N3}" Culture="en" Name="textBox4">
              <Style TextAlign="Center" VerticalAlign="Middle">
                <Font Size="9pt" />
                <BorderStyle Top="Dotted" Bottom="Dotted" Left="Dotted" Right="Dotted" />
                <BorderColor Top="141, 179, 227" Bottom="141, 179, 227" Left="141, 179, 227" Right="141, 179, 227" />
                <BorderWidth Top="1pt" Bottom="1pt" Left="1pt" Right="1pt" />
              </Style>
            </TextBox>
          </Items>
        </GroupHeaderSection>
      </GroupHeader>
      <GroupFooter>
