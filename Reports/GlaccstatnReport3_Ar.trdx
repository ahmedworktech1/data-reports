        <TextBox Width="2.4cm" Height="0.708cm" Left="9.4cm" Top="0cm" Value="= Abs(Sum(Fields.DbVl - Fields.CrVl) -Sum(Fields.DBBAL) + Sum (Fields.TCR_VL))" Format="{0:N3}" Culture="en" Name="textBox14">
          <Style BackgroundColor="191, 191, 191" Color="Black" TextAlign="Center" VerticalAlign="Middle">
