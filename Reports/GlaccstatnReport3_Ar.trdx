        <TextBox Width="0.273cm" Height="0.6cm" Left="11.5cm" Top="0.132cm" Value="(" Name="textBox27">
          <Style>
            <Font Bold="True" />
          </Style>
          <Bindings>
            <Binding Path="Visible" Expression="= (Sum(Fields.DbVl - Fields.CrVl) - Sum(Fields.DBBAL) + Sum (Fields.TCR_VL)) &lt; 0" />
          </Bindings>
        </TextBox>
        <TextBox Width="0.273cm" Height="0.6cm" Left="9.347cm" Top="0.132cm" Value=")" Name="textBox26">
          <Style>
            <Font Bold="True" />
          </Style>
          <Bindings>
            <Binding Path="Visible" Expression="= (Sum(Fields.DbVl - Fields.CrVl) - Sum(Fields.DBBAL) + Sum (Fields.TCR_VL)) &lt; 0" />
