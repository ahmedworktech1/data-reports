<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource1" Width="25.1cm" Name="testReportNew" xmlns="http://schemas.telerik.com/reporting/2021/1.0">
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="azx2024" SelectCommand="&#xD;&#xA;Select azaccmf.Acc_NO,azaccmf.Acc_Nm_AR,ISNULL(Bgn_bl,0) as bgn_bl,&#xD;&#xA;azaccmf.CCT_REP,(select rep_nm_ar from azreps where azaccmf.CCT_REP = azreps.rep_cd) as rep_nm_ar,&#xD;&#xA;TRY_CONVERT(DATETIME, '01/01/1901', 102)  AS FROM_date, &#xD;&#xA;TRY_CONVERT(DATETIME, '01/01/1902', 102) AS TO_date,&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;isnull(BGN_BL,0) &#xD;&#xA;+&#xD;&#xA;ISNULL((SELECT SUM(isnull(PKPRC,0) * isnull(QTY,0)+ isnull(STAX_VL,0) +ISNULL(HTAX,0)-ISNULL(HDISC,0) -isnull(DISC,0)) &#xD;&#xA;FROM AZTRD WHERE ACC_NO=AZACCMF.ACC_NO &#xD;&#xA;AND ( GRP = 1 AND TR_TY IN  (SELECT TR_TY FROM AZTRTY WHERE (AFFACCCR = 1 OR AFFACCDB = 1) AND TR_TY =  AZTRD.TR_TY) ) &#xD;&#xA;AND (TR_DT &gt;=   '01/01/1901'   AND TR_DT &lt;=  '01/01/1902'  )),0) &#xD;&#xA;-&#xD;&#xA;ISNULL((SELECT SUM(PKPRC * QTY+ STAX_VL +ISNULL(HTAX,0)-ISNULL(HDISC,0) -DISC)&#xD;&#xA;FROM AZTRD WHERE ACC_NO=AZACCMF.ACC_NO &#xD;&#xA;AND ( GRP = 0 AND TR_TY IN  (SELECT TR_TY FROM AZTRTY WHERE (AFFACCCR = 1 OR AFFACCDB = 1) AND TR_TY =  AZTRD.TR_TY))&#xD;&#xA;AND (TR_DT &gt;=   '01/01/1901'   AND TR_DT &lt;=  '01/01/1902'  )),0) &#xD;&#xA;-&#xD;&#xA;&#xD;&#xA;ISNULL((SELECT SUM(ISNULL(CR_vl,0)-ISNULL(DB_vl,0))&#xD;&#xA;FROM accstat_w WHERE ACC_NO=AZACCMF.ACC_NO AND &#xD;&#xA;(GRP = 4 AND TR_TY IN  (SELECT TR_TY FROM AZTRTY WHERE (AFFACCCR = 1 OR AFFACCDB = 1) AND TR_TY =  accstat_w.TR_TY))&#xD;&#xA;AND (TR_DT &gt;=   '01/01/1901'   AND TR_DT &lt;=  '01/01/1902'  )),0) &#xD;&#xA;+&#xD;&#xA;isnull((SELECT SUM(isnull(PKPRC,0) * isnull(QTY,0)+ isnull(STAX_VL,0) +ISNULL(HTAX,0)-ISNULL(HDISC,0) - isnull(DISC,0))&#xD;&#xA;FROM AZTRD WHERE ACC_NO=AZACCMF.ACC_NO AND ( GRP = 1 AND TR_TY IN  (SELECT TR_TY FROM AZTRTY WHERE (AFFACCCR = 1 OR AFFACCDB = 1) AND TR_TY =  AZTRD.TR_TY) )&#xD;&#xA;AND (TR_DT &gt;=   '01/01/1901'   AND TR_DT &lt;=  '01/01/1902'  )),0)&#xD;&#xA;-&#xD;&#xA;isnull((SELECT SUM(isnull(PKPRC,0) * isnull(QTY,0)+ isnull(STAX_VL,0) +ISNULL(HTAX,0)-ISNULL(HDISC,0) - isnull(DISC,0))&#xD;&#xA;FROM AZTRD WHERE ACC_NO=AZACCMF.ACC_NO AND &#xD;&#xA;( GRP = 0 AND TR_TY IN  (SELECT TR_TY FROM AZTRTY WHERE (AFFACCCR = 1 OR AFFACCDB = 1) AND TR_TY =  AZTRD.TR_TY))  &#xD;&#xA;AND (TR_DT &gt;=   '01/01/1901'   AND TR_DT &lt;=  '01/01/1902'  )),0)  &#xD;&#xA;-&#xD;&#xA;isnull((SELECT SUM(ISNULL(CR_vl,0)-ISNULL(DB_vl,0)) &#xD;&#xA;FROM accstat_w WHERE ACC_NO=AZACCMF.ACC_NO AND ( GRP = 4 AND TR_TY IN  (SELECT TR_TY FROM AZTRTY WHERE (AFFACCCR = 1 OR AFFACCDB = 1) AND TR_TY =  accstat_w.TR_TY)) &#xD;&#xA;AND (TR_DT &gt;=   '01/01/1901'   AND TR_DT &lt;=  '01/01/1902'  )),0) as 'الرصيد النهائى' ,&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;(select MAX (tr_dt) from AZTRH where aztrh.ACC_NO= azaccmf.Acc_NO AND (TR_DT &gt;=   '01/01/1901'   AND TR_DT &lt;=  '01/01/1902'  ) )as max_tr_ty,&#xD;&#xA;(select MAX (tr_dt) from accstat_w where accstat_w.ACC_NO= azaccmf.Acc_NO AND (TR_DT &gt;=   '01/01/1901'   AND TR_DT &lt;=  '01/01/1902'  ) )as max_acc_tr_ty&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;  &#xD;&#xA;From azaccmf,aztrd &#xD;&#xA;where azaccmf.Rec_id=3 and azaccmf.acc_ty =2 &#xD;&#xA;and  1=1&#xD;&#xA;GROUP BY AZACCMF.CCT_REP,AZACCMF.ACC_NO ,AZACCMF.ACC_NM_AR,AZACCMF.BGN_BL&#xD;&#xA;HAVING &#xD;&#xA;(ROUND (isnull(BGN_BL,0),2) &#xD;&#xA;+&#xD;&#xA;ROUND(ISNULL((SELECT SUM(isnull(PKPRC,0) * isnull(QTY,0)+ isnull(STAX_VL,0) +ISNULL(HTAX,0)-ISNULL(HDISC,0) -isnull(DISC,0)) &#xD;&#xA;FROM AZTRD WHERE ACC_NO=AZACCMF.ACC_NO &#xD;&#xA;AND ( GRP = 1 AND TR_TY IN  (SELECT TR_TY FROM AZTRTY WHERE (AFFACCCR = 1 OR AFFACCDB = 1) AND TR_TY =  AZTRD.TR_TY) ) &#xD;&#xA;AND (TR_DT &gt;=   '01/01/1901'   AND TR_DT &lt;=  '01/01/1902'  )),0) ,2)&#xD;&#xA;-&#xD;&#xA;ROUND(ISNULL((SELECT SUM(PKPRC * QTY+ STAX_VL +ISNULL(HTAX,0)-ISNULL(HDISC,0) -DISC)&#xD;&#xA;FROM AZTRD WHERE ACC_NO=AZACCMF.ACC_NO &#xD;&#xA;AND ( GRP = 0 AND TR_TY IN  (SELECT TR_TY FROM AZTRTY WHERE (AFFACCCR = 1 OR AFFACCDB = 1) AND TR_TY =  AZTRD.TR_TY))&#xD;&#xA;AND (TR_DT &gt;=   '01/01/1901'   AND TR_DT &lt;=  '01/01/1902'  )),0) ,2)&#xD;&#xA;-&#xD;&#xA;&#xD;&#xA;ROUND(ISNULL((SELECT SUM(ISNULL(CR_vl,0)-ISNULL(DB_vl,0))&#xD;&#xA;FROM accstat_w WHERE ACC_NO=AZACCMF.ACC_NO AND &#xD;&#xA;(GRP = 4 AND TR_TY IN  (SELECT TR_TY FROM AZTRTY WHERE (AFFACCCR = 1 OR AFFACCDB = 1) AND TR_TY =  accstat_w.TR_TY))&#xD;&#xA;AND (TR_DT &gt;=   '01/01/1901'   AND TR_DT &lt;=  '01/01/1902'  )),0),2) &#xD;&#xA;+&#xD;&#xA;ROUND(isnull((SELECT SUM(isnull(PKPRC,0) * isnull(QTY,0)+ isnull(STAX_VL,0) +ISNULL(HTAX,0)-ISNULL(HDISC,0) - isnull(DISC,0))&#xD;&#xA;FROM AZTRD WHERE ACC_NO=AZACCMF.ACC_NO AND ( GRP = 1 AND TR_TY IN  (SELECT TR_TY FROM AZTRTY WHERE (AFFACCCR = 1 OR AFFACCDB = 1) AND TR_TY =  AZTRD.TR_TY) )&#xD;&#xA;AND (TR_DT &gt;=   '01/01/1901'   AND TR_DT &lt;=  '01/01/1902'  )),0),2)&#xD;&#xA;-&#xD;&#xA;ROUND(isnull((SELECT SUM(isnull(PKPRC,0) * isnull(QTY,0)+ isnull(STAX_VL,0) +ISNULL(HTAX,0)-ISNULL(HDISC,0) - isnull(DISC,0))&#xD;&#xA;FROM AZTRD WHERE ACC_NO=AZACCMF.ACC_NO AND &#xD;&#xA;( GRP = 0 AND TR_TY IN  (SELECT TR_TY FROM AZTRTY WHERE (AFFACCCR = 1 OR AFFACCDB = 1) AND TR_TY =  AZTRD.TR_TY))  &#xD;&#xA;AND (TR_DT &gt;=   '01/01/1901'   AND TR_DT &lt;=  '01/01/1902'  )),0),2) &#xD;&#xA;-&#xD;&#xA;ROUND(isnull((SELECT SUM(ISNULL(CR_vl,0)-ISNULL(DB_vl,0)) &#xD;&#xA;FROM accstat_w WHERE ACC_NO=AZACCMF.ACC_NO AND ( GRP = 4 AND TR_TY IN  (SELECT TR_TY FROM AZTRTY WHERE (AFFACCCR = 1 OR AFFACCDB = 1) AND TR_TY =  accstat_w.TR_TY)) &#xD;&#xA;AND (TR_DT &gt;=   '01/01/1901'   AND TR_DT &lt;=  '01/01/1902'  )),0),2)&lt;&gt;0)&#xD;&#xA;&#xD;&#xA;order by AZACCMF.CCT_REP,AZACCMF.ACC_NO ,AZACCMF.ACC_NM_AR,AZACCMF.BGN_BL&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;--جملة اخرى لمعرفة الرصيد من كشف الحساب&#xD;&#xA;--select SUM(C_BAL) from ACCSTAT where Acc_NO = '130102010' AND (TR_DT &lt;  {D'2015-04-01'}) &#xD;&#xA;--select SUM(C_BAL) from ACCSTAT where Acc_NO = '130102010' AND (TR_DT &gt;=    {D'2015-04-01'}    AND TR_DT &lt;=   {D'2015-05-31'}) " Name="sqlDataSource1" />
  </DataSources>
