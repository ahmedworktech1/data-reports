<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource1" Width="21cm" Name="Budget_Execution_Report_WithCommitments" xmlns="http://schemas.telerik.com/reporting/2023/1.0">
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="glxsandoaaAhmedHasan" SelectCommand="WITH &#xD;&#xA;&#xD;&#xA;-- الفترة&#xD;&#xA;ReportPeriod AS (&#xD;&#xA;    SELECT &#xD;&#xA;        MAX(CAST(G.fPRD_No AS VARCHAR(20))) AS fprd_no,&#xD;&#xA;        MAX(CAST(G.tPRD_NO AS VARCHAR(20))) AS tPRD_NO&#xD;&#xA;    FROM GLBDG G&#xD;&#xA;    WHERE G.CHKTOT = '0'&#xD;&#xA;),&#xD;&#xA;&#xD;&#xA;-- 1. بنود الارتباط الفردية تحت كل حساب رئيسي (ربط مباشر على BDG_CTG)&#xD;&#xA;RevenueLinks AS (&#xD;&#xA;    SELECT &#xD;&#xA;        A.SEQ AS Seq,&#xD;&#xA;        ROW_NUMBER() OVER (PARTITION BY A.SEQ ORDER BY FL.Linq_Id) AS SubIdx,&#xD;&#xA;        FL.Description AS LinkText,&#xD;&#xA;        CAST(FL.RESERVED AS DECIMAL(18,2)) AS Commitment,          -- الارتباط&#xD;&#xA;        CAST(FL.ActualReserved AS DECIMAL(18,2)) AS Reserved  -- المحجوز الفعلي&#xD;&#xA;    FROM appcodes A&#xD;&#xA;    INNER JOIN Financial_Linq FL &#xD;&#xA;        ON FL.BDG_CTG = A.SEQ&#xD;&#xA;    WHERE A.ID = 63&#xD;&#xA;      AND A.SEQ IN (SELECT DISTINCT M.BDG_CTG FROM GLMF M WHERE M.ACC_NO LIKE '40%' AND M.BDG_CTG IS NOT NULL)&#xD;&#xA;),&#xD;&#xA;ExpenseLinks AS (&#xD;&#xA;    SELECT &#xD;&#xA;        A.SEQ AS Seq,&#xD;&#xA;        ROW_NUMBER() OVER (PARTITION BY A.SEQ ORDER BY FL.Linq_Id) AS SubIdx,&#xD;&#xA;        FL.Description AS LinkText,&#xD;&#xA;        CAST(FL.RESERVED AS DECIMAL(18,2)) AS Commitment,&#xD;&#xA;        CAST(FL.ActualReserved AS DECIMAL(18,2)) AS Reserved&#xD;&#xA;    FROM appcodes A&#xD;&#xA;    INNER JOIN Financial_Linq FL &#xD;&#xA;        ON FL.BDG_CTG = A.SEQ&#xD;&#xA;    WHERE A.ID = 63&#xD;&#xA;      AND A.SEQ IN (SELECT DISTINCT M.BDG_CTG FROM GLMF M WHERE M.ACC_NO LIKE '30%' AND M.BDG_CTG IS NOT NULL)&#xD;&#xA;),&#xD;&#xA;&#xD;&#xA;-- 2. إجمالي الارتباط والمحجوز لكل حساب رئيسي (Seq)&#xD;&#xA;RevenueLinkTotals AS (&#xD;&#xA;    SELECT Seq, &#xD;&#xA;           SUM(ISNULL(Commitment, 0)) AS TotalCommitment, &#xD;&#xA;           SUM(ISNULL(Reserved, 0)) AS TotalReserved&#xD;&#xA;    FROM RevenueLinks&#xD;&#xA;    GROUP BY Seq&#xD;&#xA;),&#xD;&#xA;ExpenseLinkTotals AS (&#xD;&#xA;    SELECT Seq, &#xD;&#xA;           SUM(ISNULL(Commitment, 0)) AS TotalCommitment, &#xD;&#xA;           SUM(ISNULL(Reserved, 0)) AS TotalReserved&#xD;&#xA;    FROM ExpenseLinks&#xD;&#xA;    GROUP BY Seq&#xD;&#xA;),&#xD;&#xA;&#xD;&#xA;-- 3. تفاصيل الإيرادات (موازنة + فعلي + ارتباط ومحجوز) - ديناميكي من GLMF + appcodes&#xD;&#xA;RevenueDetails AS (&#xD;&#xA;    SELECT &#xD;&#xA;        A.SEQ AS Seq, &#xD;&#xA;        MAX(A.DSCR_AR) AS Text, &#xD;&#xA;        CAST(SUM(ISNULL(BdgCalc.BudgetAmt, 0)) AS DECIMAL(18,2)) AS Amount,&#xD;&#xA;        CAST(SUM(ISNULL(ActCalc.ActualAmt, 0)) * -1 AS DECIMAL(18,2)) AS ActualAmount,&#xD;&#xA;        MAX(ISNULL(RLT.TotalCommitment, 0)) AS Commitment,&#xD;&#xA;        MAX(ISNULL(RLT.TotalReserved, 0)) AS Reserved&#xD;&#xA;    FROM GLMF M&#xD;&#xA;    INNER JOIN appcodes A &#xD;&#xA;        ON A.SEQ = M.BDG_CTG &#xD;&#xA;       AND A.ID = 63&#xD;&#xA;    CROSS APPLY (&#xD;&#xA;        SELECT SUM(G.BDG) AS BudgetAmt FROM GLBDG G &#xD;&#xA;        WHERE G.ACC_NO = M.ACC_NO AND G.CHKTOT = '0'&#xD;&#xA;    ) BdgCalc&#xD;&#xA;    CROSS APPLY (&#xD;&#xA;        SELECT SUM(J.db_vl - J.cr_vl) AS ActualAmt FROM gljrnld J &#xD;&#xA;        WHERE J.ACC_NO = M.ACC_NO&#xD;&#xA;    ) ActCalc&#xD;&#xA;    LEFT JOIN RevenueLinkTotals RLT &#xD;&#xA;        ON RLT.Seq = A.SEQ&#xD;&#xA;    WHERE M.ACC_NO LIKE '40%'&#xD;&#xA;      AND M.BDG_CTG IS NOT NULL&#xD;&#xA;    GROUP BY A.SEQ&#xD;&#xA;),&#xD;&#xA;&#xD;&#xA;-- 4. تفاصيل المصروفات (موازنة + فعلي + ارتباط ومحجوز) - ديناميكي من GLMF + appcodes&#xD;&#xA;ExpenseDetails AS (&#xD;&#xA;    SELECT &#xD;&#xA;        A.SEQ AS Seq, &#xD;&#xA;        MAX(A.DSCR_AR) AS Text,&#xD;&#xA;        CAST(SUM(ISNULL(BdgCalc.BudgetAmt, 0)) AS DECIMAL(18,2)) AS Amount,&#xD;&#xA;        CAST(SUM(ISNULL(ActCalc.ActualAmt, 0)) AS DECIMAL(18,2)) AS ActualAmount,&#xD;&#xA;        MAX(ISNULL(ELT.TotalCommitment, 0)) AS Commitment,&#xD;&#xA;        MAX(ISNULL(ELT.TotalReserved, 0)) AS Reserved&#xD;&#xA;    FROM GLMF M&#xD;&#xA;    INNER JOIN appcodes A &#xD;&#xA;        ON A.SEQ = M.BDG_CTG &#xD;&#xA;       AND A.ID = 63&#xD;&#xA;    CROSS APPLY (&#xD;&#xA;        SELECT SUM(G.BDG) AS BudgetAmt FROM GLBDG G &#xD;&#xA;        WHERE G.ACC_NO = M.ACC_NO AND G.CHKTOT = '0'&#xD;&#xA;    ) BdgCalc&#xD;&#xA;    CROSS APPLY (&#xD;&#xA;        SELECT SUM(J.db_vl - J.cr_vl) AS ActualAmt FROM gljrnld J &#xD;&#xA;        WHERE J.ACC_NO = M.ACC_NO&#xD;&#xA;    ) ActCalc&#xD;&#xA;    LEFT JOIN ExpenseLinkTotals ELT &#xD;&#xA;        ON ELT.Seq = A.SEQ&#xD;&#xA;    WHERE M.ACC_NO LIKE '30%'&#xD;&#xA;      AND M.BDG_CTG IS NOT NULL&#xD;&#xA;    GROUP BY A.SEQ&#xD;&#xA;),&#xD;&#xA;&#xD;&#xA;-- 5. التجميع النهائي&#xD;&#xA;CombinedReport AS (&#xD;&#xA;    -- أولاً: الإيرادات&#xD;&#xA;    SELECT NULL AS SerialNo, 'أولاً: الإيرادات' AS StatementText, &#xD;&#xA;           CAST(0 AS DECIMAL(18,2)) AS Amount, CAST(0 AS DECIMAL(18,2)) AS ActualAmount,&#xD;&#xA;           CAST(0 AS DECIMAL(18,2)) AS Commitment, CAST(0 AS DECIMAL(18,2)) AS Reserved,&#xD;&#xA;           CAST(0 AS DECIMAL(18,2)) AS Increase, CAST(0 AS DECIMAL(18,2)) AS Deficit,&#xD;&#xA;           CAST(0 AS DECIMAL(9,4)) AS ExecPct,&#xD;&#xA;           1000 AS SortOrder, 'SectionTitle' AS SectionType&#xD;&#xA;&#xD;&#xA;    -- الحساب الرئيسي (موازنة + فعلي + ارتباط + محجوز + زيادة/عجز/نسبة)&#xD;&#xA;    UNION ALL&#xD;&#xA;    SELECT &#xD;&#xA;        Seq, Text, Amount, ActualAmount, Commitment, Reserved,&#xD;&#xA;        CASE WHEN ActualAmount &lt; Amount THEN Amount - ActualAmount ELSE 0 END,&#xD;&#xA;        CASE WHEN ActualAmount &gt; Amount THEN ActualAmount - Amount ELSE 0 END,&#xD;&#xA;        CASE WHEN ISNULL(Amount, 0) = 0 THEN CAST(0 AS DECIMAL(18,4)) ELSE CAST(ActualAmount AS DECIMAL(18,4)) / Amount END,&#xD;&#xA;        1000 + Seq * 100, 'Detail'&#xD;&#xA;    FROM RevenueDetails&#xD;&#xA;&#xD;&#xA;    -- بنود الارتباط تحت كل حساب رئيسي&#xD;&#xA;    UNION ALL&#xD;&#xA;    SELECT &#xD;&#xA;        NULL, LinkText, CAST(0 AS DECIMAL(18,2)), CAST(0 AS DECIMAL(18,2)), &#xD;&#xA;        ISNULL(Commitment,0), ISNULL(Reserved,0),&#xD;&#xA;        CAST(0 AS DECIMAL(18,2)), CAST(0 AS DECIMAL(18,2)), CAST(0 AS DECIMAL(9,4)),&#xD;&#xA;        1000 + Seq * 100 + SubIdx, 'CommitmentItem'&#xD;&#xA;    FROM RevenueLinks&#xD;&#xA;&#xD;&#xA;    -- إجمالي الإيرادات (موازنة)&#xD;&#xA;    UNION ALL&#xD;&#xA;    SELECT NULL, 'إجمالي الإيرادات (موازنة)', SUM(Amount), SUM(ActualAmount), SUM(Commitment), SUM(Reserved),&#xD;&#xA;        CASE WHEN SUM(ActualAmount) &lt; SUM(Amount) THEN SUM(Amount) - SUM(ActualAmount) ELSE 0 END,&#xD;&#xA;        CASE WHEN SUM(ActualAmount) &gt; SUM(Amount) THEN SUM(ActualAmount) - SUM(Amount) ELSE 0 END,&#xD;&#xA;        CASE WHEN SUM(Amount) = 0 THEN CAST(0 AS DECIMAL(18,4)) ELSE CAST(SUM(ActualAmount) AS DECIMAL(18,4)) / SUM(Amount) END,&#xD;&#xA;        2999, 'BudgetTotal'&#xD;&#xA;    FROM RevenueDetails&#xD;&#xA;&#xD;&#xA;    -- ثانياً: المصروفات&#xD;&#xA;    UNION ALL&#xD;&#xA;    SELECT NULL, 'ثانياً: المصروفات', 0, 0, 0, 0, 0, 0, 0, 3000, 'SectionTitle'&#xD;&#xA;&#xD;&#xA;    UNION ALL&#xD;&#xA;    SELECT &#xD;&#xA;        Seq, Text, Amount, ActualAmount, Commitment, Reserved,&#xD;&#xA;        CASE WHEN ActualAmount &lt; Amount THEN Amount - ActualAmount ELSE 0 END,&#xD;&#xA;        CASE WHEN ActualAmount &gt; Amount THEN ActualAmount - Amount ELSE 0 END,&#xD;&#xA;        CASE WHEN ISNULL(Amount, 0) = 0 THEN CAST(0 AS DECIMAL(18,4)) ELSE CAST(ActualAmount AS DECIMAL(18,4)) / Amount END,&#xD;&#xA;        3000 + Seq * 100, 'Detail'&#xD;&#xA;    FROM ExpenseDetails&#xD;&#xA;&#xD;&#xA;    UNION ALL&#xD;&#xA;    SELECT &#xD;&#xA;        NULL, LinkText, CAST(0 AS DECIMAL(18,2)), CAST(0 AS DECIMAL(18,2)), &#xD;&#xA;        ISNULL(Commitment,0), ISNULL(Reserved,0),&#xD;&#xA;        CAST(0 AS DECIMAL(18,2)), CAST(0 AS DECIMAL(18,2)), CAST(0 AS DECIMAL(9,4)),&#xD;&#xA;        3000 + Seq * 100 + SubIdx, 'CommitmentItem'&#xD;&#xA;    FROM ExpenseLinks&#xD;&#xA;&#xD;&#xA;    UNION ALL&#xD;&#xA;    SELECT NULL, 'إجمالي المصروفات (موازنة)', SUM(Amount), SUM(ActualAmount), SUM(Commitment), SUM(Reserved),&#xD;&#xA;        CASE WHEN SUM(ActualAmount) &lt; SUM(Amount) THEN SUM(Amount) - SUM(ActualAmount) ELSE 0 END,&#xD;&#xA;        CASE WHEN SUM(ActualAmount) &gt; SUM(Amount) THEN SUM(ActualAmount) - SUM(Amount) ELSE 0 END,&#xD;&#xA;        CASE WHEN SUM(Amount) = 0 THEN CAST(0 AS DECIMAL(18,4)) ELSE CAST(SUM(ActualAmount) AS DECIMAL(18,4)) / SUM(Amount) END,&#xD;&#xA;        5999, 'BudgetTotal'&#xD;&#xA;    FROM ExpenseDetails&#xD;&#xA;)&#xD;&#xA;&#xD;&#xA;-- النهائي&#xD;&#xA;SELECT &#xD;&#xA;    CR.SerialNo, &#xD;&#xA;    CR.StatementText, &#xD;&#xA;    CR.Amount,&#xD;&#xA;    CR.ActualAmount,&#xD;&#xA;    CR.Commitment,&#xD;&#xA;    CR.Reserved,&#xD;&#xA;    CR.Increase,&#xD;&#xA;    CR.Deficit,&#xD;&#xA;    CR.ExecPct,&#xD;&#xA;    CR.SectionType,&#xD;&#xA;    RP.fprd_no,&#xD;&#xA;    RP.tPRD_NO,&#xD;&#xA;    CR.SortOrder,&#xD;&#xA;    CASE &#xD;&#xA;        WHEN CR.SortOrder BETWEEN 1000 AND 2999 THEN 1&#xD;&#xA;        WHEN CR.SortOrder BETWEEN 3000 AND 5999 THEN 2&#xD;&#xA;        ELSE 0 &#xD;&#xA;    END AS ReportSection&#xD;&#xA;FROM CombinedReport CR&#xD;&#xA;CROSS JOIN ReportPeriod RP&#xD;&#xA;ORDER BY CR.SortOrder;" Name="sqlDataSource1" />
  </DataSources>
