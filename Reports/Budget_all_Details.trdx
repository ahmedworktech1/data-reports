    <DetailSection Height="0.7cm" Name="detailSection1">
      <Items>
        <TextBox Width="1.6cm" Height="0.7cm" Left="0.2cm" Top="0cm" Value="=Fields.ExecPct" Format="{0:P1}" Name="textBoxPct">
          <Style BackgroundColor="White" TextAlign="Center" VerticalAlign="Middle">
            <Font Size="6pt" Bold="True" Underline="False" />
            <BorderStyle Top="Solid" Bottom="Solid" Left="Solid" Right="Solid" />
            <BorderColor Top="Black" Bottom="Black" Left="Black" Right="Black" />
            <BorderWidth Top="0.5pt" Bottom="0.5pt" Left="1pt" Right="1pt" />
          </Style>
          <ConditionalFormatting>
            <FormattingRule>
              <Style BackgroundColor="Aqua" />
              <Filters>
                <Filter Expression="= Fields.StatementText" Operator="Equal" Value="=&quot;إجمالي الإيرادات (موازنة)&quot;" />
              </Filters>
            </FormattingRule>
            <FormattingRule>
              <Style BackgroundColor="226, 198, 255" />
              <Filters>
                <Filter Expression="= Fields.StatementText" Operator="Equal" Value="=&quot;إجمالي المصروفات (موازنة)&quot;" />
              </Filters>
            </FormattingRule>
            <FormattingRule>
              <Style BackgroundColor="220, 230, 241">
                <Font Bold="True" />
              </Style>
              <Filters>
                <Filter Expression="= Fields.SectionType" Operator="In" Value="SectionTitle|BudgetTotal" />
              </Filters>
            </FormattingRule>
            <FormattingRule>
              <Style BackgroundColor="255, 242, 204" />
              <Filters>
                <Filter Expression="= Fields.SectionType" Operator="Equal" Value="=&quot;COMMITMENTITEM&quot;" />
              </Filters>
            </FormattingRule>
            <FormattingRule>
              <Style BackgroundColor="220, 230, 241" />
              <Filters>
                <Filter Expression="= Fields.SectionType" Operator="Equal" Value="=&quot;DETAIL&quot;" />
              </Filters>
            </FormattingRule>
          </ConditionalFormatting>
        </TextBox>
        <TextBox Width="2cm" Height="0.7cm" Left="1.8cm" Top="0cm" Value="=Fields.Deficit" Format="{0:N2}" Name="textBoxDeficit">
          <Style BackgroundColor="White" TextAlign="Center" VerticalAlign="Middle">
