<?xml version="1.0" encoding="utf-8"?>
<Report DataSourceName="sqlDataSource2" Width="242.91mm" UnitOfMeasure="Mm" Name="ReportGlunbaljrn" ShowWatermarks="False" xmlns="http://schemas.telerik.com/reporting/2021/1.0">
  <Style Visible="True" />
  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="glx2024" SelectCommand="WITH Expenses AS (&#xA;    SELECT &#xA;        GLJRNLD.scst_cd,&#xA;        GLJRNLD.acc_no,&#xA;        GLJRNLD.itm_Cd,&#xA;&#x9;&#x9;GLJRNLD.tr_no as tr_no,&#xA;&#x9;&#x9;GLJRNLD.TR_DT as TR_DT,&#xA;&#x9;&#x9;GLJRNLD.ln_no as ln_no,&#xA;        GLLISTS.Dscr_Ar AS itmnm,&#xA;        db_vl - cr_vl AS expense,&#xA;&#x9;&#x9;glScst.SCST_NM_Ar as scst_nm,&#xA;        glScst.PLT_NO as pltno,&#xA;        glScst.MOT_NO as motor,&#xA;        glScst.CHS_NO as chsno,&#xA;        glLoc.unt_nm_ar as untnm,&#xA;&#x9;&#x9;GLMF.ACC_NM_Ar as accnm,&#xA;&#x9;&#x9;GLTRSTBL.DOC_DS_Ar as docnm,&#xA;&#x9;&#x9;GLJRNLD.previous_mileage as prev_mil  ,&#xA;&#x9;&#x9;GLJRNLD.CURRENT_MILEAGE as curn_mil,&#xA;&#x9;&#x9;(GLJRNLD.CURRENT_MILEAGE - GLJRNLD.previous_mileage) as diff_mil&#xA;&#x9;&#xA;&#x9;&#x9;&#xA;    FROM GLJRNLD &#xA;    LEFT JOIN GLLISTS ON GLJRNLD.itm_Cd = GLLISTS.Code&#xA;    LEFT JOIN glScst ON GLJRNLD.scst_cd = glScst.Scst_cd&#xA;    LEFT JOIN glLoc ON GLJRNLD.COM_ID = glLoc.UNT_CD&#xA;&#x9;LEFT JOIN glmf ON GLJRNLD.ACC_NO = GLMF.ACC_NO&#xA;&#x9;LEFT JOIN GLTRSTBL ON GLJRNLD.JRN_CD = GLTRSTBL.DOC_TY&#xA;&#x9;LEFT JOIN glcst ON GLJRNLD.CST_CD = glcst.cst_cd&#xA;    WHERE &#xA;        (&#xA;&#xA;            GLJRNLD.ACC_NO LIKE '4[6-8]112101%' OR  &#xA;&#x9;&#x9;&#x9; GLJRNLD.ACC_NO LIKE '4[6-8]112102%' OR   GLJRNLD.ACC_NO LIKE '4[6-8]112103%' &#xA;&#x9;&#x9;&#x9; OR   GLJRNLD.ACC_NO LIKE '4[6-8]112104%' OR   GLJRNLD.ACC_NO LIKE '4[6-8]112105%'&#xA;&#x9;&#x9;&#x9; or GLJRNLD.ACC_NO LIKE '4[6-8]11231%' OR GLJRNLD.ACC_NO LIKE '4[6-8]11233%'&#xA;&#x9;&#x9;&#x9; or  GLJRNLD.ACC_NO LIKE '4[6-8]1132%'&#xA;        ) &#xA;        AND (GLJRNLD.scst_cd LIKE '113%' OR GLJRNLD.scst_cd LIKE '114%') and (1=1)&#xA;)&#xA;SELECT &#xA;    E.scst_cd,&#xA;&#x9;E.scst_nm,&#xA;    E.pltno,&#xA;    E.motor,&#xA;    E.chsno,&#xA;    E.untnm,&#xA;    E.acc_no,&#xA;&#x9;E.accnm,&#xA;    E.itm_Cd,&#xA;    E.itmnm,&#xA;&#x9;E.docnm,&#xA;&#x9;E.TR_DT,&#xA;&#x9;E.tr_no,&#xA;&#x9;E.ln_no,&#xA;    E.expense,&#xA;&#x9;E.prev_mil,&#xA;&#x9;E.curn_mil,&#xA;&#x9;E.diff_mil&#xA;FROM Expenses E&#xA;ORDER BY &#xA;    E.scst_cd,&#xA;    E.acc_no,&#xA;    E.itm_Cd;&#xA;" Name="sqlDataSource2" />
  </DataSources>
