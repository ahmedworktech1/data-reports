  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="glx2024" SelectCommand="select   'خدمة عملاء' as s,&#xD;&#xA;CAST(ROUND(sum( case when ((( acc_no like '5[6-8]1122103%' ) &#xD;&#xA;and  SUM_CD IN ('11','12','13')) ) then db_vl-cr_vl else 0 end )/1000, 0)*-1 AS BIGINT)  as s1,&#xD;&#xA;&#xD;&#xA;CAST(ROUND(sum( case when ((( acc_no like '0%' ) &#xD;&#xA;and  SUM_CD IN ('11','12','13')) ) then db_vl-cr_vl else 0 end )/1000, 0)*-1 AS BIGINT)  as s2&#xD;&#xA;from gljrnld  WHERE (((  acc_no like '5[6-8]1122103%' )&#xD;&#xA;&#xD;&#xA; and  SUM_CD IN ('11','12','13')) ) &#xD;&#xA;&#xD;&#xA;AND (1=1) UNION ALL&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;select   'خدمات مباعة تيار' as s,&#xD;&#xA;CAST(ROUND(sum( case when ((( acc_no like '5[6-8]1122101%') &#xD;&#xA;and  SUM_CD IN ('11','12','13')) ) then db_vl-cr_vl else 0 end )/1000, 0)*-1 AS BIGINT)  as s1,&#xD;&#xA;&#xD;&#xA;CAST(ROUND(sum( case when ((( acc_no like '0%' ) &#xD;&#xA;and  SUM_CD IN ('11','12','13')) ) then db_vl-cr_vl else 0 end )/1000, 0)*-1 AS BIGINT)  as s2&#xD;&#xA;&#xD;&#xA;from gljrnld  WHERE ((( acc_no like '5[6-8]1122101%')&#xD;&#xA;&#xD;&#xA; and  SUM_CD IN ('11','12','13')) )  AND (1=1)&#xD;&#xA;&#xD;&#xA; UNION ALL&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;select   'إجمالي إيرادات النشاط الجاري بخلاف التيار' as s,&#xD;&#xA;&#xD;&#xA;CAST(ROUND(sum( case when ((( acc_no like '0%' ) &#xD;&#xA;and  SUM_CD IN ('11','12','13')) ) then db_vl-cr_vl else 0 end )/1000, 0)*-1 AS BIGINT)  as s1,&#xD;&#xA;CAST(ROUND(sum( case when ((( acc_no like '5[6-8]1122103%'  or  acc_no like '5[6-8]1122101%') &#xD;&#xA;and  SUM_CD IN ('11','12','13')) ) then db_vl-cr_vl else 0 end )/1000, 0)*-1 AS BIGINT)  as s2&#xD;&#xA;&#xD;&#xA;from gljrnld  WHERE ((( acc_no like '5[6-8]1122103%' or  acc_no like '5[6-8]1122101%')&#xD;&#xA;&#xD;&#xA; and  SUM_CD IN ('11','12','13')) ) &#xD;&#xA;&#xD;&#xA; AND (1=1) UNION ALL&#xD;&#xA;&#xD;&#xA;select   'التكاليف والمصروفات' as s,&#xD;&#xA;CAST(ROUND(sum( case when (((  acc_no like '0%') &#xD;&#xA;and  SUM_CD IN ('0')) ) and cst_Cd not like '0%' then db_vl-cr_vl else 0 end )/1000, null) AS BIGINT)  as s1,&#xD;&#xA;&#xD;&#xA;CAST(ROUND(sum( case when ((( acc_no like '0%' ) &#xD;&#xA;and  SUM_CD IN ('11','12','13')) ) then db_vl-cr_vl else 0 end )/1000, 0)*-1 AS BIGINT)  as s2&#xD;&#xA;&#xD;&#xA;from gljrnld &#xD;&#xA; &#xD;&#xA;&#xD;&#xA;WHERE  (1=1) UNION ALL&#xD;&#xA;&#xD;&#xA;  select   'خامات ومواد ووقود وقطع غيار' as s,&#xD;&#xA;CAST(ROUND(sum( case when (((  acc_no like '0%') &#xD;&#xA;and  SUM_CD IN ('0')) ) and cst_Cd not like '0%' then db_vl-cr_vl else 0 end )/1000, null) AS BIGINT)  as s1,&#xD;&#xA;&#xD;&#xA;CAST(ROUND(sum( case when ((( acc_no like '0%' ) &#xD;&#xA;and  SUM_CD IN ('11','12','13')) ) then db_vl-cr_vl else 0 end )/1000, 0)*-1 AS BIGINT)  as s2&#xD;&#xA;&#xD;&#xA;from gljrnld &#xD;&#xA; &#xD;&#xA;&#xD;&#xA;WHERE (1=1) UNION ALL&#xD;&#xA;&#xD;&#xA;select   'قطع غيار ومهمات' as s,&#xD;&#xA;CAST(ROUND(sum( case when (((  acc_no like '4[7]113%') &#xD;&#xA;and  SUM_CD IN ('11')) ) and cst_Cd not like '11%' then db_vl-cr_vl else 0 end )/1000, 0) AS BIGINT)  as s1,&#xD;&#xA;&#xD;&#xA;CAST(ROUND(sum( case when ((( acc_no like '0%' ) &#xD;&#xA;and  SUM_CD IN ('11','12','13')) ) then db_vl-cr_vl else 0 end )/1000, 0)*-1 AS BIGINT)  as s2&#xD;&#xA;&#xD;&#xA;from gljrnld  WHERE (  acc_no like '4[7]113%') and  SUM_CD IN ('11') and cst_Cd not like '11%'&#xD;&#xA;&#xD;&#xA;AND (1=1) UNION ALL&#xD;&#xA;&#xD;&#xA;select   'باقي خامات ومواد ووقود وقطع غيار' as s,&#xD;&#xA;CAST(ROUND(sum( case when (((  acc_no like '4[7]111%' or  acc_no like '4[7]112%' or  acc_no like '4[7]114%' or  acc_no like '4[7]115%' or  acc_no like '4[7]116%') &#xD;&#xA;and  SUM_CD IN ('11')) ) and cst_Cd not like '11%' then db_vl-cr_vl else 0 end )/1000, 0) AS BIGINT)  as s1,&#xD;&#xA;&#xD;&#xA;CAST(ROUND(sum( case when ((( acc_no like '0%' ) &#xD;&#xA;and  SUM_CD IN ('11','12','13')) ) then db_vl-cr_vl else 0 end )/1000, 0)*-1 AS BIGINT)  as s2&#xD;&#xA;&#xD;&#xA;from gljrnld  WHERE (  acc_no like '4[7]111%' or  acc_no like '4[7]112%' or  acc_no like '4[7]114%' or  acc_no like '4[7]115%' or  acc_no like '4[7]116%') and  SUM_CD IN ('11') and cst_Cd not like '11%'&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;AND (1=1) UNION ALL&#xD;&#xA;&#xD;&#xA;select   'الأجور' as s,&#xD;&#xA; CAST(ROUND(sum( case when (((  acc_no like '4[7]12%') &#xD;&#xA;and  SUM_CD IN ('11')) ) and cst_Cd not like '11%' then db_vl-cr_vl else 0 end )/1000, 0) AS BIGINT) as s1,&#xD;&#xA;CAST(ROUND(sum( case when ((( acc_no like '0%' ) &#xD;&#xA;and  SUM_CD IN ('11','12','13')) ) then db_vl-cr_vl else 0 end )/1000, 0)*-1 AS BIGINT)  as s2&#xD;&#xA;&#xD;&#xA;from gljrnld  WHERE (   acc_no like '4[7]12%') and  SUM_CD IN ('11') and cst_Cd not like '11%'&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;AND (1=1) UNION ALL&#xD;&#xA;&#xD;&#xA;select   'إجمالي خامات ومواد ووقود وقطع غيار والأجور' as s,&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;CAST(ROUND(sum( case when ((( acc_no like '0%' ) &#xD;&#xA;and  SUM_CD IN ('11','12','13')) ) then db_vl-cr_vl else 0 end )/1000, 0)*-1 AS BIGINT)  as s1,&#xD;&#xA;CAST(ROUND(sum( case when (((acc_no like '4[7]11%' or  acc_no like '4[7]12%') &#xD;&#xA;and  SUM_CD IN ('11')) ) and cst_Cd not like '11%' then db_vl-cr_vl else 0 end )/1000, 0) AS BIGINT)  as s2&#xD;&#xA;&#xD;&#xA;from gljrnld  WHERE (acc_no like '4[7]11%' or  acc_no like '4[7]12%') and  SUM_CD IN ('11') and cst_Cd not like '11%'&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA; AND (1=1) UNION ALL&#xD;&#xA;&#xD;&#xA;select   'المصروفات' as s,&#xD;&#xA;CAST(ROUND(sum( case when (((  acc_no like '0%') &#xD;&#xA;and  SUM_CD IN ('0')) ) and cst_Cd not like '0%' then db_vl-cr_vl else 0 end )/1000, null) AS BIGINT)  as s1,&#xD;&#xA;&#xD;&#xA;CAST(ROUND(sum( case when ((( acc_no like '0%' ) &#xD;&#xA;and  SUM_CD IN ('11','12','13')) ) then db_vl-cr_vl else 0 end )/1000, 0)*-1 AS BIGINT)  as s2&#xD;&#xA;&#xD;&#xA;from gljrnld &#xD;&#xA; &#xD;&#xA;WHERE (1=1) UNION ALL&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;select   'مصروفات صيانة' as s,&#xD;&#xA;CAST(ROUND(sum( case when (((acc_no like '4[7]211%' ) &#xD;&#xA;and  SUM_CD IN ('11')) ) and cst_Cd not like '11%' then db_vl-cr_vl else 0 end )/1000, 0) AS BIGINT)  as s1,&#xD;&#xA;&#xD;&#xA;CAST(ROUND(sum( case when ((( acc_no like '0%' ) &#xD;&#xA;and  SUM_CD IN ('11','12','13')) ) then db_vl-cr_vl else 0 end )/1000, 0)*-1 AS BIGINT)  as s2&#xD;&#xA;&#xD;&#xA;from gljrnld  WHERE (acc_no like '4[7]211%' ) and  SUM_CD IN ('11') and cst_Cd not like '11%'&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;AND (1=1) UNION ALL&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;select   'باقي خدمات مشتراه' as s,&#xD;&#xA;(CAST(ROUND(sum( case when (((acc_no like '4[7]21%' ) &#xD;&#xA;and  SUM_CD IN ('11')) ) and cst_Cd not like '11%' then db_vl-cr_vl else 0 end )/1000, 0) AS BIGINT)&#xD;&#xA;-&#xD;&#xA;&#xD;&#xA;CAST(ROUND(sum( case when (((acc_no like '4[7]211%' ) &#xD;&#xA;and  SUM_CD IN ('11')) ) and cst_Cd not like '11%' then db_vl-cr_vl else 0 end )/1000, 0) AS BIGINT))  as s1,&#xD;&#xA;&#xD;&#xA;CAST(ROUND(sum( case when ((( acc_no like '0%' ) &#xD;&#xA;and  SUM_CD IN ('11','12','13')) ) then db_vl-cr_vl else 0 end )/1000, 0)*-1 AS BIGINT)  as s2&#xD;&#xA;&#xD;&#xA;from gljrnld  WHERE (acc_no like '4[7]21%' ) and  SUM_CD IN ('11') and cst_Cd not like '11%'&#xD;&#xA;&#xD;&#xA;AND (1=1) UNION ALL&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;select   'إهلاك واستهلاك' as s,&#xD;&#xA;CAST(ROUND(sum( case when (((acc_no like '4[7]22%') &#xD;&#xA;and  SUM_CD IN ('11')) ) and cst_Cd not like '11%' then db_vl-cr_vl else 0 end )/1000, 0) AS BIGINT)  as s1,&#xD;&#xA;&#xD;&#xA;CAST(ROUND(sum( case when ((( acc_no like '0%' ) &#xD;&#xA;and  SUM_CD IN ('11','12','13')) ) then db_vl-cr_vl else 0 end )/1000, 0)*-1 AS BIGINT)  as s2&#xD;&#xA;&#xD;&#xA;from gljrnld  WHERE (acc_no like '4[7]22%' ) and  SUM_CD IN ('11') and cst_Cd not like '11%'&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;AND (1=1) UNION ALL&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;select   'فوائد محلية' as s,&#xD;&#xA;CAST(ROUND(sum( case when (((acc_no like '4[7]23111%') &#xD;&#xA;and  SUM_CD IN ('11')) ) and cst_Cd not like '11%' then db_vl-cr_vl else 0 end )/1000, 0) AS BIGINT)  as s1,&#xD;&#xA;&#xD;&#xA;CAST(ROUND(sum( case when ((( acc_no like '0%' ) &#xD;&#xA;and  SUM_CD IN ('11','12','13')) ) then db_vl-cr_vl else 0 end )/1000, 0)*-1 AS BIGINT)  as s2&#xD;&#xA;&#xD;&#xA;from gljrnld  WHERE (acc_no like '4[7]23111%') and  SUM_CD IN ('11') and cst_Cd not like '11%'&#xD;&#xA;&#xD;&#xA;AND (1=1) UNION ALL&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;select   'فوائد أجنبية' as s,&#xD;&#xA;CAST(ROUND(sum( case when (((acc_no like '4[7]23112%') &#xD;&#xA;and  SUM_CD IN ('11')) ) and cst_Cd not like '11%' then db_vl-cr_vl else 0 end )/1000, 0) AS BIGINT)  as s1,&#xD;&#xA;&#xD;&#xA;CAST(ROUND(sum( case when ((( acc_no like '0%' ) &#xD;&#xA;and  SUM_CD IN ('11','12','13')) ) then db_vl-cr_vl else 0 end )/1000, 0)*-1 AS BIGINT)  as s2&#xD;&#xA;&#xD;&#xA;from gljrnld  WHERE (acc_no like '4[7]23112%') and  SUM_CD IN ('11') and cst_Cd not like '11%'&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;AND (1=1) UNION ALL&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;select   'إيجار عقارات' as s,&#xD;&#xA;CAST(ROUND(sum( case when (((acc_no like '4[7]24%') &#xD;&#xA;and  SUM_CD IN ('11')) ) and cst_Cd not like '11%' then db_vl-cr_vl else 0 end )/1000, 0) AS BIGINT)  as s1,&#xD;&#xA;&#xD;&#xA;CAST(ROUND(sum( case when ((( acc_no like '0%' ) &#xD;&#xA;and  SUM_CD IN ('11','12','13')) ) then db_vl-cr_vl else 0 end )/1000, 0)*-1 AS BIGINT)  as s2&#xD;&#xA;&#xD;&#xA;from gljrnld  WHERE (acc_no like '4[7]24%') and  SUM_CD IN ('11') and cst_Cd not like '11%'&#xD;&#xA;&#xD;&#xA;AND (1=1) UNION ALL&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;select   'ضرائب غير مباشرة على النشاط' as s,&#xD;&#xA;CAST(ROUND(sum( case when (((acc_no like '4[7]25%' or acc_no like '4[7]26%') &#xD;&#xA;and  SUM_CD IN ('11')) ) and cst_Cd not like '11%' then db_vl-cr_vl else 0 end )/1000, 0) AS BIGINT)  as s1,&#xD;&#xA;&#xD;&#xA;CAST(ROUND(sum( case when ((( acc_no like '0%' ) &#xD;&#xA;and  SUM_CD IN ('11','12','13')) ) then db_vl-cr_vl else 0 end )/1000, 0)*-1 AS BIGINT)  as s2&#xD;&#xA;&#xD;&#xA;from gljrnld  WHERE (acc_no like '4[7]25%' or acc_no like '4[7]26%') and  SUM_CD IN ('11') and cst_Cd not like '11%'&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;AND (1=1) UNION ALL&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;select   'إجمالي المصروفات' as s,&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;CAST(ROUND(sum( case when ((( acc_no like '0%' ) &#xD;&#xA;and  SUM_CD IN ('11','12','13')) ) then db_vl-cr_vl else 0 end )/1000, 0)*-1 AS BIGINT)  as s1,&#xD;&#xA;CAST(ROUND(sum( case when (((acc_no like '4[7]21%' or acc_no like '4[7]22%'  or acc_no like '4[7]23%' or acc_no like '4[7]24%' or acc_no like '4[7]25%' or acc_no like '4[7]26%') &#xD;&#xA;and  SUM_CD IN ('11')) ) and cst_Cd not like '11%' then db_vl-cr_vl else 0 end )/1000, 0) AS BIGINT)  as s2&#xD;&#xA;&#xD;&#xA;from gljrnld  WHERE (acc_no like '4[7]21%' or acc_no like '4[7]22%' or acc_no like '4[7]23%' or acc_no like '4[7]24%' or acc_no like '4[7]25%' or acc_no like '4[7]26%') and  SUM_CD IN ('11') and cst_Cd not like '11%'&#xD;&#xA;&#xD;&#xA;AND (1=1) UNION ALL&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;select   'إجمالي التكاليف والمصروفات' as s,&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;CAST(ROUND(sum( case when ((( acc_no like '0%' ) &#xD;&#xA;and  SUM_CD IN ('11','12','13')) ) then db_vl-cr_vl else 0 end )/1000, 0)*-1 AS BIGINT)  as s1,&#xD;&#xA;CAST(ROUND(sum( case when (((acc_no like '4[7]11%' or  acc_no like '4[7]12%' or acc_no like '4[7]21%' or acc_no like '4[7]22%' or acc_no like '4[7]23%'  or acc_no like '4[7]24%' or acc_no like '4[7]25%' or acc_no like '4[7]26%') &#xD;&#xA;and  SUM_CD IN ('11')) ) and cst_Cd not like '11%' then db_vl-cr_vl else 0 end )/1000, 0) AS BIGINT)  as s2&#xD;&#xA;&#xD;&#xA;from gljrnld  WHERE (acc_no like '4[7]11%' or  acc_no like '4[7]12%' or acc_no like '4[7]21%' or acc_no like '4[7]22%' or acc_no like '4[7]23%'  or acc_no like '4[7]24%' or acc_no like '4[7]25%' or acc_no like '4[7]26%') and  SUM_CD IN ('11') and cst_Cd not like '11%'&#xD;&#xA;&#xD;&#xA;AND (1=1) UNION ALL&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;select   'نتيجة النشاط' as s,&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;CAST(ROUND(sum( case when ((( acc_no like '0%' ) &#xD;&#xA;and  SUM_CD IN ('11','12','13')) ) then db_vl-cr_vl else 0 end )/1000, 0)*-1 AS BIGINT)  as s1,&#xD;&#xA;(CAST(ROUND(sum( case when ((( acc_no like '5[6-8]1122103%'  or  acc_no like '5[6-8]1122101%') &#xD;&#xA;and  SUM_CD IN ('11','12','13')) ) then db_vl-cr_vl else 0 end )/1000, 0)*-1 AS BIGINT) &#xD;&#xA;-&#xD;&#xA;&#xD;&#xA;CAST(ROUND(sum( case when (((acc_no like '4[7]11%' or  acc_no like '4[7]12%' or acc_no like '4[7]21%' or acc_no like '4[7]22%'  or acc_no like '4[7]24%' or acc_no like '4[7]25%' or acc_no like '4[7]26%') &#xD;&#xA;and  SUM_CD IN ('11')) ) and cst_Cd not like '11%' then db_vl-cr_vl else 0 end )/1000, 0) AS BIGINT))  as s2&#xD;&#xA;&#xD;&#xA;from gljrnld  WHERE (acc_no like '5[6-8]1122103%'  or  acc_no like '5[6-8]1122101%' or acc_no like '4[7]11%' or  acc_no like '4[7]12%' or acc_no like '4[7]21%' or acc_no like '4[7]22%'  or acc_no like '4[7]24%' or acc_no like '4[7]25%' or acc_no like '4[7]26%') and  SUM_CD IN ('11') and cst_Cd not like '11%'&#xD;&#xA;&#xD;&#xA;AND (1=1)&#xD;&#xA;" Name="sqlDataSource1" />
