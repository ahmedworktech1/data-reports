  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="glxarmy" SelectCommand="WITH DebitRows AS (&#xD;&#xA;    SELECT OPERATION_NO, LN_NO, m.manacc macc1, d.ACC_NO AS AccNo1,AMT AS Db,&#xD;&#xA;        ROW_NUMBER() OVER (PARTITION BY OPERATION_NO ORDER BY TR_DT) AS RowNum&#xD;&#xA;    FROM glmf m inner join EXPENSE_FORMS d on d.acc_no=m.ACC_NO WHERE LN_TY = 1 -- المدين فقط&#xD;&#xA;),&#xD;&#xA;CreditRows AS (&#xD;&#xA;     SELECT OPERATION_NO, LN_NO, m.manacc macc2, d.ACC_NO AS AccNo2,AMT AS CR,&#xD;&#xA;        ROW_NUMBER() OVER (PARTITION BY OPERATION_NO ORDER BY TR_DT) AS RowNum&#xD;&#xA;    FROM glmf m inner join EXPENSE_FORMS d on d.ACC_NO=m.ACC_NO WHERE LN_TY = -1 -- الدائن فقط&#xD;&#xA;)&#xD;&#xA;SELECT  COALESCE(d.OPERATION_NO, c.OPERATION_NO) AS OPERATION_NO,&#xD;&#xA;&#xD;&#xA;    d.LN_NO AS LINE_NO_POSITIVE, c.LN_NO AS LINE_NO_NEGATIVE, isnull(d.macc1,c.macc2)macc,isnull(d.AccNo1,c.AccNo2) acc,&#xD;&#xA;   d.macc1, d.AccNo1,d.Db,c.macc2, c.AccNo2 , c.Cr&#xD;&#xA;FROM DebitRows d&#xD;&#xA;FULL OUTER JOIN  CreditRows c&#xD;&#xA;ON  d.OPERATION_NO = c.OPERATION_NO AND d.RowNum = c.RowNum &#xD;&#xA;&#x9;where d.OPERATION_NO = '1م'&#xD;&#xA;ORDER BY  LINE_NO_POSITIVE , LINE_NO_NEGATIVE" Name="sqlDataSource1" />
  </DataSources>
