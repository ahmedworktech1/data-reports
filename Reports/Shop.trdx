  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="aqxarmy2024" SelectCommand="select Tr_NO as TrNo, STRT_DT as StartDate, End_Dt as EndDate, TR_DT as TrDt, PRD as Prd, &#xD;&#xA;&#x9;   case Prd_ty &#xD;&#xA;&#x9;&#x9;   when 1 then 'يوم' &#xD;&#xA;&#x9;&#x9;   when 2 then 'شهر'&#xD;&#xA;&#x9;&#x9;   when 3 then 'سنه'&#xD;&#xA;&#x9;&#x9;   else ''&#xD;&#xA;&#x9;   end as PrdTy,&#xD;&#xA;&#x9;   (select DSCR_AR from AppCodes where ID = 141 and SEQ = Rent_Type) as RentType,&#xD;&#xA;&#x9;   case Contrct_State &#xD;&#xA;&#x9;&#x9;   when 1 then 'جديد' &#xD;&#xA;&#x9;&#x9;   when 2 then 'سارى'&#xD;&#xA;&#x9;&#x9;   when 3 then 'منتهى'&#xD;&#xA;&#x9;&#x9;   when 4 then 'ملغى'&#xD;&#xA;&#x9;&#x9;   when 5 then 'طلب موافقه'&#xD;&#xA;&#x9;&#x9;   else ''&#xD;&#xA;&#x9;   end as ContractState,&#xD;&#xA;&#x9;   ElectricServiceMounthlyAmt, WaterServiceMounthlyAmt, CleanServiceMounthlyAmt, GuardServiceMounthlyAmt, &#xD;&#xA;&#x9;   ServiceMounthlyAmt, ServiceAmt, MonthlyAmt, AMT as Amt, InsPercentange, INS as Ins, &#xD;&#xA;&#x9;   case ServiceParts&#xD;&#xA;&#x9;&#x9;   when 1 then 'الطرف الاول'&#xD;&#xA;&#x9;&#x9;   when 2 then ' الطرف الثانى'&#xD;&#xA;&#x9;&#x9;   else ''&#xD;&#xA;&#x9;   end as ServiceParts,&#xD;&#xA;&#x9;   RMRK, CouncilDate, CouncilNo,&#xD;&#xA;&#x9;   case Approval&#xD;&#xA;&#x9;&#x9;   when 1 then 'تحت التصديق'&#xD;&#xA;&#x9;&#x9;   when 2 then 'مصدق'&#xD;&#xA;&#x9;&#x9;   else 'تحت التصديق'&#xD;&#xA;&#x9;   end as Approval,&#xD;&#xA;&#x9;   Introduction,&#xD;&#xA;&#x9;   UNTS as UntCd,&#xD;&#xA;&#x9;   (select UNT_DSCR_AR from UNTMF where BLD_CD = 1 and UNT_CD = UNTS) as UntDscrAr,&#xD;&#xA;&#x9;   (select DSCR_AR from AppCodes where ID = 139 and SEQ = (select UNT_TYP from UNTMF where BLD_CD = 1 and UNT_CD = UNTS)) as UntType,&#xD;&#xA;&#x9;   (select TENANT_Nm_AR from tenantMF where TENANT_NO = AQRENT_H.TENANT_NO) as Tenant&#xD;&#xA;from AQRENT_H&#xD;&#xA;" Name="sqlDataSource1" />
  </DataSources>
