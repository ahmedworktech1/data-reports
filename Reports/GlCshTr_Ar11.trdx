  <DataSources>
    <SqlDataSource QueryDesignerState="null" ParameterValues="null" ConnectionString="glxarmy" SelectCommand="SELECT&#xD;&#xA;&#x9;GLCSH_TR_H.TR_TY, &#xD;&#xA;(select csh_dscr from GLCSHMF where CSH_CD=GLCSH_TR_H.CSH_CD) as M_CshDscr,&#xD;&#xA;&#x9;GLCSH_TR_H.TR_NO, &#xD;&#xA;&#x9;GLCSH_TR_H.NOTES,&#xD;&#xA;&#x9;GLCSH_TR_H.TR_DT, &#xD;&#xA;&#x9;GLCSH_TR_H.CSH_CD, &#xD;&#xA;&#x9;GLCSH_TR_H.CST_CD,&#xD;&#xA;(select cst_NM_Ar from glcst where CST_CD=GLCSH_TR_H.CST_CD ) as cst_name_ar,&#xD;&#xA;&#x9;GLCSH_TR_H.TOT_AMT, &#xD;&#xA;&#x9;GLCSH_TR_H.TO_NM, &#xD;&#xA;&#x9;GLCSH_TR_H.TOADR, &#xD;&#xA;&#x9;GLCSH_TR_H.DOC_TY, &#xD;&#xA;&#x9;GLCSH_TR_H.DOC_NO, &#xD;&#xA;&#x9;GLCSH_TR_H.CHK_NO, &#xD;&#xA;&#x9;GLCSH_TR_H.RMRK, &#xD;&#xA;&#x9;GLCSH_TR_H.POSTED_DT, &#xD;&#xA;&#x9;GLCSH_TR_H.POSTED_BY, &#xD;&#xA;&#x9;GLCSH_TR_H.EnteredBy, &#xD;&#xA;&#x9;GLCSH_TR_H.UpdatedBy, &#xD;&#xA;&#x9;GLCSH_TR_H.EntryDate, &#xD;&#xA;&#x9;GLCSH_TR_H.UpdateDate, &#xD;&#xA;&#x9;GLCSH_TR_H.DOCS, &#xD;&#xA;&#x9;GLCSH_TR_H.RDOCS, &#xD;&#xA;&#x9;GLCSH_TR_H.PAID, &#xD;&#xA;&#x9;GLCSH_TR_H.PAID_DT, &#xD;&#xA;&#x9;GLCSH_TR_H.PAID_BY, &#xD;&#xA;&#x9;GLCSH_TR_H.CSH_TY,  &#xD;&#xA;&#x9;GLCSH_TR_H.REVISD, &#xD;&#xA;&#x9;GLCSH_TR_H.REVISD_BY, &#xD;&#xA;&#x9;GLCSH_TR_H.REVISD_DT, &#xD;&#xA;&#x9;GLCSH_TR_H.TOT_NUM_WRD, &#xD;&#xA;&#x9;GLCSH_TR_H.tmp_no, &#xD;&#xA;&#x9;GLCSH_TR_H.HDUE_DT, &#xD;&#xA;&#x9;GLCSH_TR_H.COM_ID, &#xD;&#xA;&#x9;GLCSH_TR_H.ROLL_NO, &#xD;&#xA;&#x9;GLCSH_TR_H.SUM_CD, &#xD;&#xA;&#x9;(select sum_NM_Ar from GLSUMS where SUM_CD=GLCSH_TR_H.SUM_CD) as sum_name_Ar ,&#xD;&#xA;&#x9;GLCSH_TR_H.SSUM_CD,&#xD;&#xA;&#x9;(select SSUM_NM_Ar from GLSSUMS where SSUM_CD=GLCSH_TR_H.SSUM_CD ) as ssum_name_Ar ,&#xD;&#xA;&#x9;GLCSH_TR_H.ALT_CHK_NO, &#xD;&#xA;&#x9;GLCSH_TR_H.DIST_DON, &#xD;&#xA;&#x9;GLCSH_TR_H.CHK_stat, &#xD;&#xA;&#x9;GLCSH_TR_H.chk_stat_DT, &#xD;&#xA;&#x9;GLCSH_TR_H.ALT_TR_NO, &#xD;&#xA;&#x9;GLCSH_TR_H.TO_FRST_ACC, &#xD;&#xA;&#x9;GLCSH_TR_H.BY_ACC_RPT, &#xD;&#xA;&#x9;GLCSH_TR_H.tmp_jrn_cd, &#xD;&#xA;&#x9;GLCSH_TR_H.SCST_CD,&#xD;&#xA;&#x9;(select scst_nm_ar from GLSCST where SCST_CD=GLCSH_TR_H.SCST_CD) as scst_nm_ar ,&#xD;&#xA;&#x9;GLCSH_TR_H.RMRK_EN, &#xD;&#xA;&#x9;GLCSH_TR_H.HCHK_NO, &#xD;&#xA;&#x9;GLCSH_TR_H.HBNK_ID, &#xD;&#xA;&#x9;GLCSH_TR.TO_ACC,&#xD;&#xA;&#x9;(select Acc_NM_Ar from GLMF where ACC_NO=GLCSH_TR.TO_ACC) as GLMF_name_Ar&#xD;&#xA;FROM GLCSH_TR_H,GLCSH_TR &#xD;&#xA;WHERE [GLCSH_TR_H].[TR_TY] = GLCSH_TR.TR_TY &#xD;&#xA;AND [GLCSH_TR_H].[TR_NO] = GLCSH_TR.TR_NO &#xD;&#xA;and GLCSH_TR_H.TR_TY='102'&#xD;&#xA;order by [GLCSH_TR_H].[TR_TY]&#xD;&#xA;&#x9;&#x9; ,[GLCSH_TR_H].[TR_NO]" Name="sqlDataSource1" />
