              <Legend Position="RightCenter" IsInsidePlotArea="False">
                <Style LineWidth="0cm" LineColor="LightGray" />
              </Legend>
              <Style>
                <Padding Left="10px" Right="10px" Top="10px" Bottom="10px" />
              </Style>
              <SeriesGroups>
                <GraphGroup Name="group1_DSCRGroup">
                  <ChildGroups>
                    <GraphGroup Name="tOTDBGroup">
                      <Groupings>
                        <Grouping Expression="= Fields.TOTDB" />
                      </Groupings>
                      <Sortings>
                        <Sorting Expression="= Fields.TOTDB" Direction="Asc" />
                      </Sortings>
                    </GraphGroup>
                  </ChildGroups>
                  <Groupings>
                    <Grouping Expression="= Fields.Group1_DSCR" />
                  </Groupings>
                  <Sortings>
                    <Sorting Expression="= Fields.Group1_DSCR" Direction="Asc" />
                  </Sortings>
