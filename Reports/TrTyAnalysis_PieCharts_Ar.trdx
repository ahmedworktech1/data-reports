                    <Grouping Expression="= Fields.Group1_DSCR" />
                  </Groupings>
                  <Sortings>
                    <Sorting Expression="= Fields.Group1_DSCR" Direction="Asc" />
                  </Sortings>
                </GraphGroup>
              </SeriesGroups>
              <CategoryGroups>
                <GraphGroup Name="group1Group">
                  <Groupings>
                    <Grouping Expression="= Fields.Group1" />
                  </Groupings>
                  <Sortings>
                    <Sorting Expression="= Fields.Group1" Direction="Asc" />
                  </Sortings>
                </GraphGroup>
                <GraphGroup Name="categoryGroup" />
              </CategoryGroups>
              <Series>
                <BarSeries CoordinateSystem="polarCoordinateSystem2" CategoryGroup="categoryGroup" SeriesGroup="group1_DSCRGroup1" DataPointLabelOffset="1mm" X="= Sum(Fields.SBAL_DB)" ArrangeMode="Stacked100" DataPointLabel="= Sum(Fields.SBAL_DB) / CDbl(Exec('graph1', Sum(Fields.SBAL_DB)))" DataPointLabelFormat="{0:P}" Name="barSeries2">
                  <DataPointStyle Visible="True" LineWidth="0cm" />
                  <DataPointLabelStyle Visible="True" />
                  <LegendItem Value="= Fields.Group1_DSCR" />
                  <DataPointLabelConnectorStyle Visible="False">
                    <Padding Top="2pt" Bottom="2pt" />
                  </DataPointLabelConnectorStyle>
                  <MergedDataPoints />
                  <ToolTip Title="= Fields.Group1_DSCR" Text="= Format('{0:P}', Sum(Fields.SBAL_DB) / CDbl(Exec('graph1', Sum(Fields.SBAL_DB))))" />
                </BarSeries>
              </Series>
              <Titles>
                <GraphTitle Text="graph1" Position="TopCenter">
                  <Style Visible="False" LineWidth="0cm" LineColor="LightGray" />
                </GraphTitle>
              </Titles>
            </Graph>
          </Items>
        </GroupHeaderSection>
      </GroupHeader>
